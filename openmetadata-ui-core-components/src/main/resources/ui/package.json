{
  "name": "@openmetadata/ui-core-components",
  "version": "1.0.0",
  "description": "OpenMetadata shared UI core components and theme system",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/types/src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./colors": {
      "types": "./dist/types/src/colors/index.d.ts",
      "import": "./dist/colors/index.es.js",
      "require": "./dist/colors/index.cjs.js"
    },
    "./components": {
      "types": "./dist/types/src/components/index.d.ts",
      "import": "./dist/components/index.es.js",
      "require": "./dist/components/index.cjs.js"
    },
    "./utils": {
      "types": "./dist/types/src/utils/index.d.ts",
      "import": "./dist/utils/index.es.js",
      "require": "./dist/utils/index.cjs.js"
    },
    "./locale": {
      "types": "./dist/types/src/locale/index.d.ts",
      "import": "./dist/locale/index.es.js",
      "require": "./dist/locale/index.cjs.js"
    },
    "./globals.css": "./src/styles/globals.css"
  },
  "files": [
    "dist",
    "src/styles/globals.css",
    "src/locale",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "dist/**/*.css"
  ],
  "keywords": [
    "theme",
    "design-system",
    "core-components",
    "react",
    "typescript",
    "ui-library",
    "component-library"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn clean && yarn build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:base": "eslint --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src/ --fix",
    "pretty": "prettier --write src/",
    "pretty:base": "prettier --config './.prettierrc.yaml' --ignore-path './.prettierignore'",
    "pretty:check": "prettier --check src/",
    "ui-checkstyle:changed": "bash scripts/ui-checkstyle-changed.sh",
    "i18n": "sync-i18n --files 'src/locale/languages/*.json' --primary en-us --space 2 --fn",
    "check-i18n": "yarn i18n --check",
    "check-i18n-keys": "node scripts/i18n-extract-check.cjs",
    "check-locale-parity": "node scripts/check-locale-parity.cjs",
    "check-translations-not-english": "node scripts/check-translations-not-english.cjs",
    "check-i18n-all": "yarn check-i18n && yarn check-i18n-keys && yarn check-locale-parity && yarn check-translations-not-english"
  },
  "author": "OpenMetadata",
  "license": "Apache-2.0",
  "dependencies": {
    "@untitledui/file-icons": "^0.0.9"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.11.0",
    "@react-aria/utils": "^3.33.0",
    "@react-stately/utils": "^3.11.0",
    "@tailwindcss/typography": ">=0.5.0",
    "@tailwindcss/vite": ">=4.0.0",
    "@untitledui/icons": "^0.0.21",
    "i18next": "^21.10.0",
    "input-otp": "^1.4.2",
    "react": ">=18.0.0",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "react-dom": ">=18.0.0",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^15.5.3",
    "tailwind-merge": ">=3.0.0",
    "tailwindcss": ">=4.0.0",
    "tailwindcss-animate": ">=1.0.0",
    "tailwindcss-react-aria-components": ">=2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fontsource/inter": "^5.2.8",
    "@internationalized/date": "^3.11.0",
    "@react-aria/utils": "^3.33.0",
    "@react-stately/utils": "^3.11.0",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@untitledui/icons": "^0.0.21",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.4.0",
    "i18next": "^21.10.0",
    "i18next-json-sync": "^3.1.2",
    "i18next-parser": "^9.0.0",
    "input-otp": "^1.4.2",
    "jsdom": "^25.0.1",
    "prettier": "2.8.8",
    "react": "^18.2.0",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^15.5.3",
    "storybook": "^8.6.18",
    "sync-i18n": "^0.0.20",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.0.1",
    "terser": "^5.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "lodash": "4.18.1",
    "minimatch": "10.2.3",
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "rollup": "4.59.0",
    "uuid": "^14.0.0",
    "esbuild": "^0.28.1",
    "ws": "8.21.1",
    "js-yaml": "^5.2.2"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.17.0",
    "yarn": ">=1.22.0"
  }
}
