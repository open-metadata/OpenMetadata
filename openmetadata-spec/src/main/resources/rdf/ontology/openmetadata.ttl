om:isReferencedBy a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:isReferencedBy. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
