    rdfs:comment "Unique identifier of the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range rdfs:Literal .

om:title a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "title" ;
    rdfs:subPropertyOf dct:title ;
    rdfs:comment "Title of the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range rdfs:Literal .

om:creator a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:creator. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "creator" ;
    rdfs:subPropertyOf dct:creator ;
    rdfs:comment "Entity primarily responsible for creating the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range prov:Agent .

om:contributor a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:contributor. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "contributor" ;
    rdfs:subPropertyOf dct:contributor ;
    rdfs:comment "Entity responsible for contributions to the dataset" ;
