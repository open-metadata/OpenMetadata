om:startDate a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:startDate. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "start date" ;
    rdfs:subPropertyOf dcat:startDate ;
    rdfs:comment "Start of the temporal period" ;
    rdfs:domain om:PeriodOfTime ;
    rdfs:range xsd:dateTime .

om:endDate a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "end date" ;
    rdfs:subPropertyOf dcat:endDate ;
    rdfs:comment "End of the temporal period" ;
    rdfs:domain om:PeriodOfTime ;
    rdfs:range xsd:dateTime .

om:hasBeginning a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of time:hasBeginning. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has beginning" ;
    rdfs:subPropertyOf time:hasBeginning ;
    rdfs:comment "Beginning instant of the temporal period" ;
    rdfs:domain om:PeriodOfTime ;
    rdfs:range time:Instant .

om:hasEnd a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of time:hasEnd. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has end" ;
    rdfs:subPropertyOf time:hasEnd ;
    rdfs:comment "Ending instant of the temporal period" ;
    rdfs:domain om:PeriodOfTime ;
    rdfs:range time:Instant .

#################################################################
# Statistical Properties (STAT-DCAT aligned)
#################################################################

om:numberOfRecords a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "number of records" ;
    rdfs:comment "Number of records in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:integer .

om:numberOfColumns a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "number of columns" ;
    rdfs:comment "Number of columns in the dataset" ;
    rdfs:domain om:Table ;
    rdfs:range xsd:integer .

om:statisticalUnit a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "statistical unit" ;
    rdfs:comment "Unit of observation in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range skos:Concept .

om:dimension a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "dimension" ;
    rdfs:comment "Dimension represented in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range qb:DimensionProperty .

om:measure a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "measure" ;
    rdfs:comment "Measure represented in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range qb:MeasureProperty .

#################################################################
# Service-specific Properties
#################################################################

om:serviceEndpoint a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "service endpoint" ;
    rdfs:comment "Endpoint for accessing the service" ;
    rdfs:domain om:DataService ;
    rdfs:range rdfs:Resource .

om:serviceStatus a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "service status" ;
    rdfs:comment "Operational status of the service" ;
    rdfs:domain om:DataService ;
    rdfs:range xsd:string .

om:serviceLevel a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "service level" ;
    rdfs:comment "Service level agreement details" ;
    rdfs:domain om:DataService ;
    rdfs:range xsd:string .

om:apiDocumentation a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "API documentation" ;
    rdfs:comment "Link to API documentation" ;
    rdfs:domain om:DataService ;
    rdfs:range foaf:Document .


#################################################################
# Projection availability
#################################################################

om:projectionStatus a owl:AnnotationProperty ;
    rdfs:label "projection status" ;
    rdfs:comment "Whether a property is asserted by the metadata projection (Stored) or is vocabulary for custom inference/external data only (InferenceOnly). This annotation does not enable inference." .

om:Stored rdfs:label "stored" ;
    rdfs:comment "Asserted when the corresponding metadata field or relationship is populated. Queryable with inference=none; optional fields need not exist on every entity." .

om:InferenceOnly rdfs:label "inference or external data only" ;
    rdfs:comment "Not asserted by the metadata projection. Requires custom rules or externally supplied data. Merely enabling RDFS/OWL does not guarantee this property is present, especially for aliases declared only as subproperties." .

om:UPSTREAM a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    owl:deprecated true ;
    owl:inverseOf om:upstream ;
    rdfs:label "legacy source-to-output lineage" ;
    rdfs:comment "Not emitted by the metadata projection. Legacy source-to-output alias of om:downstream, supported by readers until a full RDF rebuild replaces old triples." .

om:ExtensionProperty a owl:Class ;
    rdfs:label "extension property entry" ;
    rdfs:comment "A user-defined key and typed value, linked from an Extension by hasExtensionProperty. Keys are data, not predicates in the OpenMetadata vocabulary." .

#################################################################
# Predicates emitted by JSON-LD mappings and structured projections
#
# Generic schema fields can be literals or references depending on the entity
# context. rdf:Property deliberately avoids inventing domain/range constraints.
# External vocabulary declarations document usage without redefining its axioms.
# RdfOntologyContractTest checks these against actual projected schema fixtures.
#################################################################

