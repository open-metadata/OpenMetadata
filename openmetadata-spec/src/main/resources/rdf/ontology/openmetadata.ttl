    rdfs:range prov:Agent .

om:type a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:type. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "type" ;
    rdfs:subPropertyOf dct:type ;
    rdfs:comment "Nature or genre of the dataset" ;
