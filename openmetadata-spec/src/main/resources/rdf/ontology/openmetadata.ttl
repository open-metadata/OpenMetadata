@prefix om: <https://open-metadata.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix spdx: <http://spdx.org/rdfterms/spdx#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dprod: <https://ekgf.github.io/dprod/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix dctype: <http://purl.org/dc/dcmitype/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix schema: <https://schema.org/> .

# OpenMetadata Complete Ontology
om: a owl:Ontology ;
    owl:versionInfo "2.1.0" ;
    dct:title "OpenMetadata Ontology" ;
    dct:description "Complete ontology for OpenMetadata covering all entities and relationships" ;
    dct:creator "OpenMetadata Team" ;
    dct:created "2025-08-24"^^xsd:date ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    owl:imports dcat: , prov: , skos: .

#################################################################
# Base Classes
#################################################################

om:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "Any OpenMetadata entity: a data asset, a service, a governance object such as a glossary term or policy, or a user or team. Entities carry om:fullyQualifiedName and rdfs:label, and most have owners, tags and a description." ;
    rdfs:subClassOf dcat:Resource .

om:DataAsset a owl:Class ;
    rdfs:label "Data Asset" ;
    rdfs:comment "Something that holds, moves or presents data, such as a table, topic, dashboard, pipeline, ML model, container, file or API endpoint. Data assets carry lineage (om:upstream, om:downstream), owners, tags, domains and the service that hosts them (om:belongsToService)." ;
    rdfs:subClassOf om:Entity, dcat:Resource ;
    owl:equivalentClass dcat:Dataset .

om:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A system OpenMetadata connects to and ingests from, such as a database, BI, messaging or pipeline service. Its assets point at it with om:belongsToService; om:serviceType names the technology." ;
    rdfs:subClassOf om:Entity .

#################################################################
# Service Classes
#################################################################

om:DatabaseService a owl:Class ;
    rdfs:label "Database Service" ;
    rdfs:comment "A database service such as Snowflake, BigQuery, Redshift, Postgres or MySQL; it hosts databases." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:DashboardService a owl:Class ;
    rdfs:label "Dashboard Service" ;
    rdfs:comment "A BI service such as Looker, Tableau or Superset that hosts dashboards, charts and dashboard data models." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:MessagingService a owl:Class ;
    rdfs:label "Messaging Service" ;
    rdfs:comment "A messaging service such as Kafka or Redpanda; it hosts topics." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:PipelineService a owl:Class ;
    rdfs:label "Pipeline Service" ;
    rdfs:comment "A pipeline orchestration service such as Airflow, Dagster or Fivetran; it hosts pipelines." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:MLModelService a owl:Class ;
    rdfs:label "ML Model Service" ;
    rdfs:comment "A machine-learning model service such as MLflow or SageMaker; it hosts ML models." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:StorageService a owl:Class ;
    rdfs:label "Storage Service" ;
    rdfs:comment "An object storage service such as S3, GCS or Azure Storage; it hosts containers." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:SearchService a owl:Class ;
    rdfs:label "Search Service" ;
    rdfs:comment "A search service such as Elasticsearch or OpenSearch; it hosts search indexes." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:MetadataService a owl:Class ;
    rdfs:label "Metadata Service" ;
    rdfs:comment "A metadata service, such as another catalog, that OpenMetadata ingests from." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:APIService a owl:Class ;
    rdfs:label "API Service" ;
    rdfs:comment "A service that exposes REST or webhook APIs; it hosts API collections and their endpoints." ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:ReportingService a owl:Class ;
    rdfs:label "Reporting Service" ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:QualityService a owl:Class ;
    rdfs:label "Quality Service" ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:ObservabilityService a owl:Class ;
    rdfs:label "Observability Service" ;
    rdfs:subClassOf om:Service, dcat:DataService .

om:DriveService a owl:Class ;
    rdfs:label "Drive Service" ;
    rdfs:comment "A file storage service such as Google Drive or SharePoint; it hosts directories, files and spreadsheets." ;
    rdfs:subClassOf om:Service, dcat:DataService .

#################################################################
# Data Asset Classes
#################################################################

om:Database a owl:Class ;
    rdfs:label "Database" ;
    rdfs:comment "A database, also called a catalog: a collection of database schemas within a database service." ;
    rdfs:subClassOf om:DataAsset, dcat:Catalog .

om:DatabaseSchema a owl:Class ;
    rdfs:label "Database Schema" ;
    rdfs:comment "A database schema: a collection of tables, views and stored procedures within a database." ;
    rdfs:subClassOf om:DataAsset .

om:Table a owl:Class ;
    rdfs:label "Table" ;
    rdfs:comment "A table or view in a database schema. It has columns (om:hasColumn), lineage (om:upstream, om:downstream), owners, tags, domains and quality evidence." ;
    rdfs:subClassOf om:DataAsset, dcat:Dataset .

om:StoredProcedure a owl:Class ;
    rdfs:label "Stored Procedure" ;
    rdfs:comment "A stored procedure defined in a database schema, with its code." ;
    rdfs:subClassOf om:DataAsset .

om:Query a owl:Class ;
    rdfs:label "Query" ;
    rdfs:comment "A SQL query recorded against data assets, with its text, the users who ran it and the assets that use it." ;
    rdfs:subClassOf om:DataAsset .

om:Dashboard a owl:Class ;
    rdfs:label "Dashboard" ;
    rdfs:comment "A dashboard in a BI tool, built from charts (om:hasChart) over dashboard data models (om:hasDataModel). Its lineage shows which tables feed it." ;
    rdfs:subClassOf om:DataAsset .

om:Chart a owl:Class ;
    rdfs:label "Chart" ;
    rdfs:comment "A visualisation of data, usually part of one or more dashboards." ;
    rdfs:subClassOf om:DataAsset .

om:Report a owl:Class ;
    rdfs:label "Report" ;
    rdfs:comment "A report from a reporting service: a fixed presentation of data, such as a scheduled or paginated report." ;
    rdfs:subClassOf om:DataAsset, dcat:Distribution .

om:Metric a owl:Class ;
    rdfs:label "Metric" ;
    rdfs:comment "A business metric computed from data, such as Monthly Active Users, with its expression, granularity, unit and related metrics." ;
    rdfs:subClassOf om:DataAsset .

om:MetricGroup a owl:Class ;
    rdfs:label "Metric Group" ;
    rdfs:comment "A named collection of metrics, such as Profitability, used for browsing and governance; deleting a group leaves its metrics in place." ;
    rdfs:subClassOf om:Entity .

om:Pipeline a owl:Class ;
    rdfs:label "Pipeline" ;
    rdfs:comment "A data pipeline (ETL or ELT job) that moves data between assets. Lineage edges it produces name it through prov:wasGeneratedBy; its runs hang under om:hasExecution." ;
    rdfs:subClassOf om:DataAsset, dcat:DataService .

om:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:comment "A unit of work. In the metadata projection, nodes typed om:Task are task entities: governance work items such as data access requests, glossary approvals and ontology release reviews, with their own assignees and status. The subclass axiom to om:DataAsset dates from a pipeline-task reading that the projection does not use." ;
    rdfs:subClassOf om:DataAsset .

om:Topic a owl:Class ;
    rdfs:label "Topic" ;
    rdfs:comment "Message topic providing streaming data access" ;
    rdfs:subClassOf om:DataAsset, dcat:DataService .

om:MLModel a owl:Class ;
    rdfs:label "ML Model" ;
    rdfs:comment "Machine learning model providing inference service" ;
    rdfs:subClassOf om:DataAsset, dcat:DataService .

om:Container a owl:Class ;
    rdfs:label "Container" ;
    rdfs:comment "Storage container organizing multiple datasets" ;
    rdfs:subClassOf om:DataAsset, dcat:Catalog .

om:SearchIndex a owl:Class ;
    rdfs:label "Search Index" ;
    rdfs:comment "A search index, such as an Elasticsearch or OpenSearch index mapping, with its fields." ;
    rdfs:subClassOf om:DataAsset .

om:APICollection a owl:Class ;
    rdfs:label "API Collection" ;
    rdfs:comment "A collection of API endpoints within an API service, such as one REST API. Its endpoints point at it with om:belongsToAPICollection." ;
    rdfs:subClassOf om:DataAsset, dcat:Catalog .

om:APIDocumentation a owl:Class ;
    rdfs:label "API Documentation" ;
    rdfs:comment "Documentation for API endpoints" ;
    rdfs:subClassOf foaf:Document .

om:APIEndpoint a owl:Class ;
    rdfs:label "API Endpoint" ;
    rdfs:comment "One endpoint of an API collection, with its request method and request and response schemas." ;
    rdfs:subClassOf om:DataAsset, dcat:DataService .

om:Directory a owl:Class ;
    rdfs:label "Directory" ;
    rdfs:comment "A folder in a drive service such as Google Drive or SharePoint, holding files, spreadsheets and sub-directories." ;
    rdfs:subClassOf om:DataAsset, dcat:Dataset .

om:File a owl:Class ;
    rdfs:label "File" ;
    rdfs:comment "A file in a drive service, with its type, size and path and, for structured files, its columns." ;
    rdfs:subClassOf om:DataAsset, dcat:Distribution .

om:Spreadsheet a owl:Class ;
    rdfs:label "Spreadsheet" ;
    rdfs:comment "A spreadsheet file in a drive service, such as a Google Sheet or Excel workbook. Its tabs are worksheets (om:hasWorksheet)." ;
    rdfs:subClassOf om:DataAsset, dcat:Dataset .

om:Worksheet a owl:Class ;
    rdfs:label "Worksheet" ;
    rdfs:comment "One tab of a spreadsheet, with its columns." ;
    rdfs:subClassOf om:DataAsset .

#################################################################
# AI Classes
#################################################################

om:LLMModel a owl:Class ;
    rdfs:label "LLM Model" ;
    rdfs:comment "Registered large language model deployment, fine-tune, or base model" ;
    rdfs:subClassOf om:Entity .

om:AIApplication a owl:Class ;
    rdfs:label "AI Application" ;
    rdfs:comment "An AI system such as a chatbot, agent or copilot, with the LLM models, tools and data sources it uses." ;
    rdfs:subClassOf om:Entity .

om:McpServer a owl:Class ;
    rdfs:label "MCP Server" ;
    rdfs:comment "A deployed MCP (Model Context Protocol) server, with the tools, resources and prompts it exposes to AI applications." ;
    rdfs:subClassOf om:Entity .

om:AgentExecution a owl:Class ;
    rdfs:label "Agent Execution" ;
    rdfs:subClassOf om:Entity, prov:Activity .

om:McpExecution a owl:Class ;
    rdfs:label "MCP Execution" ;
    rdfs:subClassOf om:Entity, prov:Activity .

om:PromptTemplate a owl:Class ;
    rdfs:label "Prompt Template" ;
    rdfs:comment "A reusable prompt template for AI agents, with variables, a system prompt and examples." ;
    rdfs:subClassOf om:Entity .

#################################################################
# Metadata & Governance Classes
#################################################################

om:Glossary a owl:Class ;
    rdfs:label "Glossary" ;
    rdfs:comment "A glossary: a collection of hierarchical glossary terms that define business vocabulary." ;
    rdfs:subClassOf om:Entity, skos:ConceptScheme .

om:GlossaryTerm a owl:Class ;
    rdfs:label "Glossary Term" ;
    rdfs:comment "A business term defined in a glossary. Assets that carry it as a label point at it with om:hasGlossaryTerm; terms relate to each other through the configured glossary relations." ;
    rdfs:subClassOf om:Entity, skos:Concept .

om:Classification a owl:Class ;
    rdfs:label "Classification" ;
    rdfs:comment "A classification: a named group of tags such as PII or Tier, whose tags may be mutually exclusive (om:isMutuallyExclusive). Its tags point at it with skos:inScheme." ;
    rdfs:subClassOf om:Entity, skos:ConceptScheme .

om:Tag a owl:Class ;
    rdfs:label "Tag" ;
    rdfs:comment "A tag defined under a classification, used to label entities and columns, for example PII.Sensitive or Tier.Tier1. Labelled entities point at it with om:hasTag." ;
    rdfs:subClassOf om:Entity, skos:Concept .

#################################################################
# Glossary Term Relation Properties (Business-oriented)
#################################################################

# Associative Relations
om:relatedTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "related to" ;
    rdfs:comment "Related entities. Between glossary terms it is the symmetric relatedTo relation, an association between connected concepts; between other entities, such as a table, metric, test case, knowledge page or context memory and what it relates to, it comes from RELATED_TO relationships." ;
    rdfs:subPropertyOf skos:related ;
    a owl:SymmetricProperty ;
    schema:domainIncludes om:ContextMemory, om:GlossaryTerm, om:Metric, om:Page, om:Table, om:TestCase .

om:synonym a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of skos:exactMatch. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "synonym" ;
    rdfs:comment "Terms that have the same or nearly identical meaning and can be used interchangeably" ;
    rdfs:subPropertyOf skos:exactMatch ;
    a owl:SymmetricProperty ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:GlossaryTerm .

om:seeAlso a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of rdfs:seeAlso. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "see also" ;
    rdfs:comment "Reference to a related term that may provide additional context" ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    a owl:SymmetricProperty ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:GlossaryTerm .

# Hierarchical Relations (Classification)
om:typeOf a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of rdfs:subClassOf. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "type of" ;
    rdfs:comment "Classification where the subject is a specific type of the object (e.g., 'Premium Customer' typeOf 'Customer')" ;
    rdfs:subPropertyOf rdfs:subClassOf ;
    owl:inverseOf om:hasTypes ;
    a owl:TransitiveProperty ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:GlossaryTerm .

om:hasTypes a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "has types" ;
    rdfs:comment "Inverse of 'Type Of'. The subject has specific types (e.g., 'Customer' hasTypes 'Premium Customer')" ;
    owl:inverseOf om:typeOf ;
    a owl:TransitiveProperty ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:GlossaryTerm .

# Hierarchical Relations (Composition)
om:componentOf a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "component of" ;
    rdfs:comment "The subject is a component or part of the object (e.g., 'Product Revenue' componentOf 'Total Revenue')" ;
    owl:inverseOf om:composedOf ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:GlossaryTerm .

om:composedOf a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "composed of" ;
    rdfs:comment "The subject is composed of or includes the object (e.g., 'Total Revenue' composedOf 'Product Revenue')" ;
    owl:inverseOf om:componentOf ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:GlossaryTerm .

# Derivation Relations (for Metrics/KPIs)
om:calculatedFrom a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "calculated from" ;
    rdfs:comment "The subject metric is calculated or derived from the object (e.g., 'ARR' calculatedFrom 'MRR')" ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    owl:inverseOf om:usedToCalculate ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:GlossaryTerm .

om:usedToCalculate a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "used to calculate" ;
    rdfs:comment "The subject is used to calculate the object metric (e.g., 'MRR' usedToCalculate 'ARR')" ;
    owl:inverseOf om:calculatedFrom ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:GlossaryTerm .

om:DataContract a owl:Class ;
    rdfs:label "Data Contract" ;
    rdfs:comment "A contract for a data asset: the schema, quality expectations and service levels it promises its consumers." ;
    rdfs:subClassOf om:Entity .

om:DataProduct a owl:Class ;
    rdfs:label "Data Product" ;
    rdfs:comment "A data product: a governed set of assets published by a domain for consumers, with input and output ports, owners and experts. Its assets carry om:hasDataProduct." ;
    rdfs:subClassOf om:Entity .

om:Domain a owl:Class ;
    rdfs:label "Domain" ;
    rdfs:comment "A business domain: a bounded context aligned with a business unit or function. Assets join it through om:belongsToDomain; sub-domains hang under skos:narrower." ;
    rdfs:subClassOf om:Entity .

#################################################################
# Teams & Users Classes
#################################################################

om:Team a owl:Class ;
    rdfs:label "Team" ;
    rdfs:comment "A team: a group of users and other teams in the hierarchy Organization, BusinessUnit, Division, Department and Group. Teams own assets and carry default roles and policies." ;
    rdfs:subClassOf om:Entity, prov:Agent, foaf:Group .

om:User a owl:Class ;
    rdfs:label "User" ;
    rdfs:comment "A person who uses OpenMetadata, or a bot user. Users own and follow assets and belong to teams." ;
    rdfs:subClassOf om:Entity, prov:Agent, foaf:Person .

om:Bot a owl:Class ;
    rdfs:label "Bot" ;
    rdfs:comment "An automation account that acts as a special user, for example to ingest metadata or apply descriptions. Its bot user is the om:User that performs its changes." ;
    rdfs:subClassOf om:Entity, prov:Agent .

om:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A role: a set of policies that grants privileges to the users and teams it is assigned to." ;
    rdfs:subClassOf om:Entity .

om:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "An access-control policy: a set of rules that allow or deny operations on resources. Roles and teams attach it through om:hasPolicy." ;
    rdfs:subClassOf om:Entity .

#################################################################
# Quality & Testing Classes
#################################################################

om:TestDefinition a owl:Class ;
    rdfs:label "Test Definition" ;
    rdfs:subClassOf om:Entity .

om:TestSuite a owl:Class ;
    rdfs:label "Test Suite" ;
    rdfs:comment "A named group of test cases that run and are reported together: the basic suite of one table, or a logical suite that gathers tests across tables. Test cases point to it with om:belongsToTestSuite." ;
    rdfs:subClassOf om:Entity .

om:TestDefinition a owl:Class ;
    rdfs:label "Test Definition" ;
    rdfs:comment "The kind of check a test case runs, such as columnValuesToBeNotNull or tableRowCountToBeBetween, and the parameters it takes. Test cases point to it with om:hasTestDefinition; tests that share a definition check the same kind of rule on different data." ;
    rdfs:subClassOf om:Entity .

om:TestCase a owl:Class ;
    rdfs:label "Test Case" ;
    rdfs:comment "A data quality test on a table or column: what it checks (om:testsEntity, om:testsColumn), its parameters (om:hasParameterValue), its latest result (om:hasTestResult, om:latestResultStatus) and any open incident. Read the latest status before trusting the data the test covers." ;
    rdfs:subClassOf om:Entity .

om:TestCaseResult a owl:Class ;
    rdfs:label "Test Case Result" ;
    rdfs:comment "The latest run of a test case: its status, when it ran, what it observed and the bounds it was judged against. The graph keeps only the latest run; older runs stay in the test results API." .

om:TestResultValue a owl:Class ;
    rdfs:label "Test Result Value" ;
    rdfs:comment "One value a test run observed, such as the null count or the minimum it measured, named by rdfs:label with the observed value as dqv:value." .

om:testsEntity a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "tests entity" ;
    rdfs:comment "The table a test case checks. Follow it backwards from a table to find every test on it, column tests included; a column test also carries om:testsColumn. Written only while the table is in the catalog. The inverse of om:testedBy, which the projection does not write for test cases." ;
    owl:inverseOf om:testedBy ;
    rdfs:domain om:TestCase ;
    rdfs:range om:Table .

om:testsColumn a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "tests column" ;
    rdfs:comment "The column a column-level test case checks, the same column IRI om:hasColumn names. Absent for table-level tests." ;
    rdfs:domain om:TestCase ;
    rdfs:range om:Column .

om:belongsToTestSuite a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "belongs to test suite" ;
    rdfs:comment "The test suite a test case belongs to, normally the basic suite of the table it tests. Follow it to the other tests that run and are reported with this one; a suite's latest run is read through the test suites API, not the graph." ;
    rdfs:domain om:TestCase ;
    rdfs:range om:TestSuite .

om:hasTestDefinition a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has test definition" ;
    rdfs:comment "The test definition a test case runs, which says what kind of rule it checks; its parameter values are om:hasParameterValue on the test case. Follow it backwards to find every test of the same kind." ;
    rdfs:domain om:TestCase ;
    rdfs:range om:TestDefinition .

om:testsEntityFQN a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "tests entity FQN" ;
    rdfs:comment "Fully qualified name of the table or column a test case checks, matching that asset's om:fullyQualifiedName." ;
    rdfs:domain om:TestCase ;
    rdfs:range xsd:string .

om:hasTestResult a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has test result" ;
    rdfs:comment "The latest result of a test case. Read it before trusting the data the test covers: a Failed status means the last run found the data outside the test's bounds. There is at most one; it is replaced when a newer run arrives and removed with the test case. Results of tests on PII-sensitive columns are not projected." ;
    rdfs:domain om:TestCase ;
    rdfs:range om:TestCaseResult .

om:testResultStatus a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "test result status" ;
    rdfs:comment "Outcome of the latest run: Success, Failed, Aborted or Queued. The run time is prov:generatedAtTime on the same result." ;
    rdfs:domain om:TestCaseResult ;
    rdfs:range xsd:string .

om:testResultMessage a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "test result message" ;
    rdfs:comment "The run's own summary of what it found, as the test framework wrote it." ;
    rdfs:domain om:TestCaseResult ;
    rdfs:range xsd:string .

om:passedRows a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "passed rows" ;
    rdfs:comment "Rows that met the test in the latest run, for tests that count rows." ;
    rdfs:domain om:TestCaseResult ;
    rdfs:range xsd:long .

om:failedRows a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "failed rows" ;
    rdfs:comment "Rows that broke the test in the latest run, for tests that count rows. A filter that should exclude bad rows can use it to estimate how many it removes." ;
    rdfs:domain om:TestCaseResult ;
    rdfs:range xsd:long .

om:minBound a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "minimum bound" ;
    rdfs:comment "Lowest value the latest run accepted: the threshold the observed values were judged against, after any failure tolerance. The test's configured parameters are on the test case as om:hasParameterValue." ;
    rdfs:domain om:TestCaseResult ;
    rdfs:range xsd:double .

om:maxBound a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "maximum bound" ;
    rdfs:comment "Highest value the latest run accepted: the threshold the observed values were judged against, after any failure tolerance." ;
    rdfs:domain om:TestCaseResult ;
    rdfs:range xsd:double .

om:hasResultValue a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has result value" ;
    rdfs:comment "A value the latest run observed, such as the measured null count or minimum. Each carries its name as rdfs:label and the observed value, as the framework reported it, as a dqv:value string." ;
    rdfs:domain om:TestCaseResult ;
    rdfs:range om:TestResultValue .

om:profiledAt a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled at" ;
    rdfs:comment "When the latest profile of this table or column was taken. Every om:profile* fact on the same node comes from that profile; older profiles stay in the profiler API." ;
    rdfs:domain om:Entity ;
    rdfs:range xsd:dateTime .

om:profileRowCount a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled row count" ;
    rdfs:comment "Rows the profiler counted in the table. From the latest profile only; om:profiledAt on the same node says when it was taken." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:double .

om:profileColumnCount a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled column count" ;
    rdfs:comment "Columns the profiler saw in the table; om:hasColumn edges list the declared columns. From the latest profile only; om:profiledAt on the same node says when it was taken." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:double .

om:profileSizeInBytes a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled size in bytes" ;
    rdfs:comment "Storage size of the table when it was profiled. From the latest profile only; om:profiledAt on the same node says when it was taken." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:double .

om:profileValuesCount a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled values count" ;
    rdfs:comment "Values the profiler counted in the column. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileNullCount a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled null count" ;
    rdfs:comment "Null values in the column; a filter on the column drops these rows unless it handles nulls. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileNullProportion a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled null proportion" ;
    rdfs:comment "Share of the column that is null, from 0 to 1. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileDistinctCount a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled distinct count" ;
    rdfs:comment "Distinct values in the column; a low count suggests a categorical column to filter or group by. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileUniqueCount a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled unique count" ;
    rdfs:comment "Values that occur exactly once in the column; close to the row count suggests a key. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileMin a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled minimum" ;
    rdfs:comment "Smallest value of a numeric column. Not projected for non-numeric columns or PII-sensitive ones. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileMax a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled maximum" ;
    rdfs:comment "Largest value of a numeric column. Not projected for non-numeric columns or PII-sensitive ones. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileMean a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled mean" ;
    rdfs:comment "Average value of a numeric column. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileMinLength a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled minimum length" ;
    rdfs:comment "Shortest string length in a text column. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:profileMaxLength a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "profiled maximum length" ;
    rdfs:comment "Longest string length in a text column. From the latest profile only; om:profiledAt on the same node says when it was taken. Columns tagged PII.Sensitive carry no profile." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:double .

om:latestResultStatus a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "latest result status" ;
    rdfs:comment "Outcome of the test case's latest run (Success, Failed, Aborted or Queued), repeated from its om:hasTestResult node so the test case's own card shows it. Absent when the test never ran or tests a PII-sensitive column." ;
    rdfs:domain om:TestCase ;
    rdfs:range xsd:string .

om:latestResultAt a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "latest result at" ;
    rdfs:comment "When the test case's latest run happened. Compare it with the current time to tell whether om:latestResultStatus still describes the data." ;
    rdfs:domain om:TestCase ;
    rdfs:range xsd:dateTime .

om:TestCaseIncident a owl:Class ;
    rdfs:label "Test Case Incident" ;
    rdfs:comment "The incident a failing test case has open: its state, severity and who is assigned. A resolved incident is not projected." .

om:hasOpenIncident a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has open incident" ;
    rdfs:comment "The unresolved incident of a test case. Present means someone has to act on the failure before the data it covers is trusted; it disappears when the incident is resolved." ;
    rdfs:domain om:TestCase ;
    rdfs:range om:TestCaseIncident .

om:incidentState a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "incident state" ;
    rdfs:comment "Where the open incident stands: New, Ack (acknowledged) or Assigned. The time of that state is prov:generatedAtTime on the same node." ;
    rdfs:domain om:TestCaseIncident ;
    rdfs:range xsd:string .

om:incidentSeverity a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "incident severity" ;
    rdfs:comment "Severity of the open incident, from Severity1 (most severe) to Severity5." ;
    rdfs:domain om:TestCaseIncident ;
    rdfs:range xsd:string .

om:incidentAssignee a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "incident assignee" ;
    rdfs:comment "The user or team working on the open incident, once it is assigned." ;
    rdfs:domain om:TestCaseIncident ;
    rdfs:range prov:Agent .

om:hasParameterValue a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has parameter value" ;
    rdfs:comment "The test case's configured parameters, such as minValue or allowedValues, as one JSON array of name and value pairs." ;
    rdfs:domain om:TestCase ;
    rdfs:range xsd:string .

#################################################################
# DCAT 3 Alignment Classes
#################################################################

om:DatasetSeries a owl:Class ;
    rdfs:label "Dataset Series" ;
    rdfs:comment "Collection of related datasets, e.g., time series or versions" ;
    rdfs:subClassOf dcat:DatasetSeries, om:Entity .

om:CatalogRecord a owl:Class ;
    rdfs:label "Catalog Record" ;
    rdfs:comment "Metadata about when/how an entity was cataloged" ;
    rdfs:subClassOf dcat:CatalogRecord, om:Entity .

om:QualifiedRelationship a owl:Class ;
    rdfs:label "Qualified Relationship" ;
    rdfs:comment "Relationship with additional context like role, time, etc." ;
    rdfs:subClassOf dcat:Relationship .

om:Distribution a owl:Class ;
    rdfs:label "Distribution" ;
    rdfs:comment "Specific representation of a dataset" ;
    rdfs:subClassOf dcat:Distribution, om:Entity .

om:DataService a owl:Class ;
    rdfs:label "Data Service" ;
    rdfs:comment "Service that provides access to data" ;
    rdfs:subClassOf dcat:DataService, om:Service .

om:Catalog a owl:Class ;
    rdfs:label "Catalog" ;
    rdfs:comment "Curated collection of metadata about resources" ;
    rdfs:subClassOf dcat:Catalog, om:Entity .

om:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "Any resource cataloged in OpenMetadata" ;
    rdfs:subClassOf dcat:Resource .

om:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Organization entity" ;
    rdfs:subClassOf foaf:Organization, prov:Agent, om:Entity .

om:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "Spatial region or location" ;
    rdfs:subClassOf dct:Location .

om:PeriodOfTime a owl:Class ;
    rdfs:label "Period of Time" ;
    rdfs:comment "Time period specification" ;
    rdfs:subClassOf dct:PeriodOfTime .

om:Frequency a owl:Class ;
    rdfs:label "Frequency" ;
    rdfs:comment "Update frequency specification" ;
    rdfs:subClassOf dct:Frequency .

om:LicenseDocument a owl:Class ;
    rdfs:label "License Document" ;
    rdfs:comment "Legal document giving permissions" ;
    rdfs:subClassOf dct:LicenseDocument .

om:RightsStatement a owl:Class ;
    rdfs:label "Rights Statement" ;
    rdfs:comment "Statement about intellectual property rights" ;
    rdfs:subClassOf dct:RightsStatement .

om:Standard a owl:Class ;
    rdfs:label "Standard" ;
    rdfs:comment "Technical standard or specification" ;
    rdfs:subClassOf dct:Standard .

om:MediaType a owl:Class ;
    rdfs:label "Media Type" ;
    rdfs:comment "Media type or format" ;
    rdfs:subClassOf dct:MediaType .

#################################################################
# Communication Classes
#################################################################

om:Thread a owl:Class ;
    rdfs:label "Thread" ;
    rdfs:subClassOf om:Entity .

om:Post a owl:Class ;
    rdfs:label "Post" ;
    rdfs:subClassOf om:Entity .

#################################################################
# Entity and structure classes typed by the metadata projection
#################################################################

om:AccessDetails a owl:Class ;
    rdfs:label "Access Details" ;
    rdfs:comment "One lifecycle event of an asset in its source system: when it happened (om:accessTimestamp) and the user or process behind it." .

om:AiFrameworkControl a owl:Class ;
    rdfs:label "AI Framework Control" ;
    rdfs:comment "A single control within an AI governance framework, such as an article of the EU AI Act. Controls drive per-asset compliance assessments." ;
    rdfs:subClassOf om:Entity .

om:AiGovernanceFramework a owl:Class ;
    rdfs:label "AI Governance Framework" ;
    rdfs:comment "A library of AI governance controls enabled for the workspace. Enabling it applies it to in-scope AI assets." ;
    rdfs:subClassOf om:Entity .

om:AiGovernancePolicy a owl:Class ;
    rdfs:label "AI Governance Policy" ;
    rdfs:comment "An organizational policy for AI and LLM usage, such as model approval, data access, bias thresholds or cost control." ;
    rdfs:subClassOf om:Entity .

om:App a owl:Class ;
    rdfs:label "App" ;
    rdfs:comment "An installed OpenMetadata application, with its configuration, schedule and bot." ;
    rdfs:subClassOf om:Entity .

om:AppMarketPlaceDefinition a owl:Class ;
    rdfs:label "App Marketplace Definition" ;
    rdfs:comment "The marketplace definition of an OpenMetadata application that can be installed." ;
    rdfs:subClassOf om:Entity .

om:AuditReport a owl:Class ;
    rdfs:label "Audit Report" ;
    rdfs:comment "An evidence pack for AI governance, scoped to a framework, domain or single AI asset, generated asynchronously." ;
    rdfs:subClassOf om:Entity .

om:ContextFile a owl:Class ;
    rdfs:label "Context File" ;
    rdfs:comment "A file, such as a PDF, spreadsheet or document, uploaded to the Context Center drive. Knowledge extracted from it becomes context memories." ;
    rdfs:subClassOf om:Entity .

om:ContextFileContent a owl:Class ;
    rdfs:label "Context File Content" ;
    rdfs:comment "One stored content snapshot of a context file, with its extracted text and processing status." ;
    rdfs:subClassOf om:Entity .

om:ContextMemory a owl:Class ;
    rdfs:label "Context Memory" ;
    rdfs:comment "A reusable piece of context, such as a question with its answer or a piece of guidance, kept in Context Center for AI-assisted retrieval." ;
    rdfs:subClassOf om:Entity .

om:CustomProperty a owl:Class ;
    rdfs:label "Custom Property" ;
    rdfs:comment "A custom property declared on an entity type or carried by an entity: its name, type and value." .

om:DashboardDataModel a owl:Class ;
    rdfs:label "Dashboard Data Model" ;
    rdfs:comment "A data model inside a BI tool, the schema dashboards and charts are built on. It has columns and lineage like a table." ;
    rdfs:subClassOf om:DataAsset .

om:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic stored JSON document, such as a saved configuration, kept in the document store." ;
    rdfs:subClassOf om:Entity .

om:Extension a owl:Class ;
    rdfs:label "Extension" ;
    rdfs:comment "The custom property values of one entity. Each value is an om:ExtensionProperty under om:hasExtensionProperty." .

om:Folder a owl:Class ;
    rdfs:label "Folder" ;
    rdfs:comment "A folder in the Context Center drive that organizes files and other folders." ;
    rdfs:subClassOf om:Entity .

om:IngestionPipeline a owl:Class ;
    rdfs:label "Ingestion Pipeline" ;
    rdfs:comment "An OpenMetadata ingestion workflow deployed for a service, such as metadata, usage, lineage, profiler or test suite ingestion." ;
    rdfs:subClassOf om:Entity .

om:LLMService a owl:Class ;
    rdfs:label "LLM Service" ;
    rdfs:comment "A service that provides large language models, such as OpenAI, Anthropic, Azure OpenAI or AWS Bedrock." ;
    rdfs:subClassOf om:Service .

om:LearningResource a owl:Class ;
    rdfs:label "Learning Resource" ;
    rdfs:comment "An in-product tutorial, walkthrough, video or link to external guidance, shown on product surfaces." ;
    rdfs:subClassOf om:Entity .

om:LifeCycle a owl:Class ;
    rdfs:label "Life Cycle" ;
    rdfs:comment "When an asset was created, last updated and last accessed in its source system, each as an om:AccessDetails node." .

om:McpService a owl:Class ;
    rdfs:label "MCP Service" ;
    rdfs:comment "A service that discovers MCP servers from configurations, registries or individual servers." ;
    rdfs:subClassOf om:Service .

om:NotificationTemplate a owl:Class ;
    rdfs:label "Notification Template" ;
    rdfs:comment "A template that formats notifications for a type of entity change." ;
    rdfs:subClassOf om:Entity .

om:Ontology a owl:Class ;
    rdfs:label "Ontology" ;
    rdfs:comment "A governed ontology namespace. Its concepts, properties and axioms are separate entities, and its approved releases are what the ontology graphs serve." ;
    rdfs:subClassOf om:Entity .

om:OntologyAxiom a owl:Class ;
    rdfs:label "Ontology Axiom" ;
    rdfs:comment "A governed OWL axiom of an ontology, such as a subclass or disjointness statement." ;
    rdfs:subClassOf om:Entity .

om:OntologyChangeSet a owl:Class ;
    rdfs:label "Ontology Change Set" ;
    rdfs:comment "An ontology authoring session: typed operations proposed against a working revision, then submitted, applied or discarded." ;
    rdfs:subClassOf om:Entity .

om:OntologyConcept a owl:Class ;
    rdfs:label "Ontology Concept" ;
    rdfs:comment "A class, SKOS concept or both, owned by an ontology." ;
    rdfs:subClassOf om:Entity .

om:OntologyProperty a owl:Class ;
    rdfs:label "Ontology Property" ;
    rdfs:comment "An object, data or annotation property owned by an ontology." ;
    rdfs:subClassOf om:Entity .

om:OntologyRelease a owl:Class ;
    rdfs:label "Ontology Release" ;
    rdfs:comment "A sealed, immutable version of an ontology's content, reviewed through the approval workflow before it is activated." ;
    rdfs:subClassOf om:Entity .

om:Page a owl:Class ;
    rdfs:label "Page" ;
    rdfs:comment "A knowledge page in the Knowledge Center: an article or quick link, possibly with sub-pages." ;
    rdfs:subClassOf om:Entity .

om:Persona a owl:Class ;
    rdfs:label "Persona" ;
    rdfs:comment "A job function assigned to users, such as Data Engineer or Data Consumer, that shapes what they see." ;
    rdfs:subClassOf om:Entity .

om:PipelineExecution a owl:Class ;
    rdfs:label "Pipeline Execution" ;
    rdfs:comment "One run of a pipeline: start and end times, status, the agent that executed it, and the datasets it used and generated." ;
    rdfs:subClassOf prov:Activity .

om:RelationshipType a owl:Class ;
    rdfs:label "Relationship Type" ;
    rdfs:comment "An admin-governed relationship definition between glossary terms or ontology concepts, with its predicate IRI, inverse and OWL characteristics." ;
    rdfs:subClassOf om:Entity .

om:SecurityService a owl:Class ;
    rdfs:label "Security Service" ;
    rdfs:comment "A security service such as Apache Ranger that holds access policies for data." ;
    rdfs:subClassOf om:Service .

om:TestConnectionDefinition a owl:Class ;
    rdfs:label "Test Connection Definition" ;
    rdfs:comment "The steps OpenMetadata runs to test the connection to one kind of service." ;
    rdfs:subClassOf om:Entity .

om:Type a owl:Class ;
    rdfs:label "Type" ;
    rdfs:comment "A type in the metadata system: an entity type or a property type. Custom properties of an entity type are declared on it." ;
    rdfs:subClassOf om:Entity .

om:Workflow a owl:Class ;
    rdfs:label "Workflow" ;
    rdfs:comment "A unit of automation work, such as a connection test or a query run, triggered through the OpenMetadata API." ;
    rdfs:subClassOf om:Entity .

#################################################################
# Object Properties - All Relationship Types
#################################################################

om:contains a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "contains" ;
    rdfs:comment "Containment from entity relationships: the subject holds the object. Examples are a service and its databases, dashboards, topics or pipelines, a database and its schemas, a schema and its tables, a glossary or parent term and its terms, a classification and its tags, and a domain and its sub-domains or data products. The child's om:belongsTo* edges give the upward view." ;
    schema:domainIncludes om:Classification, om:Database, om:DatabaseSchema, om:Domain,
        om:Glossary, om:GlossaryTerm, om:Service, om:Tag .

om:createdBy a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "created by" ;
    rdfs:comment "Two forms. As a literal, the name of the user or bot who created the entity in OpenMetadata (the createdBy field). As an edge it comes from CREATED relationships and points from the creating user to what was created, for example user om:createdBy task: read it as created." ;
    schema:domainIncludes om:Chart, om:Container, om:Dashboard, om:DashboardDataModel,
        om:DataContract, om:Database, om:DatabaseSchema, om:MLModel,
        om:Metric, om:Pipeline, om:Query, om:Role,
        om:Table, om:Team, om:Topic, om:User ;
    rdfs:subPropertyOf prov:wasGeneratedBy .

om:repliedTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "replied to" ;
    rdfs:comment "Activity-feed relationship type. No OpenMetadata writer creates it today and feed threads are outside the projection, so the edge is normally absent." ;
    rdfs:domain om:Post ;
    rdfs:range om:Post .

om:isAbout a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "is about" ;
    rdfs:comment "Thread or post is about an entity" .

om:addressedTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "addressed to" ;
    rdfs:comment "Activity-feed relationship type. No OpenMetadata writer creates it today and feed threads are outside the projection, so the edge is normally absent." ;
    rdfs:domain om:Post ;
    rdfs:range prov:Agent .

om:mentionedIn a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "mentioned in" ;
    rdfs:comment "From an entity to a query, task, knowledge page or context memory that mentions it (MENTIONED_IN relationships)." .

om:testedBy a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "tested by" ;
    rdfs:comment "Relationship type from an asset to a test case that checks it. No OpenMetadata repository writes TESTED_BY relationships, so the edge is normally absent: a test case points at its table with om:testsEntity, so find a table's tests with ^om:testsEntity." ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:TestCase .

om:uses a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of prov:used. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "uses" ;
    rdfs:subPropertyOf prov:used .

om:owns a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "owns" ;
    rdfs:comment "From a user or team to an entity it owns (the owns field of users and teams, and OWNS relationships). The asset-side view is om:hasOwner." ;
    rdfs:domain prov:Agent ;
    rdfs:range om:Entity .

om:parentOf a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "parent of" ;
    rdfs:comment "From a parent to a child in a hierarchy kept in entity relationships, such as a parent team and its child teams, or a knowledge page and its sub-pages." ;
    schema:domainIncludes om:Page, om:Team .

om:has a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has" ;
    rdfs:comment "Generic possession from entity relationships. Examples are a domain or data product and its assets, a team and its users, a user or team and its roles, a role or team and its policies, and a dashboard and its charts. Read the subject and object types to tell which; om:belongsToDomain and om:hasDataProduct give asset membership from the asset side." ;
    schema:domainIncludes om:Dashboard, om:DataProduct, om:Domain, om:Role,
        om:Team, om:User .

om:follows a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "follows" ;
    rdfs:comment "From a user to an entity the user follows (the user's follows field)." ;
    rdfs:domain prov:Agent ;
    rdfs:range om:Entity .

om:joinedWith a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "joined with" ;
    rdfs:comment "Relationship type for tables joined in queries. OpenMetadata keeps join counts in field relationships, which the projection does not read, so this edge is normally absent; a table's om:joins value, when present, carries its join details as JSON." ;
    rdfs:domain om:Table ;
    rdfs:range om:Table .

om:upstream a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "upstream" ;
    rdfs:comment "Lineage, read from output to source: ?output om:upstream ?source. Following it reaches the assets this asset's data comes from, one edge per hop; use om:upstream+ for the whole chain. The edge's SQL, pipeline and column mappings sit on the details node the source points at with om:hasLineageDetails." ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:DataAsset .

om:downstream a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "downstream" ;
    rdfs:comment "Lineage, read from source to output: ?source om:downstream ?output, the reverse of om:upstream. Following it reaches the assets built from this one, which a change or data issue here affects; use om:downstream+ for the whole impact." ;
    schema:domainIncludes om:DataAsset ;
    owl:inverseOf om:upstream .

om:appliedTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "applied to" ;
    rdfs:comment "From a persona to a user it is assigned to, and from a metric or context memory to an entity it applies to (APPLIED_TO relationships). Tags reach entities through om:hasTag, not through this edge." ;
    schema:domainIncludes om:ContextMemory, om:Metric, om:Persona ;
    rdfs:range om:Entity .

om:relatedTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "related to" .

om:reviews a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "reviews" ;
    rdfs:comment "From a user or team to an entity or task it reviews (REVIEWS relationships), for example a task's reviewers." ;
    rdfs:domain prov:Agent ;
    rdfs:range om:Entity .

om:reactedTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "reacted to" ;
    rdfs:comment "Activity-feed relationship type. No OpenMetadata writer creates it today and feed threads are outside the projection, so the edge is normally absent." ;
    rdfs:domain prov:Agent ;
    rdfs:range om:Post .

om:voted a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "voted" ;
    rdfs:comment "From a user to an entity the user voted on. It records who voted, not whether the vote was up or down, so counting these edges does not measure popularity." ;
    rdfs:domain prov:Agent ;
    rdfs:range om:Entity .

om:expert a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "expert" ;
    rdfs:comment "From a domain, data product or metric to a user who is an expert for it (EXPERT relationships)." ;
    schema:domainIncludes om:DataProduct, om:Domain, om:Metric ;
    rdfs:range om:User .

om:editedBy a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "edited by" ;
    rdfs:comment "From a knowledge page to a user who edited it." ;
    rdfs:domain om:Entity ;
    rdfs:range prov:Agent .

om:defaultsTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "defaults to" ;
    rdfs:comment "From a domain or persona to a user for whom it is the default (DEFAULTS_TO relationships)." ;
    schema:domainIncludes om:Domain, om:Persona .

om:relatesTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "relates to" ;
    rdfs:comment "Alternative spelling of relatedTo" ;
    owl:equivalentProperty om:relatedTo .

#################################################################
# Additional Important Properties
#################################################################

om:belongsToDatabase a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "belongs to database" ;
    rdfs:comment "The database that contains a database schema, table or stored procedure. Walk it upward from a table to its catalog." ;
    schema:domainIncludes om:DatabaseSchema, om:StoredProcedure, om:Table ;
    rdfs:subPropertyOf dct:isPartOf ;
    rdfs:range om:Database .

om:belongsToSchema a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "belongs to schema" ;
    rdfs:comment "The database schema that contains a table or stored procedure." ;
    schema:domainIncludes om:StoredProcedure, om:Table ;
    rdfs:subPropertyOf dct:isPartOf ;
    rdfs:range om:DatabaseSchema .

om:belongsToService a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "belongs to service" ;
    rdfs:comment "The service that hosts the asset: its database, dashboard, messaging, pipeline, storage, drive, search, API or ML model service. Follow it to group assets by source system; the service's om:serviceType names the technology." ;
    rdfs:subPropertyOf dcat:accessService ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:Service .

om:Column a owl:Class ;
    rdfs:label "Column" ;
    rdfs:comment "A column of a table, dashboard data model, file or worksheet, at an IRI derived from its fully qualified name. It carries its name (rdfs:label), data type, description, position, nullability, tags and nested columns (om:hasChildColumn), and it is the endpoint of column lineage." ;
    rdfs:subClassOf om:Entity .

om:TableConstraint a owl:Class ;
    rdfs:label "Table Constraint" ;
    rdfs:comment "A constraint (primary key, foreign key, unique, etc.) declared on a table." ;
    rdfs:subClassOf om:Entity .

om:ConstraintMember a owl:Class ;
    rdfs:label "Constraint Member" ;
    rdfs:comment "One column of a table constraint at its position in the key, with the column it refers to for a foreign key. A composite key has one member per column; the key as a whole is unique, not each member." ;
    rdfs:subClassOf om:Entity .

om:hasConstraintMember a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has constraint member" ;
    rdfs:comment "A member of this constraint, one per column, numbered by om:memberPosition. Read the members in position order to know a key's column order, or to pair each foreign key column with the column it references before writing a join on a composite key." ;
    rdfs:domain om:TableConstraint ;
    rdfs:range om:ConstraintMember .

om:memberPosition a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "member position" ;
    rdfs:comment "Position of the member's column in the constraint, counted from 1 in the order the constraint declares its columns." ;
    rdfs:domain om:ConstraintMember ;
    rdfs:range xsd:int .

om:memberColumn a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "member column" ;
    rdfs:comment "The column of the constrained table at this position of the constraint." ;
    rdfs:domain om:ConstraintMember ;
    rdfs:range om:Column .

om:memberReferredColumn a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "member referred column" ;
    rdfs:comment "For a foreign key, the column the member column references: join om:memberColumn to om:memberReferredColumn for every member of the constraint, not for a subset, or the join multiplies rows." ;
    rdfs:domain om:ConstraintMember ;
    rdfs:range om:Column .

om:LineageDetails a owl:Class ;
    rdfs:label "Lineage Details" ;
    rdfs:comment "Reified details of a lineage edge, including column-level mappings and the pipeline that produced it." ;
    rdfs:subClassOf om:Entity .

om:hasColumn a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has column" ;
    rdfs:comment "A column of a table, dashboard data model, file or worksheet. Each column is an om:Column node with om:fullyQualifiedName, its data type and its tags; nested struct columns hang under om:hasChildColumn. Column lineage and column quality evidence attach to these nodes." ;
    schema:domainIncludes om:DashboardDataModel, om:File, om:Table, om:Worksheet ;
    rdfs:range om:Column .

om:hasTag a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has tag" ;
    rdfs:comment "A tag or glossary term applied to the entity, one edge per tag label. The object is the tag's or term's node with om:tagFQN and om:tagSource. Glossary terms are also reachable through om:hasGlossaryTerm and tier tags through om:hasTier; column tags hang off the column nodes." ;
    rdfs:domain om:Entity ;
    rdfs:range skos:Concept .

om:hasGlossaryTerm a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has glossary term" ;
    rdfs:comment "A glossary term applied to the entity as a label (a tag label whose source is Glossary). Follow it backwards from a term to find the assets that carry a business concept; the same term also appears under om:hasTag." ;
    rdfs:subPropertyOf dct:subject ;
    rdfs:domain om:Entity ;
    rdfs:range om:GlossaryTerm .

om:mappedTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "mapped to" ;
    rdfs:comment "Data asset that stores the instances of this concept. Stronger than om:hasGlossaryTerm, which only records that an asset references the concept." ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:DataAsset .

om:hasPrimaryStore a owl:ObjectProperty, owl:FunctionalProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of om:mappedTo. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has primary store" ;
    rdfs:comment "Data asset holding the instances of record for this concept. A concept has at most one." ;
    rdfs:subPropertyOf om:mappedTo ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:DataAsset .

om:hasDerivedAsset a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of om:mappedTo. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has derived asset" ;
    rdfs:comment "Data asset deriving this concept's instances from another asset." ;
    rdfs:subPropertyOf om:mappedTo ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:DataAsset .

om:hasReplica a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of om:mappedTo. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has replica" ;
    rdfs:comment "Data asset replicating this concept's instances from another asset." ;
    rdfs:subPropertyOf om:mappedTo ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range om:DataAsset .

om:boundAsset a rdf:Property, owl:AnnotationProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "bound asset" ;
    rdfs:comment "Catalog asset that implements an Ontology Studio concept. The subject is the concept under the IRI its ontology's active release gives it, so the concept's definition is in that release's graph; the object is the asset's catalog node. Follow it to go from a business term to the tables, topics or dashboards that hold its data, then om:hasColumn for the columns. Only concepts of an active release carry it; a binding to a draft concept appears once a release holding the concept is activated. The bindings API leaves out assets a reader cannot view; this edge does not." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range om:DataAsset .

om:boundColumn a rdf:Property, owl:AnnotationProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "bound column" ;
    rdfs:comment "Column that holds the values of an Ontology Studio property, such as Customer.email bound to customers.cust_email. The subject is the property under the IRI its ontology's active release gives it; the object is the om:Column node om:hasColumn reaches. Use it to turn a question about a business attribute into the column to select or filter. The edge does not say which concept the assignment was made for; a property shared by several concepts can point at columns of several assets. A column path that no longer resolves is left out." ;
    rdfs:domain rdf:Property ;
    rdfs:range om:Column .

om:hasOwner a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has owner" ;
    rdfs:subPropertyOf dcat:contactPoint ;
    rdfs:comment "An owner of the entity: a user or team accountable for it (the owners field). Follow it to find who to ask about an asset; om:owns is the owner-side view and prov:wasAttributedTo mirrors it." ;
    rdfs:domain om:Entity ;
    rdfs:range prov:Agent .

om:memberOf a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "member of" ;
    rdfs:comment "A team the user belongs to; on a role or policy, a team that has the role or uses the policy directly (the teams field)." ;
    rdfs:range om:Team ;
    schema:domainIncludes om:Policy, om:Role, om:User .

om:creates a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "creates" ;
    rdfs:domain om:User ;
    rdfs:range om:Thread .

om:containsPosts a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "contains posts" ;
    rdfs:domain om:Thread ;
    rdfs:range om:Post .

#################################################################
# DCAT 3 Properties - Core Dataset Properties
#################################################################

om:inSeries a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:inSeries. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "in series" ;
    rdfs:subPropertyOf dcat:inSeries ;
    rdfs:comment "Links a dataset to its series" ;
    rdfs:domain om:Table ;
    rdfs:range om:DatasetSeries .

om:servesDataset a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:servesDataset. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "serves dataset" ;
    rdfs:subPropertyOf dcat:servesDataset ;
    rdfs:comment "Links a data service to datasets it serves" ;
    rdfs:domain om:Service ;
    rdfs:range om:DataAsset .

om:distribution a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:distribution. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "distribution" ;
    rdfs:subPropertyOf dcat:distribution ;
    rdfs:comment "Available distribution of the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:Distribution .

om:landingPage a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:landingPage. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "landing page" ;
    rdfs:subPropertyOf dcat:landingPage ;
    rdfs:comment "Web page providing access and information" ;
    rdfs:domain om:Entity ;
    rdfs:range foaf:Document .

om:theme a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:theme. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "theme" ;
    rdfs:subPropertyOf dcat:theme ;
    rdfs:comment "Main category of the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range skos:Concept .

om:keyword a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:keyword. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "keyword" ;
    rdfs:subPropertyOf dcat:keyword ;
    rdfs:comment "Keywords describing the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:string .

om:contactPoint a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:contactPoint. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "contact point" ;
    rdfs:subPropertyOf dcat:contactPoint ;
    rdfs:comment "Contact information for the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range vcard:Kind .

om:temporal a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:temporal. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "temporal coverage" ;
    rdfs:subPropertyOf dcat:temporal ;
    rdfs:comment "Temporal period covered by the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:PeriodOfTime .

om:spatial a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:spatial. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "spatial coverage" ;
    rdfs:subPropertyOf dcat:spatial ;
    rdfs:comment "Spatial area covered by the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:Location .

om:accrualPeriodicity a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:accrualPeriodicity. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "accrual periodicity" ;
    rdfs:subPropertyOf dcat:accrualPeriodicity ;
    rdfs:comment "Frequency of dataset updates" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:Frequency .

om:language a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:language. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "language" ;
    rdfs:subPropertyOf dcat:language ;
    rdfs:comment "Language of the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range dct:LinguisticSystem .

om:publisher a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:publisher. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "publisher" ;
    rdfs:subPropertyOf dcat:publisher ;
    rdfs:comment "Entity responsible for making the dataset available" ;
    rdfs:domain om:DataAsset ;
    rdfs:range prov:Agent .

om:issued a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:issued. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "issued" ;
    rdfs:subPropertyOf dcat:issued ;
    rdfs:comment "Date of formal issuance" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:dateTime .

om:license a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:license. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "license" ;
    rdfs:subPropertyOf dcat:license ;
    rdfs:comment "License under which the dataset is available" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:LicenseDocument .

om:rights a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:rights. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "rights" ;
    rdfs:subPropertyOf dcat:rights ;
    rdfs:comment "Rights statement for the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:RightsStatement .

om:accessRights a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:accessRights. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "access rights" ;
    rdfs:subPropertyOf dcat:accessRights ;
    rdfs:comment "Information about access restrictions" ;
    rdfs:domain om:DataAsset ;
    rdfs:range dct:RightsStatement .

om:endpointURL a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:endpointURL. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "endpoint URL" ;
    rdfs:subPropertyOf dcat:endpointURL ;
    rdfs:domain om:Service ;
    rdfs:range xsd:anyURI .

om:endpointDescription a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:endpointDescription. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "endpoint description" ;
    rdfs:subPropertyOf dcat:endpointDescription ;
    rdfs:domain om:Service ;
    rdfs:range xsd:string .

#################################################################
# DCAT Distribution Properties
#################################################################

om:accessURL a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:accessURL. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "access URL" ;
    rdfs:subPropertyOf dcat:accessURL ;
    rdfs:comment "URL to access the distribution" ;
    rdfs:domain om:Distribution ;
    rdfs:range rdfs:Resource .

om:downloadURL a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:downloadURL. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "download URL" ;
    rdfs:subPropertyOf dcat:downloadURL ;
    rdfs:comment "Direct download URL" ;
    rdfs:domain om:Distribution ;
    rdfs:range rdfs:Resource .

om:format a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "format" ;
    rdfs:subPropertyOf dcat:format ;
    rdfs:comment "Output format of an audit report (om:AuditReport)." ;
    schema:domainIncludes om:AuditReport .

om:mediaType a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:mediaType. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "media type" ;
    rdfs:subPropertyOf dcat:mediaType ;
    rdfs:comment "Media type of the distribution" ;
    rdfs:domain om:Distribution ;
    rdfs:range om:MediaType .

om:byteSize a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:byteSize. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "byte size" ;
    rdfs:subPropertyOf dcat:byteSize ;
    rdfs:comment "Size in bytes" ;
    rdfs:domain om:Distribution ;
    rdfs:range xsd:nonNegativeInteger .

om:compressFormat a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:compressFormat. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "compression format" ;
    rdfs:subPropertyOf dcat:compressFormat ;
    rdfs:comment "Compression format of the distribution" ;
    rdfs:domain om:Distribution ;
    rdfs:range om:MediaType .

om:packageFormat a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:packageFormat. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "package format" ;
    rdfs:subPropertyOf dcat:packageFormat ;
    rdfs:comment "Package format of the distribution" ;
    rdfs:domain om:Distribution ;
    rdfs:range om:MediaType .

#################################################################
# DCAT Catalog Properties
#################################################################

om:dataset a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:dataset. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "dataset" ;
    rdfs:subPropertyOf dcat:dataset ;
    rdfs:comment "Dataset that is part of the catalog" ;
    rdfs:domain om:Catalog ;
    rdfs:range om:DataAsset .

om:service a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "service" ;
    rdfs:subPropertyOf dcat:service ;
    rdfs:comment "The service of an LLM model, MCP server or ingestion pipeline, as the referenced service's JSON text rather than a graph edge. Data assets use om:belongsToService instead." ;
    schema:domainIncludes om:IngestionPipeline, om:LLMModel, om:McpServer .

om:catalog a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:catalog. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "catalog" ;
    rdfs:subPropertyOf dcat:catalog ;
    rdfs:comment "Sub-catalog" ;
    rdfs:domain om:Catalog ;
    rdfs:range om:Catalog .

om:themeTaxonomy a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:themeTaxonomy. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "theme taxonomy" ;
    rdfs:subPropertyOf dcat:themeTaxonomy ;
    rdfs:comment "Knowledge organization system for categorizing datasets" ;
    rdfs:domain om:Catalog ;
    rdfs:range skos:ConceptScheme .

om:homepage a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of foaf:homepage. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "homepage" ;
    rdfs:subPropertyOf foaf:homepage ;
    rdfs:comment "Homepage of the catalog" ;
    rdfs:domain om:Catalog ;
    rdfs:range foaf:Document .

om:temporalResolution a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:temporalResolution. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "temporal resolution" ;
    rdfs:subPropertyOf dcat:temporalResolution ;
    rdfs:comment "Minimum time period resolvable in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:duration .

om:spatialResolution a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:spatialResolutionInMeters. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "spatial resolution" ;
    rdfs:subPropertyOf dcat:spatialResolutionInMeters ;
    rdfs:comment "Minimum spatial separation resolvable in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:decimal .

#################################################################
# DCAT Quality Properties
#################################################################

om:hasQualityMeasurement a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:hasQualityMeasurement. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has quality measurement" ;
    rdfs:subPropertyOf dcat:hasQualityMeasurement ;
    rdfs:comment "Quality measurement for the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range dqv:QualityMeasurement .

om:hasQualityAnnotation a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:hasQualityAnnotation. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has quality annotation" ;
    rdfs:subPropertyOf dcat:hasQualityAnnotation ;
    rdfs:comment "Quality annotation for the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range oa:Annotation .

om:conformsToStandard a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:conformsTo. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "conforms to standard" ;
    rdfs:subPropertyOf dcat:conformsTo ;
    rdfs:comment "Standard the dataset conforms to" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:Standard .

om:checksum a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "checksum" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Query: a checksum used to avoid registering the same query twice. On om:File: the file's checksum. On om:ContextFileContent: the SHA-256 checksum of the stored content." ;
    schema:domainIncludes om:ContextFileContent, om:File, om:Query .

om:hadRole a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:hadRole. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "had role" ;
    rdfs:subPropertyOf dcat:hadRole ;
    rdfs:comment "Role in a qualified relationship" ;
    rdfs:domain om:QualifiedRelationship ;
    rdfs:range dcat:Role .

om:qualifiedRelation a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:qualifiedRelation. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "qualified relation" ;
    rdfs:subPropertyOf dcat:qualifiedRelation ;
    rdfs:comment "Link to a qualified relationship" ;
    rdfs:domain om:Entity ;
    rdfs:range om:QualifiedRelationship .

#################################################################
# DCAT Versioning Properties
#################################################################

om:version a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:version. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "version" ;
    rdfs:subPropertyOf dcat:version ;
    rdfs:comment "Version identifier" ;
    rdfs:domain om:Entity ;
    rdfs:range xsd:string .

om:versionNotes a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of adms:versionNotes. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "version notes" ;
    rdfs:subPropertyOf adms:versionNotes ;
    rdfs:comment "Notes about this version" ;
    rdfs:domain om:Entity ;
    rdfs:range xsd:string .

om:isVersionOf a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:isVersionOf. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "is version of" ;
    rdfs:subPropertyOf dcat:isVersionOf ;
    rdfs:comment "Links to the non-versioned or abstract dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:DataAsset .

om:hasVersion a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:hasVersion. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has version" ;
    rdfs:subPropertyOf dcat:hasVersion ;
    owl:inverseOf om:isVersionOf ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:DataAsset .

om:previousVersion a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:previousVersion. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "previous version" ;
    rdfs:subPropertyOf dcat:previousVersion ;
    rdfs:comment "Link to previous version" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:DataAsset .

om:first a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:first. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "first" ;
    rdfs:subPropertyOf dcat:first ;
    rdfs:comment "First dataset in a series" ;
    rdfs:domain om:DatasetSeries ;
    rdfs:range om:DataAsset .

om:last a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:last. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "last" ;
    rdfs:subPropertyOf dcat:last ;
    rdfs:comment "Last dataset in a series" ;
    rdfs:domain om:DatasetSeries ;
    rdfs:range om:DataAsset .

om:prev a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:prev. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "previous" ;
    rdfs:subPropertyOf dcat:prev ;
    rdfs:comment "Previous dataset in a series" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:DataAsset .

om:next a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:next. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "next" ;
    rdfs:subPropertyOf dcat:next ;
    rdfs:comment "Next dataset in a series" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:DataAsset .

#################################################################
# Catalog-specific Properties
#################################################################

om:record a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:record. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "record" ;
    rdfs:subPropertyOf dcat:record ;
    rdfs:comment "Links catalog to its records" ;
    rdfs:domain om:Database ;
    rdfs:range om:CatalogRecord .

om:primaryTopic a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of foaf:primaryTopic. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "primary topic" ;
    rdfs:subPropertyOf foaf:primaryTopic ;
    rdfs:comment "Main entity described by this record" ;
    rdfs:domain om:CatalogRecord ;
    rdfs:range om:Entity .

om:cataloged a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "cataloged" ;
    rdfs:comment "Date when entity was added to catalog" ;
    rdfs:domain om:CatalogRecord ;
    rdfs:range xsd:dateTime .

om:conformsTo a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:conformsTo. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "conforms to" ;
    rdfs:subPropertyOf dct:conformsTo ;
    rdfs:comment "Standard or schema that the resource conforms to" ;
    rdfs:domain om:Entity ;
    rdfs:range dct:Standard .

#################################################################
# DCAT Provenance Properties
#################################################################

om:wasGeneratedBy a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of prov:wasGeneratedBy. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "was generated by" ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:comment "Activity that generated the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range prov:Activity .

om:wasDerivedFrom a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of prov:wasDerivedFrom. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "was derived from" ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:comment "Source dataset this was derived from" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:DataAsset .

om:qualifiedAttribution a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of prov:qualifiedAttribution. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "qualified attribution" ;
    rdfs:subPropertyOf prov:qualifiedAttribution ;
    rdfs:comment "Detailed attribution with roles" ;
    rdfs:domain om:DataAsset ;
    rdfs:range prov:Attribution .

om:qualifiedDerivation a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of prov:qualifiedDerivation. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "qualified derivation" ;
    rdfs:subPropertyOf prov:qualifiedDerivation ;
    rdfs:comment "Detailed derivation with transformation info" ;
    rdfs:domain om:DataAsset ;
    rdfs:range prov:Derivation .

om:provenance a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "provenance" ;
    rdfs:subPropertyOf dct:provenance ;
    rdfs:comment "How an ontology axiom (om:OntologyAxiom) came to exist (its provenance field)." ;
    schema:domainIncludes om:OntologyAxiom .

om:source a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "source" ;
    rdfs:subPropertyOf dct:source ;
    rdfs:comment "Its meaning depends on the entity type. On om:LearningResource: where the resource lives, as JSON text. On om:AiGovernanceFramework: where the framework definition comes from." ;
    schema:domainIncludes om:AiGovernanceFramework, om:LearningResource .

#################################################################
# Datatype Properties
#################################################################

om:fullyQualifiedName a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "fully qualified name" ;
    rdfs:subPropertyOf dct:identifier ;
    rdfs:comment "Unique identifier for the entity within OpenMetadata" ;
    rdfs:domain om:Entity ;
    rdfs:range xsd:string .

om:serviceType a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "service type" ;
    rdfs:comment "The technology of a service, such as Snowflake, Looker, Kafka or Airflow." ;
    rdfs:subPropertyOf dct:type ;
    rdfs:domain om:Service ;
    rdfs:range xsd:string .

om:description a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:description. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "description" ;
    rdfs:subPropertyOf dct:description ;
    rdfs:domain om:Entity ;
    rdfs:range xsd:string .

om:created a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:created. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "created" ;
    rdfs:subPropertyOf dct:created ;
    rdfs:domain om:Entity ;
    rdfs:range xsd:dateTime .

om:modified a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:modified. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "modified" ;
    rdfs:subPropertyOf dct:modified ;
    rdfs:domain om:Entity ;
    rdfs:range xsd:dateTime .

#################################################################
# CSVW Tabular Data Metadata (for Tables)
#################################################################

om:rowCount a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "row count" ;
    rdfs:comment "Number of rows in a worksheet, as its drive connector reports it. Tables carry the profiled count as om:profileRowCount instead." ;
    rdfs:domain om:Worksheet .

om:columnCount a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "column count" ;
    rdfs:comment "Number of columns in a worksheet, as its drive connector reports it. Tables carry the profiled count as om:profileColumnCount instead." ;
    rdfs:domain om:Worksheet .

om:columnDataType a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "column data type" ;
    rdfs:subPropertyOf csvw:datatype ;
    rdfs:comment "The column's data type as OpenMetadata normalizes it, such as VARCHAR, INT, TIMESTAMP or STRUCT, whatever the source system called it." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:string .

om:columnDescription a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "column description" ;
    rdfs:comment "The column's description as written in OpenMetadata, usually Markdown. Read it for what the column means." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:string .

om:isPrimaryKey a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "is primary key" ;
    rdfs:comment "True for every column of the table's primary key, each member of a composite key included. A member of a composite key is not unique on its own: om:isUnique says when a column is, and the key's om:TableConstraint lists its members in order." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:boolean .

om:isNullable a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "is nullable" ;
    rdfs:subPropertyOf csvw:null ;
    rdfs:comment "Whether the column may hold nulls: false for a NOT_NULL or primary-key column, true for an explicit NULL constraint. Absent when the source declared neither, so a missing value does not mean nullable." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:boolean .

om:sampleData a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "sample data" ;
    rdfs:comment "Sample data from the table" ;
    rdfs:domain om:Table ;
    rdfs:range csvw:TableGroup .

#################################################################
# Enhanced Lineage Properties (PROV-O aligned)
#################################################################

om:lineageSource a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "lineage source" ;
    rdfs:comment "How the lineage edge was created, such as Manual, QueryLineage, PipelineLineage, DbtLineage or ViewLineage." ;
    rdfs:domain om:LineageDetails ;
    rdfs:range xsd:string .

om:sqlQuery a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "SQL query" ;
    rdfs:comment "On a lineage details node, the SQL that produced the lineage edge; the edge's prov:Plan holds the same text." ;
    rdfs:domain om:LineageDetails ;
    rdfs:range xsd:string .

om:transformationFunction a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "transformation function" ;
    rdfs:comment "Function applied to transform data" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:string .

om:ColumnLineage a owl:Class ;
    rdfs:label "Column lineage" ;
    rdfs:comment "One column-level mapping of a lineage edge: the source columns and the target column it produces." .

om:fromColumn a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "from column" ;
    rdfs:subPropertyOf prov:used ;
    rdfs:comment "On a column mapping (om:ColumnLineage), a source column the target column is computed from; a mapping can name several. The object is the same om:Column node om:hasColumn reaches, so it joins with the column's tags; om:fromColumnFqn carries its name. Stores not rebuilt since 2.1 may hold the name as a literal here." ;
    rdfs:domain om:ColumnLineage ;
    rdfs:range om:Column .

om:toColumn a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "to column" ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:comment "On a column mapping (om:ColumnLineage), the target column the mapping produces. The object is the same om:Column node om:hasColumn reaches; om:toColumnFqn carries its name. Stores not rebuilt since 2.1 may hold the name as a literal here." ;
    rdfs:domain om:ColumnLineage ;
    rdfs:range om:Column .

om:lineageCreatedBy a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "lineage created by" ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:comment "Name of the user who created the lineage edge, as text; prov:wasAssociatedWith on the same node points at that user." ;
    rdfs:domain om:LineageDetails .

om:lineageCreatedAt a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of prov:generatedAtTime. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "lineage created at" ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:comment "When the lineage was created" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:dateTime .

om:pipeline a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of prov:wasGeneratedBy. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "pipeline" ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:comment "Pipeline that processes the data" ;
    rdfs:domain om:DataAsset ;
    rdfs:range om:Pipeline .

#################################################################
# Data Product Properties (DPROD aligned)
#################################################################

om:InputPort a owl:Class ;
    rdfs:label "Input Port" ;
    rdfs:comment "Input port of a data product for consuming data" ;
    rdfs:subClassOf dprod:InputPort, dcat:DataService .

om:OutputPort a owl:Class ;
    rdfs:label "Output Port" ;
    rdfs:comment "Output port of a data product for exposing data" ;
    rdfs:subClassOf dprod:OutputPort, dcat:DataService .

om:DataProductSLA a owl:Class ;
    rdfs:label "Data Product SLA" ;
    rdfs:comment "Service Level Agreement for a data product" ;
    rdfs:subClassOf dprod:ServiceLevelAgreement .

om:dataProductAssets a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "data product assets" ;
    rdfs:comment "Assets that are part of this data product" ;
    rdfs:domain om:DataProduct ;
    rdfs:range om:DataAsset .

om:dataProductDomain a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "data product domain" ;
    rdfs:comment "Domain this data product belongs to" ;
    rdfs:domain om:DataProduct ;
    rdfs:range om:Domain .

om:dataProductOwner a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:contactPoint. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "data product owner" ;
    rdfs:subPropertyOf dcat:contactPoint ;
    rdfs:comment "Owner of the data product" ;
    rdfs:domain om:DataProduct ;
    rdfs:range prov:Agent .

om:dataProductExpert a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "data product expert" ;
    rdfs:comment "Expert for this data product" ;
    rdfs:domain om:DataProduct ;
    rdfs:range prov:Agent .

om:hasInputPort a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dprod:hasInputPort. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has input port" ;
    rdfs:subPropertyOf dprod:hasInputPort ;
    rdfs:comment "Input port of the data product" ;
    rdfs:domain om:DataProduct ;
    rdfs:range om:InputPort .

om:hasOutputPort a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dprod:hasOutputPort. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has output port" ;
    rdfs:subPropertyOf dprod:hasOutputPort ;
    rdfs:comment "Output port of the data product" ;
    rdfs:domain om:DataProduct ;
    rdfs:range om:OutputPort .

om:portName a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "port name" ;
    rdfs:comment "Name of the port" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( om:InputPort om:OutputPort ) ] ;
    rdfs:range xsd:string .

om:portProtocol a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "port protocol" ;
    rdfs:comment "Protocol used by the port (REST, GRPC, KAFKA, etc.)" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( om:InputPort om:OutputPort ) ] ;
    rdfs:range xsd:string .

om:portFormat a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "port format" ;
    rdfs:comment "Data format supported by the port (JSON, CSV, PARQUET, etc.)" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( om:InputPort om:OutputPort ) ] ;
    rdfs:range xsd:string .

om:portEndpoint a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:endpointURL. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "port endpoint" ;
    rdfs:subPropertyOf dcat:endpointURL ;
    rdfs:comment "Endpoint URL or connection string for the port" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( om:InputPort om:OutputPort ) ] ;
    rdfs:range xsd:anyURI .

om:portDataAsset a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "port data asset" ;
    rdfs:comment "Data asset exposed through this port" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( om:InputPort om:OutputPort ) ] ;
    rdfs:range om:DataAsset .

om:lifecycleStage a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "lifecycle stage" ;
    rdfs:comment "Current lifecycle stage (IDEATION, DESIGN, DEVELOPMENT, TESTING, PRODUCTION, DEPRECATED, RETIRED)" ;
    rdfs:domain om:DataProduct ;
    rdfs:range xsd:string .

om:hasSLA a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "has SLA" ;
    rdfs:comment "Service Level Agreement for the data product" ;
    rdfs:domain om:DataProduct ;
    rdfs:range om:DataProductSLA .

om:slaTier a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "SLA tier" ;
    rdfs:comment "SLA tier level (GOLD, SILVER, BRONZE)" ;
    rdfs:domain om:DataProductSLA ;
    rdfs:range xsd:string .

om:slaAvailability a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "SLA availability" ;
    rdfs:comment "Expected availability percentage" ;
    rdfs:domain om:DataProductSLA ;
    rdfs:range xsd:decimal .

om:slaResponseTime a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "SLA response time" ;
    rdfs:comment "Expected response time in milliseconds" ;
    rdfs:domain om:DataProductSLA ;
    rdfs:range xsd:integer .

om:slaDataFreshness a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "SLA data freshness" ;
    rdfs:comment "Maximum data staleness in minutes" ;
    rdfs:domain om:DataProductSLA ;
    rdfs:range xsd:integer .

om:slaDataQuality a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "SLA data quality" ;
    rdfs:comment "Minimum data quality score" ;
    rdfs:domain om:DataProductSLA ;
    rdfs:range xsd:decimal .

om:consumesFrom a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "consumes from" ;
    rdfs:subPropertyOf dprod:consumesFrom ;
    rdfs:comment "Other data products this data product consumes data from, as the JSON of their references rather than graph edges." ;
    rdfs:domain om:DataProduct .

om:providesTo a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "provides to" ;
    rdfs:subPropertyOf dprod:providesTo ;
    rdfs:comment "Other data products that consume data from this data product, as the JSON of their references rather than graph edges." ;
    rdfs:domain om:DataProduct .

#################################################################
# Additional DCAT Dataset Properties
#################################################################

om:identifier a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:identifier. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "identifier" ;
    rdfs:subPropertyOf dct:identifier ;
    rdfs:comment "Unique identifier of the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range rdfs:Literal .

om:title a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "title" ;
    rdfs:subPropertyOf dct:title ;
    rdfs:comment "Short title of a context memory, shown in Context Center." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range rdfs:Literal .

om:creator a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:creator. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "creator" ;
    rdfs:subPropertyOf dct:creator ;
    rdfs:comment "Entity primarily responsible for creating the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range prov:Agent .

om:contributor a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:contributor. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "contributor" ;
    rdfs:subPropertyOf dct:contributor ;
    rdfs:comment "Entity responsible for contributions to the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range prov:Agent .

om:type a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:type. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "type" ;
    rdfs:subPropertyOf dct:type ;
    rdfs:comment "Nature or genre of the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range rdfs:Class .

om:isReferencedBy a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:isReferencedBy. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "is referenced by" ;
    rdfs:subPropertyOf dct:isReferencedBy ;
    rdfs:comment "Related resource that references this dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range rdfs:Resource .

om:relation a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dct:relation. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "relation" ;
    rdfs:subPropertyOf dct:relation ;
    rdfs:comment "Related resource" ;
    rdfs:domain om:DataAsset ;
    rdfs:range rdfs:Resource .

om:hasPolicy a owl:ObjectProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "has policy" ;
    rdfs:subPropertyOf odrl:hasPolicy ;
    rdfs:comment "A policy attached to a role or team (its policies field). The policy's rules decide what members may do." ;
    schema:domainIncludes om:Role, om:Team ;
    rdfs:range om:Policy .

om:qualifiedAccess a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "qualified access" ;
    rdfs:comment "Qualified access information including authentication and authorization" ;
    rdfs:domain om:DataAsset ;
    rdfs:range dcat:Relationship .

#################################################################
# Data Quality Properties
#################################################################

om:accuracy a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "accuracy" ;
    rdfs:comment "Degree of data accuracy" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:decimal .

om:completeness a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "completeness" ;
    rdfs:comment "Degree of data completeness" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:decimal .

om:consistency a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "consistency" ;
    rdfs:comment "Degree of data consistency" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:decimal .

om:timeliness a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "timeliness" ;
    rdfs:comment "How current the data is" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:string .

om:validity a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "validity" ;
    rdfs:comment "Degree to which data conforms to defined rules" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:decimal .

om:uniqueness a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "uniqueness" ;
    rdfs:comment "Degree of uniqueness in the data" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:decimal .

#################################################################
# Geospatial Properties (DCAT-aligned)
#################################################################

om:bbox a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:bbox. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "bounding box" ;
    rdfs:subPropertyOf dcat:bbox ;
    rdfs:comment "Geographic bounding box" ;
    rdfs:domain om:DataAsset ;
    rdfs:range rdfs:Literal .

om:centroid a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:centroid. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "centroid" ;
    rdfs:subPropertyOf dcat:centroid ;
    rdfs:comment "Geographic center point" ;
    rdfs:domain om:DataAsset ;
    rdfs:range rdfs:Literal .

om:geometry a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of locn:geometry. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "geometry" ;
    rdfs:subPropertyOf locn:geometry ;
    rdfs:comment "Geometry of the spatial area" ;
    rdfs:domain om:Location ;
    rdfs:range rdfs:Literal .

#################################################################
# Temporal Properties (DCAT-aligned)
#################################################################

om:startDate a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of dcat:startDate. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "start date" ;
    rdfs:subPropertyOf dcat:startDate ;
    rdfs:comment "Start of the temporal period" ;
    rdfs:domain om:PeriodOfTime ;
    rdfs:range xsd:dateTime .

om:endDate a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:label "end date" ;
    rdfs:subPropertyOf dcat:endDate ;
    rdfs:comment "End date of the pipeline's schedule, as text." ;
    schema:domainIncludes om:Pipeline .

om:hasBeginning a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of time:hasBeginning. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has beginning" ;
    rdfs:subPropertyOf time:hasBeginning ;
    rdfs:comment "Beginning instant of the temporal period" ;
    rdfs:domain om:PeriodOfTime ;
    rdfs:range time:Instant .

om:hasEnd a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Vocabulary alias of time:hasEnd. Custom rules or externally supplied triples are required; the subPropertyOf axiom does not materialize this alias." ;
    rdfs:label "has end" ;
    rdfs:subPropertyOf time:hasEnd ;
    rdfs:comment "Ending instant of the temporal period" ;
    rdfs:domain om:PeriodOfTime ;
    rdfs:range time:Instant .

#################################################################
# Statistical Properties (STAT-DCAT aligned)
#################################################################

om:numberOfRecords a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "number of records" ;
    rdfs:comment "Number of records in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range xsd:integer .

om:numberOfColumns a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "number of columns" ;
    rdfs:comment "Number of columns in the dataset" ;
    rdfs:domain om:Table ;
    rdfs:range xsd:integer .

om:statisticalUnit a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "statistical unit" ;
    rdfs:comment "Unit of observation in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range skos:Concept .

om:dimension a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "dimension" ;
    rdfs:comment "Dimension represented in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range qb:DimensionProperty .

om:measure a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "measure" ;
    rdfs:comment "Measure represented in the dataset" ;
    rdfs:domain om:DataAsset ;
    rdfs:range qb:MeasureProperty .

#################################################################
# Service-specific Properties
#################################################################

om:serviceEndpoint a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "service endpoint" ;
    rdfs:comment "Endpoint for accessing the service" ;
    rdfs:domain om:DataService ;
    rdfs:range rdfs:Resource .

om:serviceStatus a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "service status" ;
    rdfs:comment "Operational status of the service" ;
    rdfs:domain om:DataService ;
    rdfs:range xsd:string .

om:serviceLevel a owl:DatatypeProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "service level" ;
    rdfs:comment "Service level agreement details" ;
    rdfs:domain om:DataService ;
    rdfs:range xsd:string .

om:apiDocumentation a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection. Retained for custom inference or externally supplied ontology data; there is no built-in derivation for this property." ;
    rdfs:label "API documentation" ;
    rdfs:comment "Link to API documentation" ;
    rdfs:domain om:DataService ;
    rdfs:range foaf:Document .


#################################################################
# Projection availability
#################################################################

om:projectionStatus a owl:AnnotationProperty ;
    rdfs:label "projection status" ;
    rdfs:comment "Whether a property is asserted by the metadata projection (Stored) or is vocabulary for custom inference/external data only (InferenceOnly). This annotation does not enable inference." .

om:statusProperty a owl:AnnotationProperty ;
    rdfs:label "status property" ;
    rdfs:comment "A property whose value says how a node of the annotated class stands, such as a test case's latest result. A reader of the graph can count the nodes on the other side of a relationship by it: by value for a value, by presence for a relationship. It is an annotation and entails nothing." .

om:TestCase om:statusProperty om:latestResultStatus, om:hasOpenIncident .

om:TestCaseIncident om:statusProperty om:incidentState, om:incidentSeverity, om:incidentAssignee .

om:Stored rdfs:label "stored" ;
    rdfs:comment "Asserted when the corresponding metadata field or relationship is populated. Queryable with inference=none; optional fields need not exist on every entity." .

om:InferenceOnly rdfs:label "inference or external data only" ;
    rdfs:comment "Not asserted by the metadata projection. Requires custom rules or externally supplied data. Merely enabling RDFS/OWL does not guarantee this property is present, especially for aliases declared only as subproperties." .

schema:domainIncludes a owl:AnnotationProperty ;
    rdfs:label "domain includes" ;
    rdfs:comment "A class whose nodes the metadata projection writes this predicate on, recorded for a predicate shared by several classes whose rdfs:domain is left open. It is an annotation and entails nothing about the subject. A class's entry in ontology_describe lists the shared predicates recorded for it." .

om:UPSTREAM a owl:ObjectProperty ;
    om:projectionStatus om:InferenceOnly ;
    owl:deprecated true ;
    owl:inverseOf om:upstream ;
    rdfs:label "legacy source-to-output lineage" ;
    rdfs:comment "Not emitted by the metadata projection. Legacy source-to-output alias of om:downstream, supported by readers until a full RDF rebuild replaces old triples." .

om:ExtensionProperty a owl:Class ;
    rdfs:label "extension property entry" ;
    rdfs:comment "A user-defined key and typed value, linked from an Extension by hasExtensionProperty. Keys are data, not predicates in the OpenMetadata vocabulary." .

#################################################################
# Predicates emitted by JSON-LD mappings and structured projections
#
# Generic schema fields can be literals or references depending on the entity
# context. rdf:Property deliberately avoids inventing domain/range constraints.
# External vocabulary declarations document usage without redefining its axioms.
# RdfOntologyContractTest checks these against actual projected schema fixtures.
#################################################################

<http://purl.org/dc/terms/created> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "created" ;
    rdfs:comment "On a lineage details node (om:LineageDetails), when the lineage edge was first recorded, in Unix epoch milliseconds (xsd:long)." ;
    schema:domainIncludes om:LineageDetails .

<http://purl.org/dc/terms/description> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "description" ;
    rdfs:comment "The description written for the entity in OpenMetadata, usually Markdown. On a tag node it is the description carried by a tag label, and on om:LineageDetails it describes the lineage edge. Read it for business meaning when names are ambiguous." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextFileContent,
        om:ContextMemory, om:Dashboard, om:DashboardDataModel, om:DashboardService,
        om:DataContract, om:DataProduct, om:Database, om:DatabaseSchema,
        om:DatabaseService, om:Directory, om:Document, om:Domain,
        om:DriveService, om:File, om:Folder, om:Glossary,
        om:GlossaryTerm, om:IngestionPipeline, om:LLMModel, om:LLMService,
        om:LearningResource, om:LineageDetails, om:MLModel, om:MLModelService,
        om:McpServer, om:McpService, om:MessagingService, om:MetadataService,
        om:Metric, om:MetricGroup, om:NotificationTemplate, om:Ontology,
        om:OntologyAxiom, om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty,
        om:OntologyRelease, om:Page, om:Persona, om:Pipeline,
        om:PipelineService, om:Policy, om:PromptTemplate, om:Query,
        om:RelationshipType, om:Report, om:Role, om:SearchIndex,
        om:SearchService, om:SecurityService, om:Spreadsheet, om:StorageService,
        om:StoredProcedure, om:Table, om:Tag, om:Team,
        om:TestConnectionDefinition, om:Topic, om:Type, om:User,
        om:Workflow, om:Worksheet .

<http://purl.org/dc/terms/hasVersion> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasVersion" ;
    rdfs:comment "The entity's OpenMetadata metadata version, a decimal that grows with every change (0.1, 0.2, then 1.0 after a major change). dcat:version carries the same number." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextFileContent,
        om:ContextMemory, om:Dashboard, om:DashboardDataModel, om:DashboardService,
        om:DataContract, om:DataProduct, om:Database, om:DatabaseSchema,
        om:DatabaseService, om:Directory, om:Document, om:Domain,
        om:DriveService, om:File, om:Folder, om:Glossary,
        om:GlossaryTerm, om:IngestionPipeline, om:LLMModel, om:LLMService,
        om:LearningResource, om:MLModel, om:MLModelService, om:McpServer,
        om:McpService, om:MessagingService, om:MetadataService, om:Metric,
        om:MetricGroup, om:NotificationTemplate, om:Ontology, om:OntologyAxiom,
        om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty, om:OntologyRelease,
        om:Page, om:Persona, om:Pipeline, om:PipelineService,
        om:Policy, om:PromptTemplate, om:Query, om:RelationshipType,
        om:Report, om:Role, om:SearchIndex, om:SearchService,
        om:SecurityService, om:Spreadsheet, om:StorageService, om:StoredProcedure,
        om:Table, om:Tag, om:Team, om:TestConnectionDefinition,
        om:Topic, om:Type, om:User, om:Workflow,
        om:Worksheet .

<http://purl.org/dc/terms/modified> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "modified" ;
    rdfs:comment "When the entity last changed in OpenMetadata, as xsd:dateTime. On om:LineageDetails it is the lineage edge's last update, in Unix epoch milliseconds (xsd:long)." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextFileContent,
        om:ContextMemory, om:Dashboard, om:DashboardDataModel, om:DashboardService,
        om:DataContract, om:DataProduct, om:Database, om:DatabaseSchema,
        om:DatabaseService, om:Directory, om:Document, om:Domain,
        om:DriveService, om:File, om:Folder, om:Glossary,
        om:GlossaryTerm, om:IngestionPipeline, om:LLMModel, om:LLMService,
        om:LearningResource, om:LineageDetails, om:MLModel, om:MLModelService,
        om:McpServer, om:McpService, om:MessagingService, om:MetadataService,
        om:Metric, om:MetricGroup, om:NotificationTemplate, om:Ontology,
        om:OntologyAxiom, om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty,
        om:OntologyRelease, om:Page, om:Persona, om:Pipeline,
        om:PipelineService, om:Policy, om:PromptTemplate, om:Query,
        om:RelationshipType, om:Report, om:Role, om:SearchIndex,
        om:SearchService, om:SecurityService, om:Spreadsheet, om:StorageService,
        om:StoredProcedure, om:Table, om:Tag, om:Task,
        om:Team, om:TestCase, om:TestConnectionDefinition, om:Topic,
        om:Type, om:User, om:Workflow, om:Worksheet .

<http://purl.org/dc/terms/publisher> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "publisher" ;
    rdfs:comment "Who provides the definition (the provider field): system for definitions OpenMetadata ships and seeds, user for ones people created." ;
    schema:domainIncludes om:App, om:Bot, om:Classification, om:Glossary,
        om:GlossaryTerm, om:IngestionPipeline, om:MetadataService, om:Metric,
        om:MetricGroup, om:NotificationTemplate, om:Ontology, om:OntologyAxiom,
        om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty, om:OntologyRelease,
        om:Policy, om:RelationshipType, om:Role, om:Tag .

<http://rdfs.org/ns/void#entities> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "entities" ;
    rdfs:comment "On om:Container, the number of objects or files the container holds (numberOfObjects)." ;
    schema:domainIncludes om:Container .

<http://www.w3.org/1999/02/22-rdf-syntax-ns#first> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "first" ;
    rdfs:comment "A member of an RDF list that the projection writes for a JSON array mapped as an ordered list. Read the members in order with rdf:rest*/rdf:first." .

<http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "rest" ;
    rdfs:comment "The rest of an RDF list written for an ordered JSON array; rdf:nil ends it." .

<http://www.w3.org/1999/02/22-rdf-syntax-ns#type> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "type" ;
    rdfs:comment "The node's classes. An entity carries its om: class (om:Table, om:Dashboard, om:GlossaryTerm) plus aligned W3C classes such as dcat:Dataset or prov:Agent. A node reached only through a reference may carry just the coarse class of that reference. Filter on the om: class to select entities of one kind." .

<http://www.w3.org/2000/01/rdf-schema#label> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "label" ;
    rdfs:comment "The entity's name (the name field), the last segment of its fully qualified name. Use om:fullyQualifiedName to identify an entity exactly and skos:prefLabel for the name people see." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Column, om:Container, om:ContextFile,
        om:ContextFileContent, om:ContextMemory, om:Dashboard, om:DashboardDataModel,
        om:DashboardService, om:DataContract, om:DataProduct, om:Database,
        om:DatabaseSchema, om:DatabaseService, om:Directory, om:Document,
        om:Domain, om:DriveService, om:File, om:Folder,
        om:Glossary, om:GlossaryTerm, om:IngestionPipeline, om:LLMModel,
        om:LLMService, om:LearningResource, om:MLModel, om:MLModelService,
        om:McpServer, om:McpService, om:MessagingService, om:MetadataService,
        om:Metric, om:MetricGroup, om:NotificationTemplate, om:Ontology,
        om:OntologyAxiom, om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty,
        om:OntologyRelease, om:Page, om:Persona, om:Pipeline,
        om:PipelineService, om:Policy, om:PromptTemplate, om:Query,
        om:RelationshipType, om:Report, om:Role, om:SearchIndex,
        om:SearchService, om:SecurityService, om:Spreadsheet, om:StorageService,
        om:StoredProcedure, om:Table, om:Tag, om:Team,
        om:TestConnectionDefinition, om:TestDefinition, om:TestResultValue, om:TestSuite,
        om:Topic, om:Type,
        om:User, om:Workflow, om:Worksheet .

<http://www.w3.org/2000/01/rdf-schema#seeAlso> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "seeAlso" ;
    rdfs:comment "Glossary term relation of type seeAlso: the object is a related term that gives the subject additional context." ;
    schema:domainIncludes om:GlossaryTerm .

<http://www.w3.org/2000/01/rdf-schema#subClassOf> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "subClassOf" ;
    rdfs:comment "Glossary term relation of type subClassOf: every instance of the subject term is also an instance of the object term, so the object's attributes apply to the subject. Unlike skos:broader it asserts subsumption." ;
    schema:domainIncludes om:GlossaryTerm .

<http://www.w3.org/2004/02/skos/core#altLabel> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "altLabel" ;
    rdfs:comment "A synonym of a glossary term (the synonyms field), one literal per synonym. Match it together with rdfs:label and skos:prefLabel when looking a business term up by name." ;
    schema:domainIncludes om:GlossaryTerm .

<http://www.w3.org/2004/02/skos/core#broader> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "broader" ;
    rdfs:comment "The parent of a tag, glossary term or domain (its parent field), and the glossary term relation of type broader. Walk it upward for the hierarchy; skos:narrower is the reverse. It does not imply subclassing." ;
    schema:domainIncludes om:Domain, om:GlossaryTerm, om:Tag .

<http://www.w3.org/2004/02/skos/core#exactMatch> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "exactMatch" ;
    rdfs:comment "Glossary term relation of type synonym: the two terms mean the same thing and can be used interchangeably." ;
    schema:domainIncludes om:GlossaryTerm .

<http://www.w3.org/2004/02/skos/core#inScheme> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "inScheme" ;
    rdfs:comment "The glossary a glossary term belongs to, or the classification a tag belongs to." ;
    schema:domainIncludes om:GlossaryTerm, om:Tag .

<http://www.w3.org/2004/02/skos/core#narrower> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "narrower" ;
    rdfs:comment "A child of a tag, glossary term or domain (its children field), and the glossary term relation of type narrower. skos:broader is the reverse." ;
    schema:domainIncludes om:Domain, om:GlossaryTerm, om:Tag .

<http://www.w3.org/2004/02/skos/core#prefLabel> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "prefLabel" ;
    rdfs:comment "The entity's display name (displayName), the name shown in the UI. It may be absent or differ from rdfs:label." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextFileContent,
        om:ContextMemory, om:Dashboard, om:DashboardDataModel, om:DashboardService,
        om:DataContract, om:DataProduct, om:Database, om:DatabaseSchema,
        om:DatabaseService, om:Directory, om:Document, om:Domain,
        om:DriveService, om:File, om:Folder, om:Glossary,
        om:GlossaryTerm, om:IngestionPipeline, om:LLMModel, om:LLMService,
        om:LearningResource, om:MLModel, om:MLModelService, om:McpServer,
        om:McpService, om:MessagingService, om:MetadataService, om:Metric,
        om:MetricGroup, om:NotificationTemplate, om:Ontology, om:OntologyAxiom,
        om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty, om:OntologyRelease,
        om:Page, om:Persona, om:Pipeline, om:PipelineService,
        om:Policy, om:PromptTemplate, om:Query, om:RelationshipType,
        om:Report, om:Role, om:SearchIndex, om:SearchService,
        om:SecurityService, om:Spreadsheet, om:StorageService, om:StoredProcedure,
        om:Table, om:Tag, om:Team, om:TestConnectionDefinition,
        om:Topic, om:Type, om:User, om:Workflow,
        om:Worksheet .

<http://www.w3.org/ns/dcat#byteSize> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "byteSize" ;
    rdfs:comment "Size of a file, spreadsheet or container. Files and spreadsheets give bytes; a container gives the total size of its objects in kilobytes (its size field)." ;
    schema:domainIncludes om:Container, om:File, om:Spreadsheet .

<http://www.w3.org/ns/dcat#mediaType> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "mediaType" ;
    rdfs:comment "MIME type of a file or spreadsheet (mimeType)." ;
    schema:domainIncludes om:File, om:Spreadsheet .

<http://www.w3.org/ns/dcat#version> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "version" ;
    rdfs:comment "The entity's OpenMetadata metadata version as a number, the same value as dct:hasVersion." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextFileContent,
        om:ContextMemory, om:Dashboard, om:DashboardDataModel, om:DashboardService,
        om:DataContract, om:DataProduct, om:Database, om:DatabaseSchema,
        om:DatabaseService, om:Directory, om:Document, om:Domain,
        om:DriveService, om:File, om:Folder, om:Glossary,
        om:GlossaryTerm, om:IngestionPipeline, om:LLMModel, om:LLMService,
        om:LearningResource, om:MLModel, om:MLModelService, om:McpServer,
        om:McpService, om:MessagingService, om:MetadataService, om:Metric,
        om:MetricGroup, om:NotificationTemplate, om:Ontology, om:OntologyAxiom,
        om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty, om:OntologyRelease,
        om:Page, om:Persona, om:Pipeline, om:PipelineService,
        om:Policy, om:PromptTemplate, om:Query, om:RelationshipType,
        om:Report, om:Role, om:SearchIndex, om:SearchService,
        om:SecurityService, om:Spreadsheet, om:StorageService, om:StoredProcedure,
        om:Table, om:Tag, om:Task, om:Team,
        om:TestCase, om:TestConnectionDefinition, om:Topic, om:Type,
        om:User, om:Workflow, om:Worksheet .

<http://www.w3.org/ns/dqv#computedOn> a rdf:Property ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection: profiles are om:profile* facts on the table or column (ADR:2026-11-18-the-rdf-graph-carries-the-latest-quality-evidence). Kept so a DQV view can be derived from those facts." ;
    rdfs:label "computedOn" .

<http://www.w3.org/ns/dqv#hasQualityMeasurement> a rdf:Property ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection: profiles are om:profile* facts on the table or column (ADR:2026-11-18-the-rdf-graph-carries-the-latest-quality-evidence). Kept so a DQV view can be derived from those facts." ;
    rdfs:label "hasQualityMeasurement" .

<http://www.w3.org/ns/dqv#isMeasurementOf> a rdf:Property ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:comment "Not emitted by the metadata projection: profiles are om:profile* facts on the table or column (ADR:2026-11-18-the-rdf-graph-carries-the-latest-quality-evidence). Kept so a DQV view can be derived from those facts." ;
    rdfs:label "isMeasurementOf" .

<http://www.w3.org/ns/dqv#value> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "value" ;
    rdfs:comment "On a test result value (om:TestResultValue), the value the latest run observed, as the test framework reported it, as a string; rdfs:label on the same node names the measure." ;
    schema:domainIncludes om:TestResultValue .

<http://www.w3.org/ns/prov#endedAtTime> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "endedAtTime" ;
    rdfs:comment "When an activity ended: a pipeline run's end time (om:PipelineExecution), or when a lineage edge was last updated (om:LineageDetails)." ;
    schema:domainIncludes om:LineageDetails, om:PipelineExecution .

<http://www.w3.org/ns/prov#generated> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "generated" ;
    rdfs:comment "Outputs of an activity: from a pipeline to the details nodes (om:LineageDetails) of the lineage edges it produces, and from a pipeline run (om:PipelineExecution) to each output dataset it reported. A run's dataset node carries om:fullyQualifiedName; join on it to reach the catalog asset." ;
    schema:domainIncludes om:PipelineExecution .

<http://www.w3.org/ns/prov#generatedAtTime> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "generatedAtTime" ;
    rdfs:comment "When a quality fact was recorded: on om:TestCaseResult, the time of the test case's latest run; on om:TestCaseIncident, when the open incident reached its current state." ;
    schema:domainIncludes om:TestCaseIncident, om:TestCaseResult .

<http://www.w3.org/ns/prov#hadPlan> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hadPlan" ;
    rdfs:comment "From a lineage details node to the prov:Plan that holds the SQL transformation of the lineage edge in prov:value." ;
    schema:domainIncludes om:LineageDetails .

<http://www.w3.org/ns/prov#invalidatedAtTime> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "invalidatedAtTime" ;
    rdfs:comment "Present only on a soft-deleted entity: its last update time, which is when it was deleted." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextFileContent,
        om:ContextMemory, om:Dashboard, om:DashboardDataModel, om:DashboardService,
        om:DataContract, om:DataProduct, om:Database, om:DatabaseSchema,
        om:DatabaseService, om:Directory, om:Document, om:Domain,
        om:DriveService, om:File, om:Folder, om:Glossary,
        om:GlossaryTerm, om:IngestionPipeline, om:LLMModel, om:LLMService,
        om:LearningResource, om:MLModel, om:MLModelService, om:McpServer,
        om:McpService, om:MessagingService, om:MetadataService, om:Metric,
        om:MetricGroup, om:NotificationTemplate, om:Ontology, om:OntologyAxiom,
        om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty, om:OntologyRelease,
        om:Page, om:Persona, om:Pipeline, om:PipelineService,
        om:Policy, om:PromptTemplate, om:Query, om:RelationshipType,
        om:Report, om:Role, om:SearchIndex, om:SearchService,
        om:SecurityService, om:Spreadsheet, om:StorageService, om:StoredProcedure,
        om:Table, om:Tag, om:Task, om:Team,
        om:TestCase, om:TestConnectionDefinition, om:Topic, om:Type,
        om:User, om:Workflow, om:Worksheet .

<http://www.w3.org/ns/prov#startedAtTime> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "startedAtTime" ;
    rdfs:comment "When an activity started: a pipeline run's start time (om:PipelineExecution), or when a lineage edge was first recorded (om:LineageDetails)." ;
    schema:domainIncludes om:LineageDetails, om:PipelineExecution .

<http://www.w3.org/ns/prov#used> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "used" ;
    rdfs:comment "Inputs of an activity: from a lineage details node to the upstream asset the edge reads, from a pipeline run to each input dataset it reported, and USES relationships such as a user or an asset to a query it uses." ;
    schema:domainIncludes om:LineageDetails, om:PipelineExecution, om:User .

<http://www.w3.org/ns/prov#value> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "value" ;
    rdfs:comment "On the prov:Plan of a lineage edge, the SQL text of the transformation." .

<http://www.w3.org/ns/prov#wasAssociatedWith> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "wasAssociatedWith" ;
    rdfs:comment "The agent behind an activity: the user or bot that executed a pipeline run, or the user who created a lineage edge. On om:LineageDetails the user IRI is built from the user name, because only the name is recorded." ;
    schema:domainIncludes om:LineageDetails, om:PipelineExecution .

<http://www.w3.org/ns/prov#wasAttributedTo> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "wasAttributedTo" ;
    rdfs:comment "An owner of the entity, the PROV-O mirror of om:hasOwner: a user or team that owns it." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Chart, om:Classification,
        om:Container, om:ContextFile, om:ContextMemory, om:Dashboard,
        om:DashboardDataModel, om:DashboardService, om:DataContract, om:DataProduct,
        om:Database, om:DatabaseSchema, om:DatabaseService, om:Directory,
        om:Domain, om:DriveService, om:File, om:Folder,
        om:Glossary, om:GlossaryTerm, om:IngestionPipeline, om:LLMModel,
        om:LLMService, om:LearningResource, om:MLModel, om:MLModelService,
        om:McpServer, om:McpService, om:MessagingService, om:MetadataService,
        om:Metric, om:MetricGroup, om:Ontology, om:OntologyAxiom,
        om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty, om:OntologyRelease,
        om:Page, om:Pipeline, om:PipelineService, om:Policy,
        om:PromptTemplate, om:Query, om:RelationshipType, om:Report,
        om:SearchIndex, om:SearchService, om:SecurityService, om:Spreadsheet,
        om:StorageService, om:StoredProcedure, om:Table, om:Tag,
        om:Team, om:TestConnectionDefinition, om:Topic, om:Workflow,
        om:Worksheet .

<http://www.w3.org/ns/prov#wasDerivedFrom> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "wasDerivedFrom" ;
    rdfs:comment "Lineage: the subject asset is derived from the object asset. It is written with om:upstream for every lineage edge, so ?output prov:wasDerivedFrom ?source matches ?output om:upstream ?source." ;
    schema:domainIncludes om:DataAsset .

<http://www.w3.org/ns/prov#wasGeneratedBy> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "wasGeneratedBy" ;
    rdfs:comment "On a lineage details node (om:LineageDetails), the pipeline that produces the lineage edge. The pipeline carries the inverse, prov:generated." ;
    schema:domainIncludes om:LineageDetails .

<http://www.w3.org/ns/prov#wasInfluencedBy> a rdf:Property ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:label "wasInfluencedBy" ;
    rdfs:comment "Not emitted by the metadata projection for current entity schemas. Available to explicit graph exports or custom projections using the structured mapper." .

<http://www.w3.org/ns/prov#wasInformedBy> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "wasInformedBy" ;
    rdfs:comment "From a pipeline run (om:PipelineExecution) to the pipeline it is a run of." ;
    schema:domainIncludes om:PipelineExecution .

<http://xmlns.com/foaf/0.1/mbox> a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "mbox" ;
    rdfs:comment "Email address of a user or team." ;
    schema:domainIncludes om:Team, om:User .

om:accessTimestamp a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "accessTimestamp" ;
    rdfs:comment "On an om:AccessDetails node, when the lifecycle event happened." ;
    rdfs:domain om:AccessDetails ;
    rdfs:range xsd:dateTime .

om:accessedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "accessedBy" ;
    rdfs:comment "On an om:AccessDetails node, the user who performed the lifecycle event." ;
    rdfs:domain om:AccessDetails .

om:accessedByProcess a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "accessedByProcess" ;
    rdfs:comment "On an om:AccessDetails node, the process, such as a pipeline, that performed the lifecycle event." ;
    rdfs:domain om:AccessDetails .

om:agentType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "agentType" ;
    rdfs:comment "Type of agent the application runs as, such as Metadata." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:aliases a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "aliases" ;
    rdfs:comment "Alternate fully qualified SQL names that resolve to this table, such as SQL Server synonyms. Set on om:Table. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:allowBotImpersonation a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "allowBotImpersonation" ;
    rdfs:comment "When true, the bot created for this application will have allowImpersonation enabled, allowing it to act on behalf of users. Set on om:AppMarketPlaceDefinition." ;
    rdfs:domain om:AppMarketPlaceDefinition ;
    rdfs:range xsd:boolean .

om:allowConcurrentExecution a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "allowConcurrentExecution" ;
    rdfs:comment "If true, multiple instances of this app can run concurrently. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:boolean .

om:allowConfiguration a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "allowConfiguration" ;
    rdfs:comment "Allow users to configure the app from the UI. If false, the configure step will be hidden. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:boolean .

om:allowDelete a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "allowDelete" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Policy: Some system policies can't be deleted. On om:Role: Some system roles can't be deleted." ;
    schema:domainIncludes om:Policy, om:Role ;
    rdfs:range xsd:boolean .

om:allowEdit a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "allowEdit" ;
    rdfs:comment "Some system roles can't be edited. Set on om:Policy and om:Role; the domain is left open." ;
    schema:domainIncludes om:Policy, om:Role ;
    rdfs:range xsd:boolean .

om:allowImpersonation a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "allowImpersonation" ;
    rdfs:comment "When true, this bot is allowed to impersonate users (subject to policy checks). Set on om:User." ;
    rdfs:domain om:User ;
    rdfs:range xsd:boolean .

om:aliases a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "aliases" .

om:answer a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "answer" ;
    rdfs:comment "Canonical answer or retained guidance represented by this memory. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:antonym a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "antonym" ;
    rdfs:comment "Glossary term relation of type antonym: the two terms have opposite meanings." ;
    schema:domainIncludes om:GlossaryTerm .

om:apiEndpoints a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "apiEndpoints" ;
    rdfs:comment "All the APIs included in this API Collection. Set on om:APICollection. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:APICollection ;
    rdfs:range xsd:string .

om:appLogoUrl a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "appLogoUrl" ;
    rdfs:comment "Application Logo Url. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:appScreenshots a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "appScreenshots" ;
    rdfs:comment "Application Screenshots. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:appType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "appType" ;
    rdfs:comment "Whether the application runs inside OpenMetadata (internal) or outside it (external)." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:applicationResult a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "applicationResult" ;
    rdfs:comment "Typed outcome of applying an ontology change set. Set on om:OntologyChangeSet. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyChangeSet ;
    rdfs:range xsd:string .

om:applicationType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "applicationType" ;
    rdfs:comment "Its meaning depends on the entity type. On om:AIApplication: Type of AI application based on primary function and interaction pattern. On om:IngestionPipeline: Type of the application when pipelineType is 'application'." ;
    schema:domainIncludes om:AIApplication, om:IngestionPipeline ;
    rdfs:range xsd:string .

om:appliesTo a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "appliesTo" ;
    rdfs:comment "Entities this policy applies to. Set on om:AiGovernancePolicy. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:appliesToUser a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "appliesToUser" ;
    rdfs:comment "Users that are assigned a persona. Set on om:Persona. Points at the referenced entity's node." ;
    rdfs:domain om:Persona .

om:approvedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "approvedBy" ;
    rdfs:comment "Who approved this policy. Set on om:AiGovernancePolicy." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:artifacts a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "artifacts" ;
    rdfs:comment "Generated artifacts available for download. Set on om:AuditReport. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:string .

om:asOfDate a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "asOfDate" ;
    rdfs:comment "Snapshot date — the pack assembles state as it was at this time. Set on om:AuditReport." ;
    rdfs:domain om:AuditReport .

om:assessmentCadence a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "assessmentCadence" ;
    rdfs:comment "How often this framework requires reassessment of in-scope assets. Set on om:AiGovernanceFramework. One of: Monthly, Quarterly, SemiAnnual, Annual." ;
    rdfs:domain om:AiGovernanceFramework ;
    rdfs:range xsd:string .

om:assetId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "assetId" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextFileContent: Reference to the Asset entity storing the actual file blob. On om:ContextFile: Legacy reference to the current Asset entity storing the file blob." ;
    schema:domainIncludes om:ContextFile, om:ContextFileContent ;
    rdfs:range xsd:string .

om:assets a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "assets" ;
    rdfs:comment "Data assets (tables, columns, dashboards, etc.) this metric is computed on or applies to. Set on om:Metric. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:assignedTo a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "assignedTo" ;
    rdfs:comment "From a user or team to a task (om:Task) assigned to it." ;
    schema:domainIncludes om:Team, om:User .

om:attachments a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "attachments" ;
    rdfs:comment "Attachments for the Knowledge Page. Set on om:Page. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Page ;
    rdfs:range xsd:string .

om:autoApply a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "autoApply" ;
    rdfs:comment "Predicate that determines which AI assets this framework automatically applies to. Set on om:AiGovernanceFramework. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AiGovernanceFramework ;
    rdfs:range xsd:string .

om:autoClassificationConfig a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "autoClassificationConfig" ;
    rdfs:comment "Configuration for automatic classification behavior. Set on om:Classification. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Classification ;
    rdfs:range xsd:string .

om:autoClassificationEnabled a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "autoClassificationEnabled" ;
    rdfs:comment "Whether automatic classification is enabled for this tag. Set on om:Tag." ;
    rdfs:domain om:Tag ;
    rdfs:range xsd:boolean .

om:autoClassificationPriority a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "autoClassificationPriority" ;
    rdfs:comment "Priority for conflict resolution when multiple tags match (higher number = higher priority). Set on om:Tag." ;
    rdfs:domain om:Tag .

om:automationRequest a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "automationRequest" ;
    rdfs:comment "Request body for a specific workflow type. Set on om:Workflow." ;
    rdfs:domain om:Workflow ;
    rdfs:range xsd:string .

om:automationResponse a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "automationResponse" ;
    rdfs:comment "Response to the request. Set on om:Workflow." ;
    rdfs:domain om:Workflow ;
    rdfs:range xsd:string .

om:axiomType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "axiomType" ;
    rdfs:comment "Kind of ontology axiom, such as SUBCLASS_OF, EQUIVALENT_CLASS, DISJOINT_WITH or CLASS_ASSERTION." ;
    rdfs:domain om:OntologyAxiom ;
    rdfs:range xsd:string .

om:baseModel a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "baseModel" ;
    rdfs:comment "Base model name (e.g., 'gpt-4', 'claude-3-opus', 'llama-2-70b'). Set on om:LLMModel." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:belongsToAPICollection a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "belongsToAPICollection" ;
    rdfs:comment "The API collection that contains an API endpoint." ;
    rdfs:domain om:APIEndpoint ;
    rdfs:range om:APICollection .

om:belongsToDomain a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "belongsToDomain" ;
    rdfs:comment "A domain the entity belongs to (its domain or domains field); for a data product, the domains it is published in. Follow it to scope a question to a business area, or walk it backwards from an om:Domain to list its assets." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextMemory,
        om:Dashboard, om:DashboardDataModel, om:DashboardService, om:DataProduct,
        om:Database, om:DatabaseSchema, om:DatabaseService, om:Directory,
        om:Document, om:DriveService, om:File, om:Folder,
        om:Glossary, om:GlossaryTerm, om:IngestionPipeline, om:LLMModel,
        om:LLMService, om:MLModel, om:MLModelService, om:McpServer,
        om:McpService, om:MessagingService, om:MetadataService, om:Metric,
        om:MetricGroup, om:Page, om:Persona, om:Pipeline,
        om:PipelineService, om:Policy, om:PromptTemplate, om:Query,
        om:Report, om:Role, om:SearchIndex, om:SearchService,
        om:SecurityService, om:Spreadsheet, om:StorageService, om:StoredProcedure,
        om:Table, om:Tag, om:Team, om:TestConnectionDefinition,
        om:Topic, om:Type, om:User, om:Workflow,
        om:Worksheet .

om:belongsToProject a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "belongsToProject" ;
    rdfs:comment "Its meaning depends on the entity type. On om:DashboardDataModel: Name of the project / workspace / collection in which the dataModel is contained. On om:Dashboard: Name of the project / workspace / collection in which the dashboard is contained." ;
    schema:domainIncludes om:Dashboard, om:DashboardDataModel ;
    rdfs:range xsd:string .

om:belongsToSpreadsheet a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "belongsToSpreadsheet" ;
    rdfs:comment "The spreadsheet a worksheet (tab) belongs to." ;
    rdfs:domain om:Worksheet ;
    rdfs:range om:Spreadsheet .

om:biasMetrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "biasMetrics" ;
    rdfs:comment "Bias evaluation metrics for the AI application. Set on om:AIApplication. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:biasThresholds a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "biasThresholds" ;
    rdfs:comment "Bias threshold limits for LLM models. Set on om:AiGovernancePolicy. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:botUser a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "botUser" ;
    rdfs:comment "Bot user created for this bot on behalf of which the bot performs all the operations, such as updating description, responding on the conversation threads, etc. Set on om:Bot. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:Bot ;
    rdfs:range xsd:string .

om:capabilities a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "capabilities" ;
    rdfs:comment "Its meaning depends on the entity type. On om:LLMModel: Capabilities of this model. On om:McpServer: Capabilities supported by the MCP server. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:LLMModel, om:McpServer ;
    rdfs:range xsd:string .

om:cardinality a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "cardinality" ;
    rdfs:comment "Cardinality constraints of the relationship type, as JSON text." ;
    rdfs:domain om:RelationshipType ;
    rdfs:range xsd:string .

om:categories a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "categories" ;
    rdfs:comment "Topic categories the resource belongs to. Set on om:LearningResource. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LearningResource ;
    rdfs:range xsd:string .

om:category a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "category" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Type: field or entity. On om:AiFrameworkControl: the control's category, such as Risk, Data or Transparency. On om:RelationshipType: CORE, OWL_SKOS or CUSTOM." ;
    schema:domainIncludes om:AiFrameworkControl, om:RelationshipType, om:Type ;
    rdfs:range xsd:string .

om:certificationAppliedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "certificationAppliedAt" ;
    rdfs:comment "When the entity's certification was applied, in Unix epoch milliseconds." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:Chart,
        om:Container, om:Dashboard, om:DashboardDataModel, om:DataProduct,
        om:Database, om:DatabaseSchema, om:Directory, om:Domain,
        om:File, om:LLMModel, om:MLModel, om:McpServer,
        om:Metric, om:MetricGroup, om:Pipeline, om:SearchIndex,
        om:Spreadsheet, om:StoredProcedure, om:Table, om:Topic,
        om:Worksheet .

om:certificationExpiresAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "certificationExpiresAt" ;
    rdfs:comment "When the entity's certification expires, in Unix epoch milliseconds. Compare it with the current time to tell whether the certification still holds." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:Chart,
        om:Container, om:Dashboard, om:DashboardDataModel, om:DataProduct,
        om:Database, om:DatabaseSchema, om:Directory, om:Domain,
        om:File, om:LLMModel, om:MLModel, om:McpServer,
        om:Metric, om:MetricGroup, om:Pipeline, om:SearchIndex,
        om:Spreadsheet, om:StoredProcedure, om:Table, om:Topic,
        om:Worksheet .

om:certificationLevel a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "certificationLevel" ;
    rdfs:comment "Level of the entity's certification: the last segment of the certification tag's fully qualified name (Gold in Certification.Gold)." ;
    schema:domainIncludes om:Table ;
    rdfs:range xsd:string .

om:certifications a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "certifications" ;
    rdfs:comment "Certifications this model has received. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:characteristics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "characteristics" ;
    rdfs:comment "OWL characteristics of a relationship type or ontology property, such as transitive or symmetric, as JSON text." ;
    schema:domainIncludes om:OntologyProperty, om:RelationshipType ;
    rdfs:range xsd:string .

om:childrenCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "childrenCount" ;
    rdfs:comment "Number of children: nested sub-domains for a domain, child teams for a team, direct children for a folder, child terms for a glossary term or knowledge page, child metrics for a metric." ;
    schema:domainIncludes om:Domain, om:Folder, om:GlossaryTerm, om:Metric,
        om:Page, om:Team .

om:className a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "className" ;
    rdfs:comment "Java class that implements the application (on om:AppMarketPlaceDefinition) or runs its schedule (on om:App)." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:code a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "code" ;
    rdfs:comment "Its meaning depends on the entity type. On om:AiFrameworkControl: Stable short code for the control within its framework (e.g. 'art-10'). On om:StoredProcedure: SQL Query definition." ;
    schema:domainIncludes om:AiFrameworkControl, om:StoredProcedure ;
    rdfs:range xsd:string .

om:color a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "color" ;
    rdfs:comment "Optional color for the folder icon. Set on om:Folder." ;
    rdfs:domain om:Folder ;
    rdfs:range xsd:string .

om:completedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "completedAt" ;
    rdfs:comment "When job execution finished (success or failure). Set on om:AuditReport." ;
    rdfs:domain om:AuditReport .

om:complianceRequirements a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "complianceRequirements" ;
    rdfs:comment "Compliance requirements this policy enforces. Set on om:AiGovernancePolicy. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:compressionCodec a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "compressionCodec" ;
    rdfs:comment "Compression algorithm/codec used. Examples: LZ4, ZSTD, Snappy, Gorilla, Delta, etc. Set on om:Table." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:compressionEnabled a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "compressionEnabled" ;
    rdfs:comment "Indicates whether compression is enabled on this table. Applicable for databases that support compression like Snowflake, TimescaleDB, ClickHouse, BigQuery, Redshift, etc. Set on om:Table." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:boolean .

om:compressionStrategy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "compressionStrategy" ;
    rdfs:comment "Compression strategy configuration including segment/partition/order keys. Set on om:Table. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:conceptMappings a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "conceptMappings" ;
    rdfs:comment "Mappings from a glossary term or ontology concept to external concepts, such as SKOS alignments, as JSON text." ;
    schema:domainIncludes om:GlossaryTerm, om:OntologyConcept ;
    rdfs:range xsd:string .

om:conceptType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "conceptType" ;
    rdfs:comment "Vocabulary a source ontology used to assert a concept. Preserved so imported ontologies round-trip with the typing they were authored with. Set on om:OntologyConcept. One of: SKOS_CONCEPT, OWL_CLASS, BOTH." ;
    rdfs:domain om:OntologyConcept ;
    rdfs:range xsd:string .

om:concurrency a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "concurrency" ;
    rdfs:comment "Concurrency of the Pipeline. Set on om:Pipeline." ;
    rdfs:domain om:Pipeline .

om:connectionConfig a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "connectionConfig" ;
    rdfs:comment "Connection configuration for the MCP server. Set on om:McpServer. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:constraintType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "constraintType" ;
    rdfs:comment "Kind of table constraint: PRIMARY_KEY, UNIQUE, FOREIGN_KEY, SORT_KEY, DIST_KEY or CLUSTER_KEY." ;
    rdfs:domain om:TableConstraint ;
    rdfs:range xsd:string .

om:contentType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "contentType" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextFileContent: MIME type of the stored content. On om:ContextFile: MIME type of the file." ;
    schema:domainIncludes om:ContextFile, om:ContextFileContent ;
    rdfs:range xsd:string .

om:contextDefinition a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "contextDefinition" ;
    rdfs:comment "Rules and settings used to materialize the shared AI context for an om:Persona. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Persona ;
    rdfs:range xsd:string .

om:contextFile a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "contextFile" ;
    rdfs:comment "The file this content snapshot belongs to. Set on om:ContextFileContent. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:ContextFileContent ;
    rdfs:range xsd:string .

om:contexts a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "contexts" ;
    rdfs:comment "List of contexts where this resource should surface. Set on om:LearningResource. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LearningResource ;
    rdfs:range xsd:string .

om:contractUpdates a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "contractUpdates" ;
    rdfs:comment "History of updates to the data contract. Set on om:DataContract. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:costControls a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "costControls" ;
    rdfs:comment "Cost control limits. Set on om:AiGovernancePolicy. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:costMetrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "costMetrics" ;
    rdfs:comment "Cost metrics for using this model. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:createdAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "createdAt" ;
    rdfs:comment "Its meaning depends on the entity type. On om:DataContract: Timestamp in Unix epoch time milliseconds corresponding to when the data contract was created. On most other entity types: Timestamp in Unix epoch time milliseconds corresponding to when this entity was created in OpenMetadata." ;
    schema:domainIncludes om:Chart, om:Container, om:Dashboard, om:DashboardDataModel,
        om:DataContract, om:Database, om:DatabaseSchema, om:MLModel,
        om:Metric, om:Pipeline, om:Query, om:Role,
        om:Table, om:Team, om:Topic, om:User .

om:createdTime a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "createdTime" ;
    rdfs:comment "Its meaning depends on the entity type. On om:File: File creation timestamp. On om:Spreadsheet: Spreadsheet creation timestamp." ;
    schema:domainIncludes om:File, om:Spreadsheet .

om:crossGlossaryAllowed a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "crossGlossaryAllowed" ;
    rdfs:comment "Whether the relationship type may link terms from different glossaries." ;
    rdfs:domain om:RelationshipType ;
    rdfs:range xsd:boolean .

om:customMetrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "customMetrics" ;
    rdfs:comment "List of Custom Metrics registered for a table. Set on om:Table. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:customUnitOfMeasurement a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "customUnitOfMeasurement" ;
    rdfs:comment "Custom unit of measurement when unitOfMeasurement is OTHER. Set on om:Metric." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:dashboardType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dashboardType" ;
    rdfs:comment "Kind of dashboard: Dashboard or Report." ;
    rdfs:domain om:Dashboard ;
    rdfs:range xsd:string .

om:dashboards a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dashboards" ;
    rdfs:comment "All the dashboards containing this chart. Set on om:Chart. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:Chart ;
    rdfs:range xsd:string .

om:dataAccessControls a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dataAccessControls" ;
    rdfs:comment "Data access controls for AI agents. Set on om:AiGovernancePolicy. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:dataAccessSummary a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dataAccessSummary" ;
    rdfs:comment "Summary of data access patterns for this MCP server. Set on om:McpServer. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:dataContract a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dataContract" ;
    rdfs:comment "Reference to the data contract for this entity. Set on many entity types; the domain is left open. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:Chart, om:Container, om:Dashboard, om:DashboardDataModel,
        om:DashboardService, om:Database, om:DatabaseSchema, om:DatabaseService,
        om:Directory, om:DriveService, om:File, om:Glossary,
        om:GlossaryTerm, om:LLMModel, om:LLMService, om:MLModel,
        om:MLModelService, om:MessagingService, om:Metric, om:Pipeline,
        om:PipelineService, om:SearchIndex, om:SearchService, om:SecurityService,
        om:Spreadsheet, om:StorageService, om:StoredProcedure, om:Table,
        om:Tag, om:Topic, om:Worksheet ;
    rdfs:range xsd:string .

om:dataModelType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dataModelType" ;
    rdfs:comment "Kind of dashboard data model, named after the BI construct it comes from, such as a LookML view or a Tableau data model." ;
    rdfs:domain om:DashboardDataModel ;
    rdfs:range xsd:string .

om:dataProductType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dataProductType" ;
    rdfs:comment "Type of the data product (ODPS-aligned taxonomy). Set on om:DataProduct." ;
    rdfs:domain om:DataProduct ;
    rdfs:range xsd:string .

om:dataSources a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dataSources" ;
    rdfs:comment "Data sources (tables, APIs, etc.) this application can access. Set on om:AIApplication. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:databaseProfilerConfig a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "databaseProfilerConfig" ;
    rdfs:comment "Profiler settings of the database, as JSON text: sample data row count, randomized sampling and the profile sample size." ;
    rdfs:domain om:Database ;
    rdfs:range xsd:string .

om:databaseSchemaProfilerConfig a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "databaseSchemaProfilerConfig" ;
    rdfs:comment "Profiler settings of the database schema, as JSON text: sample data row count, randomized sampling and the profile sample size." ;
    rdfs:domain om:DatabaseSchema ;
    rdfs:range xsd:string .

om:databaseSchemas a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "databaseSchemas" ;
    rdfs:comment "References to schemas in the database. Set on om:Database. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:Database ;
    rdfs:range xsd:string .

om:default a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "default" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Persona: When true, this persona is the system-wide default persona that will be applied to users who don't have any persona assigned or no default persona set. On om:Database: Some databases don't support a database/catalog in the hierarchy and use default database." ;
    schema:domainIncludes om:Database, om:Persona ;
    rdfs:range xsd:boolean .

om:defaultDomain a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "defaultDomain" ;
    rdfs:comment "The domain the user selects in the navbar to scope list views. Set on om:User. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:User ;
    rdfs:range xsd:string .

om:defaultPersona a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "defaultPersona" ;
    rdfs:comment "Its meaning depends on the entity type. On om:User: Default Persona for the user from list of personas. On om:Team: Default persona for all users in this team. Only applicable to Group type teams. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:Team, om:User ;
    rdfs:range xsd:string .

om:deploymentInfo a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "deploymentInfo" ;
    rdfs:comment "Deployment information for the model. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:deploymentUrl a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "deploymentUrl" ;
    rdfs:comment "Its meaning depends on the entity type. On om:McpServer: Deployment endpoint URL. On om:AIApplication: Production deployment endpoint." ;
    schema:domainIncludes om:AIApplication, om:McpServer ;
    rdfs:range xsd:string .

om:deprecated a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "deprecated" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Tag: If the tag is deprecated. On om:OntologyConcept, om:OntologyProperty: A deprecated definition stays resolvable for existing references but should not be used for new ones." ;
    schema:domainIncludes om:OntologyConcept, om:OntologyProperty, om:Tag ;
    rdfs:range xsd:boolean .

om:descendantTeams a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "descendantTeams" ;
    rdfs:comment "All teams nested under this team, resolved recursively (the full subtree, excluding this team itself). Set on om:Team. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:Team ;
    rdfs:range xsd:string .

om:derivedEntities a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "derivedEntities" ;
    rdfs:comment "Derived: glossary terms and metrics created by the Memory Agent from this memory (DERIVED_FROM edges, agent-owned). Set on om:ContextMemory. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:derivedFrom a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "derivedFrom" ;
    rdfs:comment "Two forms. As an edge (DERIVED_FROM relationships), the subject was derived from the object, for example an ontology change set or metric created by the Memory Agent from a context memory. On om:Metric the derivedFrom field also appears as the source memory's JSON text." ;
    schema:domainIncludes om:Metric, om:OntologyChangeSet .

om:detection a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "detection" ;
    rdfs:comment "Origin of Shadow AI detection — auto-discovered from outbound API traffic, SSO logs, connector audits, etc. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:developer a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "developer" ;
    rdfs:comment "Developer For the Application. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:developerUrl a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "developerUrl" ;
    rdfs:comment "Url for the developer. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:developmentStage a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "developmentStage" ;
    rdfs:comment "Its meaning depends on the entity type. On om:McpServer: Development stage of the MCP server. 'Unauthorized' indicates Shadow AI that needs governance review. On om:AIApplication: Development stage of the AI application. 'Unauthorized' indicates Shadow AI that needs governance review." ;
    schema:domainIncludes om:AIApplication, om:McpServer ;
    rdfs:range xsd:string .

om:difficulty a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "difficulty" ;
    rdfs:comment "Suggested proficiency tier for the resource. Set on om:LearningResource. One of: Intro, Intermediate, Advanced." ;
    rdfs:domain om:LearningResource ;
    rdfs:range xsd:string .

om:dimensions a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "dimensions" ;
    rdfs:comment "Dimensions associated with this metric from a semantic layer. Set on om:Metric. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:directory a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "directory" ;
    rdfs:comment "Its meaning depends on the entity type. On om:File: Parent directory containing this file. On om:Spreadsheet: Reference to Directory that contains this spreadsheet. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:File, om:Spreadsheet ;
    rdfs:range xsd:string .

om:disjointWith a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "disjointWith" ;
    rdfs:comment "Its meaning depends on the entity type. On om:RelationshipType: Relationship types declared property-disjoint with this type. On om:OntologyProperty: Semantic IRIs of properties disjoint with this property. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    schema:domainIncludes om:OntologyProperty, om:RelationshipType ;
    rdfs:range xsd:string .

om:disputes a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "disputes" ;
    rdfs:comment "Unresolved conflicts that hold this Draft memory in review, one per contradicting memory. Set on om:ContextMemory. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:documentForEntityType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "documentForEntityType" ;
    rdfs:comment "Type of the Entity stored in DocStore. Set on om:Document." ;
    rdfs:domain om:Document ;
    rdfs:range xsd:string .

om:documentation a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "documentation" ;
    rdfs:comment "Link to external documentation. Set on om:AIApplication and om:McpServer; the domain is left open." ;
    schema:domainIncludes om:AIApplication, om:McpServer ;
    rdfs:range xsd:string .

om:domainType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "domainType" ;
    rdfs:comment "Domain type. Set on om:Domain. One of: Source-aligned, Consumer-aligned, Aggregate." ;
    rdfs:domain om:Domain ;
    rdfs:range xsd:string .

om:domains a rdf:Property ;
    om:projectionStatus om:InferenceOnly ;
    owl:deprecated true ;
    rdfs:label "domains" ;
    rdfs:comment "Not emitted by the metadata projection. Legacy predicate for asset domains, now projected as om:belongsToDomain. Each entity's next projection removes it; a full RDF rebuild removes it everywhere." .

om:downloadLink a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "downloadLink" ;
    rdfs:comment "Direct download link. Set on om:File." ;
    rdfs:domain om:File ;
    rdfs:range xsd:string .

om:downstreamApplications a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "downstreamApplications" ;
    rdfs:comment "AI applications that depend on this application. Set on om:AIApplication. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:driveFileId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "driveFileId" ;
    rdfs:comment "Native file ID in the source system. Set on om:Spreadsheet." ;
    rdfs:domain om:Spreadsheet ;
    rdfs:range xsd:string .

om:editors a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "editors" ;
    rdfs:comment "List of users who are updating the entity. Set on om:Page. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:Page ;
    rdfs:range xsd:string .

om:effectiveDate a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "effectiveDate" ;
    rdfs:comment "Date when policy becomes effective. Set on om:AiGovernancePolicy." ;
    rdfs:domain om:AiGovernancePolicy .

om:effectiveFrom a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "effectiveFrom" ;
    rdfs:comment "Date from which this data contract is effective. Set on om:DataContract." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:effectiveUntil a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "effectiveUntil" ;
    rdfs:comment "Date until which this data contract is effective. Set on om:DataContract." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:enableStreamableLogs a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "enableStreamableLogs" ;
    rdfs:comment "Enable real-time log streaming to the OpenMetadata server. When enabled, ingestion logs will be automatically shipped to the server's configured log storage backend (S3 or compatible). Set on om:IngestionPipeline." ;
    rdfs:domain om:IngestionPipeline ;
    rdfs:range xsd:boolean .

om:enabled a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "enabled" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Policy: Is the policy enabled. On om:AiGovernancePolicy: Whether this policy is currently active. On om:AiGovernanceFramework: Whether this framework is enabled in the workspace. Disabled frameworks remain in the library but do not auto-apply." ;
    schema:domainIncludes om:AiGovernanceFramework, om:AiGovernancePolicy, om:Policy ;
    rdfs:range xsd:boolean .

om:enforcementLevel a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "enforcementLevel" ;
    rdfs:comment "How strictly to enforce this policy. Set on om:AiGovernancePolicy." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:entity a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "entity" ;
    rdfs:comment "Reference to the data entity (table, topic, etc.) this contract applies to. Set on om:DataContract. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:entityStatus a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "entityStatus" ;
    rdfs:comment "Lifecycle status of the entity, such as Draft, In Review, Approved, Deprecated or Archived; context memories add statuses such as Superseded and Invalidated. Filter on Approved for governed content." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:Chart, om:Classification, om:Container, om:ContextMemory,
        om:Dashboard, om:DashboardDataModel, om:DashboardService, om:DataContract,
        om:DataProduct, om:Database, om:DatabaseSchema, om:DatabaseService,
        om:Directory, om:Domain, om:File, om:Glossary,
        om:GlossaryTerm, om:LLMModel, om:MLModel, om:MLModelService,
        om:McpServer, om:MessagingService, om:MetadataService, om:Metric,
        om:MetricGroup, om:OntologyRelease, om:Page, om:Pipeline,
        om:PipelineService, om:Query, om:RelationshipType, om:Report,
        om:SearchIndex, om:SearchService, om:Spreadsheet, om:StorageService,
        om:StoredProcedure, om:Table, om:Tag, om:Topic,
        om:Worksheet ;
    rdfs:range xsd:string .

om:estimatedDuration a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "estimatedDuration" ;
    rdfs:comment "Approximate viewing time in seconds. Set on om:LearningResource." ;
    rdfs:domain om:LearningResource .

om:eventSubscriptions a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "eventSubscriptions" ;
    rdfs:comment "Event Subscriptions for the Application. Set on om:App. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:App ;
    rdfs:range xsd:string .

om:evidence a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "evidence" ;
    rdfs:comment "Supporting documentation URLs (DPIA, model card, fairness analysis, technical docs). Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:evidenceRequirements a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "evidenceRequirements" ;
    rdfs:comment "What evidence assessors should attach to demonstrate this control is met. Set on om:AiFrameworkControl. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AiFrameworkControl ;
    rdfs:range xsd:string .

om:examples a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "examples" ;
    rdfs:comment "Examples demonstrating how to use this template. Set on om:PromptTemplate. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:PromptTemplate ;
    rdfs:range xsd:string .

om:exclude_usage a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "exclude_usage" ;
    rdfs:comment "Flag to check if query is to be excluded while processing usage. Set on om:Query." ;
    rdfs:domain om:Query ;
    rdfs:range xsd:boolean .

om:executedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "executedBy" ;
    rdfs:comment "List of users who ran this query. Set on om:Query. Points at the referenced entity's node." ;
    rdfs:domain om:Query .

om:executionId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "executionId" ;
    rdfs:comment "On a pipeline run (om:PipelineExecution), the run's identifier in the pipeline tool." ;
    rdfs:domain om:PipelineExecution ;
    rdfs:range xsd:string .

om:executionStatus a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "executionStatus" ;
    rdfs:comment "On a pipeline run (om:PipelineExecution), the run's status, such as Successful, Failed, Pending or Skipped. Use the latest run's status to judge whether a pipeline's outputs are fresh." ;
    rdfs:domain om:PipelineExecution ;
    rdfs:range xsd:string .

om:expirationDate a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "expirationDate" ;
    rdfs:comment "Date when policy expires. Set on om:AiGovernancePolicy." ;
    rdfs:domain om:AiGovernancePolicy .

om:expressions a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "expressions" ;
    rdfs:comment "Class expressions participating in the axiom, ordered from left to right. Set on om:OntologyAxiom. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyAxiom ;
    rdfs:range xsd:string .

om:extensionKey a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "extensionKey" ;
    rdfs:comment "Name of the custom property, as defined on the entity type." ;
    rdfs:domain om:ExtensionProperty ;
    rdfs:range xsd:string .

om:extensionValue a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "extensionValue" ;
    rdfs:comment "Value of the custom property: a typed literal for a string, number or boolean, and the JSON text of a structured value." ;
    rdfs:domain om:ExtensionProperty .

om:externalId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "externalId" ;
    rdfs:comment "Its meaning depends on the entity type. On om:User: External identifier from identity provider (used for SCIM). On om:Team: External identifier for the team from an external identity provider (e.g., Azure AD group ID)." ;
    schema:domainIncludes om:Team, om:User ;
    rdfs:range xsd:string .

om:extractedText a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "extractedText" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextFileContent: Canonical extracted text for this content snapshot. On om:ContextFile: Full text extracted from the file for search and AI context." ;
    schema:domainIncludes om:ContextFile, om:ContextFileContent ;
    rdfs:range xsd:string .

om:extractionStats a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "extractionStats" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextFile: Statistics from the most recent knowledge-pill extraction run. On om:Page: Statistics from the most recent knowledge-pill extraction run on this page's body. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:ContextFile, om:Page ;
    rdfs:range xsd:string .

om:failureReason a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "failureReason" ;
    rdfs:comment "Stack/message if status=Failed. Set on om:AuditReport." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:string .

om:features a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "features" ;
    rdfs:comment "Features of the Application. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:fileExtension a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "fileExtension" ;
    rdfs:comment "Its meaning depends on the entity type. On om:File: File extension. On om:ContextFile: File extension (e.g., pdf, xlsx)." ;
    schema:domainIncludes om:ContextFile, om:File ;
    rdfs:range xsd:string .

om:fileFormats a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "fileFormats" ;
    rdfs:comment "File & data formats identified for the container: e.g. dataFormats=[csv, json]. Set on om:Container. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Container ;
    rdfs:range xsd:string .

om:fileSize a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "fileSize" ;
    rdfs:comment "File size in bytes. Set on om:ContextFile." ;
    rdfs:domain om:ContextFile .

om:fileType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "fileType" ;
    rdfs:comment "Its meaning depends on the entity type. On om:File: Type of file based on content. On om:ContextFile: Type of file (PDF, Spreadsheet, etc.)." ;
    schema:domainIncludes om:ContextFile, om:File ;
    rdfs:range xsd:string .

om:fileVersion a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "fileVersion" ;
    rdfs:comment "File version information. Set on om:File and om:Spreadsheet; the domain is left open." ;
    schema:domainIncludes om:File, om:Spreadsheet ;
    rdfs:range xsd:string .

om:filters a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "filters" ;
    rdfs:comment "Filters applied to this metric. Set on om:Metric. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:folder a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "folder" ;
    rdfs:comment "Parent folder containing this file. Set on om:ContextFile. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:ContextFile ;
    rdfs:range xsd:string .

om:forkedFrom a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "forkedFrom" ;
    rdfs:comment "When source is 'ForkedFrom', the framework this was forked from. Set on om:AiGovernanceFramework. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:AiGovernanceFramework ;
    rdfs:range xsd:string .

om:framework a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "framework" ;
    rdfs:comment "Its meaning depends on the entity type. On om:AIApplication: Information about the framework used to build the application. On om:AuditReport: Framework this audit pack is scoped to (omit for an estate-wide multi-framework pack). On om:AiFrameworkControl: Framework this control belongs to. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:AIApplication, om:AiFrameworkControl, om:AuditReport ;
    rdfs:range xsd:string .

om:fromColumnFqn a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "fromColumnFqn" ;
    rdfs:comment "Fully qualified name of the source column in a column-level lineage edge, written alongside the column IRI in om:fromColumn for string matching." ;
    schema:domainIncludes om:ColumnLineage .

om:fullPath a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "fullPath" ;
    rdfs:comment "Full path of the container/file. Set on om:Container." ;
    rdfs:domain om:Container ;
    rdfs:range xsd:string .

om:glossaries a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "glossaries" ;
    rdfs:comment "Ontology models affected by this change set. Set on om:OntologyChangeSet. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:OntologyChangeSet ;
    rdfs:range xsd:string .

om:governanceMetadata a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "governanceMetadata" ;
    rdfs:comment "Its meaning depends on the entity type. On om:McpServer: Governance metadata for compliance and risk management of the MCP server. On om:AIApplication: AI governance metadata for compliance and risk management. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:AIApplication, om:McpServer ;
    rdfs:range xsd:string .

om:governanceStatus a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "governanceStatus" ;
    rdfs:comment "Governance status - tracks unauthorized/shadow AI models. Set on om:LLMModel." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:hasAirflowConfig a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasAirflowConfig" ;
    rdfs:comment "Properties to configure the Airflow pipeline that will run the workflow. Set on om:IngestionPipeline. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:IngestionPipeline ;
    rdfs:range xsd:string .

om:hasAlgorithm a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasAlgorithm" ;
    rdfs:comment "Algorithm used to train the ML Model. Set on om:MLModel." ;
    rdfs:domain om:MLModel ;
    rdfs:range xsd:string .

om:hasAppConfiguration a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasAppConfiguration" ;
    rdfs:comment "Application Configuration object. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:hasAppSchedule a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasAppSchedule" ;
    rdfs:comment "In case the app supports scheduling, list of different app schedules. Set on om:App. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:App ;
    rdfs:range xsd:string .

om:hasAsset a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasAsset" ;
    rdfs:comment "An asset that belongs to a domain or data product (its assets field). om:belongsToDomain and om:hasDataProduct on the asset give the same membership from the asset side." ;
    schema:domainIncludes om:DataProduct, om:Domain .

om:hasBot a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasBot" ;
    rdfs:comment "Bot User Associated with this application. Set on om:App. Points at the referenced entity's node." ;
    rdfs:domain om:App .

om:hasCertification a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasCertification" ;
    rdfs:comment "The entity's certification tag, for example Certification.Gold. om:certificationLevel, om:certificationAppliedAt and om:certificationExpiresAt on the entity give its level and validity window." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:Chart,
        om:Container, om:Dashboard, om:DashboardDataModel, om:DataProduct,
        om:Database, om:DatabaseSchema, om:Directory, om:Domain,
        om:File, om:LLMModel, om:MLModel, om:McpServer,
        om:Metric, om:MetricGroup, om:Pipeline, om:SearchIndex,
        om:Spreadsheet, om:StoredProcedure, om:Table, om:Topic,
        om:Worksheet .

om:hasChart a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasChart" ;
    rdfs:comment "All the charts included in this Dashboard. Set on om:Dashboard. Points at the referenced entity's node." ;
    rdfs:domain om:Dashboard .

om:hasChartType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasChartType" ;
    rdfs:comment "Kind of chart, such as Line, Bar, Table, Pie or Map." ;
    rdfs:domain om:Chart ;
    rdfs:range xsd:string .

om:hasChild a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasChild" ;
    rdfs:comment "A child of a container, directory, folder, metric, knowledge page or team (its children field). om:hasParent is the reverse." ;
    schema:domainIncludes om:Container, om:Directory, om:Folder, om:Metric,
        om:Page, om:Team .

om:hasChildColumn a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasChildColumn" ;
    rdfs:comment "Nested column of a struct, map or union column. The projection links each child that has a fully qualified name to its parent column." ;
    schema:domainIncludes om:Column .

om:hasCleanupPolicy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasCleanupPolicy" ;
    rdfs:comment "Kafka cleanup policies of the topic (cleanup.policy), such as delete or compact." ;
    rdfs:domain om:Topic .

om:hasColumnLineage a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasColumnLineage" ;
    rdfs:comment "From a lineage details node (om:LineageDetails) to each column mapping (om:ColumnLineage) of the lineage edge. A mapping names its source columns with om:fromColumn and its target column with om:toColumn." ;
    rdfs:domain om:LineageDetails ;
    rdfs:range om:ColumnLineage .

om:hasConstrainedColumn a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasConstrainedColumn" ;
    rdfs:comment "A column the constraint covers, without its position; om:hasConstraintMember gives the order and, for a foreign key, the pairing with the referred columns." ;
    rdfs:domain om:TableConstraint ;
    rdfs:range om:Column .

om:hasConstraint a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasConstraint" ;
    rdfs:comment "A constraint declared on the table (om:TableConstraint): a primary, unique or foreign key, or a sort, distribution or cluster key. Several column-level PRIMARY_KEY markers become one composite primary key. Read its members in order through om:hasConstraintMember." ;
    rdfs:domain om:Table ;
    rdfs:range om:TableConstraint .

om:hasCustomProperty a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasCustomProperty" ;
    rdfs:comment "A custom property declared on an entity type (om:Type) or carried in an entity's customProperties, as an om:CustomProperty node with om:propertyName, om:propertyType and, when set, om:propertyValue." ;
    schema:domainIncludes om:Table, om:Type ;
    rdfs:range om:CustomProperty .

om:hasDataModel a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasDataModel" ;
    rdfs:comment "The data model behind an asset: for a dashboard, the dashboard data models it is built on; for a table, its dbt model; for a container, the structure of the data it holds." ;
    schema:domainIncludes om:Container, om:Dashboard, om:Table .

om:hasDataProduct a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasDataProduct" ;
    rdfs:comment "A data product the entity is part of (its dataProducts field). Walk it backwards from an om:DataProduct to list the product's assets." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:Chart, om:Container, om:Dashboard, om:DashboardDataModel,
        om:DashboardService, om:Database, om:DatabaseSchema, om:DatabaseService,
        om:Directory, om:DriveService, om:File, om:Glossary,
        om:GlossaryTerm, om:LLMModel, om:LLMService, om:MLModel,
        om:MLModelService, om:McpServer, om:McpService, om:MessagingService,
        om:Metric, om:MetricGroup, om:Page, om:Pipeline,
        om:PipelineService, om:SearchIndex, om:SearchService, om:SecurityService,
        om:Spreadsheet, om:StorageService, om:StoredProcedure, om:Table,
        om:Tag, om:Topic, om:Type, om:Workflow,
        om:Worksheet .

om:hasDefaultRole a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasDefaultRole" ;
    rdfs:comment "Default roles of a team. These roles will be inherited by all the users that are part of this team. Set on om:Team. Points at the referenced entity's node." ;
    rdfs:domain om:Team .

om:hasDirectoryType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasDirectoryType" ;
    rdfs:comment "Type of directory. Set on om:Directory. One of: Root, MyDrive, SharedDrive, TeamDrive, Folder, SharePointSite, SharePointLibrary." ;
    rdfs:domain om:Directory ;
    rdfs:range xsd:string .

om:hasDocumentData a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasDocumentData" ;
    rdfs:comment "The document's JSON payload." ;
    rdfs:domain om:Document ;
    rdfs:range xsd:string .

om:hasExecution a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasExecution" ;
    rdfs:comment "From a pipeline to one of its runs (om:PipelineExecution), with start and end times, status, and the datasets the run used and generated." ;
    rdfs:domain om:Pipeline ;
    rdfs:range om:PipelineExecution .

om:hasExpert a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasExpert" ;
    rdfs:comment "A user who is an expert for the domain, data product or metric (its experts field)." ;
    schema:domainIncludes om:DataProduct, om:Domain, om:Metric .

om:hasExtension a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasExtension" ;
    rdfs:comment "The entity's custom property values (its extension field), as one om:Extension node whose om:hasExtensionProperty entries each carry an om:extensionKey and an om:extensionValue." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:AiFrameworkControl,
        om:AiGovernanceFramework, om:AiGovernancePolicy, om:AuditReport, om:Chart,
        om:Container, om:Dashboard, om:DashboardDataModel, om:DataContract,
        om:DataProduct, om:Database, om:DatabaseSchema, om:Directory,
        om:Domain, om:File, om:Glossary, om:GlossaryTerm,
        om:LLMModel, om:LearningResource, om:MLModel, om:McpServer,
        om:Metric, om:MetricGroup, om:Page, om:Pipeline,
        om:PromptTemplate, om:SearchIndex, om:Spreadsheet, om:StoredProcedure,
        om:Table, om:Team, om:Topic, om:User,
        om:Worksheet ;
    rdfs:range om:Extension .

om:hasExtensionProperty a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasExtensionProperty" ;
    rdfs:comment "One custom property value of an extension, an om:ExtensionProperty node with om:extensionKey and om:extensionValue." ;
    rdfs:domain om:Extension ;
    rdfs:range om:ExtensionProperty .

om:hasField a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasField" ;
    rdfs:comment "Fields in this SearchIndex. Set on om:SearchIndex. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:SearchIndex ;
    rdfs:range xsd:string .

om:hasFileFormat a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasFileFormat" ;
    rdfs:comment "File format in case of file/datalake tables. Set on om:Table. One of: csv, csv.gz, tsv, avro, parquet, pq, pqt, parq, parquet.snappy, json, json.gz, json.zip." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:hasFollower a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasFollower" ;
    rdfs:comment "A user who follows the entity (its followers field)." ;
    schema:domainIncludes om:AIApplication, om:APIEndpoint, om:APIService, om:AiGovernancePolicy,
        om:Chart, om:Container, om:ContextFile, om:Dashboard,
        om:DashboardDataModel, om:DashboardService, om:DataProduct, om:Database,
        om:DatabaseSchema, om:DatabaseService, om:Directory, om:Domain,
        om:DriveService, om:File, om:Folder, om:IngestionPipeline,
        om:LLMModel, om:LLMService, om:LearningResource, om:MLModel,
        om:MLModelService, om:McpServer, om:McpService, om:MessagingService,
        om:MetadataService, om:Metric, om:MetricGroup, om:Page,
        om:Pipeline, om:PipelineService, om:PromptTemplate, om:Query,
        om:SearchIndex, om:SearchService, om:SecurityService, om:Spreadsheet,
        om:StorageService, om:StoredProcedure, om:Table, om:Topic,
        om:Worksheet .

om:hasGranularity a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasGranularity" ;
    rdfs:comment "Metric's granularity. Set on om:Metric. One of: SECOND, MINUTE, HOUR, DAY, WEEK, MONTH, QUARTER, YEAR." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:hasIndexSettings a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasIndexSettings" ;
    rdfs:comment "Contains key/value pair of searchIndex settings. Set on om:SearchIndex. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:SearchIndex ;
    rdfs:range xsd:string .

om:hasIndexType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasIndexType" ;
    rdfs:comment "Whether the entity is index or index template. Set on om:SearchIndex. One of: Index, IndexTemplate." ;
    rdfs:domain om:SearchIndex ;
    rdfs:range xsd:string .

om:hasLifeCycle a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasLifeCycle" ;
    rdfs:comment "The entity's lifecycle node (om:LifeCycle): when it was created, last updated and last accessed in its source system, and by whom. Use it to judge whether an asset is still in use." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:AiFrameworkControl,
        om:AiGovernanceFramework, om:AiGovernancePolicy, om:Chart, om:Container,
        om:Dashboard, om:DashboardDataModel, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:LLMModel, om:MLModel,
        om:McpServer, om:Pipeline, om:PromptTemplate, om:SearchIndex,
        om:Spreadsheet, om:StoredProcedure, om:Table, om:Topic,
        om:Worksheet ;
    rdfs:range om:LifeCycle .

om:hasLineageDetails a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasLineageDetails" ;
    rdfs:comment "From the upstream asset of a lineage edge to the edge's details node (om:LineageDetails), which records the SQL, how the lineage was created, the pipeline that produces it and the column mappings." ;
    schema:domainIncludes om:DataAsset ;
    rdfs:range om:LineageDetails .

om:hasLineageNode a rdf:Property ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:label "hasLineageNode" ;
    rdfs:comment "Not emitted by the metadata projection for current entity schemas. Available to explicit graph exports or custom projections using the structured mapper." .

om:hasLoggerLevel a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasLoggerLevel" ;
    rdfs:comment "Set the logging level for the workflow. Set on om:IngestionPipeline. One of: DEBUG, INFO, WARN, ERROR." ;
    rdfs:domain om:IngestionPipeline ;
    rdfs:range xsd:string .

om:hasMLDashboard a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasMLDashboard" ;
    rdfs:comment "Performance Dashboard URL to track metric evolution. Set on om:MLModel. Points at the referenced entity's node." ;
    rdfs:domain om:MLModel .

om:hasMLFeature a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasMLFeature" ;
    rdfs:comment "Features used to train the ML Model. Set on om:MLModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:MLModel ;
    rdfs:range xsd:string .

om:hasMLHyperParameter a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasMLHyperParameter" ;
    rdfs:comment "Hyper Parameters used to train the ML Model. Set on om:MLModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:MLModel ;
    rdfs:range xsd:string .

om:hasMLStore a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasMLStore" ;
    rdfs:comment "Location containing the ML Model. It can be a storage layer and/or a container repository. Set on om:MLModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:MLModel ;
    rdfs:range xsd:string .

om:hasMember a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasMember" ;
    rdfs:comment "On a team, a user that is part of it; on a role, a user who has the role (the users field)." ;
    schema:domainIncludes om:Role, om:Team .

om:hasMessageSchema a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasMessageSchema" ;
    rdfs:comment "The schema of the topic's messages (schema type, schema text and parsed fields), as JSON text." ;
    rdfs:domain om:Topic ;
    rdfs:range xsd:string .

om:hasMetricExpression a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasMetricExpression" ;
    rdfs:comment "Expression used to compute the metric. Set on om:Metric. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:hasMetricType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasMetricType" ;
    rdfs:comment "Type of the metric. Set on om:Metric. One of: COUNT, SUM, AVERAGE, RATIO, PERCENTAGE, MIN, MAX, MEDIAN, MODE, STANDARD_DEVIATION, VARIANCE, SIMPLE." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:hasParent a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasParent" ;
    rdfs:comment "The parent of a container, directory, metric or team (its parent or parents field). Walk it upward to the top of the hierarchy; om:hasChild is the reverse." ;
    schema:domainIncludes om:Container, om:Directory, om:Metric, om:Team .

om:hasPart a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasPart" ;
    rdfs:comment "Glossary term relation of type hasPart: the object concept is a part or component of the subject concept. om:partOf is the inverse." ;
    schema:domainIncludes om:GlossaryTerm .

om:hasPartition a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasPartition" ;
    rdfs:comment "Partitioning. For a topic, the number of partitions; for a table, its partition columns and intervals as JSON text." ;
    schema:domainIncludes om:Table, om:Topic .

om:hasPath a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasPath" ;
    rdfs:comment "Its meaning depends on the entity type. On om:File: Full path to the file. On om:Directory: Full path to the directory. On om:Spreadsheet: Full path to the spreadsheet file." ;
    schema:domainIncludes om:Directory, om:File, om:Spreadsheet ;
    rdfs:range xsd:string .

om:hasPipelineStatus a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasPipelineStatus" ;
    rdfs:comment "List of the most recent executions and status for the Pipeline. Set on om:IngestionPipeline. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:IngestionPipeline ;
    rdfs:range xsd:string .

om:hasPromptTemplate a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasPromptTemplate" ;
    rdfs:comment "Prompt templates used by this application. Set on om:AIApplication. Points at the referenced entity's node." ;
    rdfs:domain om:AIApplication .

om:hasQueryText a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasQueryText" ;
    rdfs:comment "The SQL text of a query (om:Query) recorded in OpenMetadata. Search it to find the queries that read or write a table." ;
    rdfs:domain om:Query ;
    rdfs:range xsd:string .

om:hasReference a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasReference" ;
    rdfs:comment "Link to a reference from an external glossary. Set on om:GlossaryTerm. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:GlossaryTerm ;
    rdfs:range xsd:string .

om:hasReferredColumn a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasReferredColumn" ;
    rdfs:comment "For a foreign key, a column of the referenced table, without its position; pair it with the constrained columns through om:hasConstraintMember." ;
    rdfs:domain om:TableConstraint ;
    rdfs:range om:Column .

om:hasRelatedMetric a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasRelatedMetric" ;
    rdfs:comment "Related Metrics. Set on om:Metric. Points at the referenced entity's node." ;
    rdfs:domain om:Metric .

om:hasReplicationFactor a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasReplicationFactor" ;
    rdfs:comment "Replication Factor in integer (more than 1). Set on om:Topic." ;
    rdfs:domain om:Topic .

om:hasRequestMethod a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasRequestMethod" ;
    rdfs:comment "Request Method for the API Endpoint. Set on om:APIEndpoint. One of: GET, POST, PUT, PATCH, DELETE, HEAD, CONNECT, OPTIONS, TRACE." ;
    rdfs:domain om:APIEndpoint ;
    rdfs:range xsd:string .

om:hasResponseSchema a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasResponseSchema" ;
    rdfs:comment "Response Schema for the API Endpoint. Set on om:APIEndpoint. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:APIEndpoint ;
    rdfs:range xsd:string .

om:hasRetentionTime a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasRetentionTime" ;
    rdfs:comment "Retention time in milliseconds. For Kafka - retention.ms configuration. Set on om:Topic." ;
    rdfs:domain om:Topic .

om:hasReviewer a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasReviewer" ;
    rdfs:comment "A user or team that reviews changes to this glossary, glossary term, classification, tag, data product or data contract (its reviewers field). Other entity types expose the same field as om:reviewers." ;
    schema:domainIncludes om:Classification, om:DataContract, om:DataProduct, om:Glossary,
        om:GlossaryTerm, om:Tag .

om:hasRole a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasRole" ;
    rdfs:comment "A role: on a user, a role assigned to the user; on a policy, a role that uses the policy." ;
    schema:domainIncludes om:Policy, om:User .

om:hasSampleData a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasSampleData" ;
    rdfs:comment "The asset's sample data as JSON text: sample rows for a table, file, container or worksheet, sample messages for a topic. Often absent." ;
    schema:domainIncludes om:Container, om:File, om:SearchIndex, om:Table,
        om:Topic, om:Worksheet ;
    rdfs:range xsd:string .

om:hasScheduleInterval a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasScheduleInterval" ;
    rdfs:comment "Scheduler Interval for the pipeline in cron format. Set on om:Pipeline." ;
    rdfs:domain om:Pipeline ;
    rdfs:range xsd:string .

om:hasSchemaDefinition a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasSchemaDefinition" ;
    rdfs:comment "The DDL that creates the table or view, as captured from the source; for a view it includes the query that defines it." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:hasServer a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasServer" ;
    rdfs:comment "Endpoint that serves the ML model, such as a REST API that computes predictions." ;
    rdfs:domain om:MLModel ;
    rdfs:range xsd:string .

om:hasServiceType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasServiceType" ;
    rdfs:comment "The type of service that hosts the asset, such as Snowflake, BigQuery, Kafka or GoogleDrive." ;
    schema:domainIncludes om:APICollection, om:APIEndpoint, om:Chart, om:Container,
        om:Dashboard, om:DashboardDataModel, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:MLModel, om:Pipeline,
        om:SearchIndex, om:Spreadsheet, om:StoredProcedure, om:Table,
        om:Topic, om:Worksheet ;
    rdfs:range xsd:string .

om:hasStartDate a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasStartDate" ;
    rdfs:comment "Start date of the workflow. Set on om:Pipeline." ;
    rdfs:domain om:Pipeline .

om:hasStatus a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasStatus" ;
    rdfs:comment "Workflow computation status. Set on om:Workflow. One of: Pending, Successful, Failed, Running." ;
    rdfs:domain om:Workflow ;
    rdfs:range xsd:string .

om:hasStyle a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasStyle" ;
    rdfs:comment "UI Style is used to associate a color code and/or icon to entity to customize the look of that entity in UI. Set on om:DataProduct, om:Domain, om:GlossaryTerm and om:Tag; the domain is left open. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:DataProduct, om:Domain, om:GlossaryTerm, om:Tag ;
    rdfs:range xsd:string .

om:hasTableType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasTableType" ;
    rdfs:comment "Kind of table, such as Regular, View, MaterializedView, External, Iceberg or Partitioned. Use it to tell views from base tables." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:hasTarget a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasTarget" ;
    rdfs:comment "For supervised ML Models, the value to estimate. Set on om:MLModel." ;
    rdfs:domain om:MLModel ;
    rdfs:range xsd:string .

om:hasTier a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasTier" ;
    rdfs:comment "The entity's tier tag, a tag under the Tier classification such as Tier.Tier1 that marks business importance. The same tag also appears under om:hasTag; filter on its om:tagFQN." ;
    schema:domainIncludes om:Table .

om:hasTopicConfig a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasTopicConfig" ;
    rdfs:comment "Contains key/value pair of topic configuration. Set on om:Topic. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Topic ;
    rdfs:range xsd:string .

om:hasUnitOfMeasurement a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasUnitOfMeasurement" ;
    rdfs:comment "Unit of measurement for the metric. Set on om:Metric. One of: COUNT, DOLLARS, PERCENTAGE, TIMESTAMP, SIZE, REQUESTS, EVENTS, TRANSACTIONS, OTHER." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:hasWorksheet a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "hasWorksheet" ;
    rdfs:comment "References to worksheets/tabs in the spreadsheet. Set on om:Spreadsheet. Points at the referenced entity's node." ;
    rdfs:domain om:Spreadsheet .

om:headContentId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "headContentId" ;
    rdfs:comment "Identifier of the current ContextFileContent snapshot for this file. Set on om:ContextFile." ;
    rdfs:domain om:ContextFile ;
    rdfs:range xsd:string .

om:icon a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "icon" ;
    rdfs:comment "Optional icon identifier for UI display. Set on om:Folder." ;
    rdfs:domain om:Folder ;
    rdfs:range xsd:string .

om:impersonatedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "impersonatedBy" ;
    rdfs:comment "The bot that made the entity's last change on behalf of a user, when that change was impersonated." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:App, om:AppMarketPlaceDefinition, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextMemory, om:Dashboard,
        om:DashboardDataModel, om:DashboardService, om:DataContract, om:DataProduct,
        om:Database, om:DatabaseSchema, om:DatabaseService, om:Directory,
        om:Document, om:Domain, om:DriveService, om:File,
        om:Glossary, om:GlossaryTerm, om:IngestionPipeline, om:LLMModel,
        om:LearningResource, om:MLModel, om:MLModelService, om:McpServer,
        om:MessagingService, om:MetadataService, om:Metric, om:MetricGroup,
        om:NotificationTemplate, om:Ontology, om:OntologyAxiom, om:OntologyConcept,
        om:OntologyProperty, om:OntologyRelease, om:Page, om:Persona,
        om:Pipeline, om:PipelineService, om:Policy, om:Query,
        om:RelationshipType, om:Report, om:Role, om:SearchIndex,
        om:SearchService, om:SecurityService, om:Spreadsheet, om:StorageService,
        om:StoredProcedure, om:Table, om:Tag, om:Team,
        om:TestConnectionDefinition, om:Topic, om:Type, om:User,
        om:Workflow, om:Worksheet ;
    rdfs:range xsd:string .

om:includeRedacted a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "includeRedacted" ;
    rdfs:comment "Whether to include normally-redacted evidence (DPIAs, model cards, etc.). Set on om:AuditReport." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:boolean .

om:incrementalChangeDescription a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "incrementalChangeDescription" ;
    rdfs:comment "JSON of the change that produced the entity's current version: fields added, updated and deleted. It is one step, not the history; the entity version APIs keep the history." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextFileContent,
        om:ContextMemory, om:Dashboard, om:DashboardDataModel, om:DashboardService,
        om:DataContract, om:DataProduct, om:Database, om:DatabaseSchema,
        om:DatabaseService, om:Directory, om:Document, om:Domain,
        om:DriveService, om:File, om:Folder, om:Glossary,
        om:GlossaryTerm, om:IngestionPipeline, om:LLMModel, om:LLMService,
        om:LearningResource, om:MLModel, om:MLModelService, om:McpServer,
        om:McpService, om:MessagingService, om:MetadataService, om:Metric,
        om:MetricGroup, om:NotificationTemplate, om:Ontology, om:OntologyAxiom,
        om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty, om:OntologyRelease,
        om:Page, om:Persona, om:Pipeline, om:PipelineService,
        om:Policy, om:PromptTemplate, om:Query, om:RelationshipType,
        om:Report, om:Role, om:SearchIndex, om:SearchService,
        om:SecurityService, om:Spreadsheet, om:StorageService, om:StoredProcedure,
        om:Table, om:Tag, om:Team, om:TestConnectionDefinition,
        om:Topic, om:Type, om:User, om:Workflow,
        om:Worksheet ;
    rdfs:range xsd:string .

om:index a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "index" ;
    rdfs:comment "Position/index of the worksheet in the spreadsheet. Set on om:Worksheet." ;
    rdfs:domain om:Worksheet .

om:ingestedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "ingestedAt" ;
    rdfs:comment "Time the content snapshot was ingested. Set on om:ContextFileContent." ;
    rdfs:domain om:ContextFileContent .

om:ingestionRunner a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "ingestionRunner" ;
    rdfs:comment "The ingestion agent responsible for executing the ingestion pipeline. Set on many entity types; the domain is left open. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:APIService, om:App, om:DashboardService, om:DatabaseService,
        om:DriveService, om:IngestionPipeline, om:LLMService, om:MLModelService,
        om:McpService, om:MessagingService, om:MetadataService, om:PipelineService,
        om:SearchService, om:SecurityService, om:StorageService ;
    rdfs:range xsd:string .

om:inherited a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "inherited" ;
    rdfs:comment "Indicates whether this data contract is inherited from a parent entity. Set on om:DataContract." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:boolean .

om:inheritedPersonas a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "inheritedPersonas" ;
    rdfs:comment "Personas inherited through membership in teams that have set a team default persona. Set on om:User. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:User ;
    rdfs:range xsd:string .

om:inheritedRoles a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "inheritedRoles" ;
    rdfs:comment "Its meaning depends on the entity type. On om:User: Roles that a user is inheriting through membership in teams that have set team default roles. On om:Team: Roles that a team is inheriting through membership in teams that have set team default roles. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    schema:domainIncludes om:Team, om:User ;
    rdfs:range xsd:string .

om:installedPacks a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "installedPacks" ;
    rdfs:comment "Verified library packs installed into this ontology, one entry per pack ID. Set on om:Ontology. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Ontology ;
    rdfs:range xsd:string .

om:inputPort a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "inputPort" ;
    rdfs:comment "From a data product to an asset that is one of its input ports: data the product consumes." ;
    schema:domainIncludes om:DataProduct .

om:inverse a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "inverse" ;
    rdfs:comment "Its meaning depends on the entity type. On om:RelationshipType: Inverse relationship type. Symmetric types reference themselves. On om:OntologyProperty: Semantic IRI of the inverse object property. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:OntologyProperty, om:RelationshipType ;
    rdfs:range xsd:string .

om:iri a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "iri" ;
    rdfs:comment "The semantic IRI of a glossary term, relationship type, ontology, ontology concept or ontology property, preserved across import and export. It differs from the node's own IRI, which identifies the catalog entity; no owl:sameAs joins the two." ;
    schema:domainIncludes om:GlossaryTerm, om:Ontology, om:OntologyConcept, om:OntologyProperty,
        om:RelationshipType ;
    rdfs:range xsd:string .

om:isAdmin a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isAdmin" ;
    rdfs:comment "When true indicates user is an administrator for the system with superuser privileges. Set on om:User." ;
    rdfs:domain om:User ;
    rdfs:range xsd:boolean .

om:isBot a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isBot" ;
    rdfs:comment "When true indicates a special type of user called Bot. Set on om:User." ;
    rdfs:domain om:User ;
    rdfs:range xsd:boolean .

om:isCurrent a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isCurrent" ;
    rdfs:comment "Whether this is the current content snapshot for the file. Set on om:ContextFileContent." ;
    rdfs:domain om:ContextFileContent ;
    rdfs:range xsd:boolean .

om:isDeleted a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isDeleted" ;
    rdfs:comment "True when the entity is soft-deleted (the deleted field)." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:APIService,
        om:AiFrameworkControl, om:AiGovernanceFramework, om:AiGovernancePolicy, om:App,
        om:AppMarketPlaceDefinition, om:AuditReport, om:Bot, om:Chart,
        om:Classification, om:Container, om:ContextFile, om:ContextFileContent,
        om:ContextMemory, om:Dashboard, om:DashboardDataModel, om:DashboardService,
        om:DataContract, om:Database, om:DatabaseSchema, om:DatabaseService,
        om:Directory, om:DriveService, om:File, om:Folder,
        om:Glossary, om:GlossaryTerm, om:IngestionPipeline, om:LLMModel,
        om:LLMService, om:LearningResource, om:MLModel, om:MLModelService,
        om:McpServer, om:McpService, om:MessagingService, om:MetadataService,
        om:Metric, om:MetricGroup, om:NotificationTemplate, om:Ontology,
        om:OntologyAxiom, om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty,
        om:OntologyRelease, om:Pipeline, om:PipelineService, om:Policy,
        om:PromptTemplate, om:RelationshipType, om:Report, om:Role,
        om:SearchIndex, om:SearchService, om:SecurityService, om:Spreadsheet,
        om:StorageService, om:StoredProcedure, om:Table, om:Tag,
        om:Team, om:TestConnectionDefinition, om:Topic, om:User,
        om:Workflow, om:Worksheet ;
    rdfs:range xsd:boolean .

om:isDeployed a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isDeployed" ;
    rdfs:comment "Indicates if the workflow has been successfully deployed to Airflow. Set on om:IngestionPipeline." ;
    rdfs:domain om:IngestionPipeline ;
    rdfs:range xsd:boolean .

om:isDisabled a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isDisabled" ;
    rdfs:comment "True when a system tag, classification, glossary, glossary term, policy or role has been disabled instead of deleted. Do not apply a disabled tag." ;
    schema:domainIncludes om:Classification, om:Glossary, om:GlossaryTerm, om:Policy,
        om:Role, om:Tag ;
    rdfs:range xsd:boolean .

om:isEmailVerified a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isEmailVerified" ;
    rdfs:comment "If the User has verified the mail. Set on om:User." ;
    rdfs:domain om:User ;
    rdfs:range xsd:boolean .

om:isEnabled a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isEnabled" ;
    rdfs:comment "Its meaning depends on the entity type. On om:IngestionPipeline: True if the pipeline is ready to be run in the next schedule. On om:App, om:AppMarketPlaceDefinition: Flag to enable/disable the application. If the app is not enabled, it can't be installed." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition, om:IngestionPipeline ;
    rdfs:range xsd:boolean .

om:isHidden a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isHidden" ;
    rdfs:comment "Whether the worksheet is hidden. Set on om:Worksheet." ;
    rdfs:domain om:Worksheet ;
    rdfs:range xsd:boolean .

om:isJoinable a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isJoinable" ;
    rdfs:comment "Can any user join this team during sign up? Value of true indicates yes, and false no. Set on om:Team." ;
    rdfs:domain om:Team ;
    rdfs:range xsd:boolean .

om:isModifiedFromDefault a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isModifiedFromDefault" ;
    rdfs:comment "Indicates if this system template has been modified from its default version. Set on om:NotificationTemplate." ;
    rdfs:domain om:NotificationTemplate ;
    rdfs:range xsd:boolean .

om:isMutuallyExclusive a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isMutuallyExclusive" ;
    rdfs:comment "True when the children of this classification, tag, glossary or glossary term are mutually exclusive: an entity may carry at most one of them." ;
    schema:domainIncludes om:Classification, om:Glossary, om:GlossaryTerm, om:Tag ;
    rdfs:range xsd:boolean .

om:isShared a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isShared" ;
    rdfs:comment "Its meaning depends on the entity type. On om:File: Whether this file is shared. On om:Directory: Whether this directory is shared." ;
    schema:domainIncludes om:Directory, om:File ;
    rdfs:range xsd:boolean .

om:isUnique a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isUnique" ;
    rdfs:comment "True when the column alone is unique, from a column-level UNIQUE constraint, a single-column PRIMARY_KEY or UNIQUE table constraint, or a column-level PRIMARY_KEY that no other column of the table shares. Composite keys use om:hasConstrainedColumn and om:hasConstraintMember and do not imply individual uniqueness; PRIMARY_KEY markers on several columns state one composite key." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:boolean .

om:joins a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "joins" ;
    rdfs:comment "Details of other tables this table is frequently joined with. Set on om:Table. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:kind a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "kind" ;
    rdfs:comment "Its meaning depends on the entity type. On om:OntologyProperty: the kind of property, OBJECT, DATA or ANNOTATION." ;
    schema:domainIncludes om:OntologyProperty ;
    rdfs:range xsd:string .

om:knowledgeBases a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "knowledgeBases" ;
    rdfs:comment "Vector databases, document stores used for RAG. Set on om:AIApplication. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:labelType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "labelType" ;
    rdfs:comment "How a tag label was applied, such as Manual, Automated or Derived. It sits on the tag's shared node, so it mixes the labels of every entity carrying that tag and does not say how one entity was tagged." ;
    schema:domainIncludes om:Tag ;
    rdfs:range xsd:string .

om:lastActivityTime a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lastActivityTime" ;
    rdfs:comment "Last time the user was active in the system. Set on om:User." ;
    rdfs:domain om:User .

om:lastContentUpdatedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lastContentUpdatedAt" ;
    rdfs:comment "Server-owned timestamp of the latest change to memory content or its subject. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory .

om:lastLoginTime a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lastLoginTime" ;
    rdfs:comment "Last time the user logged in. Set on om:User." ;
    rdfs:domain om:User .

om:lastModifiedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lastModifiedBy" ;
    rdfs:comment "Its meaning depends on the entity type. On om:File: User who last modified the file. On om:Spreadsheet: User who last modified the spreadsheet. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:File, om:Spreadsheet ;
    rdfs:range xsd:string .

om:lastReviewedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lastReviewedAt" ;
    rdfs:comment "When this memory was last confirmed to hold: set whenever it becomes Approved, and each time Memory Reconciliation revalidates it. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory .

om:lastUsedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lastUsedAt" ;
    rdfs:comment "Last time the memory was used by AI-assisted retrieval. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory .

om:latestResult a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "latestResult" ;
    rdfs:comment "Latest validation of the data contract, as JSON text: its timestamp, status and message." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:layer a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "layer" ;
    rdfs:comment "Governance layer of an ontology model. Set on om:Ontology. One of: L1, L2, L3." ;
    rdfs:domain om:Ontology ;
    rdfs:range xsd:string .

om:lifecycleAccessed a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lifecycleAccessed" ;
    rdfs:comment "On om:LifeCycle, the om:AccessDetails of the last access to the asset in its source system." ;
    rdfs:domain om:LifeCycle ;
    rdfs:range om:AccessDetails .

om:lifecycleCreated a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lifecycleCreated" ;
    rdfs:comment "On om:LifeCycle, the om:AccessDetails of the asset's creation in its source system." ;
    rdfs:domain om:LifeCycle ;
    rdfs:range om:AccessDetails .

om:lifecycleUpdated a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lifecycleUpdated" ;
    rdfs:comment "On om:LifeCycle, the om:AccessDetails of the asset's last update in its source system." ;
    rdfs:domain om:LifeCycle ;
    rdfs:range om:AccessDetails .

om:lineageUpdatedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lineageUpdatedBy" ;
    rdfs:comment "Name of the user who last updated the lineage edge." ;
    rdfs:domain om:LineageDetails ;
    rdfs:range xsd:string .

om:literal a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "literal" ;
    rdfs:comment "A typed OWL literal. Set on om:OntologyAxiom. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyAxiom ;
    rdfs:range xsd:string .

om:location a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "location" ;
    rdfs:comment "Location to which a policy is applied. This field is relevant only for lifeCycle policies. Set on om:Policy. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:Policy ;
    rdfs:range xsd:string .

om:locationPath a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "locationPath" ;
    rdfs:comment "Full storage path in case of external and managed tables. Set on om:Table." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:machineRepresentation a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "machineRepresentation" ;
    rdfs:comment "Optional machine-oriented representation used for prompt packing. Set on om:ContextMemory. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:manifest a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "manifest" ;
    rdfs:comment "Top-level inventory included in the pack. Set on om:AuditReport. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:string .

om:maximumMessageSize a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "maximumMessageSize" ;
    rdfs:comment "Maximum message size in bytes. For Kafka - max.message.bytes configuration. Set on om:Topic." ;
    rdfs:domain om:Topic .

om:measures a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "measures" ;
    rdfs:comment "Measures associated with this metric from a semantic layer. Set on om:Metric. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:memoryCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "memoryCount" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextFile: Number of knowledge pills (context memories) extracted from this file. On om:Page: Number of knowledge pills (context memories) extracted from this page." ;
    schema:domainIncludes om:ContextFile, om:Page .

om:memoryScope a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "memoryScope" ;
    rdfs:comment "Scope where the memory should be applied. Set on om:ContextMemory. One of: UserGlobal, EntityScoped." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:memoryStats a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "memoryStats" ;
    rdfs:comment "Telemetry + hash-gate for the Memory Agent derivation of this memory. Set on om:ContextMemory. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:memoryType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "memoryType" ;
    rdfs:comment "High-level type of reusable memory. Learning is something the agent had to discover in a conversation, e.g. a failed query and its fix. Set on om:ContextMemory. One of: Preference, UseCase, Note, Runbook, Faq, Learning." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:metricCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "metricCount" ;
    rdfs:comment "Count of non-deleted metrics in this group. Computed on read and never stored. Set on om:MetricGroup." ;
    rdfs:domain om:MetricGroup .

om:metricGroup a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "metricGroup" ;
    rdfs:comment "Metric Group this metric belongs to, if any. A group organizes metrics for browsing; membership is a relationship, so it is derived on read and never stored on the metric. Set on om:Metric. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:Metric ;
    rdfs:range xsd:string .

om:metrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "metrics" ;
    rdfs:comment "Its meaning depends on the entity type. On om:PromptTemplate: Usage and performance metrics for the prompt template. On om:MetricGroup: Metrics that belong to this group. This relationship-derived field is used internally for mutations and is exposed to clients only through the authorized, paginated /v1/metricGroups/{id}/metrics endpoint. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    schema:domainIncludes om:MetricGroup, om:PromptTemplate ;
    rdfs:range xsd:string .

om:minimumInSyncReplicas a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "minimumInSyncReplicas" ;
    rdfs:comment "Minimum number replicas in sync to control durability. For Kafka - min.insync.replicas configuration. Set on om:Topic." ;
    rdfs:domain om:Topic .

om:modelConfigurations a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "modelConfigurations" ;
    rdfs:comment "Multiple LLM models this application can use for different purposes. Set on om:AIApplication. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:modelEvaluation a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "modelEvaluation" ;
    rdfs:comment "Comprehensive evaluation metrics for the LLM model. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:modelProvider a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "modelProvider" ;
    rdfs:comment "Model provider (e.g., 'OpenAI', 'Anthropic', 'Meta'). Set on om:LLMModel." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:modelSpecifications a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "modelSpecifications" ;
    rdfs:comment "Technical specifications of the model. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:modelType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "modelType" ;
    rdfs:comment "Type of LLM model. Set on om:LLMModel. One of: BaseModel, FineTuned, Quantized, Distilled, Adapter, Custom." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:modelVersion a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "modelVersion" ;
    rdfs:comment "Version of the model. Set on om:LLMModel." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:models a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "models" ;
    rdfs:comment "LLM Models registered with this service. Set on om:LLMService. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:LLMService ;
    rdfs:range xsd:string .

om:modifiedTime a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "modifiedTime" ;
    rdfs:comment "Last modification timestamp. Set on om:File and om:Spreadsheet; the domain is left open." ;
    schema:domainIncludes om:File, om:Spreadsheet .

om:name a rdf:Property ;
    om:projectionStatus om:InferenceOnly ;
    rdfs:label "name" ;
    rdfs:comment "Not emitted by the metadata projection for current entity schemas. Available to explicit graph exports or custom projections using the structured mapper." .

om:nameSpace a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "nameSpace" ;
    rdfs:comment "Namespace or group to which this type belongs to. For example, some of the property types commonly used can come from basic namespace. Set on om:Type." ;
    rdfs:domain om:Type ;
    rdfs:range xsd:string .

om:namespace a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "namespace" ;
    rdfs:comment "Absolute namespace used to mint persistent IRIs for native definitions. Set on om:Ontology." ;
    rdfs:domain om:Ontology ;
    rdfs:range xsd:string .

om:namespaces a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "namespaces" ;
    rdfs:comment "Namespace prefix to IRI mappings for terms imported from an external ontology. Set on om:Glossary. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Glossary ;
    rdfs:range xsd:string .

om:neverExtracted a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "neverExtracted" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextFile: Whether this file was processed but its memories were never extracted, so it shows as Not processed. On om:Page: Whether this article has a body but its memories were never extracted, so it shows as Not processed." ;
    schema:domainIncludes om:ContextFile, om:Page ;
    rdfs:range xsd:boolean .

om:nextDeadline a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "nextDeadline" ;
    rdfs:comment "Next certification or assessment deadline. Set on om:AiGovernanceFramework." ;
    rdfs:domain om:AiGovernanceFramework .

om:numberOfFiles a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "numberOfFiles" ;
    rdfs:comment "Number of files in this directory. Set on om:Directory." ;
    rdfs:domain om:Directory .

om:numberOfSubDirectories a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "numberOfSubDirectories" ;
    rdfs:comment "Number of subdirectories. Set on om:Directory." ;
    rdfs:domain om:Directory .

om:odcsElementExtensions a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "odcsElementExtensions" ;
    rdfs:comment "ODCS schema element attributes with no OpenMetadata equivalent, stored during import for round-trip compatibility with ODCS export. Set on om:DataContract. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:odcsPreservedFields a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "odcsPreservedFields" ;
    rdfs:comment "ODCS metadata without a native OpenMetadata mapping, retained as a generic JSON document for export. Set on om:DataContract. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:odcsQualityRules a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "odcsQualityRules" ;
    rdfs:comment "Quality rules imported from an ODCS contract, kept as JSON text so the contract can be exported to ODCS again." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:ontology a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "ontology" ;
    rdfs:comment "The ontology that owns a concept, property, axiom, change set or release, as the reference's JSON text." ;
    schema:domainIncludes om:OntologyAxiom, om:OntologyChangeSet, om:OntologyConcept, om:OntologyProperty,
        om:OntologyRelease ;
    rdfs:range xsd:string .

om:operations a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "operations" ;
    rdfs:comment "Typed operations the ontology change set proposes, as JSON text." ;
    rdfs:domain om:OntologyChangeSet ;
    rdfs:range xsd:string .

om:ordinalPosition a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "ordinalPosition" ;
    rdfs:comment "Position of the column within its table, as ingested from the source; order by it to list columns as declared." ;
    rdfs:domain om:Column ;
    rdfs:range xsd:int .

om:outcomes a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "outcomes" ;
    rdfs:comment "Outcome counters of the answers this memory was applied to. Only the outcome write sets them; metadata writes keep the stored values. Set on om:ContextMemory. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:outputPort a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "outputPort" ;
    rdfs:comment "From a data product to an asset that is one of its output ports: data the product serves to consumers." ;
    schema:domainIncludes om:DataProduct .

om:page a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "page" ;
    rdfs:comment "Knowledge Page Schema. Set on om:Page." ;
    rdfs:domain om:Page ;
    rdfs:range xsd:string .

om:pageCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "pageCount" ;
    rdfs:comment "Number of pages (PDF) or sheets (spreadsheet). Set on om:ContextFile." ;
    rdfs:domain om:ContextFile .

om:pageType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "pageType" ;
    rdfs:comment "Type of the Knowledge Page. Set on om:Page. One of: Article, QuickLink." ;
    rdfs:domain om:Page ;
    rdfs:range xsd:string .

om:paletteKey a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "paletteKey" ;
    rdfs:comment "Colour the UI uses to draw the relationship type; it carries no meaning." ;
    rdfs:domain om:RelationshipType ;
    rdfs:range xsd:string .

om:parent a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "parent" ;
    rdfs:comment "On om:Folder, the parent folder; on om:Page, the parent knowledge page. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:Folder, om:Page ;
    rdfs:range xsd:string .

om:parentMemory a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "parentMemory" ;
    rdfs:comment "Immediate parent memory in an append-style thread. Set on om:ContextMemory. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:parentTemplate a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "parentTemplate" ;
    rdfs:comment "Reference to parent template if this is a version/fork. Set on om:PromptTemplate. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:PromptTemplate ;
    rdfs:range xsd:string .

om:partOf a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "partOf" ;
    rdfs:comment "Glossary term relation of type partOf: the subject concept is a part or component of the object concept. om:hasPart is the inverse." ;
    schema:domainIncludes om:GlossaryTerm .

om:performanceMetrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "performanceMetrics" ;
    rdfs:comment "Runtime performance metrics for the AI application. Set on om:AIApplication. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:performanceStandards a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "performanceStandards" ;
    rdfs:comment "Performance standards for AI agents. Set on om:AiGovernancePolicy. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:permission a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "permission" ;
    rdfs:comment "Permission used by Native Applications. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open. One of: All." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:personaPreferences a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "personaPreferences" ;
    rdfs:comment "User's personal preferences for each persona. Users can customize certain UI elements per persona while inheriting base persona configuration. Set on om:User. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:User ;
    rdfs:range xsd:string .

om:personas a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "personas" ;
    rdfs:comment "Personas that the user assigned to. Set on om:User. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:User ;
    rdfs:range xsd:string .

om:pinned a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "pinned" ;
    rdfs:comment "Whether this memory is globally pinned in Context Center. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:boolean .

om:pipelineLocation a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "pipelineLocation" ;
    rdfs:comment "Pipeline Code Location. Set on om:Pipeline." ;
    rdfs:domain om:Pipeline ;
    rdfs:range xsd:string .

om:pipelineObservability a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "pipelineObservability" ;
    rdfs:comment "Pipeline observability information for the table. Multiple pipelines can process the same table. Set on om:Table. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:pipelineType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "pipelineType" ;
    rdfs:comment "Type of Pipeline - metadata, usage. Set on om:IngestionPipeline. One of: metadata, usage, lineage, profiler, autoClassification, TestSuite, dataInsight, elasticSearchReindex, dbt, application, policyAgent, reverseMetadata." ;
    rdfs:domain om:IngestionPipeline ;
    rdfs:range xsd:string .

om:pipelines a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "pipelines" ;
    rdfs:comment "The ingestion pipelines deployed for this service or application, as the JSON of their references rather than graph edges." ;
    schema:domainIncludes om:APIService, om:App, om:DashboardService, om:DatabaseService,
        om:DriveService, om:LLMService, om:MLModelService, om:McpService,
        om:MessagingService, om:MetadataService, om:PipelineService, om:SearchService,
        om:SecurityService, om:StorageService ;
    rdfs:range xsd:string .

om:policyType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "policyType" ;
    rdfs:comment "Kind of AI governance policy, such as ModelApproval, DataAccess, BiasThreshold, ComplianceCheck or CostControl." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:portfolioPriority a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "portfolioPriority" ;
    rdfs:comment "Portfolio-level priority of this data product. Set on om:DataProduct. One of: CRITICAL, HIGH, MEDIUM, LOW." ;
    rdfs:domain om:DataProduct ;
    rdfs:range xsd:string .

om:prefix a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "prefix" ;
    rdfs:comment "Optional prefix path defined for this container. Set on om:Container." ;
    rdfs:domain om:Container ;
    rdfs:range xsd:string .

om:prefixes a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "prefixes" ;
    rdfs:comment "Namespace prefixes declared for the ontology, as JSON text." ;
    rdfs:domain om:Ontology ;
    rdfs:range xsd:string .

om:primaryEntity a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "primaryEntity" ;
    rdfs:comment "Primary entity this memory should attach to for reuse. Set on om:ContextMemory. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:primaryModel a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "primaryModel" ;
    rdfs:comment "Primary/default LLM model used by this application. Set on om:AIApplication. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:privacyPolicyUrl a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "privacyPolicyUrl" ;
    rdfs:comment "Privacy Policy for the developer. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:privateConfiguration a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "privateConfiguration" ;
    rdfs:comment "Application Private configuration loaded at runtime. Set on om:App." ;
    rdfs:domain om:App ;
    rdfs:range xsd:string .

om:processedLineage a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "processedLineage" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Query: Flag if this query has already been successfully processed for lineage. On om:Table: Processed lineage for the table. On om:StoredProcedure: Processed lineage for the stored procedure." ;
    schema:domainIncludes om:Query, om:StoredProcedure, om:Table ;
    rdfs:range xsd:boolean .

om:processingEngine a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "processingEngine" ;
    rdfs:comment "The processing engine responsible for executing the ingestion pipeline logic. Set on om:IngestionPipeline. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:IngestionPipeline ;
    rdfs:range xsd:string .

om:processingError a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "processingError" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextFileContent: Processing failure details for this snapshot. On om:ContextFile: Reason the most recent processing attempt failed. Cleared when a new attempt starts. On om:Page: Error message from the most recent failed knowledge-pill extraction run, if any." ;
    schema:domainIncludes om:ContextFile, om:ContextFileContent, om:Page ;
    rdfs:range xsd:string .

om:processingStatus a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "processingStatus" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextFileContent: Processing status for this content snapshot. On om:ContextFile: Current processing state after upload. On om:Page: Status of the most recent knowledge-pill extraction run on this article's body." ;
    schema:domainIncludes om:ContextFile, om:ContextFileContent, om:Page ;
    rdfs:range xsd:string .

om:prompts a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "prompts" ;
    rdfs:comment "Prompt templates exposed by this MCP Server. Set on om:McpServer. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:propertyChain a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "propertyChain" ;
    rdfs:comment "Its meaning depends on the entity type. On om:RelationshipType: Ordered property chain whose composition implies this relationship type. On om:OntologyProperty: Ordered object-property IRIs whose composition implies this property. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    schema:domainIncludes om:OntologyProperty, om:RelationshipType ;
    rdfs:range xsd:string .

om:propertyIri a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "propertyIri" ;
    rdfs:comment "Semantic IRI of the property an ontology axiom states." ;
    rdfs:domain om:OntologyAxiom ;
    rdfs:range xsd:string .

om:propertyName a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "propertyName" ;
    rdfs:comment "Name of a custom property." ;
    rdfs:domain om:CustomProperty ;
    rdfs:range xsd:string .

om:propertyType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "propertyType" ;
    rdfs:comment "Name of the type of a custom property, such as string, integer or enum." ;
    rdfs:domain om:CustomProperty ;
    rdfs:range xsd:string .

om:propertyValue a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "propertyValue" ;
    rdfs:comment "Value of a custom property, as text." ;
    rdfs:domain om:CustomProperty ;
    rdfs:range xsd:string .

om:protocolVersion a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "protocolVersion" ;
    rdfs:comment "MCP protocol version supported by this server. Set on om:McpServer." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:providerModelId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "providerModelId" ;
    rdfs:comment "Provider's internal model ID. Set on om:LLMModel." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:qualityExpectations a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "qualityExpectations" ;
    rdfs:comment "Test cases the data contract expects to pass, as the JSON of their references rather than graph edges." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:qualityMetrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "qualityMetrics" ;
    rdfs:comment "Quality metrics for AI application responses. Set on om:AIApplication. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:queries a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "queries" ;
    rdfs:comment "List of queries that are used to create this table. Set on om:Table. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:queryDuration a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "queryDuration" ;
    rdfs:comment "How long did the query took to run in milliseconds. Set on om:Query." ;
    rdfs:domain om:Query .

om:queryExecutedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "queryExecutedAt" ;
    rdfs:comment "Date on which the query ran. Set on om:Query." ;
    rdfs:domain om:Query .

om:queryUsedIn a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "queryUsedIn" ;
    rdfs:comment "Entities that are using this query. Set on om:Query. Points at the referenced entity's node." ;
    rdfs:domain om:Query .

om:query_type a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "query_type" ;
    rdfs:comment "SQL query type. Set on om:Query." ;
    rdfs:domain om:Query ;
    rdfs:range xsd:string .

om:question a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "question" ;
    rdfs:comment "Canonical question or instruction represented by this memory. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:raiseOnError a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "raiseOnError" ;
    rdfs:comment "Control if we want to flag the workflow as failed if we encounter any processing errors. Set on om:IngestionPipeline." ;
    rdfs:domain om:IngestionPipeline ;
    rdfs:range xsd:boolean .

om:range a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "range" ;
    rdfs:comment "Semantic IRIs of the range classes or datatypes of an ontology property or relationship type, as JSON text." ;
    schema:domainIncludes om:OntologyProperty, om:RelationshipType ;
    rdfs:range xsd:string .

om:rdfPredicate a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "rdfPredicate" ;
    rdfs:comment "Predicate emitted for authored relationship edges. Set on om:RelationshipType." ;
    rdfs:domain om:RelationshipType ;
    rdfs:range xsd:string .

om:recognizers a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "recognizers" ;
    rdfs:comment "List of recognizers configured for automatic detection of this tag. Set on om:Tag. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Tag ;
    rdfs:range xsd:string .

om:reference a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "reference" ;
    rdfs:comment "External reference for the framework (e.g. 'Reg EU 2024/1689', 'AI 100-1', 'ISO/IEC 42001:2023'). Set on om:AiGovernanceFramework." ;
    rdfs:domain om:AiGovernanceFramework ;
    rdfs:range xsd:string .

om:references a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "references" ;
    rdfs:comment "From a foreign key column to the column it references, paired by position. A single-column foreign key joins directly on it; a composite key must join on every pair its om:hasConstraintMember nodes give." ;
    rdfs:domain om:Column ;
    rdfs:range om:Column .

om:region a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "region" ;
    rdfs:comment "Geographic jurisdiction this framework covers (e.g. 'European Union', 'United States', 'Global'). Set on om:AiGovernanceFramework." ;
    rdfs:domain om:AiGovernanceFramework ;
    rdfs:range xsd:string .

om:regulatoryCompliance a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "regulatoryCompliance" ;
    rdfs:comment "Regulatory compliance standards met. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:relatedEntities a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "relatedEntities" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextMemory: Additional related entities this memory applies to. On om:Page: Related Entities for the Knowledge Page. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    schema:domainIncludes om:ContextMemory, om:Page ;
    rdfs:range xsd:string .

om:relationshipType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "relationshipType" ;
    rdfs:comment "For a foreign key, the cardinality the constraint declares between the two tables: ONE_TO_ONE, ONE_TO_MANY, MANY_TO_ONE or MANY_TO_MANY. It tells whether a join on the key can multiply rows." ;
    rdfs:domain om:TableConstraint ;
    rdfs:range xsd:string .

om:remediationActions a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "remediationActions" ;
    rdfs:comment "Structured remediation actions with assignee, due date, priority, and status. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:replacedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "replacedBy" ;
    rdfs:comment "Its meaning depends on the entity type. On om:RelationshipType: Replacement relationship type when this type is deprecated. On om:OntologyProperty: IRI of the property in the same ontology that replaces this one. On om:OntologyConcept: IRI of the concept in the same ontology that replaces this one. Elsewhere the value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:OntologyConcept, om:OntologyProperty, om:RelationshipType .

om:requestSchema a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "requestSchema" ;
    rdfs:comment "Request Schema for the API Endpoint. Set on om:APIEndpoint. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:APIEndpoint ;
    rdfs:range xsd:string .

om:requestSignature a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "requestSignature" ;
    rdfs:comment "Deterministic hash of the request parameters (scope, target, framework, format, asOfDate, includeRedacted). Set on om:AuditReport." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:string .

om:requestedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "requestedAt" ;
    rdfs:comment "When the report was requested. Set on om:AuditReport." ;
    rdfs:domain om:AuditReport .

om:requestedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "requestedBy" ;
    rdfs:comment "User who requested the report. Set on om:AuditReport. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:string .

om:resourceType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "resourceType" ;
    rdfs:comment "Kind of learning asset represented. A Link opens its URL in a new browser tab; a PDF is displayed in the resource player. Set on om:LearningResource. One of: Storylane, Video, Article, Link, PDF." ;
    rdfs:domain om:LearningResource ;
    rdfs:range xsd:string .

om:resources a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "resources" ;
    rdfs:comment "Resources exposed by this MCP Server. Set on om:McpServer. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:retentionPeriod a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "retentionPeriod" ;
    rdfs:comment "How long data is retained in the table, schema, database or container, as an ISO 8601 duration such as P23DT23H." ;
    schema:domainIncludes om:Container, om:Database, om:DatabaseSchema, om:Table ;
    rdfs:range xsd:string .

om:retentionSize a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "retentionSize" ;
    rdfs:comment "Maximum size of a partition in bytes before old data is discarded. Set on om:Topic." ;
    rdfs:domain om:Topic .

om:reusedEntities a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "reusedEntities" ;
    rdfs:comment "Derived: glossary terms and metrics reused (not created) by the Memory Agent from this memory (RELATED_TO edges). Set on om:ContextMemory. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:reviewTask a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "reviewTask" ;
    rdfs:comment "Its meaning depends on the entity type. On om:OntologyRelease: Current approval task, assigned by the existing workflow infrastructure. On om:OntologyChangeSet: Review task created when a suggester submits the change set. The value is the referenced entity's JSON as a string, not a graph edge." ;
    schema:domainIncludes om:OntologyChangeSet, om:OntologyRelease ;
    rdfs:range xsd:string .

om:reviewAuthor a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "reviewAuthor" ;
    rdfs:comment "Author of the current governed content revision; assigned by the server. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:ontologyReview a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "ontologyReview" ;
    rdfs:comment "On a review task (om:Task) for an ontology release, the release under review: its entity id, content digest and author, as JSON text." ;
    rdfs:domain om:Task ;
    rdfs:range xsd:string .

om:approvalRule a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "approvalRule" ;
    rdfs:comment "How many reviewers must approve a release review. Frozen into each review task when a review is requested. Set on om:Ontology. One of: AnyReviewer, AllReviewers." ;
    rdfs:domain om:Ontology ;
    rdfs:range xsd:string .

om:reviewers a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "reviewers" ;
    rdfs:comment "A user or team that reviews this entity (its reviewers field), on entity types whose context does not map the field to om:hasReviewer." ;
    schema:domainIncludes om:AIApplication, om:LLMModel, om:LearningResource, om:McpServer,
        om:Metric, om:Ontology, om:OntologyRelease, om:Page,
        om:RelationshipType .

om:rootMemory a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "rootMemory" ;
    rdfs:comment "Root memory in an append-style memory thread. Set on om:ContextMemory. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:rules a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "rules" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Policy: Set of rules that the policy contains. On om:AiGovernancePolicy: Rules that make up this policy. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:AiGovernancePolicy, om:Policy ;
    rdfs:range xsd:string .

om:runningOn a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "runningOn" ;
    rdfs:comment "Identifier of the server node that claimed and is running this job. Set on om:AuditReport." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:string .

om:runtime a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "runtime" ;
    rdfs:comment "Its meaning depends on the entity type. On om:App: Execution Configuration. On om:AppMarketPlaceDefinition: If app type is live, user can provide additional runtime context." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:safetyMetrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "safetyMetrics" ;
    rdfs:comment "Safety metrics for AI application. Set on om:AIApplication. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:scheduleType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "scheduleType" ;
    rdfs:comment "How the application is scheduled: Live, Scheduled, ScheduledOrManual, NoSchedule or OnlyManual." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:schema a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "schema" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Type: JSON schema encoded as string that defines the type. This will be used to validate the type values. On om:DataContract: Schema definition for the data contract. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:DataContract, om:Type ;
    rdfs:range xsd:string .

om:scimUserName a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "scimUserName" ;
    rdfs:comment "Raw user name from SCIM. Set on om:User." ;
    rdfs:domain om:User ;
    rdfs:range xsd:string .

om:scope a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "scope" ;
    rdfs:comment "Breadth of the audit pack. Set on om:AuditReport. One of: Estate, Domain, Asset." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:string .

om:scopeTarget a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "scopeTarget" ;
    rdfs:comment "Reference to the domain or asset when scope is not Estate. Set on om:AuditReport. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:AuditReport ;
    rdfs:range xsd:string .

om:security a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "security" ;
    rdfs:comment "Security and access policy expectations defined in the data contract. Set on om:DataContract. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:securityMetrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "securityMetrics" ;
    rdfs:comment "Security metrics and settings for the MCP server. Set on om:McpServer. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:semantics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "semantics" ;
    rdfs:comment "Semantics rules defined in the data contract. Set on om:DataContract. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:serverInfo a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "serverInfo" ;
    rdfs:comment "Information about the MCP server software. Set on om:McpServer. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:serverType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "serverType" ;
    rdfs:comment "Type of MCP server based on its primary function. Set on om:McpServer. One of: DataAccess, FileSystem, WebAPI, Database, Cloud, Security, Development, Communication, Custom." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:serviceAttributes a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "serviceAttributes" ;
    rdfs:comment "Deployment attributes of this service: environment, region and deployment. Set on many entity types; the domain is left open. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:APIService, om:DashboardService, om:DatabaseService, om:DriveService,
        om:LLMService, om:MLModelService, om:McpService, om:MessagingService,
        om:MetadataService, om:PipelineService, om:SearchService, om:SecurityService,
        om:StorageService ;
    rdfs:range xsd:string .

om:shareConfig a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "shareConfig" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextMemory: Visibility and sharing configuration for the memory. On om:ContextFile: Who can see this file, beyond its owners. Absent means the file follows ordinary policy, which is how every file added before this field behaved; Private restricts it to its owners and the principals it names. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:ContextFile, om:ContextMemory ;
    rdfs:range xsd:string .

om:size a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "size" ;
    rdfs:comment "Content size in bytes. Set on om:ContextFileContent." ;
    rdfs:domain om:ContextFileContent .

om:sla a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sla" ;
    rdfs:comment "Its meaning depends on the entity type. On om:DataProduct: Service Level Agreement for this data product. On om:DataContract: Service Level Agreement expectations defined in the data contract. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:DataContract, om:DataProduct ;
    rdfs:range xsd:string .

om:sourceAssistantMessage a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceAssistantMessage" ;
    rdfs:comment "Assistant message identifier used to produce this memory. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:sourceCode a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceCode" ;
    rdfs:comment "Link to source code repository. Set on om:AIApplication and om:McpServer; the domain is left open." ;
    schema:domainIncludes om:AIApplication, om:McpServer ;
    rdfs:range xsd:string .

om:sourceConversation a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceConversation" ;
    rdfs:comment "Conversation identifier that produced this memory. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:sourceEntity a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceEntity" ;
    rdfs:comment "The Context Center entity (file or page) this memory was extracted from. Set on om:ContextMemory. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:sourceFile a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceFile" ;
    rdfs:comment "Deprecated: use sourceEntity. The Context Center file this memory was extracted from. Set on om:ContextMemory. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:sourceHash a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceHash" ;
    rdfs:comment "Hash of the entity's source metadata, computed by ingestion to detect changes between runs." ;
    schema:domainIncludes om:AIApplication, om:APICollection, om:APIEndpoint, om:AiFrameworkControl,
        om:AiGovernanceFramework, om:AiGovernancePolicy, om:Chart, om:Container,
        om:Dashboard, om:DashboardDataModel, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:LLMModel, om:MLModel,
        om:McpServer, om:Pipeline, om:PromptTemplate, om:SearchIndex,
        om:Spreadsheet, om:StoredProcedure, om:Table, om:Topic,
        om:Worksheet ;
    rdfs:range xsd:string .

om:sourceHumanMessage a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceHumanMessage" ;
    rdfs:comment "Human message identifier used to produce this memory. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:sourceId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceId" ;
    rdfs:comment "ID of the file in the external source system. Set on om:ContextFile." ;
    rdfs:domain om:ContextFile ;
    rdfs:range xsd:string .

om:sourcePack a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourcePack" ;
    rdfs:comment "Library pack selection this native change set installs. Applying it records the pack in the ontology's installedPacks. Set on om:OntologyChangeSet. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyChangeSet ;
    rdfs:range xsd:string .

om:sourcePythonClass a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourcePythonClass" ;
    rdfs:comment "Fully Qualified class name for the Python source that will execute the external application. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:sourceType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceType" ;
    rdfs:comment "Its meaning depends on the entity type. On om:ContextMemory: How the memory was created. ConversationExtraction is captured automatically at the end of a chat turn; it is ground truth, not regenerable like a file or page pill. On om:ContextFile: How this file was added." ;
    schema:domainIncludes om:ContextFile, om:ContextMemory ;
    rdfs:range xsd:string .

om:sourceVersion a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceVersion" ;
    rdfs:comment "Provider revision or version token for synced files. Set on om:ContextFileContent." ;
    rdfs:domain om:ContextFileContent ;
    rdfs:range xsd:string .

om:sql a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sql" ;
    rdfs:comment "In case the Data Model is based on a SQL query. Set on om:DashboardDataModel." ;
    rdfs:domain om:DashboardDataModel ;
    rdfs:range xsd:string .

om:startedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "startedAt" ;
    rdfs:comment "When job execution started. Set on om:AuditReport." ;
    rdfs:domain om:AuditReport .

om:state a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "state" ;
    rdfs:comment "Its meaning depends on the entity type. On om:OntologyChangeSet: DRAFT, SUBMITTED, APPLIED, APPLY_FAILED or DISCARDED. On om:Pipeline: Active or Inactive." ;
    schema:domainIncludes om:OntologyChangeSet, om:Pipeline ;
    rdfs:range xsd:string .

om:status a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "status" ;
    rdfs:comment "Its meaning depends on the entity type. On om:LearningResource: Lifecycle state for controllable publishing. On om:AuditReport: Current state of the audit pack job." ;
    schema:domainIncludes om:AuditReport, om:LearningResource ;
    rdfs:range xsd:string .

om:statusReason a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "statusReason" ;
    rdfs:comment "Why the memory reached its current status, e.g. the reconciliation verdict or the missing anchor. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:steps a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "steps" ;
    rdfs:comment "Steps to test the connection. Order matters. Set on om:TestConnectionDefinition. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:TestConnectionDefinition ;
    rdfs:range xsd:string .

om:stewards a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "stewards" ;
    rdfs:comment "Users or teams responsible for this framework's assessments. Set on om:AiGovernanceFramework. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:AiGovernanceFramework ;
    rdfs:range xsd:string .

om:storedProcedureType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "storedProcedureType" ;
    rdfs:comment "Type of the Stored Procedure. Set on om:StoredProcedure. One of: StoredProcedure, UDF, StoredPackage, Function." ;
    rdfs:domain om:StoredProcedure ;
    rdfs:range xsd:string .

om:style a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "style" ;
    rdfs:comment "UI Style is used to associate a color code and/or icon to entity to customize the look of that entity in UI. Set on many entity types; the domain is left open. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:DashboardService, om:DatabaseService, om:DriveService, om:MLModelService,
        om:MessagingService, om:PipelineService, om:SearchService, om:StorageService ;
    rdfs:range xsd:string .

om:subjectIri a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "subjectIri" ;
    rdfs:comment "Semantic IRI of the class, property or individual an ontology axiom is about." ;
    rdfs:domain om:OntologyAxiom ;
    rdfs:range xsd:string .

om:summary a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "summary" ;
    rdfs:comment "Optional summary of the memory. Set on om:ContextMemory." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:superClassOf a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "superClassOf" ;
    rdfs:comment "Glossary term relation of type superClassOf: every instance of the object term is also an instance of the subject term. The inverse of rdfs:subClassOf between glossary terms." ;
    schema:domainIncludes om:GlossaryTerm .

om:superProperties a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "superProperties" ;
    rdfs:comment "Semantic IRIs of the named properties this property specializes (rdfs:subPropertyOf). Set on om:OntologyProperty. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyProperty ;
    rdfs:range xsd:string .

om:supersededBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "supersededBy" ;
    rdfs:comment "The memory that replaced this one. Set if and only if entityStatus is Superseded or the legacy Deprecated stage. Set on om:ContextMemory. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:ContextMemory ;
    rdfs:range xsd:string .

om:supportEmail a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "supportEmail" ;
    rdfs:comment "Support Email for the application. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:string .

om:supportsIngestionRunner a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "supportsIngestionRunner" ;
    rdfs:comment "If the app support execution through the external runner. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:boolean .

om:supportsInterrupt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "supportsInterrupt" ;
    rdfs:comment "If the app run can be interrupted as part of the execution. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:boolean .

om:synonyms a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "synonyms" ;
    rdfs:comment "Synonyms of an ontology concept, as JSON text. Glossary term synonyms use skos:altLabel." ;
    rdfs:domain om:OntologyConcept ;
    rdfs:range xsd:string .

om:system a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "system" ;
    rdfs:comment "A system app cannot be uninstalled or modified. Set on om:App and om:AppMarketPlaceDefinition; the domain is left open." ;
    schema:domainIncludes om:App, om:AppMarketPlaceDefinition ;
    rdfs:range xsd:boolean .

om:systemDefined a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "systemDefined" ;
    rdfs:comment "System types can be updated but cannot be deleted. Set on om:RelationshipType." ;
    rdfs:domain om:RelationshipType ;
    rdfs:range xsd:boolean .

om:systemPrompt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "systemPrompt" ;
    rdfs:comment "System prompt to set the AI's behavior and context. Set on om:PromptTemplate." ;
    rdfs:domain om:PromptTemplate ;
    rdfs:range xsd:string .

om:tableProfilerConfig a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "tableProfilerConfig" ;
    rdfs:comment "Profiler settings of the table, as JSON text: sampling, partitioning, a custom profile query, and the columns included in or excluded from profiling. An excluded column carries no om:profile* facts." ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string .

om:tables a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "tables" ;
    rdfs:comment "References to tables in the schema. Set on om:DatabaseSchema. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:DatabaseSchema ;
    rdfs:range xsd:string .

om:tagFQN a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "tagFQN" ;
    rdfs:comment "Fully qualified name of a tag or glossary term, such as PII.Sensitive or Tier.Tier1. Match on it to find the assets that carry a tag." ;
    schema:domainIncludes om:Tag ;
    rdfs:range xsd:string .

om:tagSource a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "tagSource" ;
    rdfs:comment "Where a tag label comes from: Classification for a tag, Glossary for a glossary term." ;
    schema:domainIncludes om:Tag ;
    rdfs:range xsd:string .

om:tagState a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "tagState" ;
    rdfs:comment "Whether a tag label is Suggested or Confirmed. Like om:labelType it sits on the tag's shared node and mixes the labels of every entity carrying that tag." ;
    schema:domainIncludes om:Tag ;
    rdfs:range xsd:string .

om:targetIri a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "targetIri" ;
    rdfs:comment "Semantic IRI of the class, individual or value an ontology axiom relates its subject to." ;
    rdfs:domain om:OntologyAxiom ;
    rdfs:range xsd:string .

om:teamType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "teamType" ;
    rdfs:comment "Team type. Set on om:Team. One of: Group, Department, Division, BusinessUnit, Organization." ;
    rdfs:domain om:Team ;
    rdfs:range xsd:string .

om:templateBody a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "templateBody" ;
    rdfs:comment "Handlebars HTML template body with placeholders. Set on om:NotificationTemplate." ;
    rdfs:domain om:NotificationTemplate ;
    rdfs:range xsd:string .

om:templateContent a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "templateContent" ;
    rdfs:comment "The actual prompt template content with variables in {{variable}} format. Set on om:PromptTemplate." ;
    rdfs:domain om:PromptTemplate ;
    rdfs:range xsd:string .

om:templateSubject a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "templateSubject" ;
    rdfs:comment "Handlebars template for the email subject line with placeholders. Set on om:NotificationTemplate." ;
    rdfs:domain om:NotificationTemplate ;
    rdfs:range xsd:string .

om:templateType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "templateType" ;
    rdfs:comment "Type of prompt template. Set on om:PromptTemplate." ;
    rdfs:domain om:PromptTemplate ;
    rdfs:range xsd:string .

om:templateVersion a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "templateVersion" ;
    rdfs:comment "Template version for tracking changes. Set on om:PromptTemplate." ;
    rdfs:domain om:PromptTemplate ;
    rdfs:range xsd:string .

om:termCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "termCount" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Classification: Total number of children tag terms under this classification. On om:Glossary: Total number of terms in the glossary. This includes all the children in the hierarchy." ;
    schema:domainIncludes om:Classification, om:Glossary .

om:termsOfUse a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "termsOfUse" ;
    rdfs:comment "Terms of use for the data contract for both human and AI agents consumption. Set on om:DataContract. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:DataContract ;
    rdfs:range xsd:string .

om:testConnectionResult a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "testConnectionResult" ;
    rdfs:comment "Its meaning depends on the entity type. On om:McpService: Result of the last test connection performed on this service. On most other entity types: Last test connection results for this service. The value is the field's JSON, serialized as a string." ;
    schema:domainIncludes om:APIService, om:DashboardService, om:DatabaseService, om:DriveService,
        om:LLMService, om:MLModelService, om:McpService, om:MessagingService,
        om:MetadataService, om:PipelineService, om:SearchService, om:SecurityService,
        om:StorageService ;
    rdfs:range xsd:string .

om:testSuite a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "testSuite" ;
    rdfs:comment "The test suite of a table or data contract, as the reference's JSON text rather than a graph edge. A table's test cases are reachable with ^om:testsEntity." ;
    rdfs:range xsd:string ;
    schema:domainIncludes om:DataContract, om:Table .

om:testSuites a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "testSuites" ;
    rdfs:comment "Test suites that validate the AI application, as the JSON of their references rather than graph edges." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:timezone a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "timezone" ;
    rdfs:comment "Timezone of the user. Set on om:User." ;
    rdfs:domain om:User ;
    rdfs:range xsd:string .

om:toColumnFqn a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "toColumnFqn" ;
    rdfs:comment "Fully qualified name of the target column in a column-level lineage edge, written alongside the column IRI in om:toColumn for string matching." ;
    schema:domainIncludes om:ColumnLineage .

om:totalSize a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "totalSize" ;
    rdfs:comment "Total size of all files in bytes. Set on om:Directory." ;
    rdfs:domain om:Directory .

om:trainingMetadata a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "trainingMetadata" ;
    rdfs:comment "Training or fine-tuning metadata - critical for data lineage and impact analysis. Set on om:LLMModel. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:LLMModel ;
    rdfs:range xsd:string .

om:transformFunction a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "transformFunction" ;
    rdfs:comment "On a column mapping (om:ColumnLineage), the transformation that produces the target column from the source columns." ;
    rdfs:domain om:ColumnLineage ;
    rdfs:range xsd:string .

om:transportType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "transportType" ;
    rdfs:comment "Transport protocol used by the MCP server. Set on om:McpServer. One of: Stdio, SSE, StreamableHTTP." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:triggeredBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "triggeredBy" ;
    rdfs:comment "Entity that triggered the query. E.g., a Stored Procedure or a Pipeline Task. Set on om:Query. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:Query ;
    rdfs:range xsd:string .

om:uiCustomization a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "uiCustomization" ;
    rdfs:comment "Reference to the UI customization configuration. Set on om:Persona. The value is the referenced entity's JSON as a string, not a graph edge." ;
    rdfs:domain om:Persona ;
    rdfs:range xsd:string .

om:undoCursor a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "undoCursor" ;
    rdfs:comment "Number of active operations at the current undo/redo position. Set on om:OntologyChangeSet." ;
    rdfs:domain om:OntologyChangeSet .

om:upstreamApplications a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "upstreamApplications" ;
    rdfs:comment "Other AI applications this application depends on (multi-agent orchestration). Set on om:AIApplication. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:AIApplication ;
    rdfs:range xsd:string .

om:usageCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageCount" ;
    rdfs:comment "How many times a tag, glossary term, classification or glossary is used as a label, child terms included; for a context memory, how often AI-assisted retrieval used it." ;
    schema:domainIncludes om:Classification, om:ContextMemory, om:Glossary, om:GlossaryTerm,
        om:Tag .

om:usageDailyCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageDailyCount" ;
    rdfs:comment "Number of times the asset was used in the day of om:usageDate, from the usage summary: queries for tables, views for dashboards and charts." ;
    schema:domainIncludes om:Chart, om:Dashboard, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:MLModel, om:Pipeline,
        om:Report, om:Spreadsheet, om:Table, om:Worksheet .

om:usageDailyPercentile a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageDailyPercentile" ;
    rdfs:comment "Percentile rank (0 to 100) of the asset's daily usage among assets of its type. Divide by 100 for a 0 to 1 importance score." ;
    schema:domainIncludes om:Chart, om:Dashboard, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:MLModel, om:Pipeline,
        om:Report, om:Spreadsheet, om:Table, om:Worksheet .

om:usageDate a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageDate" ;
    rdfs:comment "Date of the usage summary that the om:usage* counts and percentiles describe." ;
    schema:domainIncludes om:Chart, om:Dashboard, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:MLModel, om:Pipeline,
        om:Report, om:Spreadsheet, om:Table, om:Worksheet ;
    rdfs:range xsd:date .

om:usageMetrics a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageMetrics" ;
    rdfs:comment "Usage metrics for the MCP server. Set on om:McpServer. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:usageMonthlyCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageMonthlyCount" ;
    rdfs:comment "Number of times the asset was used in the month ending on om:usageDate, from the usage summary." ;
    schema:domainIncludes om:Chart, om:Dashboard, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:MLModel, om:Pipeline,
        om:Report, om:Spreadsheet, om:Table, om:Worksheet .

om:usageMonthlyPercentile a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageMonthlyPercentile" ;
    rdfs:comment "Percentile rank (0 to 100) of the asset's monthly usage among assets of its type." ;
    schema:domainIncludes om:Chart, om:Dashboard, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:MLModel, om:Pipeline,
        om:Report, om:Spreadsheet, om:Table, om:Worksheet .

om:usageWeeklyCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageWeeklyCount" ;
    rdfs:comment "Number of times the asset was used in the week ending on om:usageDate, from the usage summary." ;
    schema:domainIncludes om:Chart, om:Dashboard, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:MLModel, om:Pipeline,
        om:Report, om:Spreadsheet, om:Table, om:Worksheet .

om:usageWeeklyPercentile a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usageWeeklyPercentile" ;
    rdfs:comment "Percentile rank (0 to 100) of the asset's weekly usage among assets of its type." ;
    schema:domainIncludes om:Chart, om:Dashboard, om:Database, om:DatabaseSchema,
        om:Directory, om:File, om:MLModel, om:Pipeline,
        om:Report, om:Spreadsheet, om:Table, om:Worksheet .

om:usedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usedBy" ;
    rdfs:comment "List of users who ran the query but does not exist in OpenMetadata. Set on om:Query. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Query ;
    rdfs:range xsd:string .

om:usedByAgents a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usedByAgents" ;
    rdfs:comment "Its meaning depends on the entity type. On om:LLMModel: AI Agents that use this model. On om:PromptTemplate: AI Agents using this template. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    schema:domainIncludes om:LLMModel, om:PromptTemplate ;
    rdfs:range xsd:string .

om:usedByApplications a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usedByApplications" ;
    rdfs:comment "AI Applications that use this MCP Server. Set on om:McpServer. The value is the JSON of the referenced entities as a string, not a graph edge." ;
    rdfs:domain om:McpServer ;
    rdfs:range xsd:string .

om:userCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "userCount" ;
    rdfs:comment "Its meaning depends on the entity type. On om:Persona: Distinct active users assigned this persona directly, through a team, or as their default persona. On om:Team: Total count of users that are part of the team." ;
    schema:domainIncludes om:Persona, om:Team .

om:usesMcpServer a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usesMcpServer" ;
    rdfs:comment "MCP servers this application connects to for tools, resources, and prompts. Set on om:AIApplication. Points at the referenced entity's node." ;
    rdfs:domain om:AIApplication .

om:usesTool a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "usesTool" ;
    rdfs:comment "MCP tools or other tools available to this application. Set on om:AIApplication. Points at the referenced entity's node." ;
    rdfs:domain om:AIApplication .

om:variables a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "variables" ;
    rdfs:comment "Variables used in this template. Set on om:PromptTemplate. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:PromptTemplate ;
    rdfs:range xsd:string .

om:violations a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "violations" ;
    rdfs:comment "Recent policy violations. Set on om:AiGovernancePolicy. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:AiGovernancePolicy ;
    rdfs:range xsd:string .

om:visibility a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "visibility" ;
    rdfs:comment "Visibility level of the data product in the marketplace. Set on om:DataProduct. One of: PRIVATE, INVITATION, ORGANISATION, DATASPACE, PUBLIC." ;
    rdfs:domain om:DataProduct ;
    rdfs:range xsd:string .

om:webViewLink a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "webViewLink" ;
    rdfs:comment "Web link to view the file. Set on om:File." ;
    rdfs:domain om:File ;
    rdfs:range xsd:string .

om:workflowType a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "workflowType" ;
    rdfs:comment "Type of the workflow. Set on om:Workflow. One of: TEST_CONNECTION, REVERSE_INGESTION, QUERY_RUNNER, TEST_SPARK_ENGINE_CONNECTION." ;
    rdfs:domain om:Workflow ;
    rdfs:range xsd:string .

om:worksheetId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "worksheetId" ;
    rdfs:comment "Native worksheet/tab ID. Set on om:Worksheet." ;
    rdfs:domain om:Worksheet ;
    rdfs:range xsd:string .

om:contentDigest a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "contentDigest" ;
    rdfs:comment "SHA-256 of the sealed manifest, including ordered member identities and payload digests. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:logicalCheck a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "logicalCheck" ;
    rdfs:comment "Logical consistency has not been checked. Structural and OWL 2 DL profile checks do not establish consistency. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:superClasses a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "superClasses" ;
    rdfs:comment "Direct named superclasses, derived from non-deleted ontology-owned SUBCLASS_OF axioms. Set on om:OntologyConcept. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyConcept ;
    rdfs:range xsd:string .

om:subClasses a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "subClasses" ;
    rdfs:comment "Direct named subclasses, derived from non-deleted ontology-owned SUBCLASS_OF axioms. Set on om:OntologyConcept. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyConcept ;
    rdfs:range xsd:string .

om:publicationStatus a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "publicationStatus" ;
    rdfs:comment "Publication state derived by the server from ontology releases. Set on om:Ontology. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:Ontology ;
    rdfs:range xsd:string .

om:changeSummary a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "changeSummary" ;
    rdfs:comment "Member change counts against baseReleaseId, assigned by the server at capture. Set on om:OntologyRelease. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:lifecycleStatus a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "lifecycleStatus" ;
    rdfs:comment "Release review state of this concept, derived by the server from ontology releases. Set on om:OntologyConcept. One of: Draft, InReview, Approved." ;
    rdfs:domain om:OntologyConcept ;
    rdfs:range xsd:string .

om:encodingVersion a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "encodingVersion" ;
    rdfs:comment "Canonical manifest and member encoding used to reproduce the digest. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:memberCount a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "memberCount" ;
    rdfs:comment "Number of definitions sealed into the ontology release." ;
    rdfs:domain om:OntologyRelease .

om:ontologyIri a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "ontologyIri" ;
    rdfs:comment "Semantic IRI of the ontology the release belongs to." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:approvalBasis a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "approvalBasis" ;
    rdfs:comment "Why this release was approved. REVIEWED means the ontology's reviewers decided it; NO_REVIEWERS_CONFIGURED means the ontology had no reviewers when an author published it directly. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:releaseRevision a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "releaseRevision" ;
    rdfs:comment "Monotonic release number allocated under the owning ontology state lock. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease .

om:semanticVersion a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "semanticVersion" ;
    rdfs:comment "Immutable semantic version allocated by the server. Absent on legacy releases; independent of entity version, release revision and version IRI. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:releaseNotes a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "releaseNotes" ;
    rdfs:comment "Immutable publication notes preserved exactly as captured, independently of the semantic content digest. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:baseReleaseId a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "baseReleaseId" ;
    rdfs:comment "Active release at capture, retained as the immutable review comparison baseline. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:baseWorkingRevision a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "baseWorkingRevision" ;
    rdfs:comment "Native working revision against which all operations were proposed. Set on om:OntologyChangeSet." ;
    rdfs:domain om:OntologyChangeSet .

om:sealedAt a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sealedAt" ;
    rdfs:comment "When the ontology release was sealed, in Unix epoch milliseconds." ;
    rdfs:domain om:OntologyRelease .

om:sealedBy a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sealedBy" ;
    rdfs:comment "User who sealed the ontology release." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:sourceWorkingRevision a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "sourceWorkingRevision" ;
    rdfs:comment "Working revision of the ontology that the release was captured from." ;
    rdfs:domain om:OntologyRelease .

om:totalBytes a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "totalBytes" ;
    rdfs:comment "Total UTF-8 size of canonical member payloads. Set on om:OntologyRelease." ;
    rdfs:domain om:OntologyRelease .

om:versionIri a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "versionIri" ;
    rdfs:comment "Semantic version IRI of the ontology release." ;
    rdfs:domain om:OntologyRelease ;
    rdfs:range xsd:string .

om:enumValues a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "enumValues" ;
    rdfs:comment "Allowed typed values for a DATA property, projected as an OWL data enumeration. Set on om:OntologyProperty. The value is the field's JSON, serialized as a string." ;
    rdfs:domain om:OntologyProperty ;
    rdfs:range xsd:string .

om:unit a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "unit" ;
    rdfs:comment "Unit IRI or display symbol for a DATA property, retained as an annotation without implying conversion. Set on om:OntologyProperty." ;
    rdfs:domain om:OntologyProperty ;
    rdfs:range xsd:string .

om:isIdentifier a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "isIdentifier" ;
    rdfs:comment "Identifier intent for a DATA property. This annotation does not assert functionality, an OWL key, or uniqueness in source data. Set on om:OntologyProperty." ;
    rdfs:domain om:OntologyProperty ;
    rdfs:range xsd:boolean .

om:abstract a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "abstract" ;
    rdfs:comment "An abstract class has no direct instances; data is classified by its subclasses. Set on om:OntologyConcept." ;
    rdfs:domain om:OntologyConcept ;
    rdfs:range xsd:boolean .

om:definitionSource a rdf:Property ;
    om:projectionStatus om:Stored ;
    rdfs:label "definitionSource" ;
    rdfs:comment "IRI of the document or standard this definition is taken from. Set on om:OntologyConcept." ;
    rdfs:domain om:OntologyConcept ;
    rdfs:range xsd:string .

om:unitAnnotation a owl:AnnotationProperty ;
    rdfs:label "unit annotation" ;
    rdfs:comment "Authored unit IRI or display symbol, without conversion semantics." .

om:identifierIntent a owl:AnnotationProperty ;
    rdfs:label "identifier intent" ;
    rdfs:comment "Authored identifier intent, without asserting functionality, an OWL key or source-data uniqueness." .

om:tableSharding a owl:DatatypeProperty ;
    om:projectionStatus om:Stored ;
    rdfs:domain om:Table ;
    rdfs:range xsd:string ;
    rdfs:label "tableSharding" ;
    rdfs:comment "Daily shard family metadata. Columns describe the representative. Set on om:Table. The value is the field's JSON, serialized as a string." .
