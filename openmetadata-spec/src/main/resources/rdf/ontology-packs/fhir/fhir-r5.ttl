        rdfs:subClassOf  fhir:Element ;
        rdfs:subClassOf  [ a                owl:Restriction ;
                           owl:cardinality  0 ;
                           owl:onProperty   fhir:modifierExtension
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  fhir:Extension ;
