                                     ] ;
        rdfs:subClassOf              [ a                   owl:Restriction ;
                                       owl:maxCardinality  1 ;
                                       owl:onProperty      fhir:expectedInResearchStudy
                                     ] ;
        rdfs:subClassOf              [ a                  owl:Restriction ;
                                       owl:allValuesFrom  fhir:Reference ;
