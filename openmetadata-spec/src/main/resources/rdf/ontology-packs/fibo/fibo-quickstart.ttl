	skos:definition "central banking system of the U.S., comprised of the Federal Reserve Board, the 12 Federal Reserve Banks, the Federal Open Market Committee, and the national and state member banks" ;
	cmns-av:abbreviation "FRS" ;
	cmns-av:explanatoryNote "The Federal Reserve, the central bank of the United States, provides the nation with a safe, flexible, and stable monetary and financial system." ;
	cmns-av:synonym
		"Fed" ,
		"Federal Reserve"
		;
	cmns-col:isPartOf fibo-be-ge-usj:UnitedStatesGovernment ;
	cmns-org:hasWebsite "https://www.federalreserve.gov/"^^xsd:anyURI ;
	cmns-rga:hasJurisdiction fibo-be-ge-usj:UnitedStatesJurisdiction ;
	.

