<https://spec.edmcouncil.org/fibo/ontology/QuickFIBOProd/>
	a owl:Ontology ;
	rdfs:label "About FIBO Production" ;
	dct:abstract "This ontology is provided for the convenience of FIBO users. It loads all of the very latest FIBO production ontologies based on the contents of GitHub, rather than those that comprise a specific version, such as a quarterly release. Note that metadata files and other 'load' files, such as the various domain-specific 'all' files, are intentionally excluded." ;
	dct:issued "2018-03-31T18:00:00"^^xsd:dateTime ;
	dct:license """Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2018-2025 Object Management Group, Inc.

