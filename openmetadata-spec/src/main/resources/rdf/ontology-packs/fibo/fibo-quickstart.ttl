lcc-639-2:Papiamento
	a owl:NamedIndividual ;
	.

lcc-639-2:Pedi
	a owl:NamedIndividual ;
	.

lcc-639-2:Tetum
	a owl:NamedIndividual ;
	.

lcc-639-2:TokPisin
	a owl:NamedIndividual ;
	.

lcc-639-2:Tokelau
	a owl:NamedIndividual ;
	.

lcc-639-2:Tuvalu
	a owl:NamedIndividual ;
