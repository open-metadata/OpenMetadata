fibo-fbc-fct-usjrga:StateGovernmentEntity
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-ge-ge:GovernmentBody ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-be-ge-ge:GovernmentAgency
				fibo-be-ge-ge:GovernmentDepartment
				fibo-be-ge-ge:Instrumentality
				fibo-be-ge-ge:RegionalSovereignty
			) ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:hasJurisdiction ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rga:hasReach ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:intersectionOf (
						cmns-loc:CountrySubdivision
						[
							a owl:Restriction ;
							owl:onProperty cmns-loc:isSubregionOf ;
							owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
						]
					) ;
				] ;
			] ;
		]
		;
	rdfs:label "state government entity or agency" ;
	skos:definition "formal organization that is an independent agency, instrumentality or other permanent or semi-permanent organization in the machinery of government of any one of the states or territories of the United States" ;
	.

