	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:ConventionalStreetAddress
		;
	rdfs:label "Ubisecure Oy headquarters address" ;
	skos:definition "headquarters address for Ubisecure Oy" ;
	fibo-fnd-plc-adr:hasAddressLine1 "Tekniikantie 14" ;
	fibo-fnd-plc-adr:hasPostalCode "02150" ;
	cmns-loc:hasCountry lcc-3166-1:Finland ;
	cmns-loc:hasMunicipality fibo-fbc-fct-bci:Espoo ;
	cmns-loc:hasSubdivision <https://www.omg.org/spec/LCC/Countries/Regions/ISO3166-2-SubdivisionCodes-FI/FI-18-Subdivision> ;
	.

fibo-fbc-fct-cra:UbisecureAsLocalOperatingUnit
	a
		owl:NamedIndividual ,
		fibo-fbc-fct-breg:LocalOperatingUnit
		;
	rdfs:label "Ubisecure Oy as local operating unit" ;
	skos:definition "Ubisecure Oy functional entity that is a legal entity identifier (LEI) local operating unit (LOU) registrar" ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:UBIsecureOy-FI ;
	.

fibo-fbc-fct-cra:WMDatenserviceEntityIdentifierRegistry
	a
		owl:NamedIndividual ,
		fibo-fbc-fct-breg:LegalEntityIdentifierRegistry
		;
	rdfs:label "WM Datenservice Registry" ;
	skos:definition "WM Datenservice LEI registry" ;
	.

fibo-fbc-fct-cra:WMGruppeHeadquartersAndLegalAddress
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:ConventionalStreetAddress
		;
	rdfs:label "Herausgebergemeinschaft Wertpapier-Mitteilungen Keppler, Lehmann (WM Gruppe) headquarters address" ;
	skos:definition "headquarters and legal address for Herausgebergemeinschaft Wertpapier-Mitteilungen Keppler, Lehmann (WM Gruppe)" ;
