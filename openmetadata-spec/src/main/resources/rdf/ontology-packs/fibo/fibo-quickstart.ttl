			a owl:Restriction ;
			owl:onProperty cmns-ra:isRegisteredIn ;
			owl:hasValue fibo-fbc-fct-usjrga:FDICInstitutionDirectory ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:isRegisteredBy ;
			owl:hasValue fibo-fbc-fct-usjrga:FederalDepositInsurerAndRegulator ;
		]
		;
