fibo-fnd-plc-rp:PersonalProperty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Asset ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isEvaluatedBy ;
			owl:onClass fibo-fnd-arr-asmt:Appraisal ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "personal property"@en ;
	owl:disjointWith fibo-fnd-plc-rp:RealProperty ;
	skos:definition "asset that is a movable item or possession not fixed to land"@en ;
	cmns-av:explanatoryNote "Personal property may include tangible assets, such as machinery, furniture, vehicles, artwork, and jewelry, regardless of whether such assets are owned by a person or organization, and intangible assets, including but not limited to intellectual property and financial instruments."@en ;
	.

fibo-fnd-plc-rp:PropertyInspection
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:AssessmentEvent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOutput ;
			owl:onClass fibo-fnd-plc-rp:PropertyInspectionReport ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:evaluates ;
			owl:someValuesFrom fibo-fnd-plc-rp:RealProperty ;
		]
		;
	rdfs:label "property inspection" ;
	skos:definition "event that involves analyzing one or more aspects of a real property" ;
	cmns-av:explanatoryNote "The concept of a property inspection is separate from conducting an overarching appraisal. Examples are termite inspections, construction inspections, evaluation for completion of some milestone, improvement, correction, etc." ;
	.

fibo-fnd-plc-rp:PropertyInspectionReport
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:AssessmentReport ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:isAbout ;
			owl:someValuesFrom fibo-fnd-plc-rp:RealProperty ;
		]
		;
	rdfs:label "property inspection report" ;
	skos:definition "report covering the findings of a property inspection" ;
	.

fibo-fnd-plc-rp:RealEstate
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:Asset ;
	rdfs:label "real estate"@en ;
	owl:disjointWith fibo-fnd-pas-pas:Good ;
	skos:definition "real property, interests in mortgages on real property (including interests in mortgages on leaseholds of land or improvements thereon), and shares in qualified real estate investment trusts"@en ;
	cmns-av:adaptedFrom "https://www.law.cornell.edu/cfr/text/26/1.856-3"^^xsd:anyURI ;
	cmns-av:explanatoryNote "The term 'mortgages on real property' includes deeds of trust on real property. Note that interpretation of the term 'real estate' is context-dependent - this broader interpretation is used in tax law in the US and elsewhere."@en ;
	cmns-av:synonym "real estate asset"@en ;
	.

fibo-fnd-plc-rp:RealProperty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:PhysicalAsset ,
		fibo-fnd-plc-rp:RealEstate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isEvaluatedBy ;
			owl:onClass fibo-fnd-plc-rp:RealPropertyAppraisal ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "real property"@en ;
	rdfs:seeAlso <https://www.investopedia.com/terms/r/real-property.asp> ;
	skos:definition "physical asset defined as land together with any structures that are permanently attached to that land, such as houses, trees, fences and improvements"@en ;
	cmns-av:adaptedFrom "https://www.law.cornell.edu/cfr/text/10/600.101"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"Real property may be classified according to its general use as residential, commercial, agricultural, industrial, or special purpose. This term is sometimes used synonymously with 'real estate', though not in all circumstances under US law."@en ,
		"Real property typically encompasses both the physical land and everything that lies above, below, or on its surface, including any fixed structures, natural resources, and rights or interests (e.g., mineral rights). There are cases, such as condominiums, in which the interior of the structure is owned by a party that may not own the land. There are also cases in which certain long-term leases have similar characteristics to ownership, but are time-bound."@en
		;
	cmns-av:synonym "parcel"@en ;
	.

fibo-fnd-plc-rp:RealPropertyAppraisal
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:Appraisal ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasInput ;
			owl:onClass fibo-fnd-plc-rp:PropertyInspectionReport ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:evaluates ;
			owl:someValuesFrom fibo-fnd-plc-rp:RealProperty ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fnd-arr-asmt:Appraiser ;
		]
		;
	rdfs:label "real property appraisal" ;
	skos:definition "value assessment that estimates the amount of money some real property is worth" ;
	cmns-av:explanatoryNote "The valuation uses one or more methodologies and is conducted by an appraiser or technology with a logical model that performs the same function." ;
	.

fibo-fnd-plc-rp:RealPropertyIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtid:ContextualIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:onClass cmns-rga:Jurisdiction ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-plc-rp:RealProperty ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "real property identifier" ;
	skos:definition "unique identifier given to identify a specific real property in some jurisidiction" ;
	.

fibo-fnd-plc-rp:TractIdentifier
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass cmns-sfc:TractIdentifier ;
	.

fibo-fnd-plc-rp:TractOfLand
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass cmns-sfc:TractOfLand ;
	.

fibo-fnd-plc-vrt:ElectronicMailAddress
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:VirtualAddress ;
	rdfs:label "electronic mail address" ;
	skos:definition "virtual address that defines an electronic messaging endpoint to which email messages can be delivered, typically via an Simple Mail Transfer Protocol (SMTP) based communications system" ;
	cmns-av:abbreviation
		"e-mail address" ,
		"email address"
		;
	cmns-av:explanatoryNote "Electronic mail, abbreviated e-mail or email, is a method of composing, sending, and receiving messages over electronic communication systems. The term e-mail applies both to the Internet e-mail system based on the Simple Mail Transfer Protocol (SMTP) and to intranet systems allowing users within one company or organization to send messages to each other. Often these workgroup collaboration systems natively use non-standard protocols but have some form of gateway to allow them to send and receive Internet e-mail. Some organizations may use the Internet protocols for internal e-mail service." ;
	.

fibo-fnd-plc-vrt:NetworkLocation
	a owl:Class ;
	rdfs:subClassOf
		cmns-loc:VirtualLocation ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fnd-plc-adr:Address ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "network location" ;
	skos:definition "a virtual location that may be identified by a network address (an identifier for a node or interface)" ;
	.

fibo-fnd-plc-vrt:NotionalPlace
	a owl:Class ;
	rdfs:subClassOf cmns-loc:Location ;
	rdfs:label "notional place" ;
	skos:definition "an abstract place; one of many commonly understood concepts such as domestic, Eurozone etc." ;
	.

fibo-fnd-plc-vrt:TelephoneNumber
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:VirtualAddress ;
	rdfs:label "telephone number" ;
	skos:definition "virtual address that may be assigned to a fixed-line telephone subscriber station connected to a telephone line or to a wireless electronic telephony device, such as a radio telephone or a mobile telephone, or to other devices or services for data transmission via the public switched telephone network (PSTN) or other public and private networks" ;
	cmns-av:abbreviation "phone number" ;
	cmns-av:explanatoryNote "Telephone numbers are assigned within the framework of a national or regional telephone numbering plan to subscribers by telephone service operators, which may be commercial entities, state-controlled administrations, or other telecommunication industry associations." ;
	.

fibo-fnd-plc-vrt:hasElectronicMailAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-plc-adr:hasAddress ;
	rdfs:label "has electronic mail address" ;
	rdfs:range fibo-fnd-plc-vrt:ElectronicMailAddress ;
	skos:definition "specifies an electronic messaging endpoint at which some entity may be located or contacted or may receive correspondence" ;
	cmns-av:abbreviation
		"has e-mail address" ,
		"has email address"
		;
	.

fibo-fnd-plc-vrt:hasTelephoneNumber
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-plc-adr:hasAddress ;
	rdfs:label "has telephone number" ;
	rdfs:range fibo-fnd-plc-vrt:TelephoneNumber ;
	skos:definition "indicates a virtual address composed of a sequence of digits and symbols that may be assigned to a fixed-line telephone subscriber station, a wireless electronic telephony device, such as a radio telephone or a mobile telephone, or other similar device or service" ;
	.

fibo-fnd-pas-psch:Payee
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Obligee ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fnd-pas-psch:PaymentObligation ;
			] ;
		]
		;
	rdfs:label "payee" ;
	skos:definition "a party to whom a debt should be paid, or to whose order a bill of exchange, note, or check is made payable, or who receives or will receive a payment from a payer in partial or complete fulfillment of an obligation" ;
	.

fibo-fnd-pas-psch:Payer
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Obligor ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-agr:hasObligation ;
			owl:allValuesFrom fibo-fnd-pas-psch:PaymentObligation ;
		]
		;
	rdfs:label "payer" ;
	skos:definition "a party who pays a bill or fees, or who makes payments to a payee in partial or complete fulfillment of an obligation" ;
	.

fibo-fnd-pas-psch:Payment
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-psch:hasPaymentAmount ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryAmount ;
		]
		;
	rdfs:label "payment" ;
	skos:definition "delivery of money in fulfillment of an obligation, such as to satisfy a claim or debt" ;
	.

fibo-fnd-pas-psch:PaymentEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:TransactionEvent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:involves ;
			owl:onClass fibo-fnd-pas-psch:Payment ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:onClass fibo-fnd-pas-psch:PaymentObligation ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "payment event" ;
	skos:definition "an event that involves delivery of money in fulfillment of an obligation" ;
	.

fibo-fnd-pas-psch:PaymentObligation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Commitment ,
		fibo-fnd-law-lcap:Duty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:allValuesFrom fibo-fnd-agr-ctr:Contract ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-agr:isObligationOf ;
			owl:someValuesFrom fibo-fnd-pas-psch:Payer ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-fnd-pas-psch:Payee ;
		]
		;
	rdfs:label "payment obligation" ;
	skos:definition "legally enforceable duty to pay a sum of money according to the terms stated in a contract" ;
	skos:example "the duty of a borrower to repay a loan, related to the legal right of a lender to enforce payment" ;
	.

fibo-fnd-pas-psch:PaymentSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:Schedule ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-pas-psch:Payment ;
		]
		;
	rdfs:label "payment schedule" ;
	skos:definition "schedule for delivery of money in fulfillment of an obligation" ;
	skos:example "Examples include coupon payment, loan payment, and interest payment schedules, among others." ;
	.

fibo-fnd-pas-psch:fulfillsObligation
	a owl:ObjectProperty ;
	rdfs:label "fulfills obligation" ;
	rdfs:domain fibo-fnd-pas-psch:Payment ;
	rdfs:range fibo-fnd-pas-psch:PaymentObligation ;
	skos:definition "satisfies a requirement for payment of some claim, debt, or other obligation" ;
	.

fibo-fnd-pas-psch:hasPaymentAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has payment amount" ;
	rdfs:domain fibo-fnd-pas-psch:Payment ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "specifies the amount of money involved in a payment" ;
	.

fibo-fnd-pas-psch:hasPaymentSchedule
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasSchedule ;
	rdfs:label "has payment schedule" ;
	rdfs:range fibo-fnd-pas-psch:PaymentSchedule ;
	skos:definition "specifies the schedule for fulfillment of an obligation" ;
	.

fibo-fnd-pas-pas:Buyer
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:buys ;
			owl:someValuesFrom fibo-fnd-pas-pas:Product ;
		]
		;
	rdfs:label "buyer" ;
	skos:definition "party that purchases something in exchange for money or other consideration under a contract of sale" ;
	cmns-av:explanatoryNote "A buyer is the party that acquires, or agrees to acquire, ownership (in case of goods), or benefit or usage (in case of rights or services), something in the context of a sale, and may or may not be an end user of the product, good, service, or right." ;
	cmns-av:synonym
		"buyer" ,
		"purchaser"
		;
	.

fibo-fnd-pas-pas:Client
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fnd-pas-pas:ServiceAgreement ;
			] ;
		]
		;
	rdfs:label "client" ;
	skos:definition "party that purchases professional services from, or has a formal relationship to purchase services from another party" ;
	.

fibo-fnd-pas-pas:ClientIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pty-pty:PartyRoleIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-pas-pas:Client ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "client identifier" ;
	skos:definition "sequence of characters uniquely identifying a client within the context of some organization" ;
	.

fibo-fnd-pas-pas:Commodity
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:Good ;
	rdfs:label "commodity" ;
	skos:definition "material resource used in commerce that is interchangeable with other commodities of the same type" ;
	cmns-av:explanatoryNote "Commodities are most often used as inputs in the production of other goods or services. The quality of a given commodity may differ slightly, but it is essentially uniform across producers." ;
	.

fibo-fnd-pas-pas:Consumer
	a owl:Class ;
	rdfs:subClassOf cmns-pts:PartyRole ;
	rdfs:label "consumer" ;
	rdfs:seeAlso <http://www.oecd.org/sti/consumer/> ;
	skos:definition "party that utilizes economic goods or services, typically for personal, family, or household purposes" ;
	cmns-av:explanatoryNote "The general notion of a consumer includes an end user, and is not limited to a purchaser, in the distribution chain of a good or service" ;
	.

fibo-fnd-pas-pas:ContractualProduct
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:Product ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isExemplifiedBy ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		]
		;
	rdfs:label "contractual product" ;
	skos:definition "product that takes the form of an agreement" ;
	cmns-av:explanatoryNote "This represents the case where the product itself is a contract, such as a life insurance policy or financial instrument, rather than a product or service whose terms of use, license to use, or terms of service are specified in a product." ;
	.

fibo-fnd-pas-pas:ContractualTemplateProduct
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:ContractualProduct ,
		fibo-fnd-pas-pas:OffTheShelfProduct
		;
	rdfs:label "contractual template product" ;
	skos:definition "contractual product that is finalized through specification of values for parameters defined in a template" ;
	.

fibo-fnd-pas-pas:CustomProduct
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:Product ;
	rdfs:label "custom product" ;
	owl:disjointWith fibo-fnd-pas-pas:OffTheShelfProduct ;
	skos:definition "product that is made to order, commissioned based on a customer's specifications" ;
	cmns-av:synonym
		"bespoke product" ,
		"custom-made product" ,
		"made to order product"
		;
	.

fibo-fnd-pas-pas:Customer
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:Buyer ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:buysFrom ;
			owl:someValuesFrom fibo-fnd-pas-pas:Supplier ;
		]
		;
	rdfs:label "customer" ;
	skos:definition "party that receives or consumes products (goods or services) and has the ability to choose between different products and suppliers" ;
	.

fibo-fnd-pas-pas:CustomerIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pty-pty:PartyRoleIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-pas-pas:Customer ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "customer identifier" ;
	skos:definition "sequence of characters uniquely identifying a customer within the context of some organization" ;
	.

fibo-fnd-pas-pas:Good
	a owl:Class ;
	rdfs:label "good" ;
	skos:definition "physical, produced item over which ownership rights can be established, whose ownership can be passed from one party to another by engaging in transactions, and that is not money or real estate" ;
	cmns-av:adaptedFrom
		"https://data.oecd.org/trade/trade-in-goods.htm"^^xsd:anyURI ,
		"https://www.law.cornell.edu/ucc/9/9-102#goods"^^xsd:anyURI
		;
	cmns-av:explanatoryNote
		"An inherently useful and relatively scarce tangible item produced from agricultural, construction, manufacturing, or mining activities. Off-the-shelf products, including off-the-shelf software products and customization of software products, are generally considered to be goods. Energy, such as electricity, is also considered to be a good from a legal perspective, and meets the criteria of being manufactured or produced via some process, including but not limited to a mining process. According to the UN Convention On Contract For The International Sale Of Goods, the term 'good' does not include (1) items bought for personal use, (2) items bought at an auction or foreclosure sale, (3) aircraft or ocean-going vessels." ,
		"From the Universal Commercial Code (UCC) in the United States, the term 'good' includes (i) fixtures, (ii) standing timber that is to be cut and removed under a conveyance or contract for sale, (iii) the unborn young of animals, (iv) crops grown, growing, or to be grown, even if the crops are produced on trees, vines, or bushes, and (v) manufactured homes. The term also includes a computer program embedded in goods and any supporting information provided in connection with a transaction relating to the program if (i) the program is associated with the goods in such a manner that it customarily is considered part of the goods, or (ii) by becoming the owner of the goods, a person acquires a right to use the program in connection with the goods. The term does not include a computer program embedded in goods that consist solely of the medium in which the program is embedded. The term also does not include accounts, chattel paper, commercial tort claims, deposit accounts, documents, general intangibles, instruments, investment property, letter-of-credit rights, letters of credit, money, or oil, gas, or other minerals before extraction."
		;
	.

fibo-fnd-pas-pas:NegotiableCommodity
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:Commodity ;
	rdfs:label "negotiable commodity" ;
	skos:definition "commodity that can be bought or sold in some marketplace" ;
	.

fibo-fnd-pas-pas:OffTheShelfProduct
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:Product ;
	rdfs:label "off-the-shelf product" ;
	skos:definition "product that is readily available from merchandise in stock, or can be quickly and easily configured to order, not specially designed or custom-made" ;
	cmns-av:abbreviation "COTS product" ;
	cmns-av:synonym
		"commercial off-the-shelf product" ,
		"commercially available off-the-shelf product"
		;
	.

fibo-fnd-pas-pas:Producer
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:produces ;
			owl:someValuesFrom fibo-fnd-pas-pas:Good ;
		]
		;
	rdfs:label "producer" ;
	skos:definition "grower, maker, fabricator, or manufacturer of some product or other good" ;
	.

fibo-fnd-pas-pas:Product
	a owl:Class ;
	rdfs:subClassOf
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-law-lcap:ContractualRight
				fibo-fnd-pas-pas:Good
				cmns-org:Service
			) ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:onClass fibo-fbc-pas-fpas:Catalog ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasLifecycle ;
			owl:onClass fibo-fbc-pas-fpas:ProductLifecycle ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "product" ;
	skos:definition "commercially distributed good that is (1) tangible property, (2) the output or result of a fabrication, manufacturing, or production process, or (3) something that passes through a distribution channel before being consumed or used." ;
	cmns-av:explanatoryNote "Financial products include contracts that are developed via a financial service-specific process, such as a life insurance policy, demand deposit account or financial instrument, for example. Leases and rentals are similar in that they are initiated via some contractual development process, wherein the product is the right to use something for some period of time." ;
	.

fibo-fnd-pas-pas:ProductIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-pas-pas:Product ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "product identifier" ;
	skos:definition "sequence of characters uniquely identifying a product in some context" ;
	.

fibo-fnd-pas-pas:Sale
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:TransactionEvent ,
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasPrice ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryAmount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:hasBuyer ;
			owl:someValuesFrom fibo-fnd-pas-pas:Buyer ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:hasSeller ;
			owl:someValuesFrom fibo-fnd-pas-pas:Seller ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-pas-pas:Product ;
		]
		;
	rdfs:label "sale" ;
	skos:definition "exchange of goods or services for money" ;
	.

fibo-fnd-pas-pas:Seller
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:sells ;
			owl:someValuesFrom fibo-fnd-pas-pas:Product ;
		]
		;
	rdfs:label "seller" ;
	skos:definition "party that makes, offers or contracts to make a sale to an actual or potential buyer" ;
	cmns-av:synonym
		"purveyor" ,
		"vendor"
		;
	.

fibo-fnd-pas-pas:ServiceAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:WrittenContract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:onClass cmns-org:ServiceProvider ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:governs ;
			owl:someValuesFrom cmns-org:Service ;
		]
		;
	rdfs:label "service agreement" ;
	skos:definition "written contract between a client and service provider whereby the service provider supplies some service in the form of time, effort, and/or expertise in exchange for compensation" ;
	cmns-av:synonym "service contract" ;
	.

fibo-fnd-pas-pas:Supplier
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:supplies ;
			owl:someValuesFrom fibo-fnd-pas-pas:Product ;
		]
		;
	rdfs:label "supplier" ;
	skos:definition "party that provides goods or services that some party wants or needs, especially over a long period of time" ;
	cmns-av:explanatoryNote "A supplier may be distinguished from a contractor or subcontractor, who commonly adds specialized input to deliverables." ;
	.

fibo-fnd-pas-pas:TransactionConfirmation
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:LegalDocument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:onClass fibo-fnd-pas-pas:TransactionEvent ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "transaction confirmation" ;
	skos:definition "written communication from a seller or service provider reciting the relevant details of a transaction" ;
	.

fibo-fnd-pas-pas:TransactionEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:OccurrenceKind ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidencedBy ;
			owl:onClass fibo-fnd-pas-pas:TransactionConfirmation ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "transaction event" ;
	skos:definition "any sale, assignment, lease, license, loan, advance, contribution, or other transfer of any interest in or right to use any property (tangible or intangible) or money, however that transaction is effected, and regardless of whether the terms of the transaction are formally documented" ;
	.

fibo-fnd-pas-pas:buys
	a owl:ObjectProperty ;
	rdfs:label "buys" ;
	rdfs:domain fibo-fnd-pas-pas:Buyer ;
	rdfs:range fibo-fnd-pas-pas:Product ;
	skos:definition "links a party in the role of purchaser to something that they have purchased or plan to purchase" ;
	.

fibo-fnd-pas-pas:buysFrom
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "buys from" ;
	rdfs:domain fibo-fnd-pas-pas:Buyer ;
	rdfs:range fibo-fnd-pas-pas:Seller ;
	skos:definition "links a party in the role of purchaser to a party from which they have made or are planning to make a purchase" ;
	.

fibo-fnd-pas-pas:hasBuyer
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-pts:hasPartyRole ,
		cmns-pts:hasUndergoer
		;
	rdfs:label "has buyer"@en ;
	rdfs:range fibo-fnd-pas-pas:Buyer ;
	skos:definition "indicates the purchasing party in the context of a sales transaction" ;
	.

fibo-fnd-pas-pas:hasSeller
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasActor ;
	rdfs:label "has seller"@en ;
	rdfs:range fibo-fnd-pas-pas:Seller ;
	skos:definition "indicates the vendor in the context of a sales transaction" ;
	.

fibo-fnd-pas-pas:isProvisionedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:isProvidedBy ;
	rdfs:label "is provisioned by" ;
	rdfs:range cmns-org:ServiceProvider ;
	owl:inverseOf fibo-fnd-pas-pas:provisions ;
	skos:definition "identifies the service provider that provisions the service or facility" ;
	.

fibo-fnd-pas-pas:isSuppliedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:isProvidedBy ;
	rdfs:label "is supplied by" ;
	rdfs:domain fibo-fnd-pas-pas:Product ;
	rdfs:range fibo-fnd-pas-pas:Supplier ;
	owl:inverseOf fibo-fnd-pas-pas:supplies ;
	skos:definition "identifies the party (supplier, vendor, distributor, etc.) that makes a product available" ;
	.

fibo-fnd-pas-pas:provisions
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:provides ;
	rdfs:label "provisions" ;
	rdfs:domain cmns-org:ServiceProvider ;
	skos:definition "customizes, provides, or outfits something required for use in delivering a service" ;
	.

fibo-fnd-pas-pas:sells
	a owl:ObjectProperty ;
	rdfs:label "sells" ;
	rdfs:domain fibo-fnd-pas-pas:Seller ;
	rdfs:range fibo-fnd-pas-pas:Product ;
	skos:definition "links a party in the role of broker, dealer, vendor, or merchandiser to something that they make available for sale" ;
	.

fibo-fnd-pas-pas:sellsTo
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsOn ;
	rdfs:label "sells to" ;
	rdfs:domain fibo-fnd-pas-pas:Seller ;
	rdfs:range fibo-fnd-pas-pas:Buyer ;
	owl:inverseOf fibo-fnd-pas-pas:buysFrom ;
	skos:definition "links a party in the role of broker, dealer, vendor, or merchandiser to a purchaser or potential purchasing party" ;
	.

fibo-fnd-pas-pas:supplies
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:provides ;
	rdfs:label "supplies" ;
	rdfs:domain fibo-fnd-pas-pas:Supplier ;
	rdfs:range fibo-fnd-pas-pas:Product ;
	skos:definition "links a party in the role of outfitter, provisioner, distributor, etc. to something that they provide" ;
	.

fibo-fnd-rel-rel:Referent
	a owl:Class ;
	rdfs:label "referent" ;
	skos:definition "something that another concept stands for, exemplifies, symbolizes, or otherwise mentions" ;
	.

fibo-fnd-rel-rel:causes
	a owl:ObjectProperty ;
	rdfs:label "causes" ;
	skos:definition "relationship between an event or set of events or factors (the cause) and a second event, phenomenon, situation, or result (the effect), where the second event or outcome is understood as a consequence of the first" ;
	.

fibo-fnd-rel-rel:confers
	a owl:ObjectProperty ;
	rdfs:label "confers" ;
	skos:definition "grants or bestows by virtue of some authority" ;
	cmns-av:explanatoryNote "This property should be read as describing the conferral of some legal power or duty, some commitment or some social construct, and is a property of some social construct such as an agreement or some legal authority. These concepts, which would describe the kind of thing of which this is a property, and the kinds of thing in terms of which this property is framed, are outside the scope of this mode land so are not shown." ;
	cmns-av:synonym "invests with" ;
	.

fibo-fnd-rel-rel:controls
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:playsActiveRoleThatDirectlyAffects ;
	rdfs:label "controls" ;
	rdfs:domain cmns-pts:Party ;
	skos:definition "exercises authority or influence over" ;
	.

fibo-fnd-rel-rel:embodies
	a owl:ObjectProperty ;
	rdfs:label "embodies" ;
	skos:definition "is an expression of, gives a tangible or visible form to (an idea, quality, or feeling), makes concrete and perceptible" ;
	.

fibo-fnd-rel-rel:evaluates
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cxtdsg:appliesTo ;
	rdfs:label "evaluates" ;
	skos:definition "assesses the nature, quality, or ability of someone or something" ;
	.

fibo-fnd-rel-rel:exchanges
	a owl:ObjectProperty ;
	rdfs:label "exchanges" ;
	skos:definition "gives something in return something else" ;
	.

fibo-fnd-rel-rel:exemplifies
	a owl:ObjectProperty ;
	rdfs:label "exemplifies" ;
	skos:definition "is a concrete realization or example of" ;
	cmns-av:adaptedFrom "http://www.merriam-webster.com/dictionary/exemplify"^^xsd:anyURI ;
	.

fibo-fnd-rel-rel:generates
	a owl:ObjectProperty ;
	rdfs:label "generates" ;
	skos:definition "produces through the application of one or more mathematical or logical steps or rules" ;
	.

fibo-fnd-rel-rel:hasAlias
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dsg:hasTextualName ;
	rdfs:label "has alias" ;
	skos:definition "indicates an alternate name of by which something is known" ;
	.

fibo-fnd-rel-rel:hasCommonName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dsg:hasTextualName ;
	rdfs:label "has common name" ;
	skos:definition "indicates a name by which something is frequently referred, without reference to any formal usage or structure" ;
	.

fibo-fnd-rel-rel:hasDesignation
	a owl:ObjectProperty ;
	rdfs:label "has designation" ;
	skos:definition "relates an individual or organization to a position, role, or other designation" ;
	.

fibo-fnd-rel-rel:hasFormalName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dsg:hasTextualName ;
	rdfs:label "has formal name" ;
	skos:definition "indicates a name by which something is known for some official purpose or context, or which is structured in some way such as to always follow the same format regardless of usage" ;
	.

fibo-fnd-rel-rel:hasLegalName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:hasFormalName ;
	rdfs:label "has legal name" ;
	skos:definition "specifies the name used to refer to a party in legal communications" ;
	.

fibo-fnd-rel-rel:hasTag
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has tag" ;
	rdfs:range xsd:string ;
	skos:definition "combination of alphanumeric characters corresponding to a label for something" ;
	skos:note "Text-valued tags may be useful for automated transformation or encoding systems, such as those used to produce IETF compliant language tags in XML. Such tags are required to be string-valued in FIBO, but not language-tagged strings." ;
	.

fibo-fnd-rel-rel:holds
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:directlyAffects ;
	rdfs:label "holds" ;
	skos:definition "is the relationship between a party and something it possesses, or over which it exercises some ownership or control or has at its discretion the ability to dispose of it as it sees fit" ;
	.

fibo-fnd-rel-rel:involves
	a owl:ObjectProperty ;
	rdfs:label "involves" ;
	skos:definition "(of a situation or event) includes (something) as a necessary part or result" ;
	.

fibo-fnd-rel-rel:isCausedBy
	a owl:ObjectProperty ;
	rdfs:label "is caused by" ;
	owl:inverseOf fibo-fnd-rel-rel:causes ;
	skos:definition "is the relationship between an event (the effect) and a second event (the cause), where the first event is understood as a consequence of the second; also, the relationship between a set of factors (causes) and a phenomenon (the effect)" ;
	.

fibo-fnd-rel-rel:isConferredBy
	a owl:ObjectProperty ;
	rdfs:label "is conferred by" ;
	owl:inverseOf fibo-fnd-rel-rel:confers ;
	skos:definition "a relationship between a right or obligation and the vehicle, such as an agreement or contract, that vests (or confers) said right or obligation" ;
	cmns-av:explanatoryNote "This property should be read as describing some legal power or duty, some commitment or some social construct being conferred as a result of some social construct such as an agreement or some legal authority. These concepts, which would describe the kind of thing of which this is a property, and the kinds of thing in terms of which this property is framed, are outside the scope of this model and so are not shown." ;
	.

fibo-fnd-rel-rel:isControlledBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:experiencesDirectly ;
	rdfs:label "is controlled by" ;
	rdfs:range cmns-pts:Party ;
	owl:inverseOf fibo-fnd-rel-rel:controls ;
	skos:definition "is influenced, managed, or directed by" ;
	.

fibo-fnd-rel-rel:isEvaluatedBy
	a owl:ObjectProperty ;
	rdfs:label "is evaluated by" ;
	owl:inverseOf fibo-fnd-rel-rel:evaluates ;
	skos:definition "is ascertained or determined by" ;
	.

fibo-fnd-rel-rel:isExemplifiedBy
	a owl:ObjectProperty ;
	rdfs:label "is exemplified by" ;
	owl:inverseOf fibo-fnd-rel-rel:exemplifies ;
	skos:definition "is made concrete or is realized by" ;
	.

fibo-fnd-rel-rel:isGeneratedBy
	a owl:ObjectProperty ;
	rdfs:label "is generated by" ;
	owl:inverseOf fibo-fnd-rel-rel:generates ;
	skos:definition "identifies some party or something that produces something via some equation, logic, or rules" ;
	.

fibo-fnd-rel-rel:isHeldBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:experiencesWith ;
	rdfs:label "is held by" ;
	owl:inverseOf fibo-fnd-rel-rel:holds ;
	skos:definition "indicates the party that possesses and has at least partial control of something, regardless of ownership" ;
	.

fibo-fnd-rel-rel:isIssuedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:isProvidedBy ;
	rdfs:label "is issued by" ;
	skos:definition "indicates a functional entity or party responsible for circulating, distributing, or publishing something" ;
	.

fibo-fnd-rel-rel:isMandatedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:isConferredBy ;
	rdfs:label "is mandated by" ;
	skos:definition "relates a responsibility, capacity, or action to that which requires it" ;
	.

fibo-fnd-rel-rel:isProducedBy
	a owl:ObjectProperty ;
	rdfs:label "is produced by" ;
	owl:inverseOf fibo-fnd-rel-rel:produces ;
	skos:definition "identifies the producer that fabricates, manufactures or otherwise creates something through some production process" ;
	.

fibo-fnd-rel-rel:issues
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:provides ;
	rdfs:label "issues" ;
	owl:inverseOf fibo-fnd-rel-rel:isIssuedBy ;
	skos:definition "officially makes something available" ;
	.

fibo-fnd-rel-rel:mandates
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:confers ;
	rdfs:label "mandates" ;
	owl:inverseOf fibo-fnd-rel-rel:isMandatedBy ;
	skos:definition "relates something to a commitment, contract, law, obligation, requirement, regulation, or similar concept that requires it" ;
	.

fibo-fnd-rel-rel:produces
	a owl:ObjectProperty ;
	rdfs:label "produces" ;
	skos:definition "creates through a fabrication, manufacturing or production process" ;
	.

fibo-fnd-rel-rel:wasFormerlyKnownAs
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "was formerly known as" ;
	skos:definition "indicates a name by which something was known in the past" ;
	.

fibo-fnd-utl-alx:AnnualizedStandardDeviation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StandardDeviation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ;
			owl:onClass fibo-fnd-dt-fd:ExplicitRecurrenceInterval ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "annualized standard deviation" ;
	skos:definition "standard deviation for some measure over a specific reference period" ;
	cmns-av:explanatoryNote "Standard deviation applied to the annual rate of return of an investment provides insights on the historical volatility of that investment. The greater the standard deviation of the price of a security, the greater the volatility. Multiplying monthly standard deviation by the square root of twelve (12) is an industry standard method of approximating annualized standard deviations of monthly returns." ;
	.

fibo-fnd-utl-alx:ArithmeticMean
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-utl-alx:Mean ;
	rdfs:label "arithmetic mean" ;
	skos:definition "sum of a collection of numbers divided by the number of numbers in the collection" ;
	cmns-av:explanatoryNote "While the arithmetic mean is often used to report central tendencies, it is not a robust statistic, meaning that it is greatly influenced by outliers (values that are very much larger or smaller than most of the values). Notably, for skewed distributions, such as the distribution of income for which a few people's incomes are substantially greater than most people's, the arithmetic mean may not accord with one's notion of 'middle', and robust statistics, such as the median, may be a better description of central tendency." ;
	cmns-av:synonym "average" ;
	.

fibo-fnd-utl-alx:AverageAbsoluteDeviation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:Dispersion ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-utl-alx:Mean
					fibo-fnd-utl-alx:Median
				) ;
			] ;
		]
		;
	rdfs:label "average absolute deviation" ;
	skos:definition "average of the absolute deviations from a central point" ;
	cmns-av:explanatoryNote "The central point can be the mean, median, mode, or the result of another measure of central tendency. Absolute deviation is the distance between each value in the data set and that data set's mean or median." ;
	cmns-av:synonym "mean absolute deviation" ;
	.

fibo-fnd-utl-alx:Difference
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalMeasure ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasMinuend ;
			owl:cardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasSubtrahend ;
			owl:cardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "difference" ;
	skos:definition "quantity by which amounts differ; the remainder left after subtraction of one value from another" ;
	.

fibo-fnd-utl-alx:Dispersion
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalMeasure ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-arr:hasCollectionSize ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasObservedValue ;
			owl:someValuesFrom cmns-col:StructuredCollection ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-utl-alx:FinitePopulation ;
		]
		;
	rdfs:label "dispersion" ;
	skos:definition "degree of scatter or variability shown by observations" ;
	skos:example "Common examples of measures of statistical dispersion are the variance, standard deviation, and interquartile range. The collection size argument, above, represents the number of elements in the set, if known. The collection of values under consideration is represented as a structured collection in FIBO, typically a sample set derived from a finite population." ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=3637"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"A measure of statistical dispersion is a nonnegative real number that is zero if all the data are the same and increases as the data become more diverse." ,
		"It is usually measured as an average deviation about some central value (e.g. mean deviation, standard deviation) or by an order statistic (e.g. quartile deviation, range) but may also be a mean of deviations of values among themselves (e.g. Gini's mean difference and also standard deviation)."
		;
	.

fibo-fnd-utl-alx:FinitePopulation
	a owl:Class ;
	rdfs:subClassOf cmns-col:Collection ;
	rdfs:label "finite population" ;
	skos:definition "population for which it is possible to count its units" ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=3649"^^xsd:anyURI ;
	cmns-av:explanatoryNote "In statistics, a population is a set of similar items or events of interest for some question or experiment. In other words, a population is the complete group of units to which survey results are to apply. (These units may be persons, animals, objects, businesses, trips, etc.). See http://www.statcan.gc.ca/edu/power-pouvoir/glossary-glossaire/5214842-eng.htm#p." ;
	.

fibo-fnd-utl-alx:Formula
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:Specification ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:someValuesFrom cmns-qtu:Expression ;
		]
		;
	rdfs:label "formula" ;
	skos:definition "rule expressed in letters and symbols that consists of at least one expression" ;
	cmns-av:synonym "complex expression" ;
	.

fibo-fnd-utl-alx:GeometricMean
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-utl-alx:Mean ;
	rdfs:label "geometric mean" ;
	skos:definition "mean that indicates the central tendency or typical value of a set of numbers by using the product of their values (as opposed to the arithmetic mean which uses their sum)" ;
	cmns-av:explanatoryNote "The geometric mean is defined as the nth root of the product of n numbers. A geometric mean is often used when comparing different items - finding a single 'figure of merit' for these items - when each item has multiple properties that have different numeric ranges. For example, the geometric mean can give a meaningful 'average' to compare two companies which are each rated at 0 to 5 for their environmental sustainability, and are rated at 0 to 100 for their financial viability. If an arithmetic mean were used instead of a geometric mean, the financial viability is given more weight because its numeric range is larger - so a small percentage change in the financial rating (e.g. going from 80 to 90) makes a much larger difference in the arithmetic mean than a large percentage change in environmental sustainability (e.g. going from 2 to 5)." ;
	.

fibo-fnd-utl-alx:KeyPerformanceIndicator
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:QualifiedMeasure ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasObservedValue ;
			owl:someValuesFrom fibo-fnd-dt-fd:DatedStructuredCollection ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasTargetValue ;
			owl:someValuesFrom fibo-fnd-dt-fd:DatedStructuredCollection ;
		]
		;
	rdfs:label "key performance indicator" ;
	skos:definition "measurable target that indicates how an individual or business is performing in terms of meeting its goals" ;
	skos:example "Examples include profits, sales numbers, employee turnover and average annual expenses." ;
	cmns-av:abbreviation "KPI" ;
	cmns-av:adaptedFrom
		"https://www.forbes.com/advisor/business/what-is-a-kpi-definition-examples/"^^xsd:anyURI ,
		"https://www.kpi.org/KPI-Basics/"^^xsd:anyURI
		;
	cmns-av:explanatoryNote
		"Although they are both designed to measure performance, KPIs and metrics have different characteristics and are used by businesses in different ways. Metrics are measures used to track progress and evaluate success, while KPIs are metrics tied to specific goals during a certain period of time. KPIs are designed to align with business goals and targets, while metrics evaluate the performance of particular processes." ,
		"Key Performance Indicators (KPIs) are the critical (key) quantifiable indicators of progress toward an intended result. KPIs provide a focus for strategic and operational improvement, create an analytical basis for decision making and help focus attention on what matters most. Managing with the use of KPIs includes setting targets (the desired level of performance) and tracking progress against those targets."
		;
	.

fibo-fnd-utl-alx:Mean
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalMeasure ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasObservedValue ;
			owl:someValuesFrom cmns-col:StructuredCollection ;
		]
		;
	rdfs:label "mean" ;
	skos:definition "most common measure of central tendency; the average of a set of numbers" ;
	cmns-av:adaptedFrom
		"http://www.statcan.gc.ca/edu/power-pouvoir/glossary-glossaire/5214842-eng.htm#m"^^xsd:anyURI ,
		"https://stats.oecd.org/glossary/detail.asp?ID=3762"^^xsd:anyURI
		;
	cmns-av:explanatoryNote "When unqualified, the mean usually refers to the expectation of a variate, or to the arithmetic mean of a sample used as an estimate of the expectation." ;
	cmns-av:symbol "μ" ;
	cmns-av:synonym
		"expected value" ,
		"first (raw) moment"
		;
	.

fibo-fnd-utl-alx:Median
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalMeasure ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasObservedValue ;
			owl:someValuesFrom cmns-col:StructuredCollection ;
		]
		;
	rdfs:label "median" ;
	skos:definition "value of the variate dividing the total frequency of a data sample, population, or probability distribution, into two halves" ;
	cmns-av:adaptedFrom "https://stats.oecd.org/glossary/detail.asp?ID=3717"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"The basic advantage of the median in describing data compared to the mean is that it is not skewed by extremely large or small values, and may provide a better idea of a 'typical' value." ,
		"This measure represents the middle value (if n is odd) or the average of the two middle values (if n is even) in an ordered list of data values. The median divides the total frequency distribution into two equal parts: one-half of the cases fall below the median and one-half of the cases exceed the median."
		;
	.

fibo-fnd-utl-alx:MedianAbsoluteDeviation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:Dispersion ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fnd-utl-alx:Median ;
		]
		;
	rdfs:label "median absolute deviation" ;
	skos:definition "median of the absolute deviations of observations from the average which may be the arithmetic mean, the median or the mode" ;
	.

fibo-fnd-utl-alx:NumericIndexValue
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:ScalarQuantityValue ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:isValueOf ;
			owl:onClass fibo-fnd-utl-alx:QualifiedMeasure ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasMeasurementDateTime ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
		]
		;
	rdfs:label "numeric index value" ;
	skos:definition "numeric value of some aggregate relative to the value of that aggregate as of some date" ;
	cmns-av:adaptedFrom "http://www.statcan.gc.ca/edu/power-pouvoir/glossary-glossaire/5214842-eng.htm#i"^^xsd:anyURI ;
	cmns-av:explanatoryNote "A mathematical device or number which is used to express the observation (e.g., price level, volume of trade, relative amount etc.) of a given period, in comparison with that of a prior period." ;
	.

fibo-fnd-utl-alx:QualifiedMeasure
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalMeasure ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasAnchorDate ;
			owl:onClass fibo-fnd-dt-fd:AnchorDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:isCalculatedViaMethodology ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange [
				a rdfs:Datatype ;
				owl:unionOf (
					xsd:anyURI
					xsd:string
				) ;
			] ;
		]
		;
	rdfs:label "qualified measure" ;
	skos:definition "statistical measure that is constrained by features, quantity kinds or units that refine how it is calculated" ;
	.

fibo-fnd-utl-alx:SamplingVariance
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-utl-alx:Variance ;
	rdfs:label "sampling variance" ;
	skos:definition "measure of the extent to which the estimate of a characteristic from different possible samples of the same size and the same design differ from one another" ;
	cmns-av:adaptedFrom
		"http://www.statcan.gc.ca/pub/12-587-x/12-587-x2003001-eng.pdf"^^xsd:anyURI ,
		"https://stats.oecd.org/glossary/detail.asp?ID=3834"^^xsd:anyURI
		;
	cmns-av:explanatoryNote "The word 'sampling' can usually be omitted, as being defined by the context or otherwise understood. The sampling variance of a statistic is the square of its standard error." ;
	.

fibo-fnd-utl-alx:ScopedMeasure
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:QualifiedMeasure ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasPeriodicity ;
			owl:allValuesFrom fibo-fnd-dt-fd:RecurrenceInterval ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:onClass fibo-fnd-utl-alx:FinitePopulation ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasCoverageArea ;
			owl:onClass fibo-fnd-utl-alx:StatisticalArea ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "scoped measure" ;
	skos:definition "qualified measure that is constrained by filters on the statistical population to which it applies" ;
	cmns-av:explanatoryNote "Note that (1) the anchor date reflects the start of the current series, such as 1982-1984 for the CPI, (2) the fixed comparative date might be something like March 2009, if one is comparing a current index against its value at the end of the great recession, (3) the relative comparative date might be something like a month or year ago, depending on the analysis requirements, and (4) the relative comparative period might be a 3 month average prior value, again depending on the analysis requirements." ;
	.

fibo-fnd-utl-alx:StandardDeviation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:Dispersion ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-utl-alx:Mean
					fibo-fnd-utl-alx:Variance
				) ;
			] ;
		]
		;
	rdfs:label "standard deviation" ;
	skos:definition "square root of variance that measures the spread or dispersion around the mean of a data set" ;
	cmns-av:abbreviation "SD" ;
	cmns-av:adaptedFrom
		"http://www.statcan.gc.ca/edu/power-pouvoir/glossary-glossaire/5214842-eng.htm#s"^^xsd:anyURI ,
		"https://stats.oecd.org/glossary/detail.asp?ID=3845"^^xsd:anyURI
		;
	cmns-av:explanatoryNote
		"The most widely used measure of dispersion of a frequency distribution introduced by K. Pearson (1893). It is equal to the positive square root of the variance. The standard deviation should not be confused with the root mean square deviation." ,
		"While standard deviation is the most widely-used measure of spread, using squared deviations, it may not be the most robust."
		;
	cmns-av:symbol "σ" ;
	.

fibo-fnd-utl-alx:StatisticalArea
	a owl:Class ;
	rdfs:subClassOf
		cmns-loc:GeographicRegion ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:someValuesFrom fibo-fnd-utl-alx:StatisticalAreaIdentifier ;
		]
		;
	rdfs:label "statistical area" ;
	skos:definition "physical location that is defined per some program for designating geographic regions for the purposes of tabulating and presenting statistical data" ;
	cmns-av:adaptedFrom
		"U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/display/IND/Statistics+Canada+Census+Information" ,
		"U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041"
		;
	.

fibo-fnd-utl-alx:StatisticalAreaIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-loc:GeographicRegionIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-utl-alx:StatisticalArea ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "statistical area identifier" ;
	skos:definition "identifier for a physical location that is defined per a nationally consistent program for designating geographic regions for the purposes of tabulating and presenting statistical data" ;
	cmns-av:adaptedFrom
		"U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/display/IND/Statistics+Canada+Census+Information" ,
		"U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041"
		;
	.

fibo-fnd-utl-alx:StatisticalMeasure
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:Measure ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:onClass cmns-cls:Aspect ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:isEstimate ;
			owl:onDataRange xsd:boolean ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "statistical measure" ;
	skos:definition "summary (means, mode, total, index, etc.) of the individual quantitative variable values for the statistical units in a specific group (study domain)" ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=5068"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Statistical measures may consist of several orthogonal characteristics, including (a) whether they reflect an estimate or variable, (b) the datatype, or from a FIBO perspective, nature of the measure (e.g., index, total, ratio, percent, percent change, mean, others), (c) the population (or the universe that applies to the highest level if defined in general) to which the measure applies, and (d) any relevant aspects used to subset or stratify a measure, (i.e., make them apply to a smaller universe)." ;
	.

fibo-fnd-utl-alx:StatisticalPopulation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:FinitePopulation ,
		fibo-fnd-utl-alx:StatisticalUniverse ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasPopulationSize ;
			owl:allValuesFrom xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:someValuesFrom fibo-fnd-utl-alx:StatisticalArea ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:someValuesFrom cmns-dt:ExplicitDatePeriod ;
		]
		;
	rdfs:label "statistical population" ;
	skos:definition "statistical universe filtered by time and region" ;
	cmns-av:adaptedFrom <http://stats.oecd.org/glossary/detail.asp?ID=2079> ;
	cmns-av:explanatoryNote "A common aim of statistical analysis is to produce information about some chosen population. In statistical inference, a subset of the population (a statistical sample) is chosen to represent the population in a statistical analysis. If a sample is chosen properly, characteristics of the entire population that the sample is drawn from can be estimated from corresponding characteristics of the sample." ;
	.

fibo-fnd-utl-alx:StatisticalProgram
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:Program ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-utl-alx:StatisticalUniverse ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasCoverageArea ;
			owl:someValuesFrom fibo-fnd-utl-alx:StatisticalArea ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:provides ;
			owl:someValuesFrom fibo-fnd-utl-alx:StatisticalMeasure ;
		]
		;
	rdfs:label "statistical program" ;
	skos:definition "program that presents a detailed investigation and analysis of a subject or situation involving one or more studies or surveys" ;
	.

fibo-fnd-utl-alx:StatisticalUniverse
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Collection ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasUniverseSize ;
			owl:allValuesFrom xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom fibo-fnd-utl-alx:StatisticalProgram ;
		]
		;
	rdfs:label "statistical universe" ;
	skos:definition "collection representing the total membership, or 'universe', of people, resources, products, services, events, or entities of interest for some question, experiment, survey or statistical program" ;
	skos:example "A statistical universe can be a group of actually existing objects (e.g. the set of all stars within the Milky Way galaxy) or a hypothetical and potentially infinite group of objects conceived as a generalization from experience (e.g. the set of all possible hands in a game of poker)." ;
	cmns-av:adaptedFrom <http://stats.oecd.org/glossary/detail.asp?ID=2087> ;
	.

fibo-fnd-utl-alx:Variance
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:Dispersion ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fnd-utl-alx:Mean ;
		]
		;
	rdfs:label "variance" ;
	skos:definition "measure of spread, calculated as the average squared deviation of each number from the mean of a data set" ;
	cmns-av:adaptedFrom "http://www.statcan.gc.ca/edu/power-pouvoir/glossary-glossaire/5214842-eng.htm#v"^^xsd:anyURI ;
	cmns-av:symbol
		"μ2" ,
		"σ2"
		;
	cmns-av:synonym "second moment" ;
	.

fibo-fnd-utl-alx:WeightingFunction
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalMeasure ,
		cmns-qtu:Expression
		;
	rdfs:label "weighting function" ;
	skos:definition "expression or function that determines the relative importance or influence of a given element of a set with respect to the whole" ;
	skos:example "Given a sample size of 1000, and a population of 300M, then the chance that any individual is selected is 1 in 300K. In that case, 300K is the weight assigned to each of the elements in the sample." ;
	cmns-av:explanatoryNote
		"For certain indices, one of the most common weighting factor is by market capitalization. In that case, each of the elements in the basket is multiplied by its market cap to determine its relative importance to the basket overall." ,
		"With respect to discrete calculations, weighting functions are positive functions defined on discrete sets, such as weighted sums and weighted averages."
		;
	.

fibo-fnd-utl-alx:hasFixedComparativeDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has fixed comparative date" ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the a specific date, such as the end of the last recession (e.g., March 2009) against which the scoped measure is compared" ;
	.

fibo-fnd-utl-alx:hasFormula
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isCharacterizedBy ;
	rdfs:label "has formula" ;
	rdfs:range fibo-fnd-utl-alx:Formula ;
	skos:definition "specifies a concise way of expressing information symbolically, as in a mathematical or chemical formula" ;
	.

fibo-fnd-utl-alx:hasMeasurementDateTime
	a owl:DatatypeProperty ;
	rdfs:label "has measurement date time" ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "indicates the date and time that the measurement was taken" ;
	.

fibo-fnd-utl-alx:hasMeasurementPeriodInMonths
	a owl:DatatypeProperty ;
	rdfs:label "has measurement period in months" ;
	rdfs:range xsd:integer ;
	skos:definition "indicates the coverage period for which the measure is applicable expressed in months" ;
	.

fibo-fnd-utl-alx:hasMinuend
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasArgument ;
	rdfs:label "has minuend" ;
	rdfs:domain fibo-fnd-utl-alx:Difference ;
	skos:definition "specifies the quantity value from which something is subtracted; the value that is diminished" ;
	.

fibo-fnd-utl-alx:hasNumberOfEntries
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasCount ;
	rdfs:label "has number of entries" ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "indicates the number of elements in some document, table, or other resource (e.g., in a report, table)" ;
	.

fibo-fnd-utl-alx:hasObservedValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasArgument ;
	rdfs:label "has observed value" ;
	rdfs:range cmns-col:StructuredCollection ;
	skos:definition "specifies a collection of values over which some analysis is performed" ;
	cmns-av:explanatoryNote "For certain calculations, such as certain measures of dispersion, date value pairs are expected as input, in other words, a dated structured collection." ;
	.

fibo-fnd-utl-alx:hasPeriodicity
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasRecurrenceInterval ;
	rdfs:label "has periodicity" ;
	rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
	skos:definition "specifies a recurrence interval (monthly, quarterly, annual) that a statistical measure reflects" ;
	.

fibo-fnd-utl-alx:hasPopulationSize
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-arr-arr:hasCollectionSize ;
	rdfs:label "has population size" ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "indicates the number of elements in a given population" ;
	.

fibo-fnd-utl-alx:hasReferencePeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasRecurrenceInterval ;
	rdfs:label "has reference period" ;
	rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
	skos:definition "specifies a reference (baseline) recurrence interval for which a given measure applies" ;
	.

fibo-fnd-utl-alx:hasRelativeComparativeDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has relative comparative date" ;
	rdfs:range fibo-fnd-dt-fd:RelativeDate ;
	skos:definition "specifies a date against which the value of a scoped measure is compared (e.g., one month prior, three months prior, etc., and typically against a prior release or average over prior releases)" ;
	.

fibo-fnd-utl-alx:hasRelativeComparativePeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has relative comparative period" ;
	rdfs:range cmns-dt:DatePeriod ;
	skos:definition "specifies a period (typically a prior period) against which the scoped measure is compared, such as an average set of values for some period of time compared with a more recent or projected average for a forward looking period of time" ;
	.

fibo-fnd-utl-alx:hasReleaseDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has release date" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "specifies the date on which something is published" ;
	cmns-av:explanatoryNote "A release date is typically a date fixed in advance for the release of a film, recording, document, report, or product or publication." ;
	.

fibo-fnd-utl-alx:hasReleaseDateTime
	a owl:DatatypeProperty ;
	rdfs:label "has release date and time" ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "specifies the date and time on which something is published" ;
	.

fibo-fnd-utl-alx:hasSubtrahend
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasArgument ;
	rdfs:label "has subtrahend" ;
	rdfs:domain fibo-fnd-utl-alx:Difference ;
	skos:definition "specifies the quantity value that is subtracted from something" ;
	.

fibo-fnd-utl-alx:hasTargetValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasArgument ;
	rdfs:label "has target value" ;
	rdfs:range fibo-fnd-dt-fd:DatedStructuredCollection ;
	skos:definition "specifies a collection of values that represent planned or projected goals or objectives for some something over time" ;
	.

fibo-fnd-utl-alx:hasUniverseSize
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-arr-arr:hasCollectionSize ;
	rdfs:label "has universe size" ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "indicates the number of elements in a given universe" ;
	.

fibo-fnd-utl-alx:hasWeight
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has weight" ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates an amount given to increase or decrease the importance of an item" ;
	.

fibo-fnd-utl-alx:isCalculatedViaMethodology
	a owl:DatatypeProperty ;
	rdfs:label "is calculated via methodology" ;
	rdfs:domain fibo-fnd-utl-alx:StatisticalMeasure ;
	skos:definition "high-level description of the approach taken to obtain the result" ;
	.

fibo-fnd-utl-alx:isEstimate
	a owl:DatatypeProperty ;
	rdfs:label "is estimate" ;
	rdfs:domain fibo-fnd-utl-alx:StatisticalMeasure ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the measure reflects an estimate (approximation) or not" ;
	.

fibo-fnd-utl-av:Informative
	a
		owl:NamedIndividual ,
		fibo-fnd-utl-av:MaturityLevel
		;
	rdfs:label "informative" ;
	skos:definition "entity that is considered deprecated but included for informational purposes because it is referenced by some provisional concept"@en ;
	cmns-av:explanatoryNote "Informative content will be removed as soon as all dependencies have been eliminated, thus FIBO users should not depend on it going forward."@en ;
	.

fibo-fnd-utl-av:MaturityLevel
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleStage ,
		cmns-cls:Classifier
		;
	rdfs:label "maturity level" ;
	skos:definition "classifier used to indicate the state of an artifact with respect to its development lifecycle" ;
	cmns-av:explanatoryNote "FIBO currently has three maturity levels: Informative, Provisional, and Release."@en ;
	.

fibo-fnd-utl-av:Module
	a owl:Class ;
	rdfs:subClassOf cmns-cls:Classifier ;
	rdfs:label "module" ;
	skos:definition "classifier used to indicate a category used to modularize something based on principles of the model driven architecture methodology (MDA), including but not limited to separation of concerns, coherence, and establishing clear logical boundaries in order to increase reusability and maintainability" ;
	cmns-av:explanatoryNote "A module should be designed to reflect these principles, including a small number of models that have well-defined relationships with one another, that form a coherent and cohesive whole for some purpose, and that have clear boundaries or interfaces to other modules." ;
	.

fibo-fnd-utl-av:Provisional
	a
		owl:NamedIndividual ,
		fibo-fnd-utl-av:MaturityLevel
		;
	rdfs:label "provisional" ;
	skos:definition "entity that is considered to be under development"@en ;
	cmns-av:explanatoryNote "Provisional content is subject to change, and may change substantially prior to release. FIBO users should be aware that it is not dependable, but could be used for reference and as the basis for further work."@en ;
	.

fibo-fnd-utl-av:Release
	a
		owl:NamedIndividual ,
		fibo-fnd-utl-av:MaturityLevel
		;
	rdfs:label "release" ;
	skos:definition "entity that is considered to be stable and mature from a development perspective"@en ;
	cmns-av:explanatoryNote "Release notes will be provided for any changes with respect to released content, and any revisions will be backwards compatible with the prior version to the degree possible."@en ;
	.

fibo-fnd-utl-av:commonDesignation
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf cmns-av:synonym ;
	rdfs:label "common designation" ;
	skos:definition "frequently used designation for an entity" ;
	cmns-av:adaptedFrom "https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf"^^xsd:anyURI ;
	.

fibo-fnd-utl-av:definitionOrigin
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf cmns-av:directSource ;
	rdfs:label "definition origin" ;
	skos:definition "document or other source from which a given definition was taken directly; the range for this annotation can be a string, URI, or BibliographicCitation" ;
	.

fibo-fnd-utl-av:hasMaturityLevel
	a owl:AnnotationProperty ;
	rdfs:label "has maturity level" ;
	skos:definition "links something to its state with respect to a development lifecycle" ;
	.

fibo-fnd-utl-av:preferredDesignation
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf cmns-av:synonym ;
	rdfs:label "preferred designation" ;
	skos:definition "recommended designation for an entity in some context" ;
	cmns-av:adaptedFrom "https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf"^^xsd:anyURI ;
	.

fibo-fnd-utl-av:termOrigin
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf cmns-av:directSource ;
	rdfs:label "term origin" ;
	skos:definition "document or other source from which a given term was taken directly; the range for this annotation can be a string, URI, or BibliographicCitation" ;
	.

fibo-ind-ei-ei:AverageDailyEarnings
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:AverageEarnings ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ;
			owl:hasValue fibo-ind-ei-ei:Daily ;
		]
		;
	rdfs:label "average daily earnings" ;
	skos:definition "measure of the average daily wage an employee makes over the reporting period" ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI ;
	.

fibo-ind-ei-ei:AverageEarnings
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ;
			owl:onClass fibo-fnd-dt-fd:ExplicitRecurrenceInterval ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "average earnings" ;
	skos:definition "measure of the average wage an hourly or salaried worker makes in a given period of time" ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Average earnings are typically calculated on an hourly, daily, weekly, or monthly basis. They may be expressed as an amount of money or in terms of a percent change with respect to a prior period, depending on the jurisdiction and report." ;
	.

fibo-ind-ei-ei:AverageHourlyEarnings
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:AverageEarnings ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ;
			owl:hasValue fibo-ind-ei-ei:Hourly ;
		]
		;
	rdfs:label "average hourly earnings" ;
	skos:definition "measure of the average hourly wage an employee makes over the reporting period" ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI ;
	.

fibo-ind-ei-ei:AverageMonthlyEarnings
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:AverageEarnings ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ;
			owl:hasValue fibo-ind-ei-ei:Monthly ;
		]
		;
	rdfs:label "average monthly earnings" ;
	skos:definition "measure of the average monthly wage an employee makes over the reporting period" ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI ;
	.

fibo-ind-ei-ei:AverageWeeklyEarnings
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:AverageEarnings ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ;
			owl:hasValue fibo-ind-ei-ei:Weekly ;
		]
		;
	rdfs:label "average weekly earnings" ;
	skos:definition "measure of the average weekly wage an employee makes over the reporting period" ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI ;
	.

fibo-ind-ei-ei:CapitalLaborEnergyMaterialsMultifactorProductivity
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
	rdfs:label "capital-labor-energy-materials multifactor productivity" ;
	skos:definition "ratio of a quantity index of gross output to a quantity index of combined inputs" ;
	cmns-av:abbreviation "KLEMS-MFP" ;
	cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Shows the time profile of how productively combined inputs are used to generate gross output. Conceptually, the KLEMS productivity measure captures disembodied technical change. In practice, it reflects also efficiency change, economies of scale, variations in capacity utilisation and measurement errors." ;
	cmns-av:synonym "KLEMS multifactor productivity" ;
	.

fibo-ind-ei-ei:CapitalLaborMultifactorProductivityValueAdded
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
	rdfs:label "capital-labor multifactor productivity (MFP), based on value added" ;
	skos:definition "ratio of a quantity index of value added to a quantity index of combined labor and capital input" ;
	cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Capital-labour MFP indices show the time profile of how productively combined labour and capital inputs are used to generate value added. Conceptually, capital-labour productivity is not, in general, an accurate measure of technical change. It is, however, an indicator of an industry's capacity to contribute to economy-wide growth of income per unit of primary input. In practice, the measure reflects the combined effects of disembodied technical change, economies of scale, efficiency change, variations in capacity utilisation and measurement errors." ;
	.

fibo-ind-ei-ei:CapitalProductivityValueAdded
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
	rdfs:label "capital productivity, based on value added" ;
	skos:definition "ratio of a quantity index of value added to a quantity index of capital input" ;
	cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"Changes in capital productivity indicate the extent to which output growth can be achieved with lower welfare costs in the form of foregone consumption." ,
		"The capital productivity index shows the time profile of how productively capital is used to generate value added. Capital productivity reflects the joint influence of labour, intermediate inputs, technical change, efficiency change, economies of scale, capacity utilisation and measurement errors."
		;
	.

fibo-ind-ei-ei:Civilian
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-lp:LegallyCompetentNaturalPerson ;
	rdfs:label "civilian" ;
	owl:disjointWith fibo-ind-ei-ei:MilitaryPerson ;
	skos:definition "person that is not a member of the military (i.e., that is not on active duty)" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	.

fibo-ind-ei-ei:CivilianLaborForce
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
	rdfs:label "civilian labor force" ;
	owl:disjointWith fibo-ind-ei-ei:PopulationNotInLaborForce ;
	skos:definition "subset of the civilian, non-institutional population considered to be part of the labor force during a given reporting period" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	.

fibo-ind-ei-ei:CivilianLaborForceParticipationRate
	a
		owl:NamedIndividual ,
		owl:Class
		;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
			owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasComparisonPopulation ;
			owl:someValuesFrom fibo-ind-ei-ei:CivilianLaborForce ;
		]
		;
	rdfs:label "civilian labor force participation rate" ;
	owl:disjointWith fibo-ind-ei-ei:ConsumerPriceIndex ;
	skos:definition "economic indicator representing the rate of participation the labor force of a given economy for some specified period" ;
	cmns-av:adaptedFrom "https://www.bls.gov/cps/definitions.htm#lfpr"^^xsd:anyURI ;
	cmns-av:explanatoryNote "The labor force participation rate is the percentage of the population that is either employed or unemployed (that is, either working or actively seeking work)." ;
	cmns-qtu:describesActualExpression "civilian labor force ÷ civilian non-institutional population" ;
	.

fibo-ind-ei-ei:CivilianNonInstitutionalPerson
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:LegalWorkingAgePerson ,
		fibo-ind-ei-ei:Civilian
		;
	rdfs:label "civilian non-institutional person" ;
	rdfs:seeAlso <http://www.investopedia.com/terms/w/working-age-population.asp> ;
	owl:disjointWith fibo-ind-ei-ei:InstitutionalPerson ;
	skos:definition "legal working-age person that does not live in an institution (for example, a correctional facility, long-term care hospital, or nursing home), and is not on active military duty" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	cmns-av:explanatoryNote "The working-age population is the total population in a region, within a set range of ages, that is considered to be able and likely to work. The working-age population measure is used to give an estimate of the total number of potential workers within an economy. For example, in the U.S., it is 16, whereas in Canada it is 15." ;
	.

fibo-ind-ei-ei:CivilianNonInstitutionalPopulation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalUniverse ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPerson ;
		]
		;
	rdfs:label "civilian non-institutional population" ;
	skos:definition "statistical universe consisting of people of a certain age who reside in a given region, do not live in institutions (for example, correctional facilities, long-term care hospitals, and nursing homes), and are not on active military duty" ;
	skos:scopeNote "The civilian non-institutional population is typically reported in thousands." ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	.

fibo-ind-ei-ei:CombinedStatisticalArea
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
			owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "combined statistical area" ;
	skos:definition "combination of adjacent metropolitan and micropolitan areas with economic ties measured by commuting patterns" ;
	cmns-av:abbreviation "CSA" ;
	cmns-av:adaptedFrom
		<https://en.wikipedia.org/wiki/Combined_statistical_area> ,
		<https://obamawhitehouse.archives.gov/sites/default/files/omb/assets/fedreg_2010/06282010_metro_standards-Complete.pdf> ,
		<https://www.federalregister.gov/documents/2021/07/16/2021-15159/2020-standards-for-delineating-core-based-statistical-areas>
		;
	cmns-av:explanatoryNote "These areas that combine retain their own designations as metropolitan or micropolitan statistical areas within the larger combined statistical area." ;
	.

fibo-ind-ei-ei:ConsumerPriceIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasInput ;
			owl:someValuesFrom fibo-ind-ei-ei:FixedBasket ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
			owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
		]
		;
	rdfs:label "consumer price index" ;
	owl:disjointWith
		fibo-ind-ei-ei:EmploymentPopulationRatio ,
		fibo-ind-ei-ei:GrossDomesticProduct ,
		fibo-ind-ei-ei:InflationRate ,
		fibo-ind-ei-ei:ProducerPriceIndex ,
		fibo-ind-ei-ei:UnemploymentRate
		;
	skos:definition "economic indicator representing measure of the change over time in the prices of consumer goods and services that households consume" ;
	cmns-av:abbreviation "CPI" ;
	cmns-av:adaptedFrom
		"http://unstats.un.org/unsd/nationalaccount/docs/SNA2008.pdf"^^xsd:anyURI ,
		"http://www.ilo.org/public/english/bureau/stat/guides/cpi/"^^xsd:anyURI
		;
	.

fibo-ind-ei-ei:Daily
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:ExplicitRecurrenceInterval
		;
	rdfs:label "daily" ;
	skos:definition "explicit recurrence interval of one day, or 24 hours" ;
	cmns-dt:hasDurationValue "P1D" ;
	.

fibo-ind-ei-ei:DiscouragedWorkerPopulation
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:MarginallyAttachedPopulation ;
	rdfs:label "discouraged worker population" ;
	skos:definition "subset of the marginally attached population that have given a job-market related reason for not currently looking for work" ;
	cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" ;
	.

fibo-ind-ei-ei:EconomicIndicator
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:ScopedMeasure ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:isSeasonallyAdjusted ;
			owl:allValuesFrom xsd:boolean ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasSeriesOrigin ;
			owl:allValuesFrom cmns-dt:Date ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReleaseDate ;
			owl:onClass cmns-dt:Date ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReleaseDateTime ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasReportingPeriod ;
			owl:someValuesFrom cmns-dt:ExplicitDatePeriod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasCoverageArea ;
			owl:someValuesFrom fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
		]
		;
	rdfs:label "economic indicator" ;
	skos:definition "statistical measure of economic activity that is regular and comparable in the context of a statistical area (region), used for analysis of economic performance and predictions of future performance" ;
	skos:example "Example indicators include the average work week, weekly claims for unemployment insurance, new orders, vendor performance, stock prices, and changes in the money supply." ;
	cmns-av:adaptedFrom "Barron's Dictionary of Business and Economic Terms, Fifth Edition, 2012" ;
	cmns-av:explanatoryNote "The two main features of any indicator are the regularity with which they are measured and published, and the fact that they are comparable from one release to the next." ;
	.

fibo-ind-ei-ei:EmployedPopulation
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:CivilianLaborForce ;
	rdfs:label "employed population" ;
	owl:disjointWith fibo-ind-ei-ei:UnemployedPopulation ;
	skos:definition "subset of the civilian labor force considered to be employed during the reporting period" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	cmns-av:explanatoryNote "There are a number of distinctions with respect to how individuals are counted from country to country, including whether or not they are considered employed if they are on unpaid leave for some reason, and whether or not they are counted multiple times if they have more than one paying job." ;
	.

fibo-ind-ei-ei:EmployedPopulationPartTime
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulation ;
	rdfs:label "employed population part-time" ;
	skos:definition "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week based on usual working hours" ;
	cmns-av:adaptedFrom "https://stats.oecd.org/Index.aspx?DatasetCode=STLABOUR" ;
	cmns-av:explanatoryNote
		"In the U.S., part-time workers are those who usually work fewer than 35 hours per week. See https://www.bls.gov/cps/definitions.htm for additional details." ,
		"The definition of part-time varies considerably from country to country according to the OECD. Classification may be based on (1) employee perception, (2) usual working hours, which is the most reliable measure, or (3) actual working hours, which varies due to holidays, illness, etc."
		;
	cmns-av:synonym "population employed part-time" ;
	.

fibo-ind-ei-ei:EmployedPopulationPartTimeForEconomicReasons
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:EmployedPopulationPartTime ,
		fibo-ind-ei-ei:UnderemployedPopulation
		;
	rdfs:label "employed population part-time for economic reasons" ;
	owl:disjointWith fibo-ind-ei-ei:EmployedPopulationPartTimeForNonEconomicReasons ;
	skos:definition "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week due to slack work, unfavorable business conditions, inability to find full-time work, and seasonal declines in demand" ;
	cmns-av:adaptedFrom
		"https://stats.oecd.org/Index.aspx?DatasetCode=STLABOUR" ,
		"https://www.bls.gov/cps/definitions.htm"
		;
	cmns-av:synonym
		"involuntary part-time population" ,
		"population employed part-time for economic reasons"
		;
	.

fibo-ind-ei-ei:EmployedPopulationPartTimeForNonEconomicReasons
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulationPartTime ;
	rdfs:label "employed population part-time for non-economic reasons" ;
	skos:definition "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week due to illness or other health or medical limitations, childcare problems, family or personal obligations, being in school or training, retirement or Social Security limits on earnings, and having a job where full-time work is less than 35 hours" ;
	cmns-av:adaptedFrom "https://www.bls.gov/cps/definitions.htm" ;
	cmns-av:synonym "population employed part-time for non-economic reasons" ;
	.

fibo-ind-ei-ei:EmployedPopulationTemporarilyNotAtWork
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulation ;
	rdfs:label "employed population temporarily not at work" ;
	skos:definition "subset of the employed population that includes persons that are temporarily absent from work for various reasons" ;
	cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" ;
	cmns-av:explanatoryNote "This includes persons temporarily not at work because of illness or injury, holiday or vacation, strike or lockout, educational or training leave, maternity or parental leave, reduction in economic activity, temporary disorganisation or suspension of work due to such reasons as bad weather, mechanical or electrical breakdown, or shortage of raw materials or fuels, or other temporary absence with or without leave should be considered as in paid employment provided they had a formal job attachment." ;
	.

fibo-ind-ei-ei:EmploymentPopulationRatio
	a
		owl:NamedIndividual ,
		owl:Class
		;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
			owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasComparisonPopulation ;
			owl:someValuesFrom fibo-ind-ei-ei:EmployedPopulation ;
		]
		;
	rdfs:label "employment-population ratio" ;
	rdfs:seeAlso <http://www.bls.gov/news.release/pdf/empsit.pdf> ;
	skos:definition "economic indicator representing the ratio of the employed population with respect to the overall civilian non-institutional population of a given economy for some specified period" ;
	cmns-qtu:describesActualExpression "employed population ÷ civilian non-institutional population" ;
	.

fibo-ind-ei-ei:Enterprise
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-fct:FunctionalBusinessEntity ,
		fibo-ind-ei-ei:InstitutionalUnit ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-pas-pas:Producer
				cmns-org:ServiceProvider
			) ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:someValuesFrom fibo-fnd-arr-cls:IndustrySectorClassifier ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-ind-ei-ei:Establishment ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-pas-pas:Good
					cmns-org:Service
				) ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom cmns-org:LegalPerson ;
		]
		;
	rdfs:label "enterprise" ;
	skos:definition "functional business entity that produces and/or sells goods or services" ;
	cmns-av:adaptedFrom "http://www.bls.gov/opub/hom/glossary.htm#E"^^xsd:anyURI ;
	cmns-av:explanatoryNote "An enterprise (a private firm, government, or nonprofit organization) can consist of a single establishment or multiple establishments. All establishments in an enterprise may be classified in one industry (e.g., a chain), or they may be classified in different industries (e.g., a conglomerate)." ;
	.

fibo-ind-ei-ei:EnterprisePopulation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalUniverse ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-ind-ei-ei:Enterprise ;
		]
		;
	rdfs:label "enterprise population" ;
	skos:definition "statistical universe consisting of enterprises designed for the purposes of supporting surveys such as those used as the basis for employment and producer price indices" ;
	.

fibo-ind-ei-ei:Establishment
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:InstitutionalUnit ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isConstituentOf ;
			owl:onClass fibo-ind-ei-ei:Enterprise ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasAddress ;
			owl:onClass fibo-fnd-plc-adr:PhysicalAddress ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "establishment" ;
	skos:definition "an enterprise (or part of an enterprise) that operates from a single physical location" ;
	cmns-av:adaptedFrom
		"http://stats.oecd.org/glossary/detail.asp?ID=857"^^xsd:anyURI ,
		"http://www.bls.gov/opub/hom/glossary.htm#E"^^xsd:anyURI ,
		"http://www.statcan.gc.ca/eng/concepts/units"^^xsd:anyURI
		;
	cmns-av:explanatoryNote "The physical location of a certain economic activity - for example, a factory, mine, store, or office. An individual establishment is generally classified by having one NAICS code associated with it for statistical purposes, whereas an enterprise may be classified by multiple NAICS codes. The statistical structure is defined based on the operating structure and the accounting data produced by that entity. A given location may only need to publish revenues, whereas an operating unit (establishment) has employment statistics, etc. An establishment is defined as a producing unit at a single geographical location at which or from which economic activity is conducted and for which, at a minimum, employment data are available. In the case of a home-based business, the actual physical location would be specified as two distinct institutional units - as a household from a personal living and consumer perspective and as an establishment / operating unit due to the statistics required of the business." ;
	.

fibo-ind-ei-ei:EstablishmentEmployment
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
			owl:someValuesFrom fibo-ind-ei-ei:EstablishmentPopulation ;
		]
		;
	rdfs:label "establishment employment" ;
	skos:definition "economic indicator representing the total number of persons who work in or for the establishment including working proprietors, active business partners and unpaid family workers, as well as persons working outside the establishment when paid by and under the control of the establishment, for example, sales representatives, outside service engineers and repair and maintenance personnel" ;
	cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=780"^^xsd:anyURI ;
	cmns-av:explanatoryNote """Also included are salaried managers and salaried directors of incorporated enterprises. The total should include part-time workers and seasonal workers on the payroll, persons on short-term leave (sick leave, maternity leave, annual leave or vacation) and on strike, but not persons on indefinite leave, military leave or pension. 

Excluded are directors of incorporated enterprises and members of shareholders committees who are paid solely for their attendance at meetings, labour made available to the establishment by other units and charged for, such as contract workers paid through contractors, persons carrying out repair and maintenance work in the establishment on behalf of other units and all homeworkers.""" ;
	cmns-av:synonym "payroll employment" ;
	.

fibo-ind-ei-ei:EstablishmentPopulation
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:EnterprisePopulation ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-ind-ei-ei:Establishment ;
		]
		;
	rdfs:label "establishment population" ;
	skos:definition "a subset of the enterprise population focused on establishments" ;
	.

fibo-ind-ei-ei:FixedBasket
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:Basket ,
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-ind-ei-ei:FixedBasketConstituent ;
		]
		;
	rdfs:label "fixed basket" ;
	skos:definition "basket of goods and services whose quantity and quality are held fixed for some period of time" ;
	cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
	cmns-av:synonym "basket of goods" ;
	.

fibo-ind-ei-ei:FixedBasketConstituent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:BasketConstituent ,
		fibo-fnd-dt-fd:DatedCollectionConstituent ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-pas-pas:Good
				cmns-org:Service
			) ;
		]
		;
	rdfs:label "fixed basket constituent" ;
	owl:equivalentClass [
		a owl:Restriction ;
		owl:onProperty cmns-col:isConstituentOf ;
		owl:someValuesFrom fibo-ind-ei-ei:FixedBasket ;
	] ;
	skos:definition "component of a fixed basket" ;
	.

fibo-ind-ei-ei:FixedBasketPopulation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalUniverse ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-pas-pas:Good
					cmns-org:Service
				) ;
			] ;
		]
		;
	rdfs:label "fixed basket population" ;
	skos:definition "statistical universe consisting of specific goods and/or services designed for the purposes of supporting surveys such as those used as the basis for price indices" ;
	cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
	cmns-av:synonym
		"goods and services population" ,
		"goods and/or services population"
		;
	.

fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalArea ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom fibo-be-ge-ge:GovernmentBody ;
		]
		;
	rdfs:label "government-specified statistical area" ;
	skos:definition "statistical area defined by a government agency" ;
	.

fibo-ind-ei-ei:GrossDomesticProduct
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:EconomicIndicator ;
	rdfs:label "gross domestic product" ;
	rdfs:seeAlso <http://unstats.un.org/unsd/nationalaccount/docs/SNA2008.pdf> ;
	owl:disjointWith fibo-ind-ei-ei:UnemploymentRate ;
	skos:definition "economic indicator representing the broadest measure of aggregate economic activity, measuring the total unduplicated market value of all final goods and services produced within a statistical area in a period" ;
	cmns-av:abbreviation "GDP" ;
	cmns-av:adaptedFrom
		"BEA's Handbook of Methods for GDP and related national accounts, available at https://www.bea.gov/methodologies/index.htm#national_meth" ,
		"https://en.wikipedia.org/wiki/Gross_domestic_product"^^xsd:anyURI ,
		"https://home.treasury.gov/system/files/261/FSOC-2013-Annual-Report.pdf"^^xsd:anyURI
		;
	cmns-av:explanatoryNote
		"GDP represents a valuation expressed in terms of the prices actually paid by the purchaser after all applicable taxes and subsidies." ,
		"Gross domestic product (GDP) is the value of the goods and services produced by the nation's economy less the value of the goods and services used up in production. GDP is also equal to the sum of personal consumption expenditures, gross private domestic investment, net exports of goods and services, and government consumption expenditures and gross investment. Conceptually, this measure can be arrived at by three separate means: as the sum of goods and services sold to final users, as the sum of income payments and other costs incurred in the production of goods and services, and as the sum of the value added at each stage of production. Although these three ways of measuring GDP are conceptually the same, their calculation may not result in identical estimates of GDP because of differences in data sources, timing, and estimation techniques."
		;
	.

fibo-ind-ei-ei:Hourly
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:ExplicitRecurrenceInterval
		;
	rdfs:label "hourly" ;
	skos:definition "explicit recurrence interval of one hour, or 60 minutes" ;
	cmns-dt:hasDurationValue "P1H" ;
	.

fibo-ind-ei-ei:Household
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:InstitutionalUnit ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasLocation ;
			owl:onClass fibo-ind-ei-ei:HousingUnit ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-aap-ppl:Person ;
		]
		;
	rdfs:label "household" ;
	skos:definition "individual or small group of persons who occupy a housing unit (such as a house or apartment) as their usual place of residence, who pool some, or all, of their income and wealth and who consume certain types of goods and services collectively, mainly housing and food" ;
	cmns-av:adaptedFrom <http://stats.oecd.org/glossary/detail.asp?ID=1255> ;
	cmns-av:explanatoryNote
		"""A household may be either (a) a one-person household, that is to say, a person who makes provision for his or her own food or other essentials for living without combining with any other person to form part of a multi-person household or (b) a multi-person household, that is to say, a group of two or more persons living together who make common provision for food or other essentials for living. The persons in the group may pool their incomes and may, to a greater or lesser extent, have a common budget; they may be related or unrelated persons or constitute a combination of persons both related and unrelated.

A household may be located in a housing unit or in a set of collective living quarters such as a boarding house, a hotel or a camp, or may comprise the administrative personnel in an institution. The household may also be homeless.""" ,
		"From the perspective of the U.S Census Bureau, a household includes the related family members and all the unrelated people, if any, such as lodgers, foster children, wards, or employees who share the housing unit. A person living alone in a housing unit, or a group of unrelated people sharing a housing unit such as partners or roomers, is also counted as a household. The count of households excludes group quarters [such as institutional facilities]. There are two major categories of households, 'family' and 'nonfamily'."
		;
	.

fibo-ind-ei-ei:HousingUnit
	a owl:Class ;
	rdfs:subClassOf
		cmns-loc:PhysicalLocation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasAddress ;
			owl:allValuesFrom fibo-fnd-plc-adr:PhysicalAddress ;
		]
		;
	rdfs:label "housing unit" ;
	skos:definition "house, an apartment, a mobile home or trailer, a group of rooms, or a single room occupied as separate living quarters, or if vacant, intended for occupancy as separate living quarters" ;
	cmns-av:explanatoryNote "Separate living quarters are those in which the occupants live separately from any other individuals in the building and which have direct access from outside the building or through a common hall. For vacant units, the criteria of separateness and direct access are applied to the intended occupants whenever possible." ;
	.

fibo-ind-ei-ei:InflationRate
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
		]
		;
	rdfs:label "inflation rate" ;
	skos:definition "economic indicator representing a change in prices of goods and services for a specified period, for a given statistical area" ;
	skos:editorialNote "Always either includes or excludes: Energy prices; Food prices. ALL inflation rates cite whether or not they exclude energy and food prices. If nothing stated it is assumed they include them." ;
	cmns-av:explanatoryNote "Inflation rate can be used to define changes, from period-to-period, in wage (wage inflation), house prices or producer inputs/outputs. It can be calculated month-over-month and quarter-over-quarter, as well as year-over-year, or on any periodic basis required by the publisher and its community of interest." ;
	.

fibo-ind-ei-ei:InputProducerPriceIndex
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:ProducerPriceIndex ;
	rdfs:label "input producer price index" ;
	skos:definition "economic indicator representing measure of the rate of change over time in the prices of inputs of goods and services purchased by the producer" ;
	cmns-av:abbreviation "input PPI" ;
	cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
	.

fibo-ind-ei-ei:InstitutionalPerson
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-aap-ppl:Person ;
	rdfs:label "institutional person" ;
	skos:definition "person that resides in an institution for some reason, due, for example, to hospitalization, rehabilitation, or incarceration" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	.

fibo-ind-ei-ei:InstitutionalUnit
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-fct:FunctionalEntity ,
		cmns-pts:PartyRole
		;
	rdfs:label "institutional unit" ;
	skos:definition "party that is capable, in its own right, of owning assets, incurring liabilities, and engaging in economic activities and in transactions with other parties" ;
	cmns-av:adaptedFrom
		"http://stats.oecd.org/glossary/detail.asp?ID=1415"^^xsd:anyURI ,
		"http://www.statcan.gc.ca/eng/concepts/units"^^xsd:anyURI ,
		"https://www.statcan.gc.ca/en/concepts/ccius/intro"^^xsd:anyURI
		;
	cmns-av:explanatoryNote "There is a hierarchical relationship between institutional units and establishments. An institutional unit contains one or more entire establishment(s); an establishment belongs to one and only one institutional unit. There are two main types of units in the real world that may qualify as institutional units, namely persons or groups of persons in the form of households, and legal or social entities." ;
	.

fibo-ind-ei-ei:LaborProductivityGrossOutput
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
	rdfs:label "labor productivity, based on gross output" ;
	skos:definition "ratio of a quantity index of gross output to a quantity index of labor input" ;
	cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"Gross-output based labour productivity traces the labour requirements per unit of (physical) output. It reflects the change in the input coefficient of labour by industry and can help in the analysis of labour requirements by industry." ,
		"Shows the time profile of how productively labour is used to generate gross output. Labour productivity changes reflect the joint influence of changes in capital, intermediate inputs, as well as technical, organisational and efficiency change within and between firms, the influence of economies of scale, varying degrees of capacity utilisation and measurement errors."
		;
	.

fibo-ind-ei-ei:LaborProductivityValueAdded
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
	rdfs:label "labor productivity, based on value added" ;
	skos:definition "ratio of a quantity index of value added to a quantity index of labor input" ;
	cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"At the aggregate level, value-added based labour productivity forms a direct link to a widely used measure of living standards, income per capita. Productivity translates directly into living standards, by adjusting for changing working hours, unemployment, labour force participation rates and demographic changes." ,
		"Shows the time profile of how productively labour is used to generate value added. Labour productivity changes reflect the joint influence of changes in capital, as well as technical, organisational and efficiency change within and between firms, the influence of economies of scale, varying degrees of capacity utilisation and measurement errors."
		;
	.

fibo-ind-ei-ei:MarginallyAttachedPopulation
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:PopulationNotInLaborForce ;
	rdfs:label "marginally attached population" ;
	skos:definition "subset of the population that includes people who currently are neither working nor looking for work but indicate that they want and are available for a job and have looked for work sometime in the past 12 months" ;
	cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" ;
	.

fibo-ind-ei-ei:MetropolitanStatisticalArea
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
	rdfs:label "metropolitan statistical area" ;
	skos:definition "one or more adjacent counties or county equivalents that have at least one urban core area of at least 50,000 population, plus adjacent territory that has a high degree of social and economic integration with the core as measured by commuting ties" ;
	cmns-av:abbreviation "MSA" ;
	cmns-av:adaptedFrom
		<https://en.wikipedia.org/wiki/List_of_Metropolitan_Statistical_Areas> ,
		<https://obamawhitehouse.archives.gov/sites/default/files/omb/assets/fedreg_2010/06282010_metro_standards-Complete.pdf> ,
		<https://www.federalregister.gov/documents/2021/07/16/2021-15159/2020-standards-for-delineating-core-based-statistical-areas>
		;
	.

fibo-ind-ei-ei:MicropolitanStatisticalArea
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
	rdfs:label "micropolitan statistical area" ;
	skos:definition "one or more adjacent counties or county equivalents that have at least one urban core area of at least 10,000 population but less than 50,000, plus adjacent territory that has a high degree of social and economic integration with the core as measured by commuting ties" ;
	cmns-av:abbreviation "μSA" ;
	cmns-av:adaptedFrom
		<https://en.wikipedia.org/wiki/List_of_micropolitan_statistical_areas> ,
		<https://obamawhitehouse.archives.gov/sites/default/files/omb/assets/fedreg_2010/06282010_metro_standards-Complete.pdf> ,
		<https://www.federalregister.gov/documents/2021/07/16/2021-15159/2020-standards-for-delineating-core-based-statistical-areas>
		;
	.

fibo-ind-ei-ei:MilitaryPerson
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-lp:LegallyCompetentNaturalPerson ;
	rdfs:label "military person" ;
	skos:definition "person that is a member of the active duty military" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	.

fibo-ind-ei-ei:Monthly
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:ExplicitRecurrenceInterval
		;
	rdfs:label "monthly" ;
	skos:definition "explicit recurrence interval of exactly one (1) month, regardless of the length in days of a given calendar month, but typically 30 days" ;
	cmns-dt:hasDurationValue "P1M" ;
	.

fibo-ind-ei-ei:OutputProducerPriceIndex
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:ProducerPriceIndex ;
	rdfs:label "output producer price index" ;
	skos:definition "economic indicator representing measure of the rate of change over time in the prices of products sold as they leave the producer" ;
	cmns-av:abbreviation "output PPI" ;
	cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
	.

fibo-ind-ei-ei:PersonalConsumptionExpenditures
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:EconomicIndicator ;
	rdfs:label "personal consumption expenditures" ;
	skos:definition "economic indicator representing measure of the value of the goods and services purchased by, or on the behalf of, 'persons'" ;
	cmns-av:abbreviation "PCE" ;
	cmns-av:adaptedFrom "https://www.bea.gov/data/consumer-spending/main"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Personal consumption expenditures consist of purchases of goods and services by households and by nonprofit institutions serving households (NPISHs). These goods and services include imputed expenditures on items such as the services of housing by a homeowner (the equivalent of rent), financial and insurance services for which there is no explicit charge, and medical care provided to individuals and financed by government or by private insurance." ;
	.

fibo-ind-ei-ei:PopulationNotInLaborForce
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
	rdfs:label "population not in the labor force" ;
	skos:definition "subset of the civilian, noninstitutional population, that is considered neither employed nor unemployed by the reporting agency during the reporting period" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	cmns-av:explanatoryNote "There are a number of distinctions with respect to how individuals are counted from country to country, including whether or not they are considered employed if they are on unpaid leave for some reason, and whether or not they are counted multiple times if they have more than one paying job." ;
	.

fibo-ind-ei-ei:ProducerPriceIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasInput ;
			owl:someValuesFrom fibo-ind-ei-ei:FixedBasket ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-ind-ei-ei:EnterprisePopulation
					fibo-ind-ei-ei:EstablishmentPopulation
					fibo-ind-ei-ei:FixedBasketPopulation
				) ;
			] ;
		]
		;
	rdfs:label "producer price index" ;
	skos:definition "economic indicator representing measure of the rate of change over time in the prices of goods and services bought and sold by producers" ;
	cmns-av:abbreviation "PPI" ;
	cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"Statistical agencies implement the Laspeyres index by putting it into price-relative (price change from the base period) and revenue-share (from the base period) format. In this form, the Laspeyres index can be written as the sum of base-period revenue shares of the items in the index times their corresponding price relatives. Statistical agency practice has introduced some approximations to the theoretical Laspeyres target due to a number of practical problems with producing the Laspeyres index exactly. For these and other pragmatic reasons, some agencies use alternatives depending on circumstances. See the IMF publication cited for a full explanation of the most commonly used approaches and trade-offs made for determining PPI." ,
		"The standard methodology for a typical PPI is based on a Laspeyres price index with fixed quantities from an earlier base period. The construction of this index can be thought of in terms of selecting a basket of goods and services representative of base-period revenues, valuing this at base-period prices, and then repricing the same basket at current-period prices. The target PPI in this case is defined to be the ratio of these two revenues. Practicing statisticians use this methodology because it has at least three practical advantages. It is easily explained to the public, it can use often expensive and untimely weighting information from the date of the last (or an even earlier) survey or administrative source (rather than requiring sources of data for the current month), and it need not be revised if users accept the Laspeyres premise."
		;
	.

fibo-ind-ei-ei:Productivity
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		cmns-qtu:Expression
		;
	rdfs:label "productivity" ;
	skos:definition "economic indicator representing ratio of a volume measure of output to a volume measure of input use" ;
	cmns-av:adaptedFrom
		"http://stats.oecd.org/glossary/detail.asp?ID=2167"^^xsd:anyURI ,
		"http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI
		;
	cmns-av:explanatoryNote "The primary objectives of productivity measurement include: (a) tracing technology change, i.e., the currently known ways of converting resources into outputs desired by the economy, (b) identifying changes in efficiency, (c) understanding real cost savings, (d) benchmarking production processes, and (e) assessing standards of living. Productivity measures may also be single factor or multifactor." ;
	.

fibo-ind-ei-ei:StatisticalInformationPublisher
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-pub:Publisher ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom cmns-org:FormalOrganization ;
		]
		;
	rdfs:label "statistical information publisher" ;
	skos:definition "publisher that packages and makes analytical and statistical data available" ;
	.

fibo-ind-ei-ei:UltimateConsumer
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:Consumer ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom fibo-fnd-aap-ppl:Person ;
		]
		;
	rdfs:label "ultimate consumer" ;
	skos:definition "person that is the ultimate user of a good, product or service" ;
	cmns-av:explanatoryNote
		"For the purposes of the CPI and related statistics, the definition of consumer is limited to humans. In general, a consumer could include a pet, as the consumer of pet food, for example, although the pet owner would likely be the purchaser and target of advertising." ,
		"The consumer is not always the purchaser of the product. Consumers are considered to be the users of the final product. For example, purchasers of building products are interim users of these products while constructing the finished product, which then may be purchased by the consumer."
		;
	cmns-av:synonym "consumer as defined by the Consumer Price Index (CPI)" ;
	.

fibo-ind-ei-ei:UnderemployedPopulation
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulation ;
	rdfs:label "underemployed population" ;
	skos:definition "subset of the employed population that includes persons employed part-time for economic reasons, who want and are available for full-time work but have had to settle for a part-time schedule" ;
	cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" ;
	.

fibo-ind-ei-ei:UnderemployedPopulationWithRespectToOccupation
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:UnderemployedPopulation ;
	rdfs:label "underemployed population with respect to occupation" ;
	skos:definition "subset of the underemployed population that includes persons employed in a role that does not reflect their training and experience, excluding those that change careers" ;
	.

fibo-ind-ei-ei:UnderutilizedPopulation
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
	rdfs:label "underutilized population" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:unionOf (
			fibo-ind-ei-ei:MarginallyAttachedPopulation
			fibo-ind-ei-ei:UnderemployedPopulation
			fibo-ind-ei-ei:UnemployedPopulation
		) ;
	] ;
	skos:definition "subset of the civilian non-institutional population that includes persons employed part-time for economic reasons, persons that are marginally attached to the labor force, and persons that are identified as unemployed" ;
	cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" ;
	.

fibo-ind-ei-ei:UnemployedPopulation
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:CivilianLaborForce ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasDurationOfUnemployment ;
			owl:someValuesFrom cmns-dt:Duration ;
		]
		;
	rdfs:label "unemployed population" ;
	skos:definition "subset of the civilian labor force that is considered to have had no employment but was available for work, except for temporary illness, and had made specific efforts to find employment sometime during a specified period, during the reporting period" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	cmns-av:explanatoryNote "Persons who were waiting to be recalled to a job from which they had been laid off need not have been looking for work to be classified as unemployed." ;
	.

fibo-ind-ei-ei:UnemploymentRate
	a
		owl:NamedIndividual ,
		owl:Class
		;
	rdfs:subClassOf
		fibo-ind-ei-ei:EconomicIndicator ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
			owl:someValuesFrom fibo-ind-ei-ei:CivilianLaborForce ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:hasComparisonPopulation ;
			owl:someValuesFrom fibo-ind-ei-ei:UnemployedPopulation ;
		]
		;
	rdfs:label "unemployment rate" ;
	rdfs:seeAlso <http://www.bls.gov/news.release/pdf/empsit.pdf> ;
	skos:definition "economic indicator representing the ratio of the unemployed population with respect to the civilian labor force of a given economy for some specified period" ;
	cmns-av:adaptedFrom "http://www.bls.gov/cps/faq.htm#Ques3"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Persons are classified as unemployed if they do not have a job, have actively looked for work in the prior 4 weeks, and are currently available for work. Workers expecting to be recalled from layoff are counted as unemployed, whether or not they have engaged in a specific jobseeking activity. In all other cases, the individual must have been engaged in at least one active job search activity in the 4 weeks preceding the interview and be available for work (except for temporary illness)." ;
	cmns-qtu:describesActualExpression "unemployed population ÷ civilian labor force" ;
	.

fibo-ind-ei-ei:ValueAddedProducerPriceIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:ProducerPriceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasInput ;
			owl:someValuesFrom fibo-ind-ei-ei:InputProducerPriceIndex ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasInput ;
			owl:someValuesFrom fibo-ind-ei-ei:OutputProducerPriceIndex ;
		]
		;
	rdfs:label "value-added producer price index" ;
	skos:definition "economic indicator representing a weighted average of the input and output producer price indices" ;
	cmns-av:abbreviation "value-added PPI" ;
	cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
	.

fibo-ind-ei-ei:Weekly
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:ExplicitRecurrenceInterval
		;
	rdfs:label "weekly" ;
	skos:definition "explicit recurrence interval of one week, or 7 days" ;
	cmns-dt:hasDurationValue "P7D" ;
	.

fibo-ind-ei-ei:excludesEnergyAndFood
	a owl:DatatypeProperty ;
	rdfs:label "excludes energy and food" ;
	rdfs:domain fibo-ind-ei-ei:ConsumerPriceIndex ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the calculation of the index includes energy and food prices or not" ;
	.

fibo-ind-ei-ei:hasBaselinePopulation
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:refersTo ;
	rdfs:label "has baseline population" ;
	rdfs:range fibo-fnd-utl-alx:StatisticalUniverse ;
	skos:definition "specifies the starting point statistical universe or population used for comparison or analysis" ;
	.

fibo-ind-ei-ei:hasComparisonPopulation
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-oc:hasInput ;
	rdfs:label "has comparison population" ;
	rdfs:range fibo-fnd-utl-alx:StatisticalUniverse ;
	skos:definition "specifies the subset of the baseline statistical universe or population used for comparison or analysis" ;
	.

fibo-ind-ei-ei:hasDurationOfUnemployment
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has duration of unemployment" ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "specifies the length of time, typically in weeks, that people classified as unemployed have been continuously looking for work" ;
	cmns-av:adaptedFrom <https://www.bls.gov/cps/definitions.htm> ;
	.

fibo-ind-ei-ei:hasIndicatorValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
	rdfs:label "has indicator value" ;
	rdfs:range cmns-qtu:ScalarQuantityValue ;
	skos:definition "specifies a quantity value for a given indicator" ;
	.

fibo-ind-ei-ei:hasSeriesOrigin
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasStartDate ;
	rdfs:label "has series origin" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "specifies the original starting date for the time series for a given economic indicator" ;
	.

fibo-ind-ei-ei:isSeasonallyAdjusted
	a owl:DatatypeProperty ;
	rdfs:label "is seasonally adjusted" ;
	rdfs:range xsd:boolean ;
	skos:definition "a predicate indicating whether some published formal method is applied that compensates for seasonal variations in the population or index value" ;
	cmns-av:explanatoryNote "Example explanation from the US Bureau of Labor Statistics: Because price data are used for different purposes by different groups, the Bureau of Labor Statistics publishes seasonally adjusted as well as unadjusted changes each month. ... Seasonal factors used in computing the seasonally adjusted indexes are derived by the X-13ARIMA-SEATS Seasonal Adjustment Method. Seasonally adjusted indexes and seasonal factors are computed annually. Each year, the last five years of seasonally adjusted data are revised." ;
	.

fibo-ind-ei-caei:CanadianConsumerPriceIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:ConsumerPriceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:hasPublisher ;
			owl:hasValue fibo-ind-ei-caei:CanadianStatisticsPublisher ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:isPublishedBy ;
			owl:hasValue fibo-ind-ei-caei:StatisticsCanada ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:onClass fibo-ind-ei-caei:CanadianHouseholdsConsumersUniverse ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-ind-ei-caei:CanadianHouseholdsConsumersUniverse ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-ind-ei-ei:FixedBasket ;
		]
		;
	rdfs:label "Canadian consumer price index" ;
	skos:definition "economic indicator representing a measure of changes over time in the prices of a fixed basket of consumer goods and services that Canadian private households consume" ;
	cmns-av:abbreviation "CPI" ;
	cmns-av:adaptedFrom
		"http://www.statcan.gc.ca/eng/start"^^xsd:anyURI ,
		"https://www.statcan.gc.ca/en/subjects-start/prices_and_price_indexes/consumer_price_indexes"^^xsd:anyURI
		;
	.

fibo-ind-ei-caei:CanadianHouseholdsConsumersUniverse
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:playsRole ;
				owl:someValuesFrom fibo-ind-ei-ei:UltimateConsumer ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom fibo-ind-ei-ei:Household ;
		]
		;
	rdfs:label "Canadian households consumers universe" ;
	skos:definition "a statistical universe consisting of all private households in Canada, with the exception of soldiers on military bases, people living on First Nations reserves, institutionalized persons, and households living in the rural areas of the three northern territories" ;
	cmns-av:adaptedFrom "http://www.statcan.gc.ca/pub/62-553-x/62-553-x2015001-eng.pdf" ;
	.

fibo-ind-ei-caei:CanadianProducerPriceIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:ProducerPriceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:hasPublisher ;
			owl:hasValue fibo-ind-ei-caei:CanadianStatisticsPublisher ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:isPublishedBy ;
			owl:hasValue fibo-ind-ei-caei:StatisticsCanada ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-ind-ei-caei:IndustrialProductsSector
					fibo-ind-ei-caei:NewHousingSector
					fibo-ind-ei-caei:RawMaterialsSector
				) ;
			] ;
		]
		;
	rdfs:label "Canadian producer price index" ;
	skos:definition "an economic indicator representing a measure of the change over time in the prices of a fixed-basket of domestic producer goods and services" ;
	cmns-av:adaptedFrom "http://www23.statcan.gc.ca/imdb-bmdi/pub/indexth-eng.htm"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Note that Canada does not produce a high level, cross industry PPI per se. Canadian PPIs are published by industry sector. Three of the most important are captured in the union defined herein, which may be expanded over time to integrate others, as needed." ;
	.

fibo-ind-ei-caei:CanadianStatisticsPublisher
	a
		owl:NamedIndividual ,
		fibo-ind-ei-ei:StatisticalInformationPublisher
		;
	rdfs:label "Canadian statistics publisher" ;
	skos:definition "individual representing the functional entity that is the primary publisher of statistical information for the Canadian Government" ;
	cmns-av:adaptedFrom "http://www.statcan.gc.ca/eng/about/mandate/"^^xsd:anyURI ;
	cmns-rlcmp:isPlayedBy fibo-ind-ei-caei:StatisticsCanada ;
	.

fibo-ind-ei-caei:IndustrialProductsSector
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-cls:IndustrySectorClassifier ;
	rdfs:label "industrial products sector" ;
	skos:definition "a classifier for a sector of the economy used for price indices focused on major commodities sold by manufacturers in Canada" ;
	cmns-av:adaptedFrom "http://www23.statcan.gc.ca/imdb/p2SV.pl?Function=getSurvey&SDDS=2318"^^xsd:anyURI ;
	.

fibo-ind-ei-caei:NewHousingSector
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-cls:IndustrySectorClassifier ;
	rdfs:label "new housing sector" ;
	skos:definition "a classifier for a sector of the economy used for price indices focused on contractors' selling prices of new residential houses, where detailed specifications pertaining to each house remain the same between two consecutive periods" ;
	cmns-av:adaptedFrom "http://www23.statcan.gc.ca/imdb/p2SV.pl?Function=getSurvey&SDDS=2310"^^xsd:anyURI ;
	.

fibo-ind-ei-caei:RawMaterialsSector
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-cls:IndustrySectorClassifier ;
	rdfs:label "raw materials sector" ;
	skos:definition "a classifier used for price indices related to raw materials purchased by industries in Canada for further processing" ;
	cmns-av:adaptedFrom "http://www23.statcan.gc.ca/imdb/p2SV.pl?Function=getSurvey&SDDS=2306"^^xsd:anyURI ;
	.

fibo-ind-ei-caei:StatisticsCanada
	a
		owl:NamedIndividual ,
		fibo-be-ge-ge:GovernmentAgency
		;
	rdfs:label
		"Statistics Canada"@en ,
		"Statistique Canada"@fr
		;
	skos:definition "individual representing Statistics Canada, a government agency mandated to collect, compile, analyse, abstract and publish statistical information relating to the commercial, industrial, financial, social, economic and general activities and condition of the people of Canada" ;
	cmns-av:abbreviation "StatCan" ;
	cmns-av:adaptedFrom "http://www.statcan.gc.ca/eng/about/mandate"^^xsd:anyURI ;
	cmns-col:isPartOf fibo-be-ge-caj:GovernmentOfCanada ;
	cmns-loc:hasCoverageArea lcc-3166-1:Canada ;
	.

fibo-ind-ei-usei:AmericanStatisticsPublisher
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ei-ei:StatisticalInformationPublisher ;
	rdfs:label "American statistics publisher" ;
	skos:definition "statistical information publisher comprised of the government agencies and departments that publish statistical information on behalf of the U.S. Federal Government" ;
	skos:example "Examples of American statistical information publishers include the Department of Commerce, Bureau of Economic Analysis (Commerce), Census Bureau (Commerce), Bureau of Labor Statistics (Labor), Department of the Treasury, and the Federal Reserve Board, among others." ;
	.

fibo-ind-ei-usei:BureauOfLaborStatistics
	a
		owl:NamedIndividual ,
		fibo-be-ge-ge:GovernmentAgency
		;
	rdfs:label "Bureau of Labor Statistics" ;
	rdfs:seeAlso <http://www.bls.gov/> ;
	skos:definition "the Bureau of Labor Statistics, the principal Federal agency responsible for measuring labor market activity, working conditions, and price changes in the economy" ;
	cmns-av:abbreviation "BLS" ;
	cmns-av:adaptedFrom "http://www.bls.gov/bls/infohome.htm"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Its mission is to collect, analyze, and disseminate essential economic information to support public and private decision-making. As an independent statistical agency, BLS serves its diverse user communities by providing products and services that are objective, timely, accurate, and relevant." ;
	cmns-col:isPartOf fibo-ind-ei-usei:UnitedStatesDepartmentOfLabor ;
	cmns-loc:hasCoverageArea lcc-3166-1:UnitedStatesOfAmerica ;
	.

fibo-ind-ei-usei:ConsumerExpenditureSurvey
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-utl-alx:StatisticalProgram ;
	rdfs:label "consumer expenditure survey" ;
	skos:definition "statistical program conducted on a regular basis that provides information on the buying habits of consumers, including data on their expenditures, income, and consumer unit (families and single consumers) characteristics" ;
	cmns-av:adaptedFrom <http://www.bls.gov/cex/> ;
	.

fibo-ind-ei-usei:CurrentEmploymentStatistics
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-utl-alx:StatisticalProgram ;
	rdfs:label "current employment statistics" ;
	skos:definition "survey conducted on a regular basis that presents analytical information related to businesses and government agencies, in order to provide detailed industry data on employment, hours, and earnings of workers" ;
	cmns-av:adaptedFrom <http://www.bls.gov/ces/> ;
	.

fibo-ind-ei-usei:CurrentPopulationSurvey
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:StatisticalProgram ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
		]
		;
	rdfs:label "current population survey" ;
	skos:definition "survey conducted on a regular basis that presents analytical information related to the general population of a given statistical area with respect to labor force, employment, unemployment, persons not in the labor force, hours of work, earnings, and other demographic and labor force characteristics" ;
	cmns-av:adaptedFrom <http://www.bls.gov/cps/> ;
	.

fibo-ind-ei-usei:EmploymentSituationEstablishmentSurvey
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-usei:EmploymentSituationSurvey ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom fibo-ind-ei-ei:Establishment ;
		]
		;
	rdfs:label "employment situation establishment survey" ;
	rdfs:seeAlso <https://www.bls.gov/news.release/empsit.tn.htm> ;
	skos:definition "survey conducted on a regular basis that presents analytical information related to the labor force of a given statistical area, surveyed with respect to businesses, and is, for the most part, seasonally adjusted" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	.

fibo-ind-ei-usei:EmploymentSituationHouseholdSurvey
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-usei:EmploymentSituationSurvey ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom fibo-ind-ei-ei:Household ;
		]
		;
	rdfs:label "employment situation household survey" ;
	rdfs:seeAlso <https://www.bls.gov/news.release/empsit.tn.htm> ;
	skos:definition "a survey conducted on a regular basis that presents analytical information related to the labor force of a given statistical area, surveyed with respect to households, and is, for the most part, seasonally adjusted" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
	.

fibo-ind-ei-usei:EmploymentSituationSurvey
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-usei:CurrentEmploymentStatistics ,
		fibo-ind-ei-usei:CurrentPopulationSurvey ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ei-ei:isSeasonallyAdjusted ;
			owl:onDataRange xsd:boolean ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "employment situation survey" ;
	skos:definition "a survey conducted on a regular basis that presents analytical information focused on the employment characteristics of a given statistical area" ;
	cmns-av:adaptedFrom <http://www.bls.gov/opub/reports/about.htm> ;
	.

fibo-ind-ei-usei:PointOfPurchaseSurvey
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-utl-alx:StatisticalProgram ;
	rdfs:label "point of purchase survey" ;
	skos:definition "a program conducted on a regular basis that provides information on purchases of various items and services by consumers" ;
	cmns-av:adaptedFrom <http://www.bls.gov/respondents/cpi/tpops/> ;
	.

fibo-ind-ei-usei:USProducerPriceIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:ProducerPriceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:isPublishedBy ;
			owl:hasValue fibo-ind-ei-usei:BureauOfLaborStatistics ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:hasPublisher ;
			owl:someValuesFrom fibo-ind-ei-usei:AmericanStatisticsPublisher ;
		]
		;
	rdfs:label "U.S. producer price index" ;
	skos:definition "an economic indicator representing a measure of the change over time in the selling prices received by domestic producers for their output" ;
	cmns-av:adaptedFrom "http://www.bls.gov/ppi/"^^xsd:anyURI ;
	.

fibo-ind-ei-usei:UnitedStatesDepartmentOfLabor
	a
		owl:NamedIndividual ,
		fibo-be-ge-ge:GovernmentDepartment
		;
	rdfs:label "United States Department of Labor" ;
	rdfs:seeAlso <https://www.dol.gov/> ;
	skos:definition "individual representing the U.S. Department of Labor, a government department whose mission is to foster, promote, and develop the welfare of the wage earners, job seekers, and retirees of the United States; improve working conditions; advance opportunities for profitable employment; and assure work-related benefits and rights" ;
	cmns-av:abbreviation "DOL" ;
	cmns-av:adaptedFrom "https://www.dol.gov/general/aboutdol"^^xsd:anyURI ;
	cmns-col:isPartOf fibo-be-ge-usj:UnitedStatesGovernment ;
	cmns-loc:hasCoverageArea lcc-3166-1:UnitedStatesOfAmerica ;
	cmns-rga:hasJurisdiction fibo-be-ge-usj:UnitedStatesJurisdiction ;
	.

fibo-ind-ei-usei:UrbanConsumerPriceIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:ConsumerPriceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:isPublishedBy ;
			owl:hasValue fibo-ind-ei-usei:BureauOfLaborStatistics ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:onClass fibo-ind-ei-usei:UrbanConsumersUniverse ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:hasPublisher ;
			owl:someValuesFrom fibo-ind-ei-usei:AmericanStatisticsPublisher ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-ind-ei-usei:UrbanConsumersUniverse ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Basket ;
		]
		;
	rdfs:label "urban consumer price index" ;
	skos:definition "an economic indicator representing a measure of the average change over time in the prices paid by urban consumers for a market basket of consumer goods and services" ;
	cmns-av:abbreviation "CPI-U" ;
	cmns-av:adaptedFrom "http://www.bls.gov/cpi/"^^xsd:anyURI ;
	.

fibo-ind-ei-usei:UrbanConsumersUniverse
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:playsRole ;
				owl:someValuesFrom fibo-ind-ei-ei:UltimateConsumer ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom fibo-ind-ei-usei:ConsumerExpenditureSurvey ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom fibo-ind-ei-usei:PointOfPurchaseSurvey ;
		]
		;
	rdfs:label "urban consumers universe" ;
	skos:definition "a statistical universe for consumer expenditure surveys consisting of people within a household that make joint expenditure decisions" ;
	cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics, http://www.bls.gov/cpi/" ;
	cmns-av:explanatoryNote "In the United States, the CPI-U population, which covers about 88 percent of the U.S. population, covers households in all areas of the United States except people living in rural nonmetropolitan areas, in farm households, on military installations, in religious communities, and in institutions such as prisons and mental hospitals." ;
	.

fibo-ind-fx-fx:CurrencyConversionService
	a owl:Class ;
	rdfs:subClassOf fibo-ind-fx-fx:ForeignExchangeService ;
	rdfs:label "currency conversion service" ;
	skos:definition "foreign exchange service involving the conversion of currency of one country or group of countries for another, typically, but not always, as a counter transaction" ;
	cmns-av:explanatoryNote "A currency exchange service may be provided by a stand-alone business or may be part of the services offered by a bank or other financial institution. The currency exchange profits from its services either through adjusting the exchange rate or taking a commission." ;
	.

fibo-ind-fx-fx:CurrencyForwardRate
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-fx-fx:QuotedExchangeRate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:hasSettlementDate ;
			owl:allValuesFrom cmns-dt:Date ;
		]
		;
	rdfs:label "currency forward rate" ;
	skos:definition "rate of exchange between two currencies for settlement at some future point in time, expressed as a premium on the spot rate" ;
	.

fibo-ind-fx-fx:CurrencyForwardRateVolatility
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-fx-fx:ExchangeRateVolatility ,
		fibo-ind-ind-ind:ImpliedVolatility ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ind-ind:isVolatilityOf ;
			owl:allValuesFrom fibo-ind-fx-fx:CurrencyForwardRate ;
		]
		;
	rdfs:label "currency forward rate volatility" ;
	skos:definition "measure of exchange rate fluctuation based on a range of projected values for exchange rates" ;
	.

fibo-ind-fx-fx:CurrencySpotBuyRate
	a owl:Class ;
	rdfs:subClassOf fibo-ind-fx-fx:CurrencySpotRate ;
	rdfs:label "currency spot buy rate" ;
	skos:definition "indicative spot buying market rate as observed by the reporting source" ;
	.

fibo-ind-fx-fx:CurrencySpotMidRate
	a owl:Class ;
	rdfs:subClassOf fibo-ind-fx-fx:CurrencySpotRate ;
	rdfs:label "currency spot mid rate" ;
	skos:definition "indicative middle market (mean of spot buying and selling) rate as observed by the reporting source" ;
	.

fibo-ind-fx-fx:CurrencySpotRate
	a owl:Class ;
	rdfs:subClassOf fibo-ind-fx-fx:QuotedExchangeRate ;
	rdfs:label "currency spot rate" ;
	skos:definition "rate at which one currency may be exchanged for another for immediate delivery" ;
	cmns-av:explanatoryNote "Spot rates represent the prices buyers pay in one currency to purchase a second currency. Although the spot exchange rate is for delivery on the earliest value date, the standard settlement date for most spot transactions is two business days after the transaction date." ;
	.

fibo-ind-fx-fx:CurrencySpotSellRate
	a owl:Class ;
	rdfs:subClassOf fibo-ind-fx-fx:CurrencySpotRate ;
	rdfs:label "currency spot sell rate" ;
	skos:definition "indicative spot selling market rate as observed by the reporting source" ;
	.

fibo-ind-fx-fx:CurrencySpotVolatility
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-fx-fx:ExchangeRateVolatility ,
		fibo-ind-ind-ind:HistoricalVolatility ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ind-ind:isVolatilityOf ;
			owl:allValuesFrom fibo-ind-fx-fx:CurrencySpotRate ;
		]
		;
	rdfs:label "currency spot volatility" ;
	skos:definition "measure of exchange rate fluctuation based on a range of past actual values for exchange rates" ;
	.

fibo-ind-fx-fx:ExchangeRateStructure
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-acc-cur:ExchangeRate ;
		]
		;
	rdfs:label "exchange rate structure" ;
	skos:definition "structured collection of quoted or projected exchange rates, such that volatility may be constructed for the structure" ;
	.

fibo-ind-fx-fx:ExchangeRateVolatility
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ind-ind:Volatility ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-ind-fx-fx:ExchangeRateStructure ;
		]
		;
	rdfs:label "exchange rate volatility" ;
	skos:definition "statistical measure of the rate of change in the rate at which one currency can be exchanged for another" ;
	cmns-av:usageNote "Volatility is modeled here using a structured collection, comprised of a series of individual exchange rates (either projected or prior quoted rates), dates, and the source for those rates for some overall period of time" ;
	.

fibo-ind-fx-fx:ForeignExchangeService
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-fpas:FinancialService ;
	rdfs:label "foreign exchange service" ;
	skos:definition "financial service involving the exchange of one currency for another, conversion of one currency for another, and transfer of money from one country to another whereby currency conversion is required" ;
	.

fibo-ind-fx-fx:InternationalElectronicFundsTransferService
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-fse:ElectronicFundsTransferService ,
		fibo-ind-fx-fx:ForeignExchangeService
		;
	rdfs:label "international electronic funds transfer service" ;
	skos:definition "electronic funds transfer (EFT) service involving the transfer of funds across national borders, that may also involve currency conversion" ;
	cmns-av:synonym "international wire transfer" ;
	.

fibo-ind-fx-fx:QuotedExchangeRate
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:ExchangeRate ,
		fibo-ind-ind-ind:MarketRate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-fx-fx:hasQuoteCurrency ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-fx-fx:hasExchangeRateQuotationSource ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-be-fct-pub:Publisher
					fibo-fbc-fct-mkt:Exchange
					fibo-fbc-pas-fpas:FinancialServiceProvider
				) ;
			] ;
		]
		;
	rdfs:label "quoted exchange rate" ;
	skos:definition "exchange rate quoted at a specific point in time, for a given block amount of currency as quoted against another (base) currency" ;
	cmns-av:explanatoryNote "An exchange rate of R represents a rate of R units of the quoted currency to 1 unit of the base currency." ;
	.

fibo-ind-fx-fx:hasExchangeRateQuotationSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:refersTo ;
	rdfs:label "has exchange rate quotation source"@en ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			fibo-be-fct-pub:Publisher
			fibo-fbc-fct-mkt:Exchange
			fibo-fbc-pas-fpas:FinancialServiceProvider
		) ;
	] ;
	skos:definition "indicates the origin of a quoted exchange rate"@en ;
	.

fibo-ind-fx-fx:hasQuotationBlockAmountBasis
	a owl:ObjectProperty ;
	rdfs:label "has quotation block amount basis" ;
	rdfs:domain fibo-ind-fx-fx:QuotedExchangeRate ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the amount of the dealt currency which would be exchanged in a trade for which the stated spot rate applies" ;
	.

fibo-ind-fx-fx:hasQuotationSettlementBasis
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has quotation settlement basis" ;
	rdfs:domain fibo-ind-fx-fx:QuotedExchangeRate ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "indicates the settlement period for a trade for which the stated spot rate applies" ;
	.

fibo-ind-fx-fx:hasQuoteCurrency
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasDealtCurrency ;
	rdfs:label "has quote currency" ;
	rdfs:range fibo-fnd-acc-cur:Currency ;
	skos:definition "indicates the quote currency in an exchange rate; R units of this currency represent one unit of the base currency" ;
	.

fibo-ind-fx-fx:hasQuotedExchangeRate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
	rdfs:label "has quoted exchange rate"@en ;
	rdfs:range fibo-ind-fx-fx:QuotedExchangeRate ;
	skos:definition "rate of exchange between two currencies as specified as of some date and time as quoted by a specific source"@en ;
	.

fibo-ind-fx-fx:isPremiumOn
	a owl:ObjectProperty ;
	rdfs:label "is premium on" ;
	rdfs:domain fibo-ind-fx-fx:CurrencyForwardRate ;
	rdfs:range fibo-ind-fx-fx:QuotedExchangeRate ;
	skos:definition "an exchange rate expressed as a premium on the spot rate for the currency pair" ;
	.

fibo-ind-ind-ind:DailyAverageMarketRate
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ind-ind:MarketRate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ind-ind:hasQuotationDateTime ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "daily average market rate" ;
	skos:definition "overall level of a given rate, calculated as the sum of some selected observed values of the rates for a particular reference rate, foreign exchange rate, lending rate, or other market rate divided by the number of samples collected over the course of a twenty-four (24) hour period for a specific date" ;
	cmns-av:adaptedFrom "http://www.investopedia.com/terms/m/marketaverage.asp"^^xsd:anyURI ;
	.

fibo-ind-ind-ind:EndOfDayMarketRate
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ind-ind:MarketRate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ind-ind:hasQuotationDateTime ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "end-of-day market rate" ;
	skos:definition "value of a given market rate of the end of the business day for a specific date" ;
	.

fibo-ind-ind-ind:HistoricalPriceVolatility
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ind-ind:HistoricalVolatility ,
		fibo-ind-ind-ind:PriceVolatility
		;
	rdfs:label "historical price volatility" ;
	skos:definition "historical volatility measure of past trading ranges of prices of underlying securities and indexes" ;
	cmns-av:explanatoryNote "Calculations for historical volatility are generally based on the change from one closing price to the next." ;
	.

fibo-ind-ind-ind:HistoricalVolatility
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ind-ind:Volatility ;
	rdfs:label "historical volatility" ;
	skos:definition "measure of volatility that uses actual values for pricing, rates, and other measurements calculated over some prior period" ;
	cmns-av:synonym "realized volatility" ;
	.

fibo-ind-ind-ind:ImpliedPriceVolatility
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ind-ind:ImpliedVolatility ,
		fibo-ind-ind-ind:PriceVolatility
		;
	rdfs:label "implied price volatility" ;
	skos:definition "measure of volatility that represents the expected fluctuations of an underlying stock or index over a specific time frame" ;
	.

fibo-ind-ind-ind:ImpliedVolatility
	a owl:Class ;
	rdfs:subClassOf fibo-ind-ind-ind:Volatility ;
	rdfs:label "implied volatility" ;
	skos:definition "measure of volatility that is a forward-looking metric used to calculate probability" ;
	cmns-av:synonym "projected volatility" ;
	.

fibo-ind-ind-ind:MarketRate
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:Ratio ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:isValueOf ;
			owl:onClass fibo-fnd-utl-alx:ScopedMeasure ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ind-ind:hasQuotationDateTime ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasRateValue ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "market rate" ;
	skos:definition "value of a rate established in the marketplace for a set of instruments or that describes the economic climate for an industry and/or political region (e.g., SOFR, Prime)" ;
	skos:example "Financial market rates include, but are not limited to reference rates, foreign exchange rates, lending rates, bankers' acceptance rates, and so forth." ;
	skos:scopeNote
		"""Market rates include but may not be limited to the following:
	(1) Index: Statistical composite that measures changes in the economy or in financial markets, often expressed in percentage changes from a base year or from the previous month
	(2) Money Rate: Benchmark or guideline for interest rates determined by central banks or economical climate as a whole
	(3) Bankers' Acceptance Rate: Benchmark reflecting market fluctuations of Bankers' Acceptance issued instruments
	(4) Commercial Paper Rate: Benchmark reflecting market fluctuations of Commercial Paper issued instruments
	(5) Certificate of Deposit Rate: Benchmark reflecting market fluctuations of Certificate of Deposit issued instruments
	(6) Interbank Rate
	(7) Prime
	(8) Time Deposit Rate: Benchmark reflecting market fluctuations of Deposit/Redeposit issued instruments""" ,
		"known collectively (in the CFI Standard) as referential instruments"
		;
	.

fibo-ind-ind-ind:MarketSpread
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:ScopedMeasure ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:onClass fibo-ind-ind-ind:MarketRate ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "market spread" ;
	skos:definition "statistical measure providing the difference (or spread) between two market rates" ;
	.

fibo-ind-ind-ind:PriceStructure
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryPrice ;
		]
		;
	rdfs:label "price structure" ;
	skos:definition "structured collection of prices, such as market prices for some index or security, such that volatility or other analyses may be performed over the structure" ;
	cmns-av:explanatoryNote "Historical prices are needed not only for various statistical analyses but for determining best prices for certain kinds of options, for example. Note that prices may be quoted or calculated." ;
	cmns-av:synonym "price history" ;
	.

fibo-ind-ind-ind:PriceVolatility
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-ind-ind:Volatility ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-ind-ind-ind:PriceStructure ;
		]
		;
	rdfs:label "price volatility" ;
	skos:definition "statistical measure of the rate of change in pricing for a given security or market index" ;
	skos:editorialNote "Volatility is modeled here using a structured collection, comprised of a series of individual prices of something (a security, index, etc., typically quoted prices), dates, and the source for those prices for some overall period of time" ;
	cmns-av:explanatoryNote "Volatility can be determined using the standard deviation or variance among prices for the security or market index over some period of time. For a specific security, volatility may measure the amount and frequency in rapid price fluctuation. It is computed as the annualized standard deviation of the percentage change in a security's daily price." ;
	.

fibo-ind-ind-ind:QuotedPrice
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:MonetaryPrice ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-ind-ind:hasQuotationDateTime ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "quoted price" ;
	skos:definition "a monetary price quoted by some publisher on a given date" ;
	.

fibo-ind-ind-ind:TermStructure
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-ind-ind-ind:MarketRate ;
		]
		;
	rdfs:label "term structure" ;
	skos:definition "structured collection of rates, such as interest rates, or bond yields with different terms to maturity, such that a yield curve may be constructed for the structure" ;
	cmns-av:explanatoryNote "Term structure refers to a set of discrete points; elements are ordered by time. Restrictions on the rate (see above) and a point in time, paired together, and then ordered in a structured collection is how this should ultimately be modeled. Then the concept of yield curve would be a child of term structure, for calculation of net present value, for example. Term structures consist of two or more observed or projected values, typically related to debt instruments or interest rates. assessment of monetary policy conditions, and so forth." ;
	.

fibo-ind-ind-ind:Volatility
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:Dispersion ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-utl-alx:StandardDeviation
				fibo-fnd-utl-alx:Variance
			) ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:someValuesFrom cmns-dt:DatePeriod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fnd-dt-fd:DatedStructuredCollection ;
		]
		;
	rdfs:label "volatility" ;
	skos:definition "statistical measure of the dispersion around the average of some random variable over some period of time" ;
	.

fibo-ind-ind-ind:hasQuotationDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has quotation date" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "indicates the quotation date for a given market rate or indicator" ;
	cmns-av:explanatoryNote "Typically this property reflects a daily average or end of day quote." ;
	cmns-av:usageNote "Note that this property requires a reified date value, if used." ;
	.

fibo-ind-ind-ind:hasQuotationDateTime
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dt:hasObservedDateTime ;
	rdfs:label "has quotation date and time" ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "indicates a quotation date and possibly a time for a given market rate, interest rate, indicator, or other quoted pricing information" ;
	.

fibo-ind-ind-ind:isVolatilityOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cxtdsg:appliesTo ;
	rdfs:label "is volatility of" ;
	rdfs:domain fibo-ind-ind-ind:Volatility ;
	skos:definition "indicates something to which the volatility measure applies and of which it is a measure" ;
	.

