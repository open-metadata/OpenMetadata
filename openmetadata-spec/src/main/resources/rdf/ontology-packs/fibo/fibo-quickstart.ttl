fibo-fbc-fct-mkt:MarketIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fbc-fct-mkt:CryptoAssetServicesProvider
					fibo-fbc-fct-mkt:DataReportingServicesProvider
					fibo-fbc-fct-mkt:Exchange
					fibo-fbc-fct-mkt:TradeReportingFacility
				) ;
			] ;
		]
		;
	rdfs:label "market identifier" ;
	skos:definition "identifier that specifies a universal method of identifying exchanges, trading platforms, regulated or non-regulated markets, and data reporting services providers as sources of prices and related information in order to facilitate automated processing" ;
	cmns-av:abbreviation "MIC" ;
	cmns-av:adaptedFrom
		"ISO 10383, Securities and related financial instruments - Codes for exchanges and market identification (MIC), Third edition, 2012-10-01" ,
		"https://www.iso20022.org/market-identifier-codes"^^xsd:anyURI ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"^^xsd:anyURI
		;
	cmns-av:explanatoryNote """It is intended for use in any application and communication for identification of places
- where a financial instrument is listed (place of official listing),
- where a related trade is executed (place of trade), and
- where trade details are reported (trade reporting facility).""" ;
	cmns-av:synonym "Market Identifier Code" ;
	.

fibo-fbc-fct-mkt:MarketIdentifierCodeStatus
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-lif:LifecycleStage ;
	rdfs:label "market indicator code status" ;
	skos:definition "lifecycle stage indicating the status of the MIC code, as specified by the registration authority" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/market-identifier-codes"^^xsd:anyURI ;
	.

fibo-fbc-fct-mkt:MarketLevelClassifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:hasValue fibo-fbc-fct-mkt:ISO10383-ClassificationScheme ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fbc-fct-mkt:CryptoAssetServicesProvider
					fibo-fbc-fct-mkt:DataReportingServicesProvider
					fibo-fbc-fct-mkt:Exchange
					fibo-fbc-fct-mkt:TradeReportingFacility
				) ;
			] ;
		]
		;
	rdfs:label "market level classifier" ;
	skos:definition "classifier that indicates whether the exchange or data reporting services provider is an operating level or market segment level facility" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ;
	.

fibo-fbc-fct-mkt:MarketLevelClassifier-OPRT
	a
		owl:NamedIndividual ,
		fibo-fbc-fct-mkt:MarketLevelClassifier
		;
	rdfs:label "market-level classifier - OPRT" ;
	skos:definition "market-level classifier for an operating-level facility" ;
	fibo-fnd-rel-rel:hasTag "OPRT" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ;
	.

fibo-fbc-fct-mkt:MarketLevelClassifier-SGMT
	a
		owl:NamedIndividual ,
		fibo-fbc-fct-mkt:MarketLevelClassifier
		;
	rdfs:label "market-level classifier - SGMT" ;
	skos:definition "market-level classifier for a segment-level facility" ;
	fibo-fnd-rel-rel:hasTag "SGMT" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ;
	.

fibo-fbc-fct-mkt:MarketSegmentLevelMarket
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:Exchange ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketLevelClassifier-SGMT ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isPartOf ;
			owl:someValuesFrom fibo-fbc-fct-mkt:OperatingLevelMarket ;
		]
		;
	rdfs:label "market segment-level market" ;
	skos:definition "section of an exchange/market/trade reporting facility that specialises in one or more specific instruments or that is regulated differently" ;
	skos:example "Dark pool" ;
	skos:note
		"A market segment MIC can only be registered if an operating/exchange MIC already exists." ,
		"It is not required to have a MIC registered for all segments of a market, only for those segments that need to be identified."
		;
	cmns-av:adaptedFrom
		"ISO 10383, Securities and related financial instruments - Codes for exchanges and market identification (MIC), Third edition, 2012-10-01, confirmed 2018-03-29, clause 2.2" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	.

fibo-fbc-fct-mkt:MarketSegmentLevelMarketIdentifier
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-mkt:MarketIdentifier ;
	rdfs:label "market segment-level market identifier" ;
	skos:definition "market identifier that identifies a section of an exchange/market/trade reporting facility that specialises in one or more specific instruments or that is regulated differently" ;
	cmns-av:adaptedFrom
		"ISO 10383, Securities and related financial instruments - Codes for exchanges and market identification (MIC), Third edition, 2012-10-01, confirmed 2018-03-29, clause 2.2" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	.

fibo-fbc-fct-mkt:MultilateralTradingFacility
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:AlternativeTradingSystem ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketCategoryClassifier-MLTF ;
		]
		;
	rdfs:label "multilateral trading facility" ;
	skos:definition "trading system that facilitates the exchange of financial instruments between multiple parties" ;
	cmns-av:abbreviation "MTF" ;
	cmns-av:adaptedFrom
		"http://www.investopedia.com/terms/m/multilateral_trading_facility.asp" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	cmns-av:explanatoryNote "Multilateral trading facilities allow eligible contract participants to gather and transfer a variety of securities, especially instruments that may not have an official market. These facilities are often electronic systems controlled by approved market operators or larger investment banks. Traders will usually submit orders electronically, where a matching software engine is used to pair buyers with sellers." ;
	.

fibo-fbc-fct-mkt:OffMarketFacility
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-mkt:Exchange ;
	rdfs:label "off-market facility" ;
	skos:definition "facility used for reporting over-the-counter (OTC) and other direct trades that are not executed by the exchange but are reported through the exchange" ;
	cmns-av:synonym
		"off-book" ,
		"off-facility"
		;
	.

fibo-fbc-fct-mkt:OperatingLevelMarket
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:Exchange ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketLevelClassifier-OPRT ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fbc-fct-mkt:OperatingLevelMarketIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "operating-level market" ;
	skos:definition "exchange/market/trade reporting facility in a specific market/country" ;
	cmns-av:adaptedFrom
		"ISO 10383, Securities and related financial instruments - Codes for exchanges and market identification (MIC), Third edition, 2012-10-01, confirmed 2018-03-29, clause 2.1" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	.

fibo-fbc-fct-mkt:OperatingLevelMarketIdentifier
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-mkt:MarketIdentifier ;
	rdfs:label "operating-level market identifier" ;
	skos:definition "market identifier that identifies an exchange/market/trade reporting facility in a specific market/country" ;
	cmns-av:adaptedFrom
		"ISO 10383, Securities and related financial instruments - Codes for exchanges and market identification (MIC), Third edition, 2012-10-01, confirmed 2018-03-29, clause 2.1" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	.

fibo-fbc-fct-mkt:OrganizedTradingFacility
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:AlternativeTradingSystem ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isManagedBy ;
			owl:allValuesFrom fibo-fbc-pas-fpas:FinancialServiceProvider ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketCategoryClassifier-OTFS ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label
		"organised trading facility"@en-GB ,
		"organized trading facility"@en-US
		;
	rdfs:seeAlso <https://www.financierworldwide.com/organised-trading-facilities-how-they-differ-from-mtfs> ;
	skos:definition "multi-lateral system which is not an RM or an MTF and in which multiple third-party buying and selling interests in bonds, structured finance products, emission allowances or derivatives are able to interact in the system in a way that results in a contract in accordance with the provisions of Title II of MiFID II" ;
	cmns-av:abbreviation "OTF" ;
	cmns-av:adaptedFrom
		"http://www.marketswiki.com/mwiki/Organized_Trading_Facility" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	cmns-av:explanatoryNote
		"""OTFs were introduced by the European Commission as part of MiFID II and are focused on non-equities such as derivatives and cash bond markets.

OTFs are intended to be similar in scope to a swap execution facility (SEF), a type of entity created by the Dodd-Frank Act in the U.S. The goal of SEFs and OTFs is to bring transparency and structure to OTC derivatives trading.""" ,
		"Unlike RMs and MTFs, operators of OTFs will have discretion as to how to execute orders, subject to pre-transparency and best execution obligations."
		;
	.

fibo-fbc-fct-mkt:QuoteDrivenMarket
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-mkt:Exchange ;
	rdfs:label "quote-driven market" ;
	skos:definition "exchange in which prices are determined from bid and ask quotations made by market makers, dealers, or specialists" ;
	cmns-av:explanatoryNote "In a quote-driven market, dealers fill orders from their own inventory or by matching them with other orders. Note that this differs from a typical market, which is order-driven rather than quote-driven." ;
	cmns-av:synonym "price-driven market" ;
	.

fibo-fbc-fct-mkt:RecognizedMarketOperator
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:Exchange ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketCategoryClassifier-RMOS ;
		]
		;
	rdfs:label
		"recognised market operator"@en-GB ,
		"recognized market operator"@en-US
		;
	skos:definition "exchange that is operated or maintained by an operator registered under certain securities regulations that brings together purchasers and sellers of capital market products" ;
	cmns-av:abbreviation "RMO" ;
	cmns-av:adaptedFrom
		"https://www.igi-global.com/dictionary/regulating-fintech-businesses/77383" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ,
		"https://www.lawinsider.com/dictionary/recognized-market" ,
		"https://www.mas.gov.sg/regulation/capital-markets/approved-exchange-ae-or-recognised-market-operator-rmo-licence"
		;
	.

fibo-fbc-fct-mkt:RegisteredMultilateralTradingFacility
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:MultilateralTradingFacility ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isManagedBy ;
			owl:someValuesFrom fibo-fbc-pas-fpas:FinancialServiceProvider ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:isRegisteredBy ;
			owl:someValuesFrom cmns-ra:RegistrationAuthority ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "registered multilateral trading facility" ;
	skos:definition "multilateral system operated by an investment firm or market operator, which brings together multiple third-party buying and selling interests in financial instruments in the system, in accordance with non-discretionary rules, in a way that results in a contract in accordance with the provisions of Title II of the MiFID II" ;
	.

fibo-fbc-fct-mkt:RegulatedExchange
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:Exchange ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketCategoryClassifier-RMKT ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isRegulatedBy ;
			owl:someValuesFrom cmns-rga:RegulatoryAgency ;
		]
		;
	rdfs:label "regulated exchange" ;
	skos:definition "regulated market that is operated by and/or managed by a market operator that brings together or facilitates the bringing together of multiple third-party buying and selling interests in financial instruments" ;
	cmns-av:abbreviation "RM" ;
	cmns-av:adaptedFrom
		"http://www.investopedia.com/terms/r/regulated-market.asp" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	cmns-av:explanatoryNote "In the financial community in the EU, such an exchange operates in accordance with its non-discretionary rules in a way that results in a contract, in respect of the financial instruments admitted to trading under its rules and/or systems, and which is authorised and functions regularly and in accordance with the provisions of Title III of MiFID II." ;
	cmns-av:synonym "regulated market" ;
	.

fibo-fbc-fct-mkt:SwapExecutionFacility
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:Exchange ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketCategoryClassifier-SEFS ;
		]
		;
	rdfs:label "swap execution facility" ;
	skos:definition "exchange that enables participants to execute and trade swaps" ;
	cmns-av:abbreviation "SEF" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ;
	cmns-av:explanatoryNote "Swap execution facilities, including trading systems and other platforms, allow for greater transparency and represent a significant shift in the way derivative trading has been done. The Dodd-Frank Act lays the foundation for this change of derivative execution." ;
	.

fibo-fbc-fct-mkt:SystematicInternaliser
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-mkt:Exchange ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketCategoryClassifier-SINT ;
		]
		;
	rdfs:label
		"systematic internaliser"@en-GB ,
		"systematic internalizer"@en-US
		;
	skos:definition "investment firm that, on an organised, frequent, systematic and substantial basis, deals on its own account by executing client orders outside a regulated exchange, MTF or OTF without operating a multilateral system" ;
	cmns-av:abbreviation "SI" ;
	cmns-av:adaptedFrom
		"https://www.emissions-euets.com/systematic-internaliser" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	.

fibo-fbc-fct-mkt:TradeReportingFacility
	a owl:Class ;
	rdfs:subClassOf
		cmns-sfc:Facility ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-fbc-fct-mkt:MarketCategoryClassifier-TRFS ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fct-mkt:hasFacilityAcronym ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasFormalName ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fbc-fct-mkt:MarketIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isManagedBy ;
			owl:onClass fibo-fbc-pas-fpas:FinancialServiceProvider ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fct-mkt:operatesInCountry ;
			owl:someValuesFrom cmns-loc:Country ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fct-mkt:operatesInMunicipality ;
			owl:someValuesFrom cmns-loc:Municipality ;
		]
		;
	rdfs:label "trade reporting facility" ;
	skos:definition "facility that provides a mechanism for the reporting of transactions effected otherwise than on an exchange" ;
	skos:example "In the United States, for example, trades by FINRA members in Nasdaq-listed and other exchange-listed securities, as approved by the Securities and Exchange Commission (SEC), executed otherwise than on an exchange may be reported to a FINRA TRF. While each FINRA TRF is affiliated with a registered national securities exchange, each FINRA TRF is a FINRA facility and is subject to FINRA's registration as a national securities association." ;
	cmns-av:abbreviation "TRF" ;
	cmns-av:adaptedFrom
		"https://www.finra.org/filing-reporting/trade-reporting-facility-trf" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	.

fibo-fbc-fct-mkt:UpdatedMICStatus
	a
		owl:NamedIndividual ,
		fibo-fbc-fct-mkt:MarketIdentifierCodeStatus
		;
	rdfs:label "updated MIC status" ;
	skos:definition "as of the last report or update, the exchange code was revised" ;
	fibo-fnd-rel-rel:hasTag "UPDATED" ;
	cmns-av:adaptedFrom
		"ISO 10383, Securities and related financial instruments - Codes for exchanges and market identification (MIC), Third edition, version 2.0" ,
		"https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf"
		;
	.

fibo-fbc-fct-mkt:hasFacilityAcronym
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:hasAlias ;
	rdfs:label "has facility acronym" ;
	skos:definition "indicates a known acronym of the market" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ;
	.

fibo-fbc-fct-mkt:hasMarketIdentifierCodeStatus
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-fct-breg:hasRegistrationStatus ;
	rdfs:label "has market identifier code status" ;
	rdfs:range fibo-fbc-fct-mkt:MarketIdentifierCodeStatus ;
	skos:definition "indicates the status of a specific market identifier code (MIC)" ;
	.

fibo-fbc-fct-mkt:operatesInCountry
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-loc:hasCountry ;
	rdfs:label "operates in country" ;
	rdfs:range cmns-loc:Country ;
	skos:definition "indicates the ISO 3166-1 country in which an exchange, data reporting services provider, or crypto asset services provider operates" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ;
	.

fibo-fbc-fct-mkt:operatesInMunicipality
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-loc:hasMunicipality ;
	rdfs:label "operates in municipality" ;
	rdfs:range cmns-loc:Municipality ;
	skos:definition "indicates the municipality or business center in which in which an exchange, data reporting services provider, or crypto asset services provider operates" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ;
	.

