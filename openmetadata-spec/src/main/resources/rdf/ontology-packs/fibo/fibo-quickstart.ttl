fibo-be-le-cb:BenefitCorporation
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-cb:NotForProfitCorporation ;
	rdfs:label "benefit corporation" ;
	skos:definition "not-for-profit corporation set up under specific state legislation, typically to provide some social benefit, without an obligation to maximize shareholder return" ;
	cmns-av:explanatoryNote "This is a US-specific type of non-profit corporation defined in recent legislation in a number of states. In California, for example, benefit corporations may be defined as public benefit or mutual benefit corporations, depending on their purpose." ;
	.

fibo-be-le-cb:BoardAgreement
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-fbo:OrganizationCoveringAgreement ;
	rdfs:label "board agreement" ;
	skos:definition "formal, legally binding agreement between members of the Board of Directors of the organization" ;
	.

fibo-be-le-cb:CommonInterestDevelopmentCorporation
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-cb:NotForProfitCorporation ;
	rdfs:label "common interest development corporation" ;
	skos:definition "not-for-profit corporation set up under specific state legislation as a business entity for homeowners' associations" ;
	skos:example "http://www.dre.ca.gov/files/pdf/re39.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote "A common interest development is typically a type of housing, composed of individually owned units, such as condominiums, townhouses, or single-family homes, that share ownership of common areas, such as swimming pools, landscaping, and parking. Common interest developments (also known as community interest developments or CIDs) are managed by homeowners' associations." ;
	.

fibo-be-le-cb:Corporation
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:LegalEntity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-cb:isConstitutedBy ;
			owl:onClass fibo-be-le-cb:InstrumentOfIncorporation ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-cb:isIncorporatedIn ;
			owl:onClass cmns-rga:Jurisdiction ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasLegalName ;
			owl:someValuesFrom xsd:string ;
		]
		;
	rdfs:label "corporation"@en ;
	skos:definition "formal organization that is a legal entity (artificial person) distinct from its owners, created under the jurisdiction of the laws of a state or nation" ;
	cmns-av:explanatoryNote
		"A corporation has three distinguishing characteristics: (1) separation of ownership from management and general liability, i.e., its liability to creditors is limited to its resources, unlike some partnerships and sole proprietorships, (2) the ability to negotiate contracts and own property, and (3) transferable ownership, irrespective of changes in membership or the lifetimes of its stockholders." ,
		"A corporation is managed by or under the direction of a board of directors, which generally determines corporate policy. Officers manage the day-to-day affairs of the corporation."
		;
	cmns-av:synonym "body corporate" ;
	.

fibo-be-le-cb:ForProfitCorporation
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-cb:Corporation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-be-le-lp:ProfitObjective ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "for profit corporation" ;
	owl:disjointWith fibo-be-le-cb:NotForProfitCorporation ;
	skos:definition "corporation whose objective is to make money, i.e., to ensure realization of a financial benefit such that the amount of revenue gained from a business activity exceeds the expenses, costs and taxes needed to sustain that activity" ;
	.

fibo-be-le-cb:IncorporationGuarantee
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-cor:Constitution ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:cardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "incorporation guarantee" ;
	skos:definition "guarantee that is part of the financial basis by which some legal entity is incorporated" ;
	.

fibo-be-le-cb:InstrumentOfIncorporation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-cor:Constitution ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:onClass cmns-rga:Jurisdiction ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "instrument of incorporation" ;
	skos:definition "memorandum and articles of association by which some legal entity is established" ;
	cmns-av:explanatoryNote "This may be the issuance of shares, the existence of some agreement, guaranties and so on." ;
	.

fibo-be-le-cb:JointStockCompany
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-lp:BusinessEntity ;
	rdfs:label "joint stock company" ;
	skos:definition "for-profit, unincorporated business that has some characteristics of a corporation and some features of a partnership, with ownership interests represented by shares of stock" ;
	cmns-av:explanatoryNote """1. In the UK, the original (17th century) name for a corporation in which the liability of the owners is limited to the nominal value of the stock (shares) held by them.
2. In the US, a joint stock company is similar to a corporation, but with unlimited liability for the shareholders. Investors in a US joint stock company receive stock (shares) which can be transferred, and can elect a board of directors, but are jointly-and-severally liable for the company's debts and obligations. A US joint stock company cannot hold title to a real property.""" ;
	.

fibo-be-le-cb:NotForProfitCorporation
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-cb:Corporation ,
		fibo-be-le-fbo:NotForProfitOrganization
		;
	rdfs:label "not-for-profit corporation" ;
	skos:definition "corporation approved by its jurisdictional oversight and tax authorities as operating for educational, charitable, social, religious, civic or humanitarian purposes" ;
	cmns-av:explanatoryNote "A not-for-profit corporation is formed by incorporators, and has a board of directors and officers, but no shareholders. These incorporators, directors and officers may not receive a distribution of (any money from) profits, but officers and management may be paid reasonable salaries for services to the corporation." ;
	cmns-av:synonym "non-profit corporation" ;
	.

fibo-be-le-cb:PrivatelyHeldCompany
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-cb:StockCorporation ;
	rdfs:label "privately held company" ;
	skos:definition "corporation whose issued shares are all held by a family or a small group of investors and, therefore, cannot be bought by the public" ;
	cmns-av:explanatoryNote "For British or Commonwealth companies, a privately held company limited by shares is a type of company incorporated under the laws of England and Wales, Scotland, certain Commonwealth countries and the Republic of Ireland. It has shareholders with limited liability and its shares may not be offered to the general public, unlike those of public limited companies. Limited by shares means that the company has shareholders, and that the liability of the shareholders to creditors of the company is limited to the capital originally invested, i.e. the nominal value of the shares and any premium paid in return for the issue of the shares by the company. A shareholders personal assets are thereby protected in the event of the company's insolvency, but money invested in the company will be lost. A limited company may be private or public. A private limited companys disclosure requirements are lighter, but for this reason its shares may not be offered to the general public (and therefore cannot be traded on a public stock exchange). This is the major distinguishing feature between a private limited company and a public limited company. Most companies, particularly small companies, are private. Private companies limited by shares are required to have the suffix Limited (often written Ltd or Ltd.) or Incorporated (Inc.) as part of their name, though the latter cannot be used in the UK or the Republic of Ireland. In the Republic of Ireland, Teoranta (Teo.) may be used instead, largely by Gaeltacht companies. Cyfyngedig (Cyf.) may be used by Welsh companies in a similar fashion." ;
	cmns-av:synonym
		"closed corporation" ,
		"privately held corporation"
		;
	.

fibo-be-le-cb:PubliclyHeldCompany
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-cb:StockCorporation ;
	rdfs:label "publicly held company" ;
	skos:definition "corporation whose shares are traded and held publicly" ;
	.

fibo-be-le-cb:RegistrationIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:OrganizationIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:onClass cmns-rga:Jurisdiction ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass cmns-org:FormalOrganization ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-be-le-cb:RegistrationIdentifierScheme ;
		]
		;
	rdfs:label "registration identifier" ;
	skos:definition "identifier that is officially allocated to an organization at the time of registration, typically in a jurisdiction in which said organization is organized or registered and used in that jurisdiction to identify the organization" ;
	skos:scopeNote "In some jurisdictions, such as the State of California, registration identifiers are issued to corporations, including non-profit corporations, limited liability companies, certain partnerships, and foreign corporations doing business in California. The same or a very similar process is used for registration of corporations across the US." ;
	cmns-av:explanatoryNote "A registration identifier may be required for official communications and is publicly available. The relationship to the jurisdiction in which the organization is organized or registered is typically required, but is optional here to cover cases where jurisdictions may overlap or are not as clearly defined." ;
	.

fibo-be-le-cb:RegistrationIdentifierScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:OrganizationIdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-be-le-cb:RegistrationIdentifier ;
		]
		;
	rdfs:label "registration identifier scheme" ;
	skos:definition "scheme that defines the registration identifier per the issuing registration authority" ;
	.

fibo-be-le-cb:ReligiousCorporation
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-cb:NotForProfitCorporation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:someValuesFrom fibo-be-le-lp:ReligiousObjective ;
		]
		;
	rdfs:label "religious corporation" ;
	skos:definition "not-for-profit corporation whose objective is specific to some fundamental set of beliefs and practices generally agreed upon by a number of people, and that is incorporated under the law" ;
	cmns-av:explanatoryNote "Often religious corporations are recognized under the law on a sub-national level, for instance by a state or provincial government. The government agency responsible for regulating such corporations is usually the official holder of records, for instance a state department of corporations." ;
	.

fibo-be-le-cb:StockCorporation
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-cb:Corporation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-cb:hasDateOfRegistration ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-cb:hasIssuedCapital ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-cb:hasDateOfIncorporation ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom fibo-be-le-cb:BoardAgreement ;
		]
		;
	rdfs:label "stock corporation"@en ;
	skos:definition "corporation that has shareholders, each of whom receives a portion of the ownership of the corporation through shares of stock" ;
	cmns-av:adaptedFrom "https://www.oecd.org/corporate/OECD-Corporate-Governance-Factbook.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote "The shares in a stock corporation may receive a return on their investment in the form of dividends. Shares are used for voting on matters of corporate policy or to elect directors, at the corporation's annual meeting and at other meetings of the corporation." ;
	.

fibo-be-le-cb:hasDateOfIncorporation
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has date of incorporation" ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the formal date of incorporation as stated in filing documents" ;
	.

fibo-be-le-cb:hasDateOfRegistration
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has date of registration" ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the date on which the corporation has registered in some jurisdiction for regulatory and / or for tax purposes" ;
	.

fibo-be-le-cb:hasIssuedCapital
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has issued capital" ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the aggregate value of all shares held by shareholders" ;
	cmns-av:explanatoryNote "A corporation can, at any time, issue new shares up to the full amount of authorized share capital." ;
	cmns-av:synonym
		"has subscribed capital" ,
		"has subscribed share capital"
		;
	.

fibo-be-le-cb:hasSharesAuthorized
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasAmount ;
	rdfs:label "has shares authorized"@en ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "indicates the maximum number of shares that are permitted to be issued, as established by the board of directors"@en ;
	cmns-av:explanatoryNote "An initial number of authorized shares is typically established at the time of incorporation, and is documented in articles of incorporation. The number of shares authorized may be extended from time to time by the board of directors as needed, and articles of incorporation and other legal documentation will be amended accordingly. It includes shares that are available, but not yet issued, for sale to generate capital, and shares available for distribution to insiders as part of their compensation packages."@en ;
	.

fibo-be-le-cb:isConstitutedBy
	a owl:ObjectProperty ;
	rdfs:label "is constituted by" ;
	rdfs:domain fibo-be-le-cb:Corporation ;
	rdfs:range fibo-fnd-law-cor:Constitution ;
	skos:definition "the instrument by which an entity is incorporated" ;
	.

fibo-be-le-cb:isIncorporatedIn
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-rga:isOrganizedIn ;
	rdfs:label "is incorporated in" ;
	rdfs:domain fibo-be-le-cb:Corporation ;
	rdfs:range cmns-rga:Jurisdiction ;
	skos:definition "the legal jurisdiction under which the legal entity is incorporated" ;
	cmns-av:explanatoryNote "It is the laws of this jurisdiction that cause and allow the legal entity to exist and to incur debt and be sued at law as a legal entity." ;
	.

fibo-be-le-fbo:Branch
	a owl:Class ;
	rdfs:subClassOf cmns-org:OrganizationalSubUnit ;
	rdfs:label "branch" ;
	skos:definition "part of a larger organization that might not be co-located with it" ;
	.

fibo-be-le-fbo:Division
	a owl:Class ;
	rdfs:subClassOf cmns-org:OrganizationalSubUnit ;
	rdfs:label "division" ;
	skos:definition "part of an organization, such as a line of business, that may have separate accounting and reporting requirements" ;
	.

fibo-be-le-fbo:JointVenture
	a owl:Class ;
	rdfs:subClassOf cmns-org:LegalEntity ;
	rdfs:label "joint venture" ;
	skos:definition "legal entity that is formed between parties that pool their resources for the purpose of accomplishing a specific task but otherwise retain their distinct identities" ;
	cmns-av:explanatoryNote "In a joint venture, each of the participants is responsible for profits, losses, and costs associated with it. However, the venture is its own entity, separate from the participants' other business interests." ;
	.

fibo-be-le-fbo:NonGovernmentalOrganization
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-fbo:NotForProfitOrganization ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-be-le-lp:PublicPurpose ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "non-governmental organization" ;
	skos:definition "not-for-profit organization that functions independently of government" ;
	cmns-av:abbreviation "NGO" ;
	cmns-av:explanatoryNote
		"NGOs, sometimes called civil societies, are organized on community, national and international levels to serve specific social or political purposes, and are cooperative, rather than commercial, in nature." ,
		"Some NGOs avoid formal funding altogether and are run primarily by volunteers. NGOs are highly diverse groups of organizations engaged in a wide range of activities, and take different forms in different parts of the world. Some may have charitable status, while others may be registered for tax exemption based on recognition of social purposes. Others may be fronts for political, religious, or other interests."
		;
	.

fibo-be-le-fbo:NotForProfitOrganization
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:FormalOrganization ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-be-le-lp:NotForProfitObjective ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "not for profit organization" ;
	skos:definition "organization that uses its surplus revenues to further achieve its purpose rather than distributing its surplus income to the organization's owners (directors, investors, and equivalents) as profit / dividends" ;
	cmns-av:explanatoryNote
		"In the US, a nonprofit organization is an association that explicitly is not required to pay taxes on its income. Such organizations are qualified for this exemption due to their socially desirable objective (e.g. hospitals, charitable organizations, etc., or because they meet some set of requirements as determined by the US Internal Revenue Service." ,
		"The nonprofit landscape is highly varied, although many people have come to associate NPOs with charitable organizations. Although charities do comprise an often high profile or visible aspect of the sector, there are many other types of nonprofits. Overall, they tend to be either member-serving or community-serving. Member-serving organizations include mutual societies, cooperatives, trade unions, credit unions, industry associations, sports clubs, retired serviceman's clubs and other organizations that benefit a particular group of people - the members of the organization. Typically, community-serving organizations are focused on providing services to the community in general, either globally or locally: organizations delivering human services programs or projects, aid and development programs, medical research, education and health services, and so on."
		;
	cmns-av:synonym "non-profit organization" ;
	.

fibo-be-le-fbo:OrganizationCoveringAgreement
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:WrittenContract ;
	rdfs:label "organization covering agreement" ;
	skos:definition "contract between the principals in a formal organization that specifies the relationship between the principals, and between the principals and the entity" ;
	cmns-av:explanatoryNote "Also covers the aims and purposes of the Entity." ;
	.

fibo-be-le-fbo:ValueAddedTaxIdentificationNumber
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pty-pty:TaxIdentifier ,
		cmns-org:OrganizationIdentifier ,
		cmns-ra:RegisteredIdentifier
		;
	rdfs:label "value-added tax identification number" ;
	skos:definition "tax identifier that identifies a taxable person (business) or non-taxable legal entity for a consumption tax that is assessed incrementally, levied on the price of a product or service at each stage of production, distribution, and sale to the end consumer" ;
	cmns-av:abbreviation "VATIN" ;
	cmns-av:adaptedFrom "https://ec.europa.eu/taxation_customs/business/vat/eu-vat-rules-topic/vat-identification-numbers_en"^^xsd:anyURI ;
	cmns-av:explanatoryNote "If the ultimate consumer is a business that collects and pays to the government VAT on its products or services, it can reclaim the tax paid. Not all localities require VAT to be charged, and exports are often exempt. VAT is usually implemented as a destination-based tax, where the tax rate is based on the location of the consumer and applied to the sales price." ;
	cmns-av:synonym
		"VAT identification number" ,
		"VAT registration number"
		;
	.

fibo-be-le-fbo:hasEquity
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasExpression ;
	rdfs:label "has equity" ;
	rdfs:domain cmns-org:LegalEntity ;
	rdfs:range fibo-fnd-oac-own:OwnersEquity ;
	skos:definition "indicates owners' equity associated with the entity" ;
	.

fibo-be-le-fbo:hasHeadquartersAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-le-fbo:hasOperatingAddress ;
	rdfs:label "has headquarters address" ;
	rdfs:range fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "indicates the main address at which communications may be delivered for the organization" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-be-le-fbo:hasOperatingAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-plc-adr:hasAddress ;
	rdfs:label "has operating address" ;
	rdfs:domain cmns-org:Organization ;
	rdfs:range fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "indicates an address at which an organization carries out operations" ;
	.

fibo-be-le-fbo:hasRegisteredAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-plc-adr:hasAddress ;
	rdfs:label "has registered address" ;
	rdfs:domain cmns-pts:Party ;
	rdfs:range fibo-fnd-plc-adr:ConventionalStreetAddress ;
	skos:definition "identifies an address that is officially recorded with some government authority and at which legal papers may be served" ;
	.

fibo-be-le-lei:AccountingFramework
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-lei:RelationshipQualifier ;
	rdfs:label "accounting framework" ;
	skos:definition "framework, including policies, methods, rules, and processes, used to measure, recognize, present, and disclose the information appearing in an entity's financial statements, and, from a legal ownership perspective, that is applied for accounting consolidation determination" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:AccountingPeriod
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:RelationshipPeriodQualifier
		;
	rdfs:label "accounting period" ;
	skos:definition "qualifier indicating that the relationship period reflects the period of time covered by the most recent validation documents from an accounting perspective for this relationship" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:ContractuallyCapableEntity
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:AgentRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass cmns-org:LegalEntity ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "contractually capable entity" ;
	skos:definition "a unique entity that is legally or financially responsible for the performance of financial transactions, or has the legal right in its jurisdiction to enter independently into legal contracts, regardless of whether it is incorporated or constituted in some other way (e.g. trust, partnership, contractual). This excludes natural persons, but includes governmental organizations and supranationals." ;
	cmns-av:adaptedFrom "ISO 17442" ;
	.

fibo-be-le-lei:DocumentFilingPeriod
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:RelationshipPeriodQualifier
		;
	rdfs:label "document filing period" ;
	skos:definition "a qualifier indicating that the relationship period reflects the validity period for any regulatory filing, accounting document, other document demonstrating the relationship's validity" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:EntityLegalForm
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-lei:hasLegalFormAbbreviation ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-txt:Text ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-lei:hasTransliteratedLegalFormAbbreviation ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-txt:Text ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-lei:hasTransliteratedName ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-txt:Text ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:hasTextualName ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-txt:Text ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom cmns-org:LegalPerson ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-be-le-lei:EntityLegalFormScheme ;
		]
		;
	rdfs:label "entity legal form" ;
	skos:definition "a classifier for a legal entity that indicates the nature of that entity as defined from a legal or regulatory perspective, in the jurisdiction in which it was established" ;
	cmns-av:adaptedFrom
		"https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ,
		"https://www.iso.org/obp/ui/#iso:std:iso:20275:ed-1:v1:en"^^xsd:anyURI
		;
	.

fibo-be-le-lei:EntityLegalFormIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:denotes ;
			owl:onClass fibo-be-le-lei:EntityLegalForm ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-be-le-lei:EntityLegalFormScheme ;
		]
		;
	rdfs:label "entity legal form identifier" ;
	skos:definition "code that denotes an entity legal form as defined in ISO 20275" ;
	cmns-av:adaptedFrom
		"https://www.gleif.org/en/about-lei/code-lists/iso-20275-entity-legal-forms-code-list"^^xsd:anyURI ,
		"https://www.iso.org/obp/ui/#iso:std:iso:20275:ed-1:v1:en"^^xsd:anyURI
		;
	.

fibo-be-le-lei:EntityLegalFormScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:ClassificationScheme ,
		cmns-cds:CodeSet ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-be-le-lei:EntityLegalFormIdentifier ;
		]
		;
	rdfs:label "entity legal form scheme" ;
	skos:definition "scheme that specifies the elements of the codes for entity legal forms, such as those that are sanctioned in a given jurisdiction as defined in ISO 20725" ;
	cmns-av:adaptedFrom
		"https://www.gleif.org/en/about-lei/code-lists/iso-20275-entity-legal-forms-code-list"^^xsd:anyURI ,
		"https://www.iso.org/obp/ui/#iso:std:iso:20275:ed-1:v1:en"^^xsd:anyURI
		;
	.

fibo-be-le-lei:GenerallyAcceptedAccountingPrinciples
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:AccountingFramework
		;
	rdfs:label "Generally Accepted Accounting Principles" ;
	rdfs:seeAlso <https://www.fasb.org/home> ;
	skos:definition "an accounting framework developed by the US Financial Accounting Standards Board (FASB)" ;
	cmns-av:abbreviation
		"GAAP" ,
		"US GAAP"
		;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:ISO17442-CodeSet
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:LegalEntityIdentifierScheme
		;
	rdfs:label "ISO 17442 code set" ;
	skos:definition "the set of legal entity identifiers that comprise the ISO 17442 legal entity identifier specification" ;
	cmns-av:synonym "GLEIF LEI CDF v2.1 legal entity identifier (LEI) code set" ;
	.

fibo-be-le-lei:ISO20275-CodeSet
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:EntityLegalFormScheme
		;
	rdfs:label "ISO 20275 code set" ;
	skos:definition "the set of entity legal form identifiers that comprise the ISO 20275 entity legal form specification" ;
	cmns-av:synonym "entity legal form (ELF) code set" ;
	.

fibo-be-le-lei:InternationalFinancialReportingStandard
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:AccountingFramework
		;
	rdfs:label "International Financial Reporting Standard" ;
	rdfs:seeAlso <https://www.ifrs.org/> ;
	skos:definition "an accounting framework developed by the International Accounting Standards Board (IASB)" ;
	cmns-av:abbreviation "IFRS" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:LEIRegisteredEntity
	a owl:Class ;
	rdfs:subClassOf cmns-org:LegalPerson ;
	rdfs:label "LEI registered entity" ;
	owl:equivalentClass [
		a owl:Restriction ;
		owl:onProperty cmns-id:isIdentifiedBy ;
		owl:someValuesFrom fibo-be-le-lei:LegalEntityIdentifier ;
	] ;
	skos:definition "a legal person that has registered for and is identified by a legal entity identifier" ;
	cmns-av:explanatoryNote "Note that the GLEIF data includes multiple LEIs for some entities due to corporate actions or other situations. The duplicates are typically archived after some period of time, but in order to reflect the reality in the data, the restriction is modeled as someValuesFrom rather than exactly 1 LEI for a given entity." ;
	.

fibo-be-le-lei:LegalEntityIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:OrganizationIdentifier ,
		cmns-ra:RegisteredIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass cmns-org:LegalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-be-le-lei:LegalEntityIdentifierScheme ;
		]
		;
	rdfs:label "legal entity identifier" ;
	skos:definition "an organization identifier that uniquely identifies a legal person as defined in ISO 17442" ;
	cmns-av:adaptedFrom
		"https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ,
		"https://www.iso.org/standard/59771.html"^^xsd:anyURI
		;
	.

fibo-be-le-lei:LegalEntityIdentifierScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:OrganizationIdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-be-le-lei:LegalEntityIdentifier ;
		]
		;
	rdfs:label "legal entity identifier scheme" ;
	skos:definition "a scheme that specifies the elements of an unambiguous legal entity identifier (LEI) scheme to identify the legal entities relevant to any financial transaction" ;
	cmns-av:adaptedFrom
		"https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ,
		"https://www.iso.org/standard/59771.html"^^xsd:anyURI
		;
	.

fibo-be-le-lei:OtherAccountingFramework
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:AccountingFramework
		;
	rdfs:label "other accounting framework" ;
	rdfs:seeAlso <https://www.ifrs.org/> ;
	skos:definition "an accounting framework of unstated origin (other than IFRS or US GAAP)" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:RelationshipPeriodQualifier
	a owl:Class ;
	rdfs:subClassOf cmns-cls:Classifier ;
	rdfs:label "relationship period qualifier" ;
	skos:definition "a classifier that qualifies something about the reporting period specified, such as that the date period reflects an accounting or document filing period" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:RelationshipQualifier
	a owl:Class ;
	rdfs:subClassOf cmns-cls:Classifier ;
	rdfs:label "relationship qualifier" ;
	skos:definition "a classifier that qualifies something about the relationship between consolidated entities during the reporting period, such as the accounting framework used" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:RelationshipRecord
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Constituent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isQualifiedBy ;
			owl:onClass fibo-be-le-lei:RelationshipQualifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-lei:isQuantifiedBy ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:records ;
			owl:onClass fibo-be-oac-opty:EntityOwnership ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "relationship record" ;
	skos:definition "a record describing relationships between legal entities" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:RelationshipStatus
	a owl:Class ;
	rdfs:subClassOf cmns-cls:Classifier ;
	rdfs:label "relationship status" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:oneOf (
			fibo-be-le-lei:RelationshipStatusActive
			fibo-be-le-lei:RelationshipStatusInactive
		) ;
	] ;
	skos:definition "a classifier that specifies the status of the relationship between consolidated entities during the reporting period (active or inactive)" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:RelationshipStatusActive
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:RelationshipStatus
		;
	rdfs:label "relationship status - active" ;
	skos:definition "status indicating that as of the last report or update, the reporting legal entity reported that it is legally registered and/or operating, and that the relationship detailed in this relationship record is still valid" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:RelationshipStatusInactive
	a
		owl:NamedIndividual ,
		fibo-be-le-lei:RelationshipStatus
		;
	rdfs:label "relationship status - inactive" ;
	skos:definition "status indicating that it has been determined that the relationship ended, e.g. because entity that reported this relationship is no longer legally registered and/or operating; or the relationship is no longer valid for other reasons" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:hasLegalAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-le-fbo:hasRegisteredAddress ;
	rdfs:label "has legal address" ;
	rdfs:domain cmns-org:LegalEntity ;
	rdfs:range fibo-fnd-plc-adr:ConventionalStreetAddress ;
	skos:definition "indicates the legal address for the entity, in the jurisdiction in which the entity is established, used for registration purposes with respect to obtaining an LEI" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-be-le-lei:hasLegalForm
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
	rdfs:label "has legal form" ;
	rdfs:domain cmns-org:LegalEntity ;
	rdfs:range fibo-be-le-lei:EntityLegalForm ;
	skos:definition "indicates the nature of the entity as defined from a legal or regulatory perspective in a given jurisdiction" ;
	cmns-av:adaptedFrom
		"https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ,
		"https://www.iso.org/obp/ui/#iso:std:iso:20275:ed-1:v1:en"^^xsd:anyURI
		;
	.

fibo-be-le-lei:hasLegalFormAbbreviation
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has legal form abbreviation" ;
	skos:definition "the precise abbreviation for the entity legal form as defined in the jurisdiction in which it is registered, for example LLC, LLP, Ltd, PLC, Corp." ;
	.

fibo-be-le-lei:hasOwnershipPercentage
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-be-le-lei:isQuantifiedBy ;
	rdfs:label "has ownership percentage" ;
	rdfs:range xsd:decimal ;
	skos:definition "the percentage ownership interest in the owned entity owned by owning entity, if known" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-be-le-lei:hasTransliteratedLegalFormAbbreviation
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has transliterated legal form abbreviation" ;
	skos:definition "a transliterated (i.e., in Latin or Romanized ASCII) representation of the abbreviation for the entity legal form" ;
	.

fibo-be-le-lei:hasTransliteratedName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dsg:hasTextualName ;
	rdfs:label "has transliterated name" ;
	skos:definition "a transliterated (i.e., in Latin or Romanized ASCII) representation of a name for the entity" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-be-le-lei:isConsolidatedBy
	a owl:ObjectProperty ;
	rdfs:label "is consolidated by" ;
	rdfs:range cmns-org:LegalEntity ;
	skos:definition "indicates the entity considered the 'end node' or consolidating entity (parent) from an ISO 17442 perspective" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:isConsolidationOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "is consolidation of" ;
	rdfs:range cmns-org:LegalEntity ;
	skos:definition "indicates the entity considered the 'start node' or consolidated entity from an ISO 17442 perspective" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:isDirectlyConsolidatedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-le-lei:isConsolidatedBy ;
	rdfs:label "is directly consolidated by" ;
	rdfs:range cmns-org:LegalEntity ;
	skos:definition "indicates that the entity considered the 'end node' or consolidating entity (parent) fully consolidates the accounting of the 'start node' (child) per the accounting rules specified, and is the closest consolidating entity to that child in any applicable ownership hierarchy" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:isInternationalBranchOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-le-lei:isConsolidatedBy ;
	rdfs:label "is an international branch of" ;
	rdfs:range cmns-org:LegalEntity ;
	skos:definition "indicates that the entity considered the 'start node' or consolidated entity (child) is an international subsidiary of the 'end node' (parent) in the jurisdiction of the child" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:isQuantifiedBy
	a owl:DatatypeProperty ;
	rdfs:label "is quantified by" ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates that something is limited to or conditional due to some rate or other statistical value" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lei:isUltimatelyConsolidatedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-le-lei:isConsolidatedBy ;
	rdfs:label "is ultimately consolidated by" ;
	rdfs:range cmns-org:LegalEntity ;
	skos:definition "indicates that the entity considered the 'end node' or consolidating entity (parent) fully consolidates the accounting of the 'start node' (child) per the accounting rules specified, and is the most distant consolidating entity to that child in any applicable ownership hierarchy" ;
	cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" ;
	.

fibo-be-le-lp:BusinessEntity
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:FormalOrganization ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-fnd-gao-obj:BusinessObjective ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:onClass fibo-fnd-law-lcap:License ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "business entity" ;
	skos:definition "entity that is formed and administered as per commercial law in order to engage in business activities" ;
	cmns-av:explanatoryNote "There are many types of business entities defined in the legal systems of various countries. These include corporations, cooperatives, partnerships, sole proprietorships, sole traders, limited liability companies, certain trusts and trust companies, and so forth. The rules vary by country and by state or province. Some of the more widely recognized types in the US, UK, and EU are defined in FIBO, by region. However, the regulations governing particular types of entity, even those described as roughly equivalent, differ from jurisdiction to jurisdiction." ;
	.

fibo-be-le-lp:BusinessLicense
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:License ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:onClass fibo-be-le-lp:BusinessEntity ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isRecognizedIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "business license" ;
	skos:definition "license that allows the holder to conduct business or carry out a specific profession within some jurisdiction for some period of time" ;
	.

fibo-be-le-lp:CharteredLegalPerson
	a owl:Class ;
	rdfs:subClassOf cmns-org:LegalEntity ;
	rdfs:label "chartered legal person" ;
	skos:definition "a legal person created by a royal charter or decree" ;
	skos:example "Anything with 'Royal Institute' in the name. Also universities are generally set up by royal charter in a monarchy or principality, (often pre-dating any Privy Council i.e. directly be the monarch in the case of older universities). The Bank of England and the British Broadcasting Council (BBC) are also incorporated through Royal Charter." ;
	cmns-av:explanatoryNote "In a monarchy or principality, the monarch typically vests the power to create such bodies, in an entity called (for example) the Privy Council." ;
	.

fibo-be-le-lp:LegallyCompetentNaturalPerson
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:Person ,
		cmns-org:LegalPerson
		;
	rdfs:label "legally competent natural person" ;
	owl:disjointWith fibo-fnd-aap-ppl:IncapacitatedAdult ;
	skos:definition "person who is considered competent, under the circumstances, to enter into a contract, conduct business, or participate in other activities that generally require the mental ability to understand problems and make decisions on his or her own behalf" ;
	cmns-av:explanatoryNote "The definition of mental competence, and potentially of the age of majority, is a function of the situation and law in a given jurisdiction." ;
	.

fibo-be-le-lp:NotForProfitObjective
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Objective ;
	rdfs:label "not for profit objective" ;
	owl:disjointWith fibo-be-le-lp:ProfitObjective ;
	skos:definition "objective that reflects the charitable, educational, religious, humanitarian, public services, or other not for profit goals of an organization" ;
	cmns-av:explanatoryNote "The objective of all business activities is not to earn profits for its owners. All of the money earned by or donated to a not for profit organization is used in pursuing the organization's objectives." ;
	cmns-av:synonym "nonprofit objective" ;
	.

fibo-be-le-lp:PowerOfAttorney
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:LegalCapacity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasEffectiveDate ;
			owl:onClass cmns-dt:Date ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:isConferredOn ;
			owl:someValuesFrom fibo-be-le-lp:LegallyCompetentNaturalPerson ;
		]
		;
	rdfs:label "power of attorney" ;
	skos:definition "legal authorization given by one party (the principal) to another (the agent or attorney-in-fact) to perform certain acts on the principal's behalf" ;
	cmns-av:explanatoryNote "The appointment can be effective immediately or if the principal is unable to make decisions or perform certain actions on their own. It may be a (1) general power of attorney that authorizes the agent to act generally on behalf of the principal, such as to transfer funds from one account to another, pay debts, make investments, and so forth, or (2) limited to a specific act or situation, such as for management of an individual's finances in a single account, such as a brokerage account, or for management of healthcare. Decisions made and actions taken by an attorney in fact (within the scope of his or her authority) are legally binding on the principal." ;
	.

fibo-be-le-lp:ProfitObjective
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:BusinessObjective ;
	rdfs:label "profit objective" ;
	skos:definition "objective that reflects pursuit of a financial benefit that may be realized when the amount of revenue gained from a business activity exceeds the expenses, costs and taxes needed to sustain that activity" ;
	cmns-av:explanatoryNote "Any profit that is gained goes to the business's owners, who may or may not decide to spend it on the business." ;
	cmns-av:synonym
		"for profit objective" ,
		"profit motive"
		;
	.

fibo-be-le-lp:PublicPurpose
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Objective ;
	rdfs:label "public purpose" ;
	skos:definition "objective that reflects values generally thought to be shared by and that is intended to benefit the populace as a whole" ;
	cmns-av:synonym "public interest" ;
	.

fibo-be-le-lp:ReligiousObjective
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-lp:NotForProfitObjective ;
	rdfs:label "religious objective" ;
	skos:definition "not-for-profit objective that reflects the religious goals of an organization" ;
	.

fibo-be-le-lp:SpecialPurposeVehicle
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:LegalEntity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-lp:hasIntendedLiquidationDate ;
			owl:onClass cmns-dt:Date ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label
		"fonds commun de placement"@fr-FR ,
		"special purpose vehicle"@en-US
		;
	skos:definition "legal entity created to fulfill narrow, specific, and frequently temporary objectives"@en ;
	cmns-av:abbreviation
		"SPE"@en ,
		"SPV"@en
		;
	cmns-av:explanatoryNote "A special purpose vehicle (SPV), also known as a special purpose entity (SPE), refers to a legal entity, typically a limited company or partnership, created to isolate a parent company from financial risk, including bankruptcy."@en ;
	cmns-av:synonym "special purpose entity"@en ;
	.

fibo-be-le-lp:StatutoryBody
	a owl:Class ;
	rdfs:subClassOf cmns-org:LegalEntity ;
	rdfs:label "statutory body" ;
	skos:definition "legal entity established by a government to consider evidence and make judgements in some field of activity" ;
	.

fibo-be-le-lp:VariableInterestEntity
	a owl:Class ;
	rdfs:subClassOf cmns-org:LegalEntity ;
	rdfs:label "variable interest entity"@en ;
	skos:definition "legal entity whose shareholders are entitled to a percentage of a named company's profits via a private contract"@en ;
	cmns-av:abbreviation "VIE"@en ;
	cmns-av:explanatoryNote "Variable interest entity (VIE) is a term used by the Financial Accounting Standards Board (FASB) to refer to a legal entity with certain characteristics such that a public company with a financial interest in the entity is subject to certain financial reporting requirements. Examples include certain Chinese companies, such as Alibaba, that leverage VIEs to gain access to foreign capital that would otherwise not be available due to Chinese government regulations."@en ;
	cmns-av:synonym "shell company"@en ;
	.

fibo-be-le-lp:hasIntendedLiquidationDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-arr-doc:hasTerminationDate ;
	rdfs:label "has intended liquidation date"@en ;
	rdfs:range cmns-dt:Date ;
	skos:definition "links an agreement, contract, or legal entity to a date on which it is scheduled to be sold"@en ;
	.

fibo-be-oac-cpty:ContractualControl
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:DeJureControl ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		]
		;
	rdfs:label "contractual control" ;
	skos:definition "control established through the terms of some contract" ;
	.

fibo-be-oac-cpty:ControlledParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:ControlledThing ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass cmns-pts:Party ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "controlled party" ;
	skos:definition "person or organization over which some party exercises some form of authority or influence with respect to some situation" ;
	.

fibo-be-oac-cpty:ControllingAlliance
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-org-fm:Group ;
	rdfs:label "controlling alliance" ;
	skos:definition "group that has formed some alliance to jointly exercise control over some entity" ;
	skos:editorialNote "The types of entity which may enter into such an alliance are the same types of entity as may exercise control in their own right, i.e. independent parties (that is a logical union of natural persons, legal persons and formal organizations)." ;
	.

fibo-be-oac-cpty:CourtAppointedControl
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:DeJureControl ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:allValuesFrom fibo-fnd-law-cor:CourtOfLaw ;
		]
		;
	rdfs:label "court appointed control" ;
	skos:definition "control conferred by the actions of some court, for example in the context of receivership" ;
	.

fibo-be-oac-cpty:DeFactoControllingInterestParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:ControllingParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-exec:nominates ;
			owl:onClass fibo-be-oac-exec:BoardMember ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ;
			owl:someValuesFrom fibo-fnd-oac-ctl:DeFactoControl ;
		]
		;
	rdfs:label "de facto controlling interest party" ;
	skos:definition "party that exercises some control over an entity other than via explicit, legal means" ;
	skos:example "a silent partner, i.e. where someone has made a large investment, which is bilateral (not part of the constitutional framework of the company)" ;
	skos:scopeNote "divides further into financial leverage via loans; non fiscal types of leverage (influence)" ;
	cmns-av:explanatoryNote "A control owner (i.e., control person, per SEC regulations) may have some means or right that allows them to exercise control over board composition, other than through proxy assignment or vote. Not all control persons have this facility, as it is not inherent to having a significant (for example, 20 percent or more) ownership stake." ;
	.

fibo-be-oac-cpty:DeJureControllingInterestParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:ControllingParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ;
			owl:someValuesFrom fibo-fnd-oac-ctl:DeJureControl ;
		]
		;
	rdfs:label "de jure controlling interest party" ;
	skos:definition "party that has the legal authority to exercise control" ;
	.

fibo-be-oac-cpty:EntityControllingParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:ControllingParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControllingPartyOf ;
			owl:someValuesFrom cmns-org:LegalEntity ;
		]
		;
	rdfs:label "entity controlling party" ;
	skos:definition "party that has the authority to control some legal entity" ;
	skos:editorialNote "This type of party is either asserted to be the case by the entity itself or some other party, or is determined through some analysis or calculation based on the available information about controlling interests." ;
	skos:scopeNote "It is assumed that since control follows from some form of ownership or contractual instrument, that the range of entities which may fulfil this party role is the same as that for entity ownership, namely a logical union of natural persons, legal persons and formal organizations." ;
	.

fibo-be-oac-cpty:InfluenceBasedDeFactoControl
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:DeFactoControl ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:hasPartyInControl ;
			owl:someValuesFrom fibo-be-oac-cpty:InfluenceBasedDeFactoControllingParty ;
		]
		;
	rdfs:label "influence-based de facto control" ;
	skos:definition "informal control that involves influence over some party" ;
	.

fibo-be-oac-cpty:InfluenceBasedDeFactoControllingParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:DeFactoControllingInterestParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ;
			owl:someValuesFrom fibo-be-oac-cpty:InfluenceBasedDeFactoControl ;
		]
		;
	rdfs:label "influence-based de facto controlling party" ;
	skos:definition "party that holds influence-based control over some other party" ;
	skos:editorialNote "Regulatory or jurisdictional control would fall under this control. Court appointed control is de jure control BUT the scenario in which a government takes over something and then hands it over to some new de jure controller i.e. administrator - in the meantime this is de facto control by e.g. the government." ;
	.

fibo-be-oac-cpty:InvestmentBasedDeFactoControl
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:DeFactoControl ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:allValuesFrom fibo-be-oac-opty:InvestmentEquity ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:hasPartyInControl ;
			owl:someValuesFrom fibo-be-oac-cpty:InvestmentBasedDeFactoControllingInterestParty ;
		]
		;
	rdfs:label "investment-based de facto control" ;
	skos:definition "control that arises through some investment in some entity, other than via the holding of constitutional equity (shares etc.) in that entity" ;
	.

fibo-be-oac-cpty:InvestmentBasedDeFactoControllingInterestParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:DeFactoControllingInterestParty ,
		fibo-be-oac-opty:Investor ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ;
			owl:allValuesFrom fibo-be-oac-cpty:InvestmentBasedDeFactoControl ;
		]
		;
	rdfs:label "investment-based de facto controlling interest party" ;
	skos:definition "party that holds investment-based control over some other party" ;
	.

fibo-be-oac-cpty:JointControllingParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:EntityControllingParty ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:allValuesFrom fibo-be-oac-cpty:ControllingAlliance ;
		]
		;
	rdfs:label "joint controlling party" ;
	owl:disjointWith fibo-be-oac-cpty:SoleControllingParty ;
	skos:definition "party that collectively has the authority to control the affairs of some business organization" ;
	.

fibo-be-oac-cpty:MajorityControllingParty
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-cpty:EntityControllingParty ;
	rdfs:label "majority controlling party" ;
	skos:definition "controlling party that possesses, either directly or indirectly, the power to direct or cause the direction of the management and policies of a legal person, whether through the ownership of a majority of voting securities, by contract, or otherwise" ;
	cmns-av:adaptedFrom "Electronic Code of Federal Regulations, Title 17, Chapter 1, Section 49.2" ;
	.

fibo-be-oac-cpty:Receiver
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:DeJureControllingInterestParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ;
			owl:someValuesFrom fibo-be-oac-cpty:CourtAppointedControl ;
		]
		;
	rdfs:label "receiver" ;
	skos:definition "party appointed by some court for the purposes of winding up the affairs of some entity which is no longer solvent" ;
	.

fibo-be-oac-cpty:SoleControllingParty
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-cpty:EntityControllingParty ;
	rdfs:label "sole controlling party" ;
	skos:definition "party that has sole control over and directs the affairs of some legal entity" ;
	.

fibo-be-oac-cpty:TotalOwner
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-opty:ConstitutionalOwner ;
	rdfs:label "total owner" ;
	skos:definition "party that has 100 percent ownership some legal entity" ;
	skos:editorialNote "By virtue of holding 100 percent of the equity ownership, the Total Owner also holds 100 percent of the controlling equity, if there is a difference. Therefore it is both a total owner and a total controlling party." ;
	.

fibo-be-oac-cpty:advises
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:isPartyControlling ;
	rdfs:label "advises" ;
	rdfs:domain fibo-fnd-oac-ctl:ControllingParty ;
	rdfs:range fibo-be-oac-cpty:ControlledParty ;
	owl:inverseOf fibo-be-oac-cpty:isAdvisedBy ;
	skos:definition "provides counsel or guidance to" ;
	.

fibo-be-oac-cpty:hasControllingOrganizationMember
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:hasControllingParty ;
	rdfs:label "has controlling organization member" ;
	rdfs:domain fibo-be-oac-cpty:ControlledParty ;
	rdfs:range cmns-org:OrganizationMember ;
	owl:inverseOf fibo-be-oac-cpty:isControllingMemberOf ;
	skos:definition "relates a controlled party to a controlling member of the organization" ;
	.

fibo-be-oac-cpty:hasMajorityControllingParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:isControlledPartyOf ;
	rdfs:label "has majority controlling party" ;
	rdfs:domain cmns-org:LegalEntity ;
	rdfs:range fibo-be-oac-cpty:MajorityControllingParty ;
	skos:definition "indicates a party that owns a controlling stake (over 50 percent) in the entity" ;
	.

fibo-be-oac-cpty:isAdvisedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:hasControllingParty ;
	rdfs:label "has advisor" ;
	rdfs:domain fibo-be-oac-cpty:ControlledParty ;
	rdfs:range fibo-fnd-oac-ctl:ControllingParty ;
	skos:definition "indicates the party that acts in an advisory capacity to the controlled party" ;
	.

fibo-be-oac-cpty:isBasedOnInvestmentEquity
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:isConferredBy ;
	rdfs:label "is based on investment equity" ;
	rdfs:domain fibo-be-oac-cpty:InvestmentBasedDeFactoControl ;
	rdfs:range fibo-be-oac-opty:InvestmentEquity ;
	skos:definition "indicates investment-based de facto control, which is is based on the holding of some investment equity by some party" ;
	.

fibo-be-oac-cpty:isControllingMemberOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:isPartyControlling ;
	rdfs:label "is controlling member of" ;
	rdfs:domain cmns-org:OrganizationMember ;
	rdfs:range fibo-be-oac-cpty:ControlledParty ;
	skos:definition "identifies a controlled organization over which the member has some measure of control" ;
	.

fibo-be-oac-cctl:Affiliate
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-cctl:isAffiliateOf ;
			owl:someValuesFrom fibo-be-oac-cctl:Affiliate ;
		]
		;
	rdfs:label "affiliate" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:unionOf (
			fibo-be-oac-cpty:ControlledParty
			fibo-be-oac-cpty:MajorityControllingParty
		) ;
	] ;
	skos:definition "party that is related to a legal entity, directly, or indirectly through one or more intermediaries, and controls, or is controlled by, or is under common control with that entity, typically determined by the degree of ownership" ;
	.

fibo-be-oac-cctl:Affiliation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:Control ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasActor ;
			owl:someValuesFrom fibo-be-oac-cctl:ControllingAffiliate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasUndergoer ;
			owl:someValuesFrom fibo-be-oac-cctl:ControlledAffiliate ;
		]
		;
	rdfs:label "affiliation" ;
	skos:definition "situation in which a controlled party is affiliated with a controlling party for some period of time" ;
	.

fibo-be-oac-cctl:ControlledAffiliate
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:ControlledParty ,
		fibo-be-oac-cctl:Affiliate ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:allValuesFrom cmns-org:LegalEntity ;
		]
		;
	rdfs:label "controlled affiliate" ;
	skos:definition "controlled party in an affiliation situation" ;
	.

fibo-be-oac-cctl:ControllingAffiliate
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:MajorityControllingParty ,
		fibo-be-oac-cctl:Affiliate
		;
	rdfs:label "controlling affiliate" ;
	skos:definition "controlling party in an affiliation situation" ;
	.

fibo-be-oac-cctl:DomesticUltimateParent
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-cctl:TotalControllingInterestParty ;
	rdfs:label "domestic ultimate parent" ;
	skos:definition "party that is recognized as the ultimate parent of a given organization within the country or jurisdiction of incorporation or organization" ;
	.

fibo-be-oac-cctl:GlobalUltimateParent
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-cctl:TotalControllingInterestParty ;
	rdfs:label "global ultimate parent" ;
	skos:definition "party that is recognized as the ultimate parent of a given organization world-wide" ;
	.

fibo-be-oac-cctl:JointVenturePartner
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:EntityControllingParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControllingPartyOf ;
			owl:someValuesFrom fibo-be-le-fbo:JointVenture ;
		]
		;
	rdfs:label "joint venture partner" ;
	skos:definition "party that shares capital, technology, human resources, risks, and benefits of an entity under shared control" ;
	.

fibo-be-oac-cctl:SignificantShareholder
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-cctl:VotingShareholder ;
	rdfs:label "significant shareholder" ;
	skos:definition "party that owns a significant voting stake in an organization that is less than 50 percent but greater than some threshold" ;
	cmns-av:explanatoryNote "Note that the concept of significance varies depending on the jurisdiction, and particularly with respect to reporting requirements. For example, in some cases, three (3) percent ownership of any class or series of shares is considered significant, and in others it means more than five or ten percent of the total combined voting power across all classes of securities." ;
	.

fibo-be-oac-cctl:Subsidiary
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-cctl:ControlledAffiliate ;
	rdfs:label "subsidiary" ;
	skos:definition "legal entity that is entirely or majority owned and controlled by another legal entity" ;
	cmns-av:explanatoryNote "A subsidiary is a separate, distinct legal entity from its parent company(ies) for the purposes of taxation, regulatory compliance, and with respect to liability." ;
	.

fibo-be-oac-cctl:TotalControllingInterestParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:TotalOwner ,
		fibo-be-oac-cctl:SignificantShareholder
		;
	rdfs:label "total controlling interest party" ;
	skos:definition "voting shareholder that owns 100 percent of the voting shares in some legal entity" ;
	cmns-av:explanatoryNote "By virtue of holding 100 percent of the share ownership, the total controlling interest company also holds 100 percent of the controlling equity, if there is a difference. Therefore, it is both a total owner and a total controlling party." ;
	cmns-av:synonym "parent company" ;
	.

fibo-be-oac-cctl:VotingShareholder
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:DeJureControllingInterestParty ,
		fibo-be-oac-cown:Shareholder ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-exec:elects ;
			owl:onClass fibo-be-oac-exec:BoardMember ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "voting shareholder" ;
	skos:definition "shareholder whose shares confer the right to vote in corporate elections, including the right to elect directors at annual or special meetings, and to express their views to corporate management and directors on significant issues that may affect the value of those shares" ;
	cmns-av:explanatoryNote "A voting shareholder may exercise control over board composition by (1) attending a shareholder meeting and voting directly, (2) assigning a proxy to vote on their behalf, either as specified in the recommendations made in the proxy card or as indicated in a manner that deviates from those recommendations but is detailed on the proxy card, (3) by rejection of the proxy, either implicitly or explicitly, or (4) through a direct ballot that they create themselves." ;
	.

fibo-be-oac-cctl:hasAffiliate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:isControlledPartyOf ;
	rdfs:label "has affiliate" ;
	rdfs:domain cmns-org:LegalEntity ;
	rdfs:range fibo-be-oac-cctl:Affiliate ;
	skos:definition "has a party which directly, or indirectly through one or more intermediaries, controls, or is controlled by, or is under common control with the company" ;
	.

fibo-be-oac-cctl:hasControllingAffiliate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-be-oac-cctl:isAffiliateOf ,
		cmns-pts:isAffectedBy
		;
	rdfs:label "has controlling affiliate" ;
	rdfs:domain fibo-be-oac-cctl:ControlledAffiliate ;
	rdfs:range fibo-be-oac-cctl:ControllingAffiliate ;
	skos:definition "is directly, or indirectly through one or more intermediaries, controlled by" ;
	.

fibo-be-oac-cctl:hasDomesticUltimateParent
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-oac-cpty:hasMajorityControllingParty ;
	rdfs:label "has domestic ultimate parent" ;
	rdfs:range fibo-be-oac-cctl:DomesticUltimateParent ;
	skos:definition "relates an organization to another recognized as its ultimate parent, within its country or jurisdiction of incorporation, if it has one" ;
	skos:editorialNote "In the case of companies that are subsidiaries of another company that itself has a parent, this identifies the organization at the top of the hierarchy of organizations in the country of registration. Adapted from consensus definition of Ultimate Parent, now that this is split into national and global parent." ;
	cmns-av:adaptedFrom "consensus definition of ultimate parent, with the split between domestic and global parent" ;
	.

fibo-be-oac-cctl:hasGlobalUltimateParent
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-oac-cpty:hasMajorityControllingParty ;
	rdfs:label "has global ultimate parent" ;
	rdfs:range fibo-be-oac-cctl:GlobalUltimateParent ;
	skos:definition "relates an organization to another recognized as its ultimate parent, if it has one" ;
	skos:editorialNote "In the case of companies that are subsidiaries of another company that itself has a parent, this identifies the organization at the top of the hierarchy, world-wide. Adapted from consensus definition of Ultimate Parent, now that this is split into national and global parent." ;
	cmns-av:adaptedFrom "consensus definition of ultimate parent, with the split between domestic and global parent" ;
	.

fibo-be-oac-cctl:hasSubsidiary
	a owl:ObjectProperty ;
	rdfs:label "has subsidiary" ;
	rdfs:domain cmns-org:LegalEntity ;
	rdfs:range fibo-be-oac-cctl:Subsidiary ;
	owl:propertyChainAxiom (
		cmns-rlcmp:playsRole
		fibo-be-oac-cctl:isParentCompanyOf
	) ;
	skos:definition "relates a legal entity to another organization that it owns at least 50 percent of" ;
	.

fibo-be-oac-cctl:isAffiliateOf
	a
		owl:ObjectProperty ,
		owl:SymmetricProperty
		;
	rdfs:label "is affiliate of" ;
	rdfs:domain fibo-be-oac-cctl:Affiliate ;
	rdfs:range fibo-be-oac-cctl:Affiliate ;
	skos:definition "relates a party which directly, or indirectly through one or more intermediaries, controls, or is controlled by, or is under common control by another party to that party" ;
	.

fibo-be-oac-cctl:isControllingAffiliateOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-be-oac-cctl:isAffiliateOf ,
		cmns-pts:actsOn
		;
	rdfs:label "is controlling affiliate of" ;
	rdfs:domain fibo-be-oac-cctl:ControllingAffiliate ;
	rdfs:range fibo-be-oac-cctl:ControlledAffiliate ;
	owl:inverseOf fibo-be-oac-cctl:hasControllingAffiliate ;
	skos:definition "controls directly, or indirectly through one or more intermediaries" ;
	.

fibo-be-oac-cctl:isParentCompanyOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-oac-cctl:isControllingAffiliateOf ;
	rdfs:label "is parent company of" ;
	rdfs:domain fibo-be-oac-cctl:ControllingAffiliate ;
	rdfs:range fibo-be-oac-cctl:Subsidiary ;
	owl:inverseOf fibo-be-oac-cctl:isSubsidiaryOf ;
	skos:definition "indicates a controlled affiliate that it owns at least 50 percent of" ;
	.

fibo-be-oac-cctl:isSubsidiaryOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-oac-cctl:hasControllingAffiliate ;
	rdfs:label "is subsidiary of" ;
	rdfs:domain fibo-be-oac-cctl:Subsidiary ;
	rdfs:range fibo-be-oac-cctl:ControllingAffiliate ;
	skos:definition "is controlled directly, or indirectly through one or more intermediaries and owned at least 50 percent by" ;
	.

fibo-be-oac-cctl:isWhollyOwnedBy
	a owl:ObjectProperty ;
	rdfs:label "is wholly owned by" ;
	rdfs:domain cmns-org:LegalEntity ;
	rdfs:range fibo-be-oac-cctl:TotalControllingInterestParty ;
	owl:propertyChainAxiom (
		cmns-rlcmp:playsRole
		fibo-be-oac-cctl:isSubsidiaryOf
	) ;
	skos:definition "relates a legal entity to a party that has 100 percent ownership and control over it" ;
	.

fibo-be-oac-cown:BeneficialOwner
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Owner ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-cown:isBeneficialOwnerOf ;
			owl:someValuesFrom fibo-fnd-oac-own:Asset ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-bauth:delegatesControlTo ;
			owl:someValuesFrom fibo-be-oac-exec:ControllingNominee ;
		]
		;
	rdfs:label "beneficial owner" ;
	skos:definition "party that enjoys the benefits of ownership (such as receipt of income) of something even though its ownership (title) may be in the name of another party (called a nominee or registered owner)" ;
	cmns-av:adaptedFrom
		"https://en.wikipedia.org/wiki/Beneficial_ownership#Financial_Action_Task_Force_on_Money_Laundering_(FATF)"^^xsd:anyURI ,
		"https://www.fincen.gov/resources/statutes-regulations/guidance/guidance-obtaining-and-retaining-beneficial-ownership"^^xsd:anyURI ,
		"https://www.ncua.gov/regulation-supervision/letters-credit-unions-other-guidance/beneficial-ownership-requirements-legal-entity-customers-overview"^^xsd:anyURI
		;
	cmns-av:explanatoryNote
		"From World Bank Report: In identifying the beneficial owner, the focus should be on two factors: the control exercised and the benefit derived. Control of a corporate vehicle will always depend on context, as control can be exercised in many different ways, including through ownership, contractually or informally." ,
		"The Financial Action Task Force on Money Laundering (FATF) refers to a 'beneficial owner' as the natural person(s) who ultimately owns or controls a legal entity and/or the natural person on whose behalf a transaction is being conducted. It also includes those persons who exercise ultimate effective control over a legal person or arrangement." ,
		"The National Credit Union Administration (NCUA) defines a 'beneficial owner' as (1) a single individual with significant responsibility to control, manage or direct a legal entity customer, or (2) each individual, if any, who, directly or indirectly, through any contract, arrangement, understanding, relationship or otherwise, owns 25 percent or more of the equity interests of a legal entity customer; if a trust owns directly or indirectly, through any contract, arrangement, understanding, relationship or otherwise, 25 percent or more of the equity interests of a legal entity customer, the beneficial owner is the trustee." ,
		"Use of a nominee (who may be an agent, custodian, or a trustee) does not change the position regarding tax reporting and tax liability, and the beneficial owner remains responsible."
		;
	.

fibo-be-oac-cown:BeneficialOwnership
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Ownership ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:hasOwnedAsset ;
			owl:someValuesFrom fibo-fnd-oac-own:Asset ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:hasOwningParty ;
			owl:someValuesFrom fibo-be-oac-cown:BeneficialOwner ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:isRegisteredBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					cmns-ra:Registrar
					cmns-ra:RegistrationAuthority
				) ;
			] ;
		]
		;
	rdfs:label "beneficial ownership" ;
	skos:definition "situation linking party that enjoys the benefits of ownership (such as receipt of income) of something even though its ownership (title) may be in the name of another party (called a nominee or registered owner) to the asset that they own" ;
	cmns-av:explanatoryNote "Beneficial ownership may be shared among a group of individuals. If a beneficial owner acquires a position of more than 5 percent in the United States, it must file Schedule 13D or 13G under Section 12 of the Securities Exchange Act of 1934." ;
	.

fibo-be-oac-cown:PurchaseLot
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:FinancialAsset ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-cown:consistsOfNumberOfUnits ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "purchase lot" ;
	skos:definition "financial asset that is a block of securities or other financial assets bought in one transaction on a given date at a specific price" ;
	skos:example "Buying 100 shares of Apple on Jan 10 at $150/share is one purchase lot; buying 50 more shares on Mar 15 at $160/share is another purchase lot." ;
	cmns-av:explanatoryNote "Purchase lot is typically used as a trading term by brokers and portfolio managers to describe how holdings are grouped." ;
	.

fibo-be-oac-cown:Shareholder
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-opty:ConstitutionalOwner ,
		fibo-fnd-agr-ctr:Counterparty
		;
	rdfs:label "shareholder" ;
	skos:definition "party that owns shares in and has rights and responsibilities with respect to some asset, provided in exchange for investment" ;
	cmns-av:explanatoryNote "The shares represent an ownership interest in a corporation, mutual fund, or partnership, or a unit of ownership in a structured product, such as a real estate investment trust." ;
	cmns-av:synonym "stockholder"@en-US ;
	.

fibo-be-oac-cown:Shareholding
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:FinancialAsset ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-cown:consistsOfNumberOfUnits ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom fibo-sec-eq-eq:Share ;
		]
		;
	rdfs:label "shareholding" ;
	skos:definition "ownership interest in the equity of a company, represented by shares that confer financial rights and governance privileges" ;
	cmns-av:explanatoryNote "Shareholding refers to the total ownership a party has in some organization, and determines voting power, dividend entitlement, and exposure to risk." ;
	.

fibo-be-oac-cown:TaxLot
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:FinancialAsset ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-cown:consistsOfNumberOfUnits ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "tax lot" ;
	skos:definition "financial asset that is a block of securities or other financial assets with a distinct cost basis for tax reporting purposes" ;
	cmns-av:explanatoryNote """Tax lots reflect how shares or other assets are tracked for capital gains and may be adjusted by events including:
- reinvested dividends (creates very small, new tax lots);
- stock splits or mergers (adjusts basis, may create fractional lots);
- Wash sale rules (can change which lots are recognized).
When an investor sells, they select which tax lot to sell (specific ID, FIFO, etc.), which determines realized gain or loss.""" ;
	.

fibo-be-oac-cown:consistsOfNumberOfUnits
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasAmount ;
	rdfs:label "consists of number of units"@en ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the number of units of"@en ;
	cmns-av:explanatoryNote "This property indicates the number of units (e.g., shares, fund units) of the asset held in a shareholding or position, for example." ;
	.

fibo-be-oac-cown:hasBeneficialOwner
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-own:isAssetOf ;
	rdfs:label "has beneficial owner" ;
	rdfs:domain fibo-fnd-oac-own:Asset ;
	rdfs:range fibo-be-oac-cown:BeneficialOwner ;
	skos:definition "indicates the party that retains rights in the asset they own in a beneficial ownership situation" ;
	.

fibo-be-oac-cown:isBeneficialOwnerOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-own:ownsAsset ;
	rdfs:label "is beneficial owner of" ;
	rdfs:domain fibo-be-oac-cown:BeneficialOwner ;
	rdfs:range fibo-fnd-oac-own:Asset ;
	owl:inverseOf fibo-be-oac-cown:hasBeneficialOwner ;
	skos:definition "indicates an asset in which the beneficial owner holds rights (typically voting rights, management rights, etc.) in a beneficial ownership situation" ;
	.

fibo-be-oac-exec:ArticlesOfIncorporation
	a owl:Class ;
	rdfs:subClassOf fibo-be-le-cb:InstrumentOfIncorporation ;
	rdfs:label "articles of incorporation" ;
	skos:definition "contract that establishes a new corporation or, when amended, adjusts the legal basis for the corporation, and outlines basic information about the corporation, including the type of business, and a description of the business' operational characteristics" ;
	cmns-av:synonym "articles of association" ;
	.

fibo-be-oac-exec:Auditor
	a owl:Class ;
	rdfs:subClassOf cmns-bauth:AuthorizedParty ;
	rdfs:label "auditor" ;
	skos:definition "party qualified and authorized to review and verify the accuracy of financial records and ensure that companies comply with tax laws" ;
	cmns-av:explanatoryNote
		"An auditor is authorized to audit one or more specific organizations, i.e., by the authorizing party indicated by the situation." ,
		"An auditor may be an internal auditor - an individual whose primary job function is to audit his or her own company, or an external auditor - an individual from outside the company, who typically is employed by an auditing firm who handles many different clients."
		;
	.

fibo-be-oac-exec:Authorization
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass cmns-bauth:Authorization ;
	.

fibo-be-oac-exec:AuthorizedIndividual
	a owl:Class ;
	rdfs:subClassOf
		cmns-bauth:ResponsibleParty ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "authorized individual" ;
	skos:definition "role of an individual that has been given the responsibility to act on behalf of another party under some set of guidelines" ;
	.

fibo-be-oac-exec:AuthorizedParty
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass cmns-bauth:AuthorizedParty ;
	.

fibo-be-oac-exec:AuthorizingParty
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass cmns-bauth:AuthorizingParty ;
	.

fibo-be-oac-exec:BoardCapacity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:DelegatedLegalAuthority ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:onClass fibo-be-oac-exec:CompanyLaw ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:isConferredOn ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:playsRole ;
				owl:someValuesFrom fibo-be-oac-exec:BoardMember ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-be-le-cb:BoardAgreement
					fibo-be-le-cb:InstrumentOfIncorporation
					fibo-be-oac-exec:Bylaws
				) ;
			] ;
		]
		;
	rdfs:label "board capacity" ;
	skos:definition "authority to act in a fiduciary capacity with respect to the organization, including but not limited to determining and executing corporate policy" ;
	.

fibo-be-oac-exec:BoardCompositionControl
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:Control ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:hasPartyInControl ;
			owl:onClass [
				a owl:Class ;
				owl:unionOf (
					fibo-be-oac-cctl:SignificantShareholder
					fibo-be-oac-opty:EntityOwner
				) ;
			] ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:involvesControlledThing ;
			owl:someValuesFrom fibo-be-oac-exec:BoardMember ;
		]
		;
	rdfs:label "board composition control" ;
	skos:definition "situation in which a voting shareholder, entity owner, or some other party in the case of a not-for-profit organization, appoints and/or nominates someone to the board of directors of an organization for some period of time" ;
	.

fibo-be-oac-exec:BoardMember
	a owl:Class ;
	rdfs:subClassOf
		cmns-bauth:LegallyDelegatedAuthority ,
		cmns-bauth:ResponsibleParty ,
		cmns-org:OrganizationMember ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:isMemberOf ;
				owl:someValuesFrom [
					a owl:Restriction ;
					owl:onProperty cmns-rlcmp:playsRole ;
					owl:someValuesFrom fibo-be-oac-exec:BoardOfDirectors ;
				] ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-be-le-cb:BoardAgreement ;
			] ;
		]
		;
	rdfs:label "board member" ;
	skos:definition "party that has fiduciary responsibility with respect to the organization, including but not limited to determining and executing corporate policy" ;
	.

fibo-be-oac-exec:BoardMembership
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-ctl:Control ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:hasPartyInControl ;
			owl:someValuesFrom fibo-be-oac-exec:BoardMember ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:involvesControlledThing ;
			owl:someValuesFrom fibo-be-oac-cpty:ControlledParty ;
		]
		;
	rdfs:label "board membership" ;
	skos:definition "situation relating an individual member of the board of directors to the organization" ;
	.

fibo-be-oac-exec:BoardOfDirectors
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:EntityControllingParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-exec:nominates ;
			owl:someValuesFrom fibo-be-oac-exec:CorporateOfficer ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-law-lcap:hasCapacity ;
				owl:someValuesFrom fibo-be-oac-exec:BoardCapacity ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:hasMember ;
				owl:someValuesFrom [
					a owl:Restriction ;
					owl:onProperty cmns-rlcmp:playsRole ;
					owl:someValuesFrom fibo-be-oac-exec:BoardMember ;
				] ;
			] ;
		]
		;
	rdfs:label "board of directors" ;
	skos:definition "group of people comprising the governing body of an organization that has the authority to set organizational strategy and policies as well as to select and, to some degree manage, leadership" ;
	cmns-av:explanatoryNote "For a public, for profit organization, its members (directors) are elected normally by the subscribers (stockholders) of the firm (generally at an annual general meeting) to govern the firm and look after the subscribers' interests. In the case of a not-for-profit organization, the board ensures the organization is acting in line with its mission. The board has the ultimate decision-making authority and, in general, is empowered to (1) set the company's policy, objectives, and overall direction, (2) adopt bylaws, (3) name members of the advisory, executive, finance, and other committees, (4) hire, monitor, evaluate, and fire the managing director and senior executives, (5) determine and pay the dividend, and (6) issue additional shares. Though all its members might not be engaged in the company's day-to-day operations, the entire board is held liable (under the doctrine of collective responsibility) for the consequences of the firm's policies, actions, and failures to act. Members of the board usually include senior-most executives (called inside directors or executive directors) as well as experts or respected persons chosen from the wider community (called outside directors or non-executive directors)." ;
	.

fibo-be-oac-exec:Bylaws
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-cor:Law ;
	rdfs:label "bylaws" ;
	skos:definition "written rules for conduct of a corporation, association, partnership or any organization" ;
	cmns-av:synonym
		"byelaws" ,
		"membership agreement"
		;
	.

fibo-be-oac-exec:ChiefExecutiveOfficer
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:CorporateOfficer ,
		fibo-be-oac-exec:ExecutiveBoardMember ,
		fibo-be-oac-exec:PrincipalParty ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:manages ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					cmns-org:FormalOrganization
					cmns-org:LegalEntity
				) ;
			] ;
		]
		;
	rdfs:label "chief executive officer" ;
	skos:definition "top corporate officer responsible for an organization's overall operations and performance" ;
	cmns-av:abbreviation "CEO" ;
	cmns-av:explanatoryNote "He or she is the leader of the firm, serves as the main link between the board of directors (the board) and the firm's various parts or levels, and is held solely responsible for the firm's success or failure. One of the major duties of a CEO is to maintain and implement corporate policy, as established by the board. Also called President or managing director, he or she may also be the chairman (or chairperson) of the board." ;
	.

fibo-be-oac-exec:ChiefFinancialOfficer
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-exec:CorporateOfficer ;
	rdfs:label "chief financial officer" ;
	skos:definition "senior-most corporate officer responsible for financial control and planning for an organization or project" ;
	cmns-av:abbreviation "CFO" ;
	cmns-av:explanatoryNote "He or she is in charge of all accounting functions including (1) credit control, (2) preparing budgets and financial statements, (3) coordinating financing and fund raising, (4) monitoring expenditure and liquidity, (5) managing investment and taxation issues, (6) reporting financial performance to the board, and (7) providing timely financial data to the CEO. Also called chief finance officer, comptroller, controller, or finance controller." ;
	.

fibo-be-oac-exec:CompanyLaw
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-cor:StatuteLaw ;
	rdfs:label "company law" ;
	skos:definition "legislation under which the formation, registration or incorporation, governance, and dissolution of a firm is administered and controlled" ;
	cmns-av:synonym "corporate law" ;
	.

fibo-be-oac-exec:CompanySecretary
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-exec:CorporateOfficer ;
	rdfs:label "company secretary" ;
	skos:definition "corporate officer appointed by the directors of an organization, responsible for ensuring compliance with legal obligations related to corporate governance" ;
	cmns-av:explanatoryNote "His or her formal duties include (1) calling meetings, (2) recording minutes of the meetings, (3) keeping statutory record books, (4) proper payment of dividend and interest payments, and (5) proper drafting and execution of agreements, contracts, and resolutions." ;
	cmns-av:synonym "corporate secretary" ;
	.

fibo-be-oac-exec:ControllingNominee
	a owl:Class ;
	rdfs:subClassOf
		cmns-bauth:LegallyDelegatedAuthority ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-bauth:hasDelegatedControlOf ;
			owl:someValuesFrom fibo-fnd-oac-own:Asset ;
		]
		;
	rdfs:label "controlling nominee"@en ;
	skos:definition "party that holds legal title to an asset (e.g., stocks, bonds, or property) on behalf of the beneficial owner" ;
	cmns-av:explanatoryNote "The nominee is typically the registered owner of an asset, named in official records." ;
	.

fibo-be-oac-exec:CorporateBylaws
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:Bylaws ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-cb:hasSharesAuthorized ;
			owl:someValuesFrom xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "corporate bylaws" ;
	skos:definition "written rules for conduct of a corporation, adopted by the board of directors" ;
	cmns-av:explanatoryNote "Corporate bylaws may contain any provision, not inconsistent with law or with the certificate of incorporation, relating to the business of the corporation, the conduct of its affairs, and its rights or powers or the rights or powers of its stockholders, directors, officers or employees. Changes to the bylaws of a corporation require a board-level resolution and may require a vote of the shareholders." ;
	.

fibo-be-oac-exec:CorporateOfficer
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:Executive ,
		fibo-be-oac-exec:Signatory ,
		cmns-org:OrganizationMember
		;
	rdfs:label "corporate officer" ;
	skos:definition "high-level management executive of a corporation or other organization, hired by the board of directors or the business owner(s), charged with certain operational responsibilities, and who has the authority to act on behalf of the organization, including the authority to enter into contracts on behalf of the organization" ;
	skos:example "Corporate officers may include a Chief Executive Officer (CEO), Chief Financial Officer (CFO), president, vice president(s), and in some cases a Chief Operating Officer (COO), Chief Compliance Officer (CCO), or other executive responsible for a critical function in the organization." ;
	cmns-av:explanatoryNote
		"In banking, corporate officers have the legal capacity to execute some documents and make certain decisions on behalf of the institution due to the nature of the business. The level of authority varies depending on the role the officer plays, however, and based on bank policy. In large institutions, corporate officers may include loan/lending officers, those in certain supervisory roles, and others with varying degrees of authority, and frequently they are given a 'vice president' title, particularly if they are customer facing. Hiring and other decisions related to such corporate officers may be delegated to more operational levels, rather than by the board directly, with respect to such personnel." ,
		"Note that in most cases in the United States, corporate officers, especially those with signatory capacity and other fiduciary responsibilities must be employees, especially with respect to financial institutions and other highly regulated domains. There are cases, however, when an independent contractor or professional services provider may play the role of a corporate officer, such as a 'CFO for hire', which is a common practice in start-up organizations."
		;
	.

fibo-be-oac-exec:Executive
	a owl:Class ;
	rdfs:subClassOf
		cmns-bauth:LegallyDelegatedAuthority ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "executive" ;
	skos:definition "person appointed and given the responsibility to manage the affairs of an organization and the authority to make decisions within specified role-specific boundaries" ;
	.

fibo-be-oac-exec:ExecutiveBoardMember
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:BoardMember ,
		fibo-fnd-org-fm:Employee
		;
	rdfs:label "executive board member" ;
	owl:disjointWith fibo-be-oac-exec:NonExecutiveBoardMember ;
	skos:definition "member of a board of directors that is also an employee of the organization" ;
	cmns-av:synonym "inside director" ;
	.

fibo-be-oac-exec:ExternalAuditor
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-exec:Auditor ;
	rdfs:label "external auditor" ;
	owl:disjointWith fibo-be-oac-exec:InternalAuditor ;
	skos:definition "independent party qualified and authorized to examine and report on the accuracy of financial records and ensure that companies comply with tax laws" ;
	cmns-av:explanatoryNote "An external auditor is an individual or organization from outside the company, who typically is employed by an auditing firm that handles many different clients." ;
	.

fibo-be-oac-exec:InternalAuditor
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:Auditor ,
		fibo-fnd-org-fm:Employee
		;
	rdfs:label "internal auditor" ;
	skos:definition "employee who is qualified and authorized to review and verify the accuracy of financial records and evaluate internal controls and compliance" ;
	.

fibo-be-oac-exec:LegallyDelegatedAuthority
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass cmns-bauth:LegallyDelegatedAuthority ;
	.

fibo-be-oac-exec:NonExecutiveBoardMember
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-exec:BoardMember ;
	rdfs:label "non-executive board member" ;
	skos:definition "member of the board of directors of an organization that has no executive responsibilities towards the running of that organization" ;
	cmns-av:synonym "outside director" ;
	.

fibo-be-oac-exec:PrincipalParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:Signatory ,
		cmns-org:OrganizationMember
		;
	rdfs:label "principal party" ;
	skos:definition "controlling party that is responsible for the management of daily business operations of an organization" ;
	.

fibo-be-oac-exec:Signatory
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:AuthorizedIndividual ,
		cmns-bauth:LegallyDelegatedAuthority ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-law-lcap:hasCapacity ;
				owl:someValuesFrom fibo-fnd-law-lcap:SignatoryCapacity ;
			] ;
		]
		;
	rdfs:label "signatory" ;
	skos:definition "responsible party authorized to sign agreements on behalf of themselves, another person, or an organization" ;
	.

fibo-be-oac-exec:authorizes
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:authorizes ;
	.

fibo-be-oac-exec:authorizesThrough
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:authorizesThrough ;
	.

fibo-be-oac-exec:delegatesControlTo
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:delegatesControlTo ;
	.

fibo-be-oac-exec:designatesSignatory
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-bauth:authorizes ,
		cmns-org:designates
		;
	rdfs:label "designates signatory" ;
	rdfs:range fibo-be-oac-exec:Signatory ;
	skos:definition "authorizes to sign agreements, access accounts and/or perform other similar tasks" ;
	.

fibo-be-oac-exec:elects
	a owl:ObjectProperty ;
	rdfs:label "elects" ;
	rdfs:domain cmns-pts:PartyRole ;
	rdfs:range cmns-pts:PartyRole ;
	skos:definition "chooses someone, or a group of individuals, to hold office or some other position by voting" ;
	skos:editorialNote "In the case of an election of the members of a board of directors, the bylaws state the manner in which that process is effected. The candidate members may be recommended by the board or other proxy and are then elected by the shareholders. A similar process may be conducted to elect outside auditors." ;
	skos:example "the election of officers of an association, the election of directors by the shareholders" ;
	.

fibo-be-oac-exec:hasAuthorizedParty
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:hasAuthorizedParty ;
	.

fibo-be-oac-exec:hasAuthorizingParty
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:hasAuthorizingParty ;
	.

fibo-be-oac-exec:hasCorporateOfficer
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:hasControllingParty ;
	rdfs:label "has corporate officer" ;
	rdfs:domain fibo-be-oac-cpty:ControlledParty ;
	rdfs:range fibo-be-oac-exec:CorporateOfficer ;
	skos:definition "indicates an officer of the organization" ;
	.

fibo-be-oac-exec:hasDelegatedControlOf
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:hasDelegatedControlOf ;
	.

fibo-be-oac-exec:hasDirector
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:hasControllingParty ;
	rdfs:label "has director" ;
	rdfs:domain fibo-be-oac-cpty:ControlledParty ;
	rdfs:range fibo-be-oac-exec:BoardMember ;
	skos:definition "indicates a member of the board of directors of the organization" ;
	.

fibo-be-oac-exec:hasPrincipalManagingParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-oac-cpty:hasControllingOrganizationMember ;
	rdfs:label "has principal managing party" ;
	rdfs:domain fibo-be-oac-cpty:ControlledParty ;
	rdfs:range fibo-be-oac-exec:PrincipalParty ;
	owl:inverseOf fibo-be-oac-exec:isPrincipalPartyOf ;
	skos:definition "indicates a controlling party that is responsible for the management of daily business operations" ;
	.

fibo-be-oac-exec:hasResponsibility
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-law-lcap:hasCapacity ;
	rdfs:label "has responsibility" ;
	rdfs:domain cmns-pts:Party ;
	rdfs:range fibo-fnd-law-lcap:Duty ;
	skos:definition "specifies a commitment or obligation that an independent party has" ;
	.

fibo-be-oac-exec:hasResponsibleParty
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:hasResponsibleParty ;
	.

fibo-be-oac-exec:hasSigningAuthorityFor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-bauth:isAuthorizedBy ;
	rdfs:label "has signing authority for" ;
	rdfs:domain fibo-be-oac-exec:Signatory ;
	owl:inverseOf fibo-be-oac-exec:designatesSignatory ;
	skos:definition "indicates the party for which a signatory has the ability to sign agreements, access accounts and perform related tasks" ;
	.

fibo-be-oac-exec:hasVestedInIt
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-law-lcap:hasCapacity ;
	rdfs:label "has vested in it" ;
	rdfs:domain cmns-bauth:LegallyDelegatedAuthority ;
	rdfs:range fibo-fnd-law-lcap:DelegatedLegalAuthority ;
	skos:definition "indicates the delegated legal authority that is vested in the controlling party" ;
	.

fibo-be-oac-exec:isAuthorizedBy
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:isAuthorizedBy ;
	.

fibo-be-oac-exec:isAuthorizedThrough
	a owl:ObjectProperty ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentProperty cmns-bauth:isAuthorizedThrough ;
	.

fibo-be-oac-exec:isDirectorOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:isPartyControlling ;
	rdfs:label "is director of" ;
	rdfs:domain fibo-be-oac-exec:BoardMember ;
	rdfs:range fibo-be-oac-cpty:ControlledParty ;
	owl:inverseOf fibo-be-oac-exec:hasDirector ;
	skos:definition "indicates the organization that the board member oversees" ;
	.

fibo-be-oac-exec:isOfficerOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-oac-ctl:isPartyControlling ;
	rdfs:label "is officer of" ;
	rdfs:domain fibo-be-oac-exec:CorporateOfficer ;
	rdfs:range fibo-be-oac-cpty:ControlledParty ;
	owl:inverseOf fibo-be-oac-exec:hasCorporateOfficer ;
	skos:definition "indicates the organization that the person has some authority over and managerial responsibility for" ;
	.

fibo-be-oac-exec:isPrincipalPartyOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-oac-cpty:isControllingMemberOf ;
	rdfs:label "is principal party of" ;
	rdfs:domain fibo-be-oac-exec:PrincipalParty ;
	rdfs:range fibo-be-oac-cpty:ControlledParty ;
	skos:definition "identifies a legal entity (controlled party) over which a principal has some measure of control" ;
	.

fibo-be-oac-exec:nominates
	a owl:ObjectProperty ;
	rdfs:label "nominates" ;
	rdfs:domain cmns-pts:PartyRole ;
	rdfs:range cmns-pts:PartyRole ;
	skos:definition "appoints or proposes for appointment to an office or place" ;
	cmns-av:usageNote "Note that nominates is defined as a relation between two parties-in-role (the range of which could be a corporation or partnership in the case of an auditor), whereas appoints between independent parties." ;
	.

fibo-be-oac-opty:ConstitutionalOwner
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-opty:EntityOwner ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:someValuesFrom fibo-fnd-oac-own:ShareholdersEquity ;
		]
		;
	rdfs:label "constitutional owner" ;
	skos:definition "entity owner that holds an equity stake in said entity, in the form of shareholders' equity" ;
	cmns-av:explanatoryNote "Typically this would be share ownership or the holding of partnership equity. Ownership in this 'constitutional' sense means that the owner is in some way a member of the organization, such as an employee or director, as distinct from some outside investor." ;
	.

fibo-be-oac-opty:ControllingEquity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:ShareholdersEquity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:confers ;
			owl:allValuesFrom fibo-fnd-oac-ctl:DeJureControl ;
		]
		;
	rdfs:label "controlling equity" ;
	skos:definition "shareholders's equity that formally confers control in the entity, either by law or as explicitly stated in a corresponding equity instrument" ;
	.

fibo-be-oac-opty:DirectConsolidation
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
	rdfs:label "direct consolidation" ;
	skos:definition "direct ownership of an entity recorded as accounting consolidation" ;
	.

fibo-be-oac-opty:EntityOwner
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Owner ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:someValuesFrom fibo-fnd-oac-own:OwnersEquity ;
		]
		;
	rdfs:label "entity owner" ;
	skos:definition "owner (person, group of people, or other business entity) that owns, or holds an ownership interest in, a formal business organization" ;
	.

fibo-be-oac-opty:EntityOwnership
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Ownership ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isQualifiedBy ;
			owl:onClass fibo-be-le-lei:RelationshipQualifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:onClass [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-agr-ctr:Contract
					fibo-fnd-oac-own:OwnersEquity
				) ;
			] ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-le-lei:hasOwnershipPercentage ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-be-le-lei:RelationshipStatus ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-opty:hasOwnedEntity ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-be-le-fbo:NotForProfitOrganization
					fibo-be-le-lp:BusinessEntity
					cmns-org:LegalEntity
				) ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-opty:hasOwningEntity ;
			owl:someValuesFrom cmns-org:LegalPerson ;
		]
		;
	rdfs:label "entity ownership" ;
	skos:definition "ownership by some party of an interest in some non-governmental formal organization" ;
	.

fibo-be-oac-opty:ForeignBranchOwnership
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
	rdfs:label "foreign branch ownership" ;
	skos:definition "ownership by some party of some formal organization or organizational sub-unit that is a foreign affiliate and legally part of the owning entity" ;
	.

fibo-be-oac-opty:InvestmentEquity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:OwnersEquity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isHeldBy ;
			owl:someValuesFrom fibo-be-oac-opty:Investor ;
		]
		;
	rdfs:label "investment equity" ;
	skos:definition "equity that represents an ownership interest in some entity, but may or may not take the form of shareholders's equity" ;
	skos:editorialNote "Typically an investment in some entity may take the form of shares (issued or privately held), i.e., shareholders' equity, or it may take the form of some capital amount which is not reflected in shareholders' equity. In each case, there would typically be a contractual basis for the investment setting out what controls or other benefits accrue to the investor." ;
	.

fibo-be-oac-opty:Investor
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-opty:EntityOwner ,
		fibo-fnd-agr-ctr:ContractParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:someValuesFrom fibo-be-oac-opty:InvestmentEquity ;
		]
		;
	rdfs:label "investor" ;
	skos:definition "party that owns some stake in some organization by way of investment" ;
	skos:editorialNote "This is regardless of whether or not the investor is also a constitutional owner (e.g. shareholder) in the entity." ;
	.

fibo-be-oac-opty:InvestorContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:WrittenContract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:definesTermsFor ;
			owl:someValuesFrom fibo-be-oac-opty:InvestmentEquity ;
		]
		;
	rdfs:label "investor contract" ;
	skos:definition "Contract setting out the terms under which some investor invests in the entity and setting out the rights which are conferred on that investor." ;
	.

fibo-be-oac-opty:UltimateConsolidation
	a owl:Class ;
	rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
	rdfs:label "ultimate ownership" ;
	skos:definition "highest-level (top, end) ancestral ownership, evidenced by accounting consolidation, by some party of some other legal entity" ;
	.

fibo-be-oac-opty:guarantees
	a owl:ObjectProperty ;
	rdfs:label "guarantees" ;
	skos:definition "provides a formal assurance or promise, esp. that certain conditions shall be fulfilled relating to a product, service, or transaction" ;
	.

fibo-be-oac-opty:hasDirectOwnership
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:experiences ;
	rdfs:label "has direct ownership" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-be-le-fbo:NotForProfitOrganization
			fibo-be-le-lp:BusinessEntity
			cmns-org:LegalEntity
		) ;
	] ;
	rdfs:range fibo-be-oac-opty:EntityOwnership ;
	owl:inverseOf fibo-be-oac-opty:hasOwnedEntity ;
	skos:definition "relates a formal organization to the situation in which it is owned directly by another entity" ;
	.

fibo-be-oac-opty:hasDirectOwningEntity
	a owl:ObjectProperty ;
	rdfs:label "has direct owning entity" ;
	owl:propertyChainAxiom (
		fibo-be-oac-opty:hasDirectOwnership
		fibo-be-oac-opty:hasOwningEntity
	) ;
	skos:definition "relates a formal organization to a direct legal person / owner" ;
	.

fibo-be-oac-opty:hasInvestmentEntity
	a owl:ObjectProperty ;
	rdfs:label "has investment entity" ;
	owl:propertyChainAxiom (
		fibo-be-oac-opty:hasInvestmentOwnership
		fibo-be-oac-opty:hasOwnedEntity
	) ;
	skos:definition "relates a legal person to a directly owned formal organization or subsidiary, depending on the percent ownership interest" ;
	.

fibo-be-oac-opty:hasInvestmentOwnership
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:playsActiveRoleIn ;
	rdfs:label "has investment ownership" ;
	rdfs:domain cmns-org:LegalPerson ;
	rdfs:range fibo-be-oac-opty:EntityOwnership ;
	owl:inverseOf fibo-be-oac-opty:hasOwningEntity ;
	skos:definition "relates a legal person to the context in which it owns a formal organization" ;
	.

fibo-be-oac-opty:hasOwnedEntity
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isExperiencedBy ;
	rdfs:label "has owned entity" ;
	rdfs:domain fibo-be-oac-opty:EntityOwnership ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			fibo-be-le-fbo:NotForProfitOrganization
			fibo-be-le-lp:BusinessEntity
			cmns-org:LegalEntity
		) ;
	] ;
	skos:definition "indicates a formal organization, including potentially a sole proprietorship, that is owned by a legal person" ;
	.

fibo-be-oac-opty:hasOwningEntity
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasActiveParty ;
	rdfs:label "has owning entity" ;
	rdfs:domain fibo-be-oac-opty:EntityOwnership ;
	rdfs:range cmns-org:LegalPerson ;
	skos:definition "indicates a party that owns a formal organization" ;
	.

fibo-be-ptr-ptr:GeneralPartner
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:DeJureControllingInterestParty ,
		fibo-be-ptr-ptr:Partner ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-law-lcap:hasCapacity ;
				owl:someValuesFrom fibo-fnd-law-lcap:LiabilityCapacity ;
			] ;
		]
		;
	rdfs:label "general partner" ;
	owl:disjointWith fibo-be-ptr-ptr:LimitedPartner ;
	skos:definition "partner and part-owner that is responsible for managing the day to day operations of the partnership and that may be jointly and severally liable for the obligations of the partnership" ;
	cmns-av:explanatoryNote "Note that although typically a general partner is a person, in the context of certain funds, such as private equity, a general partner may be a firm that manages the fund." ;
	.

fibo-be-ptr-ptr:GeneralPartnership
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-ptr-ptr:Partnership ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-ptr-ptr:hasGeneralPartner ;
			owl:someValuesFrom fibo-be-ptr-ptr:GeneralPartner ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:playsRole ;
				owl:onClass fibo-be-ptr-ptr:GeneralPartner ;
				owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "general partnership" ;
	skos:definition "partnership that has at least two general partners that agree to share in all assets, profits, and financial and legal liabilities of the business" ;
	cmns-av:abbreviation "GP" ;
	cmns-av:explanatoryNote "General partnerships are the most basic and common form of partnership world-wide." ;
	.

fibo-be-ptr-ptr:LimitedLiabilityLimitedPartnership
	a owl:Class ;
	rdfs:subClassOf fibo-be-ptr-ptr:LimitedPartnership ;
	rdfs:label "limited liability limited partnership" ;
	skos:definition "limited partnership that consists of one or more general partners who are liable for the obligations of the entity as well as one or more protected limited liability partners" ;
	cmns-av:abbreviation "LLLP" ;
	cmns-av:explanatoryNote "The primary difference between an LLLP and more traditional limited partnership is that an LLLP allows liability transfer from the general partner's (to external insurer) for debts and obligations of the limited partnership. Typically, general partners manage the LLLP, while the limited partners' interest is primarily for investment purposes." ;
	.

fibo-be-ptr-ptr:LimitedLiabilityPartnership
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-ptr-ptr:Partnership ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-ptr-ptr:hasGeneralPartner ;
			owl:someValuesFrom fibo-be-ptr-ptr:GeneralPartner ;
		]
		;
	rdfs:label "limited liability partnership" ;
	owl:disjointWith fibo-be-ptr-ptr:LimitedPartnership ;
	skos:definition "partnership that has general partners but provides its individual partners some level of protection against personal liability for certain partnership liabilities" ;
	skos:example
		"Law firms, accountancies, wealth managers, professional medical groups, and other professional consultancies often take the form of a limited liability partnership." ,
		"One example of a limited liability partnership is that of an incorporated limited partnership (ILP) in Australia."
		;
	cmns-av:abbreviation "LLP" ;
	cmns-av:explanatoryNote "LLPs are a flexible legal and tax entity that allows partners to benefit from economies of scale by working together while also reducing their liability for the actions of other partners." ;
	.

fibo-be-ptr-ptr:LimitedPartner
	a owl:Class ;
	rdfs:subClassOf fibo-be-ptr-ptr:Partner ;
	rdfs:label "limited partner" ;
	skos:definition "partner whose liabilities are limited to the extent of their investment or guarantees and that has no involvement in the day to day operations of the partnership" ;
	.

fibo-be-ptr-ptr:LimitedPartnership
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-ptr-ptr:Partnership ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-ptr-ptr:hasGeneralPartner ;
			owl:someValuesFrom fibo-be-ptr-ptr:GeneralPartner ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-ptr-ptr:hasLimitedPartner ;
			owl:someValuesFrom fibo-be-ptr-ptr:LimitedPartner ;
		]
		;
	rdfs:label "limited partnership" ;
	skos:definition "partnership that has at least one general partner and at least one limited partner" ;
	skos:example "In the United States, film production companies, real estate investment firms, and private equity firms are typically formed as limited partnerships. In the United Kingdom, limited partnerships are governed by the Limited Partnerships Act 1907 and, on matters on which that Act is silent, also by the Partnership Act 1890." ;
	cmns-av:abbreviation "LP" ;
	cmns-av:explanatoryNote "Limited partnerships are distinct from limited liability partnerships, in which all partners have limited liability. Similar to a general partnership, the general partners have management control, share the right to use partnership property, share the profits of the firm in predefined proportions, and have joint and several liability for the debts of the partnership." ;
	.

fibo-be-ptr-ptr:Partner
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-opty:ConstitutionalOwner ,
		cmns-org:OrganizationMember ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass cmns-org:LegalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:isMemberOf ;
				owl:someValuesFrom fibo-be-ptr-ptr:Partnership ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-be-ptr-ptr:PartnershipAgreement ;
			] ;
		]
		;
	rdfs:label "partner" ;
	skos:definition "co-owner, member, and agent of a partnership whose participation level, including proportional liabilities and share in the profit / loss of the business is specified in a partnership agreement" ;
	.

fibo-be-ptr-ptr:Partnership
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-lp:BusinessEntity ,
		cmns-org:LegalEntity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-be-le-lp:ProfitObjective ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:playsRole ;
				owl:someValuesFrom fibo-be-ptr-ptr:Partner ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom fibo-be-ptr-ptr:PartnershipAgreement ;
		]
		;
	rdfs:label "partnership" ;
	skos:definition "association of two or more legal persons to carry on as co-owners a business for profit" ;
	cmns-av:explanatoryNote
		"Partnerships exist in many countries world-wide. Examples of the laws related to the establishment and operation of partnerships include the Partnership Act of 1890 in the United Kingdom and the Uniform Partnership Act in the United States." ,
		"Whether or not partnerships are established through, for example, incorporation, depends on the jurisdiction. Partnerships typically not corporations in the US, but can be in Australia and Ghana. See https://legalvision.com.au/what-are-incorporated-limited-partnerships/ and http://swiftlaw.co/incorporated-partnership/ for additional details."
		;
	.

fibo-be-ptr-ptr:PartnershipAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-fbo:OrganizationCoveringAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-be-ptr-ptr:Partner ;
		]
		;
	rdfs:label "partnership agreement" ;
	skos:definition "contract between partners in a partnership that establishes the terms and conditions of the relationship between the partners" ;
	cmns-av:synonym "articles of partnership" ;
	.

fibo-be-ptr-ptr:hasGeneralPartner
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "has general partner" ;
	rdfs:domain fibo-be-ptr-ptr:Partnership ;
	rdfs:range fibo-be-ptr-ptr:GeneralPartner ;
	skos:definition "indicates an actor that has some measure of control over the partnership" ;
	.

fibo-be-ptr-ptr:hasLimitedPartner
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "has limited partner" ;
	rdfs:domain fibo-be-ptr-ptr:Partnership ;
	rdfs:range fibo-be-ptr-ptr:LimitedPartner ;
	skos:definition "indicates an actor that may have some measure of influence over the partnership" ;
	.

fibo-be-ptr-ptr:isGeneralPartnerOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsOn ;
	rdfs:label "is general partner of" ;
	rdfs:domain fibo-be-ptr-ptr:GeneralPartner ;
	rdfs:range fibo-be-ptr-ptr:Partnership ;
	owl:inverseOf fibo-be-ptr-ptr:hasGeneralPartner ;
	skos:definition "indicates the organization that the general partner manages" ;
	.

fibo-be-ptr-ptr:isLimitedPartnerOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsOn ;
	rdfs:label "is limited partner of" ;
	rdfs:domain fibo-be-ptr-ptr:LimitedPartner ;
	rdfs:range fibo-be-ptr-ptr:Partnership ;
	owl:inverseOf fibo-be-ptr-ptr:hasLimitedPartner ;
	skos:definition "indicates the organization that the limited partner participates in" ;
	.

fibo-be-plc-plc:LimitedLiabilityCompany
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-plc-plc:PrivateCompanyWithLimitedLiability ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:playsRole ;
			owl:onClass [
				a owl:Restriction ;
				owl:onProperty fibo-be-plc-plc:hasManagingMember ;
				owl:someValuesFrom fibo-be-plc-plc:ManagingMember ;
			] ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:playsRole ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-be-oac-cpty:hasControllingOrganizationMember ;
				owl:someValuesFrom fibo-be-plc-plc:LimitedLiabilityCompanyMember ;
			] ;
		]
		;
	rdfs:label "limited liability company" ;
	skos:definition "private limited company that combines the pass through taxation of a sole proprietorship or partnership with the limited liability of a corporation" ;
	cmns-av:abbreviation "LLC" ;
	.

fibo-be-plc-plc:LimitedLiabilityCompanyMember
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-cpty:DeJureControllingInterestParty ,
		fibo-be-oac-cpty:EntityControllingParty ,
		fibo-be-oac-opty:EntityOwner ,
		cmns-org:OrganizationMember ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-cpty:isControllingMemberOf ;
			owl:onClass [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-be-plc-plc:LimitedLiabilityCompany ;
			] ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:isMemberOf ;
				owl:someValuesFrom fibo-be-plc-plc:LimitedLiabilityCompany ;
			] ;
		]
		;
	rdfs:label "limited liability company member" ;
	skos:definition "owner of an interest in a limited liability company" ;
	.

fibo-be-plc-plc:LimitedLiabilityCompanyTaxedAsACorporation
	a owl:Class ;
	rdfs:subClassOf fibo-be-plc-plc:LimitedLiabilityCompany ;
	rdfs:label "limited liability company taxed as a corporation" ;
	skos:definition "limited liability company that has elected to have corporate tax status" ;
	cmns-av:abbreviation "C-LLC" ;
	cmns-av:explanatoryNote "In the United States, LLCs that elect to be taxed as a corporation do so by filing an IRS Form 8832." ;
	.

fibo-be-plc-plc:ManagerManagedLimitedLiabilityCompany
	a owl:Class ;
	rdfs:subClassOf fibo-be-plc-plc:LimitedLiabilityCompany ;
	rdfs:label "manager-managed limited liability company" ;
	skos:definition "limited liability company in which the members appoint one or more managers to handle the daily operations and administrative responsibilities of the organization" ;
	cmns-av:explanatoryNote "If no members are interested in managing the LLC, an external manager (someone who doesn't own any portion of the LLC) can be hired to run the business operations, including, in some jurisdictions, a third-party entity, such as another company." ;
	.

fibo-be-plc-plc:ManagingMember
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:PrincipalParty ,
		fibo-be-plc-plc:LimitedLiabilityCompanyMember ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-plc-plc:isManagingMemberOf ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-be-plc-plc:LimitedLiabilityCompany ;
			] ;
		]
		;
	rdfs:label "managing member" ;
	skos:definition "owner of an interest in a limited liability company who also runs the day-to-day business operations" ;
	.

fibo-be-plc-plc:PrivateCompanyWithLimitedLiability
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-lp:BusinessEntity ,
		cmns-org:LegalEntity
		;
	rdfs:label "private company with limited liability" ;
	skos:definition "hybrid business entity having characteristics of both a corporation and a partnership or sole proprietorship (depending on how many owners there are)" ;
	cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Limited_liability_company#Overview"^^xsd:anyURI ;
	cmns-av:explanatoryNote "A private company with limited liability, although a business entity, is not a corporation. The primary characteristic this legal form shares with a corporation is limited liability, and the primary characteristic it shares with a partnership is the availability of pass-through income taxation. It is often more flexible than a corporation, and it is well-suited for companies with a single owner." ;
	.

fibo-be-plc-plc:PrivateLimitedCompany
	a owl:Class ;
	rdfs:subClassOf fibo-be-plc-plc:PrivateCompanyWithLimitedLiability ;
	rdfs:label "private limited company" ;
	skos:definition "private limited company whose shareholders' liability is limited to the capital they originally invested" ;
	cmns-av:abbreviation "Ltd." ;
	cmns-av:explanatoryNote "Private limited companies are common in countries including the U.K., Ireland, and Canada. They have one or more members, also called shareholders or owners, who buy in through private sales. Directors are company employees who keep up with all administrative tasks and tax filings but do not need to be shareholders." ;
	.

fibo-be-plc-plc:hasManagingMember
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-oac-cpty:hasControllingOrganizationMember ;
	rdfs:label "has managing member" ;
	rdfs:range fibo-be-plc-plc:ManagingMember ;
	skos:definition "indicates a managing member in a controlling role of a limited liability company that has responsibility for the day-to-day business operations" ;
	.

fibo-be-plc-plc:isManagingMemberOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-be-oac-cpty:isControllingMemberOf ;
	rdfs:label "is managing member of" ;
	rdfs:domain fibo-be-plc-plc:ManagingMember ;
	owl:inverseOf fibo-be-plc-plc:hasManagingMember ;
	skos:definition "indicates the controlled limited liability company that the managing member runs" ;
	.

fibo-be-sps-sps:SoleProprietor
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-opty:EntityOwner ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-oac-opty:hasInvestmentEntity ;
			owl:someValuesFrom fibo-be-sps-sps:SoleProprietorship ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-oac-oac:ownsAndControls ;
				owl:someValuesFrom fibo-be-sps-sps:SoleProprietorship ;
			] ;
		]
		;
	rdfs:label "sole proprietor" ;
	skos:definition "party that owns a business, has the rights to all profits from that business and is considered a single entity (unincorporated) together with that business for tax and liability purposes" ;
	cmns-av:explanatoryNote "A sole proprietor has unlimited liability with respect to any business debts." ;
	cmns-av:synonym
		"sole owner" ,
		"sole trader"
		;
	.

fibo-be-sps-sps:SoleProprietorship
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-lp:BusinessEntity ,
		cmns-org:LegalPerson ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-oac:isOwnedAndControlledBy ;
			owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:hasCapacity ;
			owl:someValuesFrom fibo-fnd-law-lcap:LiabilityCapacity ;
		]
		;
	rdfs:label "sole proprietorship" ;
	skos:definition "unincorporated business owned by a single person" ;
	.

fibo-be-tr-tr:IrrevocableTrust
	a owl:Class ;
	rdfs:subClassOf fibo-be-tr-tr:Trust ;
	rdfs:label "irrevocable trust" ;
	owl:disjointWith fibo-be-tr-tr:RevocableTrust ;
	skos:definition "trust that cannot be modified, amended or terminated except under certain legal circumstances and typically not without the permission of the grantor's named beneficiary or beneficiaries" ;
	cmns-av:explanatoryNote "Irrevocable trusts also offer asset protection from future creditors and lawsuits." ;
	.

fibo-be-tr-tr:LivingTrust
	a owl:Class ;
	rdfs:subClassOf fibo-be-tr-tr:Trust ;
	rdfs:label "living trust" ;
	skos:definition "trust created during an individual's lifetime where a designated person, the trustee, is given responsibility for managing that individual's assets for the benefit of the eventual beneficiary" ;
	cmns-av:explanatoryNote "A living trust is designed to allow for the easy transfer of the trust creator or settlor's assets while bypassing the often complex and expensive legal process of probate. Living trust agreements designate a trustee who holds legal possession of assets and property that flow into the trust." ;
	.

fibo-be-tr-tr:RevocableTrust
	a owl:Class ;
	rdfs:subClassOf fibo-be-tr-tr:Trust ;
	rdfs:label "revocable trust" ;
	skos:definition "trust in which legal ownership of the trust property is transferred to the trustee, but the trustor retains full power to revoke, modify or amend the trust" ;
	.

fibo-be-tr-tr:TestamentaryTrust
	a owl:Class ;
	rdfs:subClassOf fibo-be-tr-tr:IrrevocableTrust ;
	rdfs:label "testamentary trust" ;
	skos:definition "trust established in accordance with the instructions contained in a last will and testament" ;
	cmns-av:explanatoryNote "A will could have more than one testamentary trust. The trustee named is responsible for managing and distributing the trustor's assets to the beneficiaries as directed in the will. Sometimes called a will trust, the testamentary trust is irrevocable." ;
	.

fibo-be-tr-tr:Trust
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-lp:BusinessEntity ,
		cmns-org:LegalEntity ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:onClass fibo-be-tr-tr:TrustAgreement ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-be-tr-tr:TrustBeneficiary ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-be-tr-tr:Trustee ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-be-tr-tr:Trustor ;
		]
		;
	rdfs:label "trust" ;
	skos:definition "fiduciary relationship and legal entity in which one party, known as a trustor, gives another party, the trustee, the right to hold title to and manage assets for the benefit of a third party, the beneficiary" ;
	.

fibo-be-tr-tr:TrustAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-fbo:OrganizationCoveringAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-be-tr-tr:TrustBeneficiary ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-be-tr-tr:Trustee ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-be-tr-tr:Trustor ;
		]
		;
	rdfs:label "trust agreement" ;
	skos:definition "formal agreement that establishes a trust, whereby the trustor(s) gives the trustee(s) the responsibility to hold and manage assets for the beneficiary(ies)" ;
	cmns-av:explanatoryNote "A trust agreement typically states the (1) purpose for which the trust was established and fulfillment of which will terminate the trust, (2) details of the assets placed in the trust, (3) powers and limitations of the trustees, their reporting requirements, and other associated provisions, and (4) may also specify the trustees' compensation, if any. A trust agreement involving real estate requires its exact description and the trustor's express, written consent to create the trust to be valid." ;
	cmns-av:synonym
		"trust deed" ,
		"trust document" ,
		"trust instrument"
		;
	.

fibo-be-tr-tr:TrustBeneficiary
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Beneficiary ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:allValuesFrom fibo-be-tr-tr:TrustAgreement ;
			] ;
		]
		;
	rdfs:label "trust beneficiary" ;
	skos:definition "party for whose interest (benefit) an annuity, assignment (such as a letter of credit), contract, insurance policy, judgment, promise, trust, will, etc., is made" ;
	.

fibo-be-tr-tr:TrustFundManager
	a owl:Class ;
	rdfs:subClassOf
		cmns-bauth:LegallyDelegatedAuthority ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-org:manages ;
				owl:allValuesFrom fibo-be-tr-tr:Trust ;
			] ;
		]
		;
	rdfs:label "trust fund manager" ;
	skos:definition "party empowered to act on behalf of the trustee to manage the assets of the trust" ;
	.

fibo-be-tr-tr:Trustee
	a owl:Class ;
	rdfs:subClassOf
		cmns-bauth:LegallyDelegatedAuthority ,
		cmns-org:OrganizationMember ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:isMemberOf ;
				owl:allValuesFrom fibo-be-tr-tr:Trust ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-org:manages ;
				owl:allValuesFrom fibo-be-tr-tr:Trust ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:onClass fibo-be-tr-tr:TrustAgreement ;
				owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "trustee" ;
	skos:definition "party that holds and manages assets for the benefit of another" ;
	cmns-av:explanatoryNote "The trustee is legally obliged to make all trust-related decisions with the beneficiary's interests in mind, and may be liable for damages in the event of not doing so. Trustees may be entitled to a payment for their services, if specified in the trust agreement. In the specific case of the bond market, a trustee administers a bond issue for a borrower, and ensures that the issuer meets all the terms and conditions associated with the borrowing." ;
	.

fibo-be-tr-tr:Trustor
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:OrganizationMember ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:allValuesFrom cmns-pts:Party ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:onClass fibo-be-tr-tr:TrustAgreement ;
				owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "trustor" ;
	skos:definition "party that establishes a trust and places property under the protection and management of one or more trustees for the benefit of at least one beneficiary" ;
	cmns-av:explanatoryNote "It is not always necessary to identify the trustor who may be also be a trustee and/or one of the beneficiaries. In legal parlance, a trustor is called a settlor in the UK and a grantor in the US, whereas in common usage he or she may also be called a creator, donor, initiator, owner, or trust maker." ;
	cmns-av:synonym
		"grantor" ,
		"settlor"
		;
	.

fibo-be-tr-tr:hasTrustee
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "has trustee" ;
	rdfs:domain fibo-be-tr-tr:Trust ;
	rdfs:range fibo-be-tr-tr:Trustee ;
	owl:inverseOf fibo-be-tr-tr:isTrusteeOf ;
	skos:definition "links a trust to a named trustee" ;
	.

fibo-be-tr-tr:isTrusteeOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsOn ;
	rdfs:label "is trustee of" ;
	rdfs:domain fibo-be-tr-tr:Trustee ;
	rdfs:range fibo-be-tr-tr:Trust ;
	skos:definition "identifies the trust over which a trustee has some measure of control" ;
	.

fibo-cae-ce-act:Action
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:someValuesFrom fibo-cae-ce-act:ActionClassifier ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fbc-fi-fi:Security
					cmns-org:LegalEntity
				) ;
			] ;
		]
		;
	rdfs:label "action"@en ;
	skos:definition "event announced, initiated or carried out by an organization that affects a legal entity or the securities it issues and may have a material impact on that entity's stakeholders, such as shareholders and creditors"@en ;
	skos:example "Actions that impact an entity may be initiated by an issuer, exchange, regulator, creditor, or other third party."@en ;
	cmns-av:explanatoryNote "Actions initiated by an issuer are typically approved by that company's board of directors and authorized by their shareholders."@en ;
	.

fibo-cae-ce-act:ActionClassificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:ClassificationScheme ,
		cmns-cds:CodeSet ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:allValuesFrom fibo-cae-ce-act:ActionClassifier ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-cae-ce-act:ActionClassifier ;
		]
		;
	rdfs:label "action classification scheme" ;
	skos:definition "scheme for classifying the kinds of actions and events that may be announced, initiated or carried out by an organization that affects a legal entity or the securities it issues" ;
	cmns-av:usageNote "The set of corporate actions and income events included herein are a subset of those specified in a combination of ISO 15022 Securities - Scheme for Messages (Data Field Dictionary) and the GLEIF LEI-related corporate actions. Other schemes that are specific to a custodian, depository, or regulatory agency may also be important, and should take a similar approach with respect to classification." ;
	.

fibo-cae-ce-act:ActionClassifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:OccurrenceKind ,
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-cae-ce-act:ActionClassificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-cae-ce-act:ActionClassificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:someValuesFrom xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-cae-ce-act:Action ;
		]
		;
	rdfs:label "action classifier"@en ;
	skos:definition "classifier that distinguishes the kinds of actions and events that may be announced, initiated or carried out by an organization that affects a legal entity or the securities it issues, such as income-oriented events"@en ;
	cmns-av:explanatoryNote "ISO 15022 classifies events as impacting income vs. others. Other classification schemes distinguish between actions that return profits to shareholders, actions that are designed to influence the share price, and actions involving a change in structure to the issuer organization."@en ;
	.

fibo-cae-ce-act:ActionStatus
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleStatus ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:someValuesFrom xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-cae-ce-act:Action ;
		]
		;
	rdfs:label "action status"@en ;
	skos:definition "state of some action at some point in time"@en ;
	.

fibo-cae-ce-act:BusinessStrategyClassifier
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:ActionClassifier ;
	rdfs:label "business strategy classifier"@en ;
	skos:definition "classifier of corporate actions that involve improving liquidity or changing the overall structure of the organization through diversification, combining and closing parts of the business, etc, to increase long-term profitability"@en ;
	.

fibo-cae-ce-act:ChangeAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:MandatoryCorporateAction ;
	rdfs:label "change action"@en ;
	skos:definition "corporate action to disseminate information regarding a change further described in the corporate action details"@en ;
	cmns-av:explanatoryNote "Generic changes may include a change in the terms of an issue, change in the identification of a security, change of board lot, change from global to definitive, etc."@en ;
	.

fibo-cae-ce-act:ClassAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:VoluntaryCorporateAction ;
	rdfs:label "class action"@en ;
	skos:definition "corporate action involving a situation where interested parties seek restitution for financial loss"@en ;
	cmns-av:explanatoryNote "The security holder may be offered the opportunity to join a class action proceeding and would need to respond with an instruction."@en ;
	cmns-av:synonym "proposed settlement"@en ;
	.

fibo-cae-ce-act:ConsentSolicitation
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:VoluntaryCorporateAction ;
	rdfs:label "consent solicitation"@en ;
	skos:definition "corporate action that is a procedure that aims to obtain consent of holder to a proposal by the issuer or a third party without convening a meeting"@en ;
	skos:example "For example, consent to change the terms of a bond."@en ;
	.

fibo-cae-ce-act:CorporateAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:Action ;
	rdfs:label "corporate action"@en ;
	skos:definition "action carried out by or specifically relating to a legal entity that may affect the securities it issues and may have a material impact on its stakeholders, such as shareholders and creditors"@en ;
	skos:example "Examples of corporate actions include share issues, stock splits, consolidation, dividends, mergers and acquisitions, rights issues, spin-offs, and the inception of court actions."@en ;
	cmns-av:explanatoryNote "Corporate actions are typically approved by a company's board of directors and authorized by the shareholders."@en ;
	.

fibo-cae-ce-act:DisclosureAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:VoluntaryCorporateAction ;
	rdfs:label "disclosure action"@en ;
	skos:definition "corporate action involving a request for holders or beneficial owners to disclose their name, location and holdings of any issue to the issuer"@en ;
	.

fibo-cae-ce-act:Divestiture
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:MandatoryCorporateAction ;
	rdfs:label "divestiture"@en ;
	skos:definition "corporate action involving the sales of subsidiary business interests or investments"@en ;
	skos:note "Divestiture is an action or process involving the sale, spinoff, or liquidation of business assets, including product lines, services, subsidiaries, business property, or even an entire business. Companies may pursue a divestment strategy to refocus on their core business, in response to the operating environment in their industry, to raise capital, or to release underperforming assets."@en ;
	.

fibo-cae-ce-act:IncomeOrientedClassifier
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:ActionClassifier ;
	rdfs:label "income-oriented classifier"@en ;
	skos:definition "classifier of corporate actions that impacts income to shareholders"@en ;
	cmns-av:explanatoryNote "Cash dividends are a classic example where a public company declares a dividend to be paid on each outstanding share. Bonus is another case where the shareholder is rewarded. In a stricter sense, the bonus issue should not impact the share price but in reality, in rare cases, it does and results in an overall increase in value."@en ;
	.

fibo-cae-ce-act:LegalFormChange
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:MandatoryCorporateAction ;
	rdfs:label "legal form change"@en ;
	skos:definition "corporate action indicating a modification of the legal form of the organization"@en ;
	skos:example "In the United States it is common for companies established as Subchapter S Corporations (S-Corp), typically early stage companies, to modify their structure to become full-fledged Subchapter C Corporations (C-Corp) to facilitate outside fundraising, mergers, acquisitions, and public offerings. Other common form changes include migration from sole proprietorships to more formally registered organizations (e.g., LLC, S-Corp, C-Corp, etc.)"@en ;
	.

fibo-cae-ce-act:Liquidation
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:Divestiture ;
	rdfs:label "liquidation"@en ;
	skos:definition "corporate action related to winding up a business, including but not limited to distribution of cash, assets, or both"@en ;
	cmns-av:explanatoryNote "Debt may be paid in order of priority based on preferred claims to assets specified by a security, for example."@en ;
	.

fibo-cae-ce-act:MandatoryCorporateAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:CorporateAction ;
	rdfs:label "mandatory corporate action"@en ;
	owl:disjointWith fibo-cae-ce-act:VoluntaryCorporateAction ;
	skos:definition "action initiated by the board of directors of a corporation that affects all shareholders"@en ;
	skos:example "Examples of mandatory corporate actions include cash dividends, stock splits, mergers, pre-refunding, return of capital, bonus issue, asset ID change, and spin-offs."@en ;
	cmns-av:explanatoryNote "Mandatory means mandatory participation by all shareholders, however the shareholder is not required to do anything."@en ;
	.

fibo-cae-ce-act:MandatoryWithChoiceCorporateAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:MandatoryCorporateAction ;
	rdfs:label "mandatory with choice corporate action"@en ;
	skos:definition "mandatory corporate action where shareholders are given an opportunity to choose among several options"@en ;
	cmns-av:explanatoryNote "In case a shareholder does not submit the election, the default option will be applied."@en ;
	.

fibo-cae-ce-act:MarketAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:Action ;
	rdfs:label "market action"@en ;
	skos:definition "action that is initiated by a market, such as a securities exchange, that affects a legal entity or the securities it issues and may have a material impact on that entity's stakeholders, such as shareholders and creditors"@en ;
	.

fibo-cae-ce-act:MergerAcquisition
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:MandatoryCorporateAction ;
	rdfs:label "merger / acquisition"@en ;
	skos:definition "corporate action involving the consolidation of legal entities or assets"@en ;
	cmns-av:explanatoryNote "Such consolidation may be accomplished via financial transactions such as mergers, acquisitions, consolidations, tender offers, purchase of assets, and management acquisitions."@en ;
	.

fibo-cae-ce-act:Notification
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:MandatoryCorporateAction ;
	rdfs:label "notification"@en ;
	skos:definition "corporate action involving information provided by the issuer having no accounting/financial impact on the holder"@en ;
	.

fibo-cae-ce-act:OrganizationAddressChange
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:Notification ;
	rdfs:label "organization address change"@en ;
	skos:definition "information action that provides details of address changes for a legal entity"@en ;
	skos:note "Address changes may impact securities master data management, including but not limited to where shares are registered and by whom."@en ;
	.

fibo-cae-ce-act:OrganizationNameChange
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:Notification ;
	rdfs:label "organization name change"@en ;
	skos:definition "information action that provides details of name changes for a legal entity"@en ;
	skos:note "Name changes may include legal name changes as well as 'doing business as', and other operational names for an organization."@en ;
	.

fibo-cae-ce-act:PriorityIssue
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:VoluntaryCorporateAction ;
	rdfs:label "priority issue"@en ;
	skos:definition "corporate action that is a public offer where, due to a limited amount of securities available, priority is given to existing shareholders"@en ;
	.

fibo-cae-ce-act:RegulatoryAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:Action ;
	rdfs:label "regulatory action"@en ;
	skos:definition "action initiated by a regulatory agency that affects a legal entity or the securities it issues and may have a material impact on that entity's stakeholders, such as shareholders and creditors"@en ;
	.

fibo-cae-ce-act:SpinOff
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:Divestiture ;
	rdfs:label "spin off"@en ;
	skos:definition "corporate action involving the distribution of subsidiary stock to the shareholders of the parent company without a surrender of shares"@en ;
	cmns-av:explanatoryNote "Spin-off represents a form of divestiture usually resulting in an independent company or in an existing company. Examples include demerger, distribution, and unbundling."@en ;
	.

fibo-cae-ce-act:VoluntaryCorporateAction
	a owl:Class ;
	rdfs:subClassOf fibo-cae-ce-act:CorporateAction ;
	rdfs:label "voluntary corporate action"@en ;
	skos:definition "event in which the shareholders elect to participate and must respond in order for the issuer to process the action"@en ;
	skos:example "An example of a voluntary corporate action is a tender offer, in which the issuer may request shareholders to tender their shares at a predetermined price."@en ;
	cmns-av:explanatoryNote "Shareholders send responses to the issuer's agents, and the issuer will send the proceeds of the action to those shareholders who elect to participate."@en ;
	.

fibo-der-cr-cds:AssetBackedCreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-cr-cds:CreditDefaultSwap ;
	rdfs:label "asset-backed credit default swap"@en ;
	skos:definition "credit default swap whose underlying reference obligation is an asset-backed security rather than corporate credit"@en ;
	cmns-av:abbreviation "ABCDS"@en ;
	cmns-av:explanatoryNote "In the case of an ABCDS, the buyer receives protection for defaults on asset-backed securities or tranches of securities, rather than protecting against the default of a particular issuer. Asset-backed securities are securities backed by a pool of loans or receivables, such as auto loans, home equity loans or credit cards loans."@en ;
	.

fibo-der-cr-cds:BasketCreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-cr-cds:MultiNameCreditDefaultSwap ;
	rdfs:label "basket credit default swap"@en ;
	skos:definition "credit default swap that references a bespoke, synthetic portfolio of underlying assets whose components have been agreed to for a specific OTC derivative by the parties to the transaction"@en ;
	cmns-av:adaptedFrom
		"Draft paper on Credit Default Swaps from the Federal Reserve Board, available at https://www.federalreserve.gov/econres/feds/files/2022023pap.pdf" ,
		"ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code"
		;
	.

fibo-der-cr-cds:BasketOfCreditDefaultSwaps
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:WeightedBasket ,
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-der-cr-cds:CreditDefaultSwap ;
		]
		;
	rdfs:label "basket of credit default swaps"@en ;
	skos:definition "basket of reference obligations are credit default swap instruments"@en ;
	cmns-av:explanatoryNote "Note that the CDS Index is broken down into tranches depending on different types of credits, for example, investment grade and high yield. Tranches are defined by attachment and detachment points for the index loss distribution. It means that when default events occur the lower-level tranches absorb the loss up to the detachment point, before moving to the next senior tranche."@en ;
	.

fibo-der-cr-cds:CashSettlementMethod
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-ip:PriceDeterminationMethod ;
	rdfs:label "cash settlement method"@en ;
	skos:definition "strategy for calculating or otherwise establishing a reference final price for the contract"@en ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code" ;
	cmns-av:explanatoryNote "The method may include an independently administered synthetic auction process that sets the reference final price."@en ;
	.

fibo-der-cr-cds:ContingentCreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-cr-cds:CreditDefaultSwap ;
	rdfs:label "contingent credit default swap"@en ;
	skos:definition "credit default swap in which an additional triggering event is required"@en ;
	cmns-av:abbreviation "CCDS"@en ;
	cmns-av:explanatoryNote "In a contingent credit default swap, the trigger requires both a credit event (as in a traditional credit default swap) and another specified event. The additional specified event is usually a significant movement in an index covering equities, commodities, interest rates, or some other overall measure of the economy or relevant industry."@en ;
	.

fibo-der-cr-cds:CreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:CreditDerivative ,
		fibo-der-drc-swp:Swap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOccurrence ;
			owl:onClass fibo-der-cr-cds:SettlementAuction ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-cr-cds:hasContractPrice ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryPrice ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-der-cr-cds:CreditProtectionTerms ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:someValuesFrom fibo-der-cr-cds:TriggeringEvent ;
		]
		;
	rdfs:label "credit default swap"@en ;
	skos:definition "bilateral contract in which one party (protection seller) agrees to provide payment to the other party (protection buyer) should a credit event occur against the underlying, which could be a specified debt (the reference obligation), a specific debt issuer (reference entity), a basket of reference entities and/or reference obligations, or a credit index (reference index)"@en ;
	cmns-av:abbreviation "CDS"@en ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code" ;
	cmns-av:explanatoryNote
		"According to a 2022 working paper from the Federal Reserve, \"credit default swaps (CDS) are, by far, the most common type of credit derivative. They are financial instruments that allow the transfer of credit risk among market participants, potentially facilitating greater efficiency in the pricing and distribution of credit risk. In its most basic form, a CDS is a contract where a 'protection buyer' agrees to make periodic payments (the CDS 'spread' or premium) over a predetermined number of years (the maturity or term of the CDS) to a 'protection seller' in exchange for a payment from the protection seller in the event of default by a 'reference entity.' CDS premiums tend to be paid quarterly and are set as a percentage of the total amount of protection bought (the 'notional amount' of the contract). CDS maturities generally range from one to ten years, with the five-year maturity being particularly common.\" See https://www.federalreserve.gov/econres/feds/files/2022023pap.pdf for more detail."@en ,
		"Note that the effective date of the contract indicates the starting date of the credit protection defined therein."@en
		;
	.

fibo-der-cr-cds:CreditDefaultSwapIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-mkt-bas:ReferenceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-der-cr-cds:BasketOfCreditDefaultSwaps ;
		]
		;
	rdfs:label "credit default swap index"@en ;
	skos:definition "index whose underlying reference obligations are credit default swap instruments"@en ;
	.

fibo-der-cr-cds:CreditEventNotice
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:Notice ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:isAbout ;
			owl:someValuesFrom fibo-der-cr-cds:TriggeringEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-der-cr-cds:NotifyingParty ;
		]
		;
	rdfs:label "credit event notice"@en ;
	skos:definition "irrevocable written or verbal notice that states that a triggering event has occurred"@en ;
	cmns-av:explanatoryNote "Notices of certain kinds of credit events are required as a condition of a credit default swap. Such notices are sent from a notifying party (either the buyer or the seller) to the counterparty. They provide information that assists the contract parties in determining whether a triggering credit event has occurred."@en ;
	.

fibo-der-cr-cds:CreditProtectionTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:DerivativeTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-cr-cds:hasScheduledTerminationDate ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-cr-cds:allowsSubstitution ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:boolean ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:hasBuyer ;
			owl:someValuesFrom fibo-der-cr-cds:DeliverableObligationBuyer ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:hasSeller ;
			owl:someValuesFrom fibo-der-cr-cds:DeliverableObligationSeller ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:someValuesFrom fibo-der-cr-cds:DeliverableObligation ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:someValuesFrom fibo-der-cr-cds:TriggeringEvent ;
		]
		;
	rdfs:label "credit protection terms"@en ;
	skos:definition "legal terms that define triggering events and associated conditions related to settlement"@en ;
	cmns-av:explanatoryNote "Note that there may be additional payment schedules or a more complex calculation formula required depending on the terms of the contract."@en ;
	cmns-av:synonym "contingent leg"@en ;
	.

fibo-der-cr-cds:DeliverableObligation
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:Asset ;
	rdfs:label "deliverable asset"@en ;
	skos:definition "asset that must be delivered as a part of the process of settling a credit default swap"@en ;
	cmns-av:explanatoryNote "If the reference obligation is a bond, the deliverable asset (obligation) may be a different bond. If it is a loan, the deliverable asset may involve assigment of a loan."@en ;
	.

fibo-der-cr-cds:DeliverableObligationBuyer
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractParty ,
		fibo-fnd-pas-pas:Buyer
		;
	rdfs:label "deliverable obligation buyer"@en ;
	skos:definition "contract party that is obliged to purchase a deliverable obligation (asset) if a triggering event occurs, depending on the event and the contract"@en ;
	.

fibo-der-cr-cds:DeliverableObligationSeller
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractParty ,
		fibo-fnd-pas-pas:Seller
		;
	rdfs:label "deliverable obligation seller"@en ;
	skos:definition "contract party that is obliged to sell a deliverable obligation (asset) if a triggering event occurs, depending on the event and the contract"@en ;
	.

fibo-der-cr-cds:EscrowAgent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:RegisteredAgent ,
		fibo-fnd-agr-ctr:ContractThirdParty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:someValuesFrom fibo-der-cr-cds:DeliverableObligation ;
		]
		;
	rdfs:label "escrow agent"@en ;
	skos:definition "third party that holds an asset or funds before they are formally transferred from one party to another party, per the terms of a contract, within some specified time period and/or when a triggering event occurs"@en ;
	cmns-av:explanatoryNote "Use of an escrow agent is one possible mechanism that may be used in some cases, as specified in a credit default swap contract, for delivery purposes."@en ;
	.

fibo-der-cr-cds:IndexCreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-cr-cds:MultiNameCreditDefaultSwap ;
	rdfs:label "index credit default swap"@en ;
	skos:definition "credit default swap that references a family of standardized credit derivative indices, where the underlying reference entities are a defined basket of credit from a particular geographic region (e.g. Asia, North America, Europe), and/or credit rating level (e.g. emerging markets, high yield, investment grade)"@en ;
	cmns-av:adaptedFrom
		"Draft paper on Credit Default Swaps from the Federal Reserve Board, available at https://www.federalreserve.gov/econres/feds/files/2022023pap.pdf" ,
		"ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code"
		;
	cmns-av:explanatoryNote "Credit default indices trade in standard maturities, and the reference entities are typically the most liquid; the reference portfolio is reassessed periodically to maintain this."@en ;
	.

fibo-der-cr-cds:IndexTrancheCreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-cr-cds:MultiNameCreditDefaultSwap ;
	rdfs:label "index tranche credit default swap"@en ;
	skos:definition "credit default swap that references a synthetic collateralized debt obligation (CDO) based on a credit index where each tranche references a different segment of the loss distribution of the underlying index"@en ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code" ;
	cmns-av:explanatoryNote "Each tranche has a different priority of claims on the principal and interest flows from the collateral pool, and is traditionally portioned into rising levels of seniority."@en ;
	.

fibo-der-cr-cds:LoanCreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-cr-cds:CreditDefaultSwap ;
	rdfs:label "loan credit default swap"@en ;
	skos:definition "credit default swap whose underlying reference obligation is limited strictly to syndicated secured loans, rather than any type of corporate debt"@en ;
	cmns-av:abbreviation "LCDS"@en ;
	.

fibo-der-cr-cds:MultiNameCreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-cr-cds:CreditDefaultSwap ;
	rdfs:label "multi-name credit default swap"@en ;
	skos:definition "credit default swap that references more than one obligation or borrower"@en ;
	cmns-av:adaptedFrom
		"Draft paper on Credit Default Swaps from the Federal Reserve Board, available at https://www.federalreserve.gov/econres/feds/files/2022023pap.pdf" ,
		"ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code"
		;
	cmns-av:explanatoryNote "For instance, a multiname contract could be written to cover defaults in a reference portfolio (such as in the case of a basket credit default swap) or, as has been increasingly common over the past couple of decades,be based on an index of commonly negotiated single-name CDS. The latter are generally called CDS indexes."@en ;
	cmns-av:synonym "multiname credit default swap" ;
	.

fibo-der-cr-cds:NotifyingParty
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-agr-ctr:ContractParty
				fibo-fnd-agr-ctr:ContractThirdParty
			) ;
		]
		;
	rdfs:label "notifying party"@en ;
	skos:definition "party responsible for issuing one or more formal notices indicating that an event that is relevant to a given contract has taken place"@en ;
	cmns-av:explanatoryNote "The notifying party is the party that notifies the other party when a credit or other triggering event has occurred by means of a credit event notice. If more than one party is referenced as being the notifying party then either party may notify the other of such an occurrence."@en ;
	.

fibo-der-cr-cds:SettlementAuction
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-stl:SettlementEvent ;
	rdfs:label "settlement auction"@en ;
	skos:definition "independently administered synthetic auction process on a set of defined deliverable obligations that sets the reference final price that can be used to facilitate cash settlement of all covered transactions following a credit event"@en ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code" ;
	.

fibo-der-cr-cds:SingleNameCreditDefaultSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-cr-cds:CreditDefaultSwap ;
	rdfs:label "single name credit default swap"@en ;
	skos:definition "credit default swap whose underlying risk is a single reference obligation, or a single reference entity, such as a corporation or a sovereign borrower"@en ;
	cmns-av:adaptedFrom
		"Draft paper on Credit Default Swaps from the Federal Reserve Board, available at https://www.federalreserve.gov/econres/feds/files/2022023pap.pdf" ,
		"ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code"
		;
	.

fibo-der-cr-cds:TriggeringEvent
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-dt-oc:Occurrence ;
	rdfs:label "triggering event"@en ;
	skos:definition "event that relates to or triggers some aspect of a credit default swap"@en ;
	cmns-av:explanatoryNote "A triggering event is typically a credit event, but could be anything that happens in the marketplace. For example, a weather-specific contract could be triggered by a hurricane - which wouldn't be considered a credit event per se."@en ;
	.

fibo-der-cr-cds:allowsSubstitution
	a owl:DatatypeProperty ;
	rdfs:label "allows substitution"@en ;
	rdfs:domain fibo-der-cr-cds:CreditProtectionTerms ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether it is possible to substitute other obligations in place of the specified deliverable obligation"@en ;
	.

fibo-der-cr-cds:hasContractPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has contract price"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "specifies a predetermined price at which the buyer purchases the credit default swap contract"@en ;
	.

fibo-der-cr-cds:hasMinimumQuotationAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has minimum quotation amount"@en ;
	rdfs:domain fibo-fbc-fi-stl:CashSettlementTerms ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates a minimum intended threshold amount of outstanding principal balance of the reference obligation for which the quote should be obtained"@en ;
	.

fibo-der-cr-cds:hasQuotationMethod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-fi-ip:hasPriceDeterminationMethod ;
	rdfs:label "has quotation method"@en ;
	rdfs:domain fibo-fbc-fi-stl:CashSettlementTerms ;
	rdfs:range fibo-der-cr-cds:CashSettlementMethod ;
	skos:definition "indicates the nature of the pricing quotations to be requested from banks and/or dealers when determining the market value of the reference obligation for purposes of cash settlement"@en ;
	.

fibo-der-cr-cds:hasScheduledTerminationDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-arr-doc:hasTerminationDate ;
	rdfs:label "has scheduled termination date"@en ;
	rdfs:domain fibo-der-cr-cds:CreditProtectionTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "date on which credit protection is due to expire as agreed by both parties"@en ;
	.

fibo-der-drc-comm:AgriculturalResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "agricultural resource"@en ;
	skos:definition "negotiable commodity that is obtained via some agricultural process, including forestry, fishing, livestock, grain, dairy, corn, cocoa, soybeans, sugar, coffee"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:BaseMetal
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-comm:Metal ;
	rdfs:label "base metal"@en ;
	owl:disjointWith fibo-fnd-acc-cur:PreciousMetal ;
	skos:definition "common metal that tarnishes, oxidizes, or corrodes relatively quickly when exposed to air or moisture, that is widely used in commercial and industrial applications, such as construction and manufacturing"@en ;
	cmns-av:explanatoryNote "Base metals or alloys include metals other than precious metals, such as copper, lead, zinc, tin, iron, steel, or brass. Note that iron and steel are included under metal and metal products in some classification schemes - see https://fred.stlouisfed.org/series/WPU101 for example."@en ;
	.

fibo-der-drc-comm:BasketOfCommodities
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:WeightedBasket ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-der-drc-comm:CommodityBasketConstituent ;
		]
		;
	rdfs:label "basket of commodities" ;
	skos:definition "custom basket whose constituents consist of one or more negotiable commodities" ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	cmns-av:explanatoryNote "A commodity basket may contain constituents from one of the potential underlying assets or from multiple underlying assets."@en ;
	.

fibo-der-drc-comm:Bullion
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:PreciousMetal ;
	rdfs:label "bullion"@en ;
	skos:definition "physical precious metal that is officially recognized as being at least 99.5 percent pure"@en ;
	skos:example "In the United States, bullion that is eligible for reference in a commodities contract may include U.S. gold Buffalo coins minted by the U.S. Mint that are 1 troy ounce, 0.5 ounce, 0.25 ounce, or 0.10 ounce; 1 ounce silver coins; certain platinum coins; and gold, silver, palladium, and platinum bullion that meet or exceed the fineness requirements of a regulated futures contract. Bullion must also be certified by an approved certifier, typically identified by an exchange, including but not limited to the U.S. Mint."@en ;
	cmns-av:explanatoryNote 'Physical metals fall into two categories: (1) bullion, which are coins, ingots or bars of a specific weight and purity; and (2) "numismatic" or collectible coins, which can be rare or old coins, or special proofs that are newly minted as collectibles. If a particular asset is identified as "numismatic" or "collectible", it is, by definition, not considered bullion aside from its melt value.'@en ;
	.

fibo-der-drc-comm:CommodityBasketConstituent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:WeightedBasketConstituent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-comm:hasCommodityValueAsOfDate ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:involves ;
			owl:onClass fibo-fnd-pas-pas:Commodity ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasAsOfDate ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasQuantityValue ;
			owl:onClass cmns-qtu:ScalarQuantityValue ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "commodity basket constituent" ;
	skos:definition "component of a custom commodity basket whose relative importance with respect to other basket constituents is known" ;
	.

fibo-der-drc-comm:CommodityDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:CommodityInstrument ,
		fibo-fbc-fi-fi:DerivativeInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:onClass fibo-der-drc-comm:CommodityDerivativeUnderlier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "commodity derivative" ;
	skos:definition "derivative instrument whose primary underlying item is a physical commodity, or the price, or related index, or any other aspect related to a physical commodity"@en ;
	cmns-av:explanatoryNote "The price of any commodity used as the basis for a commodity derivative may vary according to supply and demand as of the execution date of the contract and at various other times during the lifetime of the contract depending on contract terms. Valuation of a commodity derivative may depend on the spot price for the underlying commodity, futures price, supply and demand, convenience yield, cost of money and/or interest rates, volatility, which models were used to predict future pricing, and so forth."@en ;
	.

fibo-der-drc-comm:CommodityDerivativeUnderlier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:Underlier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-comm:hasCommodityValueAsOfDate ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:involves ;
			owl:onClass fibo-fnd-pas-pas:Commodity ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasAsOfDate ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasQuantityValue ;
			owl:onClass cmns-qtu:ScalarQuantityValue ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "commodity derivative underlier" ;
	skos:definition "underlier of a commodity derivative, including, but not limited to, the negotiable commodity itself"@en ;
	cmns-av:explanatoryNote "The underlying of a commodity swap may include a physical commodity, or the price, or behavior of the price, or any other aspect of a physical commodity."@en ;
	.

fibo-der-drc-comm:CommodityForward
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:CommodityDerivative ,
		fibo-der-drc-ff:Forward
		;
	rdfs:label "commodity forward"@en ;
	skos:definition "forward contract in which a buyer and seller agree upon delivery of a specified quality and quantity of goods at a specified future date"@en ;
	cmns-av:adaptedFrom
		"CFTC glossary"@en ,
		"ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en
		;
	cmns-av:explanatoryNote 'Commodity forwards are often settled via cash transactions in many industries, including for the purposes of commodity merchandising. Terms may be more "personalized" than is the case with standardized futures contracts (i.e., delivery time and amount are as determined between seller and buyer). A price may be agreed upon in advance, or there may be agreement that the price will be determined at the time of delivery. A forward contract is a private and customizable agreement that settles at the end of the agreement and is traded over-the-counter.'@en ;
	.

fibo-der-drc-comm:CommodityFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:CommodityDerivative ,
		fibo-fbc-fi-fi:Future
		;
	rdfs:label "commodity future"@en ;
	owl:disjointWith fibo-der-drc-ff:FinancialFuture ;
	skos:definition "futures contract to buy or sell a predetermined amount of a commodity at a specific price on a specific date in the future"@en ;
	cmns-av:adaptedFrom
		"CFTC glossary"@en ,
		"ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en
		;
	cmns-av:explanatoryNote "A commodity future is an agreement to purchase or sell a commodity for delivery in the future: (1) at a price that is determined at initiation of the contract; (2) that obligates each party to the contract to fulfill the contract at the specified price; (3) that is used to assume or shift price risk; and (4) that may be satisfied by delivery or offset."@en ;
	.

fibo-der-drc-comm:CommodityIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-mkt-bas:ReferenceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-der-drc-comm:BasketOfCommodities ;
		]
		;
	rdfs:label "commodity index"@en ;
	skos:definition "investment vehicle that tracks a basket of commodities to measure their price and investment return performance"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:CommodityOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:CommodityDerivative ,
		fibo-der-drc-opt:VanillaOption
		;
	rdfs:label "commodity option"@en ;
	skos:definition "option where the option buyer has the right to buy or sell specified commodities or commodity related index at a fixed price or formula, on or before a specified date"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:CommodityReturnLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:ReturnLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom fibo-der-drc-comm:CommodityDerivativeUnderlier ;
		]
		;
	rdfs:label "commodity return leg"@en ;
	skos:definition "leg of a commodity return swap in which the return is based on a physical commodity, or the price, or behavior of the price, or any other aspect related to a physical commodity"@en ;
	cmns-av:explanatoryNote "The cash flows from a commodity may be negative as you have a cost from holding the commodity but there are no interim cash flows, so it equates to a negative interest rate. So a commodity swap is like a TRS in that it is based on the return on the increase in value."@en ;
	.

fibo-der-drc-comm:CommoditySpotContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:CommodityInstrument ,
		fibo-fbc-fi-fi:SpotContract
		;
	rdfs:label "commodity spot contract"@en ;
	skos:definition "contract that involves physical delivery of the commodity asset at settlement"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:CommoditySwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:CommodityDerivative ,
		fibo-der-drc-swp:ReturnSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasReturnLeg ;
			owl:someValuesFrom fibo-der-drc-comm:CommodityReturnLeg ;
		]
		;
	rdfs:label "commodity swap"@en ;
	skos:definition "commodity derivative that includes, without limitation, any swap for which the primary underlying notional item is a physical commodity, or the price, or behavior of the price, or the level of a commodity index, or other aspect related to a physical commodity"@en ;
	cmns-av:adaptedFrom
		"CFTC glossary"@en ,
		"ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en
		;
	cmns-av:explanatoryNote
		"Commodities that can be swapped include: energy. metal, agriculture, environmental, freight, polypropylene products, fertilizer, paper, single and multiple commodity indexes and baskets, and multi-commodity assets where each leg references a different commodity."@en ,
		"Commodity swaps typically involve the exchange of a floating commodity price for a set price over an agreed-upon period."@en
		;
	.

fibo-der-drc-comm:EnergyResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "energy resource"@en ;
	skos:definition "negotiable commodity that is an energy-related product, or a derivative of an energy-related product, including electricity, renewable energy, or any power/energy delivered through a utility network of provider; diesel fuel, fuel oil, gas oil, gasoline, heating oil, jet fuel, kerosene, natural gas, oil (Brent, Tapis, Dubai, WTI)"@en ;
	skos:scopeNote "Note that the concept of an energy resource overlaps with generated resource and extraction resource but is not identical to either."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:EnergyTransmissionRights
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-comm:EnergyResource ;
	rdfs:label "energy transmission rights"@en ;
	skos:definition "rights to the transmission of power across an electricity distribution network"@en ;
	.

fibo-der-drc-comm:EnvironmentalResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "environmental resource"@en ;
	skos:definition "negotiable commodity including offset credits"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:ExtractionResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "extraction resource"@en ;
	skos:definition "negotiable commodity that is a mineral resource obtained via withdrawal from the natural environment"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	cmns-av:explanatoryNote "These resources include ores, which contain commercially valuable amounts of metals, such as iron and aluminum, as well as precious metals, such as silver, gold, and platinum; precious stones, such as diamonds; building stones, such as granite; and solid fuels, such as coal and oil shale."@en ;
	.

fibo-der-drc-comm:FertilizerResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "fertilizer resource"@en ;
	skos:definition "negotiable commodity that includes ammonia, diammonium phosphate (DAP), potash, sulphur, urea, urea and ammonium nitrate (UAN)"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:FreightResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "freight resource"@en ;
	skos:definition "negotiable commodity that is a freight index route"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:GasCommodity
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:EnergyResource ,
		fibo-der-drc-comm:ExtractionResource
		;
	rdfs:label "gas commodity"@en ;
	skos:definition "extraction resource that is natural gas"@en ;
	.

fibo-der-drc-comm:GeneratedResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "generated resource"@en ;
	skos:definition "negotiable commodity obtained via some generation process, including electricity, renewable energy, or any power/energy delivered through a utility network or provider"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:GrainCommodity
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-comm:AgriculturalResource ;
	rdfs:label "grain commodity"@en ;
	skos:definition "agricultural resource that is a small, hard seed, of a food plant, especially of a cereal plant, such as wheat, corn, rye, oats, rice, and millet"@en ;
	.

fibo-der-drc-comm:IndustrialResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "industrial resource"@en ;
	skos:definition "negotiable commodity that is obtained via some industrial process, including construction and manufacturing"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:MeatCommodity
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-comm:AgriculturalResource ;
	rdfs:label "meat commodity"@en ;
	skos:definition "agricultural resource derived from the flesh of an animal (especially a mammal), such as pork bellies"@en ;
	.

fibo-der-drc-comm:Metal
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-comm:ExtractionResource ;
	rdfs:label "metal"@en ;
	skos:definition "material that, when freshly prepared, polished, or fractured, shows a lustrous appearance, and conducts electricity and heat relatively well"@en ;
	skos:example "Examples include precious or industrial metal, such as aluminium, copper, gold, lead, nickel, platinum, silver, tin, zinc."@en ;
	cmns-av:adaptedFrom
		"ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ,
		"https://en.wikipedia.org/wiki/Metal"@en
		;
	.

fibo-der-drc-comm:OilCommodity
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:GeneratedResource ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-comm:hasGrade ;
			owl:someValuesFrom fibo-der-drc-comm:OilGrade ;
		]
		;
	rdfs:label "oil commodity"@en ;
	skos:definition "generated resource that is a viscous liquid derived from petroleum, including for use as fuel, or as a lubricant, and the manufacture of many types of paints, plastics, and other materials"@en ;
	.

fibo-der-drc-comm:OilGrade
	a owl:Class ;
	rdfs:subClassOf cmns-cls:Classifier ;
	rdfs:label "oil grade"@en ;
	skos:definition "measure of the viscosity of oil during operation"@en ;
	.

fibo-der-drc-comm:PaperResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "paper resource"@en ;
	skos:definition "negotiable commodity that is a paper product, including containerboard, newsprint, pulp, recovered paper"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:PolypropyleneResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "polypropylene resource"@en ;
	skos:definition "negotiable commodity including plastics"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:ServiceResource
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:NegotiableCommodity ;
	rdfs:label "service resource"@en ;
	skos:definition "negotiable commodity involving services such as transportation, communications, and trade"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10"@en ;
	.

fibo-der-drc-comm:WeatherDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:CommodityDerivative ,
		fibo-fbc-fi-fi:DerivativeInstrument
		;
	rdfs:label "weather derivative" ;
	skos:definition "derivative instrument whose primary underlying notional item is based on something related to the weather, for example, the average temperature in Chicago in January"@en ;
	cmns-av:adaptedFrom "CFTC glossary, https://www.cftc.gov/LearnAndProtect/EducationCenter/CFTCGlossary/glossary_wxyz.html"@en ;
	cmns-av:explanatoryNote
		"In the CFI standard, weather is classified as an environmental resource."@en ,
		"Such a derivative can be used to hedge risks related to the demand for heating fuel or electricity. The underlying 'asset' is not a negotiable commodity per se, but because the weather can impact the prices and other things related to other commodities, weather derivatives are treated as commodity derivatives for regulatory purposes."@en
		;
	.

fibo-der-drc-comm:hasCommodityValueAsOfDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has commodity value as of date" ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the per unit value of a given commodity as of some specified date" ;
	.

fibo-der-drc-comm:hasGrade
	a owl:ObjectProperty ;
	rdfs:label "has grade"@en ;
	rdfs:domain fibo-der-drc-comm:OilCommodity ;
	rdfs:range fibo-der-drc-comm:OilGrade ;
	skos:definition "The grade of oil e.g. Brent Crude."@en ;
	.

fibo-der-drc-cur:CurrencyDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:CurrencyInstrument ,
		fibo-fbc-fi-fi:DerivativeInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-fx-fx:hasExchangeRateQuotationSource ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-be-fct-pub:Publisher
					fibo-fbc-fct-mkt:Exchange
					fibo-fbc-pas-fpas:FinancialServiceProvider
				) ;
			] ;
		]
		;
	rdfs:label "currency derivative"@en ;
	skos:definition "agreement to deliver and settle a given amount of money in one currency, in exchange for a given amount in another currency at an agreed rate of exchange"@en ;
	cmns-av:abbreviation "FX derivative"@en ;
	cmns-av:synonym
		"foreign exchange derivative"@en ,
		"forex derivative"@en
		;
	.

fibo-der-drc-cur:CurrencyForward
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-cur:CurrencyDerivative ,
		fibo-der-drc-ff:Forward ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-cur:hasForwardExchangeRate ;
			owl:someValuesFrom fibo-fnd-acc-cur:ExchangeRate ;
		]
		;
	rdfs:label "currency forward"@en ;
	skos:definition "agreement to deliver and settle a given amount of money in one currency, in exchange for a given amount in another currency, at an agreed date in the future and at an agreed rate of exchange"@en ;
	cmns-av:synonym
		"FX forward"@en ,
		"foreign exchange forward"@en
		;
	.

fibo-der-drc-cur:CurrencyForwardOutright
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-cur:CurrencyForward ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasPart ;
			owl:someValuesFrom fibo-der-drc-cur:CurrencySpotContract ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasPart ;
			owl:someValuesFrom fibo-der-drc-cur:CurrencySwap ;
		]
		;
	rdfs:label "currency forward outright"@en ;
	skos:definition "forward contract in a foreign exchange market that locks in the price at which an entity must buy or sell a currency on a future date"@en ;
	cmns-av:explanatoryNote "The holders of a currency forward are obligated to buy or sell the currency at a specified price, at a specified quantity and on a specified future date. These contracts cannot be transferred. Jan 10 Review Notes Outright Forward is the term for the professional markets. Spot + Swap where Swap is 2 simultaneous transactions."@en ;
	cmns-av:synonym
		"forward outright"@en ,
		"outright forward currency transaction"@en
		;
	.

fibo-der-drc-cur:CurrencyOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-cur:CurrencyDerivative ,
		fibo-der-drc-opt:VanillaOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-opt:hasStrikeRate ;
			owl:someValuesFrom fibo-fnd-acc-cur:ExchangeRate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:onClass fibo-ind-fx-fx:CurrencySpotBuyRate ;
				owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "currency option"@en ;
	skos:definition "option giving the buyer (holder) the right, but not the obligation, to buy or sell currency at a specified exchange rate during a specified period of time"@en ;
	cmns-av:abbreviation "FX option"@en ;
	cmns-av:explanatoryNote "For this right, a premium is paid to the broker, which will vary depending on the number of contracts purchased. Currency options are one of the best ways for corporations or individuals to hedge against adverse movements in exchange rates. Investors can hedge against foreign currency risk by purchasing a currency option put or call. For example, assume that an investor believes that the USD/EUR rate is going to increase from 0.80 to 0.90 (meaning that it will become more expensive for a European investor to buy U.S dollars). In this case, the investor would want to buy a call option on USD/EUR so that he or she could stand to gain from an increase in the exchange rate (or the USD rise)."@en ;
	cmns-av:synonym
		"foreign exchange option"@en ,
		"forex option"@en
		;
	.

fibo-der-drc-cur:CurrencySpotContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:CurrencyInstrument ,
		fibo-fbc-fi-fi:SpotContract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-cur:hasSpotExchangeRate ;
			owl:someValuesFrom fibo-ind-fx-fx:QuotedExchangeRate ;
		]
		;
	rdfs:label "currency spot contract"@en ;
	skos:definition "foreign-exchange contract for immediate delivery"@en ;
	cmns-av:explanatoryNote "Spot rates represent the price that a buyer expects to pay for a foreign currency in another currency at the time of the quote. Though the spot exchange rate is said to be settled immediately, the globally accepted settlement cycle for foreign-exchange contracts is two days. Foreign-exchange contracts are therefore settled on the second day after the day the deal is made."@en ;
	cmns-av:synonym "foreign exchange spot contract"@en ;
	.

fibo-der-drc-cur:CurrencySpotForwardSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-cur:CurrencySwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:someValuesFrom fibo-der-drc-cur:CurrencySpotContract ;
		]
		;
	rdfs:label "currency spot forward swap"@en ;
	skos:definition "foreign exchange agreement between two parties involving an exchange of two currencies at agreed fixed rates: a) on the spot settlement date and b) a reverse exchange on a later specified date"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	.

fibo-der-drc-cur:CurrencySwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-cur:CurrencyDerivative ,
		fibo-der-drc-swp:Swap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:someValuesFrom fibo-der-drc-cur:CurrencyForward ;
		]
		;
	rdfs:label "currency swap"@en ;
	skos:definition "foreign exchange agreement between two parties to exchange a given amount of one currency for another currency for spot delivery or for forward delivery at an agreed rate after a specified period of time"@en ;
	skos:note "In the case of a 'forward-forward' swap, both legs will be of type CurrencyFoward."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	.

fibo-der-drc-cur:CurrencyVolatilityOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-cur:CurrencyOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-ind-fx-fx:CurrencySpotVolatility ;
			] ;
		]
		;
	rdfs:label "currency volatility option"@en ;
	skos:definition "currency option whose underlying asset is based on the volatility of a foreign exchange rate"@en ;
	.

fibo-der-drc-cur:ForeignExchangeMasterAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:MasterAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-der-drc-cur:ForeignExchangeSettlementNettingProvision ;
		]
		;
	rdfs:label "foreign exchange master agreement"@en ;
	rdfs:seeAlso <https://www.newyorkfed.org/medialibrary/microsites/fxc/files/guidefx.pdf> ;
	skos:definition "product-specific master agreement intended to reflect best market practice and to provide a standard agreement for participants in the foreign exchange markets"@en ;
	cmns-av:explanatoryNote
		"The Foreign Exchange Committee of the Federal Reserve Bank of New York has approved and authorized publication of the Foreign Exchange and Options Master Agreement to cover foreign exchange spot and forward transactions as well as currency options."@en ,
		"The International Foreign Exchange Master Agreement (IFEMA) was published jointly by the British Bankers' Association and The Foreign Exchange Committee of the Federal Reserve Bank of New York in 1993 (an amended version was published in 1995). Foreign exchange settlement netting provisions are specified in such master agreements."@en
		;
	cmns-av:synonym "FX master agreement" ;
	.

fibo-der-drc-cur:ForeignExchangeSettlementNettingProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:SettlementNettingProvision ;
	rdfs:label "foreign exchange settlement netting provision"@en ;
	rdfs:seeAlso <https://www.newyorkfed.org/medialibrary/microsites/fxc/files/guidefx.pdf> ;
	skos:definition "settlement netting provision that is specific to foreign exchange contracts"@en ;
	cmns-av:explanatoryNote "Foreign exchange settlement netting, if between two counterparties, which is also referred to as bilateral settlement netting in this case, can take one of two forms, payment netting or novation netting. Often, one of these two methods will be found in combination with close-out netting in master agreements between trading counterparties. Close-out netting, as distinct from payment or novation netting, provides for contract liquidation procedures in the event that one of the parties defaults under a contract or become bankrupt. Payment and novation netting describe the day-to-day processes of calculating and paying net amounts."@en ;
	cmns-av:synonym "FX settlement netting provision" ;
	.

fibo-der-drc-cur:hasForwardExchangeRate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
	rdfs:label "has forward exchange rate"@en ;
	rdfs:domain fibo-der-drc-cur:CurrencyForward ;
	rdfs:range fibo-fnd-acc-cur:ExchangeRate ;
	skos:definition "rate of exchange between two currencies as specified in a forward contract"@en ;
	.

fibo-der-drc-cur:hasSpotExchangeRate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-ind-fx-fx:hasQuotedExchangeRate ;
	rdfs:label "has spot exchange rate"@en ;
	rdfs:range fibo-ind-fx-fx:QuotedExchangeRate ;
	skos:definition "rate of exchange between two currencies as specified as of some date and time as quoted by a specific source, typically for a spot contract"@en ;
	.

fibo-der-drc-bsc:CashflowExpression
	a owl:Class ;
	rdfs:subClassOf cmns-qtu:Expression ;
	rdfs:label "cashflow expression" ;
	skos:definition "expression that specifies a calculation of a cash flow as a component of a cashflow formula" ;
	.

fibo-der-drc-bsc:CashflowFormula
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:Formula ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:someValuesFrom fibo-der-drc-bsc:CashflowExpression ;
		]
		;
	rdfs:label "cashflow formula" ;
	skos:definition "formula for determining cashflows for a derivative instrument" ;
	.

fibo-der-drc-bsc:CashflowTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:DerivativeTerms ,
		fibo-fbc-dae-dbt:DebtTerms
		;
	rdfs:label "cashflow terms" ;
	skos:definition "terms setting out a cashflow structure of payments committed to by one party to a contract" ;
	skos:editorialNote "Swap cashflows are known as Swapstreams and are the terms for payment to and from either party. These are defined in swap transaction messages and represent the terms of the contract implied by that transaction. Options (Nordea reviews): Cashflows are defined as Payouts. This is not the same as a model of a cashflow which is a consequence of applying some legal term for payment of interest or principal, but is a commitment expressed in purely cashflow terms. Review this though. Payout terms include: Values - values can only go up or down; Static values are defined for limits and the like. i.e. Constraints (and direction) - this covers caps and floors - these are read upward or downward Conditionality Formula relations (Input and Output): - these are values - these may have a cap or a floor on them also - these also may have Multiplication - there is also fixed margin - may have addition or substraction between these Linearity in covered in the above Timing / expiry Observaton (not terms): Probability Sensitivity" ;
	.

fibo-der-drc-bsc:ContractForDifference
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:DerivativeInstrument ;
	rdfs:label "contract for difference"@en ;
	skos:definition "cash-settled derivative where the parties agree to exchange on the maturity of the contract the difference between the current value of the underlying asset and the initial value of that asset when the contract is initiated"@en ;
	skos:example "For example, suppose the initial price of share XYZ is $100 and a CFD for 1000 shares is exchanged. Both the buyer and seller must post some margin. If the price goes to $105, then the buyer gets $5,000 from the seller. If the price goes to $95, the buyer pays the seller $5,000. This contract avoids ownership of the stock and all the associated transactions issues (like stamp taxes). The contract also allows for leverage (typically 10:1) because the margin that must be posted is only a fraction of the value of the underlying asset."@en ;
	cmns-av:abbreviation "CFD"@en ;
	cmns-av:adaptedFrom
		"ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code" ,
		"https://www.nasdaq.com/glossary/c/contract-for-difference"^^xsd:anyURI
		;
	cmns-av:explanatoryNote "These contracts can also be on the difference of two assets' prices. They can also be on the difference of a single asset of different maturities (like a bond or futures contracts)."@en ;
	cmns-av:synonym "spread trading"@en ;
	.

fibo-der-drc-bsc:CreditDerivative
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:DerivativeInstrument ;
	rdfs:label "credit derivative"@en ;
	skos:definition "derivative instrument that is a privately held, negotiable bilateral contract traded over-the-counter (OTC) between two parties in a creditor/debtor relationship, enabling the creditor to effectively transfer some or all of the risk of a debtor defaulting to a third party"@en ;
	skos:example "Examples include credit default swaps (CDS), collateralized debt obligations (CDO), total return swaps, and credit spread options and forwards."@en ;
	cmns-av:explanatoryNote "The third party accepts the risk in return for payment, known as the premium."@en ;
	.

fibo-der-drc-bsc:DerivativeSettlementTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:DerivativeTerms ,
		fibo-fbc-pas-fpas:SettlementTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-bsc:hasAdditionalCosts ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-bsc:hasUnderlyingAssetPrice ;
			owl:onClass fibo-fnd-acc-cur:MonetaryPrice ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "derivative settlement terms" ;
	skos:definition "settlement terms specifying additional details with respect to what is to be delivered when, to whom, under what conditions at the time of settlement" ;
	.

fibo-der-drc-bsc:DerivativeTerms
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
	rdfs:label "derivative terms" ;
	skos:definition "contractual terms specific to derivative contracts, including terms related to payments and delivery between parties" ;
	.

fibo-der-drc-bsc:DerivativesClearingOrganization
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-fse:ClearingHouse ;
	rdfs:label "derivatives clearing organization" ;
	skos:definition "clearing house that enables parties to substitute the credit of the DCO for the credit of the parties" ;
	cmns-av:abbreviation "DCO" ;
	cmns-av:adaptedFrom "http://www.cftc.gov/IndustryOversight/ClearingOrganizations/index.htm"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"For options, the derivatives clearing organization is responsible for clearing transactions for put and call options on common stocks and other equity issues, stock indexes, foreign currencies, interest rate composites and single-stock futures."@en ,
		"Substitution may be done through contract novation, for example. A derivatives clearing organization (DCO) also arranges or provides, on a multilateral basis, for the settlement or netting of obligations, or otherwise provides clearing services or arrangements that mutualize or transfer credit risk among participants."
		;
	.

fibo-der-drc-bsc:EconomicRateBasedDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:RateBasedDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-ind-ei-ei:EconomicIndicator ;
			] ;
		]
		;
	rdfs:label "economic rate-based derivative" ;
	owl:equivalentClass fibo-der-rtd-rtd:EconomicRateBasedDerivativeInstrument ;
	skos:definition "rate-based derivative whose underlier is some economic indicator" ;
	.

fibo-der-drc-bsc:ForwardRateAgreement
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-bsc:InterestRateDerivative ;
	rdfs:label "forward rate agreement"@en ;
	owl:equivalentClass fibo-der-rtd-rtd:ForwardRateAgreement ;
	skos:definition "agreement to exchange an interest rate commitment on a notional amount at a future date"@en ;
	cmns-av:abbreviation "FRA"@en ;
	cmns-av:explanatoryNote "The FRA determines the rates to be used along with the termination date and notional value. FRAs are cash-settled with the payment based on the net difference between the interest rate of the contract and the floating rate in the market called the reference rate. The notional amount is not exchanged, but rather a cash amount based on the rate differentials and the notional value of the contract."@en ;
	.

fibo-der-drc-bsc:InterestRateDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:RateBasedDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-ind-ir-ir:ReferenceInterestRate ;
			] ;
		]
		;
	rdfs:label "interest rate derivative" ;
	owl:equivalentClass fibo-der-rtd-rtd:InterestRateDerivativeInstrument ;
	skos:definition "rate-based derivative whose underlier is an interest rate" ;
	skos:example "For example, interest rate derivative strategies are the simultaneous trading of two or more rate contracts in which two counterparties agree to exchange interest rate cash flows on defined dates during an agreed period, based on a specified notional amount, from a fixed rate to a floating rate, floating to fixed, fixed to fixed, or floating to floating." ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth edition, 2019-10" ;
	.

fibo-der-drc-bsc:IntroducingBroker
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-fse:NonDepositoryInstitution ,
		fibo-fbc-pas-fpas:Broker
		;
	rdfs:label "introducing broker" ;
	skos:definition "broker that solicits or accepts orders for derivatives that are traded on or subject to the rules of an exchange" ;
	cmns-av:abbreviation "IB" ;
	cmns-av:adaptedFrom "http://www.cftc.gov/IndustryOversight/Intermediaries/index.htm"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Introducing brokers do not accept money, securities, or property (or extend credit in lieu thereof) to margin, guarantee, or secure any trades or contracts that result or may result." ;
	.

fibo-der-drc-bsc:ObservableValue
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:Specification ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasValueExpressedIn ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-bsc:specifiesValueOf ;
			owl:someValuesFrom owl:Thing ;
		]
		;
	rdfs:label "observable value" ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/Fair_value> ;
	skos:definition "specification for the value for something discernible and for which evidence can be obtained" ;
	cmns-av:explanatoryNote "Derivatives, such as certain exotics, can be based on values ascribed to virtually anything, including weather. Typically, however, an observable value refers to something that can be readily observed in the marketplace, such as a quoted rate (e.g., interest rate, exchange rate), index value, commodity price, stock price, economic indicator, or something similar as of some point in time." ;
	.

fibo-der-drc-bsc:OverTheCounterDerivativeInstrument
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:OverTheCounterInstrument ,
		fibo-fbc-fi-fi:DerivativeInstrument
		;
	rdfs:label "over-the-counter derivative instrument" ;
	dct:source "ISO 4914:2021(en), Financial services - Unique product identifier (UPI)" ;
	skos:definition "derivative instrument that is not listed on an organized exchange" ;
	skos:note "ISO 4914 defines an OTC derivative instrument as a financial instrument that is, or would be, identified by an ISIN with the prefix 'EZ' or 'ZZ'. Details regarding how the prefix of an ISIN is determined can be found in ISO 6166:2020, Annex A." ;
	cmns-av:abbreviation "OTC derivative instrument" ;
	.

fibo-der-drc-bsc:OverTheCounterInstrument
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:FinancialInstrument ;
	rdfs:label "over-the-counter instrument" ;
	owl:disjointWith fibo-sec-sec-lst:ListedSecurity ;
	skos:definition "financial instrument and bilateral contract that is not listed on an organized exchange" ;
	cmns-av:abbreviation "OTC instrument" ;
	.

fibo-der-drc-bsc:ParametricCashflowTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:CashflowTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasFormula ;
			owl:someValuesFrom fibo-der-drc-bsc:CashflowFormula ;
		]
		;
	rdfs:label "parametric cashflow terms" ;
	skos:definition "terms for a set of cashflows defined according to a mathematical formula" ;
	.

fibo-der-drc-bsc:PayingParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractParty ,
		fibo-fnd-pas-psch:Payer ,
		fibo-fnd-pas-pas:Buyer
		;
	rdfs:label "paying party" ;
	skos:definition "party responsible for making payments in a transaction specified in a contract" ;
	.

fibo-der-drc-bsc:RateBasedDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:DerivativeInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:onClass [
					a owl:Class ;
					owl:unionOf (
						fibo-ind-ei-ei:EconomicIndicator
						fibo-ind-fx-fx:QuotedExchangeRate
						fibo-ind-ind-ind:MarketRate
						fibo-sec-sec-bsk:BasketOfIndices
					) ;
				] ;
				owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "rate-based derivative" ;
	owl:equivalentClass fibo-der-rtd-rtd:RateBasedDerivativeInstrument ;
	skos:definition "derivative instrument where the holder has the right but may not have the obligation, depending on the nature of the instrument, to enter into the underlying contract, or pay or receive payment related to the underlying financial rate (or rate contract) on a specified future date based on a specified future rate and term" ;
	skos:example "Examples of rate-based derivatives include interest rate swaps, forward rate agreements (FRAs), and interest rate options such as caps, floors, and collars." ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth edition, 2019-10" ;
	cmns-av:explanatoryNote "Rate-based derivatives derive their value from movements in some rate, e.g, an interest rate, market rate, economic indicator, statistical measure calculated over some collection of indices, rather than from traditional assets like stocks or commodities. They are commonly used by institutions to manage risks associated with interest rate fluctuations." ;
	.

fibo-der-drc-bsc:ReceivingParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractParty ,
		fibo-fnd-pas-psch:Payee ,
		fibo-fnd-pas-pas:Seller
		;
	rdfs:label "receiving counterparty" ;
	skos:definition "party that receives payments in a transaction specified in a contract" ;
	.

fibo-der-drc-bsc:UnderlyingAssetValuation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:ValueAssessment ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasCalculationAgent ;
			owl:onClass fibo-fbc-fi-fi:CalculationAgent ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:evaluates ;
			owl:someValuesFrom fibo-fbc-fi-fi:Underlier ;
		]
		;
	rdfs:label "underlying asset valuation"@en ;
	skos:definition "assessment activity to estimate the value of an underlying asset of a derivative"@en ;
	.

fibo-der-drc-bsc:UniqueProductIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:FinancialInstrumentIdentifier ,
		cmns-cxtid:StructuredIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-der-drc-bsc:OverTheCounterDerivativeInstrument ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:isRegisteredBy ;
			owl:someValuesFrom fibo-der-drc-bsc:UniqueProductIdentifierServiceProvider ;
		]
		;
	rdfs:label "unique product identifier" ;
	dct:source "ISO 4914:2021(en), Financial services - Unique product identifier (UPI)" ;
	skos:definition "sequence of characters uniquely identifying an OTC derivative product that is reportable to a trade repository" ;
	skos:scopeNote """At a minimum, the UPI code is applicable to OTC derivative instruments falling under the following categories of the Classification of Financial Instruments (ISO 10962):
		- Swaps (S)
		- Forwards (J)
		- Non-listed and complex listed options (H)
		- Others (miscellaneous) (M)""" ;
	cmns-av:abbreviation "UPI" ;
	cmns-av:explanatoryNote """The UPI code consists of 12 alphanumeric characters decomposed as follows:
		- the two-character prefix 'QZ'
		- nine alphanumeric characters (upper case A-Z and 0-9 only, excluding the vowel characters (A, E, I, O, U) and the character Y) without separators or special characters
		- one alphanumeric check character (A-Z and 0-9 only, excluding the vowel characters (A, E, I, O, U) and the character Y), calculated using the method specified in Annex C of the specification document.""" ;
	.

fibo-der-drc-bsc:UniqueProductIdentifierReferenceDataLibrary
	a
		owl:NamedIndividual ,
		cmns-ra:Registry
		;
	rdfs:label "unique product identifier reference data library" ;
	skos:definition "set of data comprised of reference data elements with specific values that together describe the product" ;
	cmns-org:isManagedBy fibo-der-drc-bsc:UniqueProductIdentifierServiceProvider ;
	.

fibo-der-drc-bsc:UniqueProductIdentifierRegistryEntry
	a owl:Class ;
	rdfs:subClassOf
		cmns-ra:RegistryEntry ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:allValuesFrom fibo-der-drc-bsc:OverTheCounterDerivativeInstrument ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isIncludedIn ;
			owl:hasValue fibo-der-drc-bsc:UniqueProductIdentifierReferenceDataLibrary ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-der-drc-bsc:UniqueProductIdentifier ;
		]
		;
	rdfs:label "unique product identifier registry entry" ;
	skos:definition "entry in a unique product identifier registry" ;
	cmns-av:explanatoryNote "The Reference Data Library (RDL) is a set of reference data elements, together with their values, which is properly organized and maintained by the UPI service provider. The library associates UPI codes with the values of the reference data elements characterizing the product. Each entry in the library (the registry entry) contains a minimum number of elements as defined in the ISO standard, and may be extended by the service provider." ;
	.

fibo-der-drc-bsc:UniqueProductIdentifierServiceProvider
	a
		owl:NamedIndividual ,
		owl:Class
		;
	rdfs:subClassOf
		cmns-ra:RegistrationAuthority ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:registers ;
			owl:onClass fibo-der-drc-bsc:UniqueProductIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "unique product identifier service provider" ;
	dct:source "ISO 4914:2021(en), Financial services - Unique product identifier (UPI)" ;
	skos:definition "organization designated by an external body of financial regulators to assign UPIs and operate a UPI reference data library" ;
	skos:scopeNote "At the time of publication of the ISO 4914 standard, there was only one such provider, the Regulatory Oversight Committee, confirmed by the Financial Stability Board as the International Governance Body for globally harmonised identifiers used to track OTC derivatives transactions." ;
	cmns-av:abbreviation "UPI service provider" ;
	.

fibo-der-drc-bsc:ValuationTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:DerivativeTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-asmt:hasDateOfAssessment ;
			owl:someValuesFrom cmns-dt:ExplicitDate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:involves ;
			owl:someValuesFrom fibo-der-drc-bsc:UnderlyingAssetValuation ;
		]
		;
	rdfs:label "valuation terms" ;
	skos:definition "contract terms specific to valuation of the underlying asset(s)" ;
	.

fibo-der-drc-bsc:hasAccretingNotionalAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasNotionalAmount ;
	rdfs:label "has accreting notional amount"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates that the notional amount increases through the life of the contract" ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10, clause 6.8.2" ;
	.

fibo-der-drc-bsc:hasAdditionalCosts
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has additional costs"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates costs, such as up front costs, brokerage fees and the like, that must be paid on delivery"@en ;
	.

fibo-der-drc-bsc:hasAmortizingNotionalAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasNotionalAmount ;
	rdfs:label "has amortizing notional amount"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates that the notional amount decreases through the life of the contract" ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10, clause 6.8.2" ;
	.

fibo-der-drc-bsc:hasConstantNotionalAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasNotionalAmount ;
	rdfs:label "has constant notional amount"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates that the notional amount is constant through the life of the contract" ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10, clause 6.8.2" ;
	.

fibo-der-drc-bsc:hasCustomNotionalAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasNotionalAmount ;
	rdfs:label "has custom notional amount"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates that the notional amount is customized per a notional step schedule" ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10, clause 6.8.2" ;
	.

fibo-der-drc-bsc:hasFirstDeliveryDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasExplicitDate ,
		cmns-dt:hasStartDate
		;
	rdfs:label "has first delivery date"@en ;
	rdfs:domain fibo-fbc-pas-fpas:SettlementTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the initial date in a range of dates by which the underlying asset (or some portion thereof) must be delivered in order for the terms of the contract to be fulfilled"@en ;
	.

fibo-der-drc-bsc:hasFirstNoticeDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasExplicitDate ,
		cmns-dt:hasStartDate
		;
	rdfs:label "has first notice date"@en ;
	rdfs:domain fibo-fbc-pas-fpas:SettlementTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the initial date on which a delivery notice can be issued"@en ;
	.

fibo-der-drc-bsc:hasLastDeliveryDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasEndDate ,
		cmns-dt:hasExplicitDate
		;
	rdfs:label "has last delivery date"@en ;
	rdfs:domain fibo-fbc-pas-fpas:SettlementTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the final date in a range of dates by which the underlying asset (or some portion thereof) must be delivered in order for the terms of the contract to be fulfilled"@en ;
	.

fibo-der-drc-bsc:hasLastNoticeDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasEndDate ,
		cmns-dt:hasExplicitDate
		;
	rdfs:label "has last notice date"@en ;
	rdfs:domain fibo-fbc-pas-fpas:SettlementTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the final date on which a delivery notice can be issued"@en ;
	.

fibo-der-drc-bsc:hasSettlementTerms
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has settlement terms"@en ;
	rdfs:domain fibo-fbc-fi-fi:DerivativeInstrument ;
	rdfs:range fibo-fbc-pas-fpas:SettlementTerms ;
	skos:definition "relates a derivative to contractual terms specific to the settlement process" ;
	.

fibo-der-drc-bsc:hasTickValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has tick value"@en ;
	rdfs:domain fibo-fbc-fi-fi:DerivativeInstrument ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the cash value of one tick, i.e., the minimum price change of the contract"@en ;
	.

fibo-der-drc-bsc:hasUnderlyingAssetPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has underlying asset price" ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "specifies a price for something on which the contract is based" ;
	.

fibo-der-drc-bsc:hasValuationTerms
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has valuation terms"@en ;
	rdfs:domain fibo-fbc-fi-fi:DerivativeInstrument ;
	rdfs:range fibo-der-drc-bsc:ValuationTerms ;
	skos:definition "relates a derivative to contractual terms specific to valuation of the underlying asset(s)" ;
	.

fibo-der-drc-bsc:specifiesValueOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-cxtdsg:appliesTo ,
		cmns-doc:specifies
		;
	rdfs:label "specifies value of"@en ;
	skos:definition "relates a derivative to contractual terms specific to valuation of the underlying asset(s)" ;
	.

fibo-der-drc-ma:AccountChangeNotificationObligation
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:NotificationObligation ;
	rdfs:label "account change notification obligation"@en ;
	skos:definition "obligation to notify a counterparty of any changes in account details"@en ;
	skos:example 'Example text: "Either party may change its account for receiving a payment or delivery by giving notice to the other party at least five Local Business Days prior to the scheduled date for the payment or delivery to which such change applies unless such other party gives timely notice of a reasonable objection to such change." Note that the notice period is given as a fact about the general kind of obligation which is Master Agreement Change notification Obligation.'@en ;
	.

fibo-der-drc-ma:DerivativeCreditSupportAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditEnhancementAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isSubordinateTo ;
			owl:onClass fibo-der-drc-ma:DerivativeMasterAgreement ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "derivative credit support agreement"@en ;
	skos:definition "addendum to the master agreement that governs the exchange of collateral between parties in derivatives transactions"@en ;
	cmns-av:explanatoryNote "Note that in the case of a derivative credit support agreement, the beneficiary actually holds the collateral and has the right to ask for additional collateral if its value falls below the threshold agreed upon per the agreement."@en ;
	.

fibo-der-drc-ma:DerivativeMasterAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditAgreement ,
		fibo-fnd-agr-ctr:MasterAgreement
		;
	rdfs:label "derivative master agreement"@en ;
	skos:definition "master agreement covering derivatives transactions to be carried out between the parties to this contract"@en ;
	skos:example
		'Related to conditions precedent that may apply: "Each obligation of each party under Section 2(a)(i) is subject to (1) the condition precedent that no Event of Default or Potential Event of Default with respect to the other party has occurred and is continuing, (2) the condition precedent that no Early Termination Date in respect of the relevant Transaction has occurred or been effectively designated and (3) each other applicable condition precedent specified in this Agreement. " In the above, the Obligations defined under Section 2(a)(i) of the Master Agrement is the obligation to make each payment or delivery defined in a Confirmation for a transaction carried out under this Master Agreement.'@en ,
		'Sample preamble to one of these: "EXAMPLE BANK, a Michigan banking corporation and SAMPLECOMPANY US, INC. a Delaware corporation have entered and/or anticipate entering into one or more transactions (each a "Transaction") that are or will be governed by this Master Agreement, which includes the schedule (the "Schedule"), and the documents and other confirming evidence (each a "Confirmation") exchanged between the parties confirming those Transactions. "'@en
		;
	cmns-av:explanatoryNote "The ISDA Master Agreement (Multicurrency-Cross Border version published in 1992) enables trading counterparties to include foreign exchange transactions under a global cross-product close-out netting master agreement. Because there are significant differences in market practices between the derivatives markets and the international foreign exchange spot and forward markets, parties to the ISDA frequently incorporate the ISDA FX and Currency Options Definitions and further tailor the ISDA Schedule to reflect standard market practice for the foreign exchange products."@en ;
	.

fibo-der-drc-ma:MasterAgreementEarlyTerminationRight
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:ContractualRight ;
	rdfs:label "master agreement early termination right"@en ;
	skos:definition "contractual right of a party to the master agreement to terminate the agreement early"@en ;
	cmns-av:explanatoryNote "This generally arises from some default event on the part of the other party."@en ;
	.

fibo-der-drc-exo:ArithmeticCalculationStrategy
	a
		owl:NamedIndividual ,
		fibo-der-drc-exo:AveragingStrategy
		;
	rdfs:label "arithmetic calculation strategy" ;
	rdfs:seeAlso fibo-fnd-utl-alx:ArithmeticMean ;
	skos:definition "strategy that uses an arithmetic mean calculation" ;
	.

fibo-der-drc-exo:AsianOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-der-drc-exo:AsianOptionClassifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-der-drc-exo:AveragingStrategy ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:usesCurrencyInAveraging ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasAsianTailPeriod ;
			owl:onClass cmns-dt:DatePeriod ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-ex:hasExerciseDate ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:usesWeightedAverage ;
			owl:onDataRange xsd:boolean ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "Asian option"@en ;
	skos:definition "option whose exercise terms involve a payoff determined by the average underlying price (either the strike price or the settlement price) of the underlying asset over a predetermined period"@en ;
	skos:example "For an Asian call option using arithmetic averaging and a 30-day period for sampling the data: On Nov. 1, a trader purchased a 90-day arithmetic call option on stock XYZ with an exercise price of $22, where the averaging is based on the value of the stock after each 30-day period. The stock price after 30, 60, and 90 days was $21.00, $22.00, and $24.00. The arithmetic average (mean) is (21.00 + 22.00 + 24.00) / 3 = 22.33. The profit is the average minus the strike price 22.33 - 22 = 0.33 or $33.00 per 100 share contract. As with standard options, if the average price is below the strike price, the loss is limited to the premium paid for the call options."@en ;
	skos:note "The averaging can be either a geometric or arithmetic average."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "These options allow the buyer to purchase (or sell) the underlying asset at the average price instead of the spot price. There are various ways to interpret the word 'average,' and that needs to be specified in the options contract. Typically, the average price is a geometric or arithmetic average of the price of the underlying asset at discreet intervals, which are also specified in the options contract. Because of the averaging feature, Asian options reduce the volatility inherent in the option; therefore, Asian options are typically cheaper than European or American options. They are used by traders who are exposed to the underlying asset over some time, such as consumers and suppliers of commodities, etc."@en ;
	.

fibo-der-drc-exo:AsianOptionClassifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-cls:FinancialInstrumentClassifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-der-drc-exo:AsianOption ;
		]
		;
	rdfs:label "Asian option classifier" ;
	skos:definition "financial instrument classifier that classifies Asian options based on whether they are rate-based or price based" ;
	.

fibo-der-drc-exo:AverageRate
	a
		owl:NamedIndividual ,
		fibo-der-drc-exo:AsianOptionClassifier
		;
	rdfs:label "average rate classification" ;
	skos:definition "Asian option classifier indicating that the payoff is based on the difference between a fixed strike price and the calculated average price of the underlying" ;
	.

fibo-der-drc-exo:AverageStrike
	a
		owl:NamedIndividual ,
		fibo-der-drc-exo:AsianOptionClassifier
		;
	rdfs:label "average strike classification" ;
	skos:definition "Asian option classifier indicating that the payoff is based on the difference between the price of the underlying at expiration and a strike price equal to the calculated average price of the underlying issue" ;
	.

fibo-der-drc-exo:AveragingStrategy
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:Strategy ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-der-drc-exo:AsianOption ;
		]
		;
	rdfs:label "averaging strategy"@en ;
	skos:definition "method used for calculating the average rate or price of an Asian option"@en ;
	.

fibo-der-drc-exo:BarrierOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasMonitoringFrequency ;
			owl:someValuesFrom xsd:positiveInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasMonitoringPeriod ;
			owl:someValuesFrom cmns-dt:DatePeriod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:isAboveStrikePrice ;
			owl:someValuesFrom xsd:boolean ;
		]
		;
	rdfs:label "barrier option"@en ;
	skos:definition "option whose final exercise depends upon the path taken by the price of an underlying instrument, i.e., whose payoff depends on whether or not the underlying asset has reached or exceeded a predetermined price"@en ;
	skos:note "For a knock-out barrier option, the option is cancelled if the underlying price crosses a predetermined barrier level; for a knock-in barrier option, the option becomes available-for-exercise if the underlying price crosses a predetermined barrier level."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote
		"A barrier option can be a knock-out, meaning it expires worthless if the underlying exceeds a certain price, limiting profits for the holder and limiting losses for the writer. It can also be a knock-in, meaning it has no value until the underlying reaches a certain price. Barrier options can be puts or calls. Barrier options typically have cheaper premiums than traditional vanilla options, primarily because the barrier increases the chances of the option expiring worthless. A trader may choose the cheaper (relative to a comparable vanilla) barrier option if they feel it is quite likely the underlying will hit the barrier."@en ,
		"Barrier features include any terms related to exercising the option ahead of the expiry date."@en
		;
	.

fibo-der-drc-exo:ChooserOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasOptionTypeElectionDate ;
			owl:someValuesFrom cmns-dt:ExplicitDate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-der-drc-opt:CallOption
					fibo-der-drc-opt:PutOption
				) ;
			] ;
		]
		;
	rdfs:label "chooser option"@en ;
	skos:definition "exotic option that allows its holder (buyer) to exercise the right to buy (call) or sell (put) specified assets at a fixed price whereby the buyer does not have to decide whether the contract will be a put or a call until an agreed future date, prior to expiration"@en ;
	skos:example "For example, assume a trader wants to have an option position for the updated XYZ Inc. earnings release. They think the stock will have a big move, but they are not sure in which direction. The earnings release is in one month, so the trader decides to buy a chooser option that will expire about three weeks after the earnings release. They believe this should provide enough time for the stock to make a significant move if it is going to make one, and fully digest the earnings release. Therefore, the option they choose will expire in seven to eight weeks. The chooser option allows them to exercise the option as a call if the price of XYZ rises, or as a put if the price falls. At the time of the chooser option purchase, XYZ is trading at $28. The trader chooses an at-the-money strike price of $28 and pays a premium of $2 or $200 for one contract ($2 x 100 shares). The buyer can't exercise the option prior to expiry since it is a European option. At expiry, the trader will determine if they will exercise the option as a call or put. Assume the price of XYZ at the time of expiry is $31. This is higher than the strike price of $28, therefore the trader will exercise the option as a call. Their profit is $1 ($31 - $28 - $2) or $100. If XYZ is trading between $28 and $29.99 the trader will still choose to exercise the option as a call, but they will still be losing money since the profit is not enough to offset their $2 cost. $30 is the breakeven point on the call. If the price of BAC is below $28, the trader will exercise the option as a put. In this case, $26 is the breakeven point ($28 - $2). If the underlying is trading between $28 and $26.01 the trader will lose money since the price didn't fall enough to offset the cost of the option. If the price of BAC falls below $26, say to $24, the trader will make money on the put. Their profit is $2 ($28 - $24 - $2) or $200."@en ;
	cmns-av:adaptedFrom
		"Commodity Futures Trading Commission (CFTC) glossary, https://www.cftc.gov/LearnAndProtect/EducationCenter/CFTCGlossary/glossary_c.html"@en ,
		"ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en
		;
	cmns-av:explanatoryNote "A chooser option is an option contract that allows the holder to decide whether it is a call or put prior to the expiration date. Chooser options usually have the same strike price and expiration date regardless of what decision the holder makes. Because the option could benefit from upside or downside movement, chooser options provide investors a great deal of flexibility and thus may cost more than comparable vanilla options. Chooser options are typically European style, and have one strike price and one expiration date regardless of whether the option is exercised as a call or put."@en ;
	.

fibo-der-drc-exo:CliquetOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-der-drc-exo:ForwardStartOption ;
		]
		;
	rdfs:label "cliquet option"@en ;
	skos:definition "exotic option that is a series of at-the-money (ATM) options, either puts or calls, where each successive option becomes active when the previous one expires"@en ;
	cmns-av:explanatoryNote
		"A cliquet is a cash-settled, exotic option that settles at predetermined dates and then resets its strike price based on the price of the underlying security at the time of settlement. Each new option within the cliquet enters into force when the previous option expires. The total premium and the exact reset dates are known at the time of transacting a cliquet. Investors can opt to receive their payout when each option expires or wait until the entire series plays out."@en ,
		"A cliquet is a series of forward start options, all related to each other. Each forward start option represents the advance purchase of a put, or call, option with an at-the-money (ATM) strike price to be determined at a later date, typically when the option becomes active. A forward start option becomes active at a specified date in the future. The premium is paid in advance, while the time to expiration and the underlying security are established at the time the forward start option is purchased. If at the first settlement date the underlying security trades below the strike price of the option (for a call), then it expires worthless and resets to the price of the underlying security at the time of settlement. If at the end of the next settlement the underlying security trades above the new strike, the holder may elect to receive the difference between the market price of the underlying security and the strike price. Alternatively, the holder can let it ride to receive the sum of all payouts at maturity. The main advantage of initiating a cliquet is, if an investor expects volatility to rise, they can lock in their profits at predetermined levels and thus maximize their overall portfolio return."@en
		;
	cmns-av:synonym "rachet option"@en ;
	.

fibo-der-drc-exo:CommodoreOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-der-drc-exo:DigitalOption ;
		]
		;
	rdfs:label "commodore option"@en ;
	skos:definition "exotic option consisting of a number of digital barrier options that pay a coupon if a pre-determined level of the underlying or basket of underlyings is reached"@en ;
	skos:example "A three-year commodore option with annual barriers would have three potential payoffs. The first would pay at the end of the first year and would be dependent on the pre-determined barrier being reached or exceeded. For example, if the underlying or basket of underlyings reached or exceeded 102% of its initial level at the end of year one, a coupon of 6% would be paid. At the end of year two, if the underlying reached or exceeded 104% of its initial level, another 6% coupon would be paid. The coupon in the final year would be 6% if the underlying reached or exceeded 106%. The coupon should exceed the performance level of the underlying, otherwise the investor would achieve the same result by investing directly in the underlying."@en ;
	cmns-av:explanatoryNote "Sometimes the digital barrier increases with the number of years since the trade began. All of the options are active from the start of the trade."@en ;
	.

fibo-der-drc-exo:CompoundOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-fi-fi:Option ;
		]
		;
	rdfs:label "compound option"@en ;
	skos:definition "exotic option for which the underlying asset is another option"@en ;
	skos:example "For example, assume an investor wants to buy a put to sell 100 shares of stock at $50. The stock is currently trading at $55. The investor could buy a Call-Put, which allows them to buy a call now, for say $1 per share ($100), which will allow them to buy a put with a $50 strike in the future. They pay the $1 per share now, but only need to pay the fee for the second option if they exercise the first resulting in them receiving the second option."@en ;
	cmns-av:explanatoryNote "Therefore, there are two strike prices and two exercise dates. They are available for any combination of calls and puts. For example, a put where the underlying is a call option or a call where the underlying is a put option. The underlying is the second option, while the initial option is called the overlying. If the compound option is exercised, there are two premiums."@en ;
	cmns-av:synonym "split-fee options"@en ;
	.

fibo-der-drc-exo:DigitalOption
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-exo:BarrierOption ;
	rdfs:label "digital option"@en ;
	skos:definition "exotic option that has a pre-determined payout if the option is in-the-money and the payoff condition is satisfied"@en ;
	skos:example "For example, let's say the ABC Index is trading at a level of 2,795 on June 2. An investor believes the ABC Index will trade above 2,800 before the end of the trading day, June 4th. The trader purchases 10 ABC Index options at a strike price of 2,800 options for $40 per contract. If the ABC Index closes above 2,800 at the end of the trading day on June 4, the investor is paid $100 per contract, which is a profit of $60 per contract or $600 (($100 - $40) x 10 contracts). However, if the ABC Index closes below 2,800 on June 4. The investor loses all of the premium amount or $400 ($40 x 10 contracts)."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "There is an upfront fee called the premium for digital options, which is the maximum loss for the option. Unlike traditional options, digital options don't convert or exercise to the underlying asset's shares. Instead, they pay out a fixed reward if the asset's price is above or below the option's strike price."@en ;
	cmns-av:synonym "binary option"@en ;
	.

fibo-der-drc-exo:DoubleBarrierOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-exo:BarrierOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasFirstRebateAmount ;
			owl:onClass fibo-fnd-acc-cur:PercentageMonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasSecondRebateAmount ;
			owl:onClass fibo-fnd-acc-cur:PercentageMonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasFirstBarrierPrice ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryPrice ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasSecondBarrierPrice ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryPrice ;
		]
		;
	rdfs:label "double barrier option"@en ;
	skos:definition "barrier option applied to currencies or over the counter stocks that works as a binary, or digital option in that it pays out only under defined circumstances, or it is worthless, at expiration"@en ;
	cmns-av:explanatoryNote "Considered an exotic option, a double barrier option is a combination of two single barrier options, with one barrier above and one barrier below the current price of the underlying. It is a bet by the holder that the underlying asset will move significantly, in the case of a knock-in barrier option, or will move by a very small amount, in the case of a knock-out barrier option, over the life of the contract. Traders use these options when they have an opinion on volatility but not on the direction of the underlying asset's next price move. A barrier option is a type of option where the payoff, and the very existence of the option, depends on whether or not the underlying asset reaches a predetermined price."@en ;
	.

fibo-der-drc-exo:FixedLookbackStrikeExpression
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:CashflowExpression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasMinuend ;
			owl:someValuesFrom fibo-der-drc-opt:StrikePrice ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasSubtrahend ;
			owl:someValuesFrom fibo-der-drc-exo:ObservedBestValue ;
		]
		;
	rdfs:label "fixed lookback strike expression"@en ;
	skos:definition "cashflow expression specifying the arguments required to calculate the fixed price at which the lookback option is to be exercised"@en ;
	.

fibo-der-drc-exo:FloatingLookbackStrikeExpression
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:CashflowExpression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasMinuend ;
			owl:someValuesFrom fibo-der-drc-exo:ProjectedValueAtMaturity ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasSubtrahend ;
			owl:someValuesFrom fibo-der-drc-exo:ObservedBestValue ;
		]
		;
	rdfs:label "floating lookback strike expression"@en ;
	skos:definition "cashflow expression specifying the arguments required to calculate the best projected price at which the lookback option may be exercised"@en ;
	.

fibo-der-drc-exo:ForwardStartOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-der-drc-opt:CallOption
					fibo-der-drc-opt:PutOption
				) ;
			] ;
		]
		;
	rdfs:label "forward start option"@en ;
	skos:definition "exotic option that is fully specified with respect to a set expiry date, underlying asset and other parameters, purchased and paid for on initiation, but that becomes active at a set activation date with a strike price determined at the time of activation"@en ;
	skos:example
		"For example, assume that two parties agree to enter into a call forward start option on XYZ stock. It is September and they agree that the forward start option will activate on January 1 at the money. That means on January 1 the strike price for the option will be the price that stock is trading at on that day. The option will expire in June. The exact strike price is unknown, but the parties do know the strike and underlying's price will be the same at activation. They can look at current six-month options (January to June) and assess volatility to determine a premium for the option. They agree to trade one contract, equivalent to 100 shares of the underlying stock. They decide on a premium of $40, or $4,000 for the contract ($40 x 100 shares). The call buyer agrees to pay the $4,000 now (September), even though the option doesn't activate till January. On January 1, assume the stock price is $400. The strike is set at $400, and an option is now a vanilla option with a June expiry. At the June expiry, assume XYZ is trading at $420. In this case, the option is worth $20 ($420 - $400 strike). If they settle in cash, the buyer receives $2,000, or if they exercise, they receive 100 shares at $400 and can keep them, or sell them at $420 to make $2,000. Notice that this still results in a loss for the buyer, since they paid $4,000 but are only receiving back $2,000. To make money on the call, the price of the underlying needs to move above the strike price plus the premium. Therefore, if the price moves up to $450 by expiration, the option is worth $50 ($450 - $400 strike), and the buyer receives $5,000. That's a net profit of $1,000 over their $4,000 cost. If the underlying is trading below the $400 strike at expiry, the call option expires worthless and the buyer's premium is lost ($4,000 profit to the seller)."@en ,
		"For example, the people buying/selling the option could specify that the strike will be at the money (ATM) at activation, or 3% or 5% in the money or out of the money (OTM). Since it is a customized contract, they can negotiate any terms they want."@en
		;
	cmns-av:explanatoryNote
		"Forward start options typically attempt to keep future strike prices at the money or near the money. In this way, the holder will have the right, but not the obligation, to buy (call) or sell (put) the underlying asset in the future at or near the then-current market price. Knowing where the strike price will be in relation to the underlying's price makes it easier to come up with the premium (cost) of the option, which is also typically determined and paid at the initiation of the contract prior to the activation date. If, at the expiration date, the underlying trades below the strike price of the option (for a call), then it expires worthless. If the underlying is above the strike (for a call), then the holder exercises it and owns the underlying at the strike price. For a put option, if the underlying is below the strike price, the option has value and will be sold or exercised to realize a gain. If the underlying is above the strike price, the option will expire worthless. Typically, as with most options, the holder may sell the option if it is in the money and take the cash instead of exercising the option. Since it is an exotic option, the seller and buyer of the option may also agree to settle the option with cash instead of delivering the underlying. Once a forward start option becomes active (strike price is set), then the option is valued like a vanilla option."@en ,
		"The only unknown for the contract is the strike price. In terms of pricing the contract, the future price of the underlying asset is also unknown. The contract typically stipulates some parameters for where the strike price will be in relation to the underlying asset's price."@en
		;
	.

fibo-der-drc-exo:GeometricCalculationStrategy
	a
		owl:NamedIndividual ,
		fibo-der-drc-exo:AveragingStrategy
		;
	rdfs:label "geometric calculation strategy" ;
	rdfs:seeAlso fibo-fnd-utl-alx:GeometricMean ;
	skos:definition "strategy that uses an geometric mean calculation" ;
	.

fibo-der-drc-exo:InterestRateCapOption
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-opt:InterestRateOption ;
	rdfs:label "interest rate cap option"@en ;
	owl:disjointWith fibo-der-drc-exo:InterestRateFloorOption ;
	skos:definition "interest rate derivative in which the buyer receives payments at the end of each period in which the interest rate exceeds the agreed strike price"@en ;
	skos:example "An example of a cap would be an agreement to receive a payment for each month the LIBOR rate exceeds 2.5%."@en ;
	cmns-av:explanatoryNote "The interest in each period is effectively capped by the strike rate. That is, the rate of interest may not go above the strike rate because the holder is expected to exercise the option to take the strike as the rate of interest instead."@en ;
	.

fibo-der-drc-exo:InterestRateFloorOption
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-opt:InterestRateOption ;
	rdfs:label "interest rate floor option"@en ;
	skos:definition "interest rate derivative in which the buyer receives payments at the end of each period in which the interest rate is below the agreed strike price"@en ;
	.

fibo-der-drc-exo:KnockInOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-exo:BarrierOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasFirstRebateAmount ;
			owl:onClass fibo-fnd-acc-cur:PercentageMonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasFirstBarrierPrice ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryPrice ;
		]
		;
	rdfs:label "knock-in option"@en ;
	skos:definition "barrier option that is not triggered until a certain price threshold is met"@en ;
	skos:example "Assume an investor purchases a knock-in put option with a down Direction, with a barrier price of $90 and a strike price of $100. The underlying security is trading at $110, and the option expires in three months. If the price of the underlying security reaches $90, the option comes into existence and becomes a vanilla option with a strike price of $100. Thereafter, the holder of the option has the right to sell the underlying asset at the strike price of $100, even though it is trading below $90. It is this right that gives the option value. The put option remains active until the expiration date, even if the underlying security rebounds back above $90. However, if the underlying asset does not fall below the barrier price during the life of the contract, the down-and-in option expires worthless. Just because the barrier is reached does not assure a profit on the trade since the underlying would need to stay below $100 (after triggering the barrier) in order for the option to have value."@en ;
	cmns-av:explanatoryNote "If the price is never reached, it is as if the contract never existed. However, if the underlying asset reaches a specified barrier, the knock-in option comes into existence. The difference between a knock-in and knock-out option is that a knock-in option comes into existence only when the underlying security reaches a barrier, while a knock-out option ceases to exist when the underlying security reaches a barrier."@en ;
	.

fibo-der-drc-exo:KnockOutOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-exo:BarrierOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasFirstRebateAmount ;
			owl:onClass fibo-fnd-acc-cur:PercentageMonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasFirstBarrierPrice ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryPrice ;
		]
		;
	rdfs:label "knock-out option"@en ;
	skos:definition "barrier option with a built-in mechanism to expire as worthless if a specified price level in the underlying asset is reached"@en ;
	skos:example "Assume an investor purchases a Knock-Out call option with a down Direction, also called a 'Down and Out Option', on a stock that is trading at $60 with a strike price of $55 and a barrier of $50. Assume the stock trades below $50, at any time, before the call option expires. Therefore, the down-and-out call option promptly ceases to exist."@en ;
	cmns-av:explanatoryNote "A knock-out option sets a cap on the level an option can reach in the holder's favor. As knock-out options limit the profit potential for the option buyer, they can be purchased for a smaller premium than an equivalent option without a knock-out stipulation."@en ;
	.

fibo-der-drc-exo:LookbackOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-der-drc-exo:LookbackStrikeTerms ;
		]
		;
	rdfs:label "lookback option"@en ;
	skos:definition "exotic option that minimizes the uncertainties related to the timing of market entry, providing the holder the advantage of knowing history when determining when to exercise their option"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote
		"As a type of exotic option, the lookback allows the user to 'look back,' or review, the prices of an underlying asset over the lifespan of the option after it has been purchased. The holder may then exercise the option based on the most beneficial price of the underlying asset. The holder can take advantage of the widest differential between the strike price and the price of the underlying asset. Lookback options do not trade on major exchanges. Instead, they are unlisted and trade over-the-counter (OTC). This type of option reduces uncertainties associated with the timing of market entry and reduces the chances the option will expire worthlessly. Lookback options are expensive to execute, so these advantages come at a cost."@en ,
		"Lookback options are cash settled options, which means the holder receives a cash settlement at execution based on the most advantageous differential between high and low prices during the purchase period. Sellers of lookback options would price the option at or near the widest expected distance of price differential based on past volatility and demand for the options. The cost to purchase this option would be taken up front. The settlement will equate to the profits they could have made from buying or selling the underlying asset. If the settlement was greater than the initial cost of the option, then the option buyer would have profit at settlement, otherwise loss."@en
		;
	.

fibo-der-drc-exo:LookbackStrikeTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:DerivativeTerms ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:onClass fibo-der-drc-exo:FixedLookbackStrikeExpression ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:onClass fibo-der-drc-exo:FloatingLookbackStrikeExpression ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-exo:hasLookbackPeriod ;
			owl:someValuesFrom cmns-dt:DatePeriod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-ind-ind-ind:PriceStructure ;
		]
		;
	rdfs:label "lookback strike terms"@en ;
	skos:definition "terms specifying the value of the underlying asset based on analysis during a specific period, typically ending in the maturity of the option, whereby the payoff is determined by comparing the strike price with the value of the selected price"@en ;
	cmns-av:explanatoryNote
		"In the case of a fixed strike, the terms depend on whether the option is a call or put. If it is a call, the calculated payout reflects the difference between a running maximum value of the observable during the lookback period, and the pre-agreed strike."@en ,
		"The payoff may either be the difference between a fixed, pre-agreed Strike Price and the observable, or the difference between the best or worst valuable of the observable and the value of that same observable at maturity of the contract (these are the Fixed and Floating lookback terms respectively). This (per review at Nordea) is not mutually exclusive with the terms for Fixed Strike and Resettable Strike, that is, either of those kinds of strike terms may apply, and Lookback strike terms may also apply."@en
		;
	.

fibo-der-drc-exo:LowExercisePriceOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:CallOption ,
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-opt:hasExerciseStyle ;
			owl:hasValue fibo-sec-dbt-ex:EuropeanExerciseConvention ;
		]
		;
	rdfs:label "low exercise price option"@en ;
	skos:definition "exotic option that is a European-style call option with an exercise price of one cent that mimics a futures contract"@en ;
	cmns-av:abbreviation "LEPO"@en ;
	cmns-av:explanatoryNote "LEPOs function as deep-in-the-money options similar to the stock itself. Both buyer and seller of a LEPO operate on margin. LEPO options are not available on any U.S. exchanges. Since the strike price is so close to zero, the investor purchasing the LEPO gains most of the features of owning the share directly with the major exceptions of dividends and voting rights. They are only available with European style expirations."@en ;
	.

fibo-der-drc-exo:MountainRangeOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-sec-bsk:MixedBasket ;
			] ;
		]
		;
	rdfs:label "mountain range option"@en ;
	skos:definition "exotic option based on multiple underlying securities"@en ;
	skos:example "Mountain range options are named after a series of mountains, each representing a different type of contract. Some of the most common include: (a) Altiplano options: Altiplano options provide investors with the features of both a traditional vanilla option along with a coupon payment, (b) Annapurna options: coupon rates are determined by the performance of the basket's worst-performing security when it drops under a specified range, (c) Everest options: Everest options place a long-term limit on an investor's option while offering a payout based on the lagging performers in the basket, (d) Atlas options: this type of option eliminates both the best - and worst - performing stocks in a basket of securities, and (e) Himalayan options: traders receive a payout based on the basket's best performing stock; payouts are provided on multiple dates."@en ;
	cmns-av:explanatoryNote
		"The price of a mountain range option is based on multiple variables, the most important of which are the correlations between the individual securities in the basket. Some options have discrete payout levels, such as double the investment or triple the investment, if certain performance metrics are hit by the underlying securities while the option is in effect. Mountain range options cannot be priced with standard closed-form approaches. These exotic instruments instead require Monte Carlo simulation methods. Effects such as volatility skew, which is found in most options, can be even more pronounced within mountain range options."@en ,
		"These options blend some of the key characteristics of basket-style or rainbow options—both of which have more than one underlying security or asset—and range options with multiyear time ranges. Prices are based on multiple variables - notably the correlations between the individual securities in the basket."@en
		;
	.

fibo-der-drc-exo:ObservedBestValue
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-ip:MarketPrice ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasAsOfDate ;
			owl:someValuesFrom cmns-dt:Date ;
		]
		;
	rdfs:label "observed best value"@en ;
	skos:definition "observed value of the underlying asset as of some date during the lookback period that is considered the best value from the perspective of the option holder during the lookback period (depending on whether the option is a call or put)"@en ;
	.

fibo-der-drc-exo:ProjectedValueAtMaturity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:CalculatedPrice ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasObservedDateTime ;
			owl:someValuesFrom cmns-dt:CombinedDateTime ;
		]
		;
	rdfs:label "projected value at maturity"@en ;
	skos:definition "expected value of the underlying asset at maturity calculated as of some date during the lookback period"@en ;
	.

fibo-der-drc-exo:RainbowOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-sec-bsk:MixedBasket ;
			] ;
		]
		;
	rdfs:label "rainbow option"@en ;
	skos:definition "exotic option linked to the performances of two or more underlying assets"@en ;
	skos:example
		'A best of assets plus cash rainbow effectively has n + 1 payoff possibilities. If we consider a 2 asset "best of plus cash", the payoff at expiry is a choice between Asset 1, Asset 2, or the predetermined cash amount. There is no strike price and the payoff is given as: Rainbow = max(S1, S2, Cash;T)'@en ,
		"An asset maximum or minimum payout rainbow is similar to the best of n assets plus cash, with the exception that no cash payoff is possible and there is a strike price for this type of option. The payoff of a call and put are given as: Rainbow-Call = max[0, max(S1, S2) - X] Rainbow-Put = max[0, X - max(S1, S2)] Minimum of n Assets. The counterpart to a maximum of n assets, this rainbow pays out the value of the underperformer of the n assets. The payoff for minimum of 2 asset rainbow calls and puts are given as: Rainbow-Call = max[0, mainS1, S2) - X] Rainbow-Put = max[0, X - min(S1, S2)]"@en ,
		"Better of n Assets This type of rainbow is similar to the best of n assets plus cash but with the exception that there is no possible cash payoff, and X is set to 0. With this in mind, a better of 2 assets rainbow is essentially a two-asset call option, with a payoff being: Rainbow = max[0, max(S1, S2)] Worse of n Assets Essentially the opposite to the better of n assets, with the payoff being on the asset with the lower value. We can give the payoff for this option on 2 assets as: Rainbow = max[0, min(S1, S2)]"@en
		;
	cmns-av:explanatoryNote
		"Rainbbow options can speculate on the best performer in the group or minimum performances of all the underlying assets at one time. Each underlying may be called a color so the sum of all of these factors makes up a rainbow. These structures can be rather exotic and made for institutional clients when referring to financial assets. Rainbow options can be structured in many ways depending on how the performances of each underlying asset are considered. Some pay off based on the best or worst performance among the underlying assets. In other words, it looks at the top or bottom performance and pays off based on that single asset. These are sometimes called 'best of' or 'worst of' rainbow options."@en ,
		"Rainbow options are usually calls or puts on the best or worst of n underlying assets. Like a basket option, which is written on a group of assets and pays out on a weighted-average gain on the basket as a whole, a rainbow option also considers a group of assets, but usually pays out on the level of one of them. A simple example is a call rainbow option written on FTSE 100, Nikkei and S&P 500 which will pay out the difference between the strike price and the level of the index that has risen by the largest amount of the three."@en
		;
	.

fibo-der-drc-exo:Swaption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-der-drc-swp:Swap ;
			] ;
		]
		;
	rdfs:label "swaption"@en ;
	skos:definition "over-the-counter option that confers the right but not the obligation, to enter into a swap transaction at some time in the future"@en ;
	cmns-av:explanatoryNote "A swaption, also known as a swap option, refers to an option to enter into an interest rate swap or some other type of swap. In exchange for an options premium, the buyer gains the right but not the obligation to enter into a specified swap agreement with the issuer on a specified future date."@en ;
	cmns-av:synonym "swap option"@en ;
	.

fibo-der-drc-exo:hasAsianTailPeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has Asian tail period"@en ;
	rdfs:domain fibo-der-drc-exo:AsianOption ;
	rdfs:range cmns-dt:DatePeriod ;
	skos:definition "window of time during which averaging of the price of the underlying contract is effective"@en ;
	.

fibo-der-drc-exo:hasFirstBarrierPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has first barrier price"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "has price (or level) that activates or deactivates the option"@en ;
	cmns-av:explanatoryNote "For a double barrier option, this is the level of the first barrier. Otherwise it is the only barrier price."@en ;
	.

fibo-der-drc-exo:hasFirstRebateAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has first rebate amount"@en ;
	rdfs:range fibo-fnd-acc-cur:PercentageMonetaryAmount ;
	skos:definition "indicates the percentage of the premium paid by the holder for the option"@en ;
	cmns-av:explanatoryNote "Both knock-out and knock-in barrier options can contain a provision to provide rebates to holders, if the option does not reach the barrier price and becomes worthless."@en ;
	.

fibo-der-drc-exo:hasLookbackPeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has lookback period"@en ;
	rdfs:domain fibo-der-drc-exo:LookbackStrikeTerms ;
	rdfs:range cmns-dt:DatePeriod ;
	skos:definition "window of time during which the lookback is effective"@en ;
	.

fibo-der-drc-exo:hasMonitoringFrequency
	a owl:DatatypeProperty ;
	rdfs:label "has monitoring frequency"@en ;
	rdfs:domain fibo-der-drc-exo:BarrierOption ;
	rdfs:range xsd:positiveInteger ;
	skos:definition "has frequency with respect to how often, in days, the asset price is checked to see if the barrier has been breached"@en ;
	.

fibo-der-drc-exo:hasMonitoringPeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has monitoring period"@en ;
	rdfs:domain fibo-der-drc-exo:BarrierOption ;
	rdfs:range cmns-dt:DatePeriod ;
	skos:definition "window of time during which pricing is monitored"@en ;
	.

fibo-der-drc-exo:hasOptionTypeElectionDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has option type election date"@en ;
	rdfs:domain fibo-der-drc-exo:ChooserOption ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the date on which the holder of the chooser option contract determines a choice of either a call or a put"@en ;
	.

fibo-der-drc-exo:hasSecondBarrierPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has second barrier price"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "has price (or level) that the second barrier activates or deactivates in the case of a double barrier option"@en ;
	.

fibo-der-drc-exo:hasSecondRebateAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has second rebate amount"@en ;
	rdfs:range fibo-fnd-acc-cur:PercentageMonetaryAmount ;
	skos:definition "indicates the percentage of the premium paid by the holder in the case of a double barrier option"@en ;
	.

fibo-der-drc-exo:isAboveStrikePrice
	a owl:DatatypeProperty ;
	rdfs:label "is above strike price"@en ;
	rdfs:domain fibo-der-drc-exo:BarrierOption ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the barrier is crossed when the price of the underlier is above (or below, if not) the strike price (threshold)"@en ;
	.

fibo-der-drc-exo:usesCurrencyInAveraging
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasCurrency ;
	rdfs:label "uses currency in averaging"@en ;
	rdfs:range fibo-fnd-acc-cur:Currency ;
	skos:definition "indicates the currency used in averaging calculation"@en ;
	.

fibo-der-drc-exo:usesWeightedAverage
	a owl:DatatypeProperty ;
	rdfs:label "uses weighted average"@en ;
	rdfs:domain fibo-der-drc-exo:AsianOption ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether a weighted average is being used to calculate the average rate or strike price"@en ;
	.

fibo-der-drc-ff:BasketFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-sec-bsk:MixedBasket ;
			] ;
		]
		;
	rdfs:label "basket future"@en ;
	skos:definition "futures contract whose underlying asset is a basket of securities and/or indices"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:BondFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:DebtInstrumentFuture ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-dbt-bnd:Bond ;
			] ;
		]
		;
	rdfs:label "bond future"@en ;
	skos:definition "futures contract whose underlying asset is at least one bond"@en ;
	.

fibo-der-drc-ff:CurrencyFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-cur:CurrencyDerivative ,
		fibo-der-drc-ff:FinancialFuture
		;
	rdfs:label "currency future"@en ;
	skos:definition "futures contract whose underlying asset is an agreement to exchange a specified amount of one currency for another at some point in the future based on pricing stated in the contract"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:synonym
		"foreign exchange future"@en ,
		"forex future"@en
		;
	.

fibo-der-drc-ff:DebtInstrumentFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		fibo-der-sbd-sbd:DebtInstrumentDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-fbc-fi-fi:DebtInstrument ;
			] ;
		]
		;
	rdfs:label "debt instrument future"@en ;
	skos:definition "futures contract whose underlying asset is at least one debt instrument"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:DividendAdjustmentPeriod
	a owl:Class ;
	rdfs:subClassOf cmns-dt:DatePeriod ;
	rdfs:label "dividend adjustment period"@en ;
	skos:definition "date period used to calculate the difference, if any between an anticipated dividend and the actual dividend distributed in that period"@en ;
	.

fibo-der-drc-ff:DividendFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		fibo-der-sbd-sbd:EquityDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:ListedShare ;
			] ;
		]
		;
	rdfs:label "dividend future"@en ;
	skos:definition "futures contract whose underlying asset is at least one stock dividend"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:EquityForward
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:Forward ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-ff:hasDividendAdjustmentPeriod ;
			owl:someValuesFrom fibo-der-drc-ff:DividendAdjustmentPeriod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-ff:hasMethodOfAdjustment ;
			owl:someValuesFrom fibo-der-drc-ff:ForwardContractAdjustmentMethod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-der-drc-ff:EquityFuture
						fibo-der-drc-opt:EquityOption
						fibo-ind-mkt-bas:BasketOfEquities
						fibo-ind-mkt-bas:EquityIndex
						fibo-sec-eq-eq:ListedShare
					) ;
				] ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-fbc-pas-fpas:SettlementTerms ;
		]
		;
	rdfs:label "equity forward"@en ;
	skos:definition "forward contract to buy or sell the underlying equity stock, equity index, basket of equity stock, equity futures contract, or equity option at a specified future date at the price specified at the outset of the contract"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:EquityFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		fibo-der-sbd-sbd:EquityDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:ListedShare ;
			] ;
		]
		;
	rdfs:label "equity future"@en ;
	skos:definition "futures contract whose underlying asset is at least one equity security, specifically a publicly issued and traded share"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:FinancialFuture
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:Future ;
	rdfs:label "financial future"@en ;
	skos:definition "futures contract based on underlying assets excluding commodities"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:Forward
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:OverTheCounterDerivativeInstrument ,
		fibo-fbc-fi-fi:DerivativeInstrument
		;
	rdfs:label "forward"@en ;
	skos:definition "derivative instrument that is privately negotiated between parties to buy the underlier at a specified future date at the price specified in the contract"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote
		"Certain contracts labeled 'forwards', such as London Metal Exchange (LME) Forwards, are actually futures and are exchange-traded. Some power and gas markets, such as Nord Pool, trade electricity forwards with clearinghouse support. Per the ontology, both would be classified as futures by definition, but naming blurs the lines."@en ,
		"Since forward contracts are not exchange traded, there is no mark-to-market requirement, which allows a buyer to avoid almost all capital outflow initially (though some counterparties might set collateral requirements). The forward price makes the forward contract have no value when the contract is written. However, if the value of the underlying commodity changes, the value of the forward contract becomes positive or negative, depending on the position held. Forwards are priced in a manner similar to futures. Like in the case of a futures contract, the first step in pricing a forward is to add the spot price to the cost of carry (interest forgone, convenience yield, storage costs and interest/dividend received on the underlying). Unlike a futures contract though, the price may also include a premium for counterparty credit risk, and the fact that there is not daily marking to market process to minimize default risk. If there is no allowance for these credit risks, then the forward price will equal the futures price."@en ,
		"The primary distinctions between futures and forwards are (1) forwards are bilateral and privately negotiated, (2) forwards are over-the-counter instruments rather than exchange traded, (3) forwards are fully customizable whereas futures are typically standardized, (4) the risk associated with a forward is assumed by the counterparties whereas it is mitigated via central clearing for futures, and (5) there is typically no margin requirement for a forward whereas futures require margin posting."@en
		;
	cmns-av:synonym "forward contract"@en ;
	.

fibo-der-drc-ff:ForwardContractAdjustmentMethod
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Strategy ;
	rdfs:label "forward contract adjustment method"@en ;
	skos:definition "method by which adjustments will be made to the contract should one or more of a number of extraordinary events occur"@en ;
	.

fibo-der-drc-ff:FutureOnFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-fbc-fi-fi:Future ;
			] ;
		]
		;
	rdfs:label "future on future"@en ;
	skos:definition "futures contract whose underlying asset is at least one (other) futures contract"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:FutureOnOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-fbc-fi-fi:Option ;
			] ;
		]
		;
	rdfs:label "future on option"@en ;
	skos:definition "futures contract whose underlying asset is at least one option contract"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:FutureOnSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-der-drc-swp:Swap ;
			] ;
		]
		;
	rdfs:label "future on swap"@en ;
	skos:definition "futures contract whose underlying asset is at least one swap contract"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-ff:IndexFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-ind-ei-ei:EconomicIndicator
						fibo-ind-mkt-bas:ReferenceIndex
					) ;
				] ;
			] ;
		]
		;
	rdfs:label "index future"@en ;
	skos:definition "futures contract whose underlying asset is at least one reference index or economic indicator"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote "For each index there may be a different multiple for determining the price of the futures contract."@en ;
	.

fibo-der-drc-ff:InterestRateFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:FinancialFuture ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-fbc-fi-fi:CashInstrument
						fibo-sec-dbt-dbti:FixedIncomeSecurity
					) ;
				] ;
			] ;
		]
		;
	rdfs:label "interest rate future"@en ;
	skos:definition "futures contract with an interest-bearing instrument as the underlying asset"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote "Most interest rate futures that trade on American exchanges use U.S. Treasury securities, such as Treasury bills, Treasury bonds, certificates of deposit, Treasury notes, and Ginnie Mae securities, as the underlying asset."@en ;
	.

fibo-der-drc-ff:MoneyMarketFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-ff:DebtInstrumentFuture ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-dbt-tstd:MoneyMarketInstrument ;
			] ;
		]
		;
	rdfs:label "money market future"@en ;
	skos:definition "futures contract with a money market instrument as the underlying asset"@en ;
	.

fibo-der-drc-ff:StandardizedFuturesListingTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:DerivativeTerms ,
		fibo-fbc-fi-fi:StandardizedTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:hasPublisher ;
			owl:someValuesFrom fibo-fbc-fct-mkt:DesignatedContractMarket ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-sec-sec-lst:Listing ;
		]
		;
	rdfs:label "standardized futures listing terms"@en ;
	skos:definition "contract terms established by a derivatives exchange that apply to any listing of a futures contract on that exchange."@en ;
	cmns-av:explanatoryNote "Individual listings will take on these standard terms but they are not contractual terms of the futures contract, they are facts about that listing on that exchange."@en ;
	.

fibo-der-drc-ff:StandardizedFuturesTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:DerivativeTerms ,
		fibo-fbc-fi-fi:StandardizedTerms ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-fi-fi:Future ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:someValuesFrom fibo-fbc-pas-fpas:SettlementTerms ;
		]
		;
	rdfs:label "standardized futures terms"@en ;
	skos:definition "contract terms established by a derivatives exchange that apply to any futures contract traded on that exchange"@en ;
	cmns-av:explanatoryNote "Standard symbology for the commodities are standardized by the exchanges as part of their standard contracts, for example trading in standard bushels, commonly defined kinds of oil and so on. These give the units in which lot sizes are described and defined."@en ;
	.

fibo-der-drc-ff:hasConversionFactor
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has conversion factor"@en ;
	rdfs:domain fibo-der-drc-ff:BondFuture ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the price of the delivered bond/note ($1 par value) to yield a fixed rate. The conversion factor is used to calculate a final delivery price."@en ;
	.

fibo-der-drc-ff:hasDividendAdjustmentPeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has dividend adjustment period"@en ;
	rdfs:domain fibo-der-drc-ff:EquityForward ;
	rdfs:range fibo-der-drc-ff:DividendAdjustmentPeriod ;
	skos:definition "indicates at least one date period used to calculate the deviation between an anticipated/expected dividend and the actual dividend issued during that period"@en ;
	.

fibo-der-drc-ff:hasMethodOfAdjustment
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-gao-obj:hasStrategy ;
	rdfs:label "has method of adjustment"@en ;
	rdfs:domain fibo-der-drc-ff:EquityForward ;
	rdfs:range fibo-der-drc-ff:ForwardContractAdjustmentMethod ;
	skos:definition "indicates the method used to address any changes to the contract based on events that occur over the contract lifecycle"@en ;
	.

fibo-der-drc-ff:hasMultiple
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has multiple"@en ;
	rdfs:domain fibo-der-drc-ff:IndexFuture ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the multiple for determining the price of the futures contract in relation to the underlying index rate"@en ;
	.

fibo-der-drc-opt:AtTheMoney
	a
		owl:NamedIndividual ,
		fibo-der-drc-opt:Moneyness
		;
	rdfs:label "at-the-money"@en ;
	skos:definition "moneyness classifier that refers to an option whose value in terms of its strike price is the same or close to the current market price of the underlying security"@en ;
	cmns-av:abbreviation "ATM"@en ;
	cmns-av:explanatoryNote "An ATM option has a delta of ±0.50, positive if it is a call, negative for a put."@en ;
	.

fibo-der-drc-opt:BasketOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:ExoticOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-sec-bsk:MixedBasket ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-ip:hasPriceDeterminationMethod ;
			owl:someValuesFrom fibo-fbc-fi-ip:PriceDeterminationMethod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractDuration ;
			owl:someValuesFrom cmns-dt:ExplicitDuration ;
		]
		;
	rdfs:label "basket option"@en ;
	skos:definition "option whose underlying asset is a group, or basket, of commodities, securities, indices, or currencies"@en ;
	cmns-av:explanatoryNote "As with other options, a basket option gives the holder the right, but not the obligation, to buy or sell the basket at a specific price, on or before a certain date. This exotic option has all the characteristics of a standard option, but with the basis of the strike price on the weighted value of its components. Currency baskets are the most popular type of basket option, and they will settle in the holder's home currency. Because it involves just one transaction, a basket option often costs less than multiple single options as it saves on commissions and fees."@en ;
	.

fibo-der-drc-opt:BondOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:FixedIncomeOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-dbt-bnd:Bond ;
			] ;
		]
		;
	rdfs:label "bond option"@en ;
	skos:definition "option giving the buyer (holder) the right, but not the obligation, to buy or sell (depending on whether it is a call or a put) a bond at a certain price on or before a specified date"@en ;
	.

fibo-der-drc-opt:Butterfly
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:OptionTradingStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-opt:hasExercisePrice ;
			owl:onClass fibo-der-drc-opt:StrikePrice ;
			owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fbc-fi-fi:Option ;
			owl:qualifiedCardinality "4"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "butterfly"@en ;
	skos:definition "strategy that combines bull and bear spreads with a fixed risk and capped profit"@en ;
	cmns-av:explanatoryNote "These spreads are intended as a market-neutral strategy and pay off the most if the underlying asset does not move prior to option expiration. They involve either four calls, four puts, or a combination of puts and calls with three strike prices. Butterfly spreads pay off the most if the underlying asset price doesn't change before the option expires. The upper and lower strike prices are equal distance from the middle, or at-the-money, strike price."@en ;
	.

fibo-der-drc-opt:CallOption
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:Option ;
	rdfs:label "call option"@en ;
	skos:definition "option giving the buyer (holder) the right, but not the obligation, to buy the assets specified at a fixed price or formula, on or before a specified date"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "The seller (issuer) of the call option assumes the obligation of delivering the assets specified should the buyer exercise the option."@en ;
	.

fibo-der-drc-opt:CappedOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:VanillaOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-opt:hasCapPrice ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryPrice ;
		]
		;
	rdfs:label "capped option"@en ;
	skos:definition "option with an established profit cap or cap price"@en ;
	cmns-av:explanatoryNote "The cap price is equal to the option's strike price plus a cap interval for a call option or the strike price minus a cap interval for a put option. A capped option is automatically exercised when the underlying security closes at or above (for a call) or at or below (for a put) the option's cap price."@en ;
	.

fibo-der-drc-opt:Collar
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:OptionTradingStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CallOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:PutOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "collar"@en ;
	skos:definition "option trading strategy that involves buying a downside put and selling an upside call that is implemented to protect against large losses, but which also limits large upside gains"@en ;
	.

fibo-der-drc-opt:CondorSpread
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-opt:OptionTradingStrategy ;
	rdfs:label "condor spread"@en ;
	skos:definition "non-directional options strategy that limits both gains and losses while seeking to profit from either low or high volatility"@en ;
	cmns-av:explanatoryNote "There are two types of condor spreads. A long condor seeks to profit from low volatility and little to no movement in the underlying asset. A short condor seeks to profit from high volatility and a sizable move in the underlying asset in either direction. A Condor Spread uses either all calls or all puts."@en ;
	.

fibo-der-drc-opt:CoveredCall
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-opt:CallOption ;
	rdfs:label "covered call"@en ;
	skos:definition "call option in which the seller (investor) owns an equivalent amount of the underlying security"@en ;
	.

fibo-der-drc-opt:EquityOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:VanillaOption ,
		fibo-der-sbd-sbd:EquityDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-opt:hasExerciseStyle ;
			owl:hasValue fibo-sec-dbt-ex:AmericanExerciseConvention ;
		]
		;
	rdfs:label "equity option"@en ;
	skos:definition "option giving the buyer (holder) the right, but not the obligation, to buy (via a call option) or sell (via a put option) the underlying equity assets specified at a pre-determined price (i.e., the strike price, fixed or calculated), on or before a specified date (the expiration date)"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "For an Equity Option, one contract represents 100 shares of stock. Equity options settle in 'American style'."@en ;
	.

fibo-der-drc-opt:ExoticOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:OverTheCounterDerivativeInstrument ,
		fibo-fbc-fi-fi:Option
		;
	rdfs:label "exotic option"@en ;
	skos:definition "option that has a non-standard payout structure or other feature"@en ;
	cmns-av:adaptedFrom "Commodity Futures Trading Commission (CFTC) glossary, https://www.cftc.gov/LearnAndProtect/EducationCenter/CFTCGlossary/glossary_e.html"@en ;
	cmns-av:explanatoryNote "Exotic options include Asian options and lookback options, and are mostly traded in the over-the-counter market."@en ;
	.

fibo-der-drc-opt:ExtrinsicValue
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:MonetaryAmount ;
	rdfs:label "extrinsic value"@en ;
	owl:disjointWith fibo-der-drc-opt:IntrinsicValue ;
	skos:definition "measure of the difference between the market price of an option, called the premium, and its intrinsic value"@en ;
	cmns-av:explanatoryNote "Extrinsic value is also the portion of the worth that has been assigned to an option by factors other than the underlying asset's price. The opposite of extrinsic value is intrinsic value, which is the inherent worth of an option."@en ;
	cmns-av:synonym "option time value"@en ;
	.

fibo-der-drc-opt:Fence
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:OptionTradingStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CallOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:PutOption ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "fence"@en ;
	skos:definition "option trading strategy that uses options to limit the range of possible returns on a financial instrument"@en ;
	cmns-av:explanatoryNote
		"""A fence consists of the following elements:
- long position in a financial instrument (e.g., a share, index or currency)
- long put (normally with a strike price close to or at the current spot price of the financial instrument)
- short put (with a strike price lower than the bought put - e.g., 80% of the current spot price)
- short call (with a strike price higher than the current spot price)."""@en ,
		"The expiration dates of all the options are usually the same. The call strike is normally chosen in such a way that the sum total of the three option premiums is equal to zero. This investment strategy will ensure that the value of the investment at expiry will be between the strike price on the short call and the strike price on the long put. Thus, possible gains and losses (the value of the financial instrument minus the cost of acquiring it) are confined to a specified range. However, if the price of the financial instrument falls below the strike level of the sold put the investor will start participating in any further price declines of the financial instrument."@en
		;
	.

fibo-der-drc-opt:FixedIncomeOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:VanillaOption ,
		fibo-der-sbd-sbd:DebtInstrumentDerivative
		;
	rdfs:label "fixed income option"@en ;
	skos:definition "option giving the buyer (holder) the right, but not the obligation, to buy (via a call option) or sell (via a put option) the underlying fixed income assets specified at a pre-determined price (i.e., the strike price, fixed or calculated), on or before a specified date (the expiration date)"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "Fixed income options, or debt options, are derivatives contracts that use bonds or other fixed-income securities as their underlying asset."@en ;
	.

fibo-der-drc-opt:InTheMoney
	a
		owl:NamedIndividual ,
		fibo-der-drc-opt:Moneyness
		;
	rdfs:label "in-the-money"@en ;
	skos:definition "moneyness classifier that refers to an option that has value in a strike price that is favorable in comparison to the prevailing market price of the underlying asset"@en ;
	cmns-av:abbreviation "ITM"@en ;
	cmns-av:explanatoryNote "An in-the-money call option means the option holder has the opportunity to buy the security below its current market price. An in-the-money put option means the option holder can sell the security above its current market price."@en ;
	.

fibo-der-drc-opt:InterestRateOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:InterestRateDerivative ,
		fibo-der-drc-opt:VanillaOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-opt:hasStrikeRate ;
			owl:someValuesFrom fibo-fnd-acc-cur:InterestRate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-ind-ir-ir:InterestRateBenchmark ;
			] ;
		]
		;
	rdfs:label "interest rate option"@en ;
	skos:definition "option that giving the buyer (holder) the right, but not the obligation, to receive a cash payment if market interest rate of a reference rate is higher or lower, depending on the option, than the strike rate of the option"@en ;
	cmns-av:explanatoryNote "The amount of the payment will be based on the difference between the market rate on the exercise date and the strike rate, multiplied by the notional principal specified in the option contract, to calculate the total payment."@en ;
	.

fibo-der-drc-opt:IntrinsicValue
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:MonetaryAmount ;
	rdfs:label "intrinsic value"@en ;
	skos:definition "measure of what an asset is worth, i.e. with respect to its current price"@en ;
	cmns-av:explanatoryNote "This measure is arrived at by means of an objective calculation or complex financial model. In financial analysis this term is used in conjunction with the work of identifying, as nearly as possible, the underlying value of a company and its cash flow. In options pricing it refers to the difference between the strike price of the option and the current price of the underlying asset."@en ;
	.

fibo-der-drc-opt:IronButterfly
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:Butterfly ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CallOption ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:PutOption ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "iron butterfly"@en ;
	skos:definition "butterfly strategy that consists of two call options and two put options, three strike prices and the same expiration date"@en ;
	cmns-av:explanatoryNote "The key to using this trade as part of a successful trading strategy is to forecast a time when option prices are likely to decline in value generally. This usually occurs during periods of sideways movement or a mild upward trend."@en ;
	cmns-av:synonym "iron fly"@en ;
	.

fibo-der-drc-opt:IronCondor
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:CondorSpread ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CallOption ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:PutOption ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-opt:hasExercisePrice ;
			owl:onClass fibo-der-drc-opt:StrikePrice ;
			owl:qualifiedCardinality "4"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "iron condor"@en ;
	skos:definition "condor strategy consisting of two puts (one long and one short) and two calls (one long and one short), and four strike prices, all with the same expiration date"@en ;
	cmns-av:explanatoryNote "The iron condor earns the maximum profit when the underlying asset closes between the middle strike prices at expiration. In other words, the goal is to profit from low volatility in the underlying asset."@en ;
	.

fibo-der-drc-opt:LongTermEquityAnticipationSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:EquityOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractDuration ;
			owl:someValuesFrom cmns-dt:Duration ;
		]
		;
	rdfs:label "long-term equity anticipation security"@en ;
	skos:definition "equity option that allows the holder to buy or sell shares of stock with expiration dates that are longer than one year, and typically up to three years from issue"@en ;
	cmns-av:abbreviation "LEAP"@en ;
	cmns-av:explanatoryNote "By providing opportunities to control and manage risk or even to speculate, LEAPS are virtually identical to regular options. Expiration dates on LEAPs can range from nine months to three years, which is longer than the holding period for a traditional call or put option. Although they are not available on all stocks, LEAPS are available on most widely held issues."@en ;
	.

fibo-der-drc-opt:Moneyness
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fbc-fi-fi:Option ;
		]
		;
	rdfs:label "moneyness"@en ;
	skos:definition "classifier for a derivative relating its strike price to the price of its underlying asset"@en ;
	cmns-av:explanatoryNote "Moneyness describes the intrinsic value of an option in its current state. The term moneyness is most commonly used with put and call options and is an indicator as to the comparative value of the option with respect to its exercise/strike price. Moneyness can be measured with respect to the underlying stock or other asset's current/spot price or its future price."@en ;
	.

fibo-der-drc-opt:OptionHolder
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Owner ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:someValuesFrom fibo-fbc-fi-fi:Option ;
		]
		;
	rdfs:label "option holder"@en ;
	skos:definition "party that owns an option"@en ;
	cmns-av:explanatoryNote "In a call, the option holder has the right, but not the obligation, to buy the underlying asset, while, in a put, the option holder has the right to sell the underlying asset. An option holder may sell the option contract itself, at which point the buyer becomes the option holder. Once the instrument is exercised there are typically additional, relevant obligations with regard to settlement."@en ;
	.

fibo-der-drc-opt:OptionIssuer
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:Issuer ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fbc-fi-fi:Option ;
			] ;
		]
		;
	rdfs:label "option issuer"@en ;
	skos:definition "issuer granting the rights defined in the option in exchange for some consideration"@en ;
	.

fibo-der-drc-opt:OptionOnFuture
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:VanillaOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-fbc-fi-fi:Future ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-ex:hasExerciseTerms ;
			owl:someValuesFrom fibo-sec-dbt-ex:AmericanExerciseTerms ;
		]
		;
	rdfs:label "option on future"@en ;
	skos:definition "option that gives the holder the right, but not the obligation, to buy or sell a specific futures contract at a specified price on or before the option's expiration date"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	.

fibo-der-drc-opt:OptionPremium
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-ip:MarketPrice ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:onClass fibo-der-drc-opt:OptionPremiumFormula ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasMonetaryAmount ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasQuantityValue ;
			owl:onClass fibo-fnd-acc-cur:PercentageMonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "option premium"@en ;
	skos:definition "current market price of an option contract"@en ;
	cmns-av:explanatoryNote "The option premium is the income received by the seller (writer) of an option contract to another party. In-the-money option premiums are composed of two factors: intrinsic and extrinsic value. Out-of-the-money options' premiums consist solely of extrinsic value. For stock options, the premium is quoted as a dollar amount per share, and most contracts represent the commitment of 100 shares."@en ;
	.

fibo-der-drc-opt:OptionPremiumFormula
	a owl:Class ;
	rdfs:subClassOf cmns-qtu:Expression ;
	rdfs:label "option premium formula"@en ;
	skos:definition "expression used to calculate the premium based either on the price per option or percentage of the notional amount"@en ;
	.

fibo-der-drc-opt:OptionTradingStrategy
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:TradingStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-fi-fi:Option ;
		]
		;
	rdfs:label "option trading strategy"@en ;
	skos:definition "trading tactic involving more than one option type, strike price, or expiration date on the same underlying asset"@en ;
	cmns-av:explanatoryNote
		"Note that some trading strategies may be considered financial instruments in their own right, but most strategies are not. The critical differentiators include whether the strategy itself can be traded, whether it has a financial instrument identifier independently from the identifier(s) of the embedded instrument(s), such as a FIGI or ISIN, and so forth."@en ,
		"Option trading strategies refer to buying calls or put options or selling calls or put options or both together for the purpose of limiting losses and/or optimizing profits. Basically, these strategies utilize one or more combinations for the best outcome possible based on defined parameters. Simple combinations include option spread trades such as vertical spreads, calendar (or horizontal) spreads, and diagonal spreads. More involved combinations include trades such as condor or butterfly spreads which are actually combinations of two vertical spreads."@en
		;
	.

fibo-der-drc-opt:OutOfTheMoney
	a
		owl:NamedIndividual ,
		fibo-der-drc-opt:Moneyness
		;
	rdfs:label "out-of-the-money"@en ;
	skos:definition "moneyness classifier that refers to an option whose value in terms of its strike price is not favorable in comparison to the prevailing market price of the underlying asset"@en ;
	cmns-av:abbreviation "OTM"@en ;
	cmns-av:explanatoryNote "An OTM call option will have a strike price that is higher than the market price of the underlying asset. Alternatively, an OTM put option has a strike price that is lower than the market price of the underlying asset."@en ;
	.

fibo-der-drc-opt:ProtectiveCollar
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:Collar ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CoveredCall ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:ProtectivePut ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "protective collar"@en ;
	skos:definition "collar that consists of a covered call and protective put"@en ;
	cmns-av:explanatoryNote "A protective collar consists of a long position in the underlying security, a put option purchased to hedge the downside risk on a stock, a call option written on the stock to finance the put purchase."@en ;
	.

fibo-der-drc-opt:ProtectivePut
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:PutOption ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-opt:hasCalculatedMarketValue ;
			owl:someValuesFrom fibo-der-drc-opt:OptionPremium ;
		]
		;
	rdfs:label "protective put"@en ;
	skos:definition "put option giving the buyer (holder) the right, but not the obligation, to sell the assets specified at with a strike price equal or close to the current price of the underlying asset, on or before a specified date"@en ;
	cmns-av:explanatoryNote "A protective put is a risk management and options strategy that involves holding a long position in the underlying asset (e.g., stock). A protective put strategy is analogous to the nature of insurance. The main goal of a protective put is to limit potential losses that may result from an unexpected price drop of the underlying asset"@en ;
	cmns-av:synonym "synthetic call"@en ;
	.

fibo-der-drc-opt:PutOption
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:Option ;
	rdfs:label "put option"@en ;
	skos:definition "option giving the buyer (holder) the right, but not the obligation, to sell the assets specified at a fixed price or formula, on or before a specified date"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "The seller of the put option assumes the obligation of buying the assets specified should the buyer exercise the option."@en ;
	.

fibo-der-drc-opt:RiskReversal
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:OptionTradingStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CallOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:PutOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "risk reversal"@en ;
	skos:definition "option trading strategy that consists of being short (selling) an out of the money put and being long (i.e., buying) an out of the money call, both with the same maturity"@en ;
	cmns-av:explanatoryNote "A risk reversal is a position which simulates profit and loss behavior of owning an underlying security; therefore, it is sometimes called a synthetic long. This is an investment strategy that amounts to both buying and selling out-of-money options simultaneously. In this strategy, the investor will first make a market hunch; if that hunch is bullish, he will want to go long. However, instead of going long on the stock, he will buy an out of the money call option, and simultaneously sell an out of the money put option. Presumably he will use the money from the sale of the put option to purchase the call option. Then as the stock goes up in price, the call option will be worth more, and the put option will be worth less."@en ;
	.

fibo-der-drc-opt:StandardizedOptionsTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:StandardizedTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-pub:hasPublisher ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-der-drc-bsc:DerivativesClearingOrganization
					fibo-fbc-fct-mkt:Exchange
				) ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-ip:hasPriceDeterminationMethod ;
			owl:someValuesFrom fibo-fbc-fi-ip:PriceDeterminationMethod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-der-drc-opt:VanillaOption ;
		]
		;
	rdfs:label "standardized options terms"@en ;
	skos:definition "standardized contract terms established by a securities or options exchange or by an options clearing entity"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "Such terms may relate to the underlying instruments, exercise price, expiration date, and contract size, for example."@en ;
	.

fibo-der-drc-opt:Straddle
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:OptionTradingStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CallOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:PutOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "straddle"@en ;
	skos:definition "neutral option trading strategy that involves simultaneously buying both a put option and a call option for the underlying security with the same strike price and the same expiration date"@en ;
	cmns-av:explanatoryNote "The strategy is profitable only when the value of the underlier varies (rises or falls) from the strike price by more than the total premium paid."@en ;
	.

fibo-der-drc-opt:Strangle
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:OptionTradingStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CallOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:PutOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "strangle"@en ;
	skos:definition "option trading strategy in which the investor holds a position in both a call and a put option with different strike prices, but with the same expiration date and underlying asset"@en ;
	cmns-av:explanatoryNote "A strangle is a good strategy if you think the underlying security will experience a large price movement in the near future but are unsure of the direction. However, it is profitable mainly if the asset swings sharply in price."@en ;
	.

fibo-der-drc-opt:StrikePrice
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:MonetaryPrice ;
	rdfs:label "strike price"@en ;
	skos:definition "price at which a lot of the underlying asset may be bought or sold when the contract is exercised"@en ;
	cmns-av:explanatoryNote "For call options, the strike price is the price at which the security may be purchased by the option holder; for put options, the strike price is the price at which the security may be sold."@en ;
	.

fibo-der-drc-opt:StripStrategy
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-opt:OptionTradingStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:CallOption ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-der-drc-opt:PutOption ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:someValuesFrom fibo-fnd-dt-fd:Schedule ;
		]
		;
	rdfs:label "strip strategy"@en ;
	skos:definition "option trading strategy that involves a sequential set of options with periodic reset dates, such that each period between resets behaves like an individual option"@en ;
	cmns-av:explanatoryNote "Typically, a strip is a strategy that involves being long in one call position and two put options, all with the same strike price on a single underlying stock. The investor who adopts this strategy believes that the underlying price of the stock will plummet in the near-term future. All three of the options will have the same expiration date and the same strike price. If the investor is correct and the price drastically decreases, the puts will pay out substantially. If the investor is wrong and the price of the underlying asset increases, the call option will mitigate the loss. The period between resets may be called a Caplet or Floorlet."@en ;
	.

fibo-der-drc-opt:VanillaOption
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:Option ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-ip:hasPriceDeterminationMethod ;
			owl:someValuesFrom fibo-fbc-fi-ip:PriceDeterminationMethod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractDuration ;
			owl:someValuesFrom cmns-dt:ExplicitDuration ;
		]
		;
	rdfs:label "vanilla option"@en ;
	skos:definition "common option giving the buyer (holder) the right, but not the obligation, to buy (via a call option) or sell (via a put option) the underlying assets specified at a pre-determined price (i.e., the strike price, fixed or calculated), on or before a specified date (the expiration date)"@en ;
	cmns-av:explanatoryNote "Vanilla options include call or put options that have no special or unusual features, and are typically exchange traded."@en ;
	.

fibo-der-drc-opt:hasCalculatedMarketValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has calculated market value"@en ;
	rdfs:domain fibo-fbc-fi-fi:Option ;
	rdfs:range fibo-der-drc-opt:OptionPremium ;
	skos:definition "indicates a calculated price as of some relative date considered the market value of the option at that point in time"@en ;
	cmns-av:synonym "has premium"@en ;
	.

fibo-der-drc-opt:hasCapPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fnd-acc-cur:hasMonetaryAmount ,
		fibo-fnd-acc-cur:hasPrice
		;
	rdfs:label "has cap price"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "price at which the contract may be exercised"@en ;
	.

fibo-der-drc-opt:hasExerciseDateOffset
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has exercise date offset"@en ;
	rdfs:domain fibo-der-drc-opt:StripStrategy ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "indicates the period in days between the reset date and the exercise date"@en ;
	.

fibo-der-drc-opt:hasExercisePrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has exercise price"@en ;
	rdfs:range fibo-der-drc-opt:StrikePrice ;
	skos:definition "specifies a predetermined price at which the holder commits to buy or sell an underlying asset"@en ;
	cmns-av:synonym "has strike price"@en ;
	.

fibo-der-drc-opt:hasExerciseSchedule
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasSchedule ;
	rdfs:label "has exercise schedule"@en ;
	rdfs:domain fibo-fbc-fi-fi:Option ;
	rdfs:range fibo-fnd-dt-fd:Schedule ;
	skos:definition "links an option to the schedule specified in the contract that constrains when it may be exercised"@en ;
	cmns-av:explanatoryNote "An exercise schedule may be as simple as a single date or date period. However, in more complex cases, it may be an ad hoc schedule of individual dates, or a regular schedule of periodic exercise dates."@en ;
	.

fibo-der-drc-opt:hasExerciseStyle
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
	rdfs:label "has exercise style" ;
	rdfs:domain fibo-fbc-fi-fi:Option ;
	rdfs:range fibo-sec-dbt-ex:ExerciseConvention ;
	skos:definition "indicates the exercise convention specified for the option" ;
	.

fibo-der-drc-opt:hasInterestAccrualDateOffset
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has interest accrual date offset"@en ;
	rdfs:domain fibo-der-drc-opt:StripStrategy ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "indicates the period in days between each reset date and the commencement of interest accrual for the next period"@en ;
	.

fibo-der-drc-opt:hasOptionHolder
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractParty ;
	rdfs:label "has option holder" ;
	rdfs:domain fibo-fbc-fi-fi:Option ;
	rdfs:range fibo-der-drc-opt:OptionHolder ;
	skos:definition "indicates the owner of the option" ;
	.

fibo-der-drc-opt:hasOptionWriter
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractParty ;
	rdfs:label "has option writer" ;
	rdfs:domain fibo-fbc-fi-fi:Option ;
	rdfs:range fibo-der-drc-opt:OptionIssuer ;
	skos:definition "indicates the issuer of the option" ;
	cmns-av:explanatoryNote "Typically, the option writer collects the premium when the option is initially sold."@en ;
	.

fibo-der-drc-opt:hasSettlementDateOffset
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has settlement date offset"@en ;
	rdfs:domain fibo-der-drc-opt:StripStrategy ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "indicats the period in days between each reset date and the corresponding settlement date"@en ;
	.

fibo-der-drc-opt:hasStrikePercentageAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has strike percentage amount"@en ;
	rdfs:range fibo-fnd-acc-cur:PercentageMonetaryAmount ;
	skos:definition "indicates a strike price or level expressed as a percentage of the value of the underlying asset"@en ;
	.

fibo-der-drc-opt:hasStrikeRate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
	rdfs:label "has strike rate"@en ;
	rdfs:range cmns-qtu:Ratio ;
	skos:definition "rate at which the contract may be exercised"@en ;
	.

fibo-der-drc-raw:AllotmentRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-sbd-sbd:EquityDerivative ,
		fibo-fbc-fi-fi:Entitlement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:someValuesFrom fibo-der-drc-raw:AllotmentRightFormula ;
		]
		;
	rdfs:label "allotment right"@en ;
	skos:definition "privileges allotted to existing security holders, entitling them to receive new securities free of charge"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote "Allotment generally means the distribution of equity, particularly shares granted to a participating underwriting firm during an initial public offering (IPO)."@en ;
	cmns-av:synonym "bonus right"@en ;
	.

fibo-der-drc-raw:AllotmentRightFormula
	a owl:Class ;
	rdfs:subClassOf cmns-qtu:Expression ;
	rdfs:label "allotment right formula"@en ;
	skos:definition "rule applied to calculate the number of securities for an allotment right, typically based on the number of these instruments that the holder holds"@en ;
	cmns-av:explanatoryNote "Note that there may be a combination of a rule expressed in text as well as an expression or more complex formula embedded in a contract for making this determination."@en ;
	.

fibo-der-drc-raw:BarrierInstrumentBasedMiniFutureCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:MiniFutureCertificate ;
	rdfs:label "barrier instrument-based mini-future certificate"@en ;
	skos:definition "mini-future certificate that immediately expires if the barrier instrument trading price level is breached during product lifetime"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:BarrierUnderlyingMiniFutureCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:MiniFutureCertificate ;
	rdfs:label "barrier underlying mini-future certificate"@en ;
	skos:definition "mini-future certificate that immediately expires if the barrier underlying level is breached during product lifetime"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:BasketWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:Warrant ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-sec-bsk:BasketOfSecurities ;
			] ;
		]
		;
	rdfs:label "basket warrant"@en ;
	skos:definition "warrant that permits the holder to acquire a package or group of assets at a specified price during a specified period"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:BondPurchaseRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:PurchaseRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-dbt-bnd:Bond ;
			] ;
		]
		;
	rdfs:label "bond purchase right"@en ;
	skos:definition "purchase right that gives a prospective acquiree's bondholders the right to buy bonds of the firm or bonds of anyone who acquires the firm at a deep discount to their fair market value"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:BondSubscriptionRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:SubscriptionRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-dbt-bnd:Bond ;
			] ;
		]
		;
	rdfs:label "bond subscription right"@en ;
	skos:definition "subscription right entitling existing bond holders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CallPutWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:CallWarrant ,
		fibo-der-drc-raw:PutWarrant
		;
	rdfs:label "call put warrant"@en ;
	skos:definition "warrant that either does not specify call or put features, or that explicitly includes both a call and put feature"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "The call and put code, 'B', in the CFI stands for 'Both', meaning such a warrant embodies characteristics of both a call and a put. This can appear in structured warrants or exotic warrants where payout may depend on movements in either direction (or give the holder a choice at certain triggers)."@en ;
	cmns-av:synonym "straddle warrant"@en ;
	.

fibo-der-drc-raw:CallWarrant
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:Warrant ;
	rdfs:label "call warrant"@en ;
	skos:definition "warrant giving the buyer (holder) the right, but not the obligation, to acquire specific underlying assets during a specified period at a specified price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "Exercising a call warrant whose underlying instrument is an equity involves buying new shares directly from the company, causing dilution."@en ;
	.

fibo-der-drc-raw:CombinedInstrumentsPurchaseRight
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:PurchaseRight ;
	rdfs:label "combined instruments purchase right"@en ;
	skos:definition "purchase right that gives a prospective acquiree's holders of multiple securities the right to buy securities of the firm or securities of anyone who acquires the firm at a deep discount to their fair market value"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CombinedInstrumentsSubscriptionRight
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:SubscriptionRight ;
	rdfs:label "combined instruments subscription right"@en ;
	skos:definition "subscription right entitling existing holders of multiple securities to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CommodityWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:CommodityDerivative ,
		fibo-der-drc-raw:Warrant
		;
	rdfs:label "commodity warrant"@en ;
	skos:definition "warrant that permits the holder to acquire a specified amount of a commodity during a specified period at a specified price"@en ;
	skos:example "Commodity Warrants Australia (CWA) sells warrants based on 12 commodities and financial markets - crude oil, gold, silver, live cattle, corn, orange juice, soy, coffee, cocoa, the Dow Jones Industrial Average, the NASDAQ Composite Index and the S&P 500 Index."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CommonConvertibleSharePurchaseRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:PurchaseRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:ConvertibleCommonShare ;
			] ;
		]
		;
	rdfs:label "common convertible share purchase right"@en ;
	skos:definition "purchase right that gives a prospective acquiree's common, convertible shareholders the right to buy common, convertible shares of the firm or common, convertible shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CommonConvertibleShareSubscriptionRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:SubscriptionRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:ConvertibleCommonShare ;
			] ;
		]
		;
	rdfs:label "common convertible share subscription right"@en ;
	skos:definition "subscription right entitling existing common convertible shareholders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CommonSharePurchaseRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:PurchaseRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:CommonShare ;
			] ;
		]
		;
	rdfs:label "common share purchase right"@en ;
	skos:definition "purchase right that gives a prospective acquiree's common shareholders the right to buy common shares of the firm or common shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CommonShareSubscriptionRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:SubscriptionRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:CommonShare ;
			] ;
		]
		;
	rdfs:label "common share subscription right"@en ;
	skos:definition "subscription right entitling existing common shareholders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CompanyWarrant
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass fibo-der-drc-raw:EquityWarrant ;
	.

fibo-der-drc-raw:ConstantLeverageCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-sbd-sbd:SecurityBasedDerivative ,
		fibo-fbc-fi-fi:Entitlement ,
		fibo-fbc-fi-fi:Option
		;
	rdfs:label "constant leverage certificate"@en ;
	skos:definition "entitlement that combines the structure of an open-end certificate with a leverage option with no fixed term, making leverage available without a term restriction, without a knock-out barrier dependency"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:CoveredWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:Warrant ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom fibo-fbc-fct-fse:FinancialInstitution ;
		]
		;
	rdfs:label "covered warrant"@en ;
	owl:disjointWith
		fibo-der-drc-raw:NakedWarrant ,
		fibo-der-drc-raw:TraditionalWarrant
		;
	skos:definition "warrant that gives the holder the right, but not the obligation, to buy (call warrant) or to sell (put warrant) an underlying asset at a specified price (the strike or exercise price) by a predetermined date, issued without an accompanying security by a third party that holds as many securities as would be required if all the warrants are exercised"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote
		"Covered warrants are very similar to options in that they can be created to allow holders to benefit from either rising prices or falling prices, by having both put and call warrants. They can also be created on a wide variety of underlying instruments, not just equities and they are fairly standardised and are mostly traded on exchanges. The main difference is that warrants tend to have longer maturity dates, typically measured in years instead of months (as with options), and are easier to access for individuals as they can be bought and sold in the same way as shares in the stock exchange."@en ,
		"In contrast to traditional equity warrants, with covered warrants, no new issuance of common stock occurs if the warrant is exercised. The underlying shares of common stock are usually either owned by the issuer of the covered warrants or the issuer has a mechanism, such as owning equity warrants for the underlying shares, through which they can obtain the shares."@en
		;
	.

fibo-der-drc-raw:CurrencyWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-cur:CurrencyDerivative ,
		fibo-der-drc-raw:Warrant
		;
	rdfs:label "currency warrant"@en ;
	skos:definition "warrant that permits the holder to acquire a specified amount in a certain currency at a specified exchange rate during a specified period"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:DebtWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:Warrant ,
		fibo-der-sbd-sbd:DebtInstrumentDerivative
		;
	rdfs:label "debt warrant"@en ;
	skos:definition "warrant that permits the holder to acquire a specified amount of a debt instrument or related debt observable a specified period at a specified price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:EquityWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:CallWarrant ,
		fibo-der-drc-raw:TraditionalWarrant ,
		fibo-der-sbd-sbd:EquityDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:allValuesFrom fibo-be-le-cb:StockCorporation ;
			] ;
		]
		;
	rdfs:label "equity warrant"@en ;
	rdfs:seeAlso <https://www.lawinsider.com/dictionary/company-warrant> ;
	skos:definition "warrant that permits the holder to acquire a specified amount of an equity instrument during a specified period at a specified price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote "An equity warrant typically enables a buyer to purchase shares of capital stock issued by the corporation whose equity is the underlying asset."@en ;
	cmns-av:synonym "company warrant"@en ;
	.

fibo-der-drc-raw:ExchangeTradedWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:PublicWarrant ,
		fibo-sec-sec-lst:ListedSecurity
		;
	rdfs:label "exchange-traded warrant"@en ;
	skos:definition "warrant that is listed on a securities exchange"@en ;
	.

fibo-der-drc-raw:ExoticWarrant
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:Warrant ;
	rdfs:label "exotic warrant"@en ;
	skos:definition "warrant that gives the holder the right (but not the obligation) to buy (or sometimes sell) an underlying asset under non-standard or complex conditions, often involving additional features not found in a plain vanilla (standard) warrant"@en ;
	cmns-av:explanatoryNote
		"Exotic warrants may be created by investment banks as part of structured products to meet specific investor needs. They are often identified with an 'X' in their English stock short name."@en ,
		"Features of an exotic warrant may include (1) non-standard payoffs, such as path-dependent or condition-based payouts, (2) variations in the underlying asset(s), which may include equities, indices, currencies, interest rates, baskets of assets, etc., and (3) embedded optionality in terms of features such as barriers, lookbacks, digitals, or dual-currency terms."@en
		;
	.

fibo-der-drc-raw:IndexWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:Warrant ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:onClass [
					a owl:Class ;
					owl:unionOf (
						fibo-ind-ei-ei:EconomicIndicator
						fibo-ind-mkt-bas:ReferenceIndex
					) ;
				] ;
				owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "index warrant"@en ;
	skos:definition "warrant that permits the holder to acquire a specified amount based on the performance of an index during a specified period at a specified price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:LongMiniFutureCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:MiniFutureCertificate ;
	rdfs:label "long mini-future certificate"@en ;
	skos:definition "mini-future certificate that typically entitles the holder to acquire specific underlying assets during a specified period at a specified price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:MiniFutureCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-exo:BarrierOption ,
		fibo-der-sbd-sbd:SecurityBasedDerivative ,
		fibo-fbc-fi-fi:Entitlement
		;
	rdfs:label "mini-future certificate"@en ;
	skos:definition "entitlement that combines the structure of an open-end certificate with a leverage option with no fixed term, making leverage available without a term restriction, and whose payoff depends on whether or not the underlying asset has reached or exceeded a predetermined price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote "The price of a mini-future always corresponds to its intrinsic value, i.e. the capital outlay, plus the bid-ask spread. The financing costs associated with building up the leverage effect are offset against the capital outlay on a daily basis, thereby eliminating the need for a premium. Investors have to pay only financing costs they actually utilize. In contrast to options, factors like volatility have no influence at all on the price of mini-futures."@en ;
	.

fibo-der-drc-raw:NakedWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:Warrant ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom fibo-fbc-fct-fse:FinancialInstitution ;
		]
		;
	rdfs:label "naked warrant"@en ;
	owl:disjointWith fibo-der-drc-raw:TraditionalWarrant ;
	skos:definition "warrant that gives the holder the right, but not the obligation, to buy (call warrant) or to sell (put warrant) an underlying asset at a specified price (the strike or exercise price) by a predetermined date, issued without an accompanying security by a third party that does not hold as many securities as would be required if all the warrants are exercised"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:PerpetualWarrant
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:Warrant ;
	rdfs:label "perpetual warrant" ;
	skos:definition "warrant without an expiration date, giving the holder the right, but not the obligation, to buy (call warrant) or to sell (put warrant) an underlying asset at a certain strike price" ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote "The strike price, in the case of a perpetual warrant, is usually higher than the market value of the underlying asset at the time of issue."@en ;
	.

fibo-der-drc-raw:PreferredConvertibleSharePurchaseRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:PurchaseRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:ConvertiblePreferredShare ;
			] ;
		]
		;
	rdfs:label "preferred convertible share purchase right"@en ;
	skos:definition "purchase right that gives a prospective acquiree's preferred, convertible shareholders the right to buy preferred, convertible shares of the firm or preferred, convertible shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:PreferredConvertibleShareSubscriptionRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:SubscriptionRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:ConvertiblePreferredShare ;
			] ;
		]
		;
	rdfs:label "preferred convertible share subscription right"@en ;
	skos:definition "subscription right entitling existing preferred, convertible shareholders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:PreferredSharePurchaseRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:PurchaseRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:PreferredShare ;
			] ;
		]
		;
	rdfs:label "preferred share purchase right"@en ;
	skos:definition "purchase right that gives a prospective acquiree's preferred shareholders the right to buy preferred shares of the firm or preferred shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:PreferredShareSubscriptionRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:SubscriptionRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-sec-eq-eq:PreferredShare ;
			] ;
		]
		;
	rdfs:label "preferred share subscription right"@en ;
	skos:definition "subscription right entitling existing preferred shareholders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:PrivateWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:Warrant ,
		fibo-fbc-fi-fi:NonNegotiableSecurity
		;
	rdfs:label "private warrant" ;
	skos:definition "warrant that is not tradable" ;
	.

fibo-der-drc-raw:PublicWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-raw:Warrant ,
		fibo-fbc-fi-fi:NegotiableSecurity
		;
	rdfs:label "public warrant" ;
	skos:definition "warrant that may be traded over the counter (OTC) or through an exchange" ;
	.

fibo-der-drc-raw:PurchaseRight
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:Entitlement ;
	rdfs:label "purchase right"@en ;
	skos:definition "anti-takeover device that gives a prospective acquiree's shareholders the right to buy shares of the firm or shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote 'The underlying is usually shares but this not necessarily the case. Also known as "Poison Pill".'@en ;
	.

fibo-der-drc-raw:PutWarrant
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:Warrant ;
	rdfs:label "put warrant"@en ;
	skos:definition "warrant giving the buyer (holder) the right, but not the obligation, to sell the assets specified (i.e., acquire cash in exchange for the underlying assets, such as stock) back to the issuer at a fixed price or formula, on or before a specified date"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	cmns-av:explanatoryNote "A put warrant is essentially a company-issued option to sell shares back to the issuer."@en ;
	.

fibo-der-drc-raw:ShortMiniFutureCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:MiniFutureCertificate ;
	rdfs:label "short mini-future certificate"@en ;
	skos:definition "mini-future certificate that entitles the holder to acquire cash in exchange for specific underlying assets"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	.

fibo-der-drc-raw:StructuredWarrant
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:Warrant ;
	rdfs:label "structured warrant"@en ;
	rdfs:seeAlso <https://www.phillipnova.com.sg/wp-content/uploads/2023/08/Structured-Warrants-Product-Info-Sheet.pdf> ;
	skos:definition "warrant that is listed on an exchange, offering investors a way to participate in the price performance of an underlying asset without buying it directly"@en ;
	cmns-av:explanatoryNote
		"Unlike company-issued warrants, which are tied to corporate fundraising, structured warrants are issued by third-party financial institutions such as investment banks or brokers. They can be based on a variety of underlying assets, including individual company shares, a basket of shares, or an index."@en ,
		"When structured warrants are exercised, they are typically cash-settled and do not lead to the creation of new shares, thus avoiding dilution of existing shareholders. This is in contrast with company-issued stock options, which can potentially lead to the issuance of new shares, which might dilute the value for existing shareholders."@en
		;
	.

fibo-der-drc-raw:SubscriptionRight
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:Entitlement ;
	rdfs:label "subscription right"@en ;
	skos:definition "privileges allotted to existing security holders, entitling them to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote "A subscription rights issue increases the number of shares in the market, thus leading to a dilution in each share's value."@en ;
	cmns-av:synonym
		"anti-dilution right"@en ,
		"preemptive right"@en ,
		"subscription privilege"@en
		;
	.

fibo-der-drc-raw:TraditionalWarrant
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-raw:Warrant ;
	rdfs:label "traditional warrant"@en ;
	skos:definition "warrant that gives the holder the right, but not the obligation, to buy (call warrant) or to sell (put warrant) an underlying asset at a specified price (the strike or exercise price) by a predetermined date, issued by the issuer of the underlying instrument"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:synonym "vanilla warrant"@en ;
	.

fibo-der-drc-raw:Warrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:Entitlement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-ex:hasExerciseTerms ;
			owl:someValuesFrom fibo-sec-dbt-ex:ExerciseTerms ;
		]
		;
	rdfs:label "warrant"@en ;
	skos:definition "entitlement that permits the holder to purchase a specified amount of a financial instrument, commodity, currency or other asset during a specified period at a specified price"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote "Warrants are for any kind of instrument. Warrants may be privately issued and may not necessarily be traded on an exchange."@en ;
	.

fibo-der-drc-raw:hasConversionRatio
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has conversion ratio"@en ;
	rdfs:domain fibo-fbc-fi-fi:Entitlement ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the factor used to determine the number of warrants needed in order to buy or sell a specific number of securities or investment units"@en ;
	.

fibo-der-drc-raw:hasOversubscribeOption
	a owl:DatatypeProperty ;
	rdfs:label "has oversubscribe option"@en ;
	rdfs:domain fibo-fbc-fi-fi:Entitlement ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the holders of the rights instrument may get securities in the event that other right holders choose not to subscribe"@en ;
	.

fibo-der-drc-str:BarrierCapitalProtectionCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:CapitalProtectedProduct ,
		fibo-der-drc-str:ParticipationCertificate
		;
	rdfs:label "barrier capital protection certificate"@en ;
	skos:definition "capital-protected product whose protection is defined as a percentage of the nominal price (e.g. 100 percent), with minimum redemption at expiry equivalent to the capital protection"@en ;
	skos:note "Note that capital protection in this case refers to the nominal amount only, and not to the purchase price. The value of the product may fall below its capital protection value during its lifetime; participation is in the underlying price increase above the strike up to the barrier; possibility of rebate payment once barrier is breached; limited profit potential."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.7"@en ;
	.

fibo-der-drc-str:BarrierDiscountCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:ParticipationCertificate ,
		fibo-sec-dbt-pbs:StructuredFinanceWithoutPrincipalProtection
		;
	rdfs:label "barrier discount certificate"@en ;
	skos:definition "participation certificate that enables the investor to acquire the underlying asset at a lower price in return for a limited payout, and for which the maximum redemption amount (Cap) is paid out if the barrier is never breached"@en ;
	skos:note "Due to the barrier, the probability of maximum redemption is higher; the discount, however, is smaller than for a discount certificate. If the barrier is breached the product changes into a discount certificate. Barrier discount certificates have reduced risk compared to direct investment in the underlying assets, with limited profit potential (Cap). With higher risk levels multiple underlying assets (worst-of) allow for higher discounts or a lower barrier."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.8"@en ;
	.

fibo-der-drc-str:BarrierReverseConvertibleCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:ParticipationCertificate ,
		fibo-sec-dbt-pbs:StructuredFinanceWithoutPrincipalProtection
		;
	rdfs:label "barrier reverse convertible certificate"@en ;
	skos:definition "participation certificate whose payout is conditional: should the barrier never be breached, the nominal price plus coupon is paid at redemption; if the barrier is breached the product changes into a reverse convertible"@en ;
	skos:note "Due to the barrier, the probability of maximum redemption is higher; the coupon, however, is smaller than for a reverse convertible. It has reduced risk compared to a direct investment into the underlying asset(s). With higher risk levels, multiple underlying assets (worst-of) allow for higher coupons or lower barriers; limited profit potential (Cap)."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.8"@en ;
	.

fibo-der-drc-str:BasketCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:ParticipationCertificate ;
	rdfs:label "basket certificate"@en ;
	skos:definition "certificate whose underlying asset represents a fraction of a basket of securities that corresponds to the subscription ratio"@en ;
	cmns-av:explanatoryNote
		"Basket certificates make sense if an investor is convinced of the potential in a particular sector or region, but shies away from the risk of investing in individual securities. Because the certificate is expected to achieve higher profits than the benchmark index, the share basket usually contains fewer titles than the benchmark index. That increases the potential for profits; but the risk of loss increases compared to the index. Unlike shares, basket certificates are not eligible for dividend payouts. The limited maturity should also be taken into account."@en ,
		"The issuer determines the basket's compilation before quoting the certificate. Fundamentally, all securities with regular, at least daily, price determinations are suited for the portfolio. The selection criteria for the shares or securities in the basket are known and remain unchanged during the life of the certificate. Note, however, that the composition of the share basket can change over time. If the issuer follows a specific strategy with the certificate, the basket has to be adjusted at specific end-of-period dates, provided the market leaders change. In such a case, the basket is called an active basket. If, in contrast, the composition of a share basket remains clearly defined, as is the case for an index certificate, it is called a passive basket."@en ,
		"The success of a basket certificate is measured on whether it can outperform a comparison index or fund, a so-called benchmark. Basket certificates can be roughly divided into three categories based on the criteria for selecting securities: Sector certificates; country or region certificates; and strategy and thematic certificates."@en
		;
	.

fibo-der-drc-str:BonusCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:ParticipationCertificate ;
	rdfs:label "bonus certificate"@en ;
	skos:definition "certificate whose minimum redemption is equal to the nominal value provided the barrier has not been breached, with a greater risk in relation to multiple underlying asset(s) (worst-of), allowing for a higher bonus level or lower barrier, and with a reduced risk compared to a direct investment into the underlying asset(s)"@en ;
	skos:example "For example: You buy a bonus certificate based on a stock. The price of the stock at the time that you get the certificate is 100 Euros. The bonus level is 120 Euros, and the protection threshold is 80 Euros. Over the two-year term, the price of the stock fluctuates between 90 and 110 Euros. When the certificate matures at the end of the term, you receive the bonus price of 120 Euros."@en ;
	skos:note "If the barrier is breached the product becomes a tracker certificate."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.2.8"@en ;
	cmns-av:explanatoryNote """Bonus certificates have a risk buffer for price losses in the underlying; the bonus guarantees a minimum return above the risk level. A bonus certificate represents an alternative to a direct investment in a share or an index. Investors primarily use them if they believe that despite rising prices setbacks are still likely to occur.
		
A bonus certificate is furnished with a bonus amount and an upper and lower price level. If the certificate expires with the price of the underlying ranging between these two levels, owners are paid out their bonuses. If the underlying was at or below the risk level during the certificate's lifetime, its price is that of the current value of the certificate at expiry. If the underlying is above the upper level at expiry, the investor fully participates in the price gains. Some bonus certificates have a profit cap. This is where the certificate stops participating in the price gains of the underlying.

A bonus certificate is issued at the current price of the underlying. The upper level is derived from adding the bonus to the issue price. The lower level is determined at issuance and usually expressed in percent."""@en ;
	.

fibo-der-drc-str:CapitalProtectedProduct
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:StructuredProduct ;
	rdfs:label "capital-protected product"@en ;
	skos:definition "structured product that participates in the performance of a financial asset, such as a stock, fund or index, while protecting the investor's capital"@en ;
	skos:note "Capital protected structured instruments offer investors exposure to chosen underlying assets using various approaches and offering a large variety of asymmetric pay-off profiles. There are one or more reference entities underlying the product. Redemption is made at least in the amount of the conditional capital protection at maturity, provided that no credit event by the reference entity has occurred. Conditional capital protection only applies to the nominal amount and not to the purchase price. The general functioning of a capital guaranteed structured instrument is as follows: the notional amount is split into a zero bond, that will deliver the capital guarantee at maturity, and the difference between the zero bond's value (= present value of the guarantee level at maturity) and the notional amount is used for structuring the performance component with options which deliver the agreed pay-off profile of the structured instrument."@en ;
	cmns-av:abbreviation "CPI"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.7"@en ;
	cmns-av:explanatoryNote "Depending on the product, they may participate to varying degrees in the underlying asset's upside and protect the capital either entirely or partially."@en ;
	cmns-av:synonym "capital protected investment"@en ;
	.

fibo-der-drc-str:CapitalProtectionCertificateWithCoupons
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:CapitalProtectedProduct ,
		fibo-der-drc-str:ParticipationCertificate
		;
	rdfs:label "capital protection certificate with coupons"@en ;
	skos:definition "capital-protected product whose protection is defined as a percentage of the nominal price (e.g. 100 percent), with minimum redemption at expiry equivalent to the capital protection"@en ;
	skos:note "Note that capital protection in this case refers to the nominal amount only, and not to the purchase price. The value of the product may fall below its capital protection value during its lifetime; the coupon amount is dependent on the development of the underlying asset; periodic coupon payment is expected."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.7"@en ;
	.

fibo-der-drc-str:CapitalProtectionCertificateWithParticipation
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:CapitalProtectedProduct ,
		fibo-der-drc-str:ParticipationCertificate
		;
	rdfs:label "capital protection certificate with participation"@en ;
	skos:definition "capital-protected product whose protection is defined as a percentage of the nominal amount (e.g. 100 percent), with minimum redemption at expiry equivalent to the capital protection"@en ;
	skos:note "Note that capital protection in this case refers to the nominal amount only, and not to the purchase price. The value of the product may fall below its capital protection value during its lifetime, and participation is in the underlying price increase above the strike."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.7"@en ;
	.

fibo-der-drc-str:CapitalProtectionConvertibleCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:CapitalProtectedProduct ,
		fibo-der-drc-str:ParticipationCertificate
		;
	rdfs:label "capital protection convertible certificate"@en ;
	skos:definition "capital-protected product whose protection is defined as a percentage of the nominal price (e.g. 100 percent), with minimum redemption at expiry equivalent to the capital protection"@en ;
	skos:note "Note that capital protection in this case refers to the nominal price only, and not to the purchase price. The value of the product may fall below its capital protection value during its lifetime; participation is in the underlying price increase above the conversion price; coupon payment is possible."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.7"@en ;
	.

fibo-der-drc-str:DiscountCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:ParticipationCertificate ,
		fibo-sec-dbt-pbs:StructuredFinanceWithoutPrincipalProtection
		;
	rdfs:label "discount certificate"@en ;
	skos:definition "participation certificate that enables the investor to acquire the underlying asset at a lower price in return for a limited payout, and for which the underlying asset(s) and/or a cash amount is redeemed should the underlying asset close below the strike on expiry, for which, in return, the potential profit is capped"@en ;
	skos:note "Discount certificates correspond to a buy-write-strategy; they have reduced risk compared to a direct investment in the underlying asset; with higher risk levels multiple underlying assets (worst-of) allow for higher discounts; limited profit opportunity (Cap)."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.8"@en ;
	cmns-av:explanatoryNote
		"At the end of the certificate's maturity, a cash disbursement occurs. If the price of the underlying when the maturity is up is higher than the maximal payout or identical to it, the issuer pays the maximum amount. If the price of the underlying is less than the cap, the issuer pays either the current price of the certificate in cash or he gives the investor the underlying, for example a share, at its current price. The issuer can choose. The cash payout is obligatory in the case of discount certificates on indices, currencies or interest."@en ,
		"Discount certificates are ideal for conservative investors that want to guard against market fluctuations and who expect in the medium term sideways-moving prices. Because the buyer of a discount certificate does not profit from price gains that are higher than the cap, this form of investment is best suited for a medium-term oriented engagement. If the certificate reaches its cap before the maturity, the investor should take the profits."@en ,
		"The maximum profit that an investor can reach with a discount certificate is calculated by taking the difference between the purchase price and the cap on the underlying. Losses, in contrast, are lessened by the discount. The investor suffers a loss only when the price of the underlying at the end of the maturity has fallen so far that the discount is depleted. The discount thus works as a buffer against risk."@en
		;
	.

fibo-der-drc-str:ExpressCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:ParticipationCertificate ,
		fibo-sec-dbt-pbs:StructuredFinanceWithoutPrincipalProtection
		;
	rdfs:label "express certificate"@en ;
	skos:definition "participation certificate whose payout is conditional: should the underlying trade above the strike on the observation date, an early redemption consisting of nominal price plus an additional coupon amount is paid"@en ;
	skos:note "Express certificates offer the possibility of an early redemption combined with an attractive yield opportunity. They have reduced risk compared to a direct investment into the underlying asset(s). With higher risk levels, multiple underlying assets (worst-of) allow for higher coupons or lower barriers; limited profit opportunity (Cap)."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.8"@en ;
	.

fibo-der-drc-str:IndexCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:ParticipationCertificate ;
	rdfs:label "index certificate"@en ;
	skos:definition "certificate whose underlying asset is an index"@en ;
	cmns-av:explanatoryNote
		"If the underlying share increases in value, the value of the certificate increases in analog to the gain; with every setback, the certificate value declines accordingly."@en ,
		"Investors should think about currency risks when investing in index certificates that track a share index outside of the euro zone. And they should pay attention to whether the underlying index is a performance or price index. With a performance index, all dividends and profits from subscription rights flow into the index value. In contrast to that, price indices show the pure development of the shares and thus the price declines that usually accompany dividend payouts. Index certificates are particularly interesting to investors that want to profit from positive capital-market developments, but who don’t want to deal with the daily price developments of several individual shares."@en ,
		"With Index certificates investors can participate one-to-one in the development of an exchange index – without actually buying the underlying shares in that comprise that index. Every index certificate has a subscription rate (e.g., 1:10 or 1:100) that defines the value of the certificate in relation to the index listing. The investor invests broadly diversified and transparently with minimal effort and smaller amounts."@en
		;
	.

fibo-der-drc-str:LeveragedProduct
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:StructuredProduct ;
	rdfs:label "leveraged product"@en ;
	skos:definition "structured product that provides a further enhanced yield (over and above that of a yield-enhancement product), often without any limit to the upside participation, and frequently with a stop-loss in order to limit potential capital losses"@en ;
	skos:example "Leveraged certificates are examples of leveraged products; they provide enhanced participation to an underlying with inbuilt leverage. Leveraged exposure is also provided on the downside performance of the underlying. Another example is a call warrant, which is simply a call option that is traded in a securitized format. This format is interesting in order to be able to trade a call option on underlyings for which no exchange traded option market exists."@en ;
	.

fibo-der-drc-str:OutperformanceBonusCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:BonusCertificate ,
		fibo-der-drc-str:OutperformanceCertificate
		;
	rdfs:label "outperformance bonus certificate"@en ;
	skos:definition "certificate that allows disproportionate participation (outperformance) in positive performance above the strike, in which the minimum redemption is equal to the nominal value provided the barrier has not been breached, with greater risk multiple underlying asset(s) (worst-of) allow for a higher bonus level or lower barrier, and reduced risk compared to a direct investment into the underlying asset(s)"@en ;
	skos:note "If the barrier is breached the product changes into an outperformance certificate."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.2.8"@en ;
	cmns-av:explanatoryNote "The outperformance bonus certificate combines the strengths of both outperformance and normal bonus certificates. This means that you’re protected on the downside by a bonus level (i.e., a feature of bonus certificates) but nevertheless have the opportunity to participate disproportionately in upside gains in the underlying instrument (the 'outperformance certificate' dimension). If you compare all three structured product types with each other, you’ll see that outperformance bonus certificates come up a bit short in terms of the characteristics of the other two forms. In other words, the disproportionate participation rate (outperformance) is usually somewhat lower than with a 'plain vanilla' outperformance certificate. This is because additional bonus protection has to be bought in order to structure the product properly. The same applies to the bonus dimension: because such a certificate still affords disproportionate participation, its downside protection level is more modest."@en ;
	.

fibo-der-drc-str:OutperformanceCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:ParticipationCertificate ;
	rdfs:label "outperformance certificate"@en ;
	skos:definition "certificate that allows disproportionate participation (outperformance) in positive performance above the strike, reflecting underlying price moves 1:1 (adjusted by the conversion ratio and any related fees), and whose risk is comparable to direct investment in the underlying asset(s)"@en ;
	skos:example "For example: You buy an outperformance certificate based on a stock. The certificate’s strike price is 100 Euros and its participation factor is 150 percent. If the price of the underlying stock surpasses the strike price of 100 Euros, you are rewarded with a 150 percent return, instead of just 100 percent. If the price of the stock climbs to 110 Euros, for example, the value of the certificate would be 115 Euros."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.2.8"@en ;
	.

fibo-der-drc-str:ParticipationCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:ParticipationInstrument ,
		fibo-sec-dbt-pbs:StructuredFinanceInstrument
		;
	rdfs:label "participation certificate"@en ;
	skos:definition "participation product that provides the possibility to participate in the gains or losses in the price of an asset, subject to counterparty risk"@en ;
	cmns-av:explanatoryNote "In many cases, certificates do not give the investor the right to receive dividend distributions from the underlying stocks or other assets. For example: You buy a bonus certificate issued by your bank which is based on a stock that pays annual dividends. During the certificate's term, the bank holds the underlying stock and receives the dividends. At the end of the term, the bank pays the predefined bonus, even though the actual price of the stock is lower (but not below the protection threshold).Depending on the type of certificate, the exact terms and conditions, and the contract's expiry date, it is possible that the investor may receive the underlying asset instead of money at the end of the investment term. That is often the case with discount certificates based on stocks, for example, when their price sits below the predetermined cap. If the certificate's issuer becomes insolvent, the assets which underly the certificate are considered part of the issuer's liquid assets. This is in contrast to owning actual securities or shares in investment funds, as these are segregated assets which remain the property of the investor if the broker or custodian bank fails."@en ;
	cmns-av:synonym
		"bearer debt note"@en ,
		"certificate"@en
		;
	.

fibo-der-drc-str:ParticipationInstrument
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:StructuredProduct ,
		fibo-der-sbd-sbd:SecurityBasedDerivative
		;
	rdfs:label "participation instrument"@en ;
	skos:definition "structured product that provides the possibility to participate in the performance of an asset or basket of assets"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	cmns-av:explanatoryNote
		"The construction is generally based on a low exercise price option (LEPO) (base value less discounted future dividends) which in some cases might be comparable to a direct investment in the underlying asset(s) or a LEPO combined with other options, which together provide the desired disbursement profile."@en ,
		"These assets could be anything, from equities, funds, bonds, ETFs indices to a mix of those. The most common participation products are tracker certificates, providing 1-to-1 participation to the performance of a basket of securities."@en
		;
	cmns-av:synonym "participation product"@en ;
	.

fibo-der-drc-str:ReverseConvertibleCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:ParticipationCertificate ,
		fibo-sec-dbt-pbs:StructuredFinanceWithoutPrincipalProtection
		;
	rdfs:label "reverse convertible certificate"@en ;
	skos:definition "participation certificate whose payout is conditional: should the underlying asset close below the strike on expiry, the underlying asset(s) and/ or a cash amount is redeemed; should the underlying asset close above the strike at expiry, the nominal amount plus the coupon is paid at redemption"@en ;
	skos:note "Note that in the case of a reverse convertible certificate, the coupon is paid regardless of the underlying development. It has reduced risk compared to a direct investment into the underlying asset. With higher risk levels, multiple underlying assets (worst-of) allow for higher coupons; limited profit potential (Cap)."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.8"@en ;
	.

fibo-der-drc-str:StructuredProduct
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:DerivativeInstrument ;
	rdfs:label "structured product"@en ;
	skos:definition "security whose cash flow characteristics depend upon one or more indices or that have embedded forwards or options or securities where an investor's investment return and the issuer's payment obligations are contingent on, or highly sensitive to, changes in the value of underlying assets, indices, interest rates or cash flows"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	cmns-av:explanatoryNote "A structured product is a pre-packaged structured finance investment strategy based on a single security, a basket of securities, options, indices, commodities, debt issuance or foreign currencies, and to a lesser extent, derivatives. Structured products are not homogeneous - there are numerous varieties of derivatives and underlying assets - but they can be classified under the aside categories. Typically, a desk will employ a specialized 'structurer' to design and manage its structured-product offering."@en ;
	cmns-av:synonym
		"market-linked investment"@en ,
		"structured instrument"@en
		;
	.

fibo-der-drc-str:TrackerCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:ParticipationCertificate ;
	rdfs:label "tracker certificate"@en ;
	skos:definition "certificate that reflects underlying price moves 1:1 (adjusted by conversion ratio and any related fees), in which the associated risk is comparable to direct investment in the underlying asset(s)"@en ;
	skos:example
		"Tracker certificates can be purchased on stock exchanges which they are listed on. Many of these certificates track underlying assets at a ratio of 1:100. That means that an investor can invest just a fraction of the amount which would be required to buy the actual underlying asset. For example: You invest in a tracker certificate which is based on a stock basket with a value of 10,000 Euros. Because the tracker certificate uses a ratio of 1:100, you only need to pay 100 Euros for the certificate. If the price of the underlying stocks goes up by 10 percent (to 11,000 Euros), the value of the certificate will also go up by 10 percent (to 110 Euros)."@en ,
		"Trackers can be used to invest in the performance of multiple stocks, for example. A tracker certificate is a structured instrument that allows the investor to invest in an underlying asset without actually owning the asset. From an investor perspective, tracker certificates work much like investment funds. The tracker follows the price of an underlying asset (one or more stocks, for example). The investor buys a certificate based on the tracker. If the value of the underlying asset goes up, the value of the certificate goes up with it. If the underlying asset loses value, the certificate loses value."@en
		;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.2.8"@en ;
	cmns-av:explanatoryNote
		"Some tracker certificates have an expiry date. That means they only track an underlying asset for a predetermined length of time (one year, for example). The certificate matures at the end of that period, at which point you as the investor are paid out its going value at the time of expiry."@en ,
		"Tracker certificates can also be used to profit off negative price developments. This is the case with so-called bear tracker certificates which take a short position on the underlying asset. Note that tracker certificates do not normally pay out dividends. If one holds a certificate which tracks the stock of a company which pay dividends, they will not receive them. However, they may receive some form of compensation from the certificate’s issuer in some cases."@en ,
		"Unlike investment funds – which are divided into shares and owned by investors – tracker certificates are simply debt claims against the issuer (the bank which offers them, for example). That means the underlying asset which you are investing in does not belong to you, but to the issuer. Shares of investment funds, on the other hand, are classified as segregated assets in some jurisdictions, such as Switzerland, and are owned by you as the shareholder rather than by the fund managers. In practice, investors are not likely to notice the difference. But whether you hold tracker certificates or fund shares makes a big difference when an investment company becomes insolvent. Tracker certificates are not protected against issuer bankruptcy, and fall into the pool of general debt claims against the bankrupt party. If the issuer of a tracker certificate goes bankrupt, you may very likely lose all or part of the money which you invested in the tracker certificate. This danger is known as counterparty risk. By investing in tracker certificates, you agree to carry the counterparty risk."@en
		;
	.

fibo-der-drc-str:TurboCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:ParticipationCertificate ;
	rdfs:label "turbo certificate"@en ;
	skos:definition "certificate that acts as a leveraged security, whose price tracks an underlying financial asset's price one for one, and that can be used to go long or short"@en ;
	cmns-av:explanatoryNote
		"As risk management each turbo trade has a built-in knock-out level and will terminate if this is hit."@en ,
		"There are two types of turbos: long turbos, sometimes known as bull turbos, and short turbos, also known as bear turbos. You'd buy a long turbo if you thought the price of the underlying asset was set to rise. With a long turbo, the knock-out level will be below the underlying asset's current market price to protect you against downward movements. Alternatively, you'd buy a short turbo if you thought the price of the underlying asset might fall. A short turbo will have a knock-out level which is above the underlying asset's current market price to protect you against upward movements."@en ,
		"Turbos are traded on venue rather than over the counter (OTC), and have fully visible order books that you can view to gauge sentiment and plan your strategy. Turbo trading works by buying a transferrable security whose value is based on an underlying asset's. So, you effectively take a position on that asset's price either rising or falling. For each trade, you choose a knock-out level – the point where you'd like to exit if the market turns against you. This then helps to determine the purchase price for the turbo, which will be your maximum possible loss. You'll pay this outlay in full upfront."@en
		;
	cmns-av:synonym
		"turbo"@en ,
		"turbo warrant"@en
		;
	.

fibo-der-drc-str:TwinWinCertificate
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:ParticipationCertificate ;
	rdfs:label "twin-win certificate"@en ;
	skos:definition "certificate that makes profits possible with rising and falling underlying asset values, in which a falling underlying asset price converts into profit up to the barrier, and whose minimum redemption is equal to the nominal value provided the barrier has not been breached"@en ;
	skos:note "If the barrier is breached the product changes into a tracker certificate. With higher risk levels, multiple underlying asset(s) (worst-of) allow for a higher bonus level or lower barrier. Twin-win certificates have reduced risk compared to a direct investment into the underlying asset(s)."@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.2.8"@en ;
	cmns-av:explanatoryNote
		"Twin-win certificates are suited to investors who are convinced that the underlying instrument has a good chance of going up. If it in fact does, the built-in leverage of the product enables you to participate not just 1:1 in that upside move (as would be the case with a normal tracker certificate), but instead at a disproportionate rate and with no price limitation."@en ,
		"With a twin-win certificate, you can actually have it both ways. In other words, this type of structured product generates a profit for you not only when the price of the underlying instrument goes up, but also if it declines to a certain extent. And this with a specially built-in safety mechanism. The unique structure of these products makes it possible to turn a modest loss in the underlying instrument into a modest gain."@en
		;
	.

fibo-der-drc-str:YieldEnhancementProduct
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-str:StructuredProduct ;
	rdfs:label "yield-enhancement product"@en ;
	skos:definition "structured product that provides a predefined yield in return for a downside risk"@en ;
	skos:example "Well-known yield-enhancement products include reverse convertibles. They provide a predetermined yield per annum in return for the willingness of the investor to absorb downside risk of for example a stock, index, currency-pair or fund. Reverse convertibles come in a broad range of variations (with or without barrier, multiple underlyings and/or callability)."@en ;
	.

fibo-der-drc-swp:BasisSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-swp:RatesSwap ;
	rdfs:label "basis swap" ;
	skos:definition "swap in which payment streams are referenced to different bases" ;
	cmns-av:explanatoryNote "A basis swap can have two legs of the same tenor but different indices, e.g., 3 month LIBOR vs. 3 month TIBOR. The difference in this case is not driven by different interest rate periods but from different markets, i.e., the difference in efficiency between the two markets. The objective is to hedge against basis risk which is the difference in price between two markets. See also forward swap, as a means for controlling interest rate." ;
	.

fibo-der-drc-swp:CorrelationLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:PerformanceBasedVariableLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:isLegOf ;
			owl:someValuesFrom fibo-der-drc-swp:CorrelationSwap ;
		]
		;
	rdfs:label "correlation leg"@en ;
	skos:definition "floating leg of a correlation swap that pays an amount based on the observed average correlation of the prices of a collection of underlying products"@en ;
	.

fibo-der-drc-swp:CorrelationSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-swp:StatisticalSwap ;
	rdfs:label "correlation swap"@en ;
	skos:definition "over-the-counter statistical derivative that allows one to hedge risks associated with the observed average correlation of a collection of underlying products"@en ;
	cmns-av:explanatoryNote "Each product that can act as the underlier on which the correlation is based has periodically observable prices, such as a commodity, exchange rate, interest rate, or stock index. Correlation trading is a strategy in which the investor receives exposure to the average correlation of an index." ;
	.

fibo-der-drc-swp:DispersionLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:PerformanceBasedVariableLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:isLegOf ;
			owl:someValuesFrom fibo-der-drc-swp:DispersionSwap ;
		]
		;
	rdfs:label "dispersion leg"@en ;
	skos:definition "floating leg of a dispersion swap that pays an amount based on the realized dispersion of the price changes of the underlying product" ;
	cmns-av:explanatoryNote "Underlying assets may include, for example, exchange rates, interest rates, or the price of an index."@en ;
	cmns-av:synonym "variance leg"@en ;
	.

fibo-der-drc-swp:DispersionSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:StatisticalSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:onClass fibo-der-drc-swp:DispersionLeg ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "dispersion swap"@en ;
	rdfs:seeAlso <https://www.sk3w.co/documents/volatility_trading.pdf> ;
	skos:definition "statistical derivative used to hedge on the magnitude of a price movement of an underlying asset"@en ;
	cmns-av:explanatoryNote
		"A variance swap is an instrument that allows investors to trade future realized (or historical) volatility against current implied volatility." ,
		"Some strategies involve selling a variance swap on an index and buying the variance swaps on the individual constituents; this particular kind of spread trade is called a variance dispersion trade."
		;
	cmns-av:synonym "variance swap"@en ;
	.

fibo-der-drc-swp:ExcessReturnSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-swp:IndexReturnSwap ;
	rdfs:label "excess return swap"@en ;
	skos:definition "return swap in which the change in the level of the index will be equal to the returns generated primarily by the changes in price of each of the contracts that comprise the index"@en ;
	cmns-av:adaptedFrom "ISDA Disclosure Annex for Commodity Derivative Transactions. See https://globalmarkets.bnpparibas.com/gm/features/docs/dfdisclosures/ISDA_Commodity_Derivatives_Disclosure_Annex_04_2013.pdf"@en ;
	.

fibo-der-drc-swp:FixedLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:SwapLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-psch:hasPaymentSchedule ;
			owl:onClass fibo-fnd-pas-psch:PaymentSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "fixed leg" ;
	owl:disjointWith fibo-der-drc-swp:FloatingLeg ;
	skos:definition "swap leg whose paying party is obligated to make payments from time to time over the term of a swap calculated by reference to a fixed annual rate or consisting of at least one payment of a fixed amount" ;
	cmns-av:adaptedFrom
		"2006 ISDA Definitions"@en ,
		"ISDA Disclosure Annex for Commodity Derivative Transactions. See https://globalmarkets.bnpparibas.com/gm/features/docs/dfdisclosures/ISDA_Commodity_Derivatives_Disclosure_Annex_04_2013.pdf"@en
		;
	.

fibo-der-drc-swp:FixedPaymentLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:SwapLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-psch:hasPaymentSchedule ;
			owl:someValuesFrom fibo-fnd-pas-psch:PaymentSchedule ;
		]
		;
	rdfs:label "fixed payment leg" ;
	skos:definition "swap leg that specifies contractual terms associated with a schedule of payments for any swap calculated by reference to a fixed annual rate" ;
	cmns-av:synonym
		"fixed payment stream terms" ,
		"funding leg"
		;
	cmns-av:usageNote "Payments may be fixed or variable, which is independent from the function of the leg (payments, return etc.). The schedule may be expressed in one of two ways: as an explicit schedule of dates or as a formula for determining payment dates in advance (taking into account for example roll rules for non working days)." ;
	.

fibo-der-drc-swp:FloatingLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:SwapLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-psch:hasPaymentSchedule ;
			owl:onClass fibo-fnd-pas-psch:PaymentSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "floating leg" ;
	skos:definition "swap leg whose paying party is obligated to make payments from time to time over the term of a swap calculated by reference to some variable rate, calculated based on the change in value of some underlying asset, or consisting of at least one payment of some floating amount" ;
	cmns-av:adaptedFrom
		"2006 ISDA Definitions"@en ,
		"ISDA Disclosure Annex for Commodity Derivative Transactions. See https://globalmarkets.bnpparibas.com/gm/features/docs/dfdisclosures/ISDA_Commodity_Derivatives_Disclosure_Annex_04_2013.pdf"@en
		;
	.

fibo-der-drc-swp:IndexReturnSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-swp:ReturnSwap ;
	rdfs:label "index return swap"@en ;
	skos:definition "return swap in which payments are based on a fee paid to the seller of the swap and on a floating reference price based on changes in the level of an index from an initial level to a level observed on some valuation date(s)"@en ;
	cmns-av:adaptedFrom "ISDA Disclosure Annex for Commodity Derivative Transactions. See https://globalmarkets.bnpparibas.com/gm/features/docs/dfdisclosures/ISDA_Commodity_Derivatives_Disclosure_Annex_04_2013.pdf"@en ;
	cmns-av:explanatoryNote "Payments to the parties may be made either on a periodic basis or on termination of the transaction. One party will receive a payment based upon the change in the level of the index between two valuation dates (multiplied by the notional amount of the swap), as modified by the fee paid to the seller of the swap. If the level of the index increases, the buyer of the swap will be entitled to a payment based on this performance, as such payment may be reduced (or negated) by the fee paid to the seller of the swap. If the level of the index decreases, the seller of the swap will be entitled to a payment based on this performance, as such payment may be increased by the fee paid to the seller of the swap."@en ;
	.

fibo-der-drc-swp:MajorSwapParticipant
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-fse:NonDepositoryInstitution ;
	rdfs:label "major swap participant" ;
	skos:definition "financial service provider that maintains a substantial position in swaps for any of the major swap categories" ;
	cmns-av:abbreviation "MSP" ;
	cmns-av:adaptedFrom "http://www.cftc.gov/IndustryOversight/Intermediaries/index.htm"^^xsd:anyURI ;
	cmns-av:explanatoryNote "This excludes positions held for hedging or mitigating commercial risk and positions maintained by an employee benefit plan for the primary purpose of hedging or mitigating any risk directly associated with the operation of the plan." ;
	.

fibo-der-drc-swp:PerformanceBasedVariableLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:FloatingLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:isLegOf ;
			owl:someValuesFrom fibo-der-drc-swp:StatisticalSwap ;
		]
		;
	rdfs:label "performance-based variable leg" ;
	skos:definition "floating leg of a swap that depends on some statistical measure of the performance of the underlier" ;
	.

fibo-der-drc-swp:RateBasedLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:SwapLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:isLegOf ;
			owl:someValuesFrom fibo-der-drc-swp:RatesSwap ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-ind-ei-ei:EconomicIndicator
						fibo-ind-fx-fx:QuotedExchangeRate
						fibo-ind-ind-ind:MarketRate
						fibo-sec-sec-bsk:BasketOfIndices
					) ;
				] ;
			] ;
		]
		;
	rdfs:label "rate-based leg"@en ;
	skos:definition "swap leg of a rate-based swap based on a floating interest, floating inflation or fixed interest rate"@en ;
	.

fibo-der-drc-swp:RatesSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:Swap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:onClass fibo-der-drc-swp:RateBasedLeg ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "rates swap" ;
	skos:definition "swap in two counterparties each agree to pay the other cash flows on defined dates during an agreed period, based on a specified notional amount and a floating interest, floating inflation or fixed interest rate" ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15" ;
	.

fibo-der-drc-swp:RealizedVariableLeg
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-swp:PerformanceBasedVariableLeg ;
	rdfs:label "realized variable leg" ;
	skos:definition "performance-based leg wherein the payment is netted at maturity rather than periodically" ;
	cmns-av:explanatoryNote "In this case there is a single payment at maturity/settlement and so there is no stream of cashflows either way. The other leg of these swaps is implied, and is simply the strike price." ;
	.

fibo-der-drc-swp:ReturnLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:FloatingLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:isLegOf ;
			owl:someValuesFrom fibo-der-drc-swp:ReturnSwap ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-oac-own:TangibleAsset
					[
						a owl:Restriction ;
						owl:onProperty cmns-rlcmp:isPlayedBy ;
						owl:someValuesFrom fibo-ind-mkt-bas:ReferenceIndex ;
					]
				) ;
			] ;
		]
		;
	rdfs:label "return leg"@en ;
	skos:definition "leg of a swap in which the income generated by some underlier is paid"@en ;
	cmns-av:explanatoryNote "The return, including income from a tangible asset, the constituents of an index, or a notional/specified amount of some asset (e.g. number of shares, amount of a commodity, etc.), may be limited to the dividend or interest amounts on the underlying (simple return), or total return including capital gains and/or the appreciation or decrease in value of the asset (or index constituents)."@en ;
	.

fibo-der-drc-swp:ReturnSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:Swap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasFundingLeg ;
			owl:someValuesFrom fibo-der-drc-swp:FixedPaymentLeg ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasReturnLeg ;
			owl:someValuesFrom fibo-der-drc-swp:ReturnLeg ;
		]
		;
	rdfs:label "return swap"@en ;
	skos:definition "swap in which one leg, the return leg, is based on income generated from some underlier"@en ;
	.

fibo-der-drc-swp:SimpleReturnLeg
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-swp:ReturnLeg ;
	rdfs:label "simple return leg"@en ;
	skos:definition "return leg based strictly on the income generated by the underlying asset, excluding appreciation, decrease in value, capital gains, and fees on any increase in value"@en ;
	cmns-av:explanatoryNote "Payments may include interest payments on a debt instrument or the dividends on an equity, for example."@en ;
	.

fibo-der-drc-swp:StatisticalSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:Swap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:onClass fibo-der-drc-swp:FixedLeg ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:someValuesFrom fibo-der-drc-swp:PerformanceBasedVariableLeg ;
		]
		;
	rdfs:label "statistical swap" ;
	skos:definition "swap that depends on some statistical measure of the performance of the underlier" ;
	.

fibo-der-drc-swp:StrikeLeg
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-swp:FixedLeg ;
	rdfs:label "strike leg"@en ;
	skos:definition "swap leg that specifies a fixed amount, 'the strike', quoted at the time of execution"@en ;
	cmns-av:explanatoryNote "The fixed amount may be with respect to some variable or a monetary amount. The realization of a strike leg is not a cashflow per se, but a netting out against the terms defined in the other leg of a statistical swap."@en ;
	.

fibo-der-drc-swp:Swap
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:DerivativeInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-der-drc-swp:UniqueSwapIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:someValuesFrom fibo-der-drc-swp:SwapParty ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-der-drc-swp:SwapTerms ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exchanges ;
			owl:someValuesFrom fibo-der-drc-swp:SwapLeg ;
		]
		;
	rdfs:label "swap" ;
	skos:definition "derivative instrument whereby counterparties agree to exchange periodic streams of cash flows or liabilities from two different financial instruments with each other" ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15" ;
	cmns-av:explanatoryNote
		"The notional amount, effective date and termination date are some of the properties that each swap leg has that are taken from the swap contract." ,
		"The underlying instruments can be almost anything, representing various asset classes, but most swaps involve cash flows (streams of payments or other commitments over time) based on a notional principal amount that both parties agree to." ,
		"Usually, the principal does not change hands. Each cash flow comprises one leg of the swap. One cash flow is generally fixed, while the other is variable, that is, based on a a benchmark interest rate, floating currency exchange rate or index price."
		;
	.

fibo-der-drc-swp:SwapConfirmation
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:SwapLifecycleEvent ,
		fibo-fnd-pas-pas:TransactionConfirmation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:supersedes ;
			owl:allValuesFrom fibo-der-drc-swp:SwapConfirmation ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:someValuesFrom fibo-der-drc-swp:SwapParty ;
		]
		;
	rdfs:label "swap confirmation" ;
	skos:definition "formal confirmation that codifies the terms and conditions specific to a lifecycle event with respect to the overall transaction between the parties" ;
	.

fibo-der-drc-swp:SwapDataRepository
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-fpas:FinancialServiceProvider ;
	rdfs:label "swap data repository" ;
	skos:definition "financial service provider that provides a central facility for swap data reporting and recordkeeping" ;
	cmns-av:abbreviation "SDR" ;
	cmns-av:adaptedFrom "http://www.cftc.gov/IndustryOversight/DataRepositories/index.htm"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Swap data repositories ('SDRs') are new entities created by the Dodd-Frank Wall Street Reform and Consumer Protection Act ('Dodd-Frank Act') in order to provide a central facility for swap data reporting and recordkeeping. Under the Dodd- Frank Act, all swaps, whether cleared or uncleared, are required to be reported to registered SDRs. The Dodd-Frank Act added new Section 21 to the Commodity Exchange Act ('CEA'), governing registration and regulation of SDRs and establishing registration requirements and core duties and responsibilities for SDRs." ;
	.

fibo-der-drc-swp:SwapDealer
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-fse:NonDepositoryInstitution ,
		fibo-fbc-pas-fpas:Dealer
		;
	rdfs:label "swap dealer" ;
	skos:definition "non-depository institution such as one that deals in swaps, makes a market in swaps, regularly enters into swaps with counterparties as an ordinary course of business for its own account, and engages in any activity causing the person to be commonly known in the trade as a dealer/market maker in swaps" ;
	cmns-av:abbreviation "SD" ;
	cmns-av:adaptedFrom "http://www.cftc.gov/IndustryOversight/Intermediaries/index.htm"^^xsd:anyURI ;
	.

fibo-der-drc-swp:SwapLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:CashflowTerms ,
		fibo-der-drc-swp:SwapTerms ,
		[
			a owl:Class ;
			owl:unionOf (
				[
					a owl:Restriction ;
					owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
					owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
					owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
				]
				[
					a owl:Restriction ;
					owl:onProperty cmns-qtu:hasQuantityValue ;
					owl:onClass cmns-qtu:ScalarQuantityValue ;
					owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
				]
			) ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasTerminationDate ;
			owl:onClass cmns-dt:Date ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:hasBuyer ;
			owl:onClass fibo-der-drc-swp:SwapPayingParty ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:hasSeller ;
			owl:onClass fibo-der-drc-swp:SwapReceivingParty ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isDenominatedIn ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasEffectiveDate ;
			owl:onClass cmns-dt:Date ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:isLegOf ;
			owl:someValuesFrom fibo-der-drc-swp:Swap ;
		]
		;
	rdfs:label "swap leg" ;
	skos:definition "terms defining and the commitment to fulfill cashflow requirements (e.g., interest payments, coupon payments, etc.) for a component of a swap" ;
	cmns-av:explanatoryNote
		"A one-leg financing swap (also known as a single-leg financing swap) is a type of financial derivative, typically used by institutional investors or corporations, in which one party makes a series of fixed or floating payments to another party in exchange for a single upfront cash payment or financing." ,
		"A three-leg financial swap is a more complex type of swap agreement where three different payment streams (or 'legs') are involved, as opposed to the traditional two-leg swaps (like fixed-for-floating interest rate swaps). This structure can be useful for sophisticated risk management or hedging strategies, particularly when exposure to multiple interest rates or currencies is desired." ,
		"A two-leg financial swap is the most common type of swap agreement, where two counterparties exchange cash flows or obligations based on different financial variables. Each leg represents a stream of payments or flows tied to specific terms, such as fixed or floating interest rates, currencies, or commodities. The classic example of a two-leg swap is the interest rate swap, where one party pays a fixed interest rate while the other pays a floating interest rate." ,
		"For some swaps this may be a commitment to net up the difference between a strike and an outcome, rather than to make a series of cashflows over time. For credit default swaps there are conditional commitments, contingent on the occurrence of a credit event." ,
		"In most cases, a swap has two legs, one expressing the obligations of the seller and one expressing the obligations of the buyer. However, it is possible to represent more complex swaps, with one, three or more legs. The legs can be almost anything but usually one leg involves cash flows based on a notional principal amount that both parties agree to."
		;
	.

fibo-der-drc-swp:SwapLegEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:SwapLifecycleEvent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-der-drc-swp:SwapLeg ;
		]
		;
	rdfs:label "swap leg event" ;
	skos:definition "swap lifecycle event, such as a payment or rate reset event, that applies to one leg of a swap" ;
	.

fibo-der-drc-swp:SwapLifecycleEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleEvent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-der-drc-swp:SwapLifecycleEventIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasSwapIdentifier ;
			owl:onClass fibo-der-drc-swp:UniqueSwapIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-der-drc-swp:Swap ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-der-drc-swp:SwapParty ;
		]
		;
	rdfs:label "swap lifecycle event" ;
	skos:definition "event that occurs during the lifecycle of a swap, where the overall set of events includes those specific to the issuer, front office, middle office, and/or back office processes" ;
	.

fibo-der-drc-swp:SwapLifecycleEventIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-der-drc-swp:SwapLifecycleEvent ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "swap lifecycle event identifier" ;
	skos:definition "identifier that uniquely identifies a specific event in the lifecycle of a swap" ;
	.

fibo-der-drc-swp:SwapParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractParty ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-der-drc-swp:Swap ;
			] ;
		]
		;
	rdfs:label "swap party" ;
	skos:definition "party to a swap and therefore a legal party to the contract that embodies that transaction" ;
	.

fibo-der-drc-swp:SwapPayingParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:PayingParty ,
		fibo-der-drc-swp:SwapParty
		;
	rdfs:label "swap paying party" ;
	skos:definition "swap party responsible for making payments for a given leg of the transaction as defined in the contract" ;
	.

fibo-der-drc-swp:SwapReceivingParty
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:ReceivingParty ,
		fibo-der-drc-swp:SwapParty
		;
	rdfs:label "swap receiving party" ;
	skos:definition "swap party that receives payments for a given leg of the transaction as defined in the contract" ;
	.

fibo-der-drc-swp:SwapTerms
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-bsc:DerivativeTerms ;
	rdfs:label "swap terms" ;
	skos:definition "legal contractual terms of a swap transaction" ;
	.

fibo-der-drc-swp:TotalReturnLeg
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-swp:ReturnLeg ;
	rdfs:label "total return leg"@en ;
	skos:definition "return leg based on the income generated by the underlying asset as well as any appreciation, decrease in value, capital gains, and fees on any increase in value"@en ;
	cmns-av:explanatoryNote "This is distinguished from the more general Return Leg by the addition of increase or decrease in the value of the underlying asset."@en ;
	.

fibo-der-drc-swp:TotalReturnSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:CreditDerivative ,
		fibo-der-drc-swp:ReturnSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasReturnLeg ;
			owl:someValuesFrom fibo-der-drc-swp:TotalReturnLeg ;
		]
		;
	rdfs:label "total return swap"@en ;
	skos:definition "return swap where the seller agrees to pay the other party the difference in value of some underlying asset multiplied by an agreed-upon notional value should the asset value increase between specified periods of time"@en ;
	skos:example "For example the parties may enter into a two year agreement where every three months they compare the value of the Barclays Capital Aggregate Bond Index to its value three months previously. If the agreed upon notional was US $10,000,000 and the value increased 0.04%, or 4 basis points (bps), the seller would pay the buyer US $4,000. If, after another three months, the value decreased by 3bps, the buyer would pay the seller US $3,000. As part of the agreement, the buyer may also make an additional payment each period to the seller based on a floating rate index multiplied by the notional value."@en ;
	cmns-av:adaptedFrom
		"CFTC Data Dictionary. See https://www.cftc.gov/MarketReports/SwapsReports/DataDictionary/index.htm"@en ,
		"ISDA Disclosure Annex for Commodity Derivative Transactions. See https://globalmarkets.bnpparibas.com/gm/features/docs/dfdisclosures/ISDA_Commodity_Derivatives_Disclosure_Annex_04_2013.pdf"@en
		;
	cmns-av:explanatoryNote
		"In a total return swap that is index-based, the change in the level of the index will be equal to the returns generated by the change in price of each of the contracts that comprise the index plus a return based upon interest earned on any cash collateral posted upon the purchase of the contracts comprising the index."@en ,
		"In exchange, the other party, the buyer of the credit risk, agrees to pay the difference in value of the specified asset multiplied by the notional value should that value decrease between the same specified periods of time. Total return swaps often appear in asset classes other than the credit asset class; however, for the purpose of the CFTC Swaps Report, all total return swaps are counted only in the credit asset class."@en
		;
	.

fibo-der-drc-swp:UniqueSwapIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:FinancialInstrumentIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-der-drc-swp:Swap ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "unique swap identifier" ;
	skos:definition "identifier for a swap that is used in recordkeeping and swap data reporting" ;
	cmns-av:abbreviation "USI" ;
	cmns-av:adaptedFrom "CFTC Data Management Branch 'Unique Swap Identifier (USI) Data Standard', October 1, 2012, usidatastandards100112.pdf" ;
	.

fibo-der-drc-swp:hasFundingLeg
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-der-drc-swp:hasLeg ;
	rdfs:label "has funding leg"@en ;
	rdfs:domain fibo-der-drc-swp:ReturnSwap ;
	skos:definition "indicates the leg of a return swap that specifies a set payment rate, typically benchmark based but possibly a fixed rate" ;
	.

fibo-der-drc-swp:hasLeg
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has leg" ;
	rdfs:domain fibo-der-drc-swp:Swap ;
	rdfs:range fibo-der-drc-swp:SwapLeg ;
	skos:definition "relates a swap contract to a leg that is part of that swap" ;
	.

fibo-der-drc-swp:hasReturnLeg
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-der-drc-swp:hasLeg ;
	rdfs:label "has return leg"@en ;
	rdfs:domain fibo-der-drc-swp:ReturnSwap ;
	rdfs:range fibo-der-drc-swp:ReturnLeg ;
	skos:definition "indicates the leg of a return swap whose payments are based on the return of an underlying asset" ;
	.

fibo-der-drc-swp:hasSwapIdentifier
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:refersTo ;
	rdfs:label "has swap identifier" ;
	rdfs:range fibo-fbc-fi-fi:FinancialInstrumentIdentifier ;
	skos:definition "relates a swap lifecycle event to the identifier for the swap" ;
	.

fibo-der-drc-swp:isLegOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:isIncludedIn ;
	rdfs:label "is leg of" ;
	rdfs:domain fibo-der-drc-swp:SwapLeg ;
	rdfs:range fibo-der-drc-swp:Swap ;
	owl:inverseOf fibo-der-drc-swp:hasLeg ;
	skos:definition "relates a swap leg to the to the swap that includes it" ;
	.

fibo-der-drc-swpind:BloombergSDR
	a
		owl:NamedIndividual ,
		fibo-der-drc-swp:SwapDataRepository
		;
	rdfs:label "Bloomberg SDR" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/SwapsIndividuals/> ;
	skos:definition "swap data repository that receives, validates, maintains, and provides regulator-authorized access to derivatives transaction data submitted under jurisdiction-specific reporting rules, and operates as a registered SDR service within the Bloomberg group of entities" ;
	cmns-av:abbreviation "BSDR" ;
	cmns-ra:isRegisteredBy fibo-fbc-fct-usjrga:CommoditiesFuturesAndDerivativesRegulator ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:BSDRLLC-US-DE ;
	.

fibo-der-drc-swpind:ChicagoMercantileExchange
	a
		owl:NamedIndividual ,
		fibo-der-drc-swp:SwapDataRepository ,
		fibo-fbc-fct-fse:SelfRegulatingOrganization ,
		fibo-fbc-fct-mkt:DesignatedContractMarket
		;
	rdfs:label "Chicago Mercantile Exchange" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/SwapsIndividuals/> ;
	skos:definition "financial derivatives exchange that offers centralized, regulated trading of futures and options contracts across multiple asset classes and forms part of CME Group" ;
	skos:note "Chicago Mercantile Exchange was founded in 1898, formerly the Chicago Butter and Egg Board. CME (1) provides a marketplace for standardized futures and options, (2) operates under CME rules as a Designated Contract Market, (3) supports trading in interest rates, equity indexes, energy, agriculture, FX, metals, and cryptocurrency products, and (4) functions as one of the four major exchanges within CME Group. It has been part of CME Group since 2007." ;
	cmns-av:abbreviation "CME" ;
	cmns-ra:isRegisteredBy fibo-fbc-fct-usjrga:CommoditiesFuturesAndDerivativesRegulator ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:ChicagoMercantileExchangeInc-US-DE ;
	.

fibo-der-drc-swpind:DTCCDataRepository
	a
		owl:NamedIndividual ,
		fibo-der-drc-swp:SwapDataRepository
		;
	rdfs:label "DTCC Data Repository" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/SwapsIndividuals/> ;
	skos:definition "swap data repository that receives, validates, maintains, and provides regulated access to derivatives transaction data for reporting entities under U.S. and global derivatives market regulations, and operates as a registered SDR subsidiary of the Depository Trust & Clearing Corporation" ;
	skos:note "DDR is part of DTCC's Global Trade Repository architecture and supports multi-jurisdictional derivatives reporting mandates (e.g., Dodd-Frank, EMIR, ASIC, MAS, HKMA, JFSA). It (1) receives and validates derivatives trade data from reporting counterparties, (2) maintains a centralized, regulator-accessible record of reported transactions, (3) provides data access to authorized regulators, and (4) operates under registration and oversight of relevant authorities (e.g., CFTC, MAS, JFSA, ESMA depending on jurisdiction). DDR operates multiple jurisdiction-specific legal entities, provides reconciliation and lifecycle event processing, offers public aggregate reporting, and integrates with DTCC's Global Trade Repository (GTR) service." ;
	cmns-av:abbreviation "DDR" ;
	cmns-ra:isRegisteredBy fibo-fbc-fct-usjrga:CommoditiesFuturesAndDerivativesRegulator ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:DTCCDataRepositoryLLC-US-NY ;
	.

fibo-der-drc-swpind:ICETradeVault
	a
		owl:NamedIndividual ,
		fibo-der-drc-swp:SwapDataRepository
		;
	rdfs:label "ICE Trade Vault" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/SwapsIndividuals/> ;
	skos:definition "swap data repository that collects, validates, stores, and provides regulated access to derivatives transaction data for reporting entities under jurisdiction-specific derivatives reporting rules, and operates as a registered SDR service within Intercontinental Exchange (ICE)" ;
	skos:note "ICE Trade Vault is part of ICE's broader market infrastructure ecosystem and supports derivatives reporting mandates under Dodd-Frank, EMIR, and other jurisdictional regimes. It (1) receives and validates derivatives trade data from reporting counterparties, (2) maintains a centralized, regulator-accessible record of reported transactions and lifecycle events, (3) provides data access to authorized regulators and public aggregate reporting, and (4) operates under registration and oversight of relevant authorities (e.g., CFTC, ESMA, MAS, depending on jurisdiction). ICE Trade Vault offers multi-asset class reporting (e.g., credit, interest rate, FX, commodity derivatives, integrates with ICE's clearing and trading infrastructure, and provides reconciliation and data quality tools." ;
	cmns-ra:isRegisteredBy fibo-fbc-fct-usjrga:CommoditiesFuturesAndDerivativesRegulator ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:ICETradeVaultLLC-US-DE ;
	.

fibo-der-rtd-irswp:CrossCurrencyInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-rtd-irswp:InterestRateSwap ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "cross-currency interest rate swap" ;
	skos:definition "interest rate swap in which the two streams of interest payments are in different currencies" ;
	.

fibo-der-rtd-irswp:FixedFixedInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-rtd-irswp:InterestRateSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exchanges ;
			owl:onClass fibo-der-rtd-irswp:FixedInterestRateLeg ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "fixed fixed interest rate swap" ;
	skos:definition "interest rate swap in which both parties pay a fixed interest rate that they could not otherwise obtain outside of a swap arrangement" ;
	skos:example "For example, each counterparty uses a different native currency, but wants to borrow money in the other counterparty's native currency." ;
	skos:note "Fixed-fixed swaps generally take the form of either a zero coupon swap or a cross-currency swap." ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of Financial Instruments (CFI code), Fourth edition, 2019-10." ;
	cmns-av:synonym "fixed-fixed interest rate swap" ;
	.

fibo-der-rtd-irswp:FixedFloatCrossCurrencyInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-rtd-irswp:CrossCurrencyInterestRateSwap ,
		fibo-der-rtd-irswp:FixedFloatInterestRateSwap
		;
	rdfs:label "fixed float cross-currency interest rate swap" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-rtd-irswp:CrossCurrencyInterestRateSwap
			fibo-der-rtd-irswp:FixedFloatInterestRateSwap
		) ;
	] ;
	skos:definition "interest rate swap in which fixed interest payments on the notional are exchanged for floating interest payments and the two streams of interest payments are in different currencies" ;
	cmns-av:synonym
		"fixed float cross currency interest rate swap" ,
		"fixed-float cross-currency interest rate swap"
		;
	.

fibo-der-rtd-irswp:FixedFloatInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-rtd-irswp:InterestRateSwap ,
		[
			a owl:Class ;
			owl:intersectionOf (
				[
					a owl:Restriction ;
					owl:onProperty fibo-fnd-rel-rel:exchanges ;
					owl:someValuesFrom fibo-der-rtd-irswp:FixedInterestRateLeg ;
				]
				[
					a owl:Restriction ;
					owl:onProperty fibo-fnd-rel-rel:exchanges ;
					owl:someValuesFrom fibo-der-rtd-irswp:FloatingInterestRateLeg ;
				]
			) ;
		]
		;
	rdfs:label "fixed float interest rate swap" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-rtd-irswp:InterestRateSwap
			[
				a owl:Restriction ;
				owl:onProperty fibo-der-drc-swp:hasLeg ;
				owl:someValuesFrom fibo-der-rtd-irswp:FixedInterestRateLeg ;
			]
			[
				a owl:Restriction ;
				owl:onProperty fibo-der-drc-swp:hasLeg ;
				owl:someValuesFrom fibo-der-rtd-irswp:FloatingInterestRateLeg ;
			]
		) ;
	] ;
	skos:definition "interest rate swap in which fixed interest payments on the notional are exchanged for floating interest payments" ;
	cmns-av:synonym "fixed-float interest rate swap" ;
	.

fibo-der-rtd-irswp:FixedFloatSingleCurrencyInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-rtd-irswp:FixedFloatInterestRateSwap ;
	rdfs:label "fixed float single currency interest rate swap" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-rtd-irswp:FixedFloatInterestRateSwap
			fibo-der-rtd-irswp:SingleCurrencyInterestRateSwap
		) ;
	] ;
	skos:definition "interest rate swap in which fixed interest payments on the notional are exchanged for floating interest payments and where both payment streams are expressed in terms of the same currency" ;
	cmns-av:synonym "fixed-float single-currency interest rate swap" ;
	.

fibo-der-rtd-irswp:FixedInterestRateLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:FixedLeg ,
		fibo-der-rtd-irswp:InterestRateSwapLeg
		;
	rdfs:label "fixed interest rate leg" ;
	owl:disjointWith fibo-der-rtd-irswp:FloatingInterestRateLeg ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-rtd-irswp:InterestRateSwapLeg
			[
				a owl:Restriction ;
				owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
				owl:someValuesFrom fibo-fbc-dae-dbt:FixedInterestRate ;
			]
		) ;
	] ;
	skos:definition "fixed leg that specifies fixed interest amounts and terms for the payment of that interest" ;
	cmns-av:explanatoryNote "This may be the funding leg of some swaps (i.e. one party agrees to pay fixed interest amounts in exchange for whatever is the other leg) or it may be one or both sides of an interest rate swap, where the two parties exchange different interest payment streams." ;
	cmns-av:synonym "fixed interest rate payment stream" ;
	.

fibo-der-rtd-irswp:FloatFloatCrossCurrencyInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-rtd-irswp:FloatFloatInterestRateSwap ;
	rdfs:label "float float cross-currency interest rate swap" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-rtd-irswp:CrossCurrencyInterestRateSwap
			fibo-der-rtd-irswp:FloatFloatInterestRateSwap
		) ;
	] ;
	skos:definition "interest rate swap that exchanges cashflows based on two different interest rates in different currencies" ;
	cmns-av:synonym "float-float cross-currency interest rate swap" ;
	.

fibo-der-rtd-irswp:FloatFloatInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:BasisSwap ,
		fibo-der-rtd-irswp:InterestRateSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exchanges ;
			owl:onClass fibo-der-rtd-irswp:FloatingInterestRateLeg ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "float float interest rate swap" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-rtd-irswp:InterestRateSwap
			[
				a owl:Restriction ;
				owl:onProperty fibo-der-drc-swp:hasLeg ;
				owl:onClass fibo-der-rtd-irswp:FloatingInterestRateLeg ;
				owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
			]
		) ;
	] ;
	skos:definition "interest rate swap that exchanges cashflows based on two different floating interest rates" ;
	cmns-av:adaptedFrom "http://www.investopedia.com/terms/b/basisrateswap.asp"^^xsd:anyURI ;
	cmns-av:explanatoryNote "This is a swap in which two parties swap variable interest rates based on different money markets, and this is usually done to limit interest-rate risk that a company faces as a result of having differing lending and borrowing rates." ;
	cmns-av:synonym
		"basis rate swap" ,
		"float-float interest rate swap"
		;
	.

fibo-der-rtd-irswp:FloatFloatSingleCurrencyInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf fibo-der-rtd-irswp:FloatFloatInterestRateSwap ;
	rdfs:label "float float single currency interest rate swap" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-rtd-irswp:FloatFloatInterestRateSwap
			fibo-der-rtd-irswp:SingleCurrencyInterestRateSwap
		) ;
	] ;
	skos:definition "interest rate swap that exchanges cashflows based on two different floating interest rates in the same currency" ;
	cmns-av:synonym "float-float single-currency interest rate swap" ;
	.

fibo-der-rtd-irswp:FloatingInterestRateLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:FloatingLeg ,
		fibo-der-rtd-irswp:InterestRateSwapLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:onClass fibo-fbc-dae-dbt:InterestCalculationSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:onClass fibo-fbc-dae-dbt:InterestRateReset ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:onClass fibo-fbc-dae-dbt:InterestRateResetSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:onClass fibo-fbc-dae-dbt:InterestRateSettingEvent ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "floating interest rate leg" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-rtd-irswp:InterestRateSwapLeg
			[
				a owl:Restriction ;
				owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
				owl:someValuesFrom fibo-fbc-dae-dbt:FloatingInterestRate ;
			]
		) ;
	] ;
	skos:definition "floating leg in which variable interest is paid on some notional amount, linked to some underlying interest reference rate" ;
	cmns-av:explanatoryNote "Instead of an absolute rate you have either a variable reference rate or fixed reference rate and an offset that varies in some way, called a spread (same as margin in floating rate notes)." ;
	cmns-av:synonym "floating interest rate swap stream" ;
	.

fibo-der-rtd-irswp:InflationLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:FloatingLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-ind-ei-ei:EconomicIndicator ;
			] ;
		]
		;
	rdfs:label "inflation leg"@en ;
	skos:definition "floating rate leg of an inflation swap linked to an inflation index, such as the Consumer Price Index (CPI)"@en ;
	.

fibo-der-rtd-irswp:InflationSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:RateBasedDerivative ,
		fibo-der-drc-swp:RatesSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:isLinkedToFallback ;
			owl:onClass fibo-sec-dbt-bnd:GovernmentBond ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:someValuesFrom fibo-der-rtd-irswp:InflationLeg ;
		]
		;
	rdfs:label "inflation swap"@en ;
	skos:definition "rate swap in which one party pays an amount calculated using an inflation rate index, and the other party pays an amount calculated using another inflation rate index, or a fixed or floating interest rate"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	.

fibo-der-rtd-irswp:InterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-bsc:InterestRateDerivative ,
		fibo-der-drc-swp:RatesSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exchanges ;
			owl:onClass fibo-der-rtd-irswp:InterestRateSwapLeg ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "interest rate swap" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-drc-swp:Swap
			[
				a owl:Restriction ;
				owl:onProperty fibo-der-drc-swp:hasLeg ;
				owl:onClass fibo-der-rtd-irswp:InterestRateSwapLeg ;
				owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
			]
		) ;
	] ;
	skos:definition "swap in which the reference (underlier) for at least one leg is an interest rate" ;
	.

fibo-der-rtd-irswp:InterestRateSwapLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:RateBasedLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:onClass fibo-der-rtd-irswp:NotionalStepSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-bd:hasBusinessRecurrenceIntervalConvention ;
			owl:onClass fibo-fbc-dae-dbt:DayCountConvention ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:onClass fibo-fbc-dae-dbt:InterestCalculationSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-psch:hasPaymentSchedule ;
			owl:onClass fibo-fbc-dae-dbt:InterestPaymentSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "interest rate swap leg" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-der-drc-swp:RateBasedLeg
			[
				a owl:Restriction ;
				owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
				owl:someValuesFrom fibo-fnd-acc-cur:InterestRate ;
			]
		) ;
	] ;
	skos:definition "swap leg that has an interest rate payment stream, including both a parametric and cashflow representation for the stream of payments" ;
	cmns-av:synonym "interest rate swap stream" ;
	.

fibo-der-rtd-irswp:NotionalStepAmount
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:ScalarQuantityValue ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-acc-cur:MonetaryAmount
					fibo-fnd-acc-cur:PercentageMonetaryAmount
				) ;
			] ;
		]
		;
	rdfs:label "notional step amount" ;
	skos:definition "the amount of money that is subtracted from the notional on each step date" ;
	cmns-av:explanatoryNote "Note that this is an actual concrete sum of money, which may be specified either as a monetary amount (e.g. dollars and cents) or as a percentage of either the original notional amount or the previous notional amount." ;
	.

fibo-der-rtd-irswp:NotionalStepChangeEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:ContractLifecycleEventOccurrence ,
		fibo-sec-dbt-dbti:StepEvent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:someValuesFrom fibo-der-rtd-irswp:NotionalStepAmount ;
		]
		;
	rdfs:label "notional step change event" ;
	skos:definition "event in which a step change in the notional amount for a given swap leg occurs" ;
	cmns-av:explanatoryNote "The frequency / period length of the steps in the step schedule is a multiple of the calculation period or frequency. For example, if the notional is recalculated on every calculation date, applying a new interest rate to the new notional amount, then the two frequencies are the same. If notional is updated every second calculation period, then the step schedule specifies periods that are twice as long, and so on." ;
	.

fibo-der-rtd-irswp:NotionalStepPeriodLength
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-dt-fd:RecurrenceInterval ;
	rdfs:label "notional step period length" ;
	skos:definition "recurrence interval indicating the frequency with which step changes occur, which is a multiple of the calculation period in the calculation schedule" ;
	.

fibo-der-rtd-irswp:NotionalStepSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:ProjectedContractEventSchedule ,
		fibo-sec-dbt-dbti:StepSchedule ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasRecurrenceInterval ;
			owl:someValuesFrom fibo-der-rtd-irswp:NotionalStepPeriodLength ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOccurrence ;
			owl:someValuesFrom fibo-der-rtd-irswp:NotionalStepChangeEvent ;
		]
		;
	rdfs:label "notional step schedule" ;
	skos:definition "schedule of changes in the notional amount on which interest is paid, comprising the regular sequence of step events" ;
	.

fibo-der-rtd-irswp:OvernightIndexSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-rtd-irswp:InterestRateSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:someValuesFrom fibo-der-rtd-irswp:OvernightRateIndexLeg ;
		]
		;
	rdfs:label "overnight index swap"@en ;
	skos:definition "swap in which the periodic payments for one leg are based on an overnight interest rate index multiplied by the same notional amount upon which payments for the other leg of the swap are based"@en ;
	cmns-av:abbreviation "OIS swap"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	cmns-av:explanatoryNote "The interest of the overnight rate portion of the swap is compounded and paid at reset dates. The present value for the leg is determined by either compounding of the overnight rate or by taking the geometric average of the rate over a given period."@en ;
	.

fibo-der-rtd-irswp:OvernightRateIndexLeg
	a owl:Class ;
	rdfs:subClassOf fibo-der-rtd-irswp:FloatingInterestRateLeg ;
	rdfs:label "overnight rate index leg" ;
	owl:equivalentClass [
		a owl:Restriction ;
		owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
		owl:someValuesFrom fibo-ind-ir-ir:OvernightRate ;
	] ;
	skos:definition "floating leg in which periodic payments are based on an overnight interest rate index multiplied by the same notional amount on which the payments for the other leg of the swap are based" ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	.

fibo-der-rtd-irswp:PlainVanillaInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-rtd-irswp:FixedFloatSingleCurrencyInterestRateSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-doc:specifies ;
				owl:onClass fibo-der-rtd-irswp:NotionalStepChangeEvent ;
				owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
				owl:onClass fibo-der-rtd-irswp:NotionalStepSchedule ;
				owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "plain vanilla interest rate swap" ;
	skos:definition "fixed-float single currency interest rate swap in which interest payments are netted, the notional principal does not change, and there are no embedded options" ;
	.

fibo-der-rtd-irswp:SingleCurrencyInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-rtd-irswp:InterestRateSwap ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "single currency interest rate swap" ;
	skos:definition "interest rate swap in which the two streams of interest payments are in the same currency" ;
	.

fibo-der-rtd-irswp:ZeroCouponInterestRateSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-rtd-irswp:InterestRateSwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "zero coupon interest rate swap" ;
	skos:definition "interest rate swap in which the fixed rate cash flows are compounded and paid once on the expiration date, rather than periodically; the payments on the other side (which can be based on a floating interest rate or a fixed rate) follow typical swap payment schedules" ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	.

fibo-der-rtd-irswp:hasFirstNotionalStepDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasStartDate ;
	rdfs:label "has first notional step date" ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the initial date in a notional step schedule" ;
	.

fibo-der-rtd-irswp:hasFloatingRateCap
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-dae-dbt:hasInterestRate ;
	rdfs:label "has floating rate cap" ;
	rdfs:range fibo-fbc-dae-dbt:FloatingInterestRate ;
	skos:definition "indicates an optional ceiling (cap) on interest rates on floating rate debts" ;
	cmns-av:explanatoryNote "Rate caps can be viewed as insurance, ensuring that the maximum borrowing rate never exceeds the specified cap level." ;
	.

fibo-der-rtd-irswp:hasFloatingRateFloor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-dae-dbt:hasInterestRate ;
	rdfs:label "has floating rate floor" ;
	rdfs:range fibo-fbc-dae-dbt:FloatingInterestRate ;
	skos:definition "indicates an optional lower bound on interest rates on floating rate debts" ;
	.

fibo-der-rtd-irswp:hasFloatingRateSpread
	a owl:DatatypeProperty ;
	rdfs:label "has floating rate spread" ;
	rdfs:range xsd:decimal ;
	skos:definition "defines the spread rate that can optionally be used to adjust the floating rate" ;
	cmns-av:explanatoryNote "Such adjustments may be added to or subtracted from the floating rate." ;
	.

fibo-der-rtd-irswp:hasLastNotionalStepDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasEndDate ;
	rdfs:label "has last notional step date" ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the final date in a notional step schedule" ;
	.

fibo-der-rtd-irswp:hasRateMultiplier
	a owl:DatatypeProperty ;
	rdfs:label "has rate multiplier" ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates a multiplier applied to the coupon before adding the floating rate spread" ;
	.

fibo-der-rtd-rtd:EconomicRateBasedDerivativeInstrument
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	.

fibo-der-rtd-rtd:EconomicRateObservable
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass fibo-fbc-fi-fi:Underlier ;
	.

fibo-der-rtd-rtd:ForeignExchangeRateObservable
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass fibo-fbc-fi-fi:Underlier ;
	.

fibo-der-rtd-rtd:ForwardRateAgreement
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	.

fibo-der-rtd-rtd:InterestRateDerivativeInstrument
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	.

fibo-der-rtd-rtd:InterestRateObservable
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass fibo-fbc-fi-fi:Underlier ;
	.

fibo-der-rtd-rtd:RateBasedDerivativeInstrument
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	.

fibo-der-rtd-rtd:RateBasedObservable
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass fibo-fbc-fi-fi:Underlier ;
	.

fibo-der-sbd-eqs:DispersionSwapIndexConstituentsLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:DispersionLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-ind-mkt-bas:BasketOfEquities ;
			] ;
		]
		;
	rdfs:label "dispersion swap index constituents leg"@en ;
	skos:definition "dispersion leg whose underlier is a defined set of constituents of a given equity index"@en ;
	.

fibo-der-sbd-eqs:DispersionSwapIndexLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:DispersionLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-ind-mkt-bas:ReferenceIndex ;
			] ;
		]
		;
	rdfs:label "dispersion swap index leg"@en ;
	skos:definition "dispersion leg whose underlier is an equity index"@en ;
	.

fibo-der-sbd-eqs:DividendLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:SimpleReturnLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:onClass fibo-der-sbd-eqs:SpecialDividendLegTerms ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-fbc-fi-fi:EquityInstrument
						fibo-ind-mkt-bas:BasketOfEquities
						fibo-ind-mkt-bas:EquityIndex
					) ;
				] ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:someValuesFrom fibo-der-sbd-eqs:QualifyingDividendPeriod ;
		]
		;
	rdfs:label "dividend leg"@en ;
	skos:definition "floating leg of a dividend swap"@en ;
	cmns-av:usageNote "Note that both dividend swaps and some statistical swaps can be based on a dividend stream/leg."@en ;
	.

fibo-der-sbd-eqs:DividendSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-sbd-eqs:EquitySwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasLeg ;
			owl:someValuesFrom fibo-der-sbd-eqs:DividendLeg ;
		]
		;
	rdfs:label "dividend swap"@en ;
	skos:definition "equity swap that has at least one leg whose underlier is a dividend stream"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	cmns-av:explanatoryNote "Dividend swaps include those that are fixed-term contracts between two parties where one party makes an interest rate payment for each interval and the other party pays the total dividends received as pay-out by a selected underlying asset."@en ;
	.

fibo-der-sbd-eqs:EquityCorrelationSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:CorrelationSwap ,
		fibo-der-sbd-eqs:EquitySwap
		;
	rdfs:label "equity correlation swap"@en ;
	skos:definition "correlation swap that allows one to hedge risks associated with the observed average correlation of a collection of underlying equity products"@en ;
	cmns-av:explanatoryNote "The underlier for the leg can be any of (1) dividend stream for a single stock, (2) change in value for a single share, (3) change in value for a basket of shares, (4) change in value for an index, (5) value of a dividend stream for a basket of shares, or (6) comparison of the change in value of a given share or basket or index against something else - for example, a single share against an index, which is the thing you are cross-correlating with the volatility of the share."@en ;
	.

fibo-der-sbd-eqs:EquityPriceReturnSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:ReturnSwap ,
		fibo-der-sbd-eqs:EquitySwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasReturnLeg ;
			owl:someValuesFrom fibo-der-sbd-eqs:EquityReturnLeg ;
		]
		;
	rdfs:label "equity price return swap"@en ;
	skos:definition "return swap whose return leg underlier is based on equities"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	cmns-av:explanatoryNote "A price return equity swap is similar to a total return swap, except that dividends are not passed through to the buyer)."@en ;
	.

fibo-der-sbd-eqs:EquityReturnLeg
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:ReturnLeg ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-fbc-fi-fi:EquityInstrument
						fibo-ind-mkt-bas:BasketOfEquities
						fibo-ind-mkt-bas:EquityIndex
					) ;
				] ;
			] ;
		]
		;
	rdfs:label "equity return leg"@en ;
	skos:definition "return leg whose income is based on equities"@en ;
	.

fibo-der-sbd-eqs:EquitySwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:Swap ,
		fibo-der-sbd-sbd:EquityDerivative
		;
	rdfs:label "equity swap"@en ;
	skos:definition "swap whose payments are linked to the change in value of underlying equities (e.g. shares, basket of equities or index) or their cashflow(s)"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	cmns-av:explanatoryNote "Equity swaps can be physically or cash settled."@en ;
	.

fibo-der-sbd-eqs:EquityTotalReturnSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:TotalReturnSwap ,
		fibo-der-sbd-eqs:EquitySwap ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-der-drc-swp:hasReturnLeg ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:intersectionOf (
					fibo-der-drc-swp:TotalReturnLeg
					fibo-der-sbd-eqs:EquityReturnLeg
				) ;
			] ;
		]
		;
	rdfs:label "equity total return swap"@en ;
	skos:definition "total return swap whose return leg underlier is based on equities"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	.

fibo-der-sbd-eqs:EquityVarianceSwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:DispersionSwap ,
		fibo-der-sbd-eqs:EquitySwap
		;
	rdfs:label "equity variance swap"@en ;
	skos:definition "dispersion swap in which the parties agree to exchange payments based on the difference between (i) the realized variance of the price changes of a specified equity underlier over a stated observation period and (ii) a fixed amount of variance that is agreed when the contract is executed"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	cmns-av:explanatoryNote "An equity variance swap is a forward swap that uses the variance (being the volatility squared) of an underlying's price movement over a period as the basis for the payoff calculation."@en ;
	.

fibo-der-sbd-eqs:EquityVolatilitySwap
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-swp:DispersionSwap ,
		fibo-der-sbd-eqs:EquitySwap
		;
	rdfs:label "equity volatility swap"@en ;
	skos:definition "dispersion swap that is a forward contract on the variability of movements in the price of its underlying equities"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
	cmns-av:explanatoryNote "An equity volatility swap is a measure of the amount by which an asset's price is expected to fluctuate over a given period of time; it is normally measured by the annual standard deviation of daily price changes."@en ;
	.

fibo-der-sbd-eqs:QualifyingDividendPeriod
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDatePeriod ;
	rdfs:label "qualifying dividend period"@en ;
	skos:definition "date period over which the sum of all qualifying dividends paid by the relevant issuers as identified in the swap terms is calculated"@en ;
	.

fibo-der-sbd-eqs:SpecialDividendLegTerms
	a owl:Class ;
	rdfs:subClassOf fibo-der-drc-bsc:CashflowTerms ;
	rdfs:label "special dividend leg terms"@en ;
	skos:definition "terms that are invoked if special dividend and memorial dividends are applicable"@en ;
	.

fibo-der-sbd-sbd:BasketOfDebtInstruments
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-bsk:BasketOfSecurities ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:comprises ;
				owl:allValuesFrom fibo-fbc-fi-fi:DebtInstrument ;
			] ;
		]
		;
	rdfs:label "basket of debt instruments"@en ;
	skos:definition "basket of securities whose constituents are debt instruments"@en ;
	.

fibo-der-sbd-sbd:CapitalizedLeaseObligationDebtBasket
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-sbd-sbd:BasketOfDebtInstruments ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:comprises ;
				owl:allValuesFrom fibo-fbc-dae-dbt:Lease ;
			] ;
		]
		;
	rdfs:label "capitalized lease obligation debt basket"@en ;
	skos:definition "basket of debt instruments whose constituents are contracts entitling a renter the temporary use of an asset and, in accounting terms, has asset ownership characteristics"@en ;
	cmns-av:explanatoryNote "A capitalized lease obligation basket is increasingly broadly drafted to include indebtedness incurred to finance the purchase, improvement, repair, renewal etc. of property (including the purchase of stock of a person owning such property)."@en ;
	.

fibo-der-sbd-sbd:ContributionDebtBasket
	a owl:Class ;
	rdfs:subClassOf fibo-der-sbd-sbd:BasketOfDebtInstruments ;
	rdfs:label "contribution debt basket"@en ;
	skos:definition "basket of debt instruments that allows a company to incur an amount of indebtedness that is equal to (or in top tier sponsor transactions in the U.S., up to two times) the amount of equity contributed to the group"@en ;
	cmns-av:explanatoryNote
		"A non-guarantor debt basket is often also permitted to be secured by assets of a subsidiary other than the issuer/borrower or guarantors."@en ,
		"In U.S. law, a non-guarantor debt basket is a shared basket in an amount not to exceed the greater of $150,000,000 and 20% of Consolidated EBITDA for the most recently ended Test Period at any time outstanding that may be used for (A) the incurrence of certain Indebtedness by Restricted Subsidiaries that are not Loan Parties under Sections 6.01(a)(xii), 6.01(a)(xix) and 6.01(a)(xx) and (B) Secured Cash Management Obligations of any Restricted Subsidiary that is not a Loan Party."@en
		;
	.

fibo-der-sbd-sbd:CreditFacilityDebtBasket
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-sbd-sbd:BasketOfDebtInstruments ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:comprises ;
				owl:allValuesFrom fibo-fbc-dae-dbt:CreditFacility ;
			] ;
		]
		;
	rdfs:label "credit facility debt basket"@en ;
	skos:definition "basket of securities whose constituents are credit agreements that allow the borrower to periodically take out money over an extended period of time rather than reapplying for a loan every time they need funds"@en ;
	cmns-av:explanatoryNote "The credit facility debt basket consists of a number of credit facilities including revolving loans/line of credit, committed facilities, letters of credit and most retail credit accounts. The first port of call for issuers is the credit facility debt basket. In addition to the fixed dollar (or euro) amounts, credit facility debt baskets in senior secured notes and indentures typically provide for a grower component that is the greater of the fixed dollar/euro amount and a percentage of total assets, total tangible assets or EBITDA."@en ;
	.

fibo-der-sbd-sbd:DebtInstrumentDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-sbd-sbd:SecurityBasedDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-der-sbd-sbd:BasketOfDebtInstruments
						fibo-ind-mkt-bas:BasketOfCreditRisks
						fibo-ind-mkt-bas:CreditIndex
						fibo-sec-dbt-dbti:TradableDebtInstrument
					) ;
				] ;
			] ;
		]
		;
	rdfs:label "debt instrument derivative" ;
	skos:definition "security-based derivative whose underlier is a debt observable" ;
	.

fibo-der-sbd-sbd:EquityDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-sbd-sbd:SecurityBasedDerivative ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-fbc-fi-fi:EquityInstrument
						fibo-ind-mkt-bas:BasketOfEquities
						fibo-ind-mkt-bas:EquityIndex
					) ;
				] ;
			] ;
		]
		;
	rdfs:label "equity derivative" ;
	skos:definition "security-based derivative whose underlier is based on equities (e.g. shares, basket of equities or index) or their cashflow(s)" ;
	.

fibo-der-sbd-sbd:GeneralDebtBasket
	a owl:Class ;
	rdfs:subClassOf fibo-der-sbd-sbd:BasketOfDebtInstruments ;
	rdfs:label "general debt basket"@en ;
	skos:definition "basket of debt instruments that provides additional capacity for potential funding and does not require the proceeds to be used for any particular purpose"@en ;
	cmns-av:explanatoryNote "The general debt basket has increasingly become a basket for additional secured debt. Lenders providing funding to companies need to carefully consider whether any previous debt incurred by the company using this basket has reduced the available capacity."@en ;
	.

fibo-der-sbd-sbd:IncrementalFacilityDebtBasket
	a owl:Class ;
	rdfs:subClassOf fibo-der-sbd-sbd:CreditFacilityDebtBasket ;
	rdfs:label "incremental facility debt basket"@en ;
	skos:definition "basket of credit facilities whose constituents are extensible, allowing companies to borrow an additional term loan or revolving credit facility (or increase the commitments applicable thereto) under the same credit agreement subject to certain parameters"@en ;
	cmns-av:explanatoryNote "The incremental debt basket is available to borrowers and guarantors only; it cannot be used by non-guarantor entities to raise indebtedness. The size of the incremental debt basket varies depending on the size and creditworthiness of the credit group. The principle of a basket consists of allowing the borrower, up to a maximum determined amount, to make restricted payments, disposals or investments, or take on incremental debt. Commonly, a basket is expressed as subject to restrictions based on a fixed ('hard cap') amount (e.g., may not exceed EUR 5,000,000)."@en ;
	cmns-av:synonym "builder basket"@en ;
	.

fibo-der-sbd-sbd:LocalLinesOfCreditDebtBasket
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-sbd-sbd:BasketOfDebtInstruments ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:comprises ;
				owl:allValuesFrom fibo-fbc-dae-dbt:RevolvingLineOfCredit ;
			] ;
		]
		;
	rdfs:label "local lines of credit debt basket"@en ;
	skos:definition "basket of debt instruments that may be relevant for companies with international operations, often permitting debt to be incurred by a non-guarantor restricted subsidiary"@en ;
	.

fibo-der-sbd-sbd:Non-GuarantorDebtBasket
	a owl:Class ;
	rdfs:subClassOf fibo-der-sbd-sbd:BasketOfDebtInstruments ;
	rdfs:label "non-guarantor debt basket"@en ;
	skos:definition "basket of debt instruments that include a provision allowing certain subsidiaries within a corporate group, which are not part of the loan guarantee, to incur a specified amount of indebtedness"@en ;
	cmns-av:explanatoryNote
		"A non-guarantor debt basket is often also permitted to be secured by assets of a subsidiary other than the issuer/borrower or guarantors."@en ,
		"In U.S. law, a non-guarantor debt basket is a shared basket in an amount not to exceed the greater of $150,000,000 and 20% of Consolidated EBITDA for the most recently ended Test Period at any time outstanding that may be used for (A) the incurrence of certain Indebtedness by Restricted Subsidiaries that are not Loan Parties under Sections 6.01(a)(xii), 6.01(a)(xix) and 6.01(a)(xx) and (B) Secured Cash Management Obligations of any Restricted Subsidiary that is not a Loan Party."@en
		;
	.

fibo-der-sbd-sbd:RatioDebtBasket
	a owl:Class ;
	rdfs:subClassOf fibo-der-sbd-sbd:BasketOfDebtInstruments ;
	rdfs:label "ratio debt basket"@en ;
	skos:definition "basket of debt instruments whose constituents are specified based on a leverage ratio based on total debt rather than only secured debt"@en ;
	cmns-av:explanatoryNote "The ratio basket provides different ratio tests depending on the type of indebtedness being incurred (for example, first lien leverage ratio in respect of first lien indebtedness, senior secured leverage ratio in respect of indebtedness secured by a junior lien and a total net leverage ratio or interest coverage ratio in respect of unsecured indebtedness). A ratio basket would typically allow the borrower to incur debt secured on a senior secured basis subject to a maximum senior secured leverage ratio and unsecured debt subject to a maximum total leverage ratio."@en ;
	.

fibo-der-sbd-sbd:SecurityBasedDerivative
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:DerivativeInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-fbc-fi-fi:Security
						fibo-ind-mkt-bas:ReferenceIndex
						fibo-sec-sec-bsk:BasketOfSecurities
					) ;
				] ;
			] ;
		]
		;
	rdfs:label "security-based derivative"@en ;
	skos:definition "derivative instrument whose underlier is based on a security, including collections of securities and indices based on securities" ;
	.

