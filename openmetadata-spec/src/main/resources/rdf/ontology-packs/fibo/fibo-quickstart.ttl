	skos:definition "market category classifier indicating that the reporting party believes that the market classifier is something other than any of the given market categories" ;
	fibo-fnd-rel-rel:hasTag "OTHR" ;
	cmns-av:adaptedFrom "https://www.iso20022.org/sites/default/files/2021-12/ISO10383_MIC_Release_2_0_Factsheet.pdf" ;
