		cmns-ra:RegistrationAuthority
		;
	rdfs:label "federal deposit insurer and regulator" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/USRegulatoryAgencies/> ;
	rdfs:seeAlso <https://www.fdic.gov/> ;
	skos:definition "regulatory agency and registration authority role of the Federal Deposit Insurance Corporation (FDIC)" ;
	cmns-org:manages fibo-fbc-fct-usjrga:FDICInstitutionDirectory ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-usjrga:FederalDepositInsuranceCorporation ;
	.

fibo-fbc-fct-usjrga:FederalFinancialInstitutionsExaminationCouncil
	a
		owl:NamedIndividual ,
		fibo-be-ge-ge:GovernmentAgency ,
		fibo-fbc-fct-usjrga:FederalGovernmentEntity
		;
	rdfs:label "Federal Financial Institutions Examination Council" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/USRegulatoryAgencies/> ;
	skos:definition "FFIEC, a formal interagency body empowered to prescribe uniform principles, standards, and report forms for the federal examination of financial institutions by the Board of Governors of the Federal Reserve System (FRB), the Federal Deposit Insurance Corporation (FDIC), the National Credit Union Administration (NCUA), the Office of the Comptroller of the Currency (OCC), and the Consumer Financial Protection Bureau (CFPB), and to make recommendations to promote uniformity in the supervision of financial institutions" ;
	cmns-av:abbreviation "FFIEC" ;
	cmns-av:explanatoryNote "The Federal Financial Institutions Examination Council (FFIEC) was established on March 10, 1979, pursuant to title X of the Financial Institutions Regulatory and Interest Rate Control Act of 1978 (FIRA), Public Law 95-630. In 1989, title XI of the Financial Institutions Reform, Recovery and Enforcement Act of 1989 (FIRREA) established The Appraisal Subcommittee (ASC) within the Examination Council." ;
	cmns-col:hasMember
		fibo-fbc-fct-usjrga:ConsumerFinancialProtectionBureau ,
		fibo-fbc-fct-usjrga:FederalDepositInsuranceCorporation ,
		fibo-fbc-fct-usjrga:FederalReserveBoard ,
		fibo-fbc-fct-usjrga:NationalCreditUnionAdministration ,
		fibo-fbc-fct-usjrga:OfficeOfTheComptrollerOfTheCurrency
		;
	cmns-col:isPartOf fibo-be-ge-usj:UnitedStatesGovernment ;
	cmns-org:hasWebsite "http://www.ffiec.gov/"^^xsd:anyURI ;
	cmns-rga:hasJurisdiction fibo-be-ge-usj:UnitedStatesJurisdiction ;
	.

