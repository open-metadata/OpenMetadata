fibo-be-ge-usj:DistrictOfColumbiaEntity
	a
		owl:NamedIndividual ,
		fibo-be-ge-ge:RegionalSovereignty
		;
	rdfs:label "District of Columbia entity" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/USGovernmentEntitiesAndJurisdictions/> ;
	rdfs:seeAlso
		<http://dc.gov/> ,
