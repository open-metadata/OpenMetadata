fibo-ind-ir-ir:TwoMonths
	a
		owl:NamedIndividual ,
		cmns-dt:ExplicitDuration
		;
	rdfs:label "two months" ;
	skos:definition "duration of exactly two months, regardless of the length in days of a given calendar month, but typically 30 days" ;
	cmns-dt:hasDurationValue "P2M" ;
	.

fibo-ind-ir-ir:TwoYears
	a
		owl:NamedIndividual ,
		cmns-dt:ExplicitDuration
		;
	rdfs:label "two years" ;
	skos:definition "duration of exactly two years" ;
	cmns-dt:hasDurationValue "P2Y" ;
	.

fibo-ind-ir-ir:hasRateResetTimeOfDay
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDateTime ;
	rdfs:label "has rate reset time of day" ;
	rdfs:range cmns-dt:DateTime ;
	skos:definition "indicates the time of day when a change in a benchmark rate is published, typically the same time every business day" ;
	.

fibo-ind-ir-ir:hasReferenceCurrency
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasCurrency ;
	rdfs:label "has reference currency" ;
	rdfs:range fibo-fnd-acc-cur:Currency ;
	skos:definition "relates something to the currency it is based on" ;
	.

fibo-ind-ir-ir:hasTenor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has tenor" ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "indicates the length of time for which a given rate, such as an interbank rate, exchange rate, other market rate is quoted, or a debt instrument has remaining prior to maturity or expiration" ;
	cmns-av:explanatoryNote "The tenor of most financial instruments declines over time, while the maturity remains constant. Risk associated with a given asset tends to decline with the reduction of the time remaining to maturity. The tenor of an interest rate swap can also refer to the frequency with which coupon payments are exchanged." ;
	.

fibo-ind-ir-mdp:EuropeanMoneyMarketsInstituteBenchmarkPublisher
	a
		owl:NamedIndividual ,
		fibo-ind-ir-ir:InterestRateAuthority
		;
	rdfs:label "European Money Markets Institute (EMMI) benchmark publisher" ;
	skos:definition "individual representing the European Money Markets Institute (EMMI) functional entity that is an international financial information publisher, responsible for the publication of euro-based benchmarks, including Euribor" ;
	cmns-av:adaptedFrom "http://www.emmi-benchmarks.eu/"^^xsd:anyURI ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-eufseind:EuropeanMoneyMarketsInstitute ;
	.

fibo-ind-ir-mdp:FederalReserveBoardH.15RateResetTimeOfDay
	a
		owl:NamedIndividual ,
		fibo-fbc-dae-dbt:RateResetTimeOfDay
		;
	rdfs:label "Federal Reserve Board H.15 rate reset time of day" ;
	skos:definition "the time of day that the Federal Reserve Board publishes Selected Interest Rates (Daily) in Schedule H.15" ;
	fibo-fnd-dt-bd:hasBusinessDayConvention fibo-fbc-fct-bci:NewYorkFederalReserveBusinessDay ;
	cmns-av:adaptedFrom "https://www.federalreserve.gov/releases/h15/"^^xsd:anyURI ;
	cmns-dt:hasTimeValue "T16:15:00" ;
	cmns-loc:hasBusinessCenter fibo-fbc-fct-bci:New_York ;
	.

fibo-ind-ir-mdp:FenicsMarketData
	a
		owl:NamedIndividual ,
		fibo-be-fct-pub:MarketDataProvider
		;
	rdfs:label "Fenics Market Data" ;
	skos:definition "Fenics Market Data functional entity that is a financial service and market data provider and division of BGC Partners" ;
	fibo-fnd-rel-rel:wasFormerlyKnownAs "BGCantor Market Data, L.P." ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:BGCPartnersInc-US-DE ;
	.

fibo-ind-ir-mdp:ICEBenchmarkPublisher
	a
		owl:NamedIndividual ,
		fibo-ind-ir-ir:InterestRateAuthority
		;
	rdfs:label "ICE benchmark publisher" ;
	skos:definition "the ICE Benchmark Administration functional entity that is an international financial information publisher, responsible for the publication of ICE LIBOR, ICE Swap Rate, LBMA Gold Price and ISDA SIMM benchmarks" ;
	cmns-av:adaptedFrom "https://www.theice.com/index"^^xsd:anyURI ;
	cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:ICEBenchmarkAdministration ;
	.

fibo-ind-ir-mdp:LSEGFinancialSolutionsAsMarketDataProvider
	a
		owl:NamedIndividual ,
		fibo-be-fct-pub:MarketDataProvider
		;
	rdfs:label "LSEG Financial Solutions as market data provider" ;
	skos:definition "financial market data provider role of the London Stock Exchange Group (LSEG)'s subsidiary, LSEG Financial Solutions" ;
	cmns-av:explanatoryNote "Note that LSEG Financial Group was formerly known as Refinitiv, and before that, the market data division of Thomson Reuters." ;
	.

fibo-ind-ir-mdp:ReferenceBanks
	a
		owl:NamedIndividual ,
		fibo-be-fct-pub:MarketDataProvider ,
		cmns-col:Collection
		;
	rdfs:label "reference banks" ;
	skos:definition "market data provider of interest rate benchmarks representing a group of one or more banks that either individually, or in aggregate, provide quoted rates that contribute to the benchmark" ;
	cmns-av:explanatoryNote "With respect to LIBOR, for example, the Bank of England will request the principal London office of each of the Reference Banks to provide a quotation of its rate. If at least two such quotations are provided, the rate for such date will be the arithmetic mean of the quotations. If fewer than two quotations are provided as requested, the rate for such date will be the arithmetic mean of the rates quoted by major banks in New York City selected by the Bank, at approximately 11:00 a.m. New York City time for loans in U.S. Dollars to leading European banks for such Interest Period and in an amount approximately equal to the amount requested LIBOR-Reference Banks Loan." ;
	.

fibo-ind-ir-mdp:ReferenceDealers
	a
		owl:NamedIndividual ,
		fibo-be-fct-pub:MarketDataProvider ,
		cmns-col:Collection
		;
	rdfs:label "reference dealers" ;
	skos:definition "market data provider of interest rate benchmarks representing a group of one or more swap dealers that either individually, or in aggregate, provide quoted rates that contribute to the benchmark" ;
	.

fibo-ind-ir-mdp:SwapMarker
	a
		owl:NamedIndividual ,
		fibo-be-fct-pub:MarketDataProvider
		;
	rdfs:label "Swap Marker" ;
	skos:definition "market data provider of interest rate benchmarks" ;
	.

fibo-ind-ir-mdp:Tradition
	a
		owl:NamedIndividual ,
		fibo-be-fct-pub:MarketDataProvider ,
		fibo-fbc-pas-fpas:FinancialServiceProvider
		;
	rdfs:label "Tradition" ;
	skos:definition "Tradition functional entity that is a financial service and market data provider and division of Compagnie Financiere Tradition" ;
	.

fibo-ind-mkt-bas:BasketOfCreditRisks
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:WeightedBasket ,
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-ind-mkt-bas:CreditIndexConstituent ;
		]
		;
	rdfs:label "basket of credit risks"@en ;
	skos:definition "basket of instruments, legal entities, or a combination thereof collected for the purpose of analyzing risk"@en ;
	cmns-av:explanatoryNote "Note that the risk related to a given constituent may be calculated based on either (1) the overall credit risk associated with the entity or, (2) the combined risk associated with an entity and the specific instrument identified, or (3) risk associated with the instrument on its own. Criteria for constituents is based on sectors (emerging market, financial, sovereign, etc), spread range (investment grade, non-investment grade), or asset type (loan, bond, mortgage-backed, asset-backed), second criteria is based on maturity of protection (2,3,5,7,10 yrs). Markit manages over 2000 CDS indexes, for example."@en ;
	.

fibo-ind-mkt-bas:BasketOfEquities
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-bsk:BasketOfSecurities ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-sec-sec-bsk:SecuritiesBasketConstituent
					[
						a owl:Restriction ;
						owl:onProperty cmns-col:comprises ;
						owl:allValuesFrom fibo-sec-eq-eq:ListedShare ;
					]
				) ;
			] ;
		]
		;
	rdfs:label "basket of equities"@en ;
	skos:definition "basket of securities whose constituents are listed shares"@en ;
	.

fibo-ind-mkt-bas:CapitalizationBasedWeightingFunction
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:WeightingFunction ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-mkt-bas:hasMarketCapitalization ;
			owl:someValuesFrom fibo-ind-mkt-bas:MarketCapitalization ;
		]
		;
	rdfs:label "capitalization-based weighting function"@en ;
	skos:definition "weighting function derived from the relative market capitalization (share price times the number of shares outstanding) of the companies tracked by an index"@en ;
	.

fibo-ind-mkt-bas:CreditIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-mkt-bas:ReferenceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-ind-mkt-bas:BasketOfCreditRisks ;
		]
		;
	rdfs:label "credit index"@en ;
	skos:definition "reference index that is a function of credit events that change the value of an underlying portfolio"@en ;
	cmns-av:explanatoryNote "Such an index does not necessarily reference a static portfolio, as there may be provisions for replacing defaulted securities on which the index depends."@en ;
	.

fibo-ind-mkt-bas:CreditIndexConstituent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:WeightedBasketConstituent ,
		fibo-fnd-dt-fd:DatedCollectionConstituent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasCurrency ;
			owl:someValuesFrom fibo-fnd-acc-cur:Currency ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:refersTo ;
			owl:someValuesFrom fibo-fbc-dae-cre:CreditEvent ;
		]
		;
	rdfs:label "credit index constituent"@en ;
	owl:equivalentClass [
		a owl:Restriction ;
		owl:onProperty cmns-col:isConstituentOf ;
		owl:someValuesFrom fibo-ind-mkt-bas:BasketOfCreditRisks ;
	] ;
	skos:definition "constituent of a basket of credit risks"@en ;
	.

fibo-ind-mkt-bas:EquityIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-ind-mkt-bas:ReferenceIndex ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-ind-mkt-bas:BasketOfEquities ;
		]
		;
	rdfs:label "equity index"@en ;
	skos:definition "benchmark whose constituents are exclusively equity instruments"@en ;
	.

fibo-ind-mkt-bas:MarketCapitalization
	a
		owl:NamedIndividual ,
		owl:Class
		;
	rdfs:subClassOf
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-ind-mkt-bas:hasMarketCapitalizationValue ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryAmount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-eq-eq:hasSharesOutstanding ;
			owl:someValuesFrom xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-sec-eq-eq:ShareIssuer ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasObservedDateTime ;
			owl:someValuesFrom cmns-dt:CombinedDateTime ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-sec-eq-eq:PricePerShare ;
		]
		;
	rdfs:label "market capitalization"@en ;
	skos:definition "expression representing the perceived value of a company as determined by the stock market at a specific point in time"@en ;
	cmns-av:synonym "market cap"@en ;
	cmns-qtu:describesActualExpression "number of shares outstanding x price per share"@en ;
	.

fibo-ind-mkt-bas:ReferenceIndex
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:ScopedMeasure ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasPeriodicity ;
			owl:allValuesFrom fibo-fnd-dt-fd:RecurrenceInterval ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-fnd-arr-cls:IndustrySectorClassifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-sec-sec-cls:AssetClass ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReleaseDate ;
			owl:onClass cmns-dt:Date ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasReleaseDateTime ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasReportingPeriod ;
			owl:onClass cmns-dt:ExplicitDatePeriod ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-fbc-pas-fpas:WeightedBasket ;
		]
		;
	rdfs:label "reference index"@en ;
	skos:definition "measure of change in the value of the contents of a basket over a given period of time"@en ;
	cmns-av:explanatoryNote "An index is a function based on a set of structured calculations with respect to a basket of credit risks, financial instruments or other indices over time. Analysis may be computed based on historical values, projected values, etc."@en ;
	cmns-av:synonym "benchmark"@en ;
	.

fibo-ind-mkt-bas:hasDebtRanking
	a owl:DatatypeProperty ;
	rdfs:label "has debt ranking"@en ;
	rdfs:domain fibo-ind-mkt-bas:CreditIndexConstituent ;
	rdfs:range xsd:string ;
	skos:definition "indicates the ranking of this debt instrument with respect to the credit index as a whole"@en ;
	.

fibo-ind-mkt-bas:hasIndexName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:hasFormalName ;
	rdfs:label "has index name"@en ;
	rdfs:domain fibo-ind-mkt-bas:ReferenceIndex ;
	rdfs:range xsd:string ;
	skos:definition "specifies a formal name for the index"@en ;
	.

fibo-ind-mkt-bas:hasIndexValue
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has index value" ;
	rdfs:range xsd:decimal ;
	skos:definition "specifies the value of a given index as of the release date" ;
	.

fibo-ind-mkt-bas:hasMarketCapitalization
	a owl:ObjectProperty ;
	rdfs:label "has market capitalization"@en ;
	rdfs:domain fibo-sec-eq-eq:ShareIssuer ;
	rdfs:range fibo-ind-mkt-bas:MarketCapitalization ;
	skos:definition "indicates the market capitalization of some issuer as of some date"@en ;
	.

fibo-ind-mkt-bas:hasMarketCapitalizationValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has market capitalization value"@en ;
	rdfs:domain fibo-ind-mkt-bas:MarketCapitalization ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the monetary amount representing the market capitalization of some issuer as of some date"@en ;
	.

fibo-ind-mkt-bas:hasOriginalNotionalValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasNotionalAmount ;
	rdfs:label "has original notional value"@en ;
	rdfs:domain fibo-ind-mkt-bas:CreditIndex ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the notional amount represented by the index when it is first constituted"@en ;
	.

fibo-ind-mkt-bas:hasPremium
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has premium"@en ;
	rdfs:domain fibo-ind-mkt-bas:CreditIndex ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates a premium payable for a contract based on the index"@en ;
	.

fibo-ind-mkt-bas:hasSpreadRange
	a owl:DatatypeProperty ;
	rdfs:label "has spread range"@en ;
	rdfs:domain fibo-ind-mkt-bas:CreditIndex ;
	rdfs:range xsd:string ;
	skos:definition "the range of credit spread for the constituents of the index"@en ;
	.

fibo-ind-mkt-bas:hasUpFrontFee
	a owl:ObjectProperty ;
	rdfs:label "has up front fee"@en ;
	rdfs:domain fibo-ind-mkt-bas:CreditIndex ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "specifies a fee payable by any party that wishes to participate in a contract based on the index after the start of its life"@en ;
	.

fibo-loan-ln-ln:ClosedEndCredit
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-dae-dbt:CreditAgreement ;
	rdfs:label "closed-end credit" ;
	owl:disjointWith fibo-loan-ln-ln:OpenEndCredit ;
	skos:definition "credit agreement in which the loan principal cannot be increased after funds are dispersed in full when the loan closes" ;
	cmns-av:explanatoryNote "The loan may require regular payments that pay down principal periodically, or it may require the full payment of principal at maturity." ;
	.

fibo-loan-ln-ln:CollateralizedLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:SecuredLoan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isCollateralizedBy ;
			owl:someValuesFrom fibo-fbc-dae-dbt:Collateral ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isPrimaryContractFor ;
			owl:someValuesFrom fibo-fnd-agr-ctr:CollateralAgreement ;
		]
		;
	rdfs:label "collateralized loan"@en ;
	skos:definition "secured loan that is secured with cash or other acceptable collateral (real property, securities or other assets) provided by the borrower as specified in the collateral agreement"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
	.

fibo-loan-ln-ln:Comaker
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractThirdParty ;
	rdfs:label "co-maker" ;
	skos:definition "party that signs a borrower's promissory note, providing additional security and potentially improving the quality of the debt" ;
	cmns-av:explanatoryNote
		"Differences between a co-maker and co-borrower include: (1) a co-maker is not listed on the title of the asset to which the loan applies, (2) a co-maker does not have any legal ownership rights to the asset, and (3) the co-maker does not make regular payments on the loan unless the primary borrower(s) fails to do so." ,
		"The co-maker's liability is similar to that of an endorser or guarantor, but with additional risk/exposure, as they can be compelled to honor the debt much sooner and regardless of whether certain conditions are met."
		;
	cmns-av:synonym
		"comaker" ,
		"cosigner"
		;
	.

fibo-loan-ln-ln:CombinedLoanToValueRatio
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:PercentageMonetaryAmount ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-oac-own:Asset ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:refersTo ;
			owl:someValuesFrom fibo-fnd-arr-asmt:Appraisal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fnd-arr-asmt:AppraisedValue ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-loan-ln-ln:TotalOutstandingPrincipal ;
		]
		;
	rdfs:label "combined loan-to-value ratio" ;
	skos:definition "ratio of the total amount of debt that is secured by the asset(s) and the appraised value of the asset(s) securing the financing" ;
	cmns-av:explanatoryNote "This is particularly important for secondary loans, or for refinancing that combines outstanding loans against a given asset. Lenders use this ratio to evaluate the risk of extending a loan to a borrower(s) in cases where multiple loans are involved." ;
	.

fibo-loan-ln-ln:FeeSimpleOwnershipInterest
	a
		owl:NamedIndividual ,
		fibo-loan-ln-ln:OwnershipInterest
		;
	rdfs:label "fee-simple ownership interest" ;
	skos:definition "classification indicating the most common type of ownership, covering an indefinite ownership period and the freedom to transfer said ownership as desired" ;
	cmns-av:explanatoryNote
		"Fee simple is the term used to represent the maximum ownership interest in real property that is allowed under the law. It can be referred to as 'complete ownership'." ,
		"The asset may still be subject to government regulations such as property taxes, and the owner can place voluntary encumbrances on the real estate including its use as collateral for a loan. In the case of a mortgage, fee simple can be contrasted with lease ownership, in which case the owners have complete access to the land, but they do not own it. Owners of single-family residences typically have fee simple ownership, but condo and many townhouse owners do not, as they own their individual unit but not the land on which the development is built."
		;
	cmns-av:synonym "complete ownership" ;
	.

fibo-loan-ln-ln:FractionalOwnershipInterest
	a
		owl:NamedIndividual ,
		fibo-loan-ln-ln:OwnershipInterest
		;
	rdfs:label "fractional ownership interest" ;
	skos:definition "classification indicating that several parties may share in, and mitigate the risk of, ownership of a high-value tangible asset" ;
	.

fibo-loan-ln-ln:GuaranteedLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:SecuredLoan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-gty:hasGuarantor ;
			owl:someValuesFrom fibo-fbc-dae-gty:Guarantor ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-dae-gty:Guaranty ;
		]
		;
	rdfs:label "guaranteed loan"@en ;
	skos:definition "loan that is secured with respect to repayment of principal and interest by guaranty"@en ;
	cmns-av:explanatoryNote
		"A loan guarantee is a promise by one party to assume the debt obligation of a borrower if that borrower defaults. A guarantee can be limited or unlimited, making the guarantor liable for only a portion or all of the debt."@en ,
		"In the U.S., the term 'guaranteed loan' typically refers to a loan that is backed by a federal agency, such as the Department of Veterans Affairs or the Small Business Administration. Student loans may be guaranteed by the Student Loan Marketing Association."@en
		;
	.

fibo-loan-ln-ln:IndividualPaymentTransaction
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:IndividualTransaction ,
		fibo-fnd-pas-psch:Payment
		;
	rdfs:label "individual payment transaction"@en ;
	skos:definition "actual payment of principal, interest, fees, or other related amounts towards fulfillment of a debt obligation"@en ;
	.

fibo-loan-ln-ln:LenderLienPosition
	a owl:Class ;
	rdfs:subClassOf cmns-cls:Classifier ;
	rdfs:label "lender lien position" ;
	skos:definition "classifier indicating whether the lender has the primary lien position with respect to an asset used as collateral for the loan" ;
	.

fibo-loan-ln-ln:Loan
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditAgreementRepaidPeriodically ,
		fibo-fbc-fi-fi:DebtInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-gty:hasGuarantor ;
			owl:onClass fibo-fbc-dae-gty:Guarantor ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:hasTotalClosingCosts ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:hasTotalPointsAndFees ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasThirdParty ;
			owl:onClass fibo-fnd-agr-ctr:ContractThirdParty ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-loan-ln-ln:LenderLienPosition ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasCorrespondingAccount ;
			owl:onClass fibo-loan-ln-ln:LoanSpecificCustomerAccount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:isServicedBy ;
			owl:onClass fibo-loan-ln-ln:Servicer ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasMaturityDate ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:hasNegativeAmortization ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:boolean ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:isInterestOnly ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:boolean ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:hasPrincipalAmount ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryAmount ;
		]
		;
	rdfs:label "loan" ;
	skos:definition "debt instrument whereby one party extends money or credit to another party (or parties) with the understanding that the borrowed money will be repaid according to the terms of the contract" ;
	.

fibo-loan-ln-ln:LoanPaymentSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-psch:PaymentSchedule ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasAnticipatedNumberOfPayments ;
			owl:someValuesFrom xsd:positiveInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-loan-ln-ln:LoanSpecificCustomerAccount ;
		]
		;
	rdfs:label "loan payment schedule" ;
	skos:definition "regular or explicit (ad hoc) payment schedule associated with a given loan-specific account" ;
	cmns-av:explanatoryNote "Loan payment schedules may or may not be amortization schedules, i.e., they may or may not include principal." ;
	.

fibo-loan-ln-ln:LoanSpecificCustomerAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:CustomerAccount ,
		fibo-fbc-pas-caa:LoanOrCreditAccount ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:hasLoanBalance ;
			owl:onClass fibo-fbc-pas-caa:Balance ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-psch:hasPaymentSchedule ;
			owl:onClass fibo-loan-ln-ln:LoanPaymentSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:hasPaymentHistory ;
			owl:onClass fibo-loan-ln-ln:PaymentHistory ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:relatesTo ;
			owl:someValuesFrom fibo-loan-ln-ln:Loan ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isHeldBy ;
			owl:someValuesFrom fibo-fbc-dae-dbt:Borrower ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fbc-dae-dbt:Lender
					fibo-loan-ln-ln:Servicer
				) ;
			] ;
		]
		;
	rdfs:label "loan-specific customer account" ;
	skos:definition "account held by the borrower associated with a specific loan" ;
	.

fibo-loan-ln-ln:LoanToValueRatio
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:PercentageMonetaryAmount ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-oac-own:Asset ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:refersTo ;
			owl:someValuesFrom fibo-fnd-arr-asmt:Appraisal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fbc-dae-dbt:Principal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fnd-arr-asmt:AppraisedValue ;
		]
		;
	rdfs:label "loan-to-value ratio" ;
	skos:definition "ratio, expressed as a percentage, between the principal amount of the loan and the appraised value of the asset securing the financing" ;
	cmns-av:abbreviation "LTV" ;
	.

fibo-loan-ln-ln:OpenEndCredit
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasCreditLimit ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "open-end credit" ;
	skos:definition "credit agreement that may be extended up to an agreed credit limit and paid down at any time within the period of the line, if any, and on which interest is charged only on the outstanding balance" ;
	skos:example "Credit card and overdraft lines of credit are among the most widely used forms of open-end credit." ;
	cmns-av:explanatoryNote "There is a credit limit most of the time, with exceptions including reverse mortgages with tenure payment. The borrower has the option of paying off the outstanding balance, without penalty, or making installment payments." ;
	cmns-av:synonym
		"charge account credit" ,
		"revolving credit"
		;
	.

fibo-loan-ln-ln:OwnershipInterest
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fnd-oac-own:Ownership ;
		]
		;
	rdfs:label "ownership interest" ;
	skos:definition "classifier indicating the nature of the applicant's or borrower's ownership or leasehold interest in an asset used as collateral for the loan" ;
	cmns-av:usageNote "Note that there are a number of variations for ownership interest that represent 'corner cases', including jurisdiction-specific variants, which can be added as needed for specific applications." ;
	.

fibo-loan-ln-ln:PaymentHistory
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:TransactionRecord ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:appliesToAccount ;
			owl:someValuesFrom fibo-loan-ln-ln:LoanSpecificCustomerAccount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:hasIndividualPayment ;
			owl:someValuesFrom fibo-loan-ln-ln:IndividualPaymentTransaction ;
		]
		;
	rdfs:label "payment history" ;
	skos:definition "record of actual payments of principal, interest, and other related amounts made by a borrower to a lender or servicer in order to fulfill their re-payment obligation" ;
	.

fibo-loan-ln-ln:PrepaymentTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:PrincipalRepaymentTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-ln-ln:hasPrePaymentPenaltyTerm ;
			owl:someValuesFrom cmns-dt:ExplicitDuration ;
		]
		;
	rdfs:label "pre-payment terms"@en ;
	skos:definition "principal repayment terms related to payment of the loan prior to maturity"@en ;
	cmns-av:explanatoryNote "Prepayment may or may not involve refinancing with the same lender. Prepayment terms include any prepayment penalty period, penalty amount and whether or not there is provision for waiver of the penalty, and any conditions related to making additional payments or payments over and above the expected installment payment over the lifetime of the loan."@en ;
	.

fibo-loan-ln-ln:PrimaryLienPosition
	a
		owl:NamedIndividual ,
		fibo-loan-ln-ln:LenderLienPosition
		;
	rdfs:label "primary lien position" ;
	skos:definition "first position in the order of seniority in which the law recognizes lenders' claims against a property"@en ;
	cmns-av:synonym "primary lien priority" ;
	.

fibo-loan-ln-ln:SecuredLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:Loan ,
		[
			a owl:Class ;
			owl:unionOf (
				[
					a owl:Restriction ;
					owl:onProperty cmns-col:comprises ;
					owl:someValuesFrom fibo-fbc-dae-dbt:SecurityAgreement ;
				]
				[
					a owl:Restriction ;
					owl:onProperty cmns-col:comprises ;
					owl:someValuesFrom fibo-fbc-dae-gty:Guaranty ;
				]
			) ;
		]
		;
	rdfs:label "secured loan" ;
	owl:disjointWith fibo-loan-ln-ln:UnsecuredLoan ;
	skos:definition "loan in which the borrower pledges some asset via a security agreement as collateral for the loan, or that is secured via third-party guarantee" ;
	.

fibo-loan-ln-ln:Servicer
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:FinancialServiceProvider ,
		fibo-fnd-agr-ctr:ContractThirdParty
		;
	rdfs:label "servicer" ;
	skos:definition "party that collects principal and interest payments on behalf of the lender" ;
	cmns-av:explanatoryNote "In cases where a loan has been securitized, the servicer is also responsible for forwarding payments to investors, filing reports with credit-rating agencies and investors, and so forth." ;
	.

fibo-loan-ln-ln:SubordinateLienPosition
	a
		owl:NamedIndividual ,
		fibo-loan-ln-ln:LenderLienPosition
		;
	rdfs:label "subordinate lien position" ;
	skos:definition "secondary or lower position in the order of seniority in which the law recognizes lenders' claims against a property"@en ;
	.

fibo-loan-ln-ln:TotalOutstandingPrincipal
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-dae-dbt:Principal ;
	rdfs:label "total outstanding principal" ;
	skos:definition "the principal balance of all loans secured by the property" ;
	.

fibo-loan-ln-ln:UnsecuredLoan
	a owl:Class ;
	rdfs:subClassOf fibo-loan-ln-ln:Loan ;
	rdfs:label "unsecured loan" ;
	skos:definition "loan granted based on the strength of the borrower's credit history or reputation in the community" ;
	.

fibo-loan-ln-ln:hasBalloonPayment
	a owl:DatatypeProperty ;
	rdfs:label "has balloon payment"@en ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the contractual terms include or would have included repayment of the outstanding principal sum at the end of a loan period, prior to which only partial or no payments were made on the principal"@en ;
	.

fibo-loan-ln-ln:hasCost
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has cost" ;
	skos:definition "has amount payable for principal, interest, fees or other expenses" ;
	cmns-av:explanatoryNote "This can entail adding up other prices and/or fees (e.g. 4 units * a unit price)" ;
	.

fibo-loan-ln-ln:hasFirstRateChangeTerm
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has first rate change term" ;
	skos:definition "specifies a period of time in months after origination during which the interest rate cannot change" ;
	cmns-av:usageNote "This normally applies to a variable rate loan. It may also apply to step up/step down loans that are fixed rate but whose rate changes after a pre-determined number of months." ;
	.

fibo-loan-ln-ln:hasIndividualPayment
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has individual payment" ;
	rdfs:domain fibo-loan-ln-ln:PaymentHistory ;
	rdfs:range fibo-loan-ln-ln:IndividualPaymentTransaction ;
	skos:definition "links an actual payment of principal, interest, and other related amounts to the overall payment history for an account" ;
	.

fibo-loan-ln-ln:hasLoanBalance
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fbc-dae-dbt:hasOutstandingAmount ,
		fibo-fbc-pas-caa:hasBalance
		;
	rdfs:label "has loan balance" ;
	skos:definition "indicates the balance with respect to the principal on the loan as of some date" ;
	.

fibo-loan-ln-ln:hasNegativeAmortization
	a owl:DatatypeProperty ;
	rdfs:label "has negative amortization"@en ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the contractual terms include or would have included a feature that allows unpaid interest to be added to the balance of unpaid principal"@en ;
	.

fibo-loan-ln-ln:hasPaymentHistory
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-arr-doc:hasRecord ;
	rdfs:label "has payment history" ;
	rdfs:range fibo-loan-ln-ln:PaymentHistory ;
	skos:definition "relates a credit agreement, loan, or commitment to any history of payments that have been made by the borrower up to the point that payment history is requested" ;
	.

fibo-loan-ln-ln:hasPrePaymentPenaltyTerm
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has pre-payment penalty term" ;
	skos:definition "relates a loan to a period of time in months after which there is no prepayment penalty" ;
	cmns-av:usageNote "A value of zero means no prepayment penalty; this avoids need for a separate boolean property about whether there is a prepayment penalty" ;
	.

fibo-loan-ln-ln:hasPrincipalAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fbc-dae-dbt:hasPrincipal ,
		fibo-fnd-acc-cur:hasMonetaryAmount
		;
	rdfs:label "has principal amount"@en ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the nominal amount of the loan that must be paid at or before maturity"@en ;
	.

fibo-loan-ln-ln:hasScheduledUnpaidBalance
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-pas-caa:hasBalance ;
	rdfs:label "has scheduled unpaid balance" ;
	rdfs:range fibo-fbc-pas-caa:Balance ;
	skos:definition "indicates what the balance should be after a scheduled payment is made according to contract terms" ;
	.

fibo-loan-ln-ln:hasTotalClosingCosts
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-loan-ln-ln:hasCost ;
	rdfs:label "has total closing costs" ;
	skos:definition "indicates the total the amount paid at the closing of a real estate transaction, i.e., at the time when the title to the property is conveyed (transferred) to the buyer" ;
	cmns-av:explanatoryNote "Closing costs may be incurred by either the buyer or the seller, and may include fees paid by either or both parties for the preparation and recording of documents, title service costs, such as for title search and insurance (typically paid by the seller, depending on the jurisdiction), other recording costs, other document or transaction stamps or taxes, brokerage commissions, survey, appraisal, inspection and other such fees, home warranties, private mortgage insurance (PMI), and so forth." ;
	.

fibo-loan-ln-ln:hasTotalPointsAndFees
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-loan-ln-ln:hasCost ;
	rdfs:label "has total points and fees" ;
	skos:definition "indicates a form of pre-paid interest, charged by the lender as an alternative to charging a higher rate of interest on the mortgage loan" ;
	cmns-av:explanatoryNote "One point equals one percent of the loan principal, and usually reduces the interest rate by 1/8 percent (0.125)" ;
	.

fibo-loan-ln-ln:isAssumable
	a owl:DatatypeProperty ;
	rdfs:label "is assumable"@en ;
	rdfs:domain fibo-loan-ln-ln:Loan ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether or not another borrower may assume the payments on this loan"@en ;
	.

fibo-loan-ln-ln:isInitiallyPayable
	a owl:DatatypeProperty ;
	rdfs:label "is initially payable"@en ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the obligation arising from the covered loan was, or in the case of an application, would have been initially payable to the financial institution"@en ;
	.

fibo-loan-ln-ln:isInterestOnly
	a owl:DatatypeProperty ;
	rdfs:label "is interest only"@en ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the contractual terms include or would have included interest only payments"@en ;
	.

fibo-loan-ln-ln:isServicedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "is performed by" ;
	rdfs:range fibo-loan-ln-ln:Servicer ;
	skos:definition "relates a loan to the financial service provider that services it" ;
	.

fibo-loan-spc-crd:AmericanExpressNetwork
	a
		owl:NamedIndividual ,
		fibo-loan-spc-crd:CreditCardNetwork
		;
	rdfs:label "American Express network" ;
	skos:definition "credit card network and card issuer that both issues credit cards and processes payments for cards bearing its logo, as well as offering cardholder benefits like travel insurance" ;
	.

fibo-loan-spc-crd:CardAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:CustomerAccount ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:isLinkedToAccount ;
			owl:onClass fibo-fbc-pas-caa:CustomerAccount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasPrimaryAccountHolder ;
			owl:someValuesFrom fibo-loan-spc-crd:Cardholder ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:someValuesFrom fibo-loan-spc-crd:CardProduct ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-loan-spc-crd:PaymentCardAgreement ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isSignifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:PaymentCard ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:PrimaryCardAccountNumber ;
		]
		;
	rdfs:label "card account" ;
	skos:definition "account whose terms and conditions are defined in a card agreement that is represented by a payment card" ;
	.

fibo-loan-spc-crd:CardAuthenticationValue
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:MagneticStripeVerificationCodeValue ;
	rdfs:label "card authentication value" ;
	skos:definition "card verification value specifically for JCB payment cards" ;
	cmns-av:abbreviation "CAV" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CardAuthenticationValue2
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:ThreeDigitVerificationCodeValue ;
	rdfs:label "card authentication value 2" ;
	skos:definition "card verification value specifically for JCB payment cards" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	cmns-av:synonym "CAV2" ;
	.

fibo-loan-spc-crd:CardExpirationDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "card expiration date" ;
	skos:definition "date on which a given payment card expires" ;
	.

fibo-loan-spc-crd:CardIdentificationNumber
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:ThreeDigitVerificationCodeValue ;
	rdfs:label "card identification number" ;
	skos:definition "card verification value specifically for American Express and Discover payment cards" ;
	cmns-av:abbreviation "CID" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CardProduct
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:FinancialProduct ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-spc-crd:hasCreditCardNetwork ;
			owl:onClass fibo-loan-spc-crd:CreditCardNetwork ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasSubdivision ;
			owl:onClass cmns-loc:CountrySubdivision ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-spc-crd:usesCurrency ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasCountry ;
			owl:onClass cmns-loc:Country ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isExemplifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:CardAccount ;
		]
		;
	rdfs:label "card product" ;
	skos:definition "financial product involving the issuance of credit, debit, or other payment cards" ;
	.

fibo-loan-spc-crd:CardSecurityCode
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:MagneticStripeVerificationCodeValue ;
	rdfs:label "card security code" ;
	skos:definition "card verification value specifically for American Express payment cards" ;
	cmns-av:abbreviation "CSC" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CardValidationCode
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:MagneticStripeVerificationCodeValue ;
	rdfs:label "card validation code" ;
	skos:definition "card verification code specifically for Mastercard payment cards" ;
	cmns-av:abbreviation "PAN CVC" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CardValidationCode2
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:ThreeDigitVerificationCodeValue ;
	rdfs:label "card validation code 2" ;
	skos:definition "card verification value specifically for Mastercard payment cards" ;
	cmns-av:abbreviation "PAN CVC2" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CardVerificationCodeValue
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-loan-spc-crd:PaymentCard ;
		]
		;
	rdfs:label "card verification code or value" ;
	skos:definition "code that specifies either (1) magnetic-stripe data, or (2) printed security features that are used to protect data integrity and limit alteration, counterfeiting and fraud generally" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CardVerificationValue
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:MagneticStripeVerificationCodeValue ;
	rdfs:label "card verification value" ;
	skos:definition "card verification value specifically for Visa and Discover payment cards" ;
	cmns-av:abbreviation "CVV" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CardVerificationValue2
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:ThreeDigitVerificationCodeValue ;
	rdfs:label "card verification value 2" ;
	skos:definition "card verification value specifically for Visa payment cards" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	cmns-av:synonym "CVV2" ;
	.

fibo-loan-spc-crd:Cardholder
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:CustomerAccountHolder ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:someValuesFrom fibo-loan-spc-crd:CardAccount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-oac-own:owns ;
				owl:someValuesFrom fibo-loan-spc-crd:CardAccount ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-loan-spc-crd:CardAccount ;
			] ;
		]
		;
	rdfs:label "cardholder" ;
	skos:definition "account holder to whom a payment card is issued" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CommercialCreditCardAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-crd:CreditCardAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasBorrower ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom cmns-org:FormalOrganization ;
			] ;
		]
		;
	rdfs:label "commercial credit card agreement" ;
	skos:definition "credit card agreement for a card issued to, or in conjunction with, a formal organization, such as a small business, middle market business, local, state, or national government, or large corporation" ;
	cmns-av:adaptedFrom "https://www.fdic.gov/regulations/examinations/credit_card/pdf_version/ch2.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Corporate card programs come in more than one form to serve different business needs. In general, they are contractual agreements between a sponsoring entity and a financial institution, in which the financial institution issues corporate cards to select employees of the sponsoring company." ;
	cmns-av:synonym "corporate credit card agreement" ;
	.

fibo-loan-spc-crd:ConsumerCreditCardAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-crd:CreditCardAgreement ,
		fibo-loan-spc-cns:UnsecuredConsumerLoan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasBorrower ;
			owl:someValuesFrom fibo-fnd-pas-pas:Consumer ;
		]
		;
	rdfs:label "consumer credit card agreement" ;
	skos:definition "credit card agreement for a card issued for household, family, or other personal expenditures that is accessed by a borrower's use of a credit card" ;
	cmns-av:adaptedFrom "https://www.law.cornell.edu/cfr/text/12/228.12"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:CreditCard
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-crd:PaymentCard ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:onClass fibo-loan-spc-crd:CreditCardAccount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCardProduct ;
		]
		;
	rdfs:label "credit card" ;
	skos:definition "card issued by a financial service provider that enables the cardholder to borrow funds" ;
	cmns-av:adaptedFrom "https://www.fdic.gov/regulations/examinations/credit_card/pdf_version/ch2.pdf"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"In its non-physical form, a credit card represents a payment mechanism which facilitates both consumer and commercial business transactions, including purchases and cash advances. A credit card generally operates as a substitute for cash or a check and most often provides an unsecured revolving line of credit. The borrower is required to pay at least part of the card's outstanding balance each billing cycle, depending on the terms as set forth in the cardholder agreement. As the debt reduces, the available credit increases for accounts in good standing. These complex financial arrangements have ever-shifting terms and prices. A charge card differs from a credit card in that the charge card must be paid in full each month." ,
		"In physical form, a credit card traditionally is a thin, rectangular plastic card. The front of the card contains a series of numbers that are representative of various items such as the applicable network, bank, and account." ,
		"Issuance of credit cards has the condition that the cardholder will pay back the original, borrowed amount plus any additional agreed-upon charges. The credit company provider may also grant a line of credit (LOC) to the cardholder which allows the holder to borrow money in the form of a cash advance. The issuer pre-sets borrowing limits which have a basis on the individual's credit rating."
		;
	.

fibo-loan-spc-crd:CreditCardAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:LoanOrCreditAccount ,
		fibo-loan-spc-crd:CardAccount ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasPaymentDueDate ;
			owl:someValuesFrom fibo-fbc-pas-caa:PaymentDueDate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCardProduct ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCardAgreement ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isSignifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCard ;
		]
		;
	rdfs:label "credit card account" ;
	skos:definition "card account whose terms and conditions are defined in a credit card agreement that is represented by a credit card" ;
	.

fibo-loan-spc-crd:CreditCardAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CommittedCreditFacility ,
		fibo-loan-spc-crd:PaymentCardAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasBorrower ;
			owl:someValuesFrom fibo-loan-spc-crd:Cardholder ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasLender ;
			owl:someValuesFrom fibo-loan-spc-crd:IssuingFinancialInstitution ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidencedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCard ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCardAccount ;
		]
		;
	rdfs:label "credit card agreement" ;
	skos:definition "account-specific credit facility that specifies the terms and conditions under which the credit card is offered to the cardholder by the issuer" ;
	.

fibo-loan-spc-crd:CreditCardNetwork
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:someValuesFrom xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-loan-spc-crd:CardProduct ;
		]
		;
	rdfs:label "credit card network" ;
	skos:definition "classifier for the network that authorizes, processes, and sets the terms of credit card transactions, as well as transfers payments between shoppers, merchants, and their banks" ;
	skos:example "Mastercard, Visa, American Express, Discover" ;
	.

fibo-loan-spc-crd:CreditCardProduct
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-crd:CardProduct ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-spc-crd:hasCreditCardNetwork ;
			owl:onClass fibo-loan-spc-crd:CreditCardNetwork ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isExemplifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCardAccount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCard ;
		]
		;
	rdfs:label "credit card product" ;
	skos:definition "card product allowing the holder to purchase goods or services on credit" ;
	.

fibo-loan-spc-crd:DebitCard
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-crd:PaymentCard ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:onClass fibo-loan-spc-crd:DebitCardAccount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:DebitCardProduct ;
		]
		;
	rdfs:label "debit card" ;
	skos:definition "payment card issued by a financial service provider that enables the cardholder to access funds in a demand deposit account" ;
	.

fibo-loan-spc-crd:DebitCardAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-crd:CardAccount ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:someValuesFrom fibo-loan-spc-crd:DebitCardProduct ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isSignifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:DebitCard ;
		]
		;
	rdfs:label "debit card account" ;
	skos:definition "card account that is represented by a one or more debit cards" ;
	.

fibo-loan-spc-crd:DebitCardProduct
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-crd:CardProduct ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isExemplifiedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:DebitCardAccount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-loan-spc-crd:DebitCard ;
		]
		;
	rdfs:label "debit card product" ;
	skos:definition "card product card typically provided by a depository institution allowing the holder to transfer money electronically to another account when making a purchase" ;
	.

fibo-loan-spc-crd:DiscoverNetwork
	a
		owl:NamedIndividual ,
		fibo-loan-spc-crd:CreditCardNetwork
		;
	rdfs:label "Discover network" ;
	skos:definition "credit card network and card issuer offering benefits like secondary rental car collision insurance" ;
	.

fibo-loan-spc-crd:IssuingFinancialInstitution
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:Issuer ,
		fibo-fbc-pas-fpas:FinancialServiceProvider
		;
	rdfs:label "issuing financial institution" ;
	skos:definition "issuer and financial services provider that issues payment cards or performs, facilitates, or supports issuing services including but not limited to issuing banks and issuing processors" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	cmns-av:synonym "issuing bank" ;
	.

fibo-loan-spc-crd:JCBNetwork
	a
		owl:NamedIndividual ,
		fibo-loan-spc-crd:CreditCardNetwork
		;
	rdfs:label "JCB network" ;
	skos:definition "credit card network based in Japan, with coverage throughout Asia, with strategic partners worldwide" ;
	cmns-av:explanatoryNote "JCB Co., Ltd., (formerly Japan Credit Bureau) is a credit card company based in Tokyo, Japan. As of 2020, it operates in 23 countries with over 130 million customers. In the United States, it is not a primary credit card network but has an association with the Discover Network to enable use of JCB cards." ;
	.

fibo-loan-spc-crd:MagneticStripeVerificationCodeValue
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:CardVerificationCodeValue ;
	rdfs:label "magnetic stripe verification code or value" ;
	skos:definition "card verification code on a card's magnetic stripe that uses secure cryptographic processes to protect data integrity on the stripe, and reveals any alteration or counterfeiting" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:MastercardNetwork
	a
		owl:NamedIndividual ,
		fibo-loan-spc-crd:CreditCardNetwork
		;
	rdfs:label "Mastercard network" ;
	skos:definition "credit card network that has its own suite of card protections and benefits, such as identity theft protection and extended warranties" ;
	.

fibo-loan-spc-crd:PaymentCard
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:LegalDocument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasExpirationDate ;
			owl:onClass fibo-loan-spc-crd:CardExpirationDate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-spc-crd:hasCardVerificationCode ;
			owl:onClass fibo-loan-spc-crd:CardVerificationCodeValue ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-spc-crd:hasPrimaryAccountNumber ;
			owl:onClass fibo-loan-spc-crd:PrimaryCardAccountNumber ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:someValuesFrom fibo-loan-spc-crd:CardAccount ;
		]
		;
	rdfs:label "payment card" ;
	rdfs:seeAlso <https://www.irs.gov/payments/payment-card-transactions-faqs> ;
	skos:definition "legal document issued by a financial services provider that enables the cardholder to access the funds in the customer's designated bank accounts, or through a credit account and make payments by electronic funds transfer and access automated teller machines (ATMs)" ;
	cmns-av:explanatoryNote
		"For purposes of Payment Card Industry Data Security Standard (PCI DSS), a payment card is any payment card/device that bears the logo of the founding members of PCI SSC, which are American Express, Discover Financial Services, JCB International, MasterCard, or Visa, Inc." ,
		"The term payment card includes credit cards, debit cards, and stored-value cards, as well as payment through any distinctive marks of a payment card (such as a credit card number). A payment card is issued under an agreement that provides standards and mechanisms for settling the transactions between a merchant acquiring bank or similar entity and the providers who accept the cards as payment."
		;
	.

fibo-loan-spc-crd:PaymentCardAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditAgreement ,
		fibo-fbc-pas-caa:AccountSpecificServiceAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:someValuesFrom fibo-loan-spc-crd:Cardholder ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:someValuesFrom fibo-loan-spc-crd:IssuingFinancialInstitution ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidencedBy ;
			owl:someValuesFrom fibo-loan-spc-crd:PaymentCard ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-loan-spc-crd:CardAccount ;
		]
		;
	rdfs:label "payment card agreement" ;
	skos:definition "account-specific credit agreement that specifies the terms and conditions under which the payment card is offered to the cardholder by the issuer" ;
	.

fibo-loan-spc-crd:PrimaryCardAccountNumber
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:AccountIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-loan-spc-crd:CardAccount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "primary card account number" ;
	skos:definition "composite identifier of 14 or 16 digits embossed on a bank or payment card and encoded in the card's magnetic strip" ;
	cmns-av:abbreviation "PAN" ;
	cmns-av:explanatoryNote "The PAN identifies the issuer of the card and the account including part of the account number, and contains a check digit that verifies the authenticity of the embossed account number." ;
	cmns-av:synonym "primary account number" ;
	.

fibo-loan-spc-crd:SmartCard
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:PaymentCard ;
	rdfs:label "smart card" ;
	skos:definition "payment card that has integrated circuits embedded within it" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	cmns-av:explanatoryNote "The circuits, also referred to as the 'chip,' contain payment card data including but not limited to data equivalent to the magnetic-stripe data." ;
	.

fibo-loan-spc-crd:ThreeDigitVerificationCodeValue
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-crd:CardVerificationCodeValue ;
	rdfs:label "three-digit verification code or value" ;
	skos:definition "card verification code that is the rightmost three-digit value printed in the signature panel area on the back of the card" ;
	cmns-av:adaptedFrom "https://www.pcisecuritystandards.org/pci_security/glossary"^^xsd:anyURI ;
	.

fibo-loan-spc-crd:VisaNetwork
	a
		owl:NamedIndividual ,
		fibo-loan-spc-crd:CreditCardNetwork
		;
	rdfs:label "Visa network" ;
	skos:definition "credit card network that oversees the Visa Signature benefits associated with certain credit cards, such as premium rental car privileges and hotel perks" ;
	.

fibo-loan-spc-crd:hasCardVerificationCode
	a owl:ObjectProperty ;
	rdfs:label "has card verification code" ;
	rdfs:domain fibo-loan-spc-crd:PaymentCard ;
	rdfs:range fibo-loan-spc-crd:CardVerificationCodeValue ;
	skos:definition "links a credit card to either: (1) magnetic-stripe data, or (2) printed security features that are used to protect data integrity and limit alteration, counterfeiting and fraud generally" ;
	.

fibo-loan-spc-crd:hasCreditCardNetwork
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
	rdfs:label "has credit card network" ;
	rdfs:range fibo-loan-spc-crd:CreditCardNetwork ;
	skos:definition "indicates the underlying network for credit card product" ;
	.

fibo-loan-spc-crd:hasPrimaryAccountNumber
	a owl:ObjectProperty ;
	rdfs:label "has primary account number" ;
	rdfs:domain fibo-loan-spc-crd:PaymentCard ;
	rdfs:range fibo-loan-spc-crd:PrimaryCardAccountNumber ;
	skos:definition "specifies the account number displayed on the face of the card" ;
	skos:editorialNote "modeled independently of 'identifies' in order to circumvent circular reasoning challenges" ;
	.

fibo-loan-spc-crd:usesCurrency
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cxtdsg:uses ;
	rdfs:label "uses currency" ;
	rdfs:range fibo-fnd-acc-cur:Currency ;
	skos:definition "indicates the currency defined for the credit card product" ;
	.

fibo-loan-spc-com:CommercialLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:Loan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-fnd-gao-obj:BusinessObjective ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-spc-com:hasBusinessPurposeDescription ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasBorrower ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom cmns-org:LegalEntity ;
			] ;
		]
		;
	rdfs:label "commercial loan"@en ;
	skos:definition "loan extended to a corporation, commercial enterprise, joint venture, or other organization as opposed to a consumer"@en ;
	cmns-av:explanatoryNote "Such loans may include those that provide working capital, are used to finance the purchase of equipment and/or materials, for facilities and/or improvement of facilities, and so forth, and are typically secured."@en ;
	cmns-av:synonym "commercial and industrial loan"@en ;
	.

fibo-loan-spc-com:hasBusinessPurposeDescription
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dsg:hasDescription ;
	rdfs:label "has business purpose description" ;
	rdfs:domain fibo-loan-spc-com:CommercialLoan ;
	skos:definition "provides a description of the purpose of the loan from the perspective of the borrower" ;
	.

fibo-loan-spc-cns:ConsumerLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:Loan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasBorrower ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-pas-pas:Consumer
					[
						a owl:Restriction ;
						owl:onProperty cmns-rlcmp:isPlayedBy ;
						owl:someValuesFrom fibo-be-le-lp:LegallyCompetentNaturalPerson ;
					]
				) ;
			] ;
		]
		;
	rdfs:label "consumer loan"@en ;
	skos:definition "loan to one or more individuals for household, family, or other personal expenditures, excluding mortgages and student loans"@en ;
	skos:example "Other secured consumer loans may include loans against insurance policies, against securities held in a retirement account, loans secured with collateral other than for the loan's stated purpose, lines of credit other than credit card agreements, and so forth."@en ;
	cmns-av:adaptedFrom "12 CFR § 228.12, https://www.law.cornell.edu/cfr/text/12/228.12"@en ;
	cmns-av:explanatoryNote
		"In the United Kingdom and per the Bank of England, lending to individuals (excluding student loans) consists of sterling lending secured on dwellings (i.e. mortgages) and sterling consumer credit to UK-resident individuals. See https://www.bankofengland.co.uk/statistics/details/further-details-about-total-lending-to-individuals-data. This definition is broader than the definition used in the US, however."@en ,
		"In the United States, consumer loans do not include a home mortgage, small business, or small farm loans. They are defined by law to include the following: (1) Motor vehicle loan, which is a consumer loan extended for the purchase of and secured by a motor vehicle; (2) Credit card loan, which is a line of credit for household, family, or other personal expenditures that is accessed by a borrower's use of a 'credit card,' as this term is defined in § 1026.2 of 12 CFR § 228.12; (3) Other secured consumer loan, which is a secured consumer loan that is not included in one of the other categories of consumer loans; and (4) Other unsecured consumer loan, which is an unsecured consumer loan that is not included in one of the other categories of consumer loans."@en
		;
	.

fibo-loan-spc-cns:HomeEquityLineOfCredit
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:RevolvingLineOfCredit ,
		fibo-loan-spc-cns:SecuredConsumerLoan ,
		fibo-loan-reln-mtg:LoanSecuredByRealEstate
		;
	rdfs:label "home equity line of credit"@en ;
	skos:definition "line of credit granted to a homeowner secured by the equity value in a borrower's home or other property"@en ;
	cmns-av:acronym "HELOC"@en ;
	cmns-av:explanatoryNote
		"Home equity loans allow the borrower to borrow against the difference between the fair market value of the property, as determined by an appraisal, and the amount of any outstanding debt on that property, which is typically a first mortgage. Common practice is to set the maximum amount that can be borrowed of up to 80 percent of the fair market value less any outstanding debt."@en ,
		"Usually, the term of a HELOC can vary from 5 to up to 25 years, with an initial draw period during which the borrower can access the line of credit, followed by a repayment period during which monthly payments on principal and interest are due until the loan is paid in full. Note that there are restrictions in the US on the nature of the property that may be used as collateral for a HELOC - it must be classified as a 1-4 family dwelling. That determination is independent from the use of proceeds."@en
		;
	.

fibo-loan-spc-cns:MotorVehicleLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:CollateralizedLoan ,
		fibo-loan-spc-cns:SecuredConsumerLoan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isCollateralizedBy ;
			owl:someValuesFrom fibo-fbc-dae-dbt:PhysicalCollateral ;
		]
		;
	rdfs:label "motor vehicle loan"@en ;
	skos:definition "collateralized, simple-interest loan that is repaid in monthly installments over a period of typically three to five years, for the purpose of purchasing a vehicle"@en ;
	cmns-av:adaptedFrom "12 CFR § 228.12, https://www.law.cornell.edu/cfr/text/12/228.12"@en ;
	cmns-av:explanatoryNote "Many lenders will only approve auto loans for vehicles (i.e., cars, trucks) that are a certain age (typically 5 years or less) due to depreciation of the value of the vehicle. Because an auto loan is a 'secured' type of loan, the vehicle that is being financed is used as collateral (i.e. if the borrower fails to repay the loan, the vehicle may be seized by the lender)."@en ;
	cmns-av:synonym "auto loan"@en ;
	.

fibo-loan-spc-cns:SecuredConsumerLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:SecuredLoan ,
		fibo-loan-spc-cns:ConsumerLoan
		;
	rdfs:label "secured consumer loan"@en ;
	skos:definition "loan to one or more individuals for household, family, or other personal expenditures in which the borrower pledges some asset via a security agreement as collateral for the loan, or that is secured via third-party guarantee"@en ;
	.

fibo-loan-spc-cns:UnsecuredConsumerLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:UnsecuredLoan ,
		fibo-loan-spc-cns:ConsumerLoan
		;
	rdfs:label "unsecured consumer loan"@en ;
	skos:definition "loan to one or more individuals for household, family, or other personal expenditures granted based on the strength of the borrower's credit history or reputation in the community"@en ;
	.

fibo-loan-spc-grn:AssessmentBoundary
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtdsg:Context ,
		cmns-doc:Specification ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:onClass cmns-rga:Jurisdiction ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:onClass cmns-sfc:Facility ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:involves ;
			owl:onClass cmns-sfc:Site ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-spc-grn:hasSpatialBoundary ;
			owl:someValuesFrom cmns-loc:GeographicRegion ;
		]
		;
	rdfs:label "assessment boundary" ;
	skos:definition "defined scope, limits, and criteria used to determine what is included or excluded in an evaluation, analysis, or measurement of environmental impacts, sustainability performance, or related objectives" ;
	cmns-av:explanatoryNote """The assessment boundary ensures consistency, transparency, and focus by specifying the parameters for the evaluation. It includes: (1) the scope of assessment, (2) the relevant spacial boundaries, (3) the time period(s) over which the assessment is to be conducted, (4) organizational boundaries - which parts of an organization or project are included in the evaluation, (5) impact categories - which environmental or sustainability impacts are included, (6) lifecycle boundaries - which stages of the lifecycle are included, (7) exclusions - specific elements, processes, or impacts that are excluded from the assessment and justification for these exclusions, and (8) stakeholder boundaries - the extent to which external stakeholders or externalities (e.g., indirect social impacts) are considered.
		
		- The scope statement specifies which aspects, activities, processes, or entities are included in the evaluation. For example, in a greenhouse gas (GHG) emissions assessment, the boundary might cover Scope 1 (direct emissions), Scope 2 (indirect emissions from energy use), and Scope 3 (upstream and downstream emissions in the value chain).
		
		- The spatial boundaries cover the geographic region(s) relevant for the assessment, including but not limited to a specific site, facility, region, or global operations of a company or project.
		
		- The relevant timeframe may be a single year, the entire lifecycle of a product, or a specific project phase.
		
		- Organizational boundaries may include a parent company, subsidiaries, joint ventures, or specific divisions based on control, ownership, or influence.
		
		- Impact may include carbon emissions, energy use, water consumption, biodiversity impact, and waste generation.
		
		- Lifecycle boundaries may cover product or process evaluations (e.g., Life Cycle Assessment or LCA). If so, the boundary defines which stages of the lifecycle are included: Cradle-to-Grave: Includes all stages, from raw material extraction to disposal, Cradle-to-Gate: Covers stages up to the point where the product leaves the manufacturing facility. or Gate-to-Gate: Focuses on a specific segment of the lifecycle, such as manufacturing processes, for example.
		
		- Small, immaterial emissions sources might be excluded if their impact is negligible.
		
		- Stakeholder boundaries with respect to a given sustainability evaluation might include impacts on local communities or supply chain partners.""" ;
	.

fibo-loan-spc-grn:EnvironmentalProgram
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:Program ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:onClass fibo-loan-spc-grn:EnvironmentalProject ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityKeyPerformanceIndicator ;
		]
		;
	rdfs:label "environmental program" ;
	skos:definition "broad scale initiative, activity, or investment aimed at improving environmental sustainability, reducing ecological harm, or addressing environmental challenges" ;
	cmns-av:explanatoryNote "Key characteristics of an environmental or sustainability program include achieving measurable positive environmental outcomes, and aligning with broader sustainability goals, such as those outlined in international frameworks (e.g., the United Nations Sustainable Development Goals (SDGs), Paris Agreement). Large scale environmental programs may consist of a number of projects aimed at addressing specific requirements that support the broader challenges outlined under the program." ;
	.

fibo-loan-spc-grn:EnvironmentalProject
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:Project ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-spc-grn:hasAssessmentBoundary ;
			owl:onClass fibo-loan-spc-grn:AssessmentBoundary ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-loan-spc-grn:EnvironmentalProgram ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:someValuesFrom fibo-fnd-agr-ctr:MilestoneSchedule ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityKeyPerformanceIndicator ;
		]
		;
	rdfs:label "environmental project" ;
	skos:definition "specific initiative, activity, or investment aimed at improving environmental sustainability, reducing ecological harm, or addressing environmental challenges" ;
	cmns-av:explanatoryNote
		"Key characteristics of an environmental or sustainability project include achieving measurable positive environmental outcomes, and aligning with broader sustainability goals, such as those outlined in international frameworks (e.g., the United Nations Sustainable Development Goals (SDGs), Paris Agreement)." ,
		"Such projects are designed to align with environmental goals, such as mitigating climate change, conserving natural resources, protecting biodiversity, and promoting a circular economy."
		;
	.

fibo-loan-spc-grn:GreenLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditAgreementRepaidPeriodically ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasMilestoneProvision ;
			owl:onClass fibo-fnd-agr-ctr:ContractMilestone ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:onClass fibo-fnd-agr-ctr:MilestoneSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-fnd-agr-ctr:DisclosureProvision ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-loan-spc-grn:GreenProjectUseOfProceedsProvision ;
		]
		;
	rdfs:label "green loan"@en ;
	skos:definition "credit agreement and/or contingent facility (such as a bonding line, guarantee line or letter of credit) made available exclusively to finance, re-finance or guarantee, in whole or in part, new and/or existing eligible green projects that are aligned to the four core components of the Green Loan Principles (GLP)"@en ;
	skos:example "Example categories of eligibility contained in the LMA's Green Loan Principles (GLP) include loans designed to facilitate renewable energy, energy efficiency, climate change adaptation and green buildings that meet regional, national or internationally recognised standards or certifications."@en ;
	cmns-av:adaptedFrom
		"https://www.addleshawgoddard.com/en/insights/insights-briefings/2020/financial-services/green-loans-and-sustainability-linked-loans-what-is-the-difference/"@en ,
		"https://www.lsta.org/content/sustainable-lending-glossary-of-terms/"@en
		;
	.

fibo-loan-spc-grn:GreenProject
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-grn:EnvironmentalProject ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom fibo-loan-spc-grn:GreenProjectUseOfProceedsProvision ;
		]
		;
	rdfs:label "green project" ;
	skos:definition "project that contributes to environmental sustainability by addressing climate change, conserving natural resources, reducing pollution, or promoting ecological balance" ;
	skos:example "Examples include: renewable energy projects (e.g., solar, wind, hydroelectric power), green buildings certified by recognized standards (e.g., LEED, BREEAM), sustainable water and wastewater management systems, pollution reduction technologies and systems, sustainable forestry and agriculture initiatives, circular economy projects, such as recycling or waste-to-energy facilities, low-carbon transportation infrastructure (e.g., electric vehicle charging stations, public transit projects), and the like."@en ;
	cmns-av:adaptedFrom
		"Loan Market Association (LMA) Green Loan Principles, available at https://www.icmagroup.org/assets/documents/Regulatory/Green-Bonds/LMA_Green_Loan_Principles_Booklet-220318.pdf." ,
		"https://www.lma.eu.com/application/files/8916/9755/2443/Green_Loan_Principles_23_February_2023.pdf"@en ,
		"https://www.prince2.com/usa/blog/project-vs-programme"^^xsd:anyURI
		;
	cmns-av:explanatoryNote
		"Green projects must align with established green finance principles, such as the Green Loan Principles (GLP) issued by the Loan Market Association (LMA), or other recognized sustainability frameworks."@en ,
		"The borrower must demonstrate that the project meets predefined eligibility criteria for green financing. These criteria are usually aligned with the taxonomy or standards set forth by the Green Loan Principles, the EU Taxonomy for Sustainable Activities, or other regional or international guidelines."@en ,
		"To qualify as a green project within a green loan: (a) the project must meet use-of-proceeds requirements, meaning that funds must be exclusively allocated to activities that qualify as green, (b) the borrower must establish clear processes for evaluating and selecting eligible projects, (c) there must be transparency in how funds are managed and allocated, often verified through audits or certifications, and (d) the borrower must report regularly on the environmental impact of the project, typically through measurable metrics (e.g., tons of CO₂ avoided, energy saved)."@en
		;
	.

fibo-loan-spc-grn:GreenProjectUseOfProceedsProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:UseOfProceedsProvision ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:governs ;
			owl:someValuesFrom fibo-loan-spc-grn:GreenProject ;
		]
		;
	rdfs:label "green project use of proceeds provision" ;
	dct:source "Loan Market Association (LMA) Green Loan Principles, available at https://www.icmagroup.org/assets/documents/Regulatory/Green-Bonds/LMA_Green_Loan_Principles_Booklet-220318.pdf." ;
	skos:definition "use of proceeds provision specifying that funds obtained through financing, such as through a credit agreement, offering, warrant, or other instrument are intended to be used for Green Projects (including other related and supporting expenditures, including research and development)" ;
	cmns-av:explanatoryNote """All designated Green Projects should provide clear environmental benefits, which will be assessed, and where feasible, quantified, measured and reported by the borrower, per requirements outlined in the LMA Green Loan Principles (GLP). Where funds are to be used, in whole or part, for refinancing, it is recommended that borrowers provide an estimate of the share of financing versus refinancing. Where appropriate, they should also clarify which investments or project portfolios may be refinanced, and, to the extent relevant, the expected look-back period for refinanced Green Projects. A green loan may take the form of one or more tranches of a loan facility. In such cases, the green tranche(s) must be clearly designated, with proceeds of the green tranche(s) credited to a separate account or tracked by the borrower in an appropriate manner. 
		
		The GLP explicitly recognise several broad categories of eligibility for Green Projects with the objective of addressing key areas of environmental concern such as climate change, natural resources depletion, loss of biodiversity, and air, water and soil pollution. This non-exhaustive list, set out in Appendix 1, is intended to capture the most usual types of projects supported, and expected to be supported, by the green loan market. However, it is recognised that definitions of green and green projects may vary depending on sector and geography""" ;
	.

fibo-loan-spc-grn:ObservedIndicatorValue
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedCollectionConstituent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasQuantityValue ;
			owl:someValuesFrom cmns-qtu:ScalarQuantityValue ;
		]
		;
	rdfs:label "observed indicator value"@en ;
	skos:definition "observation (measurement) of a key performance indicator measured at specific date and time"@en ;
	.

fibo-loan-spc-grn:ObservedIndicatorValueStructure
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-loan-spc-grn:ObservedIndicatorValue ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:someValuesFrom fibo-fnd-dt-fd:CalculationPeriod ;
		]
		;
	rdfs:label "observed indicator value structure"@en ;
	skos:definition "collection of observations for some key performance indicator measured over a specified window of time"@en ;
	.

fibo-loan-spc-grn:SustainabilityBusinessObjective
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:BusinessObjective ;
	rdfs:label "sustainability business objective"@en ;
	skos:definition "objective related to improving the sustainability profile of the business"@en ;
	cmns-av:adaptedFrom "https://www.lsta.org/content/sustainability-linked-loan-principles-sllp/"@en ;
	cmns-av:explanatoryNote "The borrower of an SLL should clearly communicate to its lenders its sustainability objective(s) and how such objectives align with its proposed sustainability performance targets (SPTs)."@en ;
	.

fibo-loan-spc-grn:SustainabilityBusinessStrategy
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:BusinessStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidencedBy ;
			owl:onClass fibo-loan-spc-grn:SustainabilityPerformanceTarget ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityBusinessObjective ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityKeyPerformanceIndicator ;
		]
		;
	rdfs:label "sustainability business strategy"@en ;
	skos:definition "strategy for achieving specific business objectives related to sustainability (from an environmental and/or social and/or governance (ESG) perspective)"@en ;
	cmns-av:adaptedFrom "https://www.lsta.org/content/sustainability-linked-loan-principles-sllp/"@en ;
	cmns-av:explanatoryNote
		"An SLL borrower should clearly communicate to its lender(s) its rationale for the selection of its KPI(s) (i.e. relevance, materiality, whether it is core to the borrower's overall business) and the motivation for the SPT(s) (i.e. ambition level, benchmarking approach and how the borrower intends to reach such SPTs). Borrowers are encouraged to position this information within the context of their overarching objectives, sustainability strategy, policy, sustainability commitments and/or processes relating to sustainability."@en ,
		"SLLs aim to support a borrower's efforts in improving its sustainability profile over the term of the loan. They do so by aligning loan terms to the borrower's performance, which is measured using one or more sustainability KPIs that can be internal and/or external. The KPIs must be material to the borrower's core sustainability and business strategy, and address relevant ESG challenges of its industry sector."@en
		;
	.

fibo-loan-spc-grn:SustainabilityKeyPerformanceIndicator
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:KeyPerformanceIndicator ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasObservedValue ;
			owl:onClass fibo-loan-spc-grn:ObservedIndicatorValueStructure ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-loan-spc-grn:SustainabilityKeyPerformanceIndicatorIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasTargetValue ;
			owl:onClass fibo-loan-spc-grn:SustainabilityPerformanceTarget ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "sustainability key performance indicator"@en ;
	skos:definition "measurable performance indicator that is sustainability specific"@en ;
	cmns-av:adaptedFrom "https://www.lsta.org/content/sustainability-linked-loan-principles-sllp/"@en ;
	cmns-av:explanatoryNote "A sustainability KPI must be: (a) relevant, core and material to the borrower's overall business, and of high strategic significance to the borrower's current and/or future operations; (b) measurable or quantifiable on a consistent methodological basis; and (c) able to be benchmarked (i.e. as much as possible using an external reference or definitions to facilitate the assessment of the SPT's level of ambition). A clear definition of the KPI(s) should be provided by the borrower and should include the applicable scope or parameters, as well as the calculation methodology, a definition of a baseline and be benchmarked against an industry standard and/or industry peers where feasible."@en ;
	.

fibo-loan-spc-grn:SustainabilityKeyPerformanceIndicatorIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtid:ContextualIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityKeyPerformanceIndicator ;
		]
		;
	rdfs:label "sustainability key performance indicator identifier"@en ;
	skos:definition "sequence of characters uniquely identifying a specific sustainability-related key performance indicator" ;
	.

fibo-loan-spc-grn:SustainabilityLinkedLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditAgreementRepaidPeriodically ,
		fibo-loan-spc-com:CommercialLoan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasMilestoneProvision ;
			owl:onClass fibo-fnd-agr-ctr:ContractMilestone ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:onClass fibo-fnd-agr-ctr:MilestoneSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-fnd-agr-ctr:DisclosureProvision ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasStrategy ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityBusinessStrategy ;
		]
		;
	rdfs:label "sustainability-linked loan"@en ;
	skos:definition "credit agreement and/or contingent facility (such as a bonding line, guarantee line or letter of credit) for which the economic characteristics can vary depending on whether the borrower achieves ambitious, material and quantifiable predetermined sustainability performance objectives aligned with Sustainability-Linked Loan Principles (SSLP)"@en ;
	skos:example "The use of proceeds in relation to a SLL is not a determinant in its categorisation and, in most instances, SLLs will be used for general corporate purposes. Instead, SLLs look to support a borrower in improving its sustainability performance."@en ;
	cmns-av:abbreviation "SLL"@en ;
	cmns-av:adaptedFrom
		"https://www.addleshawgoddard.com/en/insights/insights-briefings/2020/financial-services/green-loans-and-sustainability-linked-loans-what-is-the-difference/"@en ,
		"https://www.lsta.org/content/sustainable-lending-glossary-of-terms/"@en
		;
	cmns-av:explanatoryNote "A borrower's sustainability performance is measured using sustainability performance targets (SPTs), which include key performance indicators, external ratings and/or equivalent metrics that measure improvements in the borrower's sustainability profile."@en ;
	.

fibo-loan-spc-grn:SustainabilityPerformanceTarget
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-loan-spc-grn:SustainabilityPerformanceTargetIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:isCalculatedViaMethodology ;
			owl:someValuesFrom xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-loan-spc-grn:TargetIndicatorValue ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:someValuesFrom fibo-fnd-dt-fd:CalculationPeriod ;
		]
		;
	rdfs:label "sustainability performance target"@en ;
	skos:definition "collection of quantitative target values used to calibrate the level of achievement a borrower makes with respect to a key performance indicator, by date, including, but not limited to, the methodology used to calculate its value at any point over the lifetime of a loan"@en ;
	cmns-av:abbreviation "SPT"@en ;
	cmns-av:adaptedFrom "https://www.lsta.org/content/sustainability-linked-loan-principles-sllp/"@en ;
	cmns-av:explanatoryNote
		"An SLL borrower should clearly communicate to its lenders its rationale for the selection of its KPI(s) (i.e. relevance, materiality, whether it is core to the borrower’s overall business) and the motivation for the SPT(s) (i.e. ambition level, benchmarking approach and how the borrower intends to reach such SPTs). Borrowers are encouraged to position this information within the context of their overarching objectives, sustainability strategy, policy, sustainability commitments and/or processes relating to sustainability."@en ,
		"The process for calibration of the SPT(s) per KPI is key to the structuring of SLLs, since it will be the expression of the level of ambition the borrower is ready to commit to. The SPTs must be set in good faith and remain relevant (so long as they apply) and ambitious throughout the life of the loan."@en
		;
	.

fibo-loan-spc-grn:SustainabilityPerformanceTargetIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtid:ContextualIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityPerformanceTarget ;
		]
		;
	rdfs:label "sustainability performance target identifier"@en ;
	skos:definition "sequence of characters uniquely identifying a specific sustainability-related performance target" ;
	.

fibo-loan-spc-grn:SustainabilityStructuringAgent
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-fct:SyndicateMember ;
	rdfs:label "sustainability structuring agent"@en ;
	skos:definition "financial institution appointed to help design, implement, and monitor the sustainability aspects of a syndicated green loan"@en ;
	cmns-av:explanatoryNote "This role is typically present in sustainability-linked loans (SLLs) or green loans, which tie the loan's terms to the borrower's environmental, social, and governance (ESG) performance. The sustainability structuring agent's role is crucial in ensuring that the loan's sustainability metrics align with both the borrower's goals and the expectations of the participating lenders."@en ;
	.

fibo-loan-spc-grn:TargetIndicatorValue
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedCollectionConstituent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasQuantityValue ;
			owl:someValuesFrom cmns-qtu:ScalarQuantityValue ;
		]
		;
	rdfs:label "target indicator value"@en ;
	skos:definition "target value for a key performance indicator as of a specific date and time"@en ;
	.

fibo-loan-spc-grn:TransitionLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditAgreementRepaidPeriodically ,
		fibo-loan-spc-com:CommercialLoan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasMilestoneProvision ;
			owl:onClass fibo-fnd-agr-ctr:ContractMilestone ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:onClass fibo-fnd-agr-ctr:MilestoneSchedule ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-fnd-agr-ctr:DisclosureProvision ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-loan-spc-grn:TransitionUseOfProceedsProvision ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasStrategy ;
			owl:someValuesFrom fibo-loan-spc-grn:TransitionStrategy ;
		]
		;
	rdfs:label "transition loan"@en ;
	skos:definition "credit agreement and/or contingent facility (such as a bonding line, guarantee line or letter of credit) designed to help a business or organization shift from carbon-intensive or environmentally harmful practices to more sustainable and environmentally friendly operations"@en ;
	cmns-av:explanatoryNote
		"Transition loans are part of the broader sustainable finance market and are specifically tailored for companies in industries that are not inherently green but are committed to adopting practices that align with a low-carbon or sustainable economy."@en ,
		"Transition loans are structured to assist companies in reducing greenhouse gas (GHG) emissions, improving energy efficiency, adopting renewable energy sources, or meeting other sustainability targets aligned with climate transition goals. They support initiatives such as retrofitting fossil fuel-based systems, decarbonizing supply chains, or adopting cleaner production methods. Transition loans align with emerging Climate Transition Finance principles (developed by groups such as the International Capital Market Association, ICMA). Borrowers are expected to demonstrate that the loan aligns with long-term, science-based climate goals, such as those outlined in the Paris Agreement (e.g., limiting global warming to well below 2°C)."@en
		;
	.

fibo-loan-spc-grn:TransitionProject
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-grn:EnvironmentalProject ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom fibo-loan-spc-grn:TransitionUseOfProceedsProvision ;
		]
		;
	rdfs:label "transition project" ;
	skos:definition "project that supports broad, sector-specific efforts to reduce environmental impact" ;
	cmns-av:explanatoryNote
		"Borrowers must demonstrate a credible transition plan, which include: (a) clear sustainability performance targets (SPTs), (b) alignment with recognized climate goals and frameworks (e.g., the Science Based Targets initiative, SBTi), and (c) transparency in reporting progress and outcomes. Third-party verification or certification of the transition plan and its alignment with best practices is often required."@en ,
		"Green loans focus on funding projects with direct and measurable environmental benefits (e.g., solar farms, green buildings). Transition loans are for broader initiatives aimed at improving sustainability in traditionally carbon-intensive sectors."@en ,
		"Sustainability-Linked Loans (SLLs): Transition loans share similarities with SLLs, as both tie terms (such as interest rates) to achieving predefined sustainability goals. However, transition loans are specifically framed within the context of long-term decarbonization or sustainability transitions."@en
		;
	.

fibo-loan-spc-grn:TransitionStrategy
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:BusinessStrategy ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidencedBy ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityPerformanceTarget ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityBusinessObjective ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:someValuesFrom fibo-loan-spc-grn:SustainabilityKeyPerformanceIndicator ;
		]
		;
	rdfs:label "transition strategy"@en ;
	skos:definition "strategy for achieving specific business objectives related to sustainability in the context of long-term decarbonization or sustainability transitions"@en ;
	cmns-av:explanatoryNote "Note that although there are similarities with sustainability business strategies, they are not the same. KPIs and SPTs may, however, be defined similarly for a given project."@en ;
	.

fibo-loan-spc-grn:TransitionUseOfProceedsProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:UseOfProceedsProvision ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:governs ;
			owl:someValuesFrom fibo-loan-spc-grn:TransitionProject ;
		]
		;
	rdfs:label "transition use of proceeds provision" ;
	skos:definition "use of proceeds provision specifying that funds obtained through financing, such as through a credit agreement, offering, warrant, or other instrument are intended to be used to fund specific projects, investments, or operational changes that support a company's transition toward sustainability" ;
	.

fibo-loan-spc-grn:hasAssessmentBoundary
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cxtdsg:isApplicableIn ;
	rdfs:label "has assessment boundary" ;
	rdfs:range fibo-loan-spc-grn:AssessmentBoundary ;
	skos:definition "indicates the scope, limits, and context for an environmental or sustainability project" ;
	.

fibo-loan-spc-grn:hasSpatialBoundary
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-loc:hasRegion ;
	rdfs:label "has spatial boundary" ;
	rdfs:range cmns-loc:GeographicRegion ;
	skos:definition "specifies a geographic region included in an environmental or sustainability assessment, which may cover a specific site, facility, region, or the global operations of a company or project" ;
	.

fibo-loan-spc-stu:PrivateStudentLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-spc-stu:RegulatedStudentLoan ,
		fibo-loan-spc-stu:StudentLoan
		;
	rdfs:label "private student loan"@en ;
	skos:definition "student loan that is not considered a government-backed / regulated loan"@en ;
	.

fibo-loan-spc-stu:RegulatedStudentLoan
	a owl:Class ;
	rdfs:subClassOf fibo-loan-spc-stu:StudentLoan ;
	rdfs:label "regulated student loan"@en ;
	skos:definition "student loan (1) whose lender is a government agency or instrumentality, and/or (2) that is treated uniquely due to tax regulations"@en ;
	cmns-av:explanatoryNote "In the United States, certain student loans survive bankruptcy and are subject to additional tax regulations that do not apply to other kinds of loans."@en ;
	.

fibo-loan-spc-stu:StudentLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:Loan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasBorrower ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-be-le-lp:LegallyCompetentNaturalPerson ;
			] ;
		]
		;
	rdfs:label "student loan"@en ;
	skos:definition "loan provided for the purposes of education, allowing students and parents/guardians to borrow money for college"@en ;
	cmns-av:explanatoryNote "Student loans may include loans for graduate and professional education. Student loans may be obtained from government institutions, from private sources such as a bank or financial institution, or from other organizations."@en ;
	.

fibo-loan-reln-mtg:ClosedEndMortgageLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:ClosedEndCredit ,
		fibo-loan-reln-mtg:LoanSecuredByRealEstate
		;
	rdfs:label "closed-end mortgage loan" ;
	skos:definition "loan secured by real estate with no ability for the borrower to receive additional funds under the loan at a later date" ;
	cmns-av:adaptedFrom "MISMO Business Glossary, available at https://www.mismo.org/standards-resources/business-glossary/" ;
	.

fibo-loan-reln-mtg:ClosedEndReverseMortgage
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-reln-mtg:ClosedEndMortgageLoan ,
		fibo-loan-reln-mtg:ReverseMortgageLoan
		;
	rdfs:label "closed-end reverse mortgage" ;
	dct:source "Instructions for the Preparation of Consolidated Reports of Condition and Income, FFIEC 031 and FFIEC 041, Updated March 2023, clause A-91" ;
	skos:definition "reverse mortgage that provides a lump sum payment to the borrower at closing, with no ability for the borrower to receive additional funds under the mortgage at a later date" ;
	cmns-av:explanatoryNote "Normally, closed-end reverse mortgages are first liens." ;
	.

fibo-loan-reln-mtg:LoanSecuredByRealEstate
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:CollateralizedLoan ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isCollateralizedBy ;
			owl:someValuesFrom fibo-fnd-plc-rp:RealProperty ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-fnd-agr-ctr:DisclosureProvision ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-fnd-agr-ctr:UseOfProceedsProvision ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-loan-reln-mtg:hasInitialFundingDate ;
			owl:someValuesFrom fibo-fbc-pas-caa:TransactionDate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:refersTo ;
			owl:someValuesFrom fibo-fbc-dae-dbt:SecurityAgreement ;
		]
		;
	rdfs:label "loan secured by real estate" ;
	dct:source
		"Consolidated Reports of Condition and Income for a Bank with Domestic and Foreign Offices - FFIEC 031; Board of Governors of the Federal Reserve System OMB Number 7100-0036, Federal Deposit Insurance Corporation OMB Number 3064-0052, Office of the Comptroller of the Currency OMB Number 1557-0081, dated 20240930" ,
		"Instructions for the Preparation of Consolidated Reports of Condition and Income, FFIEC 031 and FFIEC 041, Updated March 2023, clause A-91"
		;
	skos:definition "loan that, at origination, is secured wholly or substantially by a lien or liens on real property for which the lien or liens are central to the extension of the credit - that is, the borrower would not have been extended credit in the same amount or on terms as favorable without the lien or liens on real property" ;
	skos:example "Examples include (a) Construction, land development, and other land loans: (1) 1-4 family residential construction loans, and (2) Other construction loans and all land development and other land loans; (b) Secured by farmland (including farm residential and other improvements); (c) Secured by 1-4 family residential properties: (1) Revolving, open-end loans secured by 1-4 family residential properties and extended under lines of credit, and (2) Closed-end loans secured by 1-4 family residential properties including those secured by first liens and those secured by junior liens; (d) Secured by multifamily (5 or more) residential properties; and (e) Secured by nonfarm nonresidential properties: (1) Loans secured by owner-occupied nonfarm nonresidential, and (2) Loans secured by other nonfarm nonresidential properties."@en ;
	cmns-av:explanatoryNote
		"In general parlance, loans secured by real estate are often called mortgages or mortgage loans. This usage conflates a number of related concepts, which would limit the usability of FIBO for financial institutions and regulators with respect to such loans. As described herein, many different kinds of loans can be secured by real estate, including various commercial, construction, agricultural, and consumer loans."@en ,
		"In the US, to be considered wholly or substantially secured by a lien or liens on real property, the estimated value of the real estate collateral at origination (after deducting any more senior liens held by others) must be greater than 50 percent of the principal amount of the loan at origination."@en ,
		"The borrower agrees to pay the lender over time, typically in a series of regular payments divided into principal and interest. The property then serves as collateral to secure the loan."@en
		;
	.

fibo-loan-reln-mtg:Mortgage
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:SecurityAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isCollateralizedBy ;
			owl:someValuesFrom fibo-fnd-plc-rp:RealProperty ;
		]
		;
	rdfs:label "mortgage" ;
	skos:definition "grant of financial interest in real property to a party that is not an owner of that real property and is recorded by a registration authority" ;
	cmns-av:explanatoryNote "A mortgage prevents transfer of the ownership of the real property unless the financial interest is satisfied. Any loan can be collateralized by a mortgage, including, for example, a bail bond."@en ;
	.

fibo-loan-reln-mtg:OpenEndMortgageLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-ln-ln:OpenEndCredit ,
		fibo-loan-reln-mtg:LoanSecuredByRealEstate
		;
	rdfs:label "open-end mortgage loan" ;
	skos:definition "loan secured by real estate with a provision that the outstanding loan amount may be increased upon mutual agreement of the lender and the borrower" ;
	cmns-av:adaptedFrom "MISMO Business Glossary, available at https://www.mismo.org/standards-resources/business-glossary/" ;
	.

fibo-loan-reln-mtg:OpenEndReverseMortgage
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-reln-mtg:OpenEndMortgageLoan ,
		fibo-loan-reln-mtg:ReverseMortgageLoan
		;
	rdfs:label "open-end reverse mortgage" ;
	dct:source "Instructions for the Preparation of Consolidated Reports of Condition and Income, FFIEC 031 and FFIEC 041, Updated March 2023, clause A-91" ;
	skos:definition "reverse mortgage structured like a home equity line of credit in that it provides the borrower with additional funds after closing (either as fixed monthly payments, under a line of credit, or both)" ;
	cmns-av:explanatoryNote "Normally, open-end reverse mortgages are first liens. These include combinations of both a lump sum payment to the borrower at closing and payments after the closing of the loan." ;
	.

fibo-loan-reln-mtg:ReverseMortgageLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-loan-reln-mtg:LoanSecuredByRealEstate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasCreditLimit ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryAmount ;
		]
		;
	rdfs:label "reverse mortgage loan" ;
	skos:definition "loan secured by real estate that pays money to the borrower against a set principal limit based on the value of existing equity in the underlying collateral" ;
	cmns-av:explanatoryNote "The interest accrued is added to the principal balance." ;
	.

fibo-loan-reln-mtg:hasInitialFundingDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasEffectiveDate ;
	rdfs:label "has initial funding date" ;
	skos:definition "relates a mortgage to the date on which the contract is consummated, officially creating the obligations therein" ;
	cmns-av:synonym "has closing date" ;
	.

fibo-loan-reln-mtg:isARMConvertible
	a owl:DatatypeProperty ;
	rdfs:label "is ARM convertible"@en ;
	rdfs:domain fibo-loan-reln-mtg:LoanSecuredByRealEstate ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether or not the loan can be converted into an adjustable-rate mortgage contract (ARM)"@en ;
	.

fibo-sec-dbt-abs:AutoAssetBackedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:AssetBackedSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-sec-dbt-abs:AutoDebtPool ;
		]
		;
	rdfs:label "auto asset-backed security"@en ;
	skos:definition "asset-backed security that is backed by an underlying pool of auto-related loans and/or leases"@en ;
	cmns-av:adaptedFrom "https://content.naic.org/sites/default/files/capital-markets-primer-auto-abs.pdf" ;
	cmns-av:explanatoryNote
		"Auto asset-backed securities (auto ABS) are typically structured finance securities that are collateralized by auto loans or leases, such as those to prime (good credit standing) and subprime (poor credit standing) borrowers. Loans or leases are bundled into pools and transferred to a special-purpose entity (SPE), which, in turn, transfers the pool to a (bankruptcy remote) trust. Payments on the underlying auto loans and leases are pooled in the trust, and the funds are used to pay note investors their respective principal which, in turn, transfers the pool to a (bankruptcy remote) trust, i.e., one that protects the security from bankruptcy. Payments on the underlying auto loans and leases are pooled in the trust, and the funds are used to pay note investors their respective principal and interest when due. Any leftover funds - known as excess spread, or the net interest margin - are paid to the equity holder (usually the issuer, such as an auto finance company)."@en ,
		"If the credit risk of the pool has been decoupled from the institution via an SPV, then an auto asset-backed security is also a structured finance instrument."@en
		;
	.

fibo-sec-dbt-abs:AutoDebtPool
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-pls:DebtPool ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasPart ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fbc-dae-dbt:MotorVehicleLease
					fibo-loan-spc-cns:MotorVehicleLoan
				) ;
			] ;
		]
		;
	rdfs:label "auto debt pool"@en ;
	skos:definition "debt pool of loans and/or leases that are motor vehicle-related"@en ;
	.

fibo-sec-dbt-abs:BondPool
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-pls:DebtPool ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasPart ;
			owl:someValuesFrom fibo-sec-dbt-bnd:Bond ;
		]
		;
	rdfs:label "bond pool"@en ;
	skos:definition "debt pool of consisting of bonds"@en ;
	.

fibo-sec-dbt-abs:ConsumerAssetBackedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:AssetBackedSecurity ,
		fibo-sec-dbt-pbs:StructuredFinanceInstrument
		;
	rdfs:label "consumer asset-backed security"@en ;
	skos:definition "structured finance securities collateralized by pools of auto loans and leases (auto ABS), credit card receivables (credit card ABS) or student loans (student loan ABS)"@en ;
	cmns-av:adaptedFrom "https://content.naic.org/sites/default/files/capital-markets-primer-consumer-abs.pdf" ;
	.

fibo-sec-dbt-abs:ControlledAmortizationAssetBackedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:AssetBackedSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-sec-sec-pls:DebtPool ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRepaymentTerms ;
			owl:someValuesFrom fibo-sec-dbt-bnd:BondAmortizationPaymentTerms ;
		]
		;
	rdfs:label "controlled amortization asset-backed security" ;
	owl:disjointWith fibo-sec-dbt-abs:FullyAmortizingAssetBackedSecurity ;
	skos:definition "asset-backed security based on a pool of bonds securitized using a controlled amortization structure" ;
	cmns-av:adaptedFrom "http://www.investinginbonds.com/learnmore.asp?catid=11&subcatid=57&id=15" ;
	cmns-av:explanatoryNote
		"Controlled-amortization ABS resemble corporate bonds with a sinking fund. After a predetermined 'revolving' period during which only interest payments are made, these securities attempt to return principal to investors in a series of defined periodic payments that usually occur over less than a year." ,
		"Revolving debt (primarily credit card receivables, but also HELOCs, trade receivables, dealer floor-plan loans and some leases) may be securitized using a controlled amortization structure. This is a method of providing investors with a relatively predictable repayment schedule, even though the underlying assets are nonamortizing. A risk inherent in this kind of ABS is an early amortization event."
		;
	.

fibo-sec-dbt-abs:CreditCardAccountPool
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-pls:DebtPool ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasPart ;
			owl:someValuesFrom fibo-loan-spc-crd:CreditCardAccount ;
		]
		;
	rdfs:label "credit card account pool"@en ;
	skos:definition "pool of credit card receivables associated with designated accounts"@en ;
	cmns-av:adaptedFrom "Federal Deposit Insurance Corporation (FDIC) Credit Card Securitization Manual, available at https://www.fdic.gov/regulations/examinations/credit_card_securitization/ch2.html"@en ;
	cmns-av:explanatoryNote "In a credit card securitization transaction only the receivables are sold, not the accounts that generate the receivables. The financial institution retains legal ownership of the credit card accounts and can continue to change the terms on the accounts. Accounts corresponding to securitized loans are typically referred to as the designated accounts (or sometimes trust accounts). The initial outstanding balances on the designated accounts are sold to the trust as are the rights to any new charges on the designated accounts. Subsequently, as cardholder purchase activity generates more receivables on the designated accounts, these new receivables are purchased by the trust from the originating institution/seller/transferor. The trust uses the monthly principal payments received from the cardholders to acquire these new charges or receivables. When the securitization is initially set up, the originating institution/seller adds sufficient receivables to support the principal balance of the certificates plus an additional amount (seller's interest) that serves to absorb fluctuations in the outstanding balance of the receivables. The originating institution/seller will make subsequent additions to the trust in order to keep the seller's interest at the required level."@en ;
	.

fibo-sec-dbt-abs:CreditCardAssetBackedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:AssetBackedSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-sec-dbt-abs:CreditCardAccountPool ;
		]
		;
	rdfs:label "credit card asset-backed security"@en ;
	skos:definition "asset-backed security based on credit card receivables"@en ;
	cmns-av:adaptedFrom "Federal Deposit Insurance Corporation (FDIC) Credit Card Securitization Manual, available at https://www.fdic.gov/regulations/examinations/credit_card_securitization/ch2.html"@en ;
	cmns-av:explanatoryNote "Credit card securitizations currently represent the primary funding vehicle for unsecured revolving consumer credit. Similar to mortgage and other asset securitizations, the financial institution that originates the credit card receivables sells a group of these receivables to a trust. The trust then creates and sells certificates backed by the credit card receivables to investors, which are predominately institutional investors. Very few credit card ABS are marketed to retail customers, primarily due to the complex nature of the transactions and the need to continually monitor various performance indices on the underlying receivables. The underlying credit card receivables generate income to support the interest payments on the certificates."@en ;
	.

fibo-sec-dbt-abs:FullyAmortizingAssetBackedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:AssetBackedSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-sec-sec-pls:DebtPool ;
		]
		;
	rdfs:label "fully amortizing asset-backed security" ;
	skos:definition "asset-backed security based on a pool of debt instruments that returns principal to investors over the life of the security" ;
	cmns-av:adaptedFrom "http://www.investinginbonds.com/learnmore.asp?catid=11&subcatid=57&id=15" ;
	cmns-av:explanatoryNote
		"Fully amortizing asset-backed securities are designed to closely reflect the full repayment of the underlying loans through scheduled interest and principal payments." ,
		"These are typically backed by HELs, auto loans, manufactured-housing contracts and other fully amortizing assets. Prepayment risk is a key consideration with such ABS, although the rate of prepayment may vary considerably by the type of underlying asset."
		;
	.

fibo-sec-dbt-abs:HomeEquityLineOfCreditPool
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-pls:DebtPool ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasPart ;
			owl:someValuesFrom fibo-loan-spc-cns:HomeEquityLineOfCredit ;
		]
		;
	rdfs:label "home equity line of credit pool"@en ;
	skos:definition "debt pool consisting of home equity loans"@en ;
	.

fibo-sec-dbt-abs:HomeEquityLoanAssetBackedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:AssetBackedSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-sec-dbt-abs:HomeEquityLineOfCreditPool ;
		]
		;
	rdfs:label "home equity loan asset-backed security"@en ;
	skos:definition "asset-backed security based on home equity loan receivables"@en ;
	cmns-av:explanatoryNote
		"If the credit risk of the pool has been decoupled from the institution via an SPV, then home equity asset-backed securities are also structured finance instruments."@en ,
		"Similar to mortgages, home equity loans are often taken out by borrowers who have less-than-stellar credit scores or few assets - the reason why they didn’t qualify for a mortgage. These are amortizing loans - that is, payment goes toward satisfying a specific sum and consists of three categories: interest, principal, and prepayments."@en
		;
	.

fibo-sec-dbt-abs:StudentLoanAssetBackedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:AssetBackedSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-sec-dbt-abs:StudentLoanPool ;
		]
		;
	rdfs:label "student loan asset-backed security"@en ;
	skos:definition "asset-backed security based on student loan receivables"@en ;
	cmns-av:explanatoryNote
		"If the credit risk of the pool has been decoupled from the institution via an SPV, then student loan asset-backed securities are also structured finance instruments."@en ,
		"The main purpose behind Student Loan ABS is to diversify the risk for lenders across many investors. By pooling and then packaging the loans into securities and selling them to investors, agencies can spread around the default risk, which allows them to give out more loans and larger loans. This way, more students have access to loans, investors have a diversifying investment instrument, and lenders can generate consistent cash flow from their securitization and debt collection services."@en
		;
	.

fibo-sec-dbt-abs:StudentLoanPool
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-pls:DebtPool ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasPart ;
			owl:someValuesFrom fibo-loan-spc-stu:StudentLoan ;
		]
		;
	rdfs:label "student loan pool"@en ;
	skos:definition "debt pool consisting of student loans"@en ;
	.

fibo-sec-dbt-bnd:AmortizingBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRepaymentTerms ;
			owl:someValuesFrom fibo-sec-dbt-bnd:BondAmortizationPaymentTerms ;
		]
		;
	rdfs:label "amortizing bond" ;
	owl:disjointWith fibo-sec-dbt-bnd:BulletBond ;
	skos:definition "bond that regularly pays down the principal (face value) on the debt along with its interest expense over the life of the bond" ;
	.

fibo-sec-dbt-bnd:Bond
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditAgreementRepaidAtMaturity ,
		fibo-sec-dbt-dbti:TradableDebtInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-sec-iss:hasSeries ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasInterestPaymentTerms ;
			owl:someValuesFrom fibo-sec-dbt-bnd:CouponPaymentTerms ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRepaymentTerms ;
			owl:someValuesFrom fibo-sec-dbt-bnd:BondPrincipalRepaymentTerms ;
		]
		;
	rdfs:label "bond" ;
	skos:definition "tradable debt instrument representing a loan in which the issuer owes the holder(s) a debt" ;
	cmns-av:explanatoryNote "Depending on the terms of the contract, the issuer is obliged to pay interest (the coupon) and/or to repay the principal at maturity. The most common bonds are corporate or governmental, typically used to finance specific projects or operations." ;
	.

fibo-sec-dbt-bnd:BondAmortizationPaymentTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:BondPrincipalRepaymentTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:someValuesFrom fibo-fbc-dae-dbt:AmortizationSchedule ;
		]
		;
	rdfs:label "bond amortization payment terms" ;
	owl:disjointWith fibo-sec-dbt-bnd:BulletPrincipalRepaymentTerms ;
	skos:definition "terms that include a schedule for repayment of the principal over the lifetime of the bond, typically in equal payments at regular intervals" ;
	.

fibo-sec-dbt-bnd:BondConversionTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-iss:ConversionTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-sec-iss:specifiesConversionInto ;
			owl:someValuesFrom fibo-sec-eq-eq:ListedShare ;
		]
		;
	rdfs:label "bond conversion terms" ;
	skos:definition "terms indicating when a convertible bond can be converted to another security (usually a publicly traded share issued by of the same issuer)" ;
	.

fibo-sec-dbt-bnd:BondCoupon
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:InterestRate ;
	rdfs:label "bond coupon" ;
	skos:definition "interest rate on a debt security that the issuer promises to pay to the holder until maturity, expressed as an annual percentage of the face value" ;
	cmns-av:synonym
		"coupon percent rate" ,
		"coupon rate" ,
		"nominal yield"
		;
	.

fibo-sec-dbt-bnd:BondInsurance
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-dae-gty:InsurancePolicy ;
	rdfs:label "bond insurance" ;
	skos:definition "insurance policy that a bond issuer purchases that guarantees the repayment of the principal and all associated interest payments to the bondholders in the event of default" ;
	.

fibo-sec-dbt-bnd:BondPrincipalRepaymentTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:PrincipalRepaymentTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:someValuesFrom fibo-fnd-pas-psch:PaymentSchedule ;
		]
		;
	rdfs:label "bond principal repayment terms" ;
	owl:disjointWith fibo-sec-dbt-dbti:CallFeature ;
	skos:definition "terms for the repayment of the principal on a bond" ;
	.

fibo-sec-dbt-bnd:BondRegistrar
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:LegalAgent ,
		cmns-ra:Registrar ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:registers ;
			owl:someValuesFrom fibo-sec-dbt-bnd:Bond ;
		]
		;
	rdfs:label "bond registrar" ;
	skos:definition "party responsible for maintaining records on behalf of the issuer that identify the owners of a registered bond issue" ;
	cmns-av:explanatoryNote "The trustee under a bond contract often also acts as registrar." ;
	.

fibo-sec-dbt-bnd:BondVariableCoupon
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:VariableInterestRate ,
		fibo-sec-dbt-bnd:BondCoupon
		;
	rdfs:label "bond variable coupon" ;
	skos:definition "bond coupon that has a variable interest rate" ;
	.

fibo-sec-dbt-bnd:BondWithPartialCall
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:CallableBond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasCallFeature ;
			owl:someValuesFrom fibo-sec-dbt-bnd:PartialCallFeature ;
		]
		;
	rdfs:label "bond with partial call" ;
	skos:definition "bond with a feature whereby the issue can be partially called for amounts that are at the discretion of the issuer" ;
	.

fibo-sec-dbt-bnd:BondWithPublishedSinkingFund
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:AmortizingBond ;
	rdfs:label "bond with published sinking fund" ;
	skos:definition "bond whereby amortization is via a known and published schedule" ;
	.

fibo-sec-dbt-bnd:BondWithWarrant
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:involves ;
			owl:someValuesFrom fibo-der-drc-raw:Warrant ;
		]
		;
	rdfs:label "bond with warrant" ;
	dct:source "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-05" ;
	skos:definition "bond that is issued together with one or more warrant(s) attached as part of the offer, the warrant(s) granting the holder the right to purchase a designated security, often the common stock of the issuer of the debt, at a specified price" ;
	cmns-av:explanatoryNote "This concept is needed primarily to support cases where the bond issuer is the issuer of the warrant." ;
	.

fibo-sec-dbt-bnd:BuildAmericaBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalBond ;
	rdfs:label "Build America Bond" ;
	skos:definition "taxable municipal bond issued through December 31, 2010 under the American Recovery and Reinvestment Act of 2009 (ARRA)" ;
	cmns-av:explanatoryNote "BABs may be direct pay subsidy bonds or tax credit bonds." ;
	.

fibo-sec-dbt-bnd:BulletBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRepaymentTerms ;
			owl:someValuesFrom fibo-sec-dbt-bnd:BulletPrincipalRepaymentTerms ;
		]
		;
	rdfs:label "bullet bond" ;
	owl:disjointWith fibo-sec-dbt-bnd:CallableBond ;
	skos:definition "bond whose entire principal value is paid on the maturity date, rather than amortized over its lifetime" ;
	.

fibo-sec-dbt-bnd:BulletPrincipalRepaymentTerms
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:BondPrincipalRepaymentTerms ;
	rdfs:label "bond bullet principal repayment terms" ;
	skos:definition "terms for repayment of the principal for a bond as a single payment covering the whole principal amount" ;
	.

fibo-sec-dbt-bnd:CallableBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:isCallable ;
			owl:hasValue "true"^^xsd:boolean ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:hasExtraordinaryRedemptionProvision ;
			owl:onClass fibo-sec-dbt-bnd:ExtraordinaryRedemptionProvision ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasCallFeature ;
			owl:someValuesFrom fibo-sec-dbt-dbti:CallFeature ;
		]
		;
	rdfs:label "callable bond" ;
	skos:definition "bond that includes a stipulation allowing the issuer the right to repurchase and retire the bond at the call price after the call protection period" ;
	.

fibo-sec-dbt-bnd:CallableConvertibleBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:CallableBond ,
		fibo-sec-dbt-bnd:ConvertibleBond
		;
	rdfs:label "callable convertible bond" ;
	skos:definition "convertible bond that is also callable" ;
	.

fibo-sec-dbt-bnd:CertificateOfObligation
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalSecurity ;
	rdfs:label "certificate of obligation" ;
	skos:definition "municipal security available to governing councils in case of emergency, such as a natural disaster, that needs immediate action without time for voter referendum" ;
	cmns-av:abbreviation "CO" ;
	cmns-av:explanatoryNote
		"CO's are similar to GO bonds, except that they do not require voter approval before they are issued. The CO's are also guaranteed by the City's taxation power and are counted in the calculation of the tax rate that is needed to support debt payments." ,
		"For example, when a hurricane destroys the police and emergency services building, there is no time to go through the process of voter referendum. The local council must be able to borrow the money to set up provisional buildings and necessary equipment for police and emergency services so that the community is served in continuity."
		;
	.

fibo-sec-dbt-bnd:CertificateOfParticipation
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-fi:DebtInstrument ;
	rdfs:label "certificate of participation" ;
	skos:definition "debt instrument evidencing a pro rata share in a specific pledged revenue stream, usually lease payments by the issuer that are typically subject to annual appropriation" ;
	cmns-av:abbreviation "COP" ;
	cmns-av:explanatoryNote "A certificate of participation (COP) is a type of financing where an investor purchases a share of the lease revenues of a program rather than the bond being secured by those revenues. The certificate generally entitles the holder to receive a share, or participation, in the payments from a particular project. The payments are passed through the lessor to the certificate holders. The lessor typically assigns the lease and the payments to a trustee, which then distributes the payments to the certificate holders." ;
	.

fibo-sec-dbt-bnd:ConventionalGilt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:FixedCouponBond ,
		fibo-sec-dbt-bnd:UKGovernmentSecurity
		;
	rdfs:label "conventional gilt" ;
	rdfs:seeAlso <https://www.dmo.gov.uk/responsibilities/gilt-market/about-gilts/> ;
	skos:definition "fixed coupon bond issued by HM Treasury that guarantees to pay the holder of the gilt a fixed cash payment (coupon) every six months until the maturity date, at which point the holder receives the final coupon payment and the return of the principal" ;
	cmns-av:explanatoryNote "Conventional gilts are the simplest form of government bond and constitute around 75 percent of the gilt portfolio." ;
	.

fibo-sec-dbt-bnd:ConvertibleBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		fibo-sec-sec-iss:ConvertibleSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:onClass fibo-sec-dbt-bnd:BondConversionTerms ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "convertible bond" ;
	skos:definition "bond that gives the holder the right to convert the bond into a fixed number of shares (conversion ratio) if the equity price rises above a specified level (strike price)" ;
	cmns-av:explanatoryNote "If the equity price remains below the strike price throughout the term of the bond it matures and is redeemed like a regular bond. The conversion ratio and strike price are usually set when the convertible bond is issued." ;
	.

fibo-sec-dbt-bnd:CorporateBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom cmns-org:LegalEntity ;
			] ;
		]
		;
	rdfs:label "corporate bond" ;
	owl:disjointWith
		fibo-sec-dbt-bnd:GovernmentBond ,
		fibo-sec-dbt-bnd:MunicipalBond
		;
	skos:definition "bond issued by a company in order to raise financing" ;
	cmns-av:explanatoryNote
		"Corporate bonds are issued for purposes such as mergers and acquisitions, business expansion, or to cover ongoing operational needs, and are typically longer-term debt instruments that have a maturity of at least one year. Corporate debt instruments with maturity shorter than one year are referred to as commercial paper." ,
		"Note that some classification schemes consider any bond except those issued by a government in its own currency to be a corporate bond, for example, a bond issued by Canada in US dollars might be classified as a corporate bond. Bonds issued by multinational / supranational organizations such as the European Bank for Reconstruction and Development (EBRD) may also be considered corporate bonds rather than government bonds."
		;
	.

fibo-sec-dbt-bnd:CouponPaymentTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:InterestPaymentTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
			owl:someValuesFrom fibo-sec-dbt-bnd:BondCoupon ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasCurrency ;
			owl:someValuesFrom fibo-fnd-acc-cur:Currency ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:someValuesFrom fibo-fbc-dae-dbt:InterestPaymentSchedule ;
		]
		;
	rdfs:label "coupon payment terms" ;
	skos:definition "terms for payment of interest on a bond" ;
	.

fibo-sec-dbt-bnd:EquityLinkedBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:VariableCouponBond ;
	rdfs:label "equity linked bond" ;
	skos:definition "bond based on the return on an equity over time, i.e. the price and dividend payments or the total return (similar to total return swaps)" ;
	.

fibo-sec-dbt-bnd:ExtraordinaryRedemptionProvision
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:CallFeature ;
	rdfs:label "extraordinary redemption provision" ;
	skos:definition "provision that gives a bond issuer the right to call its bonds due to an unusual one-time occurrence, as specified in the offering statement" ;
	cmns-av:explanatoryNote "Such redemptions may occur when bond proceeds are not spent according to schedule; when bond proceeds are used in a way that makes nontaxable bond interest taxable; or when a catastrophe destroys the project being financed, among other reasons." ;
	.

fibo-sec-dbt-bnd:FirstRegularCouponDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "first regular coupon date" ;
	skos:definition "scheduled date for the first regular coupon payment, in a regular repeating series of coupon periods, after any non standard (long or short) first coupon period in the schedule" ;
	.

fibo-sec-dbt-bnd:FixedCouponBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		fibo-sec-dbt-dbti:FixedIncomeSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasInterestPaymentTerms ;
			owl:someValuesFrom fibo-sec-dbt-bnd:FixedCouponTerms ;
		]
		;
	rdfs:label "fixed coupon bond" ;
	owl:disjointWith fibo-sec-dbt-bnd:VariableCouponBond ;
	skos:definition "bond whose coupon rate and principal amount are fixed at the time of origination or sale and remain constant while the security is outstanding" ;
	.

fibo-sec-dbt-bnd:FixedCouponTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:CouponPaymentTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
			owl:someValuesFrom fibo-fbc-dae-dbt:FixedInterestRate ;
		]
		;
	rdfs:label "fixed coupon terms" ;
	owl:disjointWith fibo-sec-dbt-bnd:VariableCouponTerms ;
	skos:definition "terms for payment of interest on a bond with a fixed interest rate" ;
	.

fibo-sec-dbt-bnd:FloatingRateNote
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:VariableCouponBond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
			owl:someValuesFrom fibo-ind-ir-ir:ReferenceInterestRate ;
		]
		;
	rdfs:label "floating rate note" ;
	skos:definition "bond with a variable interest rate based on a published reference interest rate" ;
	cmns-av:explanatoryNote 'The adjustments to the interest rate (coupon) are made periodically, usually on a quarterly or monthly basis, and are tied to a certain money-market index. Also known as a "floater". For example six months USD LIBOR + 0.20%.' ;
	.

fibo-sec-dbt-bnd:FullFaithCreditBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:UnsecuredBond ;
	rdfs:label "full faith credit bond" ;
	skos:definition "bond secured by an unconditional promise to pay by another entity" ;
	cmns-av:explanatoryNote "Full faith and credit bonds are typically backed by a government entity and are considered low risk." ;
	cmns-av:synonym "full faith and credit bond" ;
	.

fibo-sec-dbt-bnd:GeneralObligationMunicipalBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:FullFaithCreditBond ,
		fibo-sec-dbt-bnd:MunicipalBond
		;
	rdfs:label "general obligation municipal bond" ;
	owl:disjointWith fibo-sec-dbt-bnd:RevenueBond ;
	skos:definition "municipal bond that is backed by the full faith and credit and general resources of the issuing municipality, including its general taxing authority" ;
	cmns-av:abbreviation "GO bond" ;
	.

fibo-sec-dbt-bnd:GovernmentBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		fibo-sec-dbt-bnd:GovernmentIssuedDebtSecurity
		;
	rdfs:label "government bond" ;
	skos:definition "debt security issued by a government to fund government spending" ;
	cmns-av:synonym "government-issued bond" ;
	.

fibo-sec-dbt-bnd:GovernmentIssuedDebtSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:DebtInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-be-ge-ge:Polity ;
			] ;
		]
		;
	rdfs:label "government issued debt security" ;
	skos:definition "debt security issued by some government on behalf of some polity, including sovereign and municipal debt" ;
	.

fibo-sec-dbt-bnd:GreenBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
	rdfs:label "green bond" ;
	skos:definition "bond issued specifically to fund climate or environmental projects" ;
	cmns-av:explanatoryNote "These bonds are typically asset-linked and backed by the issuer's balance sheet. Green bonds finance projects aimed at energy efficiency, pollution prevention, sustainable agriculture, fishery and forestry, the protection of aquatic and terrestrial ecosystems, clean transportation, sustainable water management and the cultivation of environmentally friendly technologies, and often include incentives such as tax exemption." ;
	.

fibo-sec-dbt-bnd:ImplicitFullFaithCreditBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:UnsecuredBond ;
	rdfs:label "implicit full faith credit bond" ;
	skos:definition "bond issued by a government sponsored agency or corporation rather than by the government directly" ;
	cmns-av:explanatoryNote "It doesn't carry an explicit full faith and credit guarantee but the market believes the government wouldn't let it default or fail." ;
	cmns-av:synonym "implicit full faith and credit bond" ;
	.

fibo-sec-dbt-bnd:IndexLinkedBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:VariableIncomeBond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-ind-ei-ei:EconomicIndicator
					fibo-ind-ind-ind:MarketRate
				) ;
			] ;
		]
		;
	rdfs:label "index-linked bond" ;
	skos:definition "bond whose income may vary over time, because either the coupon rate or principal amount is related to a specific index, such as the Consumer Price Index" ;
	.

fibo-sec-dbt-bnd:InflationLinkedBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:IndexLinkedBond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-ind-ei-ei:InflationRate ;
		]
		;
	rdfs:label "inflation-linked bond" ;
	skos:definition "bond indexed to inflation so that the principal or interest payments rise and fall with the rate of inflation" ;
	cmns-av:abbreviation "ILB" ;
	cmns-av:explanatoryNote "Inflation-linked bonds are primarily issued by sovereign governments, such as the U.S. and the UK." ;
	cmns-av:synonym "inflation-indexed bond" ;
	.

fibo-sec-dbt-bnd:LastRegularCouponDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "last regular coupon date" ;
	skos:definition "scheduled date of the last regular coupon payment, that is the last of the payments that are made according to a regular repeating series of coupon periods, before any non-standard (long or short) final coupon period in the schedule" ;
	.

fibo-sec-dbt-bnd:ListedBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		fibo-sec-sec-lst:ListedSecurity
		;
	rdfs:label "listed bond" ;
	owl:disjointWith fibo-sec-dbt-bnd:UnlistedBond ;
	skos:definition "bond that may be traded on an exchange" ;
	cmns-av:explanatoryNote "Most exchange traded bonds are corporate bonds (but most corporate bonds are not exchange traded bonds)." ;
	.

fibo-sec-dbt-bnd:LotteryConvention
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention
		;
	rdfs:label "lottery convention" ;
	skos:definition "convention involving an impartial lottery for determining which securities are subject to partial call or partial redemption" ;
	.

fibo-sec-dbt-bnd:MakeWholeCall
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:CallEvent ;
	rdfs:label "make whole call" ;
	skos:definition "call allowing the issuer to pay off remaining debt early" ;
	cmns-av:explanatoryNote "The issuer typically has to make a lump sum payment to the investor(s) derived from a formula based on the net present value (NPV) of future coupon payments that will not be paid incrementally because of the call combined with the principal payment the investor would have received at maturity." ;
	.

fibo-sec-dbt-bnd:MandatoryConvertibleBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:ConvertibleBond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-sec-dbt-bnd:BondConversionTerms ;
		]
		;
	rdfs:label "mandatory convertible bond" ;
	skos:definition "convertible bond that converts into shares at maturity regardless of the equity price" ;
	cmns-av:explanatoryNote "The conversion ratio at maturity reflects the equity price and par value of the bond when issued. There is also typically a second higher conversion ratio if the equity price rises above the strike during the term of the bond." ;
	.

fibo-sec-dbt-bnd:MediumTermNote
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
	rdfs:label "medium term note" ;
	skos:definition "bond issued over time under a shelf registration program, where each issue may have a different coupon and maturity typically ranging from one to ten years" ;
	cmns-av:explanatoryNote
		"A medium-term note (MTN) is a debt note that usually matures (is paid back) in 5 to 10 years, but the term may be less than one year or as long as 100 years. They can be issued on a fixed or floating coupon basis." ,
		"By shelf registration we mean the security registration process where an issuer registers in advance, and can issue lots of securities for up to three years." ,
		"Medium term notes are typically issued by corporations and financial institutions, although GSEs also have MTN programs. MTNs may be issued under a shelf registration program which allows the company to issue bonds over time with varying maturities and coupons. Companies issue MTNs to have a more flexible source of funding. They may also issue MTN in response to 'reverse inquiry' by investors looking for bonds with specific maturities, issue size and coupon."
		;
	.

fibo-sec-dbt-bnd:MunicipalBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:GovernmentBond ,
		fibo-sec-dbt-bnd:MunicipalSecurity
		;
	rdfs:label "municipal bond" ;
	owl:disjointWith fibo-sec-dbt-bnd:SovereignBond ;
	skos:definition "government bond that may be issued by a regional, rather than national, authority" ;
	cmns-av:abbreviation "muni" ;
	cmns-av:explanatoryNote "Municipal bonds may be issued by states, cities, counties, special tax districts or special agencies or authorities of state or local governments." ;
	.

fibo-sec-dbt-bnd:MunicipalDebtFundsUsage
	a owl:Class ;
	rdfs:subClassOf cmns-doc:LegalDocument ;
	rdfs:label "municipal debt funds usage" ;
	skos:definition "official statement specifying how the funds raised via a new issue of municipal securities are to be applied" ;
	.

fibo-sec-dbt-bnd:MunicipalDebtRemarketingAgent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:Dealer ,
		fibo-fnd-agr-ctr:ContractThirdParty
		;
	rdfs:label "municipal debt remarketing agent" ;
	skos:definition "municipal securities dealer responsible for reselling to investors securities (such as variable rate demand obligations and other tender option bonds) that have been tendered for purchase by their owner" ;
	cmns-av:explanatoryNote "The remarketing agent also typically is responsible for resetting the interest rate for a variable rate issue and may act as tender agent." ;
	.

fibo-sec-dbt-bnd:MunicipalDebtSourceOfFunds
	a owl:Class ;
	rdfs:subClassOf cmns-doc:LegalDocument ;
	rdfs:label "municipal debt source of funds" ;
	skos:definition "official statement identifying the source of funds for a new issue of municipal securities" ;
	.

fibo-sec-dbt-bnd:MunicipalNote
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalSecurity ;
	rdfs:label "municipal note" ;
	skos:definition "short-term obligation to repay a specified principal amount on a certain date, together with interest at a stated rate, usually payable from a defined source of anticipated revenues" ;
	cmns-av:explanatoryNote "Notes usually mature in one year or less, although notes of longer maturities are also issued." ;
	.

fibo-sec-dbt-bnd:MunicipalSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:GovernmentIssuedDebtSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:someValuesFrom fibo-sec-dbt-bnd:MunicipalDebtFundsUsage ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom [
					a owl:Class ;
					owl:unionOf (
						fibo-be-ge-ge:MunicipalEntity
						fibo-be-ge-ge:RegionalSovereignty
					) ;
				] ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:hasFundingSource ;
			owl:someValuesFrom fibo-sec-dbt-bnd:MunicipalDebtSourceOfFunds ;
		]
		;
	rdfs:label "municipal security" ;
	owl:disjointWith fibo-sec-dbt-bnd:SovereignDebtInstrument ;
	skos:definition "debt obligation issued by a regional governmental entity" ;
	cmns-av:explanatoryNote "A municipal security is typically a bond, note, warrant, certificate or other similar obligation issued by a state or local government or their agencies or authorities (such as cities, towns, villages, counties or special districts or authorities). A prime feature of most municipal securities is that interest or other investment earnings on them are generally excluded from gross income of the bondholder for federal income tax purposes. Some municipal securities are subject to federal income tax, although the issuers or bondholders may receive other federal tax advantages for certain types of taxable municipal securities. Some examples include Build America Bonds, municipal fund securities and direct pay subsidy bonds." ;
	.

fibo-sec-dbt-bnd:MunicipalTrustee
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-tr-tr:Trustee ,
		fibo-fbc-fct-fse:FinancialInstitution
		;
	rdfs:label "municipal trustee" ;
	skos:definition "financial institution with trust powers, designated by the issuer, that acts, pursuant to a bond contract, in a fiduciary capacity for the benefit of the bondholders in enforcing the terms of the bond contract" ;
	cmns-av:explanatoryNote "In many cases, the trustee also acts as custodian, paying agent, registrar and/or transfer agent for the bonds." ;
	.

fibo-sec-dbt-bnd:OriginalIssueDiscountBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtMaturity ;
			owl:hasValue fibo-sec-dbt-dbti:ParValue ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:hasOriginalIssueDiscountAmount ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "original issue discount bond" ;
	skos:definition "interest-bearing bond issued at a deep discount to face value" ;
	cmns-av:explanatoryNote
		"An original issue discount (OID) is the discount in price from a bond's face value at the time a bond or other debt instrument is first issued. The OID is the amount of discount or the difference between the original face value and the price paid for the bond." ,
		"The principal amount accretes over time at a constant accrual rate and is redeemed at full face value at maturity."
		;
	cmns-av:synonym "OID bond" ;
	.

fibo-sec-dbt-bnd:PartialCall
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:CallEvent ;
	rdfs:label "partial call" ;
	skos:definition "call of part of an issue" ;
	.

fibo-sec-dbt-bnd:PartialCallFeature
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-dbti:CallFeature ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:hasPartialRedemptionAllocationConvention ;
			owl:someValuesFrom fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention ;
		]
		;
	rdfs:label "partial call feature" ;
	skos:definition "call feature whereby the issuer can recall part of the issue on scheduled dates, where bonds are selected to be called according to some rule, or by selecting various bonds at random" ;
	.

fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-bd:Convention ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasRateValue ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		]
		;
	rdfs:label "partial redemption allocation convention" ;
	skos:definition "convention used to determine how the partial call will be actioned with respect to bond selection" ;
	.

fibo-sec-dbt-bnd:PercentageCumulativeAverageValue
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-bnd:RateBasisConvention
		;
	rdfs:label "percentage cumulative average value" ;
	skos:definition "rate basis calculated as a percentage of cumulative average value" ;
	cmns-av:abbreviation "percentage CAV" ;
	.

fibo-sec-dbt-bnd:PercentageParValue
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-bnd:RateBasisConvention
		;
	rdfs:label "percentage par value" ;
	skos:definition "rate basis calculated as a percentage of par value" ;
	.

fibo-sec-dbt-bnd:PerpetualBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
	rdfs:label "perpetual bond" ;
	skos:definition "bond that has no maturity date, i.e., one that pays interest in perpetuity" ;
	cmns-av:explanatoryNote "Perpetual bonds function much like dividend-paying stocks or certain preferred securities. Just as the owner of the stock receives a dividend payment as long as the stock is held, the perpetual bond owner receives an interest payment as long as the bond is held." ;
	cmns-av:synonym "consul" ;
	.

fibo-sec-dbt-bnd:ProRataConvention
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention
		;
	rdfs:label "pro rata convention" ;
	skos:definition "convention whereby securities that are subject to partial redemption are allocated proportionately" ;
	.

fibo-sec-dbt-bnd:RateBasisConvention
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-bd:Convention ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasRateValue ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		]
		;
	rdfs:label "rate basis convention" ;
	skos:definition "basis for a percentage quoted rate as used in specifying bond call percentage amounts" ;
	.

fibo-sec-dbt-bnd:RedemptionPayment
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-psch:PaymentEvent ,
		fibo-sec-dbt-dbti:RedemptionEvent
		;
	rdfs:label "redemption payment" ;
	skos:definition "repayment event involving payment of a bond's principal amount at maturity or when it is called" ;
	.

fibo-sec-dbt-bnd:RedemptionSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-psch:PaymentSchedule ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-sec-dbt-dbti:RedemptionEvent ;
		]
		;
	rdfs:label "redemption schedule" ;
	skos:definition "repayment schedule whereby a given percentage of a bond issue is redeemed on predefined dates" ;
	.

fibo-sec-dbt-bnd:RegulatoryCall
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:CallEvent ;
	rdfs:label "regulatory call" ;
	skos:definition "call triggered by some regulation-specific rule" ;
	.

fibo-sec-dbt-bnd:RemarketableBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:CorporateBond ,
		fibo-sec-dbt-bnd:FloatingRateNote
		;
	rdfs:label "remarketable bond" ;
	skos:definition "corporate bond program where the coupon rate on outstanding bonds is periodically reset through an auction process" ;
	cmns-av:explanatoryNote "A remarketing agent (dealer or underwriter) periodically surveys bond holders to identify those who want to sell bonds. The agent surveys market (or holds an auction) to determine interest rate at which the bonds can be resold. The rate on all outstanding bonds resets at the new rate. These programs are perpetual in the sense they often don't have a fixed maturity date, but the company can redeem them. If an auction fails, i.e., the agent can't place all the bonds then." ;
	.

fibo-sec-dbt-bnd:RevenueBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:MunicipalBond ,
		fibo-sec-dbt-bnd:SecuredBond
		;
	rdfs:label "revenue bond" ;
	skos:definition "municipal bond supported by the revenue from a specific project" ;
	cmns-av:explanatoryNote "Revenue bonds are municipal bonds that finance income-producing projects, such as toll bridges, highways, or local stadiums, and are secured by a specified revenue source. Typically, revenue bonds can be issued by any government agency or fund that is managed in the manner of a business, such as entities having both operating revenues and expenses." ;
	.

fibo-sec-dbt-bnd:SecuredBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
	rdfs:label "secured bond" ;
	owl:disjointWith fibo-sec-dbt-bnd:UnsecuredBond ;
	skos:definition "bond that is backed by collateral, such as a tangible asset or income stream, in addition to a general promise to pay" ;
	cmns-av:explanatoryNote "A secured bond may be collateralized by a claim on real assets, such as a factory or auto fleet; or by a claim on a revenue stream. A secured bond differs from a mortgage in that proceeds of the bond sale aren't used to acquire the asset." ;
	.

fibo-sec-dbt-bnd:SinkingFundAmortizationTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:BondAmortizationPaymentTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:isMandatory ;
			owl:onDataRange xsd:boolean ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "sinking fund amortization terms" ;
	skos:definition "terms for the paydown of principal in a sinking fund type of amortizing security" ;
	skos:editorialNote "At present there is only a schedule, there should be other terms for what happens on the scheduled dates. Sinking fund may be bullet e.g. x percent over year for y years. SF may be mandatory or contingent on some other economic event." ;
	.

fibo-sec-dbt-bnd:SovereignBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:GovernmentBond ,
		fibo-sec-dbt-bnd:SovereignDebtInstrument
		;
	rdfs:label "sovereign bond" ;
	skos:definition "bond issued by the government of a country" ;
	cmns-av:explanatoryNote "Sovereign bonds issued by G20 developed countries are generally full faith and credit obligations. Sovereign bonds issued by emerging and developing countries may be issued in local currency or a G7 currency, and may either be full faith and credit (unsecured) or secured." ;
	.

fibo-sec-dbt-bnd:SovereignDebtInstrument
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:GovernmentIssuedDebtSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-be-ge-ge:SovereignState ;
			] ;
		]
		;
	rdfs:label "sovereign debt instrument" ;
	skos:definition "debt security issued by the government of a country" ;
	.

fibo-sec-dbt-bnd:SpecialAssessmentBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:MunicipalBond ,
		fibo-sec-dbt-bnd:SecuredBond
		;
	rdfs:label "special assessment bond" ;
	skos:definition "municipal bond used to fund a development project that is payable from the revenues of an assessment (tax) on the community that is intended to benefit from the project" ;
	cmns-av:explanatoryNote "A special assessment is a charge imposed against a property in a particular locality because that property receives a special benefit by virtue of some public improvement, separate and apart from the general benefit accruing to the public at large. Special assessments may be apportioned according to the value of the benefit received, rather than merely the cost of the improvement." ;
	.

fibo-sec-dbt-bnd:SpecialObligationBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalBond ;
	rdfs:label "special obligation bond" ;
	skos:definition "bond secured by a limited revenue source, such as receipts derived from a designated project" ;
	.

fibo-sec-dbt-bnd:SpecialTaxBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:MunicipalBond ,
		fibo-sec-dbt-bnd:SecuredBond
		;
	rdfs:label "special tax bond" ;
	skos:definition "bond secured by revenues derived from designated taxes other than ad valorem taxes" ;
	skos:example "For example, bonds for a particular purpose might be supported by sales, cigarette, fuel or business license taxes." ;
	.

fibo-sec-dbt-bnd:StepUpBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		fibo-sec-dbt-dbti:FixedIncomeSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasInterestPaymentTerms ;
			owl:someValuesFrom fibo-sec-dbt-bnd:SteppedCouponTerms ;
		]
		;
	rdfs:label "step up bond" ;
	skos:definition "bond with a coupon that increases (steps up) while the bond is outstanding" ;
	cmns-av:explanatoryNote "The step change may be one time, or occur according to a schedule or at regular intervals." ;
	cmns-av:synonym "step down bond" ;
	.

fibo-sec-dbt-bnd:SteppedCouponTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:CouponPaymentTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
			owl:someValuesFrom fibo-sec-dbt-dbti:StepSchedule ;
		]
		;
	rdfs:label "stepped coupon terms" ;
	skos:definition "coupon payment terms for securities with a coupon that increases (steps up) while the bond is outstanding" ;
	.

fibo-sec-dbt-bnd:StripBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:ZeroCouponBond ,
		fibo-sec-dbt-dbti:Strip ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-sec-dbt-bnd:Bond ;
		]
		;
	rdfs:label "strip bond" ;
	skos:definition "bond that is part of a series of bonds formed by selling each interest payment and the principal amount of a bond as separate zero coupon bonds." ;
	.

fibo-sec-dbt-bnd:TaxAllocationBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:MunicipalBond ,
		fibo-sec-dbt-bnd:SecuredBond
		;
	rdfs:label "tax allocation bond" ;
	skos:definition "bond payable from the incremental increase in tax revenues realized from any increase in property value and other economic activity, often designed to capture the economic benefit resulting from a bond financing" ;
	cmns-av:explanatoryNote "Tax increment bonds, also known as tax allocation bonds, often are used to finance the redevelopment of blighted areas." ;
	.

fibo-sec-dbt-bnd:TreasuryBill
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:USTreasurySecurity ,
		fibo-sec-dbt-tstd:MoneyMarketInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtIssue ;
			owl:hasValue fibo-sec-dbt-dbti:AtADiscount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtMaturity ;
			owl:hasValue fibo-sec-dbt-dbti:ParValue ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
			owl:someValuesFrom fibo-ind-ir-ir:ReferenceInterestRate ;
		]
		;
	rdfs:label "treasury bill" ;
	rdfs:seeAlso
		<https://www.treasurydirect.gov/indiv/research/indepth/tbills/res_tbill.htm> ,
		<https://www.treasurydirect.gov/indiv/research/indepth/tbills/res_tbill_rates.htm>
		;
	skos:definition "short-term zero coupon treasury obligation with a maturity ranging from one to twelve months" ;
	cmns-av:abbreviation "T-bill" ;
	cmns-av:explanatoryNote "The pricing of T-bills is unique among U.S. government debt issues. Treasury bills are offered in multiples of $100 and in terms ranging from a few days to 52 weeks. Rather than providing interest payments as Treasury Bonds or Notes do, T-bills are sold at a discount, and the entire return is realized upon maturity. The price of a bill is determined at auction. The annualized interest rate earned on T-bills is equal to the difference between the purchase price and maturity value, divided by the maturity value." ;
	.

fibo-sec-dbt-bnd:TreasuryBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:SovereignBond ,
		fibo-sec-dbt-bnd:USTreasurySecurity
		;
	rdfs:label "treasury bond" ;
	rdfs:seeAlso <https://www.treasurydirect.gov/indiv/research/indepth/tbonds/res_tbond.htm> ;
	skos:definition "long term term coupon bearing treasury obligation issued in terms of 20 years or 30 years that pays interest every six months until they mature" ;
	.

fibo-sec-dbt-bnd:TreasuryInflationProtectedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:InflationLinkedBond ,
		fibo-sec-dbt-bnd:USTreasurySecurity ,
		fibo-sec-dbt-bnd:VariablePrincipalBond
		;
	rdfs:label "treasury inflation-protected security" ;
	rdfs:seeAlso <https://www.treasurydirect.gov/indiv/products/prod_tips_glance.htm> ;
	skos:definition "variable income bond whose principal is indexed to inflation or deflation and thus changes over the life of the security" ;
	cmns-av:abbreviation "TIPS" ;
	cmns-av:explanatoryNote "Treasury Inflation-Protected Securities, or TIPS, provide protection against inflation. The principal of a TIPS increases with inflation and decreases with deflation, as measured by the Consumer Price Index. When a TIPS matures, you are paid the adjusted principal or original principal, whichever is greater." ;
	.

fibo-sec-dbt-bnd:TreasuryNote
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:MediumTermNote ,
		fibo-sec-dbt-bnd:USTreasurySecurity
		;
	rdfs:label "treasury note" ;
	skos:definition "medium term coupon bearing treasury obligation with original maturity ranging from two to ten years" ;
	.

fibo-sec-dbt-bnd:UKGovernmentSecurity
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:SovereignDebtInstrument ;
	rdfs:label "U.K. Government security" ;
	rdfs:seeAlso <https://www.dmo.gov.uk/responsibilities/gilt-market/buying-selling/> ;
	skos:definition "debt instrument issued by HM Treasury and listed on the London Stock Exchange" ;
	cmns-av:explanatoryNote
		"If a private investor wishes to purchase gilts the secondary market can be accessed through a stockbroker, bank or the DMO's Purchase and Sale Service." ,
		"The term 'gilt' or 'gilt-edged security' is a reference to the primary characteristic of gilts as an investment: their security. This is a reflection of the fact that the British Government has never failed to make interest or principal payments on gilts as they fall due."
		;
	cmns-av:synonym
		"gilt" ,
		"gilt-edged security"
		;
	.

fibo-sec-dbt-bnd:USTreasurySecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:SovereignDebtInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isDenominatedIn ;
			owl:hasValue fibo-fnd-acc-4217:USDollar ;
		]
		;
	rdfs:label "U.S. Treasury security" ;
	skos:definition "debt instrument issued by the United States Department of the Treasury that carries a full faith and credit guarantee" ;
	.

fibo-sec-dbt-bnd:UnlistedBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
	rdfs:label "unlisted bond" ;
	skos:definition "bond that is traded over the counter rather than via an exchange or other listing facility" ;
	cmns-av:synonym "OTC Bond" ;
	.

fibo-sec-dbt-bnd:UnsecuredBond
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
	rdfs:label "unsecured bond" ;
	skos:definition "bond that is only secured by the bond issuer's good credit standing" ;
	cmns-av:explanatoryNote "Most unsecured bonds pose limited risk of default, as the organizations that issue them are typically financially sound." ;
	cmns-av:synonym "debenture" ;
	.

fibo-sec-dbt-bnd:VariableCouponBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:VariableIncomeBond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
			owl:someValuesFrom fibo-sec-dbt-bnd:BondVariableCoupon ;
		]
		;
	rdfs:label "variable coupon bond" ;
	skos:definition "bond that has a floating interest rate" ;
	cmns-av:explanatoryNote "The rate adjusts according to a predetermined formula outlined in the bond's prospectus or official statement." ;
	.

fibo-sec-dbt-bnd:VariableCouponTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:CouponPaymentTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-ind-ind-ind:MarketRate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:someValuesFrom fibo-sec-dbt-bnd:VariableInterestCalculationFormula ;
		]
		;
	rdfs:label "variable coupon terms" ;
	skos:definition "contractual terms specifying the calculation of the interest rate for a variable coupon bond" ;
	.

fibo-sec-dbt-bnd:VariableDebtPrincipal
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-dbti:PubliclyIssuedDebt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasMonetaryAmount ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryAmount ;
		]
		;
	rdfs:label "variable debt principal" ;
	skos:definition "principal that is defined in relation to some variable and so varies over time, as principal" ;
	cmns-av:explanatoryNote "Not the same as principal paydown. This is when the principal itself varies over time, usually as a result of being defined in relation to some index such as an inflation index. Forms the debt principal in instruments such as inflation bonds."@en ;
	.

fibo-sec-dbt-bnd:VariableIncomeBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		fibo-sec-dbt-dbti:VariableIncomeSecurity
		;
	rdfs:label "variable income bond" ;
	skos:definition "bond whose income may vary over time, because either the coupon rate or principal amount changes in line with an index or schedule over the life of the security" ;
	.

fibo-sec-dbt-bnd:VariableInterestCalculationFormula
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:FullyIndexedInterestRate ;
	rdfs:label "variable interest calculation formula" ;
	skos:definition "formula for the calculation of variable interest" ;
	.

fibo-sec-dbt-bnd:VariableInterestExpression
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:hasCeiling ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:hasFloor ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:onClass fibo-sec-dbt-dbti:FullyIndexedInterestRate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "variable interest expression" ;
	skos:definition "an expression used to determine a variable interest payment amount" ;
	.

fibo-sec-dbt-bnd:VariablePrincipalBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:VariableIncomeBond ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:definesTermsFor ;
			owl:someValuesFrom fibo-sec-dbt-bnd:VariableDebtPrincipal ;
		]
		;
	rdfs:label "variable principal bond" ;
	skos:definition "bond whose principal adjusts over time with changes in an index" ;
	cmns-av:explanatoryNote "The principal on variable principal bonds adjusts line with an index such as inflation or GDP. For example, for a bond linked to the CPI, if inflation rises two percent the principal increases by 2 percent. The coupon rate is typically fixed. The best-known example is TIPS or Treasury Inflation Protected Bonds, which are linked to the CPI. TIPs offer a real or inflation adjusted rate of return." ;
	.

fibo-sec-dbt-bnd:ZeroCouponBond
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:Bond ,
		fibo-sec-dbt-dbti:FixedIncomeSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtMaturity ;
			owl:hasValue fibo-sec-dbt-dbti:ParValue ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:hasOriginalIssueDiscountAmount ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasInterestPaymentTerms ;
			owl:someValuesFrom fibo-sec-dbt-bnd:ZeroCouponTerms ;
		]
		;
	rdfs:label "zero coupon bond" ;
	skos:definition "bond issued with a coupon rate of zero and that trades at a deep discount to face value" ;
	cmns-av:explanatoryNote
		"Fannie Mae also issues zero-coupon callable debt securities. Zero-coupon notes are debt securities on which no coupon interest is paid to the investor. Rather, the security is purchased at a discounted dollar price and matures at par. If the option on a callable zero-coupon security is exercised, it is redeemed at a higher dollar price than the original issue price. The yield for a callable zero-coupon security is based on the difference between the original discounted price and the principal payment at the call date." ,
		"The principal amount accretes over time at a constant accrual rate and is redeemed at full face value at maturity. In effect, the accrual rate is the coupon rate or yield which is added to the outstanding principal rather than being paid out to investors."
		;
	cmns-av:synonym "z-bond" ;
	.

fibo-sec-dbt-bnd:ZeroCouponTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-bnd:BondAmortizationPaymentTerms ,
		fibo-sec-dbt-bnd:FixedCouponTerms ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
			owl:hasValue fibo-sec-dbt-bnd:ZeroInterestRate ;
		]
		;
	rdfs:label "zero coupon terms" ;
	skos:definition "terms for payment of interest on a zero coupon bond" ;
	.

fibo-sec-dbt-bnd:ZeroInterestRate
	a
		owl:NamedIndividual ,
		fibo-fbc-dae-dbt:FixedInterestRate
		;
	rdfs:label "zero interest rate" ;
	skos:definition "an interest rate of zero (0) percent" ;
	fibo-fnd-acc-cur:hasRateValue "0.00"^^xsd:decimal ;
	.

fibo-sec-dbt-bnd:hasAwardDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has award date" ;
	rdfs:domain fibo-sec-dbt-bnd:MunicipalBond ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the date on which bonds are awarded to the lead manager or syndicate on negotiated deals, or the date of bidding on competitive deals" ;
	cmns-av:synonym "has sale date" ;
	.

fibo-sec-dbt-bnd:hasCallPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has call price" ;
	rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "indicates the amount of the call on the specified call date, typically the sum of par value and the call premium, as specified in the contract" ;
	cmns-av:explanatoryNote "This is the price a bond issuer or preferred stock issuer must pay investors to buy back, or call, all or part of an issue before the maturity date." ;
	cmns-av:synonym "has redemption price" ;
	.

fibo-sec-dbt-bnd:hasCallRateBasis
	a owl:ObjectProperty ;
	rdfs:label "has call rate basis" ;
	rdfs:domain fibo-sec-dbt-dbti:CallEvent ;
	rdfs:range fibo-sec-dbt-bnd:RateBasisConvention ;
	skos:definition "for each call event on the schedule, indicates whether the rate is expressed as a percentage of par or percentage of percentage of cumulative average value (CAV)" ;
	cmns-av:explanatoryNote "Zero coupon bonds and OID bonds are callable at an accreted value." ;
	.

fibo-sec-dbt-bnd:hasCeiling
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasRateValue ;
	rdfs:label "has ceiling" ;
	rdfs:domain fibo-sec-dbt-bnd:VariableInterestExpression ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the maximum variable interest payment amount" ;
	.

fibo-sec-dbt-bnd:hasConvertibleDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has convertible date" ;
	rdfs:domain fibo-sec-dbt-bnd:BondConversionTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "date on which a bond can be converted into the specified equity security" ;
	.

fibo-sec-dbt-bnd:hasExtraordinaryRedemptionProvision
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has extraordinary redemption provision" ;
	rdfs:domain fibo-fbc-fi-fi:RedemptionProvision ;
	rdfs:range fibo-sec-dbt-bnd:ExtraordinaryRedemptionProvision ;
	skos:definition "relates the redemption provision of a debt instrument to one-time provision that may be exercised by the issuer under certain circumstances" ;
	.

fibo-sec-dbt-bnd:hasFinalMaturityDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has final maturity date" ;
	rdfs:domain fibo-fbc-fi-fi:RedemptionProvision ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the final payment date of a financial instrument, at which point the principal (and all remaining interest) is due to be paid" ;
	.

fibo-sec-dbt-bnd:hasFirstCallPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-sec-dbt-bnd:hasCallPrice ;
	rdfs:label "has first call price" ;
	rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "indicates the amount of the call on the first call date as specified in the call schedule" ;
	.

fibo-sec-dbt-bnd:hasFirstCouponPaymentDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasExplicitDate ,
		cmns-dt:hasStartDate
		;
	rdfs:label "has first coupon payment date" ;
	rdfs:domain fibo-sec-dbt-bnd:CouponPaymentTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the first date on which the issuer or its agent expects or commits to make a coupon payment" ;
	cmns-av:explanatoryNote
		"The first coupon date sometimes occurs at an irregular time; that is, if the bond pays coupons every six months, the first coupon period may be longer or shorter than six months."@en ,
		"The first coupon payment period can be long or short when this date doesn't coincide with the start of a normal coupon payment period."@en
		;
	.

fibo-sec-dbt-bnd:hasFirstParCallDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasExplicitDate ,
		cmns-dt:hasStartDate
		;
	rdfs:label "has first par call date" ;
	rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the first date on which the bond may be called at par for redemption" ;
	.

fibo-sec-dbt-bnd:hasFirstParCallPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-sec-dbt-bnd:hasFirstCallPrice ;
	rdfs:label "has first par call price" ;
	rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "specifies the amount of the call on the first par call date as specified in the call schedule" ;
	.

fibo-sec-dbt-bnd:hasFirstPremiumCallDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasExplicitDate ,
		cmns-dt:hasStartDate
		;
	rdfs:label "has first premium call date" ;
	rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the first date on which the bond may be called for redemption at a price above par" ;
	.

fibo-sec-dbt-bnd:hasFirstPremiumCallPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-sec-dbt-bnd:hasFirstCallPrice ;
	rdfs:label "has first premium call price" ;
	rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "specifies the amount of the call on the first call date on which the bond may be called at a price above par as specified in the call schedule" ;
	.

fibo-sec-dbt-bnd:hasFirstPutDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-sec-dbt-bnd:hasPutDate ,
		cmns-dt:hasExplicitDate
		;
	rdfs:label "has first put date" ;
	rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the initial date on which the holder may sell the bond to the issuer prior to maturity" ;
	.

fibo-sec-dbt-bnd:hasFirstPutPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has first put price" ;
	rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "specifies the initial price at which the holder may sell the bond to the issuer prior to maturity" ;
	.

fibo-sec-dbt-bnd:hasFloor
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasRateValue ;
	rdfs:label "has floor" ;
	rdfs:domain fibo-sec-dbt-bnd:VariableInterestExpression ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the minimum variable interest payment amount" ;
	.

fibo-sec-dbt-bnd:hasFundingSource
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:hasDataSource ;
	rdfs:label "has funding source" ;
	rdfs:domain fibo-sec-dbt-bnd:MunicipalSecurity ;
	rdfs:range fibo-sec-dbt-bnd:MunicipalDebtSourceOfFunds ;
	skos:definition "indicates the source of funds for a new issue of municipal securities" ;
	.

fibo-sec-dbt-bnd:hasLastCouponPaymentDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasEndDate ,
		cmns-dt:hasExplicitDate
		;
	rdfs:label "has last coupon payment date" ;
	rdfs:domain fibo-sec-dbt-bnd:CouponPaymentTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the final date on which the issuer expects to make a final coupon payment" ;
	cmns-av:explanatoryNote "The last coupon date sometimes occurs at an irregular time; that is, if the bond pays coupons every six months, the last coupon period may be longer or shorter than six months."@en ;
	.

fibo-sec-dbt-bnd:hasLockoutPeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has lockout period" ;
	rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
	rdfs:range cmns-dt:DatePeriod ;
	skos:definition "indicates the period of time for which a callable security cannot be called and only interest coupon payments are received by the security holder" ;
	skos:example 'With a 10-year noncall 3-year ("10nc3") debt security, the security cannot be called for the first three years.' ;
	.

fibo-sec-dbt-bnd:hasMunicipalTrustee
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasThirdParty ;
	rdfs:label "has municipal trustee" ;
	rdfs:domain fibo-sec-dbt-bnd:MunicipalBond ;
	rdfs:range fibo-sec-dbt-bnd:MunicipalTrustee ;
	skos:definition "specifies the financial institution with trust powers, designated by the issuer, that acts, pursuant to a bond contract, in a fiduciary capacity for the benefit of the bondholders in enforcing the terms of the bond contract" ;
	.

fibo-sec-dbt-bnd:hasOriginalIssueDiscountAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has original issue discount amount" ;
	rdfs:domain fibo-sec-dbt-bnd:Bond ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the difference between the stated redemption price at maturity and the issue price" ;
	.

fibo-sec-dbt-bnd:hasPartialRedemptionAllocationConvention
	a owl:ObjectProperty ;
	rdfs:label "has partial redemption allocation convention" ;
	rdfs:domain fibo-sec-dbt-bnd:PartialCallFeature ;
	rdfs:range fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention ;
	skos:definition "indicates the convention used to determine how the redemption is allocated over the set of bond holders" ;
	.

fibo-sec-dbt-bnd:hasPenultimateCouponPaymentDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has penultimate coupon payment date" ;
	rdfs:domain fibo-sec-dbt-bnd:CouponPaymentTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the last coupon payment prior to maturity" ;
	cmns-av:explanatoryNote "This is important since the securities processing area needs to start its procedures in anticipation of maturity. For zero coupon bonds, it is the last compounding date prior to maturity."@en ;
	.

fibo-sec-dbt-bnd:hasPremiumAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has premium amount" ;
	rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the premium paid to a bond holder when the bond is called" ;
	.

fibo-sec-dbt-bnd:hasPutDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has put date" ;
	rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the date on which a security is subject to redemption by the bond holder" ;
	.

fibo-sec-dbt-bnd:hasPutFrequency
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasRecurrenceInterval ;
	rdfs:label "has put frequency" ;
	rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
	rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
	skos:definition "indicates the recurring window of time in which the put feature can be exercised" ;
	.

fibo-sec-dbt-bnd:hasRedemptionAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has redemption amount" ;
	rdfs:domain fibo-sec-dbt-bnd:RedemptionPayment ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the amount of the principal paid with a redemption payment" ;
	.

fibo-sec-dbt-bnd:hasRemarketingAgent
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasThirdParty ;
	rdfs:label "has remarketing agent" ;
	rdfs:domain fibo-sec-dbt-bnd:MunicipalSecurity ;
	rdfs:range fibo-sec-dbt-bnd:MunicipalDebtRemarketingAgent ;
	skos:definition "identifies the dealer responsible for reselling to investors securities (such as variable rate demand obligations and other tender option bonds) that have been tendered for purchase by their owner." ;
	.

fibo-sec-dbt-bnd:hasResetDateOffset
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has reset date offset" ;
	rdfs:domain fibo-sec-dbt-bnd:VariableCouponTerms ;
	rdfs:range fibo-fnd-dt-fd:RelativeDate ;
	skos:definition "indicates the offset from the coupon payment date on which the rate is reset" ;
	.

fibo-sec-dbt-bnd:isBankQualified
	a owl:DatatypeProperty ;
	rdfs:label "is bank qualified" ;
	rdfs:domain fibo-sec-dbt-bnd:MunicipalBond ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether or not a given municipal bond conforms with section 265(b)(3) of the IRS tax code; when purchased by a commercial bank for its portfolio, such designation allows the bank to deduct a portion of the interest cost of carry for the position" ;
	cmns-av:explanatoryNote "A bond that is bank qualified is also known as a qualified tax-exempt obligation." ;
	.

fibo-sec-dbt-bnd:isLegalOpinionAvailable
	a owl:DatatypeProperty ;
	rdfs:label "is legal opinion available" ;
	rdfs:domain fibo-sec-dbt-bnd:MunicipalBond ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether a legal opinion exists for a given municipal bond" ;
	.

fibo-sec-dbt-bnd:isLinkedToFallback
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:refersTo ;
	rdfs:label "is linked to fallback" ;
	rdfs:domain fibo-fbc-fi-fi:FinancialInstrument ;
	rdfs:range fibo-sec-dbt-bnd:GovernmentBond ;
	skos:definition "relates an index-linked instrument to a government bond that may be selected by a calculation agent" ;
	cmns-av:explanatoryNote "Fallback Bond means, in relation to an Inflation Index applicable to an Inflation Linked Note, a bond selected by the Calculation Agent and issued by the government or one of the governments (but not any government agency) of the country (or countries) to whose level of inflation the Inflation Index relates and which pays a coupon and/or redemption amount which is calculated by reference to the Inflation Index, with a maturity date which falls on the same day as the Maturity Date of the Inflation Linked Notes, or such other date as the Calculation Agent shall select if there is no such bond maturing on the Maturity Date of the Inflation Linked Notes. If any bond so selected is redeemed, the Calculation Agent will select a new Fallback Bond on the same basis, but selected from all eligible bonds in issue at the time the original Fallback Bond is redeemed (including any bond for which the redeemed bond is exchanged). Note the rate of the fallback bond is used as a substitute for the inflation index if, for example, it is no longer published." ;
	.

fibo-sec-dbt-bnd:isMandatory
	a owl:DatatypeProperty ;
	rdfs:label "is mandatory" ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether something is required" ;
	.

fibo-sec-dbt-bnd:isProRated
	a owl:DatatypeProperty ;
	rdfs:label "is pro-rated" ;
	rdfs:domain fibo-fbc-dae-dbt:InterestPaymentTerms ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the coupon is pro rated to the actual number of days in the payment period versus the number of payment periods" ;
	.

fibo-sec-dbt-bnd:isSuperSinker
	a owl:DatatypeProperty ;
	rdfs:label "super sinker" ;
	rdfs:domain fibo-sec-dbt-bnd:SinkingFundAmortizationTerms ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates that the bond has a long-term coupon but short potential short maturity" ;
	cmns-av:explanatoryNote "Super-sinker is a colloquial term for a term maturity, usually from a single family mortgage revenue issue with several term maturities, that will be the first to be called from a sinking fund into which all proceeds from prepayments of mortgages financed by the issue are deposited. The maturity's priority status under the call provisions means that it is likely to be redeemed in its entirety well before the stated maturity date." ;
	.

fibo-sec-dbt-dbti:AtADiscount
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-dbti:RelativePrice
		;
	rdfs:label "at a discount" ;
	skos:definition "a selling price that is less than the face or nominal value" ;
	cmns-av:synonym "below par" ;
	.

fibo-sec-dbt-dbti:AtAPremium
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-dbti:RelativePrice
		;
	rdfs:label "at a premium" ;
	skos:definition "a selling price significantly above the stated face or redemption value due to high demand or timing of redemption" ;
	cmns-av:synonym
		"above par" ,
		"premium"
		;
	.

fibo-sec-dbt-dbti:CallEvent
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:RedemptionEvent ;
	rdfs:label "call event" ;
	skos:definition "an event associated with the call schedule for a debt instrument" ;
	.

fibo-sec-dbt-dbti:CallFeature
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:RedemptionProvision ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasNotificationProvision ;
			owl:onClass fibo-sec-dbt-dbti:CallNotificationProvision ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-sec-dbt-dbti:CallSchedule ;
		]
		;
	rdfs:label "call feature" ;
	skos:definition "redemption provision defining the rights of the issuer to buy back a security at a call price after a call protection period" ;
	cmns-av:explanatoryNote "Most corporate and municipal bonds have ten-year call features (termed call protection by holders); government securities typically have none." ;
	cmns-av:synonym "call provision" ;
	.

fibo-sec-dbt-dbti:CallNotificationProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-dbti:NotificationProvision ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:allValuesFrom fibo-sec-dbt-dbti:CallWindow ;
		]
		;
	rdfs:label "call notification provision" ;
	skos:definition "provision of a call feature defining notification requirements" ;
	.

fibo-sec-dbt-dbti:CallPremium
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:MonetaryPrice ;
	rdfs:label "call premium" ;
	skos:definition "the price over par paid by an issuer to redeem securities when exercising a call provision" ;
	.

fibo-sec-dbt-dbti:CallSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:Schedule ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-sec-dbt-dbti:CallEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-acc-cur:MonetaryPrice
					fibo-sec-dbt-dbti:CallPremium
				) ;
			] ;
		]
		;
	rdfs:label "call schedule" ;
	skos:definition "a schedule of call prices and when they are in effect" ;
	.

fibo-sec-dbt-dbti:CallWindow
	a owl:Class ;
	rdfs:subClassOf cmns-dt:DatePeriod ;
	rdfs:label "call window" ;
	skos:definition "an explicit period of time prior to a call date during which an issuer or agent must give notice to holders" ;
	.

fibo-sec-dbt-dbti:DebtOffering
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-iss:SecuritiesOffering ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-fi-fi:DebtInstrument ;
		]
		;
	rdfs:label "debt offering" ;
	skos:definition "an offering of one or more debt instruments for sale" ;
	.

fibo-sec-dbt-dbti:FixedIncomeSecurity
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:TradableDebtInstrument ;
	rdfs:label "fixed income security" ;
	skos:definition "tradeable debt instrument that provides a return in the form of fixed periodic payments and typically the return of principal at maturity" ;
	cmns-av:explanatoryNote "Fixed income securities provide payments according to a regular schedule. This does not necessarily mean that the payments themselves are of a fixed amount, however." ;
	.

fibo-sec-dbt-dbti:FullyIndexedInterestRate
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:FloatingInterestRate ,
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:onClass fibo-ind-ir-ir:BaseRate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-sec-dbt-dbti:Margin ;
		]
		;
	rdfs:label "fully-indexed interest rate" ;
	skos:definition "a variable interest rate that is calculated by adding a margin to a specified index rate" ;
	cmns-av:explanatoryNote "Fully indexed interest rates are used for variable rate credit products. The interest rate on a variable (adjustable) rate mortgage corresponds to a specific benchmark (often the prime rate, but sometimes LIBOR, the one-year constant-maturity Treasury, or other benchmarks) plus a spread (also called the margin. The margin on a fully indexed interest rate product is determined by the underwriter and based on the borrower's credit quality." ;
	.

fibo-sec-dbt-dbti:InterestOnlyStrip
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:Strip ;
	rdfs:label "interest-only strip"@en ;
	owl:disjointWith fibo-sec-dbt-dbti:PrincipalOnlyStrip ;
	skos:definition "a strip that represents the non-principal portion of the monthly payments on the underlying debt instrument, such as a bond"@en ;
	skos:example "An interest-only strip can be reintegrated into other synthetic or engineered products. For example, interest-only strips can be pooled to create or make up a portion of a larger collateralized mortgage obligation (CMO), asset-backed security (ABS) or collateralized debt obligation (CDO) structure." ;
	cmns-av:explanatoryNote "An interest-only strip holder is interested in rising rates and no prepayment, as prepayment would cause them forfeit future interest payments and receive nothing from the return of the principal." ;
	cmns-av:synonym "IO strip"@en ;
	.

fibo-sec-dbt-dbti:IssuedDebt
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:Debt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:allValuesFrom fibo-fbc-fi-fi:DebtInstrument ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasDebtAmount ;
			owl:allValuesFrom fibo-fnd-acc-cur:MonetaryAmount ;
		]
		;
	rdfs:label "issued debt" ;
	skos:definition "debt that is set out by the borrower in some form of financial security in which the lender is the holder or counterparty of that security" ;
	.

fibo-sec-dbt-dbti:MakeWholeFeature
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:CallFeature ;
	rdfs:label "make whole feature" ;
	skos:definition "a call provision allowing the issuer to pay off remaining debt early" ;
	cmns-av:explanatoryNote "The issuer typically has to make a lump sum payment to the investor derived from a formula based on the net present value (NPV) of future interest or coupon payments that will not be paid incrementally because of the call combined with the principal payment the investor would have received at maturity." ;
	cmns-av:synonym "make whole provision" ;
	.

fibo-sec-dbt-dbti:Margin
	a owl:Class ;
	rdfs:subClassOf cmns-qtu:Variable ;
	rdfs:label "margin" ;
	skos:definition "a variable that is added to a specified index rate to determine the fully indexed interest rate charged to a borrower on a credit balance" ;
	cmns-av:synonym "spread" ;
	.

fibo-sec-dbt-dbti:NonTradableDebtInstrument
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:DebtInstrument ,
		fibo-fnd-agr-ctr:WrittenContract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasRedemptionProvision ;
			owl:onClass fibo-fbc-fi-fi:RedemptionProvision ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtIssue ;
			owl:someValuesFrom fibo-sec-dbt-dbti:RelativePrice ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtRedemption ;
			owl:someValuesFrom fibo-sec-dbt-dbti:RelativePrice ;
		]
		;
	rdfs:label "non-tradable debt instrument" ;
	owl:disjointWith fibo-sec-dbt-dbti:TradableDebtInstrument ;
	skos:definition "a debt instrument that may not be bought or sold" ;
	skos:example "Low-risk instruments such as savings bonds are examples of nonnegotiable debt instruments." ;
	cmns-av:explanatoryNote "Generally, a nonnegotiable instrument may be redeemed by the issuer, but this is often subject to some limitations." ;
	.

fibo-sec-dbt-dbti:NotificationProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:RedemptionProvision ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:allValuesFrom cmns-dt:DatePeriod ;
		]
		;
	rdfs:label "notification provision" ;
	skos:definition "provision of a redemption feature defining notification requirements" ;
	.

fibo-sec-dbt-dbti:ParValue
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-dbti:RelativePrice
		;
	rdfs:label "par value" ;
	skos:definition "the stated value of a negotiable instrument, stock, or bond, as compared with the value that instrument might receive when sold" ;
	cmns-av:synonym
		"face value" ,
		"nominal value" ,
		"par"
		;
	.

fibo-sec-dbt-dbti:PrescriptiveEvent
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-dt-oc:OccurrenceKind ;
	rdfs:label "prescriptive event" ;
	skos:definition "event related to the imposition or enforcement of a rule, method, formula, etc." ;
	.

fibo-sec-dbt-dbti:PrincipalOnlyStrip
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:Strip ;
	rdfs:label "principal-only strip"@en ;
	skos:definition "a strip that represents the principal portion of the monthly payments on the underlying debt instrument, such as a bond"@en ;
	.

fibo-sec-dbt-dbti:PubliclyIssuedDebt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-dbti:IssuedDebt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:allValuesFrom fibo-sec-dbt-dbti:TradableDebtInstrument ;
		]
		;
	rdfs:label "publicly issued debt" ;
	skos:definition "an issued debt in the form of a tradable debt instrument (security)" ;
	.

fibo-sec-dbt-dbti:PutEvent
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:RedemptionEvent ;
	rdfs:label "put event" ;
	skos:definition "an event associated with the put schedule for a debt instrument, i.e., an event involving the 'put', or surrender of the instrument by the holder" ;
	.

fibo-sec-dbt-dbti:PutFeature
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:DebtTerms ,
		fibo-fbc-fi-fi:RedemptionProvision ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasNotificationProvision ;
			owl:onClass fibo-sec-dbt-dbti:PutNotificationProvision ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-bnd:isMandatory ;
			owl:onDataRange xsd:boolean ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-sec-dbt-dbti:PutSchedule ;
		]
		;
	rdfs:label "put feature" ;
	skos:definition "redemption provision giving the holder the right, but not the obligation, to sell a specified amount of the debt instrument (i.e., redeem it), prior to maturity" ;
	skos:editorialNote 'FIBIM has term "Putable Date" which (by implication, and comparing with definition for "Next Call Date") is presumably a single calendar date in the future, at a given point in time. That does not cover the definition of formal terms defining when and how the issue may be put, which is what is modeled here.' ;
	cmns-av:synonym "put provision" ;
	.

fibo-sec-dbt-dbti:PutNotificationProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-dbti:NotificationProvision ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:allValuesFrom fibo-sec-dbt-dbti:PutWindow ;
		]
		;
	rdfs:label "put notification provision" ;
	skos:definition "a provision of a put feature defining notification requirements" ;
	.

fibo-sec-dbt-dbti:PutPremium
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:MonetaryPrice ;
	rdfs:label "put premium" ;
	skos:definition "an amount over par that a debt instrument holder must pay to sell the security early" ;
	.

fibo-sec-dbt-dbti:PutSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:Schedule ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-sec-dbt-dbti:PutEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-acc-cur:MonetaryPrice
					fibo-sec-dbt-dbti:PutPremium
				) ;
			] ;
		]
		;
	rdfs:label "put schedule" ;
	skos:definition "a schedule that defines the events associated with the put feature of a debt instrument, i.e, the dates on which the debt instrument may be sold at what price by the holder" ;
	.

fibo-sec-dbt-dbti:PutWindow
	a owl:Class ;
	rdfs:subClassOf cmns-dt:DatePeriod ;
	rdfs:label "put window" ;
	skos:definition "an explicit period of time prior to a put date during which holder or agent must give notice to an issuer" ;
	.

fibo-sec-dbt-dbti:RedemptionEvent
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:PrescriptiveEvent ;
	rdfs:label "redemption event" ;
	skos:definition "a prescriptive event involving the return of an investor's principal in a fixed-income security, such as a preferred stock or bond, or the sale of units in a mutual fund" ;
	.

fibo-sec-dbt-dbti:RelativePrice
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fi-ip:SecurityPrice ;
	rdfs:label "relative price" ;
	skos:definition "security price specified in comparison with either a stated or market value for a debt instrument at some point in time" ;
	.

fibo-sec-dbt-dbti:StepEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:CalculationEvent ,
		fibo-sec-dbt-dbti:PrescriptiveEvent
		;
	rdfs:label "step event" ;
	skos:definition "event that prescribes a change in a contractual term, such as a rate or notional amount, for a given contract" ;
	.

fibo-sec-dbt-dbti:StepSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:Schedule ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-sec-dbt-dbti:StepEvent ;
		]
		;
	rdfs:label "step schedule" ;
	skos:definition "schedule specifying the date(s) and change in a contractual term(s), e.g., rate or notional amount, for a contract that has a feature where stipulated changes occur at specified intervals or on specified dates" ;
	.

fibo-sec-dbt-dbti:Strip
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:FixedIncomeSecurity ;
	rdfs:label "strip"@en ;
	skos:definition "a tradeable debt instrument created either through the process of removing coupons from a bond and then selling the separate parts as a zero coupon bond and an interest paying coupon bond or through taking the opposite position from some variant in the options market"@en ;
	cmns-av:explanatoryNote "STRIPS is an acronym for Separate Trading of Registered Interest and Principal of Securities, which has come to be used as a term in its own right."@en ;
	cmns-av:synonym "Separate Trading of Registered Interest and Principal of Securities"@en ;
	.

fibo-sec-dbt-dbti:TradableDebtInstrument
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:DebtInstrument ,
		fibo-fbc-fi-fi:Security ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-gty:hasGuarantor ;
			owl:onClass fibo-fbc-dae-gty:Guarantor ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:isSubordinatedTo ;
			owl:onClass fibo-sec-dbt-dbti:TradableDebtInstrument ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "tradable debt instrument" ;
	skos:definition "a debt instrument that is also a security, i.e., that can be bought and sold by the holder" ;
	cmns-av:explanatoryNote "Details from Ecofin: A [debt] instrument can be traded, if its features depend only on one borrower. If the instrument has no bilateral or multilateral obligations, the investor can easily transfer it to another investor without asking the borrower (except the terms prohibit this explicitly). This is simplified with securitised instruments, where the debt is already split into handy denominations which trade easily (e.g. in round thousands or millions as with bonds, commercial paper, etc.). But in principle it works also with interbank loans and similar instruments. FIBIM Definition: Financial instruments evidencing moneys owed by the issuer to the holder on terms as specified." ;
	.

fibo-sec-dbt-dbti:VariableIncomeSecurity
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:TradableDebtInstrument ;
	rdfs:label "variable income security" ;
	skos:definition "tradeable debt instrument that provide their owners with a rate of return that is dynamic and determined by market forces" ;
	cmns-av:explanatoryNote "Variable-income securities provide investors with both greater risks as well as rewards." ;
	.

fibo-sec-dbt-dbti:allowsAutoReinvestment
	a owl:DatatypeProperty ;
	rdfs:label "allows auto-reinvestment" ;
	rdfs:domain fibo-fbc-dae-dbt:InterestPaymentTerms ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the security allows automatically re-investing the interest on that security towards purchasing additional shares or units of the same security" ;
	.

fibo-sec-dbt-dbti:allowsPaymentInKind
	a owl:DatatypeProperty ;
	rdfs:label "allows payment in kind" ;
	rdfs:domain fibo-fbc-fi-fi:RedemptionProvision ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the principal may be repaid in kind (i.e., replaced with another instrument) rather than in cash" ;
	.

fibo-sec-dbt-dbti:hasCallFeature
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-sec-dbt-dbti:hasRepaymentTerms ;
	rdfs:label "has call feature" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fbc-fi-fi:DebtInstrument
			fibo-sec-dbt-dbti:DebtOffering
		) ;
	] ;
	rdfs:range fibo-sec-dbt-dbti:CallFeature ;
	skos:definition "indicates the specific terms related to any inherent call feature as specified in the offering/instrument" ;
	.

fibo-sec-dbt-dbti:hasDatedDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has dated date" ;
	rdfs:domain fibo-fbc-dae-dbt:InterestPaymentTerms ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "specifies the date on which interest begins to accrue on a fixed-income security" ;
	cmns-av:explanatoryNote "Investors who purchase a fixed-income security between interest payment dates must also pay the seller or issuer any interest that has accrued from the dated date to the purchase date, or settlement date, in addition to the face value."@en ;
	.

fibo-sec-dbt-dbti:hasDefaultLotSize
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fbc-fi-ip:hasLotSize ;
	rdfs:label "has default lot size" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fbc-fi-fi:DebtInstrument
			fibo-sec-dbt-dbti:DebtOffering
		) ;
	] ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the default number of units of the security that may be held at any one time" ;
	cmns-av:explanatoryNote "This is the minimum denomination required for transfer or change of ownership of a tradable debt security." ;
	.

fibo-sec-dbt-dbti:hasEstateOrDeathPutFeature
	a owl:DatatypeProperty ;
	rdfs:label "has estate or death put feature" ;
	rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates that a security is subject to redemption upon the passing of the holder" ;
	.

fibo-sec-dbt-dbti:hasInterestPaymentTerms
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has interest payment terms" ;
	rdfs:range fibo-fbc-dae-dbt:InterestPaymentTerms ;
	skos:definition "indicates the specific terms related to interest payments on the principal as specified in the instrument or a related contract document" ;
	.

fibo-sec-dbt-dbti:hasNotificationProvision
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has notification provision" ;
	rdfs:domain fibo-fbc-fi-fi:RedemptionProvision ;
	rdfs:range fibo-sec-dbt-dbti:NotificationProvision ;
	skos:definition "relates the redemption provision of a debt instrument to a notification provision (e.g., call or put notification)" ;
	.

fibo-sec-dbt-dbti:hasPoolNumber
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has pool number" ;
	rdfs:domain fibo-sec-dbt-dbti:PubliclyIssuedDebt ;
	rdfs:range xsd:integer ;
	skos:definition "indicates the pool number of the debt" ;
	.

fibo-sec-dbt-dbti:hasPriceAndYieldDayCountConvention
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-bd:hasBusinessRecurrenceIntervalConvention ;
	rdfs:label "has price and yield day count convention" ;
	rdfs:range fibo-fbc-dae-dbt:DayCountConvention ;
	skos:definition "indicates the convention used to determine the number of days in a month and days in a year that are counted when performing calculations for yield and price figures" ;
	.

fibo-sec-dbt-dbti:hasPutFeature
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-sec-dbt-dbti:hasRepaymentTerms ;
	rdfs:label "has put feature" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fbc-fi-fi:DebtInstrument
			fibo-sec-dbt-dbti:DebtOffering
		) ;
	] ;
	rdfs:range fibo-sec-dbt-dbti:PutFeature ;
	skos:definition "indicates the specific terms related to any inherent put feature as specified in the offering/instrument" ;
	.

fibo-sec-dbt-dbti:hasRelativePriceAtIssue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has relative price at issue" ;
	rdfs:range fibo-sec-dbt-dbti:RelativePrice ;
	skos:definition "indicates a relative price with respect to the face value at which an instrument is issued, namely par, premium or discount" ;
	.

fibo-sec-dbt-dbti:hasRelativePriceAtMaturity
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has relative price at maturity" ;
	rdfs:range fibo-sec-dbt-dbti:RelativePrice ;
	skos:definition "indicates a relative price with respect to the face value at the time an instrument matures, namely par, discount or premium" ;
	.

fibo-sec-dbt-dbti:hasRelativePriceAtRedemption
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has relative price at redemption" ;
	rdfs:range fibo-sec-dbt-dbti:RelativePrice ;
	skos:definition "indicates a relative price with respect to the face value at the time an instrument is redeemed, namely par, discount or premium" ;
	.

fibo-sec-dbt-dbti:hasRepaymentTerms
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has repayment terms" ;
	rdfs:range fibo-fbc-dae-dbt:PrincipalRepaymentTerms ;
	skos:definition "indicates the specific terms related to repayment of principal as specified in the instrument or a related contract document" ;
	.

fibo-sec-dbt-dbti:hasRightToRetain
	a owl:DatatypeProperty ;
	rdfs:label "right to retain" ;
	rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the holder has an option to retain the security in the event of an issuer exercising the put feature" ;
	.

fibo-sec-dbt-dbti:isCallable
	a owl:DatatypeProperty ;
	rdfs:label "is callable" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fbc-fi-fi:DebtInstrument
			fibo-sec-dbt-dbti:DebtOffering
		) ;
	] ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the issuer (writer) of the debt contract (the debtor) can call the debt prior to maturity" ;
	.

fibo-sec-dbt-dbti:isExchangeable
	a owl:DatatypeProperty ;
	rdfs:label "is exchangeable" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fbc-fi-fi:DebtInstrument
			fibo-sec-dbt-dbti:DebtOffering
		) ;
	] ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the security can be exchanged for another security at the issuers discretion" ;
	.

fibo-sec-dbt-dbti:isExtendableByHolder
	a owl:DatatypeProperty ;
	rdfs:label "is extendable by holder" ;
	rdfs:domain fibo-fbc-fi-fi:RedemptionProvision ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the expiration date or maturity date can be extended by the holder" ;
	.

fibo-sec-dbt-dbti:isExtendableByIssuer
	a owl:DatatypeProperty ;
	rdfs:label "is extendable by issuer" ;
	rdfs:domain fibo-fbc-fi-fi:RedemptionProvision ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the issuer has the option to extend the debt rather than refinancing" ;
	cmns-av:explanatoryNote "If not, the issuer may only refinance the debt by calling the issue and creating a new issue." ;
	.

fibo-sec-dbt-dbti:isPutable
	a owl:DatatypeProperty ;
	rdfs:label "is putable" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fbc-fi-fi:DebtInstrument
			fibo-sec-dbt-dbti:DebtOffering
		) ;
	] ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the holder has the right to ask for redemption of the security prior to final maturity" ;
	.

fibo-sec-dbt-dbti:isStrippable
	a owl:DatatypeProperty ;
	rdfs:label "is strippable" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fbc-fi-fi:DebtInstrument
			fibo-sec-dbt-dbti:DebtOffering
		) ;
	] ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether or not the instrument can be stripped, so that interest and principal may be traded separately" ;
	.

fibo-sec-dbt-dbti:isSubordinated
	a owl:DatatypeProperty ;
	rdfs:label "is subordinated" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fbc-fi-fi:DebtInstrument
			fibo-sec-dbt-dbti:DebtOffering
		) ;
	] ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the security is a subordinated security, meaning that the security has a lower priority than another security so that when the assets are liquidated this one is not first in line" ;
	.

fibo-sec-dbt-dbti:isSubordinatedTo
	a owl:ObjectProperty ;
	rdfs:label "is subordinated to" ;
	rdfs:domain fibo-sec-dbt-dbti:TradableDebtInstrument ;
	rdfs:range fibo-sec-dbt-dbti:TradableDebtInstrument ;
	skos:definition "indicates the target security (i.e., the one in the range) has a higher priority than the security in question" ;
	.

fibo-sec-dbt-dln:AdministrativeAgent
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-fct:SyndicateMember ;
	rdfs:label "administrative agent"@en ;
	skos:definition "role of a financial institution (often one of the primary lenders in the syndicate) designated to act as an intermediary between the borrowers and the syndicate lenders"@en ;
	cmns-av:explanatoryNote "An administrative agent is designated by the syndicate and granted the authority to disburse funds, collect payments, monitor compliance and act as the communications intermediary with the borrower on behalf of the syndicate. This coordination role is crucial to ensuring that lenders' rights and oblications are properly coordinated and to streamline operations. Their authority and the scope of what they can do is explicitly stated in the loan agreement, and does not allow unilateral decision making with respect to the terms of the loan."@en ;
	.

fibo-sec-dbt-dln:Bookrunner
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-fse:FinancialInstitution ;
	rdfs:label "bookrunner"@en ;
	skos:definition "financial institution (typically a commercial or investment bank) responsible for coordinating the arrangement, structuring, and marketing of the loan to potential lenders"@en ;
	cmns-av:explanatoryNote "A 'bookrunner' is primarily responsible for managing the distribution and sale of a security during a new issuance, while a 'lead arranger' is the primary bank that structures and leads a syndicated loan, often assigning portions of the loan to other banks to participate in the deal; essentially, the bookrunner focuses on selling the security to investors, while the lead arranger focuses on structuring the loan itself and coordinating the syndicate of lenders involved."@en ;
	.

fibo-sec-dbt-dln:DocumentationAgent
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-fct:SyndicateMember ;
	rdfs:label "documentation agent"@en ;
	skos:definition "financial institution designated to oversee the drafting, negotiation, and finalization of the loan documentation"@en ;
	.

fibo-sec-dbt-dln:FinanceSyndicate
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-fct:Syndicate ;
	rdfs:label "finance syndicate"@en ;
	skos:definition "group of financial institutions or lenders that collectively agree to provide funding for a large loan to a single borrower"@en ;
	cmns-av:explanatoryNote "Syndicates are formed to enable the provision of substantial financing amounts that would be challenging or risky for any one lender to offer alone. The syndicate structure allows lenders to share the loan amount, spreading both the funding and associated risks among multiple participants."@en ;
	.

fibo-sec-dbt-dln:FinanceSyndicateMember
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-fct:SyndicateMember ,
		fibo-fbc-pas-fpas:FinancialServiceProvider ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:isMemberOf ;
				owl:allValuesFrom fibo-sec-dbt-dln:FinanceSyndicate ;
			] ;
		]
		;
	rdfs:label "finance syndicate member"@en ;
	skos:definition "syndicate member that is a financial services provider that contributes funds to a syndicated loan or loan participation note"@en ;
	cmns-av:explanatoryNote "Syndicate members may include a variety of financial institutions, such as commercial banks, investment banks, institutional investors - insurance companies, pension funds, and hedge funds, and specialty finance firms, focused on specific industries or credit profiles, which may join syndicates for specialized or higher-risk loans."@en ;
	.

fibo-sec-dbt-dln:LeadArranger
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-fse:FinancialInstitution ;
	rdfs:label "lead arranger"@en ;
	skos:definition "financial institution that spearheads the loan structuring and syndication process on behalf of the borrower"@en ;
	cmns-av:explanatoryNote "The lead arranger acts as the primary point of contact for the borrower. They perform credit analysis and due diligence, ensure that the structure meets borrowers goals, and coordinates with potential lenders regarding the initial structure and commitments."@en ;
	cmns-av:synonym
		"arranger"@en ,
		"lead bank"@en ,
		"lead manager"@en
		;
	.

fibo-sec-dbt-dln:LoanParticipationNote
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditFacility ,
		fibo-loan-spc-com:CommercialLoan ,
		fibo-sec-dbt-dbti:FixedIncomeSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasActor ;
			owl:onClass fibo-sec-dbt-dln:LeadArranger ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "loan participation note"@en ;
	skos:definition "credit facility and fixed-income security that may be distributed across a group of lenders"@en ;
	cmns-av:abbreviation "LPN"@en ;
	cmns-av:explanatoryNote
		"The main difference between a loan participation and a loan syndication is that in a loan participation, one lender sells ownership interests in a loan to other lenders, while in a loan syndication, the lenders work together to originate and lend on the loan."@en ,
		"With an LPN, a lead bank underwrites and issues the loan. This lending institution then recruits other banks to participate and share the risks and profits on a pro rata basis. The lead lender keeps a partial interest in the loan and is responsible for servicing it."@en
		;
	.

fibo-sec-dbt-dln:SyndicatedLoan
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-dae-dbt:CreditFacility ,
		fibo-loan-spc-com:CommercialLoan ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasActor ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-sec-dbt-dln:AdministrativeAgent
					fibo-sec-dbt-dln:Bookrunner
					fibo-sec-dbt-dln:DocumentationAgent
					fibo-sec-dbt-dln:FinanceSyndicateMember
					fibo-sec-dbt-dln:LeadArranger
					fibo-sec-dbt-dln:SyndicationAgent
				) ;
			] ;
		]
		;
	rdfs:label "syndicated loan"@en ;
	skos:definition "credit agreement in which a group of lenders, known as a syndicate, collectively provides a large loan to a single borrower"@en ;
	cmns-av:explanatoryNote "A syndicated loan enables pooling of funds from multiple financial institutions, typically under the leadership of one or more arranging banks. These kinds of credit agreements are often used by large corporations, private equity investors and government entities for significant capital needs such as acquisitions, project financing, or to meet operational requirements."@en ;
	.

fibo-sec-dbt-dln:SyndicationAgent
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-fct-fse:FinancialInstitution ;
	rdfs:label "syndication agent"@en ;
	skos:definition "financial institution (typically a commercial or investment bank) designated to help structure, arrange, and manage the loan syndication process"@en ;
	cmns-av:explanatoryNote "Syndication agents are important at the beginning of the process, including setting up the syndicate, supporting distribution of the loan across lenders, marketing, and the like. They are far less involved in loan administration, which is managed by the administrative agent."@en ;
	.

fibo-sec-dbt-ex:AmericanExerciseConvention
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-ex:ExerciseConvention
		;
	rdfs:label "American exercise convention"@en ;
	skos:definition "exercise convention that stipulates that an option may be exercised anytime between the purchase date and date of expiration"@en ;
	.

fibo-sec-dbt-ex:AmericanExerciseTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-ex:ExerciseTerms ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:uses ;
			owl:hasValue fibo-sec-dbt-ex:AmericanExerciseConvention ;
		]
		;
	rdfs:label "American exercise terms"@en ;
	owl:disjointWith
		fibo-sec-dbt-ex:BermudanExerciseTerms ,
		fibo-sec-dbt-ex:EuropeanExerciseTerms
		;
	skos:definition "exercise terms that stipulate that an option may be exercised on or before the date of expiration"@en ;
	cmns-av:explanatoryNote "Under certain circumstances, early exercise may be advantageous to the option holder."@en ;
	.

fibo-sec-dbt-ex:BermudanExerciseConvention
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-ex:ExerciseConvention
		;
	rdfs:label "Bermudan exercise convention"@en ;
	skos:definition "exercise convention that stipulates that an option may be exercised anytime between the purchase date and date of expiration"@en ;
	.

fibo-sec-dbt-ex:BermudanExerciseTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-ex:ExerciseTerms ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:uses ;
			owl:hasValue fibo-sec-dbt-ex:BermudanExerciseConvention ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-ex:hasExerciseDate ;
			owl:someValuesFrom cmns-dt:ExplicitDate ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-ex:hasExerciseWindow ;
			owl:someValuesFrom cmns-dt:DatePeriod ;
		]
		;
	rdfs:label "Bermudan exercise terms"@en ;
	owl:disjointWith fibo-sec-dbt-ex:EuropeanExerciseTerms ;
	skos:definition "exercise terms that stipulate that an option may only be exercised on predetermined dates within some exercise window, often on one day each month or at the date of expiration"@en ;
	cmns-av:explanatoryNote "The Bermuda option is named as such because its exercise dates are more flexible than European options and less flexible than American options. Thus, it is in the middle, just like Bermuda is between Europe and America. Bermuda options are also referred to as Mid-Atlantic, Quasi American, or Semi-American options."@en ;
	.

fibo-sec-dbt-ex:CanaryExerciseConvention
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-ex:ExerciseConvention
		;
	rdfs:label "canary exercise convention"@en ;
	skos:definition "exercise/call convention that stipulates that an option may only be exercised on predetermined dates until the first step is reached, but not after that point"@en ;
	.

fibo-sec-dbt-ex:CanaryExerciseTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-ex:BermudanExerciseTerms ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:uses ;
			owl:hasValue fibo-sec-dbt-ex:CanaryExerciseConvention ;
		]
		;
	rdfs:label "canary exercise terms"@en ;
	skos:definition "exercise terms that stipulate that an option may only be exercised on predetermined dates until the first step is reached, but not after that point"@en ;
	.

fibo-sec-dbt-ex:EuropeanExerciseConvention
	a
		owl:NamedIndividual ,
		fibo-sec-dbt-ex:ExerciseConvention
		;
	rdfs:label "European exercise convention"@en ;
	skos:definition "exercise convention that stipulates that an option may only be exercised at the date of expiration"@en ;
	.

fibo-sec-dbt-ex:EuropeanExerciseTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-ex:ExerciseTerms ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:uses ;
			owl:hasValue fibo-sec-dbt-ex:EuropeanExerciseConvention ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-ex:hasExerciseDate ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "European exercise terms"@en ;
	skos:definition "exercise terms that stipulate that an option may only be exercised at the date of expiration"@en ;
	.

fibo-sec-dbt-ex:ExerciseConvention
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-dt-bd:Convention ;
	rdfs:label "exercise convention"@en ;
	skos:definition "convention that determines when the holder or future holder of an option can implement the rights defined in the option"@en ;
	.

fibo-sec-dbt-ex:ExerciseTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractualCommitment ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:uses ;
			owl:someValuesFrom fibo-sec-dbt-ex:ExerciseConvention ;
		]
		;
	rdfs:label "exercise terms"@en ;
	skos:definition "contract terms specific to the conditions, conventions and other stipulations related to the exercise of an option or entitlement"@en ;
	.

fibo-sec-dbt-ex:hasExerciseDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has exercise date"@en ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates a date on which an option may be exercised as specified in the terms of the contract"@en ;
	.

fibo-sec-dbt-ex:hasExerciseTerms
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has exercise terms"@en ;
	rdfs:domain fibo-fbc-fi-fi:DerivativeInstrument ;
	rdfs:range fibo-sec-dbt-ex:ExerciseTerms ;
	skos:definition "links a derivative, such as an option or entitlement, to any exercise terms that are specified therein"@en ;
	.

fibo-sec-dbt-ex:hasExerciseWindow
	a owl:ObjectProperty ;
	rdfs:label "has exercise window"@en ;
	rdfs:range cmns-dt:DatePeriod ;
	skos:definition "indicates a period of time during which the option may be exercised as specified in the terms of the contract"@en ;
	.

fibo-sec-dbt-pbs:AbsolutePrepaymentRate
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure ;
	rdfs:label "absolute prepayment rate"@en ;
	skos:definition "measure of the monthly rate of loan prepayments as a percentage of the original pool balance"@en ;
	cmns-av:abbreviation "ABS"@en ;
	cmns-av:explanatoryNote
		"ABS is defined by the following formula where SMM refers to Single Monthly Mortality, which measures the percentage of dollars prepaid in a given month expressed as a percentage of the scheduled loan balance. ABS = (100 * SMM)/100 + (SMM X (Age - 1)."@en ,
		"The ABS measurement differs from conditional prepayment rate (CPR) used in the mortgage industry, which measures prepayment as an annualized percentage of the current pool balance."@en
		;
	.

fibo-sec-dbt-pbs:AssetBackedSecurity
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-pbs:PoolBackedSecurity ;
	rdfs:label "asset-backed security"@en ;
	skos:definition "debt instrument backed by receivables other than those arising out of real estate loans or mortgages"@en ;
	cmns-av:abbreviation "ABS"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of Financial Instruments (CFI code), Fourth edition, 2019-10-01" ;
	cmns-av:explanatoryNote
		"An asset-backed security (ABS) is a type of financial investment that is collateralized by an underlying pool of assets—usually ones that generate a cash flow from debt, such as loans, leases, credit card balances, or receivables. It takes the form of a bond or note, paying income at a fixed rate for a set amount of time, until maturity. ABS are financial securities backed by income-generating assets such as credit card receivables, home equity loans, student loans, and auto loans. Pooling assets into an ABS is a process called securitization. One difference between an ABS and a collateralized debt obligation (CDO) is that the CDO issuer is generally a special purpose vehicle (SPV) or trust."@en ,
		"Asset-backed securities, for example home equity loans (HEL), credit cards, and so forth are backed by receivables [payments] that are either secured (such as HEL) or unsecured (for example, credit cards). They are typically tranched based on default risk."@en
		;
	.

fibo-sec-dbt-pbs:AttachmentPoint
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:PercentageMonetaryAmount ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-asmt:isEstimatedValueOf ;
			owl:onClass fibo-fbc-dae-dbt:CollateralValueAsOfDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "attachment point"@en ;
	skos:definition "lower tranche boundary of a tranche defined as a percentage of the value of the total pool of collateral, either at issuance or as of some point in time"@en ;
	cmns-av:adaptedFrom
		'Alexander Veremyev, Peter Tsyurmasto, and Stan Uryasev. "Optimal Structuring of CDO contracts: Optimization Approach". https://www.ise.ufl.edu/uryasev/files/2012/10/structuring_CDO_JCR_oct12.pdf'@en ,
		"https://fincyclopedia.net/finance/"@en
		;
	cmns-av:explanatoryNote
		"A CDO tranche becomes liable for losses when the total amount of defaults or losses in the underlying debt pool exceeds a certain threshold, called the attachment point. The attachment point is expressed as a percentage of the total value of the debt pool. In other words, the attachment point is the level of subordination above which a given tranche stands. Note that the notion of 'liability for loss' is in a financial or econonmic sense rather than a legal sense."@en ,
		"The higher the attachment point, the lower the risk and the return for the tranche. The lower the attachment point, the higher the risk and the return for the tranche. The most senior tranches have the highest attachment points and are paid first from the cash flows of the debt pool. The most junior tranches have the lowest attachment points and are paid last from the cash flows of the debt pool. The junior tranches also bear the first losses when defaults occur in the debt pool."@en
		;
	.

fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:QualifiedMeasure ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:hasApplicablePeriod ;
			owl:onClass cmns-dt:DatePeriod ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-sec-sec-pls:DebtPool ;
		]
		;
	rdfs:label "debt pool statistical measure"@en ;
	skos:definition "qualified measure of some aspect of the behavior of one or more debt instrument(s) that may vary over time"@en ;
	.

fibo-sec-dbt-pbs:DefaultRate
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure ,
		cmns-qtu:Ratio
		;
	rdfs:label "default rate"@en ;
	skos:definition "qualified measure of the rate at which holders of the debt instruments in the pool default on those instruments"@en ;
	.

fibo-sec-dbt-pbs:DetachmentPoint
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:PercentageMonetaryAmount ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-asmt:isEstimatedValueOf ;
			owl:onClass fibo-fbc-dae-dbt:CollateralValueAsOfDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "detachment point"@en ;
	skos:definition "upper tranche boundary of a tranche defined as a percentage of the value of the total pool of collateral, either at issuance or as of some point in time"@en ;
	cmns-av:adaptedFrom
		'Alexander Veremyev, Peter Tsyurmasto, and Stan Uryasev. "Optimal Structuring of CDO contracts: Optimization Approach". https://www.ise.ufl.edu/uryasev/files/2012/10/structuring_CDO_JCR_oct12.pdf'@en ,
		"https://fincyclopedia.net/finance/"@en
		;
	cmns-av:explanatoryNote "The CDO tranche loss arises when the cumulative collateral loss exceeds the tranche's attachment point. The detachment point corresponds to the amount of pool losses that will completely wipe out the respective tranche. The detachment point is the maximum of pool-level losses at which a given tranche becomes liable for losses."@en ;
	.

fibo-sec-dbt-pbs:PoolBackedSecurity
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-dbti:TradableDebtInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-pbs:hasEstimatedTotalCollateralValueAtIssuance ;
			owl:onClass fibo-fbc-dae-dbt:CollateralValueAsOfDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:onClass fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-pbs:isPassThrough ;
			owl:onDataRange xsd:boolean ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
			owl:someValuesFrom fibo-sec-sec-pls:InstrumentPool ;
		]
		;
	rdfs:label "pool-backed security"@en ;
	skos:definition "debt instrument that derives its cashflow from an underlying pool of mortgage loans or other receivables"@en ;
	cmns-av:explanatoryNote "If the security is a component of a collateralized debt obligation, then the underlying pool is typically segmented into various tranches, each of which provides cash flows to hedge particular risks, or that offset other gains by time to maturity or other factors."@en ;
	.

fibo-sec-dbt-pbs:PrepaymentSpeed
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure ;
	rdfs:label "prepayment speed"@en ;
	skos:definition "estimated rate at which a debt or part of a debt is paid off ahead of schedule"@en ;
	cmns-av:explanatoryNote "A prepayment model is used to estimate the level of prepayments (speed) on a loan portfolio that will occur in a set period of time, given possible changes in interest rates. Understanding prepayment speed is critical in assessing the value of mortgage pass-through securities. Prepayment models are based on mathematical equations and usually involve the analysis of historical prepayment trends to predict what will happen in the future. Prepayment models are often used to value mortgage pools such as GNMA securities or other securitized debt products, including mortgage-backed securities (MBS)."@en ;
	.

fibo-sec-dbt-pbs:PrincipalProtectedNote
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:CapitalProtectedProduct ,
		fibo-sec-dbt-pbs:StructuredFinanceInstrument
		;
	rdfs:label "principal protected note"@en ;
	owl:disjointWith fibo-sec-dbt-pbs:StructuredFinanceWithoutPrincipalProtection ;
	skos:definition "structured finance that offers investors exposure to chosen underlying assets using various approaches and asymmetric pay-off profiles"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of Financial Instruments (CFI code), Fourth edition, 2019-10-01." ;
	cmns-av:explanatoryNote "There are one or more reference entities underlying the product. Redemption is made at least in the amount of the conditional capital protection at maturity, provided that no credit event by the reference entity has occurred. Conditional capital protection only applies to the nominal amount and not to the purchase price. The general functioning of a capital guaranteed structured instrument is as follows: the notional amount is split into a zero bond, that will deliver the capital guarantee at maturity, and the difference between the zero bond's value (= present value of the guarantee level at maturity) and the notional amount is used for structuring the performance component with options which deliver the agreed pay-off profile of the structured instrument."@en ;
	cmns-av:synonym "capital protected note"@en ;
	.

fibo-sec-dbt-pbs:SingleMonthlyMortality
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure ,
		cmns-qtu:Percentage
		;
	rdfs:label "single monthly mortality"@en ;
	skos:definition "estimated per-month percentage of mortgages in an MBS pool that will be paid off early"@en ;
	cmns-av:abbreviation "SMM"@en ;
	cmns-av:explanatoryNote "Single monthly mortality (SMM) is a way to gauge the prepayment risk of a mortgage-backed security."@en ;
	.

fibo-sec-dbt-pbs:StructuredFinanceInstrument
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-str:StructuredProduct ,
		fibo-sec-dbt-pbs:PoolBackedSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-rlcmp:isPlayedBy ;
				owl:someValuesFrom fibo-be-le-lp:SpecialPurposeVehicle ;
			] ;
		]
		;
	rdfs:label "structured finance instrument"@en ;
	rdfs:seeAlso <https://www.bis.org/publ/cgfs23mitchell.pdf> ;
	skos:definition "pool-backed security wherein the risk associated with the pool has been uncoupled from the risk associated with the originating institution through a special purpose vehicle"@en ;
	skos:example "Collateralized debt obligations (CDOs), synthetic financial instruments, collateralized bond obligations (CBOs), and syndicated loans are examples of structured finance instruments."@en ;
	cmns-av:explanatoryNote 'Structured finance instruments represent a form of securitization technology which can be defined by three key characteristics: (1) pooling of financial assets, such as loans, bonds, or credit-default swaps; (2) de-linking of the credit risk of the asset pool from the credit risk of the originating firm, usually through use of a finite-lived, stand-alone special purpose vehicle (SPV); and (3) issuance by the SPV of "tranched" liabilities backed by the asset pool. Structured finance instruments are typically presented to large financial institutions or companies with complicated financing needs that are unsatisfied with conventional financial products.'@en ;
	cmns-av:synonym "structured finance"@en ;
	.

fibo-sec-dbt-pbs:StructuredFinanceWithoutPrincipalProtection
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-pbs:StructuredFinanceInstrument ;
	rdfs:label "structured finance without principal protection"@en ;
	skos:definition "structured finance that is a short-term note linked to an underlying asset that offers a steady stream of income"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of Financial Instruments (CFI code), Fourth edition, 2019-10-01." ;
	cmns-av:explanatoryNote "The redemption at the end of the term is determined on the basis of the performance and final fixing of the underlying asset: a redemption at the nominal value is guaranteed as long as the underlying asset has not touched its barrier during relevant barrier monitoring. If the underlying asset has touched its barrier but is again above the strike price at final fixing, the nominal price is also repaid. Nevertheless, if the underlying asset has touched its barrier during barrier monitoring and closes below the strike price at final fixing, the underlying asset is delivered or cash compensation paid, provided that no credit event by the reference entity has occurred. Depending on the characteristics of the product, either a coupon or a discount to the underlying asset can apply. A coupon is paid out regardless of the performance of the underlying asset, provided that no credit event by the reference entity has occurred."@en ;
	cmns-av:synonym "structured finance without capital protection"@en ;
	.

fibo-sec-dbt-pbs:Tranche
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-pbs:StructuredFinanceInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-pbs:hasEstimatedTotalCollateralValueAtIssuance ;
			owl:onClass fibo-fbc-dae-dbt:CollateralValueAsOfDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-pbs:hasAttachmentPoint ;
			owl:onClass fibo-sec-dbt-pbs:AttachmentPoint ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-pbs:hasDetachmentPoint ;
			owl:onClass fibo-sec-dbt-pbs:DetachmentPoint ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:isPartOf ;
				owl:someValuesFrom fibo-sec-sec-pls:InstrumentPool ;
			] ;
		]
		;
	rdfs:label "tranche"@en ;
	skos:definition "segment of a pool of securities, typically debt instruments"@en ;
	cmns-av:explanatoryNote "A tranche is one of a number of related securities in the same offering that represents a partition of a debt pool whose cash flow is derived from the combined cash flows of the instruments in that partition."@en ;
	.

fibo-sec-dbt-pbs:WeightedAverageCoupon
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:ArithmeticMean ,
		fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure
		;
	rdfs:label "weighted average coupon"@en ;
	skos:definition "weighted-average gross interest rates of the pool of mortgages that underlie a mortgage-backed security (MBS) weighed by their balances at the time the securities were issued"@en ;
	skos:editorialNote "Provided by the Issuer (loan servicer?) along with the WALA etc. If you know the underlying loans you can calculate this yourself. For ABS you don't know this so you have to get this information from the loan servicer. Investopedia explains Weighted Average Coupon - WAC For example, suppose a MBS is composed of two different pools of mortgages: $6 million worth of mortgages that yield 7.5% and a pool of $4 million mortgages that yield 5%. The WAC would be 6.5%. The WAC on a mortgage-backed security is an important piece of information used by analysts to estimate the pre-pay characteristics of that security. It is an important relative value tool in MBS portfolio management and analysis."@en ;
	cmns-av:abbreviation "WAC"@en ;
	cmns-av:explanatoryNote "The weighted average coupon (WAC) is calculated by taking the gross of the interest rates owed on the underlying mortgages of the MBS and weighting them according to the percentage of the security that each mortgage represents. The WAC represents the average interest rate of different pools of mortgages with varying interest rates. In the weighted average calculation, the principal balance of each underlying mortgage is used as the weighting factor. To calculate the WAC, the coupon rate of each mortgage or MBS is multiplied by its remaining principal balance. The results are added together, and the sum total is divided by the remaining balance. A mortgage-backed security's current WAC can differ from its original WAC as the underlying mortgages pay down at different speeds. In the weighted-average calculation, the principal balance of each underlying mortgage is used as the weighting factor."@en ;
	.

fibo-sec-dbt-pbs:WeightedAverageLife
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:ArithmeticMean ,
		fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:refersTo ;
			owl:onClass fibo-sec-dbt-pbs:PrepaymentSpeed ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "weighted average life"@en ;
	skos:definition "weighted average of the times of the principal repayments Average life is calculated using the weighted average time to the receipt of all future cash flows."@en ;
	cmns-av:abbreviation "WAL"@en ;
	cmns-av:explanatoryNote
		"Average life is calculated using the weighted average time to the receipt of all future cash flows of an amortizing loan or amortizing bond. it's the average time until a dollar of principal is repaid."@en ,
		"The time weightings used in weighted average life calculations are based on payments to the principal. In many loans, such as mortgages, each payment consists of payments to principal and payments to interest. In WAL, only the principal payments are considered and these payments tend to get larger over time, with early payments of a mortgage going mostly to interest, while payments made towards the end of the loan are applied mostly to the principal balance of the loan."@en ,
		"Where it refers to pre-payment above, if the bond does not include prepayment then this is not included. However, analytics that refer to this e.g. Yield to Average Life, then this figure is relevant. It is not relevant for other types of bond where e.g. you would use yield to next call, yield to worst etc. Average Life used in place of Maturity for Yield Calculation. This is not only used for Yield calculations though. It is referred to as an analytic figure in its own right. Average Life uses one of a number of standard pre-payment models (for structured finance at least). For MBS, the average life includes some calculations to take account of pre-payments on the underlying mortgages. This takes account of the possibillity of borrowers paying early. This has to be modeled or forecast (not given) as it's a function of market conditions and interest rate. You would not see this in a market data feed. When you model MBS you calculate Average Life as part of the model i.e. you estimate the percentage of prepayment in the next x length of time and factor this into the Average Life. Refers to Weighted Average Time to receipt of future cash flows. For MBS, early payments will shorten the Average Life. For Student Loans, Credit Card, Loan etc, i.e. all Pool Backed (any bond that has securitized debt). Other bonds: Sinking Funds etc., also Early Payment - partial Call for a corporate / regular bond. Early Payment for pass through has the same effect. Sinking Fund: Each payment is part principal and part interest, this is implicit in the overall definition of \"Early payment\"."@en
		;
	cmns-av:synonym "average life"@en ;
	.

fibo-sec-dbt-pbs:WeightedAverageLoanAge
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:ArithmeticMean ,
		fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure
		;
	rdfs:label "weighted average loan age"@en ;
	skos:definition "dollar-weighted average measuring the age of the individual loans in a mortgage pass-through or pooled security"@en ;
	cmns-av:abbreviation "WALA"@en ;
	cmns-av:explanatoryNote
		"A weighted average loan age (WALA) may apply to pool-backed securities such as Ginnie Mae or Freddie Mac securities. The WALA is measured as the time in months since the origination of the loans, with the weighting based on each loan's size in proportion to the aggregate total of the pool."@en ,
		"This is defined by the issuer. WALA is more official, not an analysis from a vendor. This changes but the values are relayed by the issuer on an ongoing basis. Investopedia explains Weighted Average Loan Age - WALA The weighted average age will change over time as some mortgages get paid off faster than others. Based on the issuer of the mortgage-backed securities (MBS), the WALA may be weighted on the remaining principal balance dollar figure, or the beginning notional value of the loan. The flip side of the WALA is the weighted average maturity (WAM), which is a dollar-weighted measure of the months remaining until the principal amounts are completely repaid on each loan in the pool."@en
		;
	.

fibo-sec-dbt-pbs:WeightedAverageMaturity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:ArithmeticMean ,
		fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure
		;
	rdfs:label "weighted average maturity"@en ;
	skos:definition "weighted average amount of time until the maturities on mortgages in a mortgage-backed security (MBS)"@en ;
	cmns-av:abbreviation "WAM"@en ;
	cmns-av:explanatoryNote
		"The measure is calculated by totaling each mortgage value represented by the MBS. The weights of each mortgage is found by dividing the value of each into the total of all. To arrive at the WAM number the weight of each security is multiplied by the time until maturity of each mortgage, and then all the values are added together. For example say an MBS has three mortgages valued at $1,000, $2,000 and $3,000 (a total of $6,000) and mature in one, two and three years respectively. The weights of these are 1/6 (1,000/6,000), 1/3 (2,000/6,000) and 1/2 (3,000/6,000). The WAM is 2 1/3 years (1/6 x 1 year + 1/3 x 2 years + 1/2 x 3 years). Note that this calculation would need to be adjusted if there are multiple pools behind the MBS."@en ,
		"This term is used more broadly to describe maturities in a portfolio of debt securities, including corporate debt and municipal bonds. The higher the WAM, the longer it takes for all of the mortgages or bonds in the portfolio to mature. WAM is used to manage debt portfolios and to assess the performance of debt portfolio managers."@en
		;
	.

fibo-sec-dbt-pbs:WeightedAverageRemainingTerm
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-utl-alx:ArithmeticMean ,
		fibo-sec-dbt-pbs:DebtPoolStatisticalMeasure
		;
	rdfs:label "weighted average remaining term"@en ;
	skos:definition "weighted average time to maturity of a portfolio of asset-backed securities (ABS) or mortgage-backed (MBS) securities"@en ;
	cmns-av:abbreviation "WART"@en ;
	cmns-av:explanatoryNote "The longer the WART, the longer the portfolio's assets will take to mature, on average. WART is often used in relation to mortgage-backed securities (MBS) but can also be applied to any portfolio of fixed-income securities. WART is closely related to weighted average loan age (WALA), which is its inverse."@en ;
	cmns-av:synonym "weighted average remaining maturity"@en ;
	.

fibo-sec-dbt-pbs:hasAttachmentPoint
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
	rdfs:label "has attachment point" ;
	rdfs:range fibo-sec-dbt-pbs:AttachmentPoint ;
	skos:definition "indicates the minimum (lower boundary) of the total value of the underlying collateral, either at issuance or as of some point in time, at which point a given tranche becomes liable for losses" ;
	cmns-av:explanatoryNote "When it is said that a tranche becomes 'liable for losses,' it means that the tranche starts to absorb or incur financial losses due to defaults or impairments in the underlying assets. This is based on the contractual agreements and the structuring of the CDO, which dictate the order in which losses are allocated to different tranches. Note that the notion of 'liability for loss' is in a financial or econonmic sense rather than a legal sense."@en ;
	.

fibo-sec-dbt-pbs:hasDetachmentPoint
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
	rdfs:label "has detachment point" ;
	rdfs:range fibo-sec-dbt-pbs:DetachmentPoint ;
	skos:definition "indicates the maximum (upper boundary) of the total value of the underlying collateral, either at issuance or as of some point in time, at which point the value of given tranche is wiped out" ;
	cmns-av:explanatoryNote "When it is said that a tranche becomes 'liable for losses,' it means that the tranche starts to absorb or incur financial losses due to defaults or impairments in the underlying assets. This is based on the contractual agreements and the structuring of the CDO, which dictate the order in which losses are allocated to different tranches. Note that the notion of 'liability for loss' is in a financial or econonmic sense rather than a legal sense."@en ;
	.

fibo-sec-dbt-pbs:hasEstimatedTotalCollateralValueAtIssuance
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-arr-asmt:isEstimatedValueOf ;
	rdfs:label "is estimated value of" ;
	rdfs:range fibo-fbc-dae-dbt:CollateralValueAsOfDate ;
	skos:definition "indicates the estimated value of the combined underlying collateral for a given tranche at the time the instrument was issued" ;
	.

fibo-sec-dbt-pbs:isPassThrough
	a owl:DatatypeProperty ;
	rdfs:label "is pass through"@en ;
	rdfs:domain fibo-sec-dbt-pbs:PoolBackedSecurity ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the cash flows from the underlying asset pool are passed through to the investor by way of redemption payments"@en ;
	.

fibo-sec-dbt-tstd:BankersAcceptance
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-tstd:BillOfExchange ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtIssue ;
			owl:hasValue fibo-sec-dbt-dbti:AtADiscount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtMaturity ;
			owl:hasValue fibo-sec-dbt-dbti:ParValue ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-gty:hasGuarantor ;
			owl:someValuesFrom fibo-fbc-fct-fse:Bank ;
		]
		;
	rdfs:label "bankers' acceptance"@en ;
	skos:definition "short-term debt instrument that is guaranteed and paid by a bank and used as a relatively safe form of payment for large transactions"@en ;
	cmns-av:explanatoryNote "Considered negotiable instruments with features of a time draft, bankers' acceptances are created by the drawer and provide the bearer with the right to the amount noted on the face of the acceptance on the specified date. Unlike traditional checks, bankers' acceptances function based on the creditworthiness of the banking institution instead of the individual or business acting as the drawer. Additionally, the drawer must provide the funds necessary to support the bankers' acceptance, eliminating the risk associated with insufficient funds on the part of the drawer."@en ;
	.

fibo-sec-dbt-tstd:BillOfExchange
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-tstd:MoneyMarketInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:onClass fibo-fbc-fct-fse:FinancialInstitution ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:onClass fibo-fnd-pas-psch:Payee ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-sec-dbt-tstd:Drawee ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-sec-dbt-tstd:Drawer ;
		]
		;
	rdfs:label "bill of exchange"@en ;
	skos:definition "short-term negotiable financial instrument consisting of an order in writing addressed by one person (the seller of goods) to another (the buyer), requiring the latter to pay a fixed amount of money on demand (a sight draft) or on a predetermined date (a time draft)"@en ;
	cmns-av:explanatoryNote "A bill of exchange is a written agreement between two parties - the buyer and the seller - used primarily in international trade. The buyer or seller typically employs a bank to issue the bill of exchange due to the risks involved with international transactions. Bills of exchange can be transferred by endorsement, much like a check. They can also require the buyer to pay a third party - a bank - in the event that the buyer fails to make good on his agreement with the seller."@en ;
	cmns-av:synonym
		"bank draft"@en ,
		"draft"@en
		;
	.

fibo-sec-dbt-tstd:CommercialPaper
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-tstd:MoneyMarketInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtIssue ;
			owl:hasValue fibo-sec-dbt-dbti:AtADiscount ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtMaturity ;
			owl:hasValue fibo-sec-dbt-dbti:ParValue ;
		]
		;
	rdfs:label "commercial paper"@en ;
	skos:definition "an unsecured short-term debt instrument typically issued by a bank, corporation, or foreign government to obtain funds to meet short-term debt obligations, such as accounts receivable, inventories, or payroll, backed only by an issuing bank or company promise to pay the face amount on the maturity date specified on the note"@en ;
	cmns-av:explanatoryNote "Commercial paper has a very-short to short maturity period (usually, 2 to 30 days, and rarely more than 270 days)."@en ;
	.

fibo-sec-dbt-tstd:Drawee
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-psch:Payer ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-sec-dbt-tstd:BillOfExchange ;
			] ;
		]
		;
	rdfs:label "drawee" ;
	skos:definition "party that is required to pay the amount stated on the bill of exchange to the payee" ;
	.

fibo-sec-dbt-tstd:Drawer
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Obligee ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-sec-dbt-tstd:BillOfExchange ;
			] ;
		]
		;
	rdfs:label "drawer" ;
	skos:definition "party that requires a drawee to pay either a third party or themselves with respect to a bill of exchange" ;
	.

fibo-sec-dbt-tstd:EurodollarDeposit
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-caa:CertificateOfDeposit ;
	rdfs:label "eurodollar deposit"@en ;
	skos:definition "a certificate of deposit with a fixed interest rate issued in U.S. dollars outside the jurisdiction of the Federal Reserve, held at banks outside of the United States, including branches of U.S. banks located outside of the U.S."@en ;
	cmns-av:explanatoryNote "A bank in Japan or Singapore may accept dollar deposits, but these are still called Eurodollar deposits. The market also includes other currencies, so there are Eurosterling, Euroyen, Euroswiss, etc. Eurocurrency is the general term for any currency deposited in bank branches outside countries where it is the national currency."@en ;
	.

fibo-sec-dbt-tstd:MoneyMarketInstrument
	a owl:Class ;
	rdfs:subClassOf fibo-sec-dbt-dbti:FixedIncomeSecurity ;
	rdfs:label "money market instrument"@en ;
	skos:definition "a short-term debt security that gives the owner the unconditional right to receive a stated, fixed sum of money on a specified date"@en ;
	cmns-av:adaptedFrom "https://stats.oecd.org/glossary/detail.asp?ID=6073"^^xsd:anyURI ;
	cmns-av:explanatoryNote "These instruments usually are traded at a discount in organized markets; the discount is dependent upon the interest rate and the time remaining to maturity. Included are such instruments as treasury bills, commercial and financial paper, bankers' acceptances, negotiable certificates of deposit (with original maturities of one year or less), and short-term notes issued under note issuance facilities."@en ;
	.

fibo-sec-dbt-tstd:RepurchaseAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-tstd:MoneyMarketInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDuration ;
			owl:onClass cmns-dt:Duration ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "repurchase agreement"@en ;
	skos:definition "agreement between two parties whereby one party lends the other a security at a specified price with a commitment to take the security back at a later date for another specified price"@en ;
	cmns-av:abbreviation "REPO"@en ;
	cmns-av:explanatoryNote "Most repos are overnight transactions, with the sale taking place one day and being reversed the next day. Long-term repos - called term repos - can extend for a month or more. Usually, repos are for a fixed period of time, but open-ended deals are also possible. Reverse repo is a term used to describe the opposite side of a repo transaction. The party who sells and later repurchases a security is said to perform a repo. The other party - who purchases and later resells the security - is said to perform a reverse repo. While a repo functions like the sale and subsequent repurchase of a security, but the legal reality and the economic effect is that of a secured loan. This is a loan as the original owner retains the rights to the cashflows of the underlying security. Economically, the party purchasing the security makes funds available to the seller and holds the security as collateral. If the repurchased security pays a dividend, coupon or partial redemptions during the repo, the funds are returned to the original owner. The difference between the sale and repurchase prices paid for the security represent interest on the loan. Indeed, repos are quoted as interest rates. A repo always pays interest at maturity, i.e. there are no periodic interest payments."@en ;
	.

fibo-sec-eq-dr:AmericanDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:DepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ;
			owl:hasValue fibo-be-ge-usj:UnitedStatesJurisdiction ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-sec-eq-dr:AmericanDepositaryReceiptLevel ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "American depositary receipt"@en ;
	skos:definition "depositary receipt that represents securities of a foreign company and allows that company's securities to trade in the U.S. financial markets"@en ;
	skos:example "For example, Accton Technology is traded on the Taiwanese exchange. In order for Accton Technology to be traded in the United States, Citibank, acting as a domestic custodian bank, purchases shares of Accton Technology and creates a security, ISIN US00437R1032, which can be traded on a U.S. exchange, in this case PORTAL. Note that the depositary shares do not have to equal the number of original shares. In the case of Accton Technology, one depositary share is equivalent to two original shares."@en ;
	cmns-av:abbreviation "ADR"@en ;
	cmns-av:explanatoryNote "Most ADRs are issued by a domestic custodian bank when the underlying securities are deposited in a foreign depositary bank, usually by a broker who has purchased the securities in the open market local to the foreign company. An ADR can represent a fraction of a share, a single share, or multiple shares of a foreign security. The holder of an ADR has the right to obtain the underlying foreign security that the ADR represents, but investors usually find it more convenient to own the ADR. The price of an ADR generally tracks the price of the foreign security in its home market, adjusted for the ratio of ADRs to foreign company shares. In the case of companies domiciled in the United Kingdom, creation of ADRs attracts a 1.5 percent creation fee; this creation fee is different than stamp duty reserve tax charge by the UK government. Depositary banks have various responsibilities to ADR holders and to the issuing foreign company the ADR represents."@en ;
	.

fibo-sec-eq-dr:AmericanDepositaryReceiptLevel
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-cls:FinancialInstrumentClassifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-sec-eq-dr:AmericanDepositaryReceipt ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-sec-eq-dr:AmericanDepositaryReceiptLevelScheme ;
		]
		;
	rdfs:label "American depositary receipt level"@en ;
	skos:definition "classifier for American depositary receipts that categorizes ADRs into levels based on the extent to which the foreign company has access to the U.S. market"@en ;
	cmns-av:abbreviation "ADR level"@en ;
	.

fibo-sec-eq-dr:AmericanDepositaryReceiptLevelScheme
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-sec-cls:FinancialInstrumentClassificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-sec-eq-dr:AmericanDepositaryReceiptLevel ;
		]
		;
	rdfs:label "American depositary receipt level scheme"@en ;
	skos:definition "classifier for American depositary receipts that categorizes ADRs into levels based on the extent to which the foreign company has access to the U.S. market"@en ;
	cmns-av:abbreviation "ADR level"@en ;
	.

fibo-sec-eq-dr:ChineseDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:GlobalDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ;
			owl:hasValue fibo-be-ge-easj:JurisdictionOfTheRepublicOfChina ;
		]
		;
	rdfs:label "Chinese depositary receipt"@en ;
	skos:definition "global depositary receipt that represents ownership in the securities of a non-Chinese company that trades on a public exchange in China"@en ;
	cmns-av:abbreviation "CDR"@en ;
	cmns-av:explanatoryNote "It refers to shares in non-Chinese companies that trade in China the same way that American depositary receipts (ADRs) allow non-U.S. company shares to trade on American exchanges."@en ;
	.

fibo-sec-eq-dr:DepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:Security ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-eq-dr:hasMultiplier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-eq-dr:hasTradedSecurity ;
			owl:someValuesFrom fibo-fbc-fi-fi:Security ;
		]
		;
	rdfs:label "depositary receipt"@en ;
	skos:definition "negotiable financial instrument issued by a trust company, security depositary, or bank that is evidence of the deposit of publicly traded securities and that facilitates the ownership of securities traded in other jurisdictions"@en ;
	cmns-av:abbreviation "DR"@en ;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote """Depositary receipts are widely used in order to allow the trading of securities in jurisdictions other than
the one where the original securities were issued, such as in a local market. Depositary receipts facilitate buying securities in foreign companies, because the securities do not have to leave the home country. They enable domestic investors to buy securities of foreign companies without the accompanying risks or inconveniences of cross-border and cross-currency transactions."""@en ;
	cmns-av:synonym "depositary receipt"@en ;
	.

fibo-sec-eq-dr:EuropeanDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:GlobalDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ;
			owl:hasValue fibo-be-ge-euj:EuropeanUnionJurisdiction ;
		]
		;
	rdfs:label "European depositary receipt"@en ;
	skos:definition "global depositary receipt that represents ownership in the securities of a non-European company that trades in European financial markets"@en ;
	cmns-av:abbreviation "EDR"@en ;
	cmns-av:explanatoryNote "A European depositary receipt is a European equivalent of the original American depositary receipt (ADR). The EDR is issued by a bank in Europe representing securities traded on an exchange outside of the bank's home country."@en ;
	.

fibo-sec-eq-dr:GlobalDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf fibo-sec-eq-dr:DepositaryReceipt ;
	rdfs:label "global depositary receipt"@en ;
	skos:definition "depositary receipt where a certificate issued by a depositary bank, which purchases securities of foreign companies, creates a security on a local exchange backed by those securities"@en ;
	cmns-av:abbreviation "GDR"@en ;
	cmns-av:explanatoryNote "Global depositary receipts are the global equivalent of the original American depositary receipts (ADR) on which they are based. GDRs represent ownership of an underlying number of securities of a foreign company and are commonly used to invest in companies from developing or emerging markets by investors in developed markets."@en ;
	cmns-av:synonym "international depositary receipt"@en ;
	.

fibo-sec-eq-dr:HongKongDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:GlobalDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ;
			owl:hasValue fibo-be-ge-easj:JurisdictionOfHongKong ;
		]
		;
	rdfs:label "Hong Kong depositary receipt"@en ;
	skos:definition "global depositary receipt that represents the purchase, or ownership, of foreign assets which are deposited in a depositary bank in Hong Kong"@en ;
	cmns-av:abbreviation "HKDR"@en ;
	cmns-av:explanatoryNote "A Hong Kong Depositary Receipt (HDR) is a negotiable instrument issued by a depositary bank that evidences ownership of securities in a corporation organized outside Hong Kong. HDRs trade on the Hong Kong Stock Exchange (HKEx), thus enabling foreign issuers to tap the Hong Kong market and local investors to efficiently invest in quality international companies."@en ;
	.

fibo-sec-eq-dr:IndianDepositoryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:GlobalDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ;
			owl:hasValue fibo-be-ge-sasj:JurisdictionOfIndia ;
		]
		;
	rdfs:label "Indian depositary receipt"@en ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/Indian_Depository_Receipt> ;
	skos:definition "global depositary receipt that represents the purchase, or ownership, of foreign assets which are deposited in a Indian account managed by the Domestic Depository in India"@en ;
	cmns-av:abbreviation "IDR"@en ;
	cmns-av:explanatoryNote "An Indian Depository Receipt (IDR) is an instrument denominated in Indian Rupees in the form of a depositary receipt created by a Domestic Depository (custodian of securities registered with the Securities and Exchange Board of India) against the underlying securities of issuing company to enable foreign companies to raise funds from the Indian securities Markets."@en ;
	.

fibo-sec-eq-dr:JapaneseDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:GlobalDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ;
			owl:hasValue fibo-be-ge-easj:JurisdictionOfJapan ;
		]
		;
	rdfs:label "Japanese depositary receipt"@en ;
	skos:definition "global depositary receipt that represents the purchase, or ownership, of foreign assets which are deposited in a trust bank in Japan"@en ;
	cmns-av:abbreviation "JDR"@en ;
	cmns-av:explanatoryNote "A Japanese Depositary Receipt (JDR) is an instrument issued by a trust bank in Japan that evidences ownership of securities in a corporation organized outside Japan. JDRs trade on the Tokyo Stock Exchange (TSE) in yen, and in accordance with Japanese market conventions, enabling foreign issuers to tap the Japanese capital market and local investors to efficiently invest in quality international companies."@en ;
	.

fibo-sec-eq-dr:LevelIAmericanDepositaryReceipt
	a
		owl:NamedIndividual ,
		fibo-sec-eq-dr:AmericanDepositaryReceiptLevel
		;
	rdfs:label "Level I American depositary receipt"@en ;
	skos:definition "American Depositary Receipt level indicating that the ADR can only be traded over-the-counter in the U.S."@en ;
	cmns-av:abbreviation "Level I ADR"@en ;
	cmns-av:explanatoryNote "This level can apply to sponsored and unsponsored ADRs. However, this is the only level available for unsponsored ADRs. A Level I ADR is easier to set up for foreign companies since it does not require the same disclosures or the need to abide by generally accepted accounting principles (GAAP). There is some degree of risk with Level I ADRs given their relative lack of transparency."@en ;
	.

fibo-sec-eq-dr:LevelIIAmericanDepositaryReceipt
	a
		owl:NamedIndividual ,
		fibo-sec-eq-dr:AmericanDepositaryReceiptLevel
		;
	rdfs:label "Level II American depositary receipt"@en ;
	skos:definition "American Depositary Receipt level that is sponsored and can be listed on an exchange"@en ;
	cmns-av:abbreviation "Level II ADR"@en ;
	cmns-av:explanatoryNote "This level is visible to a wider market and requires the company to comply with the SEC regulatory rules. However, they cannot be used to raise capital."@en ;
	.

fibo-sec-eq-dr:LevelIIIAmericanDepositaryReceipt
	a
		owl:NamedIndividual ,
		fibo-sec-eq-dr:AmericanDepositaryReceiptLevel
		;
	rdfs:label "Level III American depositary receipt"@en ;
	skos:definition "American Depositary Receipt level that can be listed on an exchange and permit companies to issue shares to raise capital for the foreign issuer, but require the highest level of compliance and disclosure"@en ;
	cmns-av:abbreviation "Level III ADR"@en ;
	.

fibo-sec-eq-dr:LuxembourgDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:GlobalDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ;
			owl:hasValue fibo-be-ge-weuj:JurisdictionOfLuxembourg ;
		]
		;
	rdfs:label "Luxembourg depositary receipt"@en ;
	skos:definition "global depositary receipt that represents the purchase, or ownership, of foreign assets which are deposited in a Luxembourg-based account"@en ;
	cmns-av:abbreviation "LDR"@en ;
	cmns-av:explanatoryNote "A Luxembourg Depositary Receipt (LDR) is a certificate which represents the purchase, or ownership, of foreign assets which are deposited in a Luxembourg-based account. An LDR functions in much the same way as a global depositary receipt (GDR). LDRs may represent ownership of either an underlying number of shares or a notional amount of bonds."@en ;
	.

fibo-sec-eq-dr:OffshoreDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:SponsoredDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-sec-rst:hasRestriction ;
			owl:hasValue fibo-sec-sec-usrst:RegulationS ;
		]
		;
	rdfs:label "offshore depositary receipt"@en ;
	skos:definition "depositary receipt issued under SEC Regulation S"@en ;
	cmns-av:explanatoryNote "This regulation means that the securities are not, and will not be registered with any U.S. securities regulation authority. Regulation S shares cannot be held or traded by any 'U.S. person' as defined by SEC Regulation S rules. The shares are registered and issued to offshore, non-U.S. residents."@en ;
	.

fibo-sec-eq-dr:ParticipatoryNote
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-dbt-dbti:TradableDebtInstrument ,
		fibo-sec-eq-dr:DepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-eq-dr:hasTradedSecurity ;
			owl:someValuesFrom fibo-sec-dbt-dbti:TradableDebtInstrument ;
		]
		;
	rdfs:label "participatory note"@en ;
	skos:definition "tradable debt instrument that facilitates the ownership of securities traded in other jurisdictions"@en ;
	skos:example "Participation notes are required by investors or hedge funds to invest in Indian securities without having to register with the Securities and Exchange Board of India (SEBI). P-Notes are among the group of investments considered to be Offshore Derivative Investments (ODIs) in Indian markets."@en ;
	cmns-av:abbreviation
		"P-Note"@en ,
		"PN"@en
		;
	cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
	cmns-av:explanatoryNote
		"""Depository receipts are widely used in order to allow the trading of debt instruments in
jurisdictions other than the one where the original debt instruments were issued"""@en ,
		"Typically P-Notes are SPVs that are created to allow participation from outside that market. The SPV purchases a security on shore and issues a note that represents that security to offshore investors. They are similar to an ADR but always a debt security."@en
		;
	cmns-av:synonym "participation note"@en ;
	.

fibo-sec-eq-dr:PrivatelyPlacedDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:SponsoredDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-sec-sec-rst:hasRestriction ;
			owl:hasValue fibo-sec-sec-usrst:Rule144A ;
		]
		;
	rdfs:label "privately placed depositary receipt"@en ;
	skos:definition "depositary receipt that represents shares in a private placement under the SEC Rule 144-A"@en ;
	cmns-av:explanatoryNote "Some foreign companies will set up an ADR program under SEC Rule 144-A. This provision makes the issuance of shares a private placement. Shares of companies registered under Rule 144-A are restricted stock and may only be issued to or traded by qualified institutional buyers (QIBs). U.S. public shareholders are generally not permitted to invest in these ADR programs, and most are held exclusively through the Depository Trust & Clearing Corporation, so there is often very little information on these companies."@en ;
	.

fibo-sec-eq-dr:SponsoredDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf fibo-sec-eq-dr:AmericanDepositaryReceipt ;
	rdfs:label "sponsored depositary receipt"@en ;
	owl:disjointWith fibo-sec-eq-dr:UnsponsoredDepositaryReceipt ;
	skos:definition "depositary receipt that is issued in collaboration with the foreign company enabling them to tap into international capital markets directly"@en ;
	cmns-av:explanatoryNote "Although a sponsored ADR would be listed in the United States, the issuing company still has its revenue and profit denominated in its home currency."@en ;
	.

fibo-sec-eq-dr:UnsponsoredDepositaryReceipt
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-dr:AmericanDepositaryReceipt ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-sec-eq-dr:LevelIAmericanDepositaryReceipt ;
		]
		;
	rdfs:label "unsponsored depositary receipt"@en ;
	skos:definition "depositary receipt that is established without the company's cooperation"@en ;
	cmns-av:explanatoryNote "For an unsponsored ADR, a depositary entity can issue certificates when there's heavy demand from investors for ownership in a specific company from abroad. The issuing entity is normally a broker-dealer that owns common stock in the company. Because they're issued without the consent or cooperation of the foreign company, unsponsored ADRs generally trade over-the-counter (OTC)—rather than on a stock exchange. Also, shareholder benefits and voting rights may not be extended to the holders of these particular securities. Many large global corporations use unsponsored ADRs to attract American capital. For example, American investors can invest in Royal Mail PLC, a postal and delivery service company from the United Kingdom that was founded by Henry VIII. The company's unsponsored ADR trades OTC under the ticker symbol ROYMY."@en ;
	.

fibo-sec-eq-dr:hasMultiplier
	a owl:DatatypeProperty ;
	rdfs:label "has multiplier"@en ;
	rdfs:domain fibo-sec-eq-dr:DepositaryReceipt ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the number of underlying shares (whether multiple or fractional) represented by a single depositary receipt"@en ;
	.

fibo-sec-eq-dr:hasNumberOfDepositaryReceiptsIssued
	a owl:DatatypeProperty ;
	rdfs:label "has number of depositary receipts issued"@en ;
	rdfs:domain fibo-sec-eq-dr:DepositaryReceipt ;
	rdfs:range xsd:positiveInteger ;
	skos:definition "indicates the number of receipts issued to the general public"@en ;
	.

fibo-sec-eq-dr:hasTradedSecurity
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dsg:denotes ;
	rdfs:label "has traded security"@en ;
	rdfs:domain fibo-sec-eq-dr:DepositaryReceipt ;
	rdfs:range fibo-fbc-fi-fi:Security ;
	skos:definition "links a depositary receipt to the instrument that it represents"@en ;
	.

fibo-sec-eq-dr:hasTradedShare
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-sec-eq-dr:hasTradedSecurity ;
	rdfs:label "has traded share"@en ;
	rdfs:domain fibo-sec-eq-dr:DepositaryReceipt ;
	rdfs:range fibo-sec-eq-eq:Share ;
	skos:definition "links a depositary receipt to the instrument (equity or exchange-traded fund) that it represents"@en ;
	.

fibo-sec-eq-10962:CommonEnhancedVotingRestrictedFullyPaidRegisteredShare
	a owl:Class ;
	rdfs:subClassOf
		fibo-sec-eq-eq:CommonShare ,
		fibo-sec-eq-eq:EnhancedVotingShare ,
		fibo-sec-eq-eq:FullyPaidShare ,
		fibo-sec-eq-eq:RestrictedShare ,
		fibo-sec-sec-lst:RegisteredSecurity ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:hasValue fibo-sec-eq-10962:ESETFR ;
		]
		;
	rdfs:label "common, enhanced voting, restricted, fully-paid, registered share"@en-US ;
	skos:definition "common share that confers multiple votes per share, is restricted from a sales / transfer perspective, is fully paid and is registered" ;
	.

fibo-sec-eq-10962:CommonEnhancedVotingRestrictedNilPaidRegisteredShare
