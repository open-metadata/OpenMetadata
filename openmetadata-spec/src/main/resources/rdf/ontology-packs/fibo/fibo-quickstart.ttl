fibo-fnd-aap-ppl:Adult
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:Person ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasAgeOfMajority ;
			owl:onClass fibo-fnd-aap-ppl:AgeOfMajority ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "adult" ;
	skos:definition "person who has attained the age of majority as defined in some jurisdiction" ;
	cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Adult"^^xsd:anyURI ;
	.

fibo-fnd-aap-ppl:AgeOfMajority
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-aap-ppl:LegalAge ;
	rdfs:label "age of majority" ;
	skos:definition "age at which someone acquires the rights and responsibilities of an adult in some jurisdiction" ;
	.

fibo-fnd-aap-ppl:BirthCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:IdentityDocument ,
		cmns-doc:Certificate ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fnd-aap-ppl:BirthCertificateIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:onClass fibo-fnd-aap-ppl:PlaceOfBirth ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "birth certificate" ;
	skos:definition "an original document certifying the circumstances of the birth, or a certified copy of or representation of the ensuing registration of that birth" ;
	cmns-av:adaptedFrom "http://en.wikipedia.org/wiki/Birth_certificate"^^xsd:anyURI ;
	cmns-av:explanatoryNote "A birth certificate is a vital record that documents the birth of a child. Depending on the jurisdiction, a record of birth might or might not contain verification of the event by such as a midwife or doctor." ;
	cmns-av:synonym "certificate of live birth" ;
	.

fibo-fnd-aap-ppl:BirthCertificateIdentificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fnd-aap-ppl:BirthCertificateIdentifier ;
		]
		;
	rdfs:label "birth certificate identification scheme" ;
	skos:definition "system for allocating identifiers to birth certificates" ;
	cmns-av:explanatoryNote "Schemes for birth certificate identification are typically regionally defined, and there may be jurisdiction-specific scope required as an additional restriction on a specific scheme." ;
	.

fibo-fnd-aap-ppl:BirthCertificateIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-aap-ppl:BirthCertificate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-aap-ppl:BirthCertificateIdentificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "birth certificate identifier" ;
	skos:definition "identifier associated with a vital record documenting the birth of a child" ;
	cmns-av:synonym "birth certificate number" ;
	.

fibo-fnd-aap-ppl:Contact
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isSignifiedBy ;
			owl:someValuesFrom fibo-fnd-aap-ppl:ContactRecord ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:someValuesFrom fibo-fnd-pty-pty:PartyRoleIdentifier ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom cmns-pts:Party ;
		]
		;
	rdfs:label "contact" ;
	skos:definition "role or associated with a party serving as a designated point of communication, typically within a system or process" ;
	.

fibo-fnd-aap-ppl:ContactRecord
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:Record ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:denotes ;
			owl:onClass fibo-fnd-aap-ppl:Contact ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-pty-pty:PartyRoleIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "contact record" ;
	skos:definition "record about a party in a specific communicative or liaison role" ;
	cmns-av:explanatoryNote "Contact records may include attributes such as name, role, communication channel, and affiliation, They may be found in registries, schemas, systems such as those designed for customer relationship management (CRM), enterprise resource planning (ERP), health information, legal and regulatory compliance and others, as well as personal address books, to support communications, coordination, support, or compliance." ;
	.

fibo-fnd-aap-ppl:DateOfBirth
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "date of birth" ;
	skos:definition "explicit date, i.e., the day, month and year, on which an individual was born" ;
	cmns-av:synonym
		"birth date" ,
		"birthday"
		;
	.

fibo-fnd-aap-ppl:DateOfDeath
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "date of death" ;
	skos:definition "explicit date, i.e., the day, month and year, on which an individual died" ;
	cmns-av:synonym "death date" ;
	.

fibo-fnd-aap-ppl:DeathCertificate
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:IdentityDocument ,
		cmns-doc:Certificate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:onClass fibo-fnd-aap-ppl:DateOfDeath ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fnd-aap-ppl:DeathCertificateIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "death certificate" ;
	skos:definition "original document certifying the circumstances of the death (such as how and when it occurred), or a certified copy of or representation of the ensuing registration of that death" ;
	cmns-av:explanatoryNote "A death certificate is a vital record documenting information (including age, occupation, place of birth, place of residence, and often identifying the parents and possibly spouse of the deceased) relating to a dead person and including a doctor's certification of the cause of death." ;
	.

fibo-fnd-aap-ppl:DeathCertificateIdentificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fnd-aap-ppl:DeathCertificateIdentifier ;
		]
		;
	rdfs:label "death certificate identification scheme" ;
	skos:definition "system for allocating identifiers to death certificates" ;
	cmns-av:explanatoryNote "Schemes for death certificate identification are typically regionally defined, and there may be jurisdiction-specific scope required as an additional restriction on a specific scheme." ;
	.

fibo-fnd-aap-ppl:DeathCertificateIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-aap-ppl:DeathCertificate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-aap-ppl:DeathCertificateIdentificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "death certificate identifier" ;
	skos:definition "identifier associated with a vital record documenting the death of an individual" ;
	cmns-av:synonym "death certificate number" ;
	.

fibo-fnd-aap-ppl:DriversLicense
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:IdentityDocument ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fnd-aap-ppl:DriversLicenseIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "driver's license" ;
	skos:definition "an official document which states that a person may operate a motorized vehicle, such as a motorcycle, car, truck or a bus, on a public roadway or provides official identifying information for a non-driver" ;
	cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Non-driver_identification_card#Non-driver_identification_cards"^^xsd:anyURI ;
	cmns-av:synonym "driving licence" ;
	.

fibo-fnd-aap-ppl:DriversLicenseIdentificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fnd-aap-ppl:DriversLicenseIdentifier ;
		]
		;
	rdfs:label "driver's license identification scheme" ;
	skos:definition "system for allocating identifiers to driver's, operating, or non-driver identification documents" ;
	cmns-av:explanatoryNote "Schemes for driver's license identification are typically regionally defined, and there may be jurisdiction-specific scope required as an additional restriction on a specific scheme." ;
	.

fibo-fnd-aap-ppl:DriversLicenseIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-aap-ppl:DriversLicense ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-aap-ppl:DriversLicenseIdentificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "driver's license identifier" ;
	skos:definition "identifier associated with a drivers' or operating license for operating a motor vehicle or non-driver identification card" ;
	cmns-av:synonym "driver's license number" ;
	.

fibo-fnd-aap-ppl:EmancipatedMinor
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-aap-ppl:Minor ;
	rdfs:label "emancipated minor" ;
	skos:definition "a minor who is allowed to conduct a business or any other occupation on his or her own behalf or for their own account outside the control of a parent or guardian" ;
	cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Emancipated_minor"^^xsd:anyURI ;
	cmns-av:explanatoryNote "The minor will then have full contractual capacity to conclude contracts with regard to the business. Whether parental consent is needed to achieve emancipated status varies from case to case. In some cases, court permission is necessary. Protocols vary by jurisdiction." ;
	.

fibo-fnd-aap-ppl:IdentityDocument
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:LegalDocument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:onClass fibo-fnd-plc-adr:PhysicalAddress ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:onClass fibo-fnd-aap-ppl:PlaceOfBirth ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:onClass fibo-be-ge-ge:Government ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
			owl:onClass fibo-fnd-aap-ppl:DateOfBirth ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasExpirationDate ;
			owl:onClass cmns-dt:Date ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDateOfIssuance ;
			owl:onClass cmns-dt:Date ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass cmns-id:Identifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-fnd-aap-ppl:Person ;
		]
		;
	rdfs:label "identity document" ;
	skos:definition "any legal document which may be used to verify aspects of a person's identity" ;
	cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Identification_card"^^xsd:anyURI ;
	cmns-av:explanatoryNote "If issued in the form of a small, mostly standard-sized card, it is usually called an identity card (IC). Countries which do not have formal identity documents may require informal documents. In the absence of a formal identity document, driving licenses can be used in many countries as a method of proof of identity, although some countries do not accept driving licenses for identification, often because in those countries they don't expire as documents and can be old and easily forged. Most countries accept passports as a form of identification. Most countries have the rule that foreign citizens need to have their passport or occasionally a national identity card from their country available at any time if they do not have residence permit in the country." ;
	cmns-av:synonym "identity card" ;
	.

fibo-fnd-aap-ppl:IncapacitatedAdult
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-aap-ppl:Adult ;
	rdfs:label "incapacitated adult" ;
	owl:disjointWith fibo-fnd-aap-ppl:LegallyCapableAdult ;
	skos:definition "an adult who is legally identified as not having legal capacity, typically as a result of some inherent physical or mental incapacity or as a result of having contracted some illness which temporarily deprives them of such capacity" ;
	cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Capacity_(law)"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Individuals may have an inherent physical condition which prevents them from achieving the normal levels of performance expected from persons of comparable age, or their inability to match current levels of performance may be caused by contracting an illness. Whatever the cause, if the resulting condition is such that individuals cannot care for themselves, or may act in ways that are against their interests, those persons are vulnerable through dependency and require the protection of the state against the risks of abuse or exploitation. Hence, any agreements that were made are voidable, and a court may declare that person a ward of the state and grant power of attorney to an appointed legal guardian." ;
	.

fibo-fnd-aap-ppl:LegalAge
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:Age ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "legal age" ;
	skos:definition "age at which someone acquires the capacity to do something that they were prohibited from doing before under the law in some jurisdiction" ;
	.

fibo-fnd-aap-ppl:LegalWorkingAge
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-aap-ppl:LegalAge ;
	rdfs:label "legal working age" ;
	skos:definition "age at which someone acquires the capacity to work legally in some jurisdiction" ;
	.

fibo-fnd-aap-ppl:LegalWorkingAgePerson
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:Person ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasMinimumLegalWorkingAge ;
			owl:onClass fibo-fnd-aap-ppl:LegalWorkingAge ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "legal working age person" ;
	skos:definition "person whose age is greater than the minimum legal working age specified in a jurisdiction in which they work" ;
	.

fibo-fnd-aap-ppl:LegallyCapableAdult
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-aap-ppl:Adult ;
	rdfs:label "legally capable adult" ;
	skos:definition "person who has attained the age of majority as defined in some jurisdiction and who is allowed to conduct a business or any other occupation on his or her own behalf or for their own account" ;
	.

fibo-fnd-aap-ppl:Minor
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-aap-ppl:Person ;
	rdfs:label "minor" ;
	skos:definition "a person under a certain age, usually the age of majority in a given jurisdiction, which legally demarcates childhood from adulthood" ;
	cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Minor_(law)"^^xsd:anyURI ;
	cmns-av:explanatoryNote "The age depends upon jurisdiction and application, but is generally 18." ;
	.

fibo-fnd-aap-ppl:NationalIdentificationNumber
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:onClass fibo-be-ge-ge:Government ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-aap-ppl:NationalIdentificationNumberScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-aap-ppl:Person ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "national identification number" ;
	skos:definition "number or text which appears on an identity document issued by a country or jurisdiction" ;
	cmns-av:adaptedFrom "http://en.wikipedia.org/wiki/National_identification_number"^^xsd:anyURI ;
	cmns-av:explanatoryNote """A national identification number, national identity number, or national insurance number is used by the governments of many countries as a means of tracking their citizens, permanent residents, and temporary residents for the purposes of work, taxation, government benefits, health care, and other governmentally-related functions. The number will appear on an identity document issued by a country.

The ways in which such a system is implemented are dependent on the country, but in most cases, a citizen is issued an identification number at birth or when they reach a legal age (typically the age of 18). Non-citizens may be issued such numbers when they enter the country, or when granted a temporary or permanent residence permit.

Many countries issued such numbers ostensibly for a singular purpose, but over time, they become a de facto national identification number. For example, the United States originally developed its Social Security number system as a means of disbursing Social Security benefits. However, due to function creep, the number has become utilized for other purposes to the point where it is almost essential to have one to, among other things, open a bank account, obtain a credit card, or drive a car.""" ;
	cmns-av:synonym "national identity number" ;
	.

fibo-fnd-aap-ppl:NationalIdentificationNumberScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-aap-ppl:NationalIdentificationNumber ;
		]
		;
	rdfs:label "national identification number scheme" ;
	skos:definition "system for allocating identifiers to national identification numbers" ;
	cmns-av:explanatoryNote "Schemes for national identification numbers are jurisdiction-specific by country." ;
	.

fibo-fnd-aap-ppl:Passport
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:IdentityDocument ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-aap-ppl:PassportNumber ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "passport" ;
	skos:definition "formal identity document, issued by a national government, which certifies the identity and nationality of its holder for the purpose of international travel" ;
	fibo-fnd-utl-av:definitionOrigin "https://en.wikipedia.org/wiki/Passport"^^xsd:anyURI ;
	cmns-av:explanatoryNote "The elements of identity contained in all standardized passports include information about the holder, including name, date of birth, gender and place of birth." ;
	.

fibo-fnd-aap-ppl:PassportNumber
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-aap-ppl:NationalIdentificationNumber ,
		cmns-ra:RegisteredIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-aap-ppl:PassportNumberIdentificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "passport number" ;
	skos:definition "national identification number associated with a passport" ;
	.

fibo-fnd-aap-ppl:PassportNumberIdentificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-aap-ppl:PassportNumber ;
		]
		;
	rdfs:label "passport number identification scheme" ;
	skos:definition "system for allocating identifiers to passports" ;
	cmns-av:explanatoryNote "Schemes for passport identification are jurisdiction-specific by country." ;
	.

fibo-fnd-aap-ppl:Person
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Party ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasDateOfDeath ;
			owl:onClass fibo-fnd-aap-ppl:DateOfDeath ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:hasName ;
			owl:onClass fibo-fnd-aap-ppl:PersonName ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasAge ;
			owl:onClass fibo-fnd-dt-fd:Age ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasResidence ;
			owl:onClass fibo-fnd-plc-adr:ConventionalStreetAddress ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasCitizenship ;
			owl:onClass cmns-loc:Country ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasDateOfBirth ;
			owl:onClass fibo-fnd-aap-ppl:DateOfBirth ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasPlaceOfBirth ;
			owl:onClass fibo-fnd-aap-ppl:PlaceOfBirth ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasGender ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "person"@en ;
	skos:definition "individual human being, with consciousness of self" ;
	cmns-av:synonym "natural person" ;
	.

fibo-fnd-aap-ppl:PersonName
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtdsg:ContextualName ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isNameOf ;
			owl:onClass fibo-fnd-aap-ppl:Person ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasFullLegalName ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-txt:Text ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasNamePrefix ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-txt:Text ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasNameSuffix ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-txt:Text ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-aap-ppl:hasSurname ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-txt:Text ;
		]
		;
	rdfs:label "person name" ;
	skos:definition "designation by which someone is known in some context" ;
	.

fibo-fnd-aap-ppl:PlaceOfBirth
	a owl:Class ;
	rdfs:subClassOf cmns-loc:PhysicalLocation ;
	rdfs:label "place of birth" ;
	skos:definition "physical location, including country, region, and municipality where an individual was born" ;
	cmns-av:synonym "birth place" ;
	.

fibo-fnd-aap-ppl:hasAgeOfMajority
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasAge ;
	rdfs:label "has age of majority" ;
	rdfs:range fibo-fnd-aap-ppl:AgeOfMajority ;
	skos:definition "relates someone to the age required to attain the capacity to engage in certain transactions or be treated legally as an adult in some jurisdiction" ;
	.

fibo-fnd-aap-ppl:hasCitizenship
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
	rdfs:label "has citizenship" ;
	rdfs:domain fibo-fnd-aap-ppl:Person ;
	rdfs:range cmns-loc:Country ;
	skos:definition "links a person to their country of citizenship" ;
	.

fibo-fnd-aap-ppl:hasDateOfBirth
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has date of birth" ;
	rdfs:domain fibo-fnd-aap-ppl:Person ;
	rdfs:range fibo-fnd-aap-ppl:DateOfBirth ;
	skos:definition "identifies the date on which an individual was born" ;
	.

fibo-fnd-aap-ppl:hasDateOfDeath
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has date of death" ;
	rdfs:domain fibo-fnd-aap-ppl:Person ;
	rdfs:range fibo-fnd-aap-ppl:DateOfDeath ;
	skos:definition "identifies the date on which an individual died" ;
	.

fibo-fnd-aap-ppl:hasFamilyName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
	rdfs:label "has family name" ;
	owl:equivalentProperty
		fibo-fnd-aap-ppl:hasLastName ,
		fibo-fnd-aap-ppl:hasSurname
		;
	skos:definition "indicates the name shared in common to identify the members of a family, as distinguished from each member's given name" ;
	cmns-av:explanatoryNote "'Family name' is more commonly used in the United Kingdom than in the United States to refer to someone's surname." ;
	.

fibo-fnd-aap-ppl:hasFirstName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
	rdfs:label "has first name" ;
	owl:equivalentProperty fibo-fnd-aap-ppl:hasGivenName ;
	skos:definition "indicates the given name or first name of a person, that is, the name chosen for them at birth or changed by them subsequently from the name given at birth" ;
	.

fibo-fnd-aap-ppl:hasFullLegalName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf
		fibo-fnd-aap-ppl:hasPersonName ,
		fibo-fnd-rel-rel:hasLegalName
		;
	rdfs:label "has full legal name" ;
	skos:definition "indicates the complete name of a person, typically used in formal situations including those of a legal or contractual nature" ;
	.

fibo-fnd-aap-ppl:hasGender
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "has gender" ;
	rdfs:domain fibo-fnd-aap-ppl:Person ;
	rdfs:range xsd:string ;
	skos:definition "links a particular gender value with a person" ;
	.

fibo-fnd-aap-ppl:hasGivenName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
	rdfs:label "has given name" ;
	skos:definition "indicates the given name or first name of a person, that is, the name chosen for them at birth or changed by them subsequently from the name given at birth" ;
	.

fibo-fnd-aap-ppl:hasLastName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
	rdfs:label "has last name" ;
	owl:equivalentProperty fibo-fnd-aap-ppl:hasSurname ;
	skos:definition "indicates the name shared in common to identify the members of a family, as distinguished from each member's given name" ;
	.

fibo-fnd-aap-ppl:hasMaidenName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
	rdfs:label "has maiden name" ;
	skos:definition "indicates the name shared in common to identify the members of a family, that predates any changes of name due to marriage" ;
	.

fibo-fnd-aap-ppl:hasMiddleNameOrInitial
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
	rdfs:label "has middle name or initial" ;
	skos:definition "one or more additional names or initial letters for names that occur between a person's first and last name" ;
	.

fibo-fnd-aap-ppl:hasMinimumLegalWorkingAge
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasAge ;
	rdfs:label "has minimum legal working age" ;
	rdfs:range fibo-fnd-aap-ppl:LegalWorkingAge ;
	skos:definition "relates someone to the minimum legal working age for the jurisdiction in which they reside" ;
	.

fibo-fnd-aap-ppl:hasNamePrefix
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has name prefix" ;
	skos:definition "indicates a character or sequence of characters, preceding a person's name, that provides additional information about the person, such as a form of address representing a title, honorific, or military rank" ;
	.

fibo-fnd-aap-ppl:hasNameSuffix
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has name suffix" ;
	skos:definition "indicates a character or sequence of characters, following a person's name, that provides additional information about the person, such as their position, educational degree, accreditation, office, or honor" ;
	.

fibo-fnd-aap-ppl:hasPersonName
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dsg:hasTextualName ;
	rdfs:label "has person name" ;
	skos:definition "links a name to an individual" ;
	cmns-av:explanatoryNote "Note that the concept of a person name may include symbology as long as the symbols are properly encoded. Because person name is a class, other iconography or symbology that cannot be encoded in UTF-8 can, alternatively, be linked or attached as a separate image or in another form." ;
	.

fibo-fnd-aap-ppl:hasPlaceOfBirth
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isCharacterizedBy ;
	rdfs:label "has place of birth" ;
	rdfs:domain fibo-fnd-aap-ppl:Person ;
	rdfs:range fibo-fnd-aap-ppl:PlaceOfBirth ;
	skos:definition "identifies the location where an individual was born" ;
	.

fibo-fnd-aap-ppl:hasPointOfContact
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fnd-rel-rel:hasDesignation ,
		cmns-rlcmp:hasRole
		;
	rdfs:label "has point of contact" ;
	rdfs:range fibo-fnd-aap-ppl:Contact ;
	skos:definition "identifies a party designated as the point of contact for" ;
	.

fibo-fnd-aap-ppl:hasPrimaryResidence
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-aap-ppl:hasResidence ;
	rdfs:label "has primary residence" ;
	rdfs:domain fibo-fnd-aap-ppl:Person ;
	rdfs:range fibo-fnd-plc-adr:ConventionalStreetAddress ;
	skos:definition "identifies a dwelling where an individual resides the majority of the year" ;
	cmns-av:explanatoryNote "For tax purposes, in cases when an individual owns more than one home, their primary residence is the home in which they reside most of the time, and for which they can provide evidence to that effect. Having said this, there are cases, such as for individuals that have dual citizenship, where they may have multiple primary residences, one in each country in which they maintain a home. There may also be subtle issues related to 'rent control' that may impact the statements an individual makes about their primary residence. In other words, one cannot necessarily infer a person's identity from their primary place of residence." ;
	.

fibo-fnd-aap-ppl:hasResidence
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-plc-adr:hasAddress ;
	rdfs:label "has residence" ;
	rdfs:domain fibo-fnd-aap-ppl:Person ;
	rdfs:range fibo-fnd-plc-adr:ConventionalStreetAddress ;
	skos:definition "identifies a dwelling where an individual lives" ;
	.

fibo-fnd-aap-ppl:hasSurname
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
	rdfs:label "has surname" ;
	skos:definition "indicates the name shared in common to identify the members of a family, as distinguished from each member's given name" ;
	.

fibo-fnd-aap-ppl:isPointOfContactFor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-rlcmp:hasRole ;
	rdfs:label "is point of contact for" ;
	rdfs:domain fibo-fnd-aap-ppl:Contact ;
	owl:inverseOf fibo-fnd-aap-ppl:hasPointOfContact ;
	skos:definition "is the entity or purpose for which the party is the point of contact" ;
	.

fibo-fnd-agr-agr:Agreement
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:confers ;
			owl:onClass fibo-fnd-agr-agr:Commitment ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:onClass cmns-pts:PartyRole ;
			owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "agreement"@en ;
	skos:definition "negotiated understanding between two or more parties, reflecting the offer and acceptance of commitments on the part of either party" ;
	cmns-av:explanatoryNote "All agreements are time bound, whether implicit or explicitly stated, and thus an agreement reflects a state of affairs that holds for some period of time." ;
	.

fibo-fnd-agr-agr:Beneficiary
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:onClass fibo-fnd-agr-agr:Agreement ;
				owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "beneficiary" ;
	skos:definition "party that receives some benefit or advantage or profits from something" ;
	.

fibo-fnd-agr-agr:BilateralAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Agreement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:onClass cmns-pts:PartyRole ;
			owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "bilateral agreement"@en ;
	owl:disjointWith fibo-fnd-agr-agr:MultilateralAgreement ;
	skos:definition "agreement where two parties commit to perform specific actions or obligations towards each other" ;
	cmns-av:synonym "mutual agreement"@en ;
	.

fibo-fnd-agr-agr:Commitment
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom cmns-pts:PartyRole ;
		]
		;
	rdfs:label "commitment"@en ;
	skos:definition "promise made by some party to act or refrain from acting in some manner" ;
	cmns-av:explanatoryNote "Such a promise often results a corresponding right or obligation with respect to another party to the commitment. Thus, obligations and rights are considered as reciprocal aspects of a commitment." ;
	.

fibo-fnd-agr-agr:CommitmentAtLarge
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-agr:UnilateralCommitment ;
	rdfs:label "commitment at large" ;
	skos:definition "commitment made by some party without direct involvement from the potential beneficiaries of that commitment" ;
	skos:scopeNote "A commitment at large forms the basis for negotiable securities including transferable contracts and potentially other kinds of agreements such as software licenses." ;
	.

fibo-fnd-agr-agr:MultilateralAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Agreement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:onClass cmns-pts:PartyRole ;
			owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "multilateral agreement"@en ;
	skos:definition "agreements that involve or include multiple parties" ;
	cmns-av:explanatoryNote "Multilateral agreements are characterized by the participation and commitment of multiple countries or parties to achieve a common objective or address a shared issue." ;
	.

fibo-fnd-agr-agr:Obligee
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:onClass fibo-fnd-agr-agr:Agreement ;
				owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "obligee" ;
	skos:definition "party to whom some commitment or obligation is owed, either legally or per the terms of an agreement" ;
	.

fibo-fnd-agr-agr:Obligor
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-agr:hasObligation ;
			owl:someValuesFrom fibo-fnd-agr-agr:Commitment ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:onClass fibo-fnd-agr-agr:Agreement ;
				owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			] ;
		]
		;
	rdfs:label "obligor" ;
	skos:definition "party that is bound legally or by agreement to repay a debt, make a payment, do something, or refrain from doing something" ;
	cmns-av:synonym
		"obligated party" ,
		"obligator"
		;
	.

fibo-fnd-agr-agr:UnilateralCommitment
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-agr:Commitment ;
	rdfs:label "unilateral commitment" ;
	skos:definition "commitment (promise or obligation) made by one party without requiring a reciprocal promise from another party" ;
	skos:example "Unilateral commitments include some promotional offers, contests, and rewards, where the offering party sets conditions without requiring upfront agreement from others." ;
	.

fibo-fnd-agr-agr:hasObligation
	a owl:ObjectProperty ;
	rdfs:label "has obligation" ;
	rdfs:domain fibo-fnd-agr-agr:Obligor ;
	owl:inverseOf fibo-fnd-agr-agr:isObligationOf ;
	skos:definition "identifies a duty or obligation that a given party has taken on" ;
	.

fibo-fnd-agr-agr:isObligationOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "is obligation of" ;
	rdfs:range fibo-fnd-agr-agr:Obligor ;
	skos:definition "identifies a party that has a given obligation" ;
	.

fibo-fnd-agr-ctr:AssignableContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:TransferableContract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isAssignable ;
			owl:hasValue "true"^^xsd:boolean ;
		]
		;
	rdfs:label "assignable contract" ;
	skos:definition "contract in which contract holder (assignor) may transfer some or all of their rights and obligations to another party (assignee)" ;
	skos:example "Many, though not all, futures contracts are assignable. This means that the original contract holder can sell the contract to another party in return for cash, and that party then assumes the rights, responsibilities, and benefits of that contract from that point onwards." ;
	cmns-av:explanatoryNote "Note that while the assignor may divest themselves of some rights, that assignment does not necessarily eliminate performance obligations of the assignor to the third party. Characteristics that are important to understand with respect to an assignment include the circumstances in which the assignor remains obligated and any remedies available if the assignor does not perform." ;
	.

fibo-fnd-agr-ctr:BilateralContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:BilateralAgreement ,
		fibo-fnd-agr-ctr:WrittenContract
		;
	rdfs:label "bilateral contract" ;
	skos:definition "contract where two parties commit to perform specific actions or obligations towards each other" ;
	.

fibo-fnd-agr-ctr:BilateralNettingProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:NettingProvision ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-agr-ctr:BilateralContract ;
		]
		;
	rdfs:label "bilateral netting provision"@en ;
	owl:disjointWith fibo-fnd-agr-ctr:MultilateralNettingProvision ;
	skos:definition "netting provision that occurs between two parties, in which mutual obligations are offset to determine a single net payment"@en ;
	.

fibo-fnd-agr-ctr:BreachOfContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:ContractLifecycleEvent ,
		fibo-fnd-dt-oc:OccurrenceKind ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:refersTo ;
			owl:someValuesFrom fibo-fnd-agr-ctr:ContractualCommitment ;
		]
		;
	rdfs:label "breach of contract"@en ;
	skos:definition "classifier of events representing a violation of an express, or implied, condition of a contract to do or not to do something, without a legitimate excuse"@en ;
	cmns-av:explanatoryNote "Examples of events that are considered a breach of contract include discovery of misrepresentation, not completing a job, not paying in full or on time, failing to deliver all the goods, substituting inferior or significantly different goods, not providing a bond when required, being late without excuse, or any act that demonstrates that a party will not complete required work ('anticipatory breach.') Breach of contract is one of the most common causes of law suits for damages and/or court-ordered 'specific performance' of the contract. A breach of contract frequently invalidates the contract."@en ;
	.

fibo-fnd-agr-ctr:BreachOfCovenant
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:ContractLifecycleEvent ,
		fibo-fnd-dt-oc:OccurrenceKind ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:refersTo ;
			owl:someValuesFrom fibo-fnd-agr-ctr:ContractualCommitment ;
		]
		;
	rdfs:label "breach of covenant"@en ;
	skos:definition "classifier of events representing breaking a promise specified in a contract to do or not to do something, without a legitimate excuse"@en ;
	cmns-av:explanatoryNote "In the case of a breach of a covenant or warranty, the contract remains binding and damages only are recoverable for the breach, whereas a breach of contract typically invalidates the entire contract."@en ;
	.

fibo-fnd-agr-ctr:CloseOutNettingProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:NettingProvision ;
	rdfs:label "close-out netting provision"@en ;
	owl:disjointWith fibo-fnd-agr-ctr:SettlementNettingProvision ;
	skos:definition "netting provision that may be triggered when a counterparty defaults, leading to the termination of all outstanding transactions between the parties"@en ;
	cmns-av:explanatoryNote "In the case of close-out netting, the financial positions of the defaulting party are assessed to determine their worth, and total amounts owed are offset, resulting in a single net payment obligation." ;
	cmns-av:synonym "close out netting provision" ;
	.

fibo-fnd-agr-ctr:CollateralAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:WrittenContract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:isCollateralizedBy ;
			owl:onClass fibo-fbc-dae-dbt:Collateral ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isSubordinateTo ;
			owl:someValuesFrom fibo-fnd-agr-ctr:WrittenContract ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-asmt:hasEstimatedValue ;
			owl:someValuesFrom fibo-fnd-acc-cur:MonetaryAmount ;
		]
		;
	rdfs:label "collateral agreement" ;
	skos:definition "written contract related to another contract designed to provide clarity and additional protection for all parties involved, that is separate from the primary contract and that can be independently enforced" ;
	skos:example "Examples may be related to leases, to clarify responsibilities with respect to maintance and repair, to partnerships, clarifying how disputes should be resolved, loan agreements such as deeds of trust, covering the conditions under which the collateral would be forfeited, and uniform commercial code (UCC) agreements." ;
	cmns-av:explanatoryNote "In cases where there are discrepancies between the collateral agreement and primary contract, the primary contract, which may be a master agreement, for example, takes precedence." ;
	.

fibo-fnd-agr-ctr:ConditionPrecedent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractualElement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:isPredicatedOn ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-agr-ctr:ContractualCommitment
					fibo-fnd-law-lcap:ContractualObligation
				) ;
			] ;
		]
		;
	rdfs:label "condition precedent" ;
	skos:definition "stipulation that specifies conditions that must be met before some aspect of a contract takes effect" ;
	cmns-av:explanatoryNote
		"Condition precedents are common in wills and trusts. They include events or states of affairs that act as triggers for the contract to come into effect, such as a beneficiary reaching the age of maturity, or death of a trustor, as well as define obligations on a party to the contract, such as those required of a trustee on the death of a trustor." ,
		"There may also be condition precedents in the ongoing life of a contract, which state that if condition X occurs, event Y will then occur. Condition X is the condition precedent."
		;
	.

fibo-fnd-agr-ctr:Contract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Agreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasEffectiveDate ;
			owl:onClass cmns-dt:Date ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:onClass fibo-fnd-agr-ctr:ContractParty ;
			owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
			owl:someValuesFrom fibo-fnd-agr-ctr:ContractualElement ;
		]
		;
	rdfs:label "contract" ;
	skos:definition "voluntary, deliberate agreement between competent parties to which the parties agree to be legally bound, and for which the parties provide valuable consideration" ;
	cmns-av:explanatoryNote
		"A contractual relationship is evidenced by (1) an offer, (2) acceptance of the offer, and a (3) valid (legal and valuable) consideration. A contract is a kind of agreement, and as such it embodies the assertion that it has been negotiated, such negotiation having included the presence of some offer and the acceptance of that offer on the part of either or both of the parties." ,
		"Contracts are usually written but may be spoken or implied, and generally have to do with employment, sale or lease, or tenancy." ,
		"Note that the data of issuance may be, but is not always, the same as the effective date."
		;
	.

fibo-fnd-agr-ctr:ContractDocument
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:LegalDocument ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:records ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		]
		;
	rdfs:label "contract document" ;
	skos:definition "legal document that records the formal terms and conditions of some contract" ;
	skos:scopeNote "Written here does not necessarily mean a paper document but includes situations in which the contract is expressed electronically, whether as an electronic representation of a formal document such as in PDF form or as an electronic message, provided in the latter case that the message is expressly given formal contractual standing, for example as indicated in a separate covering agreement between the parties." ;
	.

fibo-fnd-agr-ctr:ContractMilestone
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ConditionPrecedent ,
		fibo-fnd-dt-oc:OccurrenceKind ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:onClass fibo-fnd-agr-ctr:MilestoneEvent ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		]
		;
	rdfs:label "contract milestone"@en ;
	skos:definition "classifier for an event (milestone), or set of events related to the status or level of completion of a designated activity, task, or segment of work required for contract fulfillment"@en ;
	cmns-av:explanatoryNote "Milestones are checkpoints that are predefined in the contract, used to measure progress. They specify tasks, deliverables, or objectives that must be achieved to meet each milestone and may trigger partial payment."@en ;
	.

fibo-fnd-agr-ctr:ContractParty
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass cmns-org:LegalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
			] ;
		]
		;
	rdfs:label "contract party" ;
	skos:definition "legally competent party that has entered into a binding agreement, accepting and conceding obligations, responsibilities, and benefits as specified" ;
	.

fibo-fnd-agr-ctr:ContractPrincipal
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractParty ;
	rdfs:label "contract principal" ;
	skos:definition "party that originates a contract and is identified as the first party to that contract, in the event that the contract distinguishes any party as such" ;
	cmns-av:explanatoryNote "The principal to a contract is typically the originator and, in the case of a security, the issuer. In law, the principal is the party that has the primary responsibility in a liability or obligation, as opposed to an endorser, guarantor, or surety." ;
	.

fibo-fnd-agr-ctr:ContractThirdParty
	a owl:Class ;
	rdfs:subClassOf cmns-pts:PartyRole ;
	rdfs:label "contract third party" ;
	skos:definition "party that is indirectly involved in, but not a counterparty to, an agreement" ;
	.

fibo-fnd-agr-ctr:ContractualCommitment
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractualElement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasPart ;
			owl:allValuesFrom fibo-fnd-agr-ctr:ContractualCommitment ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isMandatedBy ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		]
		;
	rdfs:label "contractual commitment" ;
	skos:definition "provision specifying something that the contracting parties agree to, i.e., a promise or pledge made by one of the parties to perform some action or fulfill some duty" ;
	skos:scopeNote "Contractual commitments include general conditions which are common to all types of contracts, such as general and special arrangements, provisions, requirements, rules, rights and obligations, specifications, and standards that form an integral part of an agreement or contract, as well as special conditions which are peculiar to a specific contract (such as, contract change conditions, payment conditions, price variation clauses, penalties). Such a commitment indicates an intention or willingness to do something, which may not be legally binding, for example, to negotiate in good faith." ;
	.

fibo-fnd-agr-ctr:ContractualDefinition
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualElement ;
	rdfs:label "contractual definition" ;
	skos:definition "contractual element that specifies the meaning of a term in a legal document, whose definition is substitutable for the term whenever it occurs in the body of that document" ;
	.

fibo-fnd-agr-ctr:ContractualElement
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Constituent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasLegalDescription ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:string ;
		]
		;
	rdfs:label "contractual element" ;
	skos:definition "element, such as an arrangement, provision, requirement, rule, specification, and standard that forms an integral part of an agreement" ;
	.

fibo-fnd-agr-ctr:Counterparty
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractParty ;
	rdfs:label "counterparty" ;
	skos:definition "party to a contract with whom one negotiates on a given agreement" ;
	cmns-av:explanatoryNote "The counterparty is usually the party 'on the other side' of a contract from the perspective of the issuer or holder. The term 'counterparty' can refer to any party to an agreement, depending on context." ;
	.

fibo-fnd-agr-ctr:DisclosureProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
	rdfs:label "disclosure provision"@en ;
	skos:definition "contractual provision that outlines the requirements and responsibilities of one or both parties to reveal certain information to each other" ;
	cmns-av:explanatoryNote
		"Disclosure provisions are crucial in ensuring transparency, mitigating risks, and maintaining trust between the parties. Typical elements of a disclosure provision include (1) scope - defining the kind of information that must be disclosed, (2) materiality - which usually states that only information material to the agreement must be disclosed, (3) timing - specifying when such disclosures must be made, (4) ongoing requirements - outlining whether or not disclosures any time significant changes or new information must be made available over some period of time, (5) method - specifying how such disclosures must be made, for example, in writing, (6) exclusions - information that is explicitly out of scope with respect to disclosure requirements, (7) confidentiality - restrictions related to whether or not the information is confidential and on how it may be used, and (8) penalities - specifying consequences for failing to disclose relevant information." ,
		"With respect to contracts, failure to disclose key details can lead to breaches of contract or claims of misrepresentation. Disclosure requirements are typically specific to the nature of the contract and jurisdiction."
		;
	.

fibo-fnd-agr-ctr:EarlyTerminationProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:TerminationProvision ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasExpirationDate ;
			owl:someValuesFrom cmns-dt:ExplicitDate ;
		]
		;
	rdfs:label "early termination provision" ;
	skos:definition "termination of an agreement for any reason prior to its expiration date" ;
	cmns-av:explanatoryNote "Early termination date refers to the date set within an agreement for the parties to exercise the option to terminate the contract prior to its original expiration, typically subject to predefined terms such as notice periods or specific conditions. Early termination may be automatically triggered by an event of default with respect to any contract obligation, due to corporate action, or for other reasons. An early termination date may be calculated per the terms of the agreement or specified explicitly at the time the termination event occurs." ;
	.

fibo-fnd-agr-ctr:ExtensionProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractualCommitment ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasExtendablePeriod ;
			owl:onClass cmns-dt:ExplicitDatePeriod ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "extension provision" ;
	skos:definition "contract terms that specify the conditions under which a contract can be extended" ;
	cmns-av:explanatoryNote "In the case of a debt instrument, an extension may include extending the time allowed for repayment of the principal, the maturity date, and so forth." ;
	.

fibo-fnd-agr-ctr:MasterAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:WrittenContract ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:governs ;
			owl:onClass fibo-fnd-agr-ctr:Contract ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "master agreement" ;
	skos:definition "contract between named parties that outlines the terms and conditions designed to apply to a number of accounts, transactions, or other activities between the parties, and that consolidates and provides overarching terms for separate but related agreements" ;
	skos:example
		"A master services agreement governs the terms between a service provider and client. Typically, clients will use Statements of Work that point back to the master agreement so they don't have to recreate a new contract with new terms each time there is a new project, or to cover common terms across services, warranties, and deliveries." ,
		"Some credit facilities and many brokerage arrangements are master agreements."
		;
	cmns-av:explanatoryNote "A master agreement can be used to set out standard terms and conditions so that any new agreements don't need to cover the same information again." ;
	cmns-av:synonym "master contract" ;
	.

fibo-fnd-agr-ctr:MilestoneEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:someValuesFrom fibo-fnd-agr-ctr:ContractMilestone ;
		]
		;
	rdfs:label "milestone event" ;
	skos:definition "event related to the status or level of completion of a designated activity, task, or segment of work required for contract fulfillment" ;
	.

fibo-fnd-agr-ctr:MilestoneSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:Schedule ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-agr-ctr:MilestoneEvent ;
		]
		;
	rdfs:label "milestone schedule" ;
	skos:definition "schedule of milestone events, observations, or other occurrences and the associated dates and/or times when they will be done" ;
	.

fibo-fnd-agr-ctr:MultilateralContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:MultilateralAgreement ,
		fibo-fnd-agr-ctr:WrittenContract
		;
	rdfs:label "multilateral contract" ;
	skos:definition "contract where multiple parties (i.e., more than two) commit to perform specific actions or obligations towards each other" ;
	.

fibo-fnd-agr-ctr:MultilateralNettingProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:NettingProvision ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-agr-ctr:MultilateralContract ;
		]
		;
	rdfs:label "multilateral netting provision"@en ;
	skos:definition "netting provision that, when triggered, is facilitated by a central clearinghouse or financial institution"@en ;
	cmns-av:explanatoryNote "Rather than settling individual obligations between each party, as in bilateral netting, all transactions are aggregated, and a single net amount is determined for each participant." ;
	.

fibo-fnd-agr-ctr:NettingProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
	rdfs:label "netting provision"@en ;
	rdfs:seeAlso <https://www.newyorkfed.org/medialibrary/microsites/fmlg/files/Millerspresentationonnetting.pdf> ;
	skos:definition "contractual element that specifies the method of reducing credit, settlement and other risks by aggregating (combining) two or more obligations to achieve a reduced net obligation"@en ;
	.

fibo-fnd-agr-ctr:NonBindingTerm
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualElement ;
	rdfs:label "non-binding term" ;
	skos:definition "contractual element that is not legally binding on any party to the agreement" ;
	.

fibo-fnd-agr-ctr:NonTransferableContract
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:WrittenContract ;
	rdfs:label "non-transferable contract" ;
	owl:disjointWith fibo-fnd-agr-ctr:TransferableContract ;
	skos:definition "contract between whose individual rights and obligations are not transferable to another party without prior written permission" ;
	.

fibo-fnd-agr-ctr:NotificationProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
	rdfs:label "notification provision" ;
	skos:definition "provision indicating that notification is required prior to the occurrence of a relevant event" ;
	.

fibo-fnd-agr-ctr:NovateableContract
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:TransferableContract ;
	rdfs:label "novateable contract" ;
	skos:definition "contract that may be replaced by another contract, and in that event, extinguishes the rights and obligations in effect under the original contract with those in the new agreement" ;
	cmns-av:explanatoryNote
		"In general, novation means consensual substitution of a party or obligation in the original contract with a new party or obligation in the successor contract. The new party takes on the rights and obligations of the original party. The corresponding novation agreement must be signed by the transferor, the transferee, and the counterparty (the other contracting party). Novation is frequently used in mergers and acquisitions to replace any outstanding relationships or rights and obligations of the organization being subsumed with relationships or obligations of the acquiring entity. It is also commonly used with respect to loan rescheduling." ,
		"Novation is different from assignment in the following ways: (1) novation is a consensual transfer of contractual rights and obligations, while an assignment can transfer only obligations and does not require the consent of the benefiting party, and (2) novation terminates the original contract, but assignment does not."
		;
	.

fibo-fnd-agr-ctr:NovationNettingProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:NettingProvision ;
	rdfs:label "novation netting provision"@en ;
	skos:definition "contractual element that specifies what should be done with respect to netting when a given contract is replaced with another"@en ;
	cmns-av:explanatoryNote "Novation netting contemplates that for each value date and for each currency, the parties agree that all existing contracts will be canceled (discharged and extinguished) and simultaneously replaced by a new contract that aggregates and nets all of the payment obligations of the original contracts. Novation netting occurs immediately when a nettable transaction is entered into." ;
	.

fibo-fnd-agr-ctr:PaymentNettingProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:NettingProvision ;
	rdfs:label "payment netting provision"@en ;
	rdfs:seeAlso <https://www.newyorkfed.org/medialibrary/microsites/fmlg/files/Millerspresentationonnetting.pdf> ;
	skos:definition "netting provision that specifies the way in which all payments in a single currency owed between parties will be aggregated for each traded currency per value date and within the larger aggregate obligation"@en ;
	cmns-av:explanatoryNote "For each value date and for each traded currency, the parties will aggregate and net all payments owed between them to arrive at a single currency obligation for each currency payable between the parties. The parties calculate net payments at some pre-agreed time, typically the day before value date (although it is possible to agree net payments on the value date, depending on the currency and time zone)." ;
	.

fibo-fnd-agr-ctr:Representation
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
	rdfs:label "representation"@en ;
	skos:definition "contractual element that is a statement made by a party to the contract, before or at the time of making the contract, in regard to some fact, circumstance, or state of affairs pertinent to the contract, which the counterparty(ies) rely on, or is influential in bringing about the contract"@en ;
	cmns-av:explanatoryNote "A party may later claim misrepresentation if a false representation has been made. They may be entitled to rescind the contract, which means that the contract would be set aside and the receiving party may also be entitled to damages to put them back into the position they would have been had the contract never been entered into." ;
	.

fibo-fnd-agr-ctr:SettlementNettingProvision
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:NettingProvision ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-agr-ctr:NovationNettingProvision
				fibo-fnd-agr-ctr:PaymentNettingProvision
			) ;
		]
		;
	rdfs:label "settlement netting provision"@en ;
	rdfs:seeAlso <https://www.newyorkfed.org/medialibrary/microsites/fmlg/files/Millerspresentationonnetting.pdf> ;
	skos:definition "netting provision that specifies the way in which on a given payment date, each party will aggregate the amounts of a currency to be delivered by it, and only the difference in the aggregate amounts will be delivered by the party with the larger aggregate obligation"@en ;
	.

fibo-fnd-agr-ctr:TermSheet
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-agr:Agreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasNonBindingTerm ;
			owl:someValuesFrom fibo-fnd-agr-ctr:NonBindingTerm ;
		]
		;
	rdfs:label "term sheet" ;
	skos:definition "nonbinding agreement setting forth the basic terms and conditions under which a proposed business deal may be made" ;
	cmns-av:explanatoryNote "Term sheets state the intentions of the parties and are used to guide legal counsel in the preparation of proposed agreements or contracts." ;
	.

fibo-fnd-agr-ctr:TerminationProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
	rdfs:label "termination provision"@en ;
	skos:definition "contractual element that specifies the circumstances under which the parties can dissolve their legal relationship and discontinue the fulfillment of their obligations under the contract"@en ;
	cmns-av:explanatoryNote "Common reasons for termination include mutual consent, certain notices, breach or failure of a precedent or condition, insolvency, change in control, the occurrence of certain events, and court orders that prohibit continuation of the contract. Termination provisions may include whether they are mutual or unilateral, and may include rights with respect to any cure." ;
	.

fibo-fnd-agr-ctr:TransferableContract
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:WrittenContract ;
	rdfs:label "transferable contract" ;
	skos:definition "contract in which the rights and obligations of one party may be transferred to another party" ;
	.

fibo-fnd-agr-ctr:UnilateralContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:WrittenContract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:confers ;
			owl:allValuesFrom fibo-fnd-agr-agr:UnilateralCommitment ;
		]
		;
	rdfs:label "unilateral contract" ;
	skos:definition "contract in which one party makes an offer that can only be accepted through performance rather than a return promise" ;
	cmns-av:explanatoryNote "In a unilateral, or one-sided, contract, one party, known as the offeror, makes a promise in exchange for an act (or abstention from acting) by another party, known as the offeree. If the offeree acts on the offeror's promise, the offeror is legally obligated to fulfill the contract, but an offeree cannot be forced to act (or not act), because no return promise has been made to the offeror. After an offeree has performed, only one enforceable promise exists, that of the offeror." ;
	.

fibo-fnd-agr-ctr:UseOfProceedsProvision
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
	rdfs:label "use of proceeds provision" ;
	skos:definition "contract provision specifying how funds obtained through financing, such as through a credit agreement, offering, warrant, or other instrument are intended to be used" ;
	cmns-av:explanatoryNote "Examples include for working capital and corporate expenses, for the purchase or upgrades to facilities and/or equipment, and so forth." ;
	.

fibo-fnd-agr-ctr:VerbalContract
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:Contract ;
	rdfs:label "verbal contract" ;
	owl:disjointWith fibo-fnd-agr-ctr:WrittenContract ;
	skos:definition "contract that exists as a result of some verbal exchange" ;
	.

fibo-fnd-agr-ctr:Warranty
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
	rdfs:label "warranty"@en ;
	skos:definition "contractual element that is a statement of fact"@en ;
	cmns-av:explanatoryNote "If a warranty is determined to be false, the receiving party has a claim for breach of contract. If it is a fundamental breach the receiving party may have the right to terminate the contact in addition to a claim for damages. However, unlike a claim for misrepresentation, the contract may not necessarily be voided in its entirety as a consequence."@en ;
	.

fibo-fnd-agr-ctr:WrittenContract
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:Contract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasExecutionDate ;
			owl:onClass cmns-dt:Date ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDateOfIssuance ;
			owl:onClass cmns-dt:Date ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasEffectiveDateTimeStamp ;
			owl:onClass cmns-dt:DateTimeStamp ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasExecutionDateTimeStamp ;
			owl:onClass cmns-dt:DateTimeStamp ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isAssignable ;
			owl:onDataRange xsd:boolean ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasCounterparty ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Counterparty ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasPrincipalParty ;
			owl:someValuesFrom fibo-fnd-agr-ctr:ContractPrincipal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:isEvidencedBy ;
			owl:someValuesFrom fibo-fnd-agr-ctr:ContractDocument ;
		]
		;
	rdfs:label "written contract" ;
	skos:definition "formal contract that is written and signed by the parties thereto" ;
	.

fibo-fnd-agr-ctr:definesTermsFor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dsg:defines ;
	rdfs:label "defines terms for" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	skos:definition "relates a contract to something for which the contract defines legally binding terms and conditions" ;
	.

fibo-fnd-agr-ctr:hasBeneficiary
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fnd-agr-ctr:hasCounterparty ,
		cmns-pts:actsOn
		;
	rdfs:label "has beneficiary"@en ;
	rdfs:range fibo-fnd-agr-agr:Beneficiary ;
	skos:definition "party that receives some benefit or advantage or profits from something as specified in the agreement" ;
	.

fibo-fnd-agr-ctr:hasContractDuration
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasTerm ;
	rdfs:label "has contract duration"@en ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "indicates the period of time during which a contract is intended to be in force once it has been executed" ;
	cmns-av:explanatoryNote "Note that the duration may be relative or explicit, depending on the nature of the contract, and may be extended if the provisions of the contract permit extension." ;
	.

fibo-fnd-agr-ctr:hasContractParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "has contract party" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range fibo-fnd-agr-ctr:ContractParty ;
	skos:definition "indicates a party that has entered into a binding agreement, accepting and conceding obligations, responsibilities, and benefits as specified" ;
	.

fibo-fnd-agr-ctr:hasContractualElement
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has contractual element" ;
	rdfs:domain fibo-fnd-agr-agr:Agreement ;
	rdfs:range fibo-fnd-agr-ctr:ContractualElement ;
	skos:definition "indicates something that is a component of an agreement" ;
	.

fibo-fnd-agr-ctr:hasCounterparty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fnd-agr-ctr:hasContractParty ,
		cmns-pts:hasUndergoer
		;
	rdfs:label "has counterparty" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range fibo-fnd-agr-ctr:Counterparty ;
	skos:definition "identifies a party to a contract, typically not the contract principal" ;
	.

fibo-fnd-agr-ctr:hasEarlyTerminationDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-arr-doc:hasTerminationDate ;
	rdfs:label "has early termination date"@en ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates a termination date that occurs prior to an explicit expiration date"@en ;
	.

fibo-fnd-agr-ctr:hasEffectiveDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has effective date" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "indicates the date a contract, relationship, or policy comes into force" ;
	.

fibo-fnd-agr-ctr:hasEffectiveDateTimeStamp
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDateTimeStamp ;
	rdfs:label "has effective date time stamp" ;
	rdfs:range cmns-dt:DateTimeStamp ;
	skos:definition "indicates the date and time, including time zone, something comes into force" ;
	.

fibo-fnd-agr-ctr:hasExecutionDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has execution date" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "indicates the date a contract has been signed by all the necessary parties" ;
	cmns-av:explanatoryNote "This may or may not be the 'effective date' of the contract, which may be specified in the body of the document." ;
	.

fibo-fnd-agr-ctr:hasExecutionDateTimeStamp
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDateTimeStamp ;
	rdfs:label "has execution date time stamp" ;
	rdfs:range cmns-dt:DateTimeStamp ;
	skos:definition "indicates the date and time, including time zone, a contract has been signed by all the necessary parties" ;
	.

fibo-fnd-agr-ctr:hasExtendablePeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has extendable period" ;
	rdfs:domain fibo-fnd-agr-ctr:ExtensionProvision ;
	rdfs:range cmns-dt:ExplicitDatePeriod ;
	skos:definition "indicates the window of time during which an extension is allowed under the terms of the contract" ;
	.

fibo-fnd-agr-ctr:hasExtensionProvision
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has extension provision" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range fibo-fnd-agr-ctr:ExtensionProvision ;
	skos:definition "specifies the details of a contract provision allowing extension of some aspect of the contract" ;
	cmns-av:explanatoryNote "Typically a contract extension refers to the termination date, coverage period, or, in the case of a security, may refer to extension of repayment or maturity dates." ;
	.

fibo-fnd-agr-ctr:hasGoverningJurisdiction
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-rga:isGovernedBy ;
	rdfs:label "has governing jurisdiction" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range cmns-rga:Jurisdiction ;
	skos:definition "indicates the jurisdiction governing the contract, as agreed by all parties" ;
	skos:editorialNote "As modeled, this relationship combines two slightly different senses in which a Jurisdiction may be named in some Contract: the jurisdiction under whose laws the contract is deemed to be in force, and the jurisdiction under which the parties agree to submit in the event of any dispute resolution. ScopeNote: One thing to tease out is whether 'Dispute Resolution' and other forms of 'Governing Law' are one and the same thing or not. Dispute Resolution is uncontroversial, the question is whether there are other implications to Governing Law or if it's the same thing. For instance I may undertake to behave as though I were responsible to a particular authority i.e., a particular set of statutes." ;
	cmns-av:explanatoryNote "In a written contract this is generally identified, for example, as Governing Law, namely the jurisdiction in which any disputes arising from the contract are to be resolved." ;
	.

fibo-fnd-agr-ctr:hasLegalDescription
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dsg:hasDescription ;
	rdfs:label "has legal description" ;
	rdfs:domain fibo-fnd-agr-ctr:ContractualElement ;
	rdfs:range xsd:string ;
	skos:definition "provides the text, or a summary thereof, expressed in legal terms, of the contract provision, clause, or other element" ;
	.

fibo-fnd-agr-ctr:hasMilestoneProvision
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has milestone provision" ;
	rdfs:domain fibo-fnd-agr-agr:Agreement ;
	rdfs:range fibo-fnd-agr-ctr:ContractMilestone ;
	skos:definition "refers to a requirement included in an agreement related to fulfillment as of some point in time in the lifetime of the contract" ;
	.

fibo-fnd-agr-ctr:hasNonBindingTerm
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
	rdfs:label "has non-binding term" ;
	rdfs:domain fibo-fnd-agr-agr:Agreement ;
	rdfs:range fibo-fnd-agr-ctr:NonBindingTerm ;
	skos:definition "refers to a term that is included in an agreement that is not considered legally binding" ;
	cmns-av:explanatoryNote "In other words, a breach of such terms in the future would not be considered to be a breach of the contract." ;
	.

fibo-fnd-agr-ctr:hasPrincipalParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fnd-agr-ctr:hasContractParty ,
		cmns-pts:hasActor
		;
	rdfs:label "has principal party" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range fibo-fnd-agr-ctr:ContractPrincipal ;
	skos:definition "identifies the main or principal party to a contract" ;
	.

fibo-fnd-agr-ctr:hasTerm
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has term"@en ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "indicates a fixed or limited period for which something, e.g., a contract, an investment, or an offer, lasts or is intended to last"@en ;
	.

fibo-fnd-agr-ctr:hasThirdParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "has third party" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range fibo-fnd-agr-ctr:ContractThirdParty ;
	skos:definition "identifies a party which is not signatory to the party but has some role in the overall context defined by the contract." ;
	.

fibo-fnd-agr-ctr:isAssignable
	a owl:DatatypeProperty ;
	rdfs:label "is assignable" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether the contract and the rights thereunder may be assigned by one of the signatories to some other party" ;
	skos:editorialNote "This is believed to be the basis on which transferable contracts such as financial securities and software licences may be bought and sold on some market, and also the basis on which a bilateral contract such as an over the counter derivative may be novated so that a new party becomes one of the parties. There are subtle distinctions between these three concepts which are not yet represented here." ;
	cmns-av:explanatoryNote "An assignment (Latin cessio) is a term used with similar meanings in the law of contracts and in the law of real estate. In both instances, it encompasses the transfer of rights held by one party, the assignor, to another party, the assignee. The details of the assignment determines some additional rights and liabilities (or duties). Typically a third-party is involved in a contract with the assignor, and the contract is in effect transferred to the assignee." ;
	.

fibo-fnd-agr-ctr:isBeneficiaryOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "is beneficiary of" ;
	rdfs:domain fibo-fnd-agr-agr:Beneficiary ;
	rdfs:range fibo-fnd-agr-agr:Agreement ;
	skos:definition "specifies the agreement that a beneficiary is named in" ;
	.

fibo-fnd-agr-ctr:isEvidenceFor
	a owl:ObjectProperty ;
	rdfs:label "is evidence for" ;
	skos:definition "corroborates" ;
	.

fibo-fnd-agr-ctr:isEvidencedBy
	a owl:ObjectProperty ;
	rdfs:label "is evidenced by" ;
	owl:inverseOf fibo-fnd-agr-ctr:isEvidenceFor ;
	skos:definition "is attested by" ;
	.

fibo-fnd-agr-ctr:isNettingAutomatic
	a owl:DatatypeProperty ;
	rdfs:label "is netting automatic"@en ;
	rdfs:domain fibo-fnd-agr-ctr:NettingProvision ;
	rdfs:range xsd:boolean ;
	skos:definition "indicates whether netting takes place automatically under the scope of the agreement"@en ;
	skos:example "Example text: \"If on any date amounts would otherwise be payable:- (i) in the same currency; and (ii) in respect of the same Transaction, by each party to the other, then, on such date, each party's obligation to make payment of any such amount will be automatically satisfied and discharged and, if the aggregate amount that would otherwise have been payable by one party exceeds the aggregate amount that would otherwise have been payable by the other party, replaced by an obligation upon the party by whom the larger aggregate amount would have been payable to pay to the other party the excess of the larger aggregate amount over the smaller aggregate amount.\""@en ;
	.

fibo-fnd-agr-ctr:isPrimaryContractFor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:isReferredToBy ;
	rdfs:label "is primary contract for" ;
	rdfs:domain fibo-fnd-agr-ctr:WrittenContract ;
	rdfs:range fibo-fnd-agr-ctr:WrittenContract ;
	owl:inverseOf fibo-fnd-agr-ctr:isSubordinateTo ;
	skos:definition "indicates any subordinate agreement, such as a collateral agreement" ;
	.

fibo-fnd-agr-ctr:isQualifiedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isCharacterizedBy ;
	rdfs:label "is qualified by" ;
	skos:definition "indicates a constraint, limitation or refinement on something" ;
	.

fibo-fnd-agr-ctr:isSubordinateTo
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:refersTo ;
	rdfs:label "is subordinate to" ;
	rdfs:domain fibo-fnd-agr-ctr:WrittenContract ;
	rdfs:range fibo-fnd-agr-ctr:WrittenContract ;
	skos:definition "indicates the primary contract referenced by a subordinate agreement, such as a collateral agreement" ;
	cmns-av:explanatoryNote "This property may also be used as the basis for linking agreements based on priority, such as linking a second or junior lien to the primary lien on some collateral" ;
	.

fibo-fnd-agr-ctr:qualifies
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:characterizes ;
	rdfs:label "qualifies" ;
	owl:inverseOf fibo-fnd-agr-ctr:isQualifiedBy ;
	skos:definition "limits, constrains or refines" ;
	.

fibo-fnd-agr-ctr:supersedes
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:label "supersedes" ;
	rdfs:domain fibo-fnd-agr-ctr:Contract ;
	rdfs:range fibo-fnd-agr-ctr:Contract ;
	skos:definition "indicates a contract that was executed prior to and is replaced by this contract" ;
	.

fibo-fnd-arr-arr:Scheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Arrangement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "scheme" ;
	skos:definition "structure or means of organizing information such as a blueprint, schema, numbering system, organization structure, measurement system, plan, taxonomy, or language for organizing information" ;
	.

fibo-fnd-arr-arr:hasCollectionSize
	a owl:DatatypeProperty ;
	rdfs:label "has collection size" ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "indicates the number of elements in a given collection" ;
	.

fibo-fnd-arr-asmt:Appraisal
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:AssessmentReport ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isGeneratedBy ;
			owl:onClass fibo-fnd-arr-asmt:Appraiser ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:evaluates ;
			owl:onClass fibo-fnd-oac-own:Asset ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-asmt:estimatesValueAt ;
			owl:someValuesFrom fibo-fnd-arr-asmt:AppraisedValue ;
		]
		;
	rdfs:label "appraisal" ;
	skos:definition "written estimate of the market value of something as of some point in time, typically provided by a qualified appraiser" ;
	.

fibo-fnd-arr-asmt:AppraisedValue
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-asmt:MarketValue ;
	rdfs:label "appraised value" ;
	skos:definition "estimated value of some asset as of a given point in time" ;
	.

fibo-fnd-arr-asmt:Appraiser
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:evaluates ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:provides ;
			owl:someValuesFrom fibo-fnd-arr-asmt:Appraisal ;
		]
		;
	rdfs:label "appraiser" ;
	skos:definition "party that evaluates or estimates the nature, quality, ability, or value of someone or something" ;
	.

fibo-fnd-arr-asmt:AssessmentActivity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:OccurrenceKind ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:evaluates ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom cmns-pts:AgentRole ;
		]
		;
	rdfs:label "assessment activity" ;
	skos:definition "activity involving the evaluation or estimation of the nature, quality, ability, or value of someone or something" ;
	.

fibo-fnd-arr-asmt:AssessmentEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:evaluates ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOutput ;
			owl:onClass fibo-fnd-arr-asmt:AssessmentReport ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fnd-arr-asmt:AssessmentActivity ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOutput ;
			owl:someValuesFrom fibo-fnd-arr-asmt:Opinion ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom cmns-pts:AgentRole ;
		]
		;
	rdfs:label "assessment event" ;
	skos:definition "event involving the evaluation or estimation of the nature, quality, or ability of someone or something" ;
	.

fibo-fnd-arr-asmt:AssessmentReport
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-rep:Report ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:reportsOn ;
			owl:onClass fibo-fnd-arr-asmt:Opinion ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "assessment report" ;
	skos:definition "report that includes an opinion, judgement, appraisal, or view about something and typically the methodology and raw inputs used to arrive at that opinion" ;
	.

fibo-fnd-arr-asmt:ExpectedValue
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-asmt:Value ;
	rdfs:label "expected value" ;
	owl:disjointWith fibo-fnd-arr-asmt:ObservedValue ;
	skos:definition "theoretical value that is anticipated based on a model or hypothesis" ;
	cmns-av:explanatoryNote "Expected values are often calculated using probability distributions. Note that they can be qualitative, however, such as certain ratings." ;
	.

fibo-fnd-arr-asmt:FairValue
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:MonetaryAmount ,
		fibo-fnd-arr-asmt:QuantitativeValue
		;
	rdfs:label "fair value" ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/Fair_value> ;
	skos:definition "price that would be received to sell an asset, or paid to transfer a liability, in an orderly transaction between market participants at the measurement date" ;
	cmns-av:adaptedFrom "ISO/TS 55010:2024(en), Asset management - Guidance on the alignment of financial and non-financial functions in asset management" ;
	.

fibo-fnd-arr-asmt:MarketValue
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:MonetaryAmount ,
		fibo-fnd-arr-asmt:QuantitativeValue
		;
	rdfs:label "market value" ;
	skos:definition "price an asset would sell for in the market" ;
	.

fibo-fnd-arr-asmt:ObservedValue
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-asmt:Value ;
	rdfs:label "observed value" ;
	skos:definition "value that is an actual data point collected from an experiment, survey, or observation" ;
	.

fibo-fnd-arr-asmt:Opinion
	a owl:Class ;
	rdfs:subClassOf
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:isOutputFrom ;
			owl:someValuesFrom fibo-fnd-arr-asmt:AssessmentEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isGeneratedBy ;
			owl:someValuesFrom cmns-pts:AgentRole ;
		]
		;
	rdfs:label "opinion" ;
	skos:definition "judgement, appraisal, or view about something" ;
	.

fibo-fnd-arr-asmt:PresentValue
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-asmt:QuantitativeValue ;
	rdfs:label "present value" ;
	skos:definition "value of an asset today, which may be calculated from reference data and may based on its expected future value" ;
	.

fibo-fnd-arr-asmt:QualitativeValue
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-arr-asmt:Value ;
	rdfs:label "qualitative value" ;
	owl:disjointWith fibo-fnd-arr-asmt:QuantitativeValue ;
	skos:definition "value that has less precision or accuracy than a value determined via quantitative methods and which is usually expressed in codes rather than actual numbers" ;
	cmns-av:adaptedFrom "ISO/IEC 5207:2024(en), Information technology - Data usage - Terminology and use cases" ;
	cmns-av:explanatoryNote "Qualitative values may follow nominal or ordinal scales, and may be expressed as enumerations." ;
	.

fibo-fnd-arr-asmt:QuantitativeValue
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:Value ,
		cmns-qtu:ScalarQuantityValue
		;
	rdfs:label "quantitative value" ;
	skos:definition "value determined via quantitative methods, expressed as a numerical value in appropriate units" ;
	.

fibo-fnd-arr-asmt:ReferenceValue
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:QuantitativeValue ,
		cmns-doc:Reference
		;
	rdfs:label "reference value" ;
	skos:definition "value for something discernible for which evidence can be obtained" ;
	cmns-av:explanatoryNote "Derivatives, such as certain exotics, can be based on values ascribed to virtually anything, including weather. Typically, however, a reference value refers to something that can be readily observed in the marketplace, such as a quoted rate (e.g., interest rate, exchange rate), index value, commodity price, stock price, economic indicator, or something similar as of some point in time." ;
	.

fibo-fnd-arr-asmt:ValuationMethod
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Strategy ;
	rdfs:label "valuation method"@en ;
	skos:definition "method used to determine the present or expected worth of an asset"@en ;
	cmns-av:explanatoryNote "Asset valuation is the process of determining the fair market or present value of assets, using book values, absolute valuation models like discounted cash flow analysis, option pricing models or comparables. Such assets include investments in marketable securities such as stocks, bonds and options; tangible assets like buildings and equipment; or intangible assets such as brands, patents and trademarks."@en ;
	.

fibo-fnd-arr-asmt:Value
	a owl:Class ;
	rdfs:subClassOf cmns-cls:Aspect ;
	rdfs:label "value" ;
	skos:definition "perceived worth of something, such as a product, service, or asset to a company, customer, or stakeholder" ;
	cmns-av:explanatoryNote """The concept of business value encompasses several dimensions, including:
- Customer Value: The benefits that a customer derives from a product or service, measured against the cost of obtaining it. This includes factors like quality, performance, convenience, and price.
- Economic Value: The financial benefits that a company gains from its assets, investments, or operations. This can be calculated through metrics like revenue, profit, return on investment (ROI), and cost savings.
- Market Value: The price at which an asset or company can be bought or sold in the open market. This reflects the collective assessment of investors and market participants.
- Shareholder Value: The financial returns that shareholders receive from owning a company's stock, including dividends and capital gains.
- Brand Value: The premium that customers are willing to pay for a product or service due to the brand's reputation, recognition, and loyalty.

Overall, value in business is about creating and capturing benefits that meet the needs and expectations of various stakeholders, from customers to investors.""" ;
	cmns-av:synonym "business value" ;
	.

fibo-fnd-arr-asmt:ValueAssessment
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:AssessmentEvent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOutput ;
			owl:onClass fibo-fnd-arr-asmt:Appraisal ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-asmt:appliesMethodology ;
			owl:onClass fibo-fnd-arr-asmt:ValuationMethod ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-asmt:hasAppraiser ;
			owl:someValuesFrom cmns-pts:AgentRole ;
		]
		;
	rdfs:label "value assessment" ;
	skos:definition "assessment event to estimate the value of something" ;
	cmns-av:explanatoryNote "Note that an appraiser in this context may be a licensed appraiser, such as a real estate appraiser or auction house, or a calculation agent, depending on the circumstances." ;
	.

fibo-fnd-arr-asmt:appliesMethodology
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-gao-obj:hasStrategy ;
	rdfs:label "applies methodology" ;
	rdfs:range fibo-fnd-arr-asmt:ValuationMethod ;
	skos:definition "indicates the strategy used for the purposes of determining the fair market or present value of something" ;
	.

fibo-fnd-arr-asmt:estimatesValueAt
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "estimates value at" ;
	rdfs:range fibo-fnd-arr-asmt:AppraisedValue ;
	skos:definition "provides an approximate value of some asset as of some point in time" ;
	.

fibo-fnd-arr-asmt:hasAppraiser
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:isProvidedBy ;
	rdfs:label "has appraiser" ;
	skos:definition "relates an assessment or report to an agent that conducts the assessment" ;
	.

fibo-fnd-arr-asmt:hasDateOfAssessment
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has date of assessment"@en ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "date on which an assessment process was completed"@en ;
	.

fibo-fnd-arr-asmt:hasEstimatedValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has estimated value" ;
	rdfs:range fibo-fnd-arr-asmt:AppraisedValue ;
	skos:definition "relates something to its estimated value" ;
	.

fibo-fnd-arr-asmt:isEstimatedValueOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:isValueOf ;
	rdfs:label "is estimated value of" ;
	rdfs:domain fibo-fnd-arr-asmt:AppraisedValue ;
	owl:inverseOf fibo-fnd-arr-asmt:hasEstimatedValue ;
	skos:definition "relates an appraised value to the asset of interest as of the date of the assessment" ;
	.

fibo-fnd-arr-cls:IndustrySectorClassificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:ClassificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fnd-arr-cls:IndustrySectorClassifier ;
		]
		;
	rdfs:label "industry sector classification scheme" ;
	skos:definition "system for allocating classifiers to organizations by industry sector" ;
	skos:example "Examples include the North American Industry Classification System (NAICS) and Standardized Industry Classification (SIC) in the U.S. and Canada, and the NACE (Nomenclature Générale des Activités Économiques dans les Communautés Européennes) in the EU, developed by governments to classify industries. They also include commercial classification schemes, such as the Global Industry Standard Classification (GICS) developed jointly by Morgan Stanley Capital International (MSCI) and Standard and Poor's, and competing schemes including the Industry Classification Benchmark (ICB) system, maintained by Dow Jones and London's FTSE Group, among others." ;
	.

fibo-fnd-arr-cls:IndustrySectorClassifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-arr-cls:IndustrySectorClassificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "industry sector classifier" ;
	skos:definition "standardized classification or delineation for an organization, or possibly for a security representing an interest in a given organization, per some scheme for such delineation, by industry" ;
	.

fibo-fnd-arr-doc:FinancialRecord
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Collection ,
		cmns-doc:Record
		;
	rdfs:label "financial record" ;
	skos:definition "record of financial information" ;
	skos:example "Financial records include accounts, agreements, trading books, etc." ;
	.

fibo-fnd-arr-doc:hasExpirationDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasEndDate ;
	rdfs:label "has expiration date" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "links something, typically an agreement, contract, document, or perishable item, with an expiration date" ;
	.

fibo-fnd-arr-doc:hasRecord
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has record" ;
	rdfs:range cmns-doc:Record ;
	skos:definition "links something to a record that pertains to it" ;
	.

fibo-fnd-arr-doc:hasReportingPeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has reporting period" ;
	rdfs:range cmns-dt:ExplicitDatePeriod ;
	skos:definition "specifies the reporting period for which a report or something else, such as a market rate or economic indicator, applies" ;
	.

fibo-fnd-arr-doc:hasTerminationDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasEndDate ;
	rdfs:label "has termination date" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "links something, typically an agreement, contract, document, or process, with a date on which it is scheduled to be or was terminated" ;
	.

fibo-fnd-arr-id:Index
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:Reference ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-id:isIndexTo ;
			owl:cardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-arr-id:IndexingScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "index" ;
	skos:definition "indirect shortcut derived from and pointing into, a greater volume of values, data, information or knowledge" ;
	fibo-fnd-utl-av:definitionOrigin "http://en.wikipedia.org/wiki/Index"^^xsd:anyURI ;
	.

fibo-fnd-arr-id:IndexingScheme
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-arr:Scheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fnd-arr-id:Index ;
		]
		;
	rdfs:label "indexing scheme" ;
	skos:definition "system for indexing values, data, information, or knowledge" ;
	.

fibo-fnd-arr-id:ReassignableIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-id:hasAssignmentTerminationDate ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-id:hasInitialAssignmentDate ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
		]
		;
	rdfs:label "reassignable identifier" ;
	skos:definition "identifier that uniquely identifies something for a given time period, and that may be reused to identify something else at a different point in time" ;
	skos:example "ticker symbol, vehicle license number, such as a vanity plate that can be reassigned and moved from one car to another" ;
	cmns-av:explanatoryNote "If no assignment termination date is provided, the identifier is considered to be assigned and valid. If there is no initial assignment date, then the identifier is assumed to be assigned up until the termination date, if any." ;
	.

fibo-fnd-arr-id:constructRegex
	a owl:AnnotationProperty ;
	rdfs:label "construct regex" ;
	rdfs:range xsd:string ;
	skos:definition "indicates how to compose the supplied character string from its components" ;
	.

fibo-fnd-arr-id:hasAssignmentTerminationDate
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dt:hasObservedDateTime ;
	rdfs:label "has assignment termination date" ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "the date on which an identifier is released from its assignment to some resource" ;
	.

fibo-fnd-arr-id:hasInitialAssignmentDate
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dt:hasObservedDateTime ;
	rdfs:label "has initial assignment date" ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "the date on which an identifier is first assigned to some resource" ;
	.

fibo-fnd-arr-id:isIndexTo
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:refersTo ;
	rdfs:label "is index to" ;
	rdfs:domain fibo-fnd-arr-id:Index ;
	skos:definition "that to which the index refers" ;
	.

fibo-fnd-arr-id:parseRegex
	a owl:AnnotationProperty ;
	rdfs:label "parse regex" ;
	rdfs:range xsd:string ;
	skos:definition "indicates how to deconstruct the supplied character string into its components" ;
	.

fibo-fnd-arr-lif:Lifecycle
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Arrangement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleStage ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isLifecycleOf ;
			owl:someValuesFrom owl:Thing ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleStage ;
		]
		;
	rdfs:label "lifecycle" ;
	skos:definition "arrangement that compares the cyclical nature of families, organizations, processes, products, marketing, and order management, portfolio management or other systems with the cradle to grave life stages (birth, growth, maturity, decay, and death) of living organisms" ;
	skos:example "The product life cycle describes the period of time over which an item is developed, brought to market and eventually removed from the market. The cycle is broken into four stages: introduction, growth, maturity and decline. The idea of the product life cycle is used in marketing to decide when it is appropriate to advertise, reduce prices, explore new markets or create new packaging." ;
	.

fibo-fnd-arr-lif:LifecycleEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:OccurrenceKind ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleStage ;
		]
		;
	rdfs:label "lifecycle event" ;
	skos:definition "kind of event that occurs during one or more stages of a lifecycle" ;
	skos:example "a call notification or coupon payment as a part of a bond lifecycle" ;
	.

fibo-fnd-arr-lif:LifecycleEventOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fnd-arr-lif:LifecycleEvent ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleStageOccurrence ;
		]
		;
	rdfs:label "lifecycle event occurrence" ;
	skos:definition "realization of an event in a stage of a lifecycle" ;
	.

fibo-fnd-arr-lif:LifecycleOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fnd-arr-lif:Lifecycle ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleStageOccurrence ;
		]
		;
	rdfs:label "lifecycle occurrence" ;
	skos:definition "realization of a lifecycle" ;
	.

fibo-fnd-arr-lif:LifecycleStage
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isStageOf ;
			owl:someValuesFrom fibo-fnd-arr-lif:Lifecycle ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-fnd-arr-lif:Lifecycle ;
		]
		;
	rdfs:label "lifecycle stage" ;
	skos:definition "phase in a lifecycle" ;
	skos:example "a research and development phase of a product lifecycle, the introduction phase in a marketing lifecycle, a growth stage in an economic lifecycle, or the origination phase in the lifecycle of a loan" ;
	.

fibo-fnd-arr-lif:LifecycleStageOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fnd-arr-lif:LifecycleStage ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isStageOf ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleOccurrence ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleEventOccurrence ;
		]
		;
	rdfs:label "lifecycle stage occurrence" ;
	skos:definition "realization of a phase in a given lifecycle" ;
	.

fibo-fnd-arr-lif:LifecycleStatus
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fnd-arr-lif:LifecycleStageOccurrence ;
		]
		;
	rdfs:label "lifecycle status" ;
	skos:definition "classifier indicating the position or state of something at a particular point in its life-cycle" ;
	.

fibo-fnd-arr-lif:hasLifecycle
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isCharacterizedBy ;
	rdfs:label "has lifecycle" ;
	rdfs:range fibo-fnd-arr-lif:Lifecycle ;
	skos:definition "relates something, such as a product, trade, or related process, to a lifecycle that characterizes it" ;
	.

fibo-fnd-arr-lif:hasStage
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:hasPart ;
	rdfs:label "has stage" ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			fibo-fnd-arr-lif:LifecycleStage
			fibo-fnd-arr-lif:LifecycleStageOccurrence
		) ;
	] ;
	skos:definition "relates something, such as a product or trade lifecycle or related process, to a phase or stage in that lifecycle" ;
	.

fibo-fnd-arr-lif:isLifecycleOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:characterizes ;
	rdfs:label "is lifecycle of" ;
	rdfs:domain fibo-fnd-arr-lif:Lifecycle ;
	owl:inverseOf fibo-fnd-arr-lif:hasLifecycle ;
	skos:definition "relates a lifecycle to something it characterizes" ;
	.

fibo-fnd-arr-lif:isStageOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:isPartOf ;
	rdfs:label "is stage of" ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			fibo-fnd-arr-lif:LifecycleStage
			fibo-fnd-arr-lif:LifecycleStageOccurrence
		) ;
	] ;
	owl:inverseOf fibo-fnd-arr-lif:hasStage ;
	skos:definition "relates a stage in a product or trade lifecycle or process to the lifecycle or process that it is a stage of" ;
	.

fibo-fnd-arr-rt:QualitativeRatingScore
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-rt:RatingScore ,
		cmns-cds:CodeElement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "qualitative rating score" ;
	skos:definition "rating score that is represented as a qualitative code with respect to some rating scale" ;
	cmns-av:explanatoryNote "Ratings for the creditworthiness of securities are often qualitative, rather than quantitative, such as a triple-A (i.e., AAA). Many ratings for products and businesses on the Internet are also qualitative, such as 5-star ratings for something." ;
	.

fibo-fnd-arr-rt:QuantitativeRatingScore
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-rt:RatingScore ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rt:hasMeasureWithinScale ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "quantitative rating score" ;
	skos:definition "rating score that is a simple numeric value on some scale, such as a credit rating for an individual" ;
	.

fibo-fnd-arr-rt:Rating
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:Opinion ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rt:rates ;
			owl:cardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasEffectiveDate ;
			owl:onClass cmns-dt:Date ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:onClass fibo-fnd-arr-rt:RatingIssuer ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isGeneratedBy ;
			owl:onClass fibo-fnd-arr-rt:RatingParty ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDateOfIssuance ;
			owl:onClass cmns-dt:Date ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rt:hasRatingScore ;
			owl:someValuesFrom fibo-fnd-arr-rt:RatingScore ;
		]
		;
	rdfs:label "rating" ;
	skos:definition "standing of something at a particular time, indicated by at least one scores with respect to some scale, based on an assessment by some party" ;
	.

fibo-fnd-arr-rt:RatingAgency
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-rt:RatingIssuer ,
		fibo-fnd-arr-rt:RatingScalePublisher ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom cmns-org:FormalOrganization ;
		]
		;
	rdfs:label "rating agency" ;
	skos:definition "rating issuer that is also a rating scale publisher, frequently but not always an independent rating service" ;
	.

fibo-fnd-arr-rt:RatingAssessmentActivity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:AssessmentActivity ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fnd-arr-rt:RatingParty ;
		]
		;
	rdfs:label "rating assessment activity" ;
	skos:definition "assessment activity resulting in a grade or score and potentially a report describing the score and the process used to determine that score" ;
	.

fibo-fnd-arr-rt:RatingAssessmentEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:AssessmentEvent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOutput ;
			owl:onClass fibo-fnd-arr-rt:RatingReport ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fnd-arr-rt:RatingAssessmentActivity ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOutput ;
			owl:someValuesFrom fibo-fnd-arr-rt:Rating ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fnd-arr-rt:RatingParty ;
		]
		;
	rdfs:label "rating assessment event" ;
	skos:definition "individual assessment resulting in a grade or score and potentially a report describing the score" ;
	.

fibo-fnd-arr-rt:RatingIssuer
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:issues ;
			owl:someValuesFrom fibo-fnd-arr-rt:Rating ;
		]
		;
	rdfs:label "rating issuer" ;
	skos:definition "party that is responsible for issuing ratings" ;
	cmns-av:explanatoryNote "A rating issuer is frequently, but not always the rating scale publisher. A rating issuer may delegate responsibility for producing a rating to a rating party." ;
	.

fibo-fnd-arr-rt:RatingParty
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:generates ;
			owl:someValuesFrom fibo-fnd-arr-rt:Rating ;
		]
		;
	rdfs:label "rating party" ;
	skos:definition "person, organization or group that analyzes some aspect of something and develops a rating" ;
	.

fibo-fnd-arr-rt:RatingReport
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-asmt:AssessmentReport ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:reportsOn ;
			owl:someValuesFrom fibo-fnd-arr-rt:Rating ;
		]
		;
	rdfs:label "rating report" ;
	skos:definition "report describing a set of ratings" ;
	.

fibo-fnd-arr-rt:RatingScale
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:ClassificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rt:hasBestMeasure ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rt:hasWorstMeasure ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isManagedBy ;
			owl:onClass fibo-fnd-arr-rt:RatingScalePublisher ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fnd-arr-rt:RatingScore ;
		]
		;
	rdfs:label "rating scale" ;
	skos:definition "system for assigning a value to something according to some scale with respect to quality, a standard, or ranking" ;
	.

fibo-fnd-arr-rt:RatingScalePublisher
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:manages ;
			owl:someValuesFrom fibo-fnd-arr-rt:RatingScale ;
		]
		;
	rdfs:label "rating scale publisher" ;
	skos:definition "party responsible for managing one or more rating schemes and potentially publishing ratings based on those schemes" ;
	cmns-av:explanatoryNote "Rating scale publishers are frequently also rating agencies." ;
	.

fibo-fnd-arr-rt:RatingScore
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rt:hasMeasureWithinScale ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-arr-rt:RatingScale ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "rating score" ;
	skos:definition "grade, classification, or ranking of for something in accordance with some rating scale" ;
	cmns-av:explanatoryNote "The meaning and methodology for determining a rating score for the rating of something is determined by a rating issuer. A given rating may apply at some point in time, as a part of a lifecycle or process, or generally. Typically ratings reflect an assessment of a state of affairs at some point in time." ;
	.

fibo-fnd-arr-rt:hasBestMeasure
	a owl:DatatypeProperty ;
	rdfs:label "has best measure" ;
	rdfs:domain fibo-fnd-arr-rt:RatingScale ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the 'best' (most desirable) possible value for a rating score's hasMeasureWithinScale property" ;
	cmns-av:explanatoryNote "Note that hasBestMeasure and hasWorstMeasure may be used together to determine the direction and range of a scale's measure values." ;
	.

fibo-fnd-arr-rt:hasMeasureWithinScale
	a owl:DatatypeProperty ;
	rdfs:label "has measure within scale" ;
	rdfs:domain fibo-fnd-arr-rt:RatingScore ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates a relative, numeric measure or ordering on a rating scale" ;
	.

fibo-fnd-arr-rt:hasRating
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
	rdfs:label "has rating" ;
	rdfs:range fibo-fnd-arr-rt:Rating ;
	owl:inverseOf fibo-fnd-arr-rt:rates ;
	skos:definition "indicates the rating assigned to a thing based on a grade or score according to a particular rating scale" ;
	.

fibo-fnd-arr-rt:hasRatingScore
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
	rdfs:label "has rating score" ;
	rdfs:domain fibo-fnd-arr-rt:Rating ;
	rdfs:range fibo-fnd-arr-rt:RatingScore ;
	skos:definition "indicates the grade or score associated with a rating with respect to a particular rating scale" ;
	.

fibo-fnd-arr-rt:hasWorstMeasure
	a owl:DatatypeProperty ;
	rdfs:label "has worst measure" ;
	rdfs:domain fibo-fnd-arr-rt:RatingScale ;
	rdfs:range xsd:decimal ;
	skos:definition "indicates the 'worst' (least desirable) possible value for a rating score's hasMeasureWithinScale property" ;
	cmns-av:explanatoryNote "Note that hasBestMeasure and hasWorstMeasure may be used together to determine the direction and range of a scale's measure values." ;
	.

fibo-fnd-arr-rt:producesRatingsFor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:produces ;
	rdfs:label "produces ratings for" ;
	rdfs:domain fibo-fnd-arr-rt:RatingParty ;
	rdfs:range fibo-fnd-arr-rt:RatingIssuer ;
	owl:inverseOf fibo-fnd-arr-rt:usesRatingParty ;
	skos:definition "issuer for which ratings are produced or posted through" ;
	.

fibo-fnd-arr-rt:rates
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:classifies ;
	rdfs:label "rates" ;
	rdfs:domain fibo-fnd-arr-rt:Rating ;
	skos:definition "indicates the instrument, party or something else to which a rating applies" ;
	.

fibo-fnd-arr-rt:usesRatingParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:isProducedBy ;
	rdfs:label "uses rating performer" ;
	rdfs:domain fibo-fnd-arr-rt:RatingIssuer ;
	rdfs:range fibo-fnd-arr-rt:RatingParty ;
	skos:definition "rating performer an issuer uses to assess ratings" ;
	.

fibo-fnd-arr-rep:Report
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:Document ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:isSubmittedBy ;
			owl:onClass fibo-fnd-arr-rep:Submitter ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasReportingPeriod ;
			owl:onClass cmns-dt:DatePeriod ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:hasReportDateTime ;
			owl:onClass cmns-dt:DateTime ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:hasReportDate ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:isSubmittedTo ;
			owl:onClass cmns-pts:PartyRole ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:isReportedTo ;
			owl:someValuesFrom cmns-pts:PartyRole ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fnd-arr-rep:ReportingParty ;
		]
		;
	rdfs:label "report" ;
	skos:definition "document that provides a structured description of something, prepared on ad hoc, periodic, recurring, regular, or as required basis" ;
	cmns-av:explanatoryNote "Reports may refer to specific periods, events, occurrences, or subjects, and may be communicated or presented in oral, electronic, or written form." ;
	.

fibo-fnd-arr-rep:ReportingParty
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:provides ;
			owl:someValuesFrom fibo-fnd-arr-rep:Report ;
		]
		;
	rdfs:label "reporting party" ;
	skos:definition "party providing a report, typically in response to some contractual, legal, regulatory or other business requirement" ;
	.

fibo-fnd-arr-rep:Request
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:hasRequestDateTime ;
			owl:onClass cmns-dt:DateTime ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:hasRequestDate ;
			owl:onClass cmns-dt:ExplicitDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:isRequestedBy ;
			owl:someValuesFrom fibo-fnd-arr-rep:Requester ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:isRequestedOf ;
			owl:someValuesFrom cmns-pts:PartyRole ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:someValuesFrom fibo-fnd-arr-rep:RequestActivity ;
		]
		;
	rdfs:label "request" ;
	skos:definition "event in which some party asks another party for something at some point in time" ;
	.

fibo-fnd-arr-rep:RequestActivity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:OccurrenceKind ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:requests ;
			owl:someValuesFrom owl:Thing ;
		]
		;
	rdfs:label "request activity" ;
	skos:definition "activity in which some party asks another party for something or to do something" ;
	.

fibo-fnd-arr-rep:Requester
	a owl:Class ;
	rdfs:subClassOf cmns-pts:PartyRole ;
	rdfs:label "requester"@en ;
	skos:definition "party that asks for something"@en ;
	.

fibo-fnd-arr-rep:Submitter
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-rep:submits ;
			owl:someValuesFrom fibo-fnd-arr-rep:Report ;
		]
		;
	rdfs:label "submitter" ;
	skos:definition "party presenting something, such as a regulatory report" ;
	.

fibo-fnd-arr-rep:hasReportDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasDateOfIssuance ,
		cmns-dt:hasExplicitDate
		;
	rdfs:label "has report date"@en ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "date on which a report was issued"@en ;
	.

fibo-fnd-arr-rep:hasReportDateTime
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDateTime ;
	rdfs:label "has report date time"@en ;
	rdfs:range cmns-dt:DateTime ;
	skos:definition "date and time at which a report was issued"@en ;
	.

fibo-fnd-arr-rep:hasRequestDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has request date"@en ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "date on which a request was made"@en ;
	.

fibo-fnd-arr-rep:hasRequestDateTime
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDateTime ;
	rdfs:label "has request date time"@en ;
	rdfs:range cmns-dt:DateTime ;
	skos:definition "date and time at which a request was made"@en ;
	.

fibo-fnd-arr-rep:isReportedTo
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "is reported to" ;
	rdfs:range cmns-pts:PartyRole ;
	skos:definition "indicates the party to which something is reported" ;
	.

fibo-fnd-arr-rep:isRequestedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "is requested by" ;
	rdfs:range fibo-fnd-arr-rep:Requester ;
	skos:definition "indicates the party that asks for something" ;
	.

fibo-fnd-arr-rep:isRequestedOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "is requested of" ;
	rdfs:range cmns-pts:PartyRole ;
	skos:definition "indicates the party that is asked for something" ;
	.

fibo-fnd-arr-rep:isSubmittedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:isProvidedBy ;
	rdfs:label "is submitted by" ;
	rdfs:range fibo-fnd-arr-rep:Submitter ;
	owl:inverseOf fibo-fnd-arr-rep:submits ;
	skos:definition "indicates the party that submits something" ;
	.

fibo-fnd-arr-rep:isSubmittedTo
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "is submitted to" ;
	rdfs:range cmns-pts:PartyRole ;
	skos:definition "indicates the party to which something is submitted" ;
	.

fibo-fnd-arr-rep:reportsOn
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:isAbout ;
	rdfs:label "reports on" ;
	rdfs:domain fibo-fnd-arr-rep:Report ;
	skos:definition "indicates a subject matter, observation(s), assessment(s), focus or other topic of a report" ;
	.

fibo-fnd-arr-rep:requests
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:isAbout ;
	rdfs:label "requests" ;
	skos:definition "asks for something" ;
	.

fibo-fnd-arr-rep:submits
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:provides ;
	rdfs:label "submits" ;
	rdfs:domain fibo-fnd-arr-rep:Submitter ;
	skos:definition "presents something (a proposal, application, report, or other document) for consideration or review" ;
	.

fibo-fnd-dt-bd:BusinessDayConvention
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-bd:BusinessRecurrenceIntervalConvention ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasBusinessCenter ;
			owl:onClass cmns-loc:BusinessCenter ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "business day convention" ;
	skos:definition "convention that enumerates the possible ways to handle a date that falls on a weekend or holiday" ;
	cmns-av:adaptedFrom "https://www.actusfrf.org/dictionary" ;
	cmns-av:explanatoryNote
		"Business day conventions are linked to a calendar. Calendars have working and non-working days. In the ACTUS dictionary, the rules related to business day conventions (BDCs) state that a BDC value other than N means that cash flows cannot fall on non-working days, they must be shifted to the next business day (following) or the previous on (preceding). These two simple rules get refined twofold: (1) Following modified (preceding): Same like following (preceding), however if a cash flow gets shifted into a new month, then it is shifted to preceding (following) business day; (2) Shift/calculate (SC) and calculate/shift (CS). Accrual, principal, and possibly other calculations are affected by this choice. In the case of SC first the dates are shifted and after the shift cash flows are calculated. In the case of CS it is the other way round." ,
		"""Business day conventions commonly include:
- Following business day: Moves the date to the next business day
- Modified following business day: Moves the date to the next business day, unless it would fall in the next calendar month
- Preceding business day: Moves the date to the previous business day
- Modified preceding business day: Moves the date to the previous business day, unless it would fall in the previous calendar month""" ,
		"""The 2006 IDSA Definitions Section 4.11, provide the following examples: FRN Convention; Eurodollar Convention.
- If a payment date or period end date falls on a non-business day, it is moved to the next business day.
- If there is no numerically corresponding day in a calendar month, the payment date or period end date is moved to the last business day in that month."""
		;
	cmns-av:synonym "business day adjustment" ;
	.

fibo-fnd-dt-bd:BusinessDayFollowing
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-bd:BusinessDayConvention
		;
	rdfs:label "business day following" ;
	skos:definition "convention specifying that a non-business date will be adjusted to the first following day that is a business day" ;
	cmns-av:adaptedFrom 'FPML 5.1 "BusinessDayConventionEnum"' ;
	.

fibo-fnd-dt-bd:BusinessDayModifiedFollowing
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-bd:BusinessDayConvention
		;
	rdfs:label "business day modified following" ;
	skos:definition "convention specifying that a non-business date will be adjusted to the first following day that is a business day unless that day falls in the next calendar month, in which case that date will be the first preceding day that is a calendar date" ;
	cmns-av:adaptedFrom 'FPML 5.1 "BusinessDayConventionEnum"' ;
	.

fibo-fnd-dt-bd:BusinessDayModifiedPreceding
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-bd:BusinessDayConvention
		;
	rdfs:label "business day modified preceding" ;
	skos:definition "convention specifying that a non-business date will be adjusted to the first preceding day that is a business day unless that day falls in the previous month, in which case that date will be the first following day that is a business day" ;
	cmns-av:adaptedFrom 'FPML 5.1 "BusinessDayConventionEnum"' ;
	.

fibo-fnd-dt-bd:BusinessDayNearest
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-bd:BusinessDayConvention
		;
	rdfs:label "business day nearest" ;
	skos:definition "convention specifying that a non-business date will be adjusted to the nearest day that is a business day -- i.e. if the non-business day falls on any day other than a Sunday or a Monday, it will be the first preceding day that is a business day, and will be the first following business day if it falls on a Sunday or a Monday" ;
	cmns-av:adaptedFrom 'FPML 5.1 "BusinessDayConventionEnum"' ;
	.

fibo-fnd-dt-bd:BusinessDayNone
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-bd:BusinessDayConvention
		;
	rdfs:label "business day none" ;
	skos:definition "convention specifying that a date will not be adjusted if it falls on a day that is not a business day" ;
	cmns-av:adaptedFrom 'FPML 5.1 "BusinessDayConventionEnum"' ;
	.

fibo-fnd-dt-bd:BusinessDayPreceding
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-bd:BusinessDayConvention
		;
	rdfs:label "business day preceding" ;
	skos:definition "convention specifying that a date will be adjusted to the first previous day that is a business day" ;
	.

fibo-fnd-dt-bd:BusinessRecurrenceInterval
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:RecurrenceInterval ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-bd:hasBusinessRecurrenceIntervalConvention ;
			owl:onClass fibo-fnd-dt-bd:BusinessRecurrenceIntervalConvention ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "business recurrence interval" ;
	skos:definition "recurrence interval that is defined per a specific convention that determines how recurring days should be handled" ;
	.

fibo-fnd-dt-bd:BusinessRecurrenceIntervalConvention
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-dt-bd:Convention ;
	rdfs:label "business recurrence interval convention" ;
	skos:definition "convention that specifies how recurring days should be handled, such as the end of the month, a particular day of the month, a day of the week, or more specifically, a t-bill auction date" ;
	.

fibo-fnd-dt-bd:Convention
	a owl:Class ;
	rdfs:label "convention" ;
	skos:definition "widely accepted or established way of doing 'something' within some community of practice" ;
	.

fibo-fnd-dt-bd:DayOfMonth
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-bd:BusinessRecurrenceInterval ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasOrdinalNumber ;
			owl:onDataRange xsd:nonNegativeInteger ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "day of month" ;
	skos:definition "specific, recurring day of the month" ;
	.

fibo-fnd-dt-bd:DayOfWeek
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-dt-bd:BusinessRecurrenceInterval ;
	rdfs:label "day of the week" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:oneOf (
			fibo-fnd-dt-fd:Friday
			fibo-fnd-dt-fd:Monday
			fibo-fnd-dt-fd:Saturday
			fibo-fnd-dt-fd:Sunday
			fibo-fnd-dt-fd:Thursday
			fibo-fnd-dt-fd:Tuesday
			fibo-fnd-dt-fd:Wednesday
		) ;
	] ;
	skos:definition "specific, recurring day of the week" ;
	.

fibo-fnd-dt-bd:EndOfMonth
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-dt-bd:BusinessRecurrenceInterval ;
	rdfs:label "end of the month" ;
	skos:definition "the last day of a calendar month, irrespective of the length of the calendar month" ;
	.

fibo-fnd-dt-bd:hasBusinessDayConvention
	a owl:ObjectProperty ;
	rdfs:label "has business day convention" ;
	rdfs:range fibo-fnd-dt-bd:BusinessDayConvention ;
	skos:definition "identifies a convention regarding how a date should be handled when it falls on a day that is not a business day, such as a weekend or holiday" ;
	.

fibo-fnd-dt-bd:hasBusinessRecurrenceIntervalConvention
	a owl:ObjectProperty ;
	rdfs:label "has business recurrence interval convention" ;
	rdfs:range fibo-fnd-dt-bd:BusinessRecurrenceIntervalConvention ;
	skos:definition "identifies a convention regarding how certain recurring dates should be handled with respect to a given schedule, such as the end of the month" ;
	.

fibo-fnd-dt-fd:AdHocSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:Schedule ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-dt-fd:AdHocScheduleEntry ;
		]
		;
	rdfs:label "ad hoc schedule" ;
	skos:definition "schedule consisting of some number of individual events that are not necessarily recurring" ;
	cmns-av:usageNote "Other ontologies can extend AdHocSchedule and/or AdHocScheduleEntry as needed to relate the date to something. In particular, the Occurrences ontology extends AdHocScheduleEntry to associate an OccurrenceKind with each entry. The intended meaning is that an Occurrence of the OccurrenceKind happens on the corresponding Date." ;
	.

fibo-fnd-dt-fd:AdHocScheduleEntry
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedCollectionConstituent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOccurrence ;
			owl:onClass fibo-fnd-dt-oc:Occurrence ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "ad hoc schedule entry" ;
	skos:definition "entry, including a date or date and time, among multiple non-regularly-recurring entries in a schedule" ;
	cmns-av:usageNote
		"Other ontologies can extend AdHocScheduleEntry as needed. In particular, the Occurrences ontology extends AdHocScheduleEntry to consist of occurrences (events) of a given OccurrenceKind. The meaning is that an ad hoc schedule entry comprises a date and an event which is scheduled to occur on that date." ,
		"""The Date of an AdHocScheduleEntry can be an ExplicitDate or any kind of CalculatedDate, such as:

* An OccurrenceBasedDate -- a Date that itself is defined by an Occurrence (see the Occurrences ontology)
* A RelativeDate - a Date relative to another Date, such as T+3
* A SpecifiedDate - a Date that is defined by an arbitrary rule""" ,
		"The cmns-dt;hasDate property may be used to reify a date, if it is important to do so for a given application, or if not and typically, the inherited cmns-dt;hasObservedDateTime property may be used together with a cmns-dt;CombinedDateTime value, as long as the resulting schedule is consistent in using one or the other."
		;
	.

fibo-fnd-dt-fd:Age
	a owl:Class ;
	rdfs:subClassOf
		cmns-dt:Duration ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasAsOfDate ;
			owl:someValuesFrom cmns-dt:ExplicitDate ;
		]
		;
	rdfs:label "age" ;
	skos:definition "length of time that something or someone has been alive or existed" ;
	.

fibo-fnd-dt-fd:AnchorDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "anchor date" ;
	skos:definition "fixed reference point within a series or timeline" ;
	cmns-av:explanatoryNote "It is an explicit date chosen to provide context or structure for analyzing data or events." ;
	.

fibo-fnd-dt-fd:BusinessCalendar
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-dt-fd:Schedule ;
	rdfs:label "business calendar" ;
	skos:definition "schedule and communications tool used to manage meetings, plan events, and coordinate activities within and/or across organizations" ;
	skos:example "academic calendar, bank holiday calendar" ;
	.

fibo-fnd-dt-fd:CalculatedDate
	a owl:Class ;
	rdfs:subClassOf
		cmns-dt:Date ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-bd:hasBusinessDayConvention ;
			owl:onClass fibo-fnd-dt-bd:BusinessDayConvention ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "calculated date" ;
	owl:disjointWith cmns-dt:ExplicitDate ;
	skos:definition "date that is or will be determined based on some formula" ;
	cmns-av:explanatoryNote "The hasDateValue property of a CalculatedDate is not set until the Date is calculated. Since the calculation may depend upon future events that may or may not ever happen, the hasDateValue property may never be set." ;
	.

fibo-fnd-dt-fd:CalculationPeriod
	a owl:Class ;
	rdfs:subClassOf
		cmns-dt:ExplicitDatePeriod ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDuration ;
			owl:onClass fibo-fnd-dt-fd:CalculationPeriodLength ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "calculation period" ;
	skos:definition "explicit period from the start to the end of a specific interval or range within which a computational process or operation occurs" ;
	.

fibo-fnd-dt-fd:CalculationPeriodLength
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDuration ;
	rdfs:label "calculation period length" ;
	skos:definition "explicit number of days from the adjusted effective or start date to the adjusted termination or end date calculated in accordance with the applicable day count fraction" ;
	.

fibo-fnd-dt-fd:CalendarMonth
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:CalendarPeriod
		;
	rdfs:label "calendar month" ;
	skos:definition "time interval resulting from the division of a calendar year in 12 time intervals, each with a specific name and containing a specific number of calendar days" ;
	cmns-av:adaptedFrom "ISO 8601, clause 2.2.11" ;
	.

fibo-fnd-dt-fd:CalendarPeriod
	a owl:Class ;
	rdfs:subClassOf cmns-dt:TimeInterval ;
	rdfs:label "calendar period" ;
	skos:definition "time interval that occurs within a system that fixes the beginning and length of a segment of the year with respect to that system" ;
	skos:editorialNote """The terms 'calendar xxx' are intended to reinforce that these are periods on a calendar, not durations. 

For example, a calendar year always starts on a January 1 and ends on a December 31. The term 'calendar year' does not mean the same thing as a duration (an amount of time) of 1 year, nor can a calendar year start on any arbitrary day of a year. For example, a calendar year never starts on September 1.

Similar points apply to other kinds of calendar periods, such as calendar week, calendar month, and calendar quarter.""" ;
	cmns-av:explanatoryNote "A calendar-specified date may be figured with respect to a calendar week, a calendar month, a calendar quarter, or a calendar year." ;
	.

fibo-fnd-dt-fd:CalendarQuarter
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:CalendarPeriod
		;
	rdfs:label "calendar quarter" ;
	skos:definition "time interval of 3 months, starting on January 1, April 1, July 1, or October 1" ;
	.

fibo-fnd-dt-fd:CalendarSpecifiedInterval
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:RecurrenceInterval ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasCalendarPeriod ;
			owl:onClass fibo-fnd-dt-fd:CalendarPeriod ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasTimeDirection ;
			owl:onClass fibo-fnd-dt-fd:TimeDirection ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasOrdinalNumber ;
			owl:onDataRange xsd:integer ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "calendar-specified interval" ;
	owl:disjointWith fibo-fnd-dt-fd:ExplicitRecurrenceInterval ;
	skos:definition "recurrence interval that is defined as the nth day of some calendar period (such as a calendar month), and a time direction (forward from the beginning of the month, or backwards from the end)" ;
	skos:example
		"The 15th day of each calendar month." ,
		"The last day of each quarter, specified as RelativeDay 1, and TimeDirection set to FromEnd."
		;
	cmns-av:explanatoryNote "The nth day is an ordinal number, not a cardinal number. '1' means the first day of the calendar period." ;
	.

fibo-fnd-dt-fd:CalendarWeek
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:CalendarPeriod
		;
	rdfs:label "calendar week" ;
	skos:definition "time interval of seven calendar days starting on a Monday" ;
	cmns-av:adaptedFrom "ISO 8601, clause 2.2.8" ;
	.

fibo-fnd-dt-fd:CalendarYear
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:CalendarPeriod
		;
	rdfs:label "calendar year" ;
	skos:definition "cyclic time interval in a calendar which is required for one revolution of the Earth around the Sun and approximated to an integral number of calendar days; a year in the Gregorian calendar" ;
	cmns-av:adaptedFrom "ISO 8601 clause 2.2.13" ;
	.

fibo-fnd-dt-fd:DatedCollectionConstituent
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Constituent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasObservedDateTime ;
			owl:someValuesFrom cmns-dt:CombinedDateTime ;
		]
		;
	rdfs:label "dated collection constituent" ;
	skos:definition "element of a collection that is associated with a date and time" ;
	cmns-av:explanatoryNote "Note that the use of several options for the representation of a date and time stamp enables extensions for milliseconds, nanoseconds using an xsd:string that has the format of an xsd:dateTime datatype but extends the level of granularity consistently. An example of where this is required is to represent prices that change multiple times in a given day." ;
	cmns-av:usageNote "The use of custom datatypes is outside the OWL 2 RL profile and so users should consider commenting out the restriction on hasObservedDateTime altogether or change the data range to rdfs:Literal in applications that are constrained to OWL 2 RL." ;
	.

fibo-fnd-dt-fd:DatedStructuredCollection
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:StructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-dt-fd:DatedCollectionConstituent ;
		]
		;
	rdfs:label "dated structured collection" ;
	skos:definition "structured collection whose elements are required to have a date and time" ;
	.

fibo-fnd-dt-fd:ExplicitRecurrenceInterval
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:RecurrenceInterval ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDurationValue ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "explicit recurrence interval" ;
	skos:definition "recurrence interval defined via an explicit duration" ;
	.

fibo-fnd-dt-fd:Friday
	a
		owl:NamedIndividual ,
		cmns-dt:TimeInterval
		;
	rdfs:label "Friday" ;
	skos:definition "time interval that has duration 1 day and that meets a Saturday" ;
	.

fibo-fnd-dt-fd:FromEnd
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:TimeDirection
		;
	rdfs:label "from the end" ;
	skos:definition "time direction indicating that a calendar-specified date is the nth date from the end of a calendar period" ;
	skos:example "Two days before the end of a calendar month." ;
	.

fibo-fnd-dt-fd:FromStart
	a
		owl:NamedIndividual ,
		fibo-fnd-dt-fd:TimeDirection
		;
	rdfs:label "from the start" ;
	skos:definition "time direction indicating that a calendar-specified date is the nth day from the beginning of a calendar period." ;
	skos:example "The first day of a calendar quarter. (The offsetDay is zero.)" ;
	.

fibo-fnd-dt-fd:Monday
	a
		owl:NamedIndividual ,
		cmns-dt:TimeInterval
		;
	rdfs:label "Monday" ;
	skos:definition "time interval that has duration 1 day and that meets a Tuesday" ;
	.

fibo-fnd-dt-fd:RecurrenceInterval
	a owl:Class ;
	rdfs:subClassOf cmns-dt:TimeInterval ;
	rdfs:label "recurrence interval" ;
	skos:definition "time interval that is consistent between elements of a regular schedule" ;
	cmns-av:synonym "frequency" ;
	.

fibo-fnd-dt-fd:RegularSchedule
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:Schedule ,
		cmns-col:StructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-bd:hasBusinessDayConvention ;
			owl:onClass fibo-fnd-dt-bd:BusinessDayConvention ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasAnchorDate ;
			owl:onClass fibo-fnd-dt-fd:AnchorDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasFinalStub ;
			owl:onClass fibo-fnd-dt-fd:ScheduleStub ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasInitialStub ;
			owl:onClass fibo-fnd-dt-fd:ScheduleStub ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOccurrence ;
			owl:onClass fibo-fnd-dt-oc:Occurrence ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-dt-oc:OccurrenceKind ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasCount ;
			owl:onDataRange xsd:positiveInteger ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasRecurrenceInterval ;
			owl:someValuesFrom fibo-fnd-dt-fd:RecurrenceInterval ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasStartDate ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-dt-fd:CalculatedDate
					cmns-dt:ExplicitDate
				) ;
			] ;
		]
		;
	rdfs:label "regular schedule" ;
	skos:definition "schedule whose time intervals recur regularly" ;
	skos:editorialNote "The BusinessDates ontology extends 'RegularSchedule' with an optional BusinessDayAdjustment that specifies what should happen if a scheduled date falls on a weekend or a holiday." ;
	skos:example
		"""A 30 year mortgage is payable monthly on the 10th of the month, starting July 2015. The mortgage is issued on June 15, 2015 so the first payment is for the period June 15-June 30, and the last payment is for June 1-14 2045.

The payment schedule is a RegularSchedule with these properties:

* comprises: regular payment OccurrenceKind (with payment details) (see the 'comprises' property of the Occurrences ontology)
* hasInitialStub: June 15-30, 2015 for initial payment
* hasFinalStub: June 1-14, 2045 for final payment
* hasCount: 358
* hasOverallPeriod starting Date: June 15, 2015 with a duration of 30 years
* hasRecurrenceInterval: specifies 10th day of each calendar month
* hasRecurrenceStartDate: July 1, 2015""" ,
		"""A corporate bond pays interest for 10 years starting on the first day of 2015. Interest payments are due 15 days after the expiration of each 6 month period: on July 15 and January 16.

The payment schedule is a RegularSchedule, with these properties:

* comprises: identifies the interest payment details
* overall DatePeriod starting date is '2015-01-01', ending date is '2025-01-15', and duration is 'P10Y15D'
* hasCount is 20 (2 payments per year for 10 years)
* hasRecurrenceInterval is 'P6M'
* hasRecurrenceStartDate is '2015-01-15'""" ,
		"An ISDA FpML schedule has a specified date (via a convention), and a date roll rule which is specified for the whole schedule and applies to each of the dates returned by the parametric specification of the schedule. It has: (1) a schedule beginning and end; (2) a set of regular repeating periods: the scheduled event takes place once per period; (3) optionally one or two stubs (one start and one end), which may be longer than the repeating period, or shorter. The precise parameters used are: Start of the overall Schedule period: Effective Date End of the overall Schedule period: Termination Date Start of first regular period: not specified (assume Effective Date) Length of each regular period: Frequency (a duration) There are generally three ways in which the regular periods of a parametric schedule may be expressed: first plus last first plus period length last plus period length event date plus period length. In FpML, Roll events (the date that something rolls over from the value used in one period to the value used in the next) is defined in a Roll Convention, which may be a day of the month, a day of the week, or some published set of dates, typically the ISDA quarterly dates for these events. This is therefore the date within the regular period (before adjustments) when the event occurs. This is in addition to a date for the start or end of such a period. In general this applies to the Calculation Schedule (i.e. the event is the calculation event) with other dates specified relative to this, however in principle the other related events (payment and reset or refix) are specified relative to this."
		;
	cmns-av:explanatoryNote
		"""A RegularSchedule is a Schedule defined as a set of Dates that start on a recurrence start date and repeat after each recurrence interval. The size of this set is defined by a count.

The 'initial ScheduleStub' associated with a RegularSchedule identifies any special treatment applied before the recurrence start date. Similarly, a 'final ScheduleStub' identifies any special handling at the end of the recurrences. For example, a mortgage loan that is due each calendar month may have an initial payment due before the first calendar month, or a final payment due after the last monthly payment.""" ,
		"A parametric schedule is a regular schedule for one of the events that occur in a periodic schedule of interest accruals, interest payments, and (for floating rate swapstreams), changes to the interest rate. Parametric schedules may be specified individually but more commonly, calculation events are scheduled, with other dates specified as offsets. In a regular schedule, related dates may be independently parametrically scheduled."
		;
	cmns-av:synonym "parametric schedule" ;
	cmns-av:usageNote
		"""Other ontologies can extend RegularSchedule as needed.

In particular, the Occurrences ontology extends RegularSchedule to 'comprise' an 'OccurrenceKind'. The intended meaning is that a regular schedule comprises a number of scheduled dates and an event which is scheduled to occur on each of those dates, in other words an Occurrence of the OccurrenceKind should happen on each Date defined by the RegularSchedule.""" ,
		"""The recurrence start date can be an ExplicitDate or any kind of CalculatedDate. Hence, the starting date could be relative to another Date (e.g. T+3) or triggered by the Occurrence of an OccurrenceKind, etc.

The recurrence start date can also be relative to the starting Date of the overall DatePeriod of the Schedule."""
		;
	.

fibo-fnd-dt-fd:RelativeDate
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:CalculatedDate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:isRelativeTo ;
			owl:onClass cmns-dt:Date ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasRelativeDuration ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "relative date" ;
	owl:disjointWith
		fibo-fnd-dt-fd:SpecifiedDate ,
		fibo-fnd-dt-oc:OccurrenceBasedDate
		;
	skos:definition "calculated date that is some duration before or after another date" ;
	skos:example "A settlement date, defined as T+3: three days after the trade date. The 'hasRelativeDuration' property is set to '3D'." ;
	cmns-av:explanatoryNote "When the 'hasRelativeDuration' property is negative, the RelativeDate is before the 'isRelativeTo' Date; otherwise the RelativeDate is after the 'isRelativeTo' Date." ;
	.

fibo-fnd-dt-fd:Saturday
	a
		owl:NamedIndividual ,
		cmns-dt:TimeInterval
		;
	rdfs:label "Saturday" ;
	skos:definition "time interval that has duration 1 day and that meets a Sunday" ;
	cmns-av:explanatoryNote "One Saturday is the time interval that has duration 1 day and that starts Gregorian year 2000. This requirement anchors the repeating sequence of days of week to specific Gregorian days. It requires that January 1, 2000 is a Saturday. It follows that January 2, 2000 must be the Sunday that it meets, and so on." ;
	.

fibo-fnd-dt-fd:Schedule
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Collection ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasOverallPeriod ;
			owl:someValuesFrom cmns-dt:DatePeriod ;
		]
		;
	rdfs:label "schedule" ;
	skos:definition "collection of events, observations, or other occurrences and the associated dates and/or times when they will be done" ;
	cmns-av:explanatoryNote "The overall period covers the entire DatePeriod of the Schedule, from the earliest Date to the final Date of the Schedule. Schedules may be ad hoc, essentially a list of dates and events without any consistency in the durations between events, regular, in which case there is a consistently recurring interval between events, or a combination of the two. There may be a single overall period, or more than one if the schedule is extended for some reason." ;
	.

fibo-fnd-dt-fd:ScheduleStub
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Collection ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOccurrence ;
			owl:onClass fibo-fnd-dt-oc:Occurrence ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-dt-oc:OccurrenceKind ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:onClass cmns-dt:DatePeriod ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "schedule stub" ;
	skos:definition "date period before the start of the recurring part of a schedule or after the end of the recurring part, which may be associated with a specific occurrence kind" ;
	skos:editorialNote "The Occurrences ontology extends ScheduleStub to 'comprise' an OccurrenceKind. The meaning is that a schedule stub comprises a date period and an event which is scheduled to occur during that date period; in other words that an Occurrence of the OccurrenceKind should happen during the DatePeriod of the ScheduleStub." ;
	skos:example "A 30 year mortgage calls for monthly payments on the first day of each month, according to a RegularSchedule. If the mortgage does not start on the first day of a calendar month, then an initial ScheduleStub specifies the payment due for the DatePeriod up to the first day of the next calendar month. Similarly, a final ScheduleStub specifies the last payment due for the DatePeriod after the end of the last full calendar month." ;
	.

fibo-fnd-dt-fd:SpecifiedDate
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:CalculatedDate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasDateSpecification ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "specified date" ;
	owl:disjointWith fibo-fnd-dt-oc:OccurrenceBasedDate ;
	skos:definition "calculated date that is defined by a rule that is captured as a string by the 'hasDateSpecification' property" ;
	.

fibo-fnd-dt-fd:Sunday
	a
		owl:NamedIndividual ,
		cmns-dt:TimeInterval
		;
	rdfs:label "Sunday" ;
	skos:definition "time interval that has duration 1 day and that meets a Monday" ;
	.

fibo-fnd-dt-fd:Thursday
	a
		owl:NamedIndividual ,
		cmns-dt:TimeInterval
		;
	rdfs:label "Thursday" ;
	skos:definition "time interval that has duration 1 day and that meets a Friday" ;
	.

fibo-fnd-dt-fd:TimeDirection
	a owl:Class ;
	rdfs:subClassOf cmns-dt:TemporalEntity ;
	rdfs:label "time direction" ;
	skos:definition "enumeration that indicates whether a calendar-specified date is figured from the start or the end of a calendar period" ;
	.

fibo-fnd-dt-fd:Tuesday
	a
		owl:NamedIndividual ,
		cmns-dt:TimeInterval
		;
	rdfs:label "Tuesday" ;
	skos:definition "time interval that has duration 1 day and that meets a Wednesday" ;
	.

fibo-fnd-dt-fd:Wednesday
	a
		owl:NamedIndividual ,
		cmns-dt:TimeInterval
		;
	rdfs:label "Wednesday" ;
	skos:definition "time interval that has duration 1 day and that meets a Thursday" ;
	.

fibo-fnd-dt-fd:hasAcquisitionDate
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf cmns-dt:hasObservedDateTime ;
	rdfs:label "has acquisition date" ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "links an asset or owner/controller/controllee to the date or date and time of purchase" ;
	cmns-av:usageNote "The use of custom datatypes is outside the OWL 2 RL profile and so users should consider commenting out the range restriction or change the range to rdfs:Literal in applications that are constrained to OWL 2 RL." ;
	.

fibo-fnd-dt-fd:hasAge
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDuration ;
	rdfs:label "has age" ;
	rdfs:range cmns-dt:Duration ;
	skos:definition "relates something to the length of time it has existed" ;
	.

fibo-fnd-dt-fd:hasAnchorDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has anchor date" ;
	rdfs:range fibo-fnd-dt-fd:AnchorDate ;
	skos:definition "specifies a fixed reference point within a series or timeline" ;
	skos:example "With respect to a scoped measure, such as an economic indicator, the anchor date specifies the reference date against which the value of a numeric index for a more recent date is compared (i.e., the starting point from which it stems)." ;
	.

fibo-fnd-dt-fd:hasAsOfDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has as-of date" ;
	skos:definition "relates something to the date on which it is accurate or valid (e.g. a credit report has an asOfDate that means the date when the information was drawn)" ;
	cmns-av:explanatoryNote "It is different from the creation date and need not be the last date of the DatePeriod covered." ;
	.

fibo-fnd-dt-fd:hasCalendarPeriod
	a owl:ObjectProperty ;
	rdfs:label "has calendar period" ;
	rdfs:range fibo-fnd-dt-fd:CalendarPeriod ;
	skos:definition "identifies a period of time used in computing a calendar-specified date, such as a calendar week, calendar month, calendar quarter, or calendar year" ;
	.

fibo-fnd-dt-fd:hasClosingDateTime
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dt:hasObservedDateTime ;
	rdfs:label "has closing date time"@en ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "the day and time at which something closes"@en ;
	cmns-av:usageNote "The use of custom datatypes is outside the OWL 2 RL profile and so users should consider commenting out the range restriction or change the range to rdfs:Literal in applications that are constrained to OWL 2 RL." ;
	.

fibo-fnd-dt-fd:hasCount
	a owl:DatatypeProperty ;
	rdfs:label "has count" ;
	rdfs:range xsd:positiveInteger ;
	skos:definition "specifies the total number of things in a collection, such as the number of entries in a regular schedule" ;
	.

fibo-fnd-dt-fd:hasDateAdded
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasExplicitDate ,
		cmns-dt:hasStartDate
		;
	rdfs:label "has date added" ;
	rdfs:range cmns-dt:ExplicitDate ;
	skos:definition "indicates the date something was included in something else" ;
	.

fibo-fnd-dt-fd:hasDateReceived
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has date received" ;
	skos:definition "relates something to the date it arrived or was delivered, e.g., a loan application request" ;
	.

fibo-fnd-dt-fd:hasDateSpecification
	a owl:DatatypeProperty ;
	rdfs:label "has date specification" ;
	rdfs:domain fibo-fnd-dt-fd:SpecifiedDate ;
	rdfs:range xsd:string ;
	skos:definition "rule that specifies how a specified date is computed" ;
	skos:editorialNote "The rule is modeled as a simple String because OWL2 provides no way to model the semantics of such a rule." ;
	.

fibo-fnd-dt-fd:hasFinalStub
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasStub ;
	rdfs:label "has final stub" ;
	skos:definition "identifies any special period at the end of a regular schedule" ;
	.

fibo-fnd-dt-fd:hasInitialStub
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-dt-fd:hasStub ;
	rdfs:label "has initial stub" ;
	skos:definition "identifies any special period at the start of a regular schedule" ;
	.

fibo-fnd-dt-fd:hasOpeningDateTime
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-dt:hasObservedDateTime ;
	rdfs:label "has opening date time"@en ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "the day and time at which something opens"@en ;
	cmns-av:usageNote "The use of custom datatypes is outside the OWL 2 RL profile and so users should consider commenting out the range restriction or change the range to rdfs:Literal in applications that are constrained to OWL 2 RL." ;
	.

fibo-fnd-dt-fd:hasOrdinalNumber
	a owl:DatatypeProperty ;
	rdfs:label "has ordinal number" ;
	rdfs:range xsd:integer ;
	skos:definition "specifies a number designating place in an ordered sequence, i.e., 1st, 2nd, 3rd, etc." ;
	cmns-av:explanatoryNote "Negative ordinal numbers mean 1st before, 2nd before, etc." ;
	.

fibo-fnd-dt-fd:hasOverallPeriod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
	rdfs:label "has overall period" ;
	rdfs:domain fibo-fnd-dt-fd:Schedule ;
	skos:definition "identifies a date period that includes all the dates of a schedule, including any schedule stubs" ;
	.

fibo-fnd-dt-fd:hasRecurrenceInterval
	a owl:ObjectProperty ;
	rdfs:label "has recurrence interval" ;
	rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
	skos:definition "indicates the frequency with which some event or publication occurs" ;
	.

fibo-fnd-dt-fd:hasRelativeDuration
	a owl:DatatypeProperty ;
	rdfs:label "has relative duration" ;
	rdfs:range xsd:string ;
	skos:definition "duration between two explicit dates" ;
	cmns-av:explanatoryNote
		"A relative duration may be negative." ,
		"Note that this property is distinct from hasDurationValue, as a relative duration may resolve to a relative date or date time (both of which are time points) rather than an interval, which would result in a logical inconsistency if its parent property is hasDurationValue."
		;
	.

fibo-fnd-dt-fd:hasSchedule
	a owl:ObjectProperty ;
	rdfs:label "has schedule" ;
	rdfs:range fibo-fnd-dt-fd:Schedule ;
	skos:definition "indicates a schedule for something" ;
	.

fibo-fnd-dt-fd:hasStub
	a owl:ObjectProperty ;
	rdfs:label "has stub" ;
	rdfs:domain fibo-fnd-dt-fd:RegularSchedule ;
	rdfs:range fibo-fnd-dt-fd:ScheduleStub ;
	skos:definition "links an abbreviated period at the start or end of some schedule to the overall schedule" ;
	.

fibo-fnd-dt-fd:hasTimeDirection
	a owl:ObjectProperty ;
	rdfs:label "has time direction" ;
	rdfs:range fibo-fnd-dt-fd:TimeDirection ;
	skos:definition "indicates whether a calendar-specified date is figured from the beginning or end of a calendar period" ;
	.

fibo-fnd-dt-fd:isRelativeTo
	a owl:ObjectProperty ;
	rdfs:label "is relative to" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "identifies a specific date that a relative date or relative date period references" ;
	.

fibo-fnd-dt-oc:Calculation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:onClass cmns-qtu:Expression ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasQuantityValue ;
			owl:onClass cmns-qtu:ScalarQuantityValue ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasQuantityValueRange ;
			owl:onClass cmns-qtu:ScalarQuantityValueRange ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fnd-dt-oc:CalculationEvent ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "calculation" ;
	skos:definition "actual execution of some computation, computational process, or operation that was scheduled or triggered by something" ;
	.

fibo-fnd-dt-oc:CalculationEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-oc:OccurrenceKind ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fnd-dt-oc:Calculation ;
		]
		;
	rdfs:label "calculation event" ;
	skos:definition "kind of event that is either scheduled or triggered by something, such as a related financial event, that causes a calculation to be performed" ;
	skos:note
		"A calculation event may be prescriptive, that occurs within a specified period, or ad hoc." ,
		"A calculation event related to a debt instrument might be a rate reset event, calculation of interest subsequent to a rate change, an amortization calculation, calculation of interest and/or recalculation of principal due to a late payment, etc. A calculation event related to an investment might involve the adjustment of the number of shares owned, such as a redemption or dividend related event."
		;
	.

fibo-fnd-dt-oc:Occurrence
	a owl:Class ;
	rdfs:subClassOf
		[
			a owl:Class ;
			owl:unionOf (
				[
					a owl:Restriction ;
					owl:onProperty fibo-fnd-dt-oc:hasEventDate ;
					owl:onClass cmns-dt:Date ;
					owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
				]
				[
					a owl:Restriction ;
					owl:onProperty cmns-pts:holdsDuring ;
					owl:onClass cmns-dt:DatePeriod ;
					owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
				]
				[
					a owl:Restriction ;
					owl:onProperty fibo-fnd-dt-oc:hasEventDateValue ;
					owl:onDataRange cmns-dt:CombinedDateTime ;
					owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
				]
			) ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-fnd-dt-oc:OccurrenceKind ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasLocation ;
			owl:onClass cmns-loc:Location ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fnd-dt-oc:OccurrenceKind ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "occurrence" ;
	skos:definition "happening of an OccurrenceKind, i.e., an event" ;
	cmns-av:explanatoryNote "Each occurrence has a date time stamp, which identifies when the event occurred, and, optionally, a location (possibly virtual), that identifies where the occurrence happened." ;
	cmns-av:synonym "event" ;
	cmns-av:usageNote "In order for other ontologies to accept FinancialDates without committing to the particular notions of 'Occurrence' and 'OccurrenceKind' that is modeled here, all aspects of Occurrences are captured in this ontology." ;
	.

fibo-fnd-dt-oc:OccurrenceBasedDate
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:CalculatedDate ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:isTriggeredBy ;
			owl:onClass fibo-fnd-dt-oc:OccurrenceKind ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "occurrence-based date" ;
	skos:definition "calculated date that is defined with respect to the occurrence of some occurrence kind" ;
	cmns-av:explanatoryNote "The 'hasDateValue' property of an OccurrenceBasedDate is not set until the Occurrence happens. The 'triggeredBy' property relates an OccurrenceBasedDate to the OccurrenceKind that gives the meaning of the OccurrenceBasedDate." ;
	.

fibo-fnd-dt-oc:OccurrenceKind
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fnd-dt-oc:Occurrence ;
		]
		;
	rdfs:label "occurrence kind" ;
	skos:definition "classifier that specifies the general nature of an occurrence (event)" ;
	skos:example
		"loan origination" ,
		"trade settlement"
		;
	cmns-av:explanatoryNote "As types (or categories) of events, OccurenceKinds do not happen; OccurenceKinds describe Occurrences which happen and exemplify an OccurenceKind. As occurrences are things that actually happen, they have an actual date where as OccurenceKinds do not have an actual date." ;
	cmns-av:usageNote "In order for other ontologies to accept FinancialDates without committing to the particular notions of 'Occurrence' and 'OccurrenceKind' that is modeled here, all aspects of Occurrences are captured in this ontolog" ;
	.

fibo-fnd-dt-oc:hasEventDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has event date" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "identifies a date associated with an event (occurrence)" ;
	.

fibo-fnd-dt-oc:hasEventDateValue
	a owl:DatatypeProperty ;
	rdfs:label "has event date value" ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "identifies a date or date and time value associated with an event (occurrence)" ;
	.

fibo-fnd-dt-oc:hasInput
	a owl:ObjectProperty ;
	rdfs:label "has input" ;
	owl:inverseOf fibo-fnd-dt-oc:isInputTo ;
	skos:definition "relates something (e.g. an occurrence) to something that is used as an input to some activity or process" ;
	.

fibo-fnd-dt-oc:hasOccurrence
	a owl:ObjectProperty ;
	rdfs:label "has occurrence" ;
	rdfs:range fibo-fnd-dt-oc:Occurrence ;
	skos:definition "identifies events of a given occurrence kind, typically as they occur in a schedule" ;
	.

fibo-fnd-dt-oc:hasOutput
	a owl:ObjectProperty ;
	rdfs:label "has output" ;
	owl:inverseOf fibo-fnd-dt-oc:isOutputFrom ;
	skos:definition "relates something (e.g. an occurrence) to something that is the result of some activity or process" ;
	.

fibo-fnd-dt-oc:isInputTo
	a owl:ObjectProperty ;
	rdfs:label "is input to" ;
	skos:definition "indicates a precondition, requirement, or other contribution (e.g., data) to some activity, process, system, report, analysis, etc." ;
	.

fibo-fnd-dt-oc:isOutputFrom
	a owl:ObjectProperty ;
	rdfs:label "is output from" ;
	skos:definition "indicates post condition or other product of some activity, process, system, report, analysis, etc." ;
	.

fibo-fnd-dt-oc:isTriggeredBy
	a owl:ObjectProperty ;
	rdfs:label "is triggered by" ;
	rdfs:domain fibo-fnd-dt-oc:OccurrenceBasedDate ;
	rdfs:range fibo-fnd-dt-oc:OccurrenceKind ;
	skos:definition "is activated or initiated by" ;
	cmns-av:explanatoryNote "An OccurrenceBasedDate is triggered by an Occurrence that exemplifies the OccurrenceKind." ;
	.

fibo-fnd-gao-obj:Aim
	a owl:Class ;
	rdfs:subClassOf [
		a owl:Restriction ;
		owl:onProperty fibo-fnd-gao-obj:isAddressedBy ;
		owl:onClass fibo-fnd-gao-obj:Approach ;
		owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
	] ;
	rdfs:label "aim" ;
	skos:definition "intention specifying a desired direction, condition, or situation toward which an agent's actions are directed, without requiring precise scope or measurable criteria" ;
	cmns-av:explanatoryNote "Business aims are sometimes considered broad, long-term goals, and in such cases, the term 'aim' is used interchangeably with goal. Here, however we differentiate between qualitative goals and quantitative objectives, both of which are kinds of aims, with the critical differences including measurability and time frame. Goals tend to have a much longer trajectory, provide the basis for determining objectives, and are often aligned with an organization's mission, whereas objectives are short term and measurable." ;
	.

fibo-fnd-gao-obj:Approach
	a owl:Class ;
	rdfs:subClassOf
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:addresses ;
			owl:onClass fibo-fnd-gao-obj:Aim ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-fnd-gao-obj:Objective ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "approach" ;
	skos:definition "way of addressing an aim or problem characterized by high-level planning and systematic execution, without presupposing scope or granularity" ;
	.

fibo-fnd-gao-obj:BusinessObjective
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Objective ;
	rdfs:label "business objective" ;
	skos:definition "objective that reflects the strategic goals and direction of a business within a time frame and available resources" ;
	cmns-av:explanatoryNote
		"Business objectives allow an organization to define its goals and direction. A company uses strategy and tactics at every level of its operation to achieve its objectives. These define the way a company allocates its resources and the strengths, weaknesses and opportunities it may have. Companies usually do not alter their objectives once they are implemented, unless changes in circumstances arise. Setting a clear course for the organization is key to its success." ,
		"In general, objectives are more specific and easier to measure than goals. Objectives are basic tools that underlie all planning and strategic activities. They serve as the basis for creating policy and evaluating performance. Some examples of business objectives include minimizing expenses, expanding internationally, or making a profit."
		;
	.

fibo-fnd-gao-obj:BusinessStrategy
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:Strategy ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:someValuesFrom fibo-fnd-gao-obj:BusinessObjective ;
		]
		;
	rdfs:label "business strategy" ;
	skos:definition "strategy for achieving a specific business goal, objective, solution or outcome" ;
	.

fibo-fnd-gao-obj:DistributionStrategy
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Strategy ;
	rdfs:label "distribution strategy" ;
	skos:definition "strategy for making a product or service available, or for distributing funds, such as in the form of a dividend or coupon" ;
	.

fibo-fnd-gao-obj:FinancialObjective
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Objective ;
	rdfs:label "financial objective" ;
	skos:definition "objective that reflects the strategic financial goals and direction of a party within a time frame and available resources" ;
	.

fibo-fnd-gao-obj:Goal
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Aim ;
	rdfs:label "goal" ;
	skos:definition "aim distinguished by broad scope and aspirational character, often qualitative and long-term, in order to achieve a desired state" ;
	cmns-av:explanatoryNote "Many people endeavor to reach goals within a finite time by setting deadlines." ;
	.

fibo-fnd-gao-obj:InvestmentObjective
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:FinancialObjective ;
	rdfs:label "investment objective" ;
	skos:definition "financial objective used by an investor to determine whether or not a given potential investment is appropriate for themselves or on behalf of another party" ;
	skos:example "An investor whose objective is capital growth might choose to invest in more aggressive, growth-oriented mutual funds and/or stocks, over income-generating mutual funds and/or bonds." ;
	cmns-av:explanatoryNote "The combination of investment objectives and risk tolerance are typically used to identify appropriate investment options." ;
	.

fibo-fnd-gao-obj:LocalInvestmentObjective
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:InvestmentObjective ;
	rdfs:label "local investment objective" ;
	skos:definition "financial objective that aims to support geographically centralized, community development needs" ;
	.

fibo-fnd-gao-obj:Method
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Approach ;
	rdfs:label "method" ;
	skos:definition "approach distinguished by systematic, repeatable procedures and operational specificity for doing or calculating something, consisting of defined steps or rules to achieve a result" ;
	.

fibo-fnd-gao-obj:Objective
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:Aim ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:onClass fibo-fnd-gao-obj:Goal ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:onClass cmns-dt:DatePeriod ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "objective" ;
	skos:definition "aim distinguished by specific scope and measurable criteria, often quantitative and short-term that a party seeks to attain, typically in order to achieve its long-term goals" ;
	.

fibo-fnd-gao-obj:Program
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasGoal ;
			owl:onClass fibo-fnd-gao-obj:Goal ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-fnd-gao-obj:Objective ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fnd-gao-obj:ProgramIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:hasName ;
			owl:onClass fibo-fnd-gao-obj:ProgramName ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:onClass fibo-fnd-gao-obj:Project ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:hasDescription ;
			owl:someValuesFrom xsd:string ;
		]
		;
	rdfs:label
		"program"@en-US ,
		"programme"@en-GB
		;
	skos:definition "state of affairs and coordinated set of activities designed to obtain benefits not available from managing them individually" ;
	cmns-av:adaptedFrom "https://www.prince2.com/usa/blog/project-vs-programme"^^xsd:anyURI ;
	.

fibo-fnd-gao-obj:ProgramIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtid:ContextualIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-fnd-gao-obj:Program ;
		]
		;
	rdfs:label
		"program identifier"@en-US ,
		"programme identifier"@en-GB
		;
	skos:definition "sequence of characters uniquely identifying a specific program within the context in which that program is administered" ;
	.

fibo-fnd-gao-obj:ProgramName
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtdsg:ContextualName ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isNameOf ;
			owl:someValuesFrom fibo-fnd-gao-obj:Program ;
		]
		;
	rdfs:label
		"program name"@en-US ,
		"programme name"@en-GB
		;
	skos:definition "contextual designation for a program within the context in which that program is administered" ;
	.

fibo-fnd-gao-obj:Project
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasInput ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-oc:hasOutput ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasGoal ;
			owl:onClass fibo-fnd-gao-obj:Goal ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasObjective ;
			owl:onClass fibo-fnd-gao-obj:Objective ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-fnd-gao-obj:Program ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fnd-gao-obj:ProjectIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:hasName ;
			owl:onClass fibo-fnd-gao-obj:ProjectName ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:hasDescription ;
			owl:someValuesFrom xsd:string ;
		]
		;
	rdfs:label "project" ;
	skos:definition "state of affairs and unique and temporary organization, designed to deliver a tangible output" ;
	cmns-av:adaptedFrom "https://www.prince2.com/usa/blog/project-vs-programme"^^xsd:anyURI ;
	cmns-av:explanatoryNote "A project has a fixed - generally fairly short - timeframe, and a project manager is responsible for delivering the output on time and on budget."@en ;
	.

fibo-fnd-gao-obj:ProjectIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtid:ContextualIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-fnd-gao-obj:Project ;
		]
		;
	rdfs:label "project identifier" ;
	skos:definition "sequence of characters uniquely identifying a specific project within the context in which that project or an overarching program is administered" ;
	.

fibo-fnd-gao-obj:ProjectName
	a owl:Class ;
	rdfs:subClassOf
		cmns-cxtdsg:ContextualName ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isNameOf ;
			owl:someValuesFrom fibo-fnd-gao-obj:Project ;
		]
		;
	rdfs:label "project name" ;
	skos:definition "contextual designation for a project" ;
	.

fibo-fnd-gao-obj:SalesStrategy
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:BusinessStrategy ;
	rdfs:label "sales strategy" ;
	skos:definition "strategy for selling something, including allocating resources to the sales process, reducing costs, and optimizing revenues" ;
	.

fibo-fnd-gao-obj:Strategy
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-gao-obj:Approach ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasGoal ;
			owl:onClass fibo-fnd-gao-obj:Goal ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "strategy" ;
	skos:definition "high-level approach that guides decision-making and the coordination of actions and plans in pursuit of some aim" ;
	cmns-av:explanatoryNote "A strategy is a high-level plan or approach designed to achieve a long-term goal or outcome, often by choosing among different possible methods or courses of action. A strategy may involve activities that are needed in order to achieve specific goals or objectives. It may take into account one or more policies or any number of restrictions and constraints. Strategies are typically distinguished by long-term orientation, adaptive planning, and broad scope."@en ;
	.

fibo-fnd-gao-obj:Study
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-gao-obj:hasGoal ;
			owl:onClass fibo-fnd-gao-obj:Goal ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:onClass cmns-cxtdsg:Context ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "study" ;
	skos:definition "analytical activity that investigates a specified area of interest, to determine its characteristics, relationships, constraints, or implications" ;
	cmns-av:explanatoryNote "Studies involve exploration, analysis, sometimes modeling, and sometimes evaluation, but are not necessarily focused on evaluation and may or may not be criteria-based, which distinguishes it from the concept of an assessment. In a business context, a study might map capabilities, analyze value streams, or model information flows. Only some studies produce an assessment (e.g., capability maturity assessment). A clinical research study may observe, test, or model phenomena, and may or may not result in a clinical or risk assessment. A study conducted as part of a project or larger programme may explore feasibility, options, impacts, or requirements."@en ;
	.

fibo-fnd-gao-obj:TripleBottomLineObjective
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:InvestmentObjective ;
	rdfs:label "triple bottom line objective" ;
	skos:definition "financial objective that integrates economic performance, environmental stewardship, and social responsibility as co-equal criteria for success" ;
	.

fibo-fnd-gao-obj:addresses
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:involves ;
	rdfs:label "addresses" ;
	skos:definition "deals with, handles, or gives attention to" ;
	.

fibo-fnd-gao-obj:hasGoal
	a owl:ObjectProperty ;
	rdfs:label "has goal" ;
	rdfs:range fibo-fnd-gao-obj:Goal ;
	skos:definition "has long-term, desired outcome" ;
	.

fibo-fnd-gao-obj:hasObjective
	a owl:ObjectProperty ;
	rdfs:label "has objective" ;
	rdfs:range fibo-fnd-gao-obj:Objective ;
	skos:definition "aims to achieve within a time frame and with available resources" ;
	.

fibo-fnd-gao-obj:hasStrategy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cxtdsg:uses ;
	rdfs:label "has strategy" ;
	rdfs:range fibo-fnd-gao-obj:Strategy ;
	skos:definition "applies strategy" ;
	.

fibo-fnd-gao-obj:isAddressedBy
	a owl:ObjectProperty ;
	rdfs:label "is addressed by" ;
	owl:inverseOf fibo-fnd-gao-obj:addresses ;
	skos:definition "indicates something, such a goal or objective, that is dealt with by" ;
	.

fibo-fnd-gao-obj:usesMethod
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cxtdsg:uses ;
	rdfs:label "uses method" ;
	rdfs:range fibo-fnd-gao-obj:Method ;
	skos:definition "employs method" ;
	.

fibo-fnd-law-lcap:Claim
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalConstruct ;
	rdfs:label "claim"@en ;
	skos:definition "demand or assertion made by one party on another, based on facts that, taken together, give rise to a legally enforceable right or judicial action" ;
	cmns-av:explanatoryNote "Claims arise from the existence of a formal commitment between the parties or as implicitly agreed upon through the operation of law or constitution." ;
	.

fibo-fnd-law-lcap:ContingentObligation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:Duty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-agr:isObligationOf ;
			owl:someValuesFrom fibo-fnd-agr-agr:Obligor ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:isImpliedBy ;
			owl:someValuesFrom fibo-fnd-law-lcap:ContingentRight ;
		]
		;
	rdfs:label "contingent obligation"@en ;
	skos:definition "obligation that depends on a future event or the performance of an action" ;
	.

fibo-fnd-law-lcap:ContingentRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:Right ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:implies ;
			owl:someValuesFrom fibo-fnd-law-lcap:ContingentObligation ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:isConferredOn ;
			owl:someValuesFrom cmns-pts:Party ;
		]
		;
	rdfs:label "contingent right"@en ;
	skos:definition "right that depends on a future event or the performance of an action" ;
	cmns-av:explanatoryNote "Contingent means that the interest, claim, or right is conditional, realized only when and if something occurs." ;
	.

fibo-fnd-law-lcap:ContractualCapability
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalCapacity ;
	rdfs:label "contractual capability"@en ;
	skos:definition "the capacity to enter into legally binding contracts" ;
	skos:editorialNote "This is the capacity which defines Contractually Capable Entity (sometimes labeled as 'Legal Entity') as distinct from 'Legal Person'. In the latter case the liabilities incurred in the contract accrue also to the Legal Person. In the case of contractual capability, the entity has the authority to enter into contracts, whether or not the liabilities accrue to that same entity (which they do if it is also a Legal Person). For Legal Entities which are not Legal Persons, the liability unwinds to some legal person within the structure of the entity, for example a General Partner or a Trustee." ;
	.

fibo-fnd-law-lcap:ContractualInterest
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:ContractualRight ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:hasFractionalInterest ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		]
		;
	rdfs:label "contractual interest" ;
	skos:definition "legally enforceable benefit or entitlement arising from a contract, agreement, or instrument, in which an entity holds specified rights or obligations related to the performance, use, or benefit of something, without necessarily holding ownership" ;
	cmns-av:explanatoryNote
		"Contractual interest may include rights to income, access, use, or participation, and is governed by the terms and conditions of the underlying contract. It may be transferable or limited, and can coexist with or be independent of ownership rights." ,
		"Contractual interests differ from ownership interests in terms of (1) the source of rights, which are specified in an agreement or contract in the case of contractual interests, and in terms of title or equity with respect to ownership, (2) control, which is typically limited at best in the case of contractual interest, and (3) transferability, which depends on the terms of the contract. Examples of contractual interest include fund units, leaseholds, annuities, and rights to certain services, whereas shares, real estate, and assets of a trust reflect ownership interest."
		;
	.

fibo-fnd-law-lcap:ContractualObligation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:LegalObligation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:isImpliedBy ;
			owl:allValuesFrom fibo-fnd-law-lcap:ContractualRight ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		]
		;
	rdfs:label "contractual obligation" ;
	skos:definition "legally binding obligation that arises from the terms of a contract" ;
	cmns-av:explanatoryNote "Contractual obligations require a party to perform or refrain from performing specific actions, and failure to meet an obligation can result in legal consequences." ;
	.

fibo-fnd-law-lcap:ContractualOption
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:ContractualRight ;
	rdfs:label "contractual option" ;
	skos:definition "contractual right that may be exercised at some point in the future, such as an option to extend a contract, or other available but not obligatory rights as defined in the contract" ;
	.

fibo-fnd-law-lcap:ContractualRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:Right ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:implies ;
			owl:someValuesFrom fibo-fnd-law-lcap:ContractualObligation ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		]
		;
	rdfs:label "contractual right" ;
	skos:definition "legally enforceable benefit or entitlement granted to a party within a binding agreement" ;
	cmns-av:explanatoryNote "Contractual rights are established by the terms of a contract, which can be explicit (written) or implied by law, industry standards, or consistent practices." ;
	.

fibo-fnd-law-lcap:DelegatedLegalAuthority
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalCapacity ;
	rdfs:label "delegated legal authority" ;
	skos:definition "institutionalized and legal power inherent in a particular job, function, or position that is meant to enable its holder to successfully carry out his or her responsibilities, where such power has been delegated through some formal means" ;
	skos:scopeNote "This specifically means the authority to make legally binding commitments." ;
	cmns-av:explanatoryNote "This is always accompanied by an equal responsibility for one's actions or a failure to act." ;
	.

fibo-fnd-law-lcap:DeliveryObligation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:ContingentObligation ,
		fibo-fnd-law-lcap:LegalObligation
		;
	rdfs:label "delivery obligation"@en ;
	skos:definition "obligation to deliver something in order to satisfy a claim or debt"@en ;
	cmns-av:explanatoryNote "A delivery obligation is the responsibility of one party to deliver goods, services, instruments, money, or other specified items to another party, typically as outlined in an agreement. Failure to do so may result in breach of contract if the obligation is specified as such, which may have further legal ramifications."@en ;
	.

fibo-fnd-law-lcap:Duty
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalConstruct ;
	rdfs:label "duty" ;
	skos:definition "some obligation which exists and is imposed on some individual" ;
	skos:editorialNote "This can also be thought of as an obligation - not in the sense in which an obligation and a right are the converse aspects of one another, but in and of itself, independent of the perspective from which it is considered. Examples include statutory obligations, reporting obligations and so on." ;
	.

fibo-fnd-law-lcap:LegalCapacity
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalConstruct ;
	rdfs:label "legal capacity" ;
	skos:definition "the capability to carry out certain actions or to have certain rights together with the resources to do so" ;
	.

fibo-fnd-law-lcap:LegalConstruct
	a owl:Class ;
	rdfs:subClassOf
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:isConferredOn ;
			owl:onClass cmns-pts:Party ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:onClass [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-agr-ctr:Contract
					fibo-fnd-law-cor:Constitution
					fibo-fnd-law-cor:Law
				) ;
			] ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "legal construct" ;
	skos:definition "something which is conferred by way of law or contract, such as a right" ;
	skos:editorialNote "Obligations are an aspect of this category of thing, as are rights." ;
	.

fibo-fnd-law-lcap:LegalObligation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:Duty ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-agr-ctr:Contract
					fibo-fnd-law-lcap:Regulation
					fibo-fnd-law-cor:StatuteLaw
				) ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isMandatedBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-agr-ctr:Contract
					fibo-fnd-law-lcap:Regulation
					fibo-fnd-law-cor:StatuteLaw
				) ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "legal obligation" ;
	skos:definition "an obligation or duty that is enforceable by a court" ;
	.

fibo-fnd-law-lcap:LegalRight
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:Right ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:implies ;
			owl:someValuesFrom fibo-fnd-law-lcap:LegalObligation ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:someValuesFrom fibo-fnd-law-cor:StatuteLaw ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "legal right" ;
	skos:definition "personal right, privilege, or benefit that a government, contract, or law provides or protects, making an individual or entity eligible to receive something" ;
	cmns-av:explanatoryNote
		"A legal right, if challenged, may be supported in court as recognizable and enforceable in law, statutes, regulations, or other legislative actions." ,
		"This entitlement creates a corresponding obligation for the provider to deliver that benefit."
		;
	.

fibo-fnd-law-lcap:LiabilityCapacity
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalCapacity ;
	rdfs:label "liability capacity"@en ;
	skos:definition "the ability to be sued at law" ;
	skos:editorialNote "Note that for the purposes of this model, this is distinct from culpability (the ability to commit criminal acts). That would be a separate and analogous term but with grounding in criminal rather than civil law." ;
	.

fibo-fnd-law-lcap:License
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:LegalDocument ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:holdsDuring ;
			owl:onClass cmns-dt:DatePeriod ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:confers ;
			owl:someValuesFrom fibo-fnd-law-lcap:LegalCapacity ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom fibo-fnd-law-lcap:Licensor ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-fnd-law-lcap:Licensee ;
		]
		;
	rdfs:label "license" ;
	skos:definition "grant of permission needed to do something" ;
	cmns-av:adaptedFrom "Barron's Dictionary of Business and Economics Terms, Fifth Edition, 2012" ;
	cmns-av:explanatoryNote "Note that in some cases, a license may also be considered an agreement or contract, depending on the specifics of the license and jurisdiction." ;
	.

fibo-fnd-law-lcap:LicenseIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-law-lcap:License ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "license identifier" ;
	skos:definition "an identifier associated with a license" ;
	.

fibo-fnd-law-lcap:Licensee
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fnd-law-lcap:License ;
			] ;
		]
		;
	rdfs:label "licensee" ;
	skos:definition "a party to whom a license has been granted" ;
	cmns-av:adaptedFrom "Barron's Dictionary of Business and Economics Terms, Fifth Edition, 2012" ;
	.

fibo-fnd-law-lcap:Licensor
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:licenses ;
			owl:someValuesFrom owl:Thing ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:issues ;
			owl:someValuesFrom fibo-fnd-law-lcap:License ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fnd-law-lcap:License ;
			] ;
		]
		;
	rdfs:label "licensor" ;
	skos:definition "a party who grants a license" ;
	cmns-av:adaptedFrom "Barron's Dictionary of Business and Economics Terms, Fifth Edition, 2012" ;
	.

fibo-fnd-law-lcap:LitigationCapacity
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalCapacity ;
	rdfs:label "litigation capacity" ;
	skos:definition "the legal capacity to pursue a litigation action in law" ;
	.

fibo-fnd-law-lcap:NotificationObligation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:ContingentObligation ,
		fibo-fnd-law-lcap:LegalObligation
		;
	rdfs:label "notification obligation"@en ;
	skos:definition "requirement for one party to formally inform another party (or parties) about specific events, actions, or changes as outlined in the agreement"@en ;
	cmns-av:explanatoryNote "Common triggering events include breaches, changes in circumstances, delays, or other kinds of events that may have a material impact on the agreement."@en ;
	.

fibo-fnd-law-lcap:Policy
	a owl:Class ;
	rdfs:subClassOf
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:implements ;
			owl:onClass [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-gao-obj:Aim
					fibo-fnd-law-lcap:LegalConstruct
				) ;
			] ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:governs ;
			owl:someValuesFrom fibo-fnd-gao-obj:Strategy ;
		]
		;
	rdfs:label "policy" ;
	skos:definition "system of principles, rules and guidelines, adopted by an organization to guide decision making with respect to particular situations and implemented via procedures or protocols to achieve stated goals" ;
	.

fibo-fnd-law-lcap:Regulation
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:LegalConstruct ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:onClass cmns-rga:RegulatoryAgency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
			owl:someValuesFrom fibo-fnd-law-cor:Law ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "regulation" ;
	skos:definition "a rule used to carry out a law" ;
	cmns-av:explanatoryNote "Many government agencies issue regulations to administer laws." ;
	.

fibo-fnd-law-lcap:ReportingPolicy
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:Policy ;
	rdfs:label "reporting policy" ;
	skos:definition "policy specifying principles, rules and/or guidelines regarding some aspect of reporting" ;
	skos:example "For example a policy for how frequently a given kind of report is produced." ;
	.

fibo-fnd-law-lcap:Right
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalConstruct ;
	rdfs:label "right" ;
	rdfs:seeAlso <https://plato.stanford.edu/entries/rights/> ;
	skos:definition "entitlement to perform certain actions (or not), or to be in certain states (or not); or entitlement that requires others to perform certain actions or be in certain states (or not)" ;
	skos:example "Examples include contractual rights, legal rights, human rights, political rights, and so forth." ;
	cmns-av:explanatoryNote "Rights dominate modern understandings of what actions are permissible and which institutions are just. Rights structure the form of governments, the content of laws, and the shape of morality as many now see it. To accept a set of rights is to approve a distribution of freedom and authority, and so to endorse a certain view of what may, must, and must not be done. According to the Hohfeldian incidents (Wesley Hohfeld (1879-1918)), rights are complex and consist of four major components: privilege, claim, power, and immunity." ;
	.

fibo-fnd-law-lcap:SignatoryCapacity
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalCapacity ;
	rdfs:label "signatory capacity" ;
	skos:definition "the capacity of some natural person to sign agreements on the part of some organization or legal person" ;
	.

fibo-fnd-law-lcap:hasCapacity
	a owl:ObjectProperty ;
	rdfs:label "has capacity" ;
	rdfs:domain cmns-pts:Party ;
	rdfs:range fibo-fnd-law-lcap:LegalCapacity ;
	owl:inverseOf fibo-fnd-law-lcap:isCapacityOf ;
	skos:definition "identifies an individual or organization that has some ability and availability to carry out certain actions, or has certain rights or obligations" ;
	.

fibo-fnd-law-lcap:hasFractionalInterest
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has fractional interest" ;
	rdfs:range xsd:decimal ;
	skos:definition "has proportionate, non-exclusive entitlement to" ;
	cmns-av:explanatoryNote "Fractional interest may be expressed as a percentage, ratio, or unit count, and typically arises in contexts where multiple parties share contractual claims to income, usage, ownership, or participation. It does not imply full control or sole ownership, and may be subject to limitations specified in the underlying legal framework." ;
	.

fibo-fnd-law-lcap:implements
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:involves ;
	rdfs:label "implements" ;
	skos:definition "carries out or puts into effect, fulfills" ;
	.

fibo-fnd-law-lcap:implies
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:involves ;
	rdfs:label "implies" ;
	skos:definition "strongly suggests or involves as a logical consequence based on some set of observations, facts, or events" ;
	.

fibo-fnd-law-lcap:isCapacityOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-law-lcap:isConferredOn ;
	rdfs:label "is capacity of" ;
	rdfs:domain fibo-fnd-law-lcap:LegalCapacity ;
	rdfs:range cmns-pts:Party ;
	skos:definition "identifies an individual or organization on which a given legal capacity has been conferred" ;
	skos:scopeNote "This includes capacities specific to duties at law (such as those for corporate officers) as well as the ability or capacity to incur liability." ;
	.

fibo-fnd-law-lcap:isConferredOn
	a owl:ObjectProperty ;
	rdfs:label "is conferred on" ;
	rdfs:range cmns-pts:Party ;
	skos:definition "indicates a party to which some benefit or right has been granted" ;
	.

fibo-fnd-law-lcap:isImplementedBy
	a owl:ObjectProperty ;
	rdfs:label "is implemented by" ;
	owl:inverseOf fibo-fnd-law-lcap:implements ;
	skos:definition "indicates something that is carried out, incorporated or put into effect by" ;
	skos:example "A regulation may be implemented by or more corporate policies. Such policies, in turn, may be implemented via various systems, executed by humans and/or automation, that can be audited for compliance purposes." ;
	.

fibo-fnd-law-lcap:isImpliedBy
	a owl:ObjectProperty ;
	rdfs:label "is implied by" ;
	owl:inverseOf fibo-fnd-law-lcap:implies ;
	skos:definition "indicates something that is strongly suggested by something else, such as a logical consequence based on some set of observations, facts, or events" ;
	.

fibo-fnd-law-lcap:isLicensedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-rga:isGovernedBy ;
	rdfs:label "is licensed by" ;
	rdfs:range cmns-pts:PartyRole ;
	owl:inverseOf fibo-fnd-law-lcap:licenses ;
	skos:definition "indicates the party that has issued a particular license to some other party" ;
	.

fibo-fnd-law-lcap:isPredicatedOn
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-doc:isSpecifiedIn ,
		cmns-doc:refersTo
		;
	rdfs:label "is predicated on"@en ;
	rdfs:domain fibo-fnd-agr-ctr:ConditionPrecedent ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			fibo-fnd-agr-ctr:ContractualCommitment
			fibo-fnd-law-lcap:ContractualObligation
		) ;
	] ;
	skos:definition "depends on an assumption or requirement stated in" ;
	.

fibo-fnd-law-lcap:licenses
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-rga:governs ;
	rdfs:label "licenses" ;
	rdfs:domain cmns-pts:PartyRole ;
	skos:definition "issues a license required in order to perform some task, provide some service, exercise some privilege, or pursue some line of business or occupation to some party" ;
	.

fibo-fnd-law-cor:Constitution
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Collection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:governs ;
			owl:someValuesFrom fibo-fnd-law-cor:Law ;
		]
		;
	rdfs:label "constitution" ;
	skos:definition "set of basic principles by which an organization is governed, especially in relation to the rights of the people it governs" ;
	cmns-av:explanatoryNote "A constitution is an aggregate of fundamental principles or established precedents that constitute the legal basis of a polity, organisation or other type of entity and commonly determine how that entity is to be governed." ;
	.

fibo-fnd-law-cor:CourtOfLaw
	a owl:Class ;
	rdfs:subClassOf cmns-org:FormalOrganization ;
	rdfs:label "court of law" ;
	skos:definition "person or body of persons having judicial authority to hear and resolve disputes on the basis of statutes or the common law" ;
	cmns-av:explanatoryNote "A court of law is a formal forum of justice that may have authority over civil, criminal, ecclesiastical, or military cases." ;
	.

fibo-fnd-law-cor:Law
	a owl:Class ;
	rdfs:label "law" ;
	skos:definition "rule recognized by some community as regulating the behavior of its members and that it may enforce through the imposition of penalties" ;
	cmns-av:explanatoryNote "Law is a term which does not have a universally accepted definition. Certain laws are made by governments, specifically by their legislatures although the sense intended here is broader. The formation of laws themselves may be influenced by a constitution (written or unwritten) and the rights encoded therein. The law shapes politics, economics and society in countless ways and serves as a social mediator of relations between people." ;
	.

fibo-fnd-law-cor:StatuteLaw
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-cor:Law ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-cor:isInForceIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "statute law"@en ;
	skos:altLabel "statutory law" ;
	skos:definition "law enacted by a legislature" ;
	cmns-av:adaptedFrom "https://www.law.cornell.edu/wex/statute"^^xsd:anyURI ;
	cmns-av:explanatoryNote
		"In the United States, statutes may also be called acts, such as the Civil Rights Act of 1964 or the Sarbanes-Oxley Act. Federal laws must be passed by both houses of Congress, the House of Representative and the Senate, and then usually require approval from the president before they can take effect." ,
		"Statutes may originate with national, state legislatures or local municipalities. Statutory laws are subordinate to the higher constitutional laws of the land."
		;
	.

fibo-fnd-law-cor:hasInForce
	a owl:ObjectProperty ;
	rdfs:label "has in force" ;
	rdfs:range fibo-fnd-law-cor:Law ;
	owl:inverseOf fibo-fnd-law-cor:isInForceIn ;
	skos:definition 'relates a jurisdiction or situation to a rule, regulation or law (collectively "law") that is currently in force in that situation or jurisdiction' ;
	.

fibo-fnd-law-cor:isInForceIn
	a owl:ObjectProperty ;
	rdfs:label "is in force in" ;
	rdfs:domain fibo-fnd-law-cor:Law ;
	skos:definition "identifies a jurisdiction in which some law has effect" ;
	.

fibo-fnd-org-fm:Employee
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:OrganizationMember ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-org-fm:isEmployedIn ;
			owl:someValuesFrom fibo-fnd-org-fm:Employment ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-org-fm:isEmployeeOf ;
			owl:someValuesFrom fibo-fnd-org-fm:Employer ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom fibo-fnd-aap-ppl:Person ;
		]
		;
	rdfs:label "employee" ;
	rdfs:seeAlso <https://www.bls.gov/opub/mlr/2002/01/art1full.pdf> ;
	skos:definition "person in the service of another under any contract of hire, express or implied, oral or written, where the employer has the right to control and direct that person in the material details of how the work is to be performed" ;
	.

fibo-fnd-org-fm:Employer
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:MemberBearingOrganization ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-org-fm:hasEmployee ;
			owl:someValuesFrom fibo-fnd-org-fm:Employee ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-org-fm:isEmployingParty ;
			owl:someValuesFrom fibo-fnd-org-fm:Employment ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom cmns-org:LegalPerson ;
		]
		;
	rdfs:label "employer" ;
	skos:definition "party that provides compensation, including wages or a salary and potentially other benefits, in exchange for work performed by one or more people, and that has the right to control and direct the employee in the material details of how the work is to be performed" ;
	.

fibo-fnd-org-fm:Employment
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:Membership ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-org-fm:hasEmployedParty ;
			owl:someValuesFrom fibo-fnd-org-fm:Employee ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-org-fm:hasEmployingParty ;
			owl:someValuesFrom fibo-fnd-org-fm:Employer ;
		]
		;
	rdfs:label "employment"@en ;
	skos:definition "situation representing the state of being employed, i.e., the relationship that holds between an employer and employee for some period of time" ;
	skos:scopeNote "This definition does not include workers in contingent arrangements, such as independent contractors, leased employees, temporary employees, on-call workers, and others that do not have a direct contractual relationship with the employer. The distinction is important for legal reasons, particularly for regulatory reporting with respect to responsible parties such as corporate officers, lending officers, others authorized or licensed to perform certain tasks, and traders, for example." ;
	cmns-av:explanatoryNote "In the broadest sense, employment is the situation in which someone is fully engaged in doing something that they want to do. From a FIBO perspective, however, employment is understood to be more specific. It is the relationship between two parties, evidenced by an implicit or explicit contract, in which work is compensated and in which one party, a legal person, typically a formal organization, acts as the employer and the other, typically a legally capable natural person, as the employee." ;
	.

fibo-fnd-org-fm:Group
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Collection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:allValuesFrom cmns-pts:Agent ;
		]
		;
	rdfs:label "group" ;
	skos:definition "collection of agents (people, organizations, software agents, etc.) that are considered as a unit" ;
	.

fibo-fnd-org-fm:employs
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:playsActiveRoleThatDirectlyAffects ;
	rdfs:label "employs" ;
	rdfs:domain cmns-org:LegalPerson ;
	rdfs:range fibo-fnd-aap-ppl:Person ;
	skos:definition "indicates someone that is employed by the legal person" ;
	.

fibo-fnd-org-fm:hasEmployedParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:hasOrganizationMember ;
	rdfs:label "has employed party" ;
	rdfs:domain fibo-fnd-org-fm:Employment ;
	rdfs:range fibo-fnd-org-fm:Employee ;
	owl:inverseOf fibo-fnd-org-fm:isEmployedIn ;
	skos:definition "identifies the employee in an employment situation" ;
	.

fibo-fnd-org-fm:hasEmployee
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsOn ;
	rdfs:label "has employee" ;
	rdfs:domain fibo-fnd-org-fm:Employer ;
	rdfs:range fibo-fnd-org-fm:Employee ;
	owl:inverseOf fibo-fnd-org-fm:isEmployeeOf ;
	skos:definition "indicates an employee that is employed by the employer" ;
	.

fibo-fnd-org-fm:hasEmployingParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:hasMembership ;
	rdfs:label "has employing party" ;
	rdfs:domain fibo-fnd-org-fm:Employment ;
	rdfs:range fibo-fnd-org-fm:Employer ;
	owl:inverseOf fibo-fnd-org-fm:isEmployingParty ;
	skos:definition "identifies employer in an employment situation" ;
	.

fibo-fnd-org-fm:isEmployedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:experiencesDirectly ;
	rdfs:label "is employed by" ;
	rdfs:domain fibo-fnd-aap-ppl:Person ;
	rdfs:range cmns-org:LegalPerson ;
	skos:definition "indicates the party (legal person or formal organization) that employs someone" ;
	.

fibo-fnd-org-fm:isEmployedIn
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:isOrganizationMember ;
	rdfs:label "is employed in" ;
	rdfs:domain fibo-fnd-org-fm:Employee ;
	rdfs:range fibo-fnd-org-fm:Employment ;
	skos:definition "indicates the context of employment in which someone is employed" ;
	.

fibo-fnd-org-fm:isEmployeeOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "is employee of" ;
	rdfs:domain fibo-fnd-org-fm:Employee ;
	rdfs:range fibo-fnd-org-fm:Employer ;
	skos:definition "identifies the formal organization for which the employee works" ;
	.

fibo-fnd-org-fm:isEmployingParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-org:isMembershipPartyIn ;
	rdfs:label "is employing party" ;
	rdfs:domain fibo-fnd-org-fm:Employer ;
	rdfs:range fibo-fnd-org-fm:Employment ;
	skos:definition "relates a party in the role of employer to the context of employment" ;
	.

fibo-fnd-oac-ctl:Control
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:hasPartyInControl ;
			owl:someValuesFrom fibo-fnd-oac-ctl:ControllingParty ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:involvesControlledThing ;
			owl:someValuesFrom fibo-fnd-oac-ctl:ControlledThing ;
		]
		;
	rdfs:label "control" ;
	skos:definition "situation in which some party has the power to direct or strongly influence the direction of the management and policies related to something" ;
	cmns-av:explanatoryNote "Control may be direct (explicit) or indirect (implicit), derived through ownership of voting shares, beneficial ownership, other ownership relations, through provisions of a contract, or otherwise." ;
	.

fibo-fnd-oac-ctl:ControlledThing
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Undergoer ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isInitiallyControlledOn ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:hasControllingParty ;
			owl:someValuesFrom fibo-fnd-oac-ctl:ControllingParty ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControlledThingIn ;
			owl:someValuesFrom fibo-fnd-oac-ctl:Control ;
		]
		;
	rdfs:label "controlled thing" ;
	skos:definition "something over which some party exercises some form of control with respect to some situation" ;
	.

fibo-fnd-oac-ctl:ControllingParty
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Actor ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ;
			owl:someValuesFrom fibo-fnd-oac-ctl:Control ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-ctl:isPartyControlling ;
			owl:someValuesFrom fibo-fnd-oac-ctl:ControlledThing ;
		]
		;
	rdfs:label "controlling party" ;
	skos:definition "actor that exercises some form of control in the context of some situation" ;
	skos:editorialNote "At this level of abstraction it is not defined whether the control is some degree of controlling interest, or some level of actual control (asserted or calculated) in some entity." ;
	.

fibo-fnd-oac-ctl:DeFactoControl
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-ctl:Control ;
	rdfs:label "de facto control" ;
	owl:disjointWith fibo-fnd-oac-ctl:DeJureControl ;
	skos:definition "control that exists informally and is accepted, although not formally recognized" ;
	cmns-av:explanatoryNote "For example, de facto acquisition or change of control means the acquisition, directly or indirectly, by any person or group of persons acting jointly or in concert, of beneficial ownership of, or control or direction over, sufficient voting shares of some legal entity to permit such person or persons to exercise, or to control or direct the voting of, 50 percent or more of the total number of votes in that entity." ;
	.

fibo-fnd-oac-ctl:DeJureControl
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:LegalConstruct ,
		fibo-fnd-oac-ctl:Control
		;
	rdfs:label "de jure control" ;
	skos:definition "control that exists as a matter of law, i.e., legitimate, legal control of something" ;
	.

fibo-fnd-oac-ctl:hasControllingParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "has controlling party" ;
	rdfs:domain fibo-fnd-oac-ctl:ControlledThing ;
	rdfs:range fibo-fnd-oac-ctl:ControllingParty ;
	skos:definition "indicates the party that exercises authority or influence over something" ;
	.

fibo-fnd-oac-ctl:hasPartyInControl
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasActor ;
	rdfs:label "has party in control" ;
	rdfs:domain fibo-fnd-oac-ctl:Control ;
	rdfs:range fibo-fnd-oac-ctl:ControllingParty ;
	skos:definition "indicates the actor in the context of a control situation" ;
	.

fibo-fnd-oac-ctl:involvesControlledThing
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasUndergoer ;
	rdfs:label "involves controlled thing" ;
	rdfs:domain fibo-fnd-oac-ctl:Control ;
	rdfs:range fibo-fnd-oac-ctl:ControlledThing ;
	skos:definition "indicates something controlled in the context of a control situation" ;
	.

fibo-fnd-oac-ctl:isControlledPartyOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isDirectlyAffectedBy ;
	rdfs:label "is controlled party of" ;
	rdfs:range fibo-fnd-oac-ctl:ControllingParty ;
	skos:definition "indicates a controlling party that has some amount of authority or influence over it" ;
	.

fibo-fnd-oac-ctl:isControlledThingIn
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:undergoes ;
	rdfs:label "is controlled thing in" ;
	rdfs:domain fibo-fnd-oac-ctl:ControlledThing ;
	rdfs:range fibo-fnd-oac-ctl:Control ;
	owl:inverseOf fibo-fnd-oac-ctl:involvesControlledThing ;
	skos:definition "indicates the context of control in which something is being controlled" ;
	.

fibo-fnd-oac-ctl:isControllingPartyIn
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsIn ;
	rdfs:label "is controlling party in" ;
	rdfs:domain fibo-fnd-oac-ctl:ControllingParty ;
	rdfs:range fibo-fnd-oac-ctl:Control ;
	owl:inverseOf fibo-fnd-oac-ctl:hasPartyInControl ;
	skos:definition "indicates the context of control in which the party plays the role of controlling something" ;
	.

fibo-fnd-oac-ctl:isControllingPartyOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:directlyAffects ;
	rdfs:label "is controlling party of" ;
	rdfs:domain fibo-fnd-oac-ctl:ControllingParty ;
	skos:definition "indicates something that a controlling party has some amount of authority or influence over" ;
	.

fibo-fnd-oac-ctl:isInitiallyControlledOn
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf cmns-dt:hasObservedDateTime ;
	rdfs:label "is initially controlled on" ;
	rdfs:range cmns-dt:CombinedDateTime ;
	skos:definition "indicates the date or date and time that some level of authority or influence was first put in place" ;
	.

fibo-fnd-oac-ctl:isPartyControlling
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsOn ;
	rdfs:label "is party controlling" ;
	rdfs:domain fibo-fnd-oac-ctl:ControllingParty ;
	rdfs:range fibo-fnd-oac-ctl:ControlledThing ;
	owl:inverseOf fibo-fnd-oac-ctl:hasControllingParty ;
	skos:definition "indicates something controlled that a controlling party has some amount of authority or influence over" ;
	.

fibo-fnd-oac-own:Asset
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Undergoer ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:hasAcquisitionPrice ;
			owl:onClass fibo-fnd-acc-cur:Price ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-dt-fd:hasAcquisitionDate ;
			owl:onDataRange cmns-dt:CombinedDateTime ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:isAssetOf ;
			owl:someValuesFrom fibo-fnd-oac-own:Owner ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:isOwnedAsset ;
			owl:someValuesFrom fibo-fnd-oac-own:Ownership ;
		]
		;
	rdfs:label "asset" ;
	skos:definition "something of monetary value that is owned or provides benefit to some party" ;
	cmns-av:adaptedFrom "Financial Accounting Standards Board (FASB) Statement of Financial Accounting Concepts No. 6, Elements of Financial Statements, paragraph 25." ;
	cmns-av:explanatoryNote "An asset is something that provides probable future economic benefit obtained or controlled by some party as a result of past transactions or events. An asset has three essential characteristics: (a) it embodies a probable future benefit that involves a capacity, singly or in combination with other assets, to contribute directly or indirectly to future net cash inflows, (b) a party can obtain the benefit and control others' access to it, and (c) the transaction or other event giving rise to the party's right to or control of the benefit has already occurred." ;
	cmns-av:synonym "economic resource" ;
	.

fibo-fnd-oac-own:CapitalSurplus
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:PaidInCapital ;
	rdfs:label "capital surplus" ;
	skos:definition "capital contributed in excess of the par value (stated value) of the ownership interest issued" ;
	.

fibo-fnd-oac-own:EarningsBeforeInterestTaxesDepreciationAmortization
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:onClass cmns-org:FormalOrganization ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "earnings before interest, taxes, depreciation and amortization" ;
	skos:definition "measure of potential cash flow that excludes the effects of capital structure, taxes and non-cash expenses" ;
	cmns-av:abbreviation "EBITDA" ;
	cmns-av:explanatoryNote
		"By stripping out the non-cash depreciation and amortization expense as well as taxes and debt costs dependent on the capital structure, EBITDA attempts to represent cash profit generated by the company's operations. EBITDA is not a metric recognized under Generally Accepted Accounting Principles (GAAP). Some public companies report EBITDA in their quarterly results along with adjusted EBITDA figures typically excluding additional costs, such as stock-based compensation." ,
		"EBITDA is often used as a proxy for cash flow, as it shows how much cash a company can generate from its core operations. However, EBITDA has some limitations, such as ignoring the cost of maintaining and replacing capital assets, and being susceptible to manipulation by excluding certain expenses."
		;
	.

fibo-fnd-oac-own:FinancialAsset
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:TangibleAsset ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:hasAcquisitionPrice ;
			owl:allValuesFrom fibo-fnd-acc-cur:MonetaryPrice ;
		]
		;
	rdfs:label "financial asset" ;
	owl:disjointWith fibo-fnd-oac-own:PhysicalAsset ;
	skos:definition "non-physical, tangible asset whose value is derived from a contractual claim, such as bank deposits, bonds, stocks, rights, certificates, and bank balances" ;
	cmns-av:explanatoryNote "Financial assets are typically more liquid than other tangible assets, such as commodities or real estate. Financial assets may not cover all assets that might be included on a balance sheet, and do not include tangible, physical assets or intangible assets such as intellectual property." ;
	.

fibo-fnd-oac-own:Holding
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Asset ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-law-lcap:hasFractionalInterest ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:decimal ;
		]
		;
	rdfs:label "holding" ;
	skos:definition "owned financial interest consisting of legal or beneficial ownership of an asset or security that confers economic rights on its owner" ;
	cmns-av:explanatoryNote "Note that there is no common, broadly accepted definition of the term holding across regulators, either within a single country such as the US, or across national jurisdictions. Typically, a holding may refer to a single asset, such as a piece of real estate, a portfolio of assets, multiple portfolios, and so forth, and may be aggregated over multiple assets." ;
	.

fibo-fnd-oac-own:Income
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:MonetaryAmount ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:hasDatePeriod ;
			owl:onClass cmns-dt:DatePeriod ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "income"@en ;
	skos:definition "revenue received during a period of time" ;
	cmns-av:explanatoryNote "Income includes cash or cash equivalent(s) received during some period of time in exchange for labor or services, from the sale of goods or property, or as receipts from financial investments." ;
	.

fibo-fnd-oac-own:IntangibleAsset
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:Asset ;
	rdfs:label "intangible asset" ;
	owl:disjointWith fibo-fnd-oac-own:TangibleAsset ;
	skos:definition "identifiable, non-monetary asset that lacks physical substance" ;
	skos:example "Intangible assets may include intellectual property, patents, copyrights, trademarks, rights-of-way (easements), brands, organizational abilities (know-how), and data." ;
	cmns-av:explanatoryNote "Intangible assets include assets that may involve a legal claim to some future benefit, typically a claim to future cash. Intangible assets have become an increasingly larger component of the valuation for all companies, from newer social media companies to even the most established and iconic manufacturers." ;
	.

fibo-fnd-oac-own:Owner
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Actor ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:isOwningParty ;
			owl:someValuesFrom fibo-fnd-oac-own:Ownership ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:ownsAsset ;
			owl:someValuesFrom fibo-fnd-oac-own:Asset ;
		]
		;
	rdfs:label "owner" ;
	skos:definition "party that is legally recognized as having the right to possess, the privilege to use, and ability to transfer any rights or privileges associated with something, as permitted by law" ;
	.

fibo-fnd-oac-own:OwnersEquity
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:Expression ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:onClass cmns-org:FormalOrganization ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fnd-oac-own:PaidInCapital ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasArgument ;
			owl:someValuesFrom fibo-fnd-oac-own:RetainedEarnings ;
		]
		;
	rdfs:label "owners' equity"@en ;
	skos:definition "owners' share in a business plus operating profit" ;
	cmns-av:adaptedFrom "Barron's Dictionary of Banking Terms, Sixth Edition, 2012." ;
	cmns-av:explanatoryNote "Owner's equity is represented by capital investments and accumulated earnings less any dividends or other financial obligations. It is typically used to talk about equity in a business, but may also refer to the net assets of a pool or special purpose vehicle." ;
	cmns-av:synonym
		"capital"@en ,
		"contributed capital"@en ,
		"equity" ,
		"net worth"
		;
	.

fibo-fnd-oac-own:Ownership
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:hasOwnedAsset ;
			owl:someValuesFrom fibo-fnd-oac-own:Asset ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:hasOwningParty ;
			owl:someValuesFrom fibo-fnd-oac-own:Owner ;
		]
		;
	rdfs:label "ownership"@en ;
	skos:definition "situation in which some party holds the legal title to something (explicitly or implicitly) and has the right to transfer that title and/or possession" ;
	cmns-av:explanatoryNote "Ownership is the right to possess, use, sell, donate or give as a gift any asset or property belonging to a person known as the 'owner'. An owner can be either a beneficial owner or a legal owner." ;
	.

fibo-fnd-oac-own:PaidInCapital
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:OwnersEquity ;
	rdfs:label "paid-in capital" ;
	skos:definition "assets received from investors in exchange for an ownership interest" ;
	.

fibo-fnd-oac-own:PhysicalAsset
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:TangibleAsset ;
	rdfs:label "physical asset" ;
	skos:definition "tangible asset that has a material form, such as property, equipment, and inventory" ;
	cmns-av:explanatoryNote "Physical (tangible) assets are real items of value that are used to generate revenue for a company." ;
	.

fibo-fnd-oac-own:Portfolio
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Collection ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isHeldBy ;
			owl:allValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-be-oac-opty:Investor
					fibo-fbc-pas-fpas:FinancialServiceProvider
				) ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-fnd-oac-own:Portfolio ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fnd-oac-own:Holding ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isManagedBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-be-oac-opty:Investor
					fibo-fbc-pas-fpas:FinancialServiceProvider
				) ;
			] ;
		]
		;
	rdfs:label "portfolio" ;
	skos:definition "collection of holdings assembled and maintained as a unit for management purposes to achieve strategic objectives" ;
	cmns-av:adaptedFrom
		"http://www.investopedia.com/terms/h/holdings.asp"^^xsd:anyURI ,
		"http://www.investopedia.com/terms/p/portfolio.asp"^^xsd:anyURI
		;
	cmns-av:explanatoryNote """The holdings of any given portfolio may include a variety of investment products, including stocks, bonds and mutual funds to options, futures and exchange-traded funds, and relatively esoteric instruments such as private equity and hedge funds as well as other assets of the owner, such as interests in real estate, art, or vehicles. 

With respect to financial assets, the number and nature of holdings contribute to the degree of diversification of a portfolio. A mix of stocks across different sectors, bonds of different maturities, and other investments would suggest a well-diversified portfolio, while concentrated holdings in a handful of stocks within a single sector indicates a portfolio with limited diversification.""" ;
	.

fibo-fnd-oac-own:RetainedEarnings
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:OwnersEquity ;
	rdfs:label "retained earnings" ;
	skos:definition "net profits kept to accumulate in a business after dividends are paid" ;
	cmns-av:explanatoryNote "If the corporation takes a loss, then that loss is retained and called variously retained losses, accumulated losses or accumulated deficit. Retained earnings and losses are cumulative from year to year with losses offsetting earnings." ;
	.

fibo-fnd-oac-own:ShareholdersEquity
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:OwnersEquity ;
	rdfs:label "shareholders' equity" ;
	skos:definition "equity that is manifested in the form of shares in an entity, fund or structured product"@en ;
	.

fibo-fnd-oac-own:TangibleAsset
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-oac-own:Asset ;
	rdfs:label "tangible asset" ;
	skos:definition "asset that is a physical, measurable resource, i.e., one that takes a physical form" ;
	cmns-av:explanatoryNote "Tangible assets include cash, cash equivalents and accounts receivables (AR), inventory, equipment, buildings and real estate, crops, and investments. Tangible assets such as art, furniture, stamps, gold, wine, toys and books of significant value may be included in an individual or organization's asset portfolio." ;
	.

fibo-fnd-oac-own:hasAcquisitionPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has acquisition price" ;
	rdfs:range fibo-fnd-acc-cur:Price ;
	skos:definition "has a value as of the date of acquisition, expressed as an amount of money, other financial assets, or goods" ;
	.

fibo-fnd-oac-own:hasOwnedAsset
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasUndergoer ;
	rdfs:label "has owned asset" ;
	rdfs:domain fibo-fnd-oac-own:Ownership ;
	rdfs:range fibo-fnd-oac-own:Asset ;
	owl:inverseOf fibo-fnd-oac-own:isOwnedAsset ;
	skos:definition "indicates the asset in an ownership situation" ;
	.

fibo-fnd-oac-own:hasOwningParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasActor ;
	rdfs:label "has owning party" ;
	rdfs:domain fibo-fnd-oac-own:Ownership ;
	rdfs:range fibo-fnd-oac-own:Owner ;
	owl:inverseOf fibo-fnd-oac-own:isOwningParty ;
	skos:definition "identifies the actor that holds title to the asset in an ownership situation" ;
	.

fibo-fnd-oac-own:isAssetOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "is asset of" ;
	rdfs:domain fibo-fnd-oac-own:Asset ;
	rdfs:range fibo-fnd-oac-own:Owner ;
	skos:definition "identifies the owner of an asset" ;
	.

fibo-fnd-oac-own:isOwnedAsset
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:undergoes ;
	rdfs:label "is owned asset" ;
	rdfs:domain fibo-fnd-oac-own:Asset ;
	rdfs:range fibo-fnd-oac-own:Ownership ;
	skos:definition "indicates the context of ownership in which something is an asset" ;
	.

fibo-fnd-oac-own:isOwnedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:experiencesDirectly ;
	rdfs:label "is owned by" ;
	rdfs:range cmns-pts:Party ;
	skos:definition "indicates something that someone owns" ;
	.

fibo-fnd-oac-own:isOwningParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsIn ;
	rdfs:label "is owning party" ;
	rdfs:domain fibo-fnd-oac-own:Owner ;
	rdfs:range fibo-fnd-oac-own:Ownership ;
	skos:definition "indicates the context of ownership in which the party plays the role of owner" ;
	.

fibo-fnd-oac-own:owns
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:playsActiveRoleThatDirectlyAffects ;
	rdfs:label "owns" ;
	rdfs:domain cmns-pts:Party ;
	skos:definition "indicates something that a party holds title to and may possess" ;
	.

fibo-fnd-oac-own:ownsAsset
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsOn ;
	rdfs:label "owns asset" ;
	rdfs:domain fibo-fnd-oac-own:Owner ;
	rdfs:range fibo-fnd-oac-own:Asset ;
	owl:inverseOf fibo-fnd-oac-own:isAssetOf ;
	skos:definition "identifies an asset that an owner owns" ;
	.

fibo-fnd-oac-oac:OwnershipControlSituation
	a owl:Class ;
	rdfs:subClassOf cmns-pts:Situation ;
	rdfs:label "ownership control situation" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			fibo-fnd-oac-ctl:Control
			fibo-fnd-oac-own:Ownership
		) ;
	] ;
	skos:definition "situation in which some party owns and controls something" ;
	.

fibo-fnd-oac-oac:isOwnedAndControlledBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fnd-oac-own:isOwnedBy ,
		fibo-fnd-rel-rel:isControlledBy
		;
	rdfs:label "is owned and controlled by" ;
	rdfs:range cmns-pts:Party ;
	skos:definition "relates something to the party that owns, influences, manages and directs it" ;
	.

fibo-fnd-oac-oac:ownsAndControls
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		fibo-fnd-oac-own:owns ,
		fibo-fnd-rel-rel:controls
		;
	rdfs:label "owns and controls" ;
	rdfs:domain cmns-pts:Party ;
	owl:inverseOf fibo-fnd-oac-oac:isOwnedAndControlledBy ;
	skos:definition "directs and exercises authoritative or dominating influence over some thing that is also owned" ;
	skos:editorialNote """basic rule: if x controls y and x owns y then x owns and controls y
SWRL rule: controls(?x, ?y), owns(?x, ?y) -> ownsAndControls(?x, ?y)""" ;
	.

fibo-fnd-pty-pty:PartyRoleIdentificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-pty-pty:PartyRoleIdentifier ;
		]
		;
	rdfs:label "party role identification scheme" ;
	skos:definition "system for allocating identifiers to roles that parties play" ;
	.

fibo-fnd-pty-pty:PartyRoleIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-fnd-pty-pty:PartyRoleIdentificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-pty-pty:PartyRoleIdentificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass cmns-pts:PartyRole ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "party role identifier" ;
	skos:definition "sequence of characters, capable of uniquely identifying a party based on a specific role that they play in some context" ;
	.

fibo-fnd-pty-pty:TaxIdentificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "tax identification scheme" ;
	skos:definition "identification scheme used to identify taxpayers in some jurisdiction" ;
	cmns-av:adaptedFrom "https://www.oecd-ilibrary.org/taxation/standard-for-automatic-exchange-of-financial-account-information-in-tax-matters-second-edition_9789264267992-en"^^xsd:anyURI ;
	.

fibo-fnd-pty-pty:TaxIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-aap-ppl:NationalIdentificationNumber
				cmns-org:OrganizationIdentifier
			) ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-fnd-pty-pty:TaxIdentificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass cmns-pts:Party ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isApplicableIn ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "tax identifier" ;
	skos:definition "identifier assigned to a taxpayer that enables compulsory financial charges and other levies to be imposed on the taxpayer by a governmental organization in order to fund government spending and various public expenditures" ;
	cmns-av:adaptedFrom "https://www.oecd-ilibrary.org/taxation/standard-for-automatic-exchange-of-financial-account-information-in-tax-matters-second-edition_9789264267992-en"^^xsd:anyURI ;
	cmns-av:explanatoryNote "Tax identifiers are used for various tax-related purposes in the United States and in other countries under the Common Reporting Standard (CRS)." ;
	.

fibo-fnd-pty-pty:hasMailingAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-plc-adr:hasAddress ;
	rdfs:label "has mailing address" ;
	rdfs:domain cmns-pts:Party ;
	rdfs:range fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "identifies a physical address where an independent party can receive communications, including letters and packages" ;
	.

fibo-fnd-plc-adr:Address
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-id:Index ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-fnd-plc-adr:AddressingScheme ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-id:isIndexTo ;
			owl:onClass cmns-loc:Location ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "address"@en ;
	skos:definition "index to a location to which communications may be delivered" ;
	.

fibo-fnd-plc-adr:AddressComponent
	a owl:Class ;
	rdfs:subClassOf cmns-cls:Aspect ;
	rdfs:label "address component" ;
	skos:definition "aspect of an address" ;
	.

fibo-fnd-plc-adr:AddressingScheme
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-id:IndexingScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:allValuesFrom fibo-fnd-plc-adr:Address ;
		]
		;
	rdfs:label "addressing scheme" ;
	skos:definition "system for allocating addresses to objects" ;
	.

fibo-fnd-plc-adr:Apartment
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label
		"apartment"@en ,
		"apartmento"@es
		;
	skos:definition "room or a group of related rooms, among similar sets in one building, designed for use as a dwelling" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "APT" ;
	.

fibo-fnd-plc-adr:Basement
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "basement"@en ;
	skos:definition "part of a building consisting of rooms that are partly or entirely below ground" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "BSMT" ;
	.

fibo-fnd-plc-adr:Building
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "building"@en ;
	skos:definition "relatively permanent enclosed structure, that has a roof and walls and stands more or less permanently in one place" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "BLDG" ;
	.

fibo-fnd-plc-adr:ConventionalStreetAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:PhysicalAddress ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasAddressLine1 ;
			owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasAddressLine2 ;
			owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasAddressLine3 ;
			owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasStreetAddress ;
			owl:onClass fibo-fnd-plc-adr:StreetAddress ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "conventional street address" ;
	owl:disjointWith
		fibo-fnd-plc-uspsa:DepartmentOfStateAddress ,
		fibo-fnd-plc-uspsa:GeneralDeliveryAddress ,
		fibo-fnd-plc-uspsa:HighwayContractRouteAddress ,
		fibo-fnd-plc-uspsa:OverseasMilitaryAddress ,
		fibo-fnd-plc-uspsa:RuralRouteAddress
		;
	skos:definition "physical address that identifies a location on a street to which communications may be delivered" ;
	cmns-av:explanatoryNote "Other unconventional addresses may include rural and highway route addresses, general delivery addresses, post office box addresses, private mail center addresses, and so forth." ;
	.

fibo-fnd-plc-adr:Department
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label
		"departamento"@es ,
		"department"@en
		;
	skos:definition "division of a large organization such as a government, university, business, or shop, dealing with a specific subject, commodity, or area of activity" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "DEPT" ;
	.

fibo-fnd-plc-adr:Floor
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "floor"@en ;
	skos:definition "all of the rooms or areas on the same level of a building; a story" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "FL" ;
	cmns-av:explanatoryNote "Labeling systems for floors vary from country to country, and may be specific to the building, for example, whether or not a 13th floor is identified as such tends to be on a case-by-case basis." ;
	.

fibo-fnd-plc-adr:Front
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "front"@en ;
	skos:definition "side or part of a building that presents itself to view first, that faces the street; the most forward part of a building" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "FRNT" ;
	.

fibo-fnd-plc-adr:GeographicDirectionalSymbol
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:someValuesFrom xsd:string ;
		]
		;
	rdfs:label "geographic directional symbol" ;
	owl:equivalentClass [
		a owl:Class ;
		owl:oneOf (
			fibo-fnd-plc-uspsa:East
			fibo-fnd-plc-uspsa:North
			fibo-fnd-plc-uspsa:Northeast
			fibo-fnd-plc-uspsa:Northwest
			fibo-fnd-plc-uspsa:South
			fibo-fnd-plc-uspsa:Southeast
			fibo-fnd-plc-uspsa:Southwest
			fibo-fnd-plc-uspsa:West
		) ;
	] ;
	skos:definition "code element that gives directional information for postal delivery" ;
	skos:example "In the United States, these include N, S, E, W, NE, NW, SE, SW." ;
	.

fibo-fnd-plc-adr:Hangar
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "hanger"@en ;
	skos:definition "shed or shelter; any relatively wide structure used for housing airplanes or airships" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "HNGR" ;
	.

fibo-fnd-plc-adr:Key
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "key"@en ;
	skos:definition "usually metal instrument by which the bolt of a lock is turned" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "KEY" ;
	.

fibo-fnd-plc-adr:Lobby
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "lobby"@en ;
	skos:definition "entrance hall, corridor, or vestibule, as in a public building, often serving as an anteroom; foyer" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "LBBY" ;
	.

fibo-fnd-plc-adr:Lot
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "lot"@en ;
	skos:definition "measured parcel of land having fixed boundaries and designated on a plot or survey" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "LOT" ;
	.

fibo-fnd-plc-adr:Lower
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "lower"@en ;
	skos:definition "floor of a building in a multistory structure that is closer to ground level" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "LOWR" ;
	.

fibo-fnd-plc-adr:Office
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "office"@en ;
	skos:definition "place where a particular kind of business is transacted or a service is supplied" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "OFC" ;
	.

fibo-fnd-plc-adr:Penthouse
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "penthouse"@en ;
	skos:definition "structure or dwelling on the roof or top floor of a building" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "PH" ;
	.

fibo-fnd-plc-adr:PhysicalAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:Address ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasPostalCode ;
			owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasCityName ;
			owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasIndividualPostcode ;
			owl:onClass fibo-fnd-plc-adr:Postcode ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasCountry ;
			owl:onClass cmns-loc:Country ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasMunicipality ;
			owl:onClass cmns-loc:Municipality ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-id:isIndexTo ;
			owl:onClass cmns-loc:PhysicalLocation ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasSubdivision ;
			owl:someValuesFrom cmns-loc:CountrySubdivision ;
		]
		;
	rdfs:label "physical address"@en ;
	owl:disjointWith fibo-fnd-plc-adr:VirtualAddress ;
	skos:definition "physical address where communications can be addressed, papers served or representatives located for any kind of organization or person" ;
	skos:scopeNote "An address may be used as an index to the location of a building, apartment, office within an office block, or other structure or parcel of land, often using political boundaries and street names as references, along with other information such as house or building numbers or names. Some addresses also contain secondary elements such as apartment or building numbers, or special codes to aid routing of mail and packages." ;
	cmns-av:usageNote "Typically, addresses will have only one postcode expressed either as a string value or individual, and only a municipality (individual) or city (string value)." ;
	.

fibo-fnd-plc-adr:PhysicalAddressIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-plc-adr:PhysicalAddress ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-fnd-plc-adr:PhysicalAddressingScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "physical address identifier" ;
	skos:definition "unique identifier for a physical address" ;
	skos:example "Physical address identifiers may include bar codes, QCR codes, and +codes in a number of countries." ;
	.

fibo-fnd-plc-adr:PhysicalAddressingScheme
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressingScheme ,
		[
			a owl:Class ;
			owl:unionOf (
				[
					a owl:Restriction ;
					owl:onProperty cmns-dsg:defines ;
					owl:onClass fibo-fnd-plc-adr:PhysicalAddress ;
					owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
				]
				[
					a owl:Restriction ;
					owl:onProperty cmns-dsg:defines ;
					owl:onClass fibo-fnd-plc-adr:PhysicalAddressIdentifier ;
					owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
				]
			) ;
		]
		;
	rdfs:label "physical addressing scheme" ;
	rdfs:seeAlso <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	skos:definition "scheme for specifying physical addresses according to a country specific standard" ;
	.

fibo-fnd-plc-adr:Pier
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "pier"@en ;
	skos:definition "structure extending into navigable water for use as a landing place or promenade" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "PIER" ;
	.

fibo-fnd-plc-adr:PostCodeArea
	a owl:Class ;
	rdfs:subClassOf cmns-loc:GeographicRegion ;
	rdfs:label "post code area"@en ;
	skos:definition "physical area uniquely identified by some postal code" ;
	.

fibo-fnd-plc-adr:PostOfficeBox
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:SupplementalAddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-adr:PostOfficeBoxDesignator ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "post office box" ;
	skos:definition "post office box associated with an address" ;
	cmns-av:explanatoryNote "Post office box identifiers are only unique to a given jurisdiction, which may be a post office, town, or other region." ;
	.

fibo-fnd-plc-adr:PostOfficeBoxAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:PhysicalAddress ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-adr:PostOfficeBox ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "post office box address" ;
	skos:definition "physical address used to deliver communications to a designated container at a local post office or the local equivalent for the jurisdiction, where mail is held until the recipient collects it, rather than to a given house, building, or other location" ;
	.

fibo-fnd-plc-adr:PostOfficeBoxDesignator
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:SupplementalAddressDesignator ;
	rdfs:label "post office box designator"@en ;
	skos:definition "designator used, together with an identifier, for a post office box" ;
	skos:example "In the U.S., the preferred designator is 'PO BOX'." ;
	.

fibo-fnd-plc-adr:Postcode
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		cmns-loc:GeographicRegionIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-plc-adr:PostCodeArea ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "postcode"@en ;
	skos:definition "sequence of characters used to assist in the sorting of mail" ;
	cmns-av:synonym "postal code" ;
	.

fibo-fnd-plc-adr:PostdirectionalSymbol
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:GeographicDirectionalSymbol ;
	rdfs:label "postdirectional symbol" ;
	skos:definition "geographic directional symbol that follows the street name and street suffix in a street address" ;
	.

fibo-fnd-plc-adr:PredirectionalSymbol
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:GeographicDirectionalSymbol ;
	rdfs:label "predirectional symbol" ;
	skos:definition "geographic directional symbol that occurs after the primary street number but before the street name in a street address" ;
	.

fibo-fnd-plc-adr:PrimaryAddressNumber
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "primary address number" ;
	skos:definition "address component that identifies a location with respect to a given street" ;
	cmns-av:explanatoryNote "Although traditionally called a 'number', the street number may consist of alphanumeric characters, for example, '221B'." ;
	cmns-av:synonym "street number" ;
	.

fibo-fnd-plc-adr:Rear
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "rear"@en ;
	skos:definition "side or part of a building at the back, located opposite its front" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "REAR" ;
	.

fibo-fnd-plc-adr:RegionSpecificIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-loc:GeographicRegionIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isUsedBy ;
			owl:someValuesFrom cmns-loc:GeopoliticalEntity ;
		]
		;
	rdfs:label "region-specific identifier" ;
	skos:definition "geographic region or subdivision identifier used internally by a country or other region" ;
	.

fibo-fnd-plc-adr:Room
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "room"@en ;
	skos:definition "partitioned part of the inside of a building" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "RM" ;
	.

fibo-fnd-plc-adr:SecondaryUnit
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-adr:SecondaryUnitIndicator ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-adr:SecondaryUnitDesignator ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "secondary unit" ;
	skos:definition "address component that identifies an individual unit within a larger structure, such as an apartment, office, hangar, slip, mailbox, and so forth, at a given street address" ;
	.

fibo-fnd-plc-adr:SecondaryUnitDesignator
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:requiresSecondaryUnitRange ;
			owl:onDataRange xsd:boolean ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "secondary unit designator" ;
	skos:definition "classifier for a smaller structure or component within a larger facility, such as an apartment, office, mail stop, or other similar designation" ;
	cmns-av:explanatoryNote "Note that only certain secondary units require a secondary range, such as an apartment number, to complete a delivery point." ;
	.

fibo-fnd-plc-adr:SecondaryUnitIndicator
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "secondary unit indicator" ;
	skos:definition "index to the specific unit within a secondary unit, such as a building or apartment, at a particular street address" ;
	.

fibo-fnd-plc-adr:Side
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "side"@en ;
	skos:definition "place, space, or direction with respect to a center or to a line of division" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "SIDE" ;
	.

fibo-fnd-plc-adr:Slip
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "slip"@en ;
	skos:definition "sloping ramp extending out into the water to serve as a place for landing or repairing ships; ship's or boat's berth between two piers" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "SLP" ;
	.

fibo-fnd-plc-adr:Space
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "space"@en ;
	skos:definition "extent set apart or available, such as a parking or storage space" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "SPC" ;
	.

fibo-fnd-plc-adr:Stop
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "stop"@en ;
	skos:definition "stopping place, such as a bus or mail stop" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "STOP" ;
	.

fibo-fnd-plc-adr:StreetAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasPrimaryAddressNumber ;
			owl:onClass fibo-fnd-plc-adr:PrimaryAddressNumber ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasPostdirectionalSymbol ;
			owl:onClass fibo-fnd-plc-adr:PostdirectionalSymbol ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasPredirectionalSymbol ;
			owl:onClass fibo-fnd-plc-adr:PredirectionalSymbol ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasSecondaryUnit ;
			owl:onClass fibo-fnd-plc-adr:SecondaryUnit ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasStreetSuffix ;
			owl:onClass fibo-fnd-plc-adr:StreetSuffix ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasStreetName ;
			owl:someValuesFrom fibo-fnd-plc-adr:StreetName ;
		]
		;
	rdfs:label "street address" ;
	skos:definition "index to a location that consists of a primary address number, predirectional, street name, suffix, postdirectional, and an optional secondary unit" ;
	.

fibo-fnd-plc-adr:StreetName
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		cmns-dsg:Name ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "street name" ;
	skos:definition "identifier for a street in some context (e.g., city, municipality, geographic region)" ;
	.

fibo-fnd-plc-adr:StreetSuffix
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		cmns-cls:Classifier
		;
	rdfs:label "street suffix" ;
	skos:definition "classifier for a street or other delivery location, such as a dwelling located along a waterway" ;
	cmns-av:explanatoryNote "The suffix may provide some insight into the size or length of the street, though not necessarily consistently. In some cities, the suffix differentiates the street from another in the same context, such as 19th Street vs. 19th Avenue in San Francisco." ;
	.

fibo-fnd-plc-adr:StructureName
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		cmns-dsg:Name ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "structure name" ;
	skos:definition "name for a building, house, office complex, shopping center, or other structure or group of structures" ;
	skos:example "Examples include 'McCoy Center', which is the name of the office complex where JPMorgan Chase's Polaris facility is located, 'Apple Park', which is the name of the corporate headquarters of Apple, Inc., and 'Howells Bridge Cottage', which is the name of a very old cottage in Cornwall." ;
	.

fibo-fnd-plc-adr:Suite
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "suite"@en ;
	skos:definition "group of rooms occupied as a unit" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "STE" ;
	.

fibo-fnd-plc-adr:SupplementalAddressComponent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:minCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-adr:SupplementalAddressUnit ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-adr:SupplementalAddressDesignator ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "supplemental address component" ;
	skos:definition "address component that provides additional information that is important to ensuring proper delivery of communications" ;
	cmns-av:explanatoryNote "Supplemental components include post office box information, rural route and highway contract route information, private mailboxes, and so forth, that are not part of a conventional street address." ;
	.

fibo-fnd-plc-adr:SupplementalAddressDesignator
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fnd-plc-adr:SupplementalAddressComponent ;
		]
		;
	rdfs:label "supplemental address designator" ;
	skos:definition "classifier for supplemental address information, such as a highway contract route, rural route, building complex, shopping center, condominium complex, mail box, or other similar designation" ;
	.

fibo-fnd-plc-adr:SupplementalAddressUnit
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:AddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "supplemental address unit" ;
	skos:definition "address component that includes a specific route, box, apartment, condominium or other indicator or unit associated with a specific address" ;
	.

fibo-fnd-plc-adr:Trailer
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "trailer"@en ;
	skos:definition "vehicle designed to serve wherever parked as a temporary dwelling or place of business" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "TRLR" ;
	.

fibo-fnd-plc-adr:Unit
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "unit"@en ;
	skos:definition "area in a facility, such as a medical facility or hospital that is specially staffed and equipped to provide a particular service or type of care" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "true"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "UNIT" ;
	.

fibo-fnd-plc-adr:Upper
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SecondaryUnitDesignator
		;
	rdfs:label "upper"@en ;
	skos:definition "floor of a building in a multistory structure that is farther away from the ground level" ;
	fibo-fnd-plc-adr:requiresSecondaryUnitRange "false"^^xsd:boolean ;
	fibo-fnd-utl-av:preferredDesignation "UPPR" ;
	.

fibo-fnd-plc-adr:VirtualAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:Address ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "virtual address" ;
	skos:definition "address identifying a virtual, i.e. non-physical, location" ;
	.

fibo-fnd-plc-adr:hasAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cls:isCharacterizedBy ;
	rdfs:label "has address" ;
	rdfs:range fibo-fnd-plc-adr:Address ;
	skos:definition "indicates a means by which something (in the case of a network address) or some entity may be located or contacted or may receive correspondence" ;
	.

fibo-fnd-plc-adr:hasAddressLine1
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has address line 1" ;
	rdfs:domain fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "the first line of the street address" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-fnd-plc-adr:hasAddressLine2
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has address line 2" ;
	rdfs:domain fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "the second line of the street address" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-fnd-plc-adr:hasAddressLine3
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has address line 3" ;
	rdfs:domain fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "the third line of the street address" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	cmns-av:usageNote "This element SHALL be omitted if address line 2 is omitted." ;
	.

fibo-fnd-plc-adr:hasAttentionLine
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has attention line" ;
	rdfs:domain fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "an optional, free text address line denoting the intended recipient" ;
	.

fibo-fnd-plc-adr:hasIndividualPostcode
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has individual postcode" ;
	rdfs:domain fibo-fnd-plc-adr:PhysicalAddress ;
	rdfs:range fibo-fnd-plc-adr:Postcode ;
	skos:definition "indicates the local or international postcode element of a delivery address as specified by the local postal service" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-fnd-plc-adr:hasMailRouting
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has mail routing" ;
	rdfs:domain fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "an optional, free text address line containing explicit routing information (this elements's presence indicates that this address is a routing / 'care of' address)" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-fnd-plc-adr:hasPostalCode
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has postal code" ;
	rdfs:domain fibo-fnd-plc-adr:PhysicalAddress ;
	skos:definition "the postal code of this address as specified by the local postal service" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-fnd-plc-adr:hasPostdirectionalSymbol
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has postdirectional symbol" ;
	rdfs:domain fibo-fnd-plc-adr:StreetAddress ;
	rdfs:range fibo-fnd-plc-adr:PostdirectionalSymbol ;
	skos:definition "specifies a geographic directional symbol that follows the street name and street suffix in a street address" ;
	.

fibo-fnd-plc-adr:hasPredirectionalSymbol
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has predirectional symbol" ;
	rdfs:domain fibo-fnd-plc-adr:StreetAddress ;
	rdfs:range fibo-fnd-plc-adr:PredirectionalSymbol ;
	skos:definition "specifies a geographic directional symbol that occurs after the primary street number but before the street name in a street address" ;
	.

fibo-fnd-plc-adr:hasPrimaryAddressNumber
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has primary address number" ;
	rdfs:domain fibo-fnd-plc-adr:StreetAddress ;
	rdfs:range fibo-fnd-plc-adr:PrimaryAddressNumber ;
	skos:definition "specifies a a location with respect to a given street" ;
	.

fibo-fnd-plc-adr:hasSecondaryUnit
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has secondary unit" ;
	rdfs:domain fibo-fnd-plc-adr:StreetAddress ;
	rdfs:range fibo-fnd-plc-adr:SecondaryUnit ;
	skos:definition "specifies an individual unit within a larger structure, such as an apartment, office, hangar, slip, mailbox, and so forth, at a given street address" ;
	.

fibo-fnd-plc-adr:hasStreetAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has street address" ;
	rdfs:domain fibo-fnd-plc-adr:ConventionalStreetAddress ;
	rdfs:range fibo-fnd-plc-adr:StreetAddress ;
	skos:definition "indicates a fully-specified address component that consists of a primary address number, predirectional, street name, suffix, postdirectional, and an optional secondary unit" ;
	.

fibo-fnd-plc-adr:hasStreetName
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has street name" ;
	rdfs:domain fibo-fnd-plc-adr:StreetAddress ;
	rdfs:range fibo-fnd-plc-adr:StreetName ;
	skos:definition "specifies an identifier for a street in some context (e.g., 'Baker', 'First', 'Main')" ;
	.

fibo-fnd-plc-adr:hasStreetSuffix
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has street suffix" ;
	rdfs:domain fibo-fnd-plc-adr:StreetAddress ;
	rdfs:range fibo-fnd-plc-adr:StreetSuffix ;
	skos:definition "specifies an additional qualifier for a street or other delivery location, such as a dwelling located along a waterway" ;
	.

fibo-fnd-plc-adr:hasStructureName
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has structure name" ;
	rdfs:domain fibo-fnd-plc-adr:PhysicalAddress ;
	rdfs:range fibo-fnd-plc-adr:StructureName ;
	skos:definition "specifies an identifier for a building, house, office complex, shopping center, or other structure or group of structures" ;
	.

fibo-fnd-plc-adr:hasTransliteratedAddress
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-plc-adr:hasAddress ;
	rdfs:label "has transliterated address" ;
	rdfs:range fibo-fnd-plc-adr:Address ;
	skos:definition "identifies a transliterated (i.e., in Latin or Romanized ASCII) address for the registered entity" ;
	cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
	.

fibo-fnd-plc-adr:requiresSecondaryUnitRange
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "requires secondary unit range" ;
	rdfs:range xsd:boolean ;
	rdfs:seeAlso <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	skos:definition "if true, indicates that an additional qualifier is needed to complete the delivery point description, such as an apartment number" ;
	cmns-av:explanatoryNote "Note that in some cases, such as for lobby or office, if there are multiple secondary units then a range may be needed to differentiate between them, even if the range is not always required." ;
	.

fibo-fnd-plc-uspsa:CompleteAddress
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-uspsa:StandardizedAddress ;
	rdfs:label "complete address" ;
	skos:definition "delivery address that has all the address elements necessary to allow an exact match with the current Postal Service ZIP+4 and City State files to obtain the finest level of ZIP+4 and delivery point codes for the delivery address" ;
	cmns-av:explanatoryNote "A complete address may be required on mail at some automation rates." ;
	.

fibo-fnd-plc-uspsa:DeliveryAddressCodeSet
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeSet ,
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-plc-uspsa:USPostalServiceAddressIdentifier ;
		]
		;
	rdfs:label "delivery address code set" ;
	rdfs:seeAlso <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	skos:definition "system of numeric codes that substitute for specified delivery point details according to the U.S. Postal Service Publication 28" ;
	.

fibo-fnd-plc-uspsa:DeliveryPointCode
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-fnd-plc-uspsa:DeliveryPointCodeSet ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "delivery point code" ;
	rdfs:seeAlso <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	skos:definition "specific set of digits between 00 and 99 assigned to a delivery point" ;
	cmns-av:explanatoryNote "When combined with the ZIP + 4 code, the delivery point code provides a unique identifier for every deliverable address served by the USPS. The delivery point digits are almost never printed on mail in human-readable form; instead they are encoded in the POSTNET delivery point barcode (DPBC) or as part of the newer Intelligent Mail Barcode (IMB)." ;
	.

fibo-fnd-plc-uspsa:DeliveryPointCodeSet
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeSet ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-plc-uspsa:DeliveryPointCode ;
		]
		;
	rdfs:label "delivery point code set" ;
	rdfs:seeAlso <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	skos:definition "system of numeric codes that substitute for specified delivery point details according to the U.S. Postal Service Publication 28" ;
	.

fibo-fnd-plc-uspsa:DepartmentOfStateAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:PhysicalAddress ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasCityName ;
			owl:hasValue "DPO" ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:DepartmentOfStateUnitComponent ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:Mailbox ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "Department of State address" ;
	skos:definition "delivery address whose delivery address line uses 'UNIT' followed by the unit identifier, followed by 'BOX' followed by box number, in place of a street address, 'DPO' as the literal value for the city, and the appropriate armed forces subdivision code in place of a subdivision (state) code" ;
	.

fibo-fnd-plc-uspsa:DepartmentOfStateUnitComponent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:SupplementalAddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:hasValue fibo-fnd-plc-adr:Unit ;
		]
		;
	rdfs:label "Department of State unit component" ;
	skos:definition "component of a Department of State address that includes 'UNIT' followed by the unit identifier" ;
	.

fibo-fnd-plc-uspsa:East
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:GeographicDirectionalSymbol
		;
	rdfs:label
		"East"@en ,
		"Este"@es
		;
	skos:definition "geographic directional symbol for East" ;
	fibo-fnd-rel-rel:hasTag "E" ;
	.

fibo-fnd-plc-uspsa:GeneralDeliveryAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:PhysicalAddress ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasAddressLine1 ;
			owl:hasValue "GENERAL DELIVERY" ;
		]
		;
	rdfs:label "general delivery address" ;
	skos:definition "delivery address that uses the words 'GENERAL DELIVERY', uppercase preferred, spelled out (no abbreviation), in place of a street address" ;
	cmns-av:explanatoryNote "The value of the +4 component of a ZIP+4 code should be '9999'." ;
	.

fibo-fnd-plc-uspsa:HighwayContractRoute
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:SupplementalAddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:hasValue fibo-fnd-plc-uspsa:HighwayContractRouteDesignator ;
		]
		;
	rdfs:label "highway contract route" ;
	skos:definition "highway contract route associated with an address" ;
	.

fibo-fnd-plc-uspsa:HighwayContractRouteAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:PhysicalAddress ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:HighwayContractRoute ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:Mailbox ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "highway contract address" ;
	skos:definition "delivery address whose delivery address line uses the abbreviation 'HC', followed by the route identifier, followed by 'BOX' followed by box number, in place of a street address" ;
	.

fibo-fnd-plc-uspsa:HighwayContractRouteDesignator
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SupplementalAddressDesignator
		;
	rdfs:label "highway contract route designator" ;
	skos:definition "designator for a route served by an independent contractor rather than directly by the U.S. Postal Service" ;
	fibo-fnd-utl-av:preferredDesignation "HC" ;
	.

fibo-fnd-plc-uspsa:InternationalAddress
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:PhysicalAddress ;
	rdfs:label "international address" ;
	owl:equivalentClass [
		a owl:Restriction ;
		owl:onProperty cmns-loc:hasCountry ;
		owl:onClass cmns-loc:Country ;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
	] ;
	skos:definition "physical address that explicitly includes a country" ;
	.

fibo-fnd-plc-uspsa:Mailbox
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:SupplementalAddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:hasValue fibo-fnd-plc-uspsa:MailboxDesignator ;
		]
		;
	rdfs:label "mailbox" ;
	skos:definition "mailbox, other than a U.S. Post Office box, associated with an address" ;
	.

fibo-fnd-plc-uspsa:MailboxDesignator
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SupplementalAddressDesignator
		;
	rdfs:label "mailbox designator" ;
	skos:definition "designator for a mail box other than a U.S. Post Office box" ;
	fibo-fnd-utl-av:preferredDesignation "BOX" ;
	.

fibo-fnd-plc-uspsa:North
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:GeographicDirectionalSymbol
		;
	rdfs:label
		"Norte"@es ,
		"North"@en
		;
	skos:definition "geographic directional symbol for North" ;
	fibo-fnd-rel-rel:hasTag "N" ;
	.

fibo-fnd-plc-uspsa:Northeast
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:GeographicDirectionalSymbol
		;
	rdfs:label
		"Noreste"@es ,
		"Northeast"@en
		;
	skos:definition "geographic directional symbol for Northeast" ;
	fibo-fnd-rel-rel:hasTag "NE" ;
	.

fibo-fnd-plc-uspsa:Northwest
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:GeographicDirectionalSymbol
		;
	rdfs:label
		"Noroeste"@es ,
		"Northwest"@en
		;
	skos:definition "geographic directional symbol for Northwest" ;
	fibo-fnd-rel-rel:hasTag
		"NO" ,
		"NW"
		;
	.

fibo-fnd-plc-uspsa:OverseasMilitaryAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:PhysicalAddress ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-plc-adr:hasAddressLine1 ;
			owl:someValuesFrom rdfs:Literal ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-loc:hasCityName ;
			owl:someValuesFrom [
				a rdfs:Datatype ;
				owl:oneOf (
					"APO"
					"FPO"
				) ;
			] ;
		]
		;
	rdfs:label "overseas military address" ;
	skos:definition "delivery address whose delivery address line uses an abbreviation for the unit or command such as 'CMR', 'PSC', or 'UNIT', or 'HC', followed by the unit identifier, followed by 'BOX' followed by box number, in place of a street address, either 'APO' or 'FPO' as the literal value for the city and the appropriate armed forces subdivision code in place of a subdivision (state) code" ;
	.

fibo-fnd-plc-uspsa:PrivateMailBoxAddress
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:ConventionalStreetAddress ;
	rdfs:label "private mail box address" ;
	skos:definition "delivery address provided by a commercial mail receiving company that includes a supplementary address line containing the abbreviation 'PMB' or the pound \"#\" symbol followed by the mailbox number; alternatively, 'PMB' or '#\" and the mailbox number can be appended to the street address" ;
	.

fibo-fnd-plc-uspsa:PuertoRicoAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:ConventionalStreetAddress ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:Urbanization ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "Puerto Rico address" ;
	skos:definition "delivery address for a delivery point in Puerto Rico that may include a supplementary address line containing the abbreviation 'URB' followed by the name of the urbanization area that is appropriate for that address" ;
	.

fibo-fnd-plc-uspsa:RuralRoute
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:SupplementalAddressComponent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:hasValue fibo-fnd-plc-uspsa:RuralRouteDesignator ;
		]
		;
	rdfs:label "highway contract route address" ;
	skos:definition "mail route outside the city or township limits in a rural area associated with an address" ;
	.

fibo-fnd-plc-uspsa:RuralRouteAddress
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:PhysicalAddress ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:Mailbox ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:RuralRoute ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "rural route address" ;
	skos:definition "delivery address whose delivery address line uses the abbreviation 'RR', followed by the route identifier, followed by 'BOX' followed by box number, in place of a street address" ;
	.

fibo-fnd-plc-uspsa:RuralRouteDesignator
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:SupplementalAddressDesignator
		;
	rdfs:label "rural route designator" ;
	skos:definition "designator for a mail route outside the city or township limits in a rural area" ;
	fibo-fnd-utl-av:preferredDesignation "RR" ;
	.

fibo-fnd-plc-uspsa:South
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:GeographicDirectionalSymbol
		;
	rdfs:label
		"South"@en ,
		"Sur"@es
		;
	skos:definition "geographic directional symbol for South" ;
	fibo-fnd-rel-rel:hasTag "S" ;
	.

fibo-fnd-plc-uspsa:Southeast
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:GeographicDirectionalSymbol
		;
	rdfs:label
		"Southeast"@en ,
		"Sureste"@es
		;
	skos:definition "geographic directional symbol for Southeast" ;
	fibo-fnd-rel-rel:hasTag "SE" ;
	.

fibo-fnd-plc-uspsa:Southwest
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:GeographicDirectionalSymbol
		;
	rdfs:label
		"Southwest"@en ,
		"Suroeste"@es
		;
	skos:definition "geographic directional symbol for Southwest" ;
	fibo-fnd-rel-rel:hasTag
		"SO" ,
		"SW"
		;
	.

fibo-fnd-plc-uspsa:StandardizedAddress
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:PhysicalAddress ;
	rdfs:label "standardized address" ;
	skos:definition "delivery address that is fully spelled out, abbreviated by using the Postal Service standard abbreviations or as given in the current Postal Service ZIP+4 file" ;
	.

fibo-fnd-plc-uspsa:USPostOfficeBoxDesignator
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:PostOfficeBoxDesignator
		;
	rdfs:label "post office box designator" ;
	skos:definition "designator for a U.S. Post Office box" ;
	fibo-fnd-utl-av:preferredDesignation "PO BOX" ;
	.

fibo-fnd-plc-uspsa:USPostalServiceAddressIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-plc-adr:PhysicalAddressIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:DeliveryPointCode ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fnd-plc-uspsa:ZIPPlus4Code ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "U.S. Postal Service address identifier" ;
	skos:definition "combined with the ZIP + 4 code, the delivery point code provides a unique identifier for every deliverable address served by the USPS" ;
	cmns-av:explanatoryNote "The delivery point digits are almost never printed on mail in human-readable form; instead they are encoded in the POSTNET delivery point barcode (DPBC) or as part of the newer Intelligent Mail Barcode (IMB)." ;
	.

fibo-fnd-plc-uspsa:Urbanization
	a owl:Class ;
	rdfs:subClassOf cmns-loc:CountrySubdivision ;
	rdfs:label "urbanization" ;
	skos:definition "an area, sector, or development within a larger geographic area" ;
	cmns-av:explanatoryNote "This URB descriptor, commonly used in urban areas of Puerto Rico, is an important part of the addressing format, as it describes the location of a given street." ;
	.

fibo-fnd-plc-uspsa:West
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:GeographicDirectionalSymbol
		;
	rdfs:label
		"Oeste"@es ,
		"West"@en
		;
	skos:definition "geographic directional symbol for West" ;
	fibo-fnd-rel-rel:hasTag
		"O" ,
		"W"
		;
	.

fibo-fnd-plc-uspsa:ZIPCode
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:Postcode ;
	rdfs:label "Zip Code" ;
	skos:definition "five-digit code code assigned to a delivery address indicating the state and post office or postal zone" ;
	.

fibo-fnd-plc-uspsa:ZIPPlus4Code
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-plc-adr:Postcode ;
	rdfs:label "ZIP+4 Code" ;
	skos:definition "nine-digit number consisting of five digits, a hyphen, and four digits, which the USPS describes by its trademark ZIP+4" ;
	cmns-av:explanatoryNote "The correct format for a numeric ZIP+4 code is five digits, a hyphen, and four digits. The first five digits represent the 5-digit ZIP Code; the sixth and seventh digits (the first two after the hyphen) identify an area known as a sector; the eighth and ninth digits identify a smaller area known as a segment. Together, the final four digits identify geographic units such as a side of a street between intersections, both sides of a street between intersections, a building, a floor or group of floors in a building, a firm within a building, a span of boxes on a rural route, or a group of Post Office boxes to which a single USPS employee makes delivery." ;
	.

fibo-fnd-plc-uspsa:ZipCodeScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeSet ,
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-plc-uspsa:ZIPCode
					fibo-fnd-plc-uspsa:ZIPPlus4Code
				) ;
			] ;
		]
		;
	rdfs:label "zip code scheme" ;
	rdfs:seeAlso <https://pe.usps.com/cpim/ftp/pubs/Pub28/pub28.pdf> ;
	skos:definition "system used in the U.S. to facilitate the delivery of mail, consisting of a five- or nine-digit code Zone Improvement Plan (ZIP) printed directly after the address, the first five digits (initial code) indicating the state and post office or postal zone, the last four (expanded code) the box section or number, portion of a rural route, building, or other specific delivery location" ;
	.

fibo-fnd-plc-uspsa:hasUrbanization
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-col:comprises ;
	rdfs:label "has urbanization" ;
	rdfs:range fibo-fnd-plc-uspsa:Urbanization ;
	skos:definition "indicates area, sector, or development within a geographic area relevant to a delivery address" ;
	.

fibo-fnd-plc-uspsai:AA
	a
		owl:NamedIndividual ,
		fibo-fnd-plc-adr:RegionSpecificIdentifier
		;
	rdfs:label "AA" ;
	skos:definition "US-specific code for the state designation for Armed Forces Americas, excluding Canada" ;
	fibo-fnd-rel-rel:hasTag "AA" ;
	fibo-fnd-utl-av:preferredDesignation "AA" ;
	cmns-cxtdsg:isUsedBy lcc-3166-1:UnitedStatesOfAmerica ;
	cmns-dsg:denotes fibo-fnd-plc-uspsai:ArmedForcesAmericas ;
