		fibo-fnd-plc-adr:ConventionalStreetAddress
		;
	rdfs:label "Bank of Canada head office address" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/CARegulatoryAgencies/> ;
	skos:definition "head office address for the Bank of Canada" ;
	fibo-fnd-plc-adr:hasAddressLine1 "234 Wellington Street" ;
	fibo-fnd-plc-adr:hasPostalCode "K1A 0G9" ;
	cmns-loc:hasCountry lcc-3166-1:Canada ;
	cmns-loc:hasMunicipality fibo-fbc-fct-bci:Ottawa ;
	cmns-loc:hasSubdivision lcc-3166-2-ca:Ontario ;
