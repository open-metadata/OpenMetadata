	rdfs:domain fibo-fbc-pas-fpas:FinancialServiceProvider ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/USRegulatoryAgencies/> ;
	rdfs:range fibo-fbc-fct-usjrga:PrimaryFederalRegulator ;
	skos:definition "identifies the primary federal regulator for an institution" ;
	.

fibo-fbc-fct-usjrga:hasSecondaryFederalRegulator
