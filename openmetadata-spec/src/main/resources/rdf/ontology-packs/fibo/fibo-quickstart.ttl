fibo-be-fct-fct:Association
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-le-fbo:NotForProfitOrganization ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:playsRole ;
			owl:onClass fibo-be-fct-fct:CooperativeSociety ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "association" ;
	skos:definition "not-for-profit organization that is owned by and acts on behalf of its members" ;
	cmns-av:explanatoryNote "Associations include trade or business associations, industry sector-specific groups, and professional associations, among others. They also commonly include cooperative farms and markets." ;
	.

fibo-be-fct-fct:CooperativeSociety
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-fct:FunctionalBusinessEntity ;
	rdfs:label "cooperative society" ;
	skos:definition "organization owned by and operated for the benefit of those using its services" ;
	skos:example "In agriculture, there are broadly three types of cooperatives: a machinery pool, a manufacturing/marketing cooperative, and a credit union" ;
	cmns-av:synonym "cooperative" ;
	.

fibo-be-fct-fct:FamilyOffice
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-fct:FunctionalBusinessEntity ;
	rdfs:label "family office" ;
	skos:definition "organization that assumes the day-to-day administration and management of a family's affairs" ;
	cmns-av:explanatoryNote "Family offices are often privately held companies set up to handle investment and wealth management for wealthy families." ;
	.

fibo-be-fct-fct:FunctionalBusinessEntity
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-fct:FunctionalEntity ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass cmns-org:FormalOrganization ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "functional business entity" ;
	skos:definition "functional entity defined in terms of the nature of the commercial activity it conducts" ;
	.

fibo-be-fct-fct:FunctionalEntity
	a owl:Class ;
	rdfs:subClassOf
		cmns-rlcmp:FunctionalRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass cmns-pts:Party ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "functional entity" ;
	skos:definition "party defined in terms of a function they or it performs" ;
	.

fibo-be-fct-fct:Merchant
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-fct:FunctionalBusinessEntity ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:someValuesFrom fibo-be-fct-fct:MerchantCategoryCode ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:someValuesFrom fibo-be-fct-fct:MerchantIdentifier ;
		]
		;
	rdfs:label "merchant" ;
	skos:definition "party engaged in the purchase and sales of goods produced by others for profit" ;
	.

fibo-be-fct-fct:MerchantCategoryCode
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-cls:IndustrySectorClassifier ,
		cmns-cds:CodeElement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:onClass fibo-be-fct-fct:MerchantCategoryCodeScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-be-fct-fct:hasMerchantCategoryDescription ;
			owl:someValuesFrom xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-be-fct-fct:Merchant ;
		]
		;
	rdfs:label "merchant category code" ;
	skos:definition "code used internationally to classify a merchant" ;
	cmns-av:abbreviation "MCC" ;
	cmns-av:adaptedFrom "ISO 18245:2003 Retail financial services - Merchant category codes" ;
	cmns-av:explanatoryNote
		"Merchant categories are organized by the type of business, trade or services supplied. Certain category codes including those for very large businesses, such as airlines and some hotel chains, may be delineated to the point of identifying the business. Merchant category codes and/or the descriptions of the service categories are frequently used in credit card and other banking transactions for analysis, transaction classification, such as for use in promotional rewards, and sometimes tax-related purposes." ,
		"Values are specified only for those merchant categories that are generally expected to originate retail financial transactions. Criteria for establishing a new category code includes (a) the merchant category is reasonable and substantially different from all other merchant categories currently represented in the list of code values; (b) the merchant category is separate and distinct from all other industries currently represented in the list of code values; (c) the proposal describes a merchant category or industry, and not a process; (d) the minimum annual sales volume of merchants included in the merchant category, taken as a whole, is USD 10 million; and (e) sufficient justification for the addition of a new code value is found."
		;
	.

fibo-be-fct-fct:MerchantCategoryCodeScheme
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-cls:IndustrySectorClassificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-be-fct-fct:MerchantCategoryCode ;
		]
		;
	rdfs:label "merchant category code scheme" ;
	skos:definition "scheme defining a set of codes for classifying merchant services" ;
	cmns-av:adaptedFrom "ISO 18245:2003 Retail financial services - Merchant category codes" ;
	cmns-av:explanatoryNote "ISO 18245 provides a set of merchant category codes that are used internationally. Some countries, regional governments, banks, and other large organizations extend the basic codes with custom additions to fit business needs." ;
	.

fibo-be-fct-fct:MerchantIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-be-fct-fct:Merchant ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "merchant identifier" ;
	skos:definition "unique identifier for a merchant that is used, for example, for transaction interchange purposes" ;
	.

fibo-be-fct-fct:Syndicate
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:Organization ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom cmns-pts:Party ;
		]
		;
	rdfs:label "syndicate"@en ;
	skos:definition "temporary, self-organizing group of people, companies, corporations or entities organized as an alliance whose purpose is to transact some specific business, or to pursue or promote a shared interest"@en ;
	skos:example "For example, when a group of investment banks work together to bring a new issue of securities to the market, they form a distributing syndicate. Other types of syndicates are created for underwriting, banking, and insurance."@en ;
	cmns-av:explanatoryNote "A syndicate is a temporary alliance formed by people or businesses to handle a large transaction that would be hard to execute individually. Syndication makes it easy for businesses to pool their resources and share risks."@en ;
	.

fibo-be-fct-fct:SyndicateMember
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:OrganizationMember ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-col:isMemberOf ;
				owl:allValuesFrom fibo-be-fct-fct:Syndicate ;
			] ;
		]
		;
	rdfs:label "syndicate member"@en ;
	skos:definition "role of an individual or organization that is a member of an alliance set up to pool resources and share risk with respect to a large transaction"@en ;
	cmns-av:synonym
		"participating member"@en ,
		"syndicate participant"@en
		;
	.

fibo-be-fct-fct:hasMerchantCategoryDescription
	a owl:DatatypeProperty ;
	rdfs:label "has merchant category description" ;
	rdfs:domain fibo-be-fct-fct:MerchantCategoryCode ;
	rdfs:range xsd:string ;
	skos:definition "provides a text description of the sector to which the code applies" ;
	.

fibo-be-fct-pub:APIFirstMarketDataProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
	rdfs:label "API-first market data provider" ;
	skos:definition "market data provider that delivers financial information primarily through programmatic interfaces, offering real-time or historical data via APIs for automated consumption" ;
	.

fibo-be-fct-pub:AlternativeDataProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
	rdfs:label "alternative data provider" ;
	skos:definition "market data provider that supplies non-traditional datasets derived from sources such as web activity, sentiment analysis, geospatial signals, or other alternative information channels" ;
	.

fibo-be-fct-pub:CryptoDigitalAssetDataProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
	rdfs:label "crypto and digital-asset data provider" ;
	skos:definition "market data provider that supplies pricing, reference data, and analytics for digital tokens and crypto-assets" ;
	.

fibo-be-fct-pub:DerivativesVolatilityDataProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
	rdfs:label "derivatives and volatility data provider" ;
	skos:definition "market data provider that supplies pricing, implied-volatility surfaces, and analytics for derivatives, including options, futures, and structured products" ;
	.

fibo-be-fct-pub:ExchangeSourcedDataProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
	rdfs:label "exchange-sourced data provider" ;
	skos:definition "market data provider that distributes financial information originating directly from trading venues, including order-book data, trades, quotes, and venue-specific reference data" ;
	.

fibo-be-fct-pub:FixedIncomeSpecialistProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
	rdfs:label "fixed income specialist provider" ;
	skos:definition "market data provider that focuses on pricing, reference data, and analytics for fixed-income instruments such as bonds, credit products, and money-market securities" ;
	.

fibo-be-fct-pub:InstitutionalMarketDataProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
	rdfs:label "institutional market data provider" ;
	skos:definition "market data provider that supplies multi-asset financial information, analytics, and reference data to financial institutions such as banks, asset managers, and trading firms" ;
	cmns-av:explanatoryNote "Institutional market data providers Offer real-time and historical market data for various asset classes. They ensure data accuracy and compliance with regulatory standards. They typically provide tools for data visualization and analysis to aid decision-making. They may also facilitate access to proprietary research and market insights. Many such firms provide APIs and other options for ease of integration with trading platforms and risk management systems" ;
	.

fibo-be-fct-pub:MarketDataProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:Publisher ;
	rdfs:label "market data provider" ;
	skos:definition "publisher that supplies financial information, reference data, analytics, or related datasets used in financial markets" ;
	cmns-av:explanatoryNote "Market data providers include exchanges and independent data vendors, among others. Market valuation and related control and risk processes typically require explicit documentation of the source for a given market rate, such as an interest rate benchmark, exchange rate, stock prices, and so forth." ;
	.

fibo-be-fct-pub:Publication
	a owl:Class ;
	rdfs:subClassOf cmns-doc:Document ;
	rdfs:label "publication" ;
	skos:definition "document offered for general distribution and usually produced in multiple copies" ;
	cmns-av:adaptedFrom "ISO 5127:2017, Information and documentation - Foundation and vocabulary" ;
	cmns-av:explanatoryNote "A publication can be anything made public by print (such as a newspaper, magazine, pamphlet, letter, telegram, via computer modem or program, or in a poster, brochure or pamphlet), orally, or by broadcast (radio, television)." ;
	.

fibo-be-fct-pub:Publisher
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass cmns-pts:Party ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "publisher" ;
	skos:definition "role of person(s) or organization(s) responsible for the printing or distribution of an item, whether in digital or print (physical) form" ;
	cmns-av:adaptedFrom "ISO 10161-1:2014(en), Information and documentation - Open Systems Interconnection - Interlibrary Loan Application Protocol Specification - Part 1: Protocol specification" ;
	cmns-av:explanatoryNote "Publishers may also include banks, government agencies and the like." ;
	.

fibo-be-fct-pub:ReferenceDataSpecialistProvider
	a owl:Class ;
	rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
	rdfs:label "reference data specialist provider" ;
	skos:definition "market data provider that focuses on authoritative reference data, including corporate actions, instrument identifiers, classifications, and entity information aligned with ISO standards" ;
	.

fibo-be-fct-pub:hasPublisher
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-pts:hasPartyRole ,
		cmns-rlcmp:manifests
		;
	rdfs:label "has publisher" ;
	rdfs:domain fibo-be-fct-pub:Publication ;
	rdfs:range fibo-be-fct-pub:Publisher ;
	owl:inverseOf fibo-be-fct-pub:publishes ;
	skos:definition "indicates the party in the role of issuing the information" ;
	.

fibo-be-fct-pub:isPublishedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasParty ;
	rdfs:label "is published by" ;
	rdfs:domain fibo-be-fct-pub:Publication ;
	rdfs:range cmns-pts:Party ;
	skos:definition "identifies the independent party (i.e., the individual or organization) that disseminates the material" ;
	.

fibo-be-fct-pub:publishes
	a owl:ObjectProperty ;
