dct:abstract
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf dct:description ;
	rdfs:label "abstract" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "summary of the resource" ;
	cmns-av:usageNote "This annotation is typically used to describe an artifact such as a controlled vocabulary, ontology, or other similar resource." ;
	.

dct:contributor
	a owl:AnnotationProperty ;
	rdfs:label "contributor" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "an entity responsible for making contributions to the resource" ;
	skos:note "The guidelines for using names of persons or organizations as creators apply to contributors." ;
	.

dct:creator
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf dct:contributor ;
	rdfs:label "creator" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "an entity responsible for making the resource" ;
	skos:note "Recommended practice is to identify the creator with a URI. If this is not possible or feasible, a literal value that identifies the creator may be provided." ;
	.

dct:description
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf skos:note ;
	rdfs:label "description" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "an account of the resource" ;
	skos:note "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource." ;
	.

dct:issued
	a owl:AnnotationProperty ;
	rdfs:label "issued" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "date of formal issuance of the resource" ;
	skos:note "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty." ;
	cmns-av:usageNote "This annotation is typically used to describe an artifact such as a controlled vocabulary, ontology, or other similar resource." ;
	.

dct:license
	a owl:AnnotationProperty ;
	rdfs:label "license" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "a legal document giving official permission to do something with the resource" ;
	skos:note "Recommended practice is to identify the license document with a URI. If this is not possible or feasible, a literal value that identifies the license may be provided." ;
	cmns-av:usageNote "This annotation is typically used to describe an artifact such as a controlled vocabulary, ontology, or other similar resource." ;
	.

dct:modified
	a owl:AnnotationProperty ;
	rdfs:label "modified" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "date on which the resource was changed" ;
	skos:note "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty." ;
	cmns-av:usageNote "This annotation is typically used to indicate the most recent date on which an artifact such as a controlled vocabulary, ontology, or other similar resource was changed." ;
	.

dct:publisher
	a owl:AnnotationProperty ;
	rdfs:label "publisher" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "an entity responsible for making the resource available" ;
	cmns-av:usageNote "This annotation is typically used to describe an artifact such as a controlled vocabulary, ontology, or other similar resource." ;
	.

dct:references
	a owl:AnnotationProperty ;
	rdfs:label "references" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "a related resource that is referenced, cited, or otherwise pointed to by the described resource" ;
	skos:note "This property is intended to be used with non-literal values. This property is an inverse property of Is Referenced By." ;
	.

dct:rights
	a owl:AnnotationProperty ;
	rdfs:label "rights" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "information about rights held in and over the resource" ;
	skos:note "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights. Recommended practice is to refer to a rights statement with a URI. If this is not possible or feasible, a literal value (name, label, or short text) may be provided." ;
	cmns-av:usageNote "This annotation is typically used to describe an artifact such as a controlled vocabulary, ontology, or other similar resource." ;
	.

dct:source
	a owl:AnnotationProperty ;
	rdfs:label "source" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "a related resource from which the described resource is derived" ;
	skos:note "This property is intended to be used with non-literal values. The described resource may be derived from the related resource in whole or in part. Best practice is to identify the related resource by means of a URI or a string conforming to a formal identification system." ;
	cmns-av:explanatoryNote "The intent is to provide a user with a reference as to how the thing being annotated was derived or arrived at. The source can be a URL to a standard, common dictionary (e.g., Collins, Merriam-Webster, Oxford), a formal reference such as an ISO standard, or similar reference. Or it can be a short description of a source from which the entity being annotated was derived." ;
	.

dct:title
	a owl:AnnotationProperty ;
	rdfs:label "title" ;
	rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
	skos:definition "a name given to the resource" ;
	cmns-av:usageNote "This annotation is typically used to describe an artifact such as a controlled vocabulary, document, ontology, or other similar resource." ;
	.

sm:directSource
	a owl:AnnotationProperty ;
	.

rdf:langString
	a rdfs:Datatype ;
	rdfs:label "langString" ;
	dct:source
		"BCP 47: Tags for Identifying Languages, available at https://tools.ietf.org/search/bcp47" ,
		"https://www.w3.org/TR/rdf11-concepts/#section-Datatypes"
		;
	skos:definition "literal with a non-empty language tag" ;
	skos:note "This datatype declaration is included to support language-tagged strings, as defined in RDF 1.1. The rdf:langString datatype has not been incorporated directly in OWL 2 to date, and so it must be declared in order to enable its inclusion in the declaration of the Text datatype. Language-tagged strings must be well-formed according to section 2.2.9 of [BCP47]." ;
	.

owl:minQualifiedCardinality
	a owl:AnnotationProperty ;
	.

<http://www.w3.org/2003/01/geo/wgs84_pos#alt>
	a owl:DatatypeProperty ;
	skos:note "WGS 84 provides the 'alt' property as an RDF property, so we declare it here to enable use in OWL. However, we have not made it equivalent to hasAltitude due to the potential semantic clash for people using 'alt' with string values or numeric values with different units." ;
	.

<http://www.w3.org/2003/01/geo/wgs84_pos#lat>
	a owl:DatatypeProperty ;
	skos:note "WGS 84 provides the 'lat' property as an RDF property, so we declare it here to enable use in OWL. However, we have not made it equivalent to hasLatitude due to the potential semantic clash for people using 'lat' with string values or numeric values with different units." ;
	.

<http://www.w3.org/2003/01/geo/wgs84_pos#long>
	a owl:DatatypeProperty ;
	skos:note "WGS 84 provides the 'long' property as an RDF property, so we declare it here to enable use in OWL. However, we have not made it equivalent to hasLongitude due to the potential semantic clash for people using 'long' with string values or numeric values with different units." ;
	.

skos:altLabel
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf rdfs:label ;
	rdfs:label "alternative label" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "an alternative lexical label for a resource" ;
	skos:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)." ;
	skos:note
		"The range of skos:altLabel is the class of RDF plain literals." ,
		"skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."
		;
	.

skos:changeNote
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf skos:note ;
	rdfs:label "change note" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "a note about a modification to a concept" ;
	.

skos:definition
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf
		dct:description ,
		skos:note
		;
	rdfs:label "definition" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "a statement or formal explanation of the meaning of a concept" ;
	cmns-av:usageNote "For the purposes of OMG and other industry standards, definitions must be ISO 704 compliant." ;
	.

skos:editorialNote
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf skos:note ;
	rdfs:label "editorial note" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "a note for an editor, translator or maintainer of the vocabulary" ;
	.

skos:example
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf skos:note ;
	rdfs:label "example" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "an example of the use of a concept" ;
	.

skos:historyNote
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf skos:note ;
	rdfs:label "history note" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "a note about the past state, use, or meaning of a concept" ;
	.

skos:note
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf rdfs:comment ;
	rdfs:label "note" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "a general note, for any purpose" ;
	skos:scopeNote "This property may be used directly, or as a super-property for more specific note types." ;
	.

skos:prefLabel
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf rdfs:label ;
	rdfs:label "preferred label" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "the preferred lexical label for a resource, in a given language" ;
	skos:note
		"A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag." ,
		"The range of skos:prefLabel is the class of RDF plain literals." ,
		"skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."
		;
	.

skos:scopeNote
	a owl:AnnotationProperty ;
	rdfs:subPropertyOf skos:note ;
	rdfs:label "scope note" ;
	rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
	skos:definition "a note that helps to clarify the meaning and/or the use of a concept" ;
	.

