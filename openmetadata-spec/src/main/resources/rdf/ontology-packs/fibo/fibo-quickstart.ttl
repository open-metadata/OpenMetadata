fibo-fbc-fct-usjrga:FinancialStabilityOversightCouncil
	a
		owl:NamedIndividual ,
		fibo-be-ge-ge:GovernmentDepartment ,
		fibo-fbc-fct-usjrga:FederalGovernmentEntity
		;
	rdfs:label "Financial Stability Oversight Council" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/USRegulatoryAgencies/> ;
	skos:definition "Financial Stability Oversight Council (FSOC), which provides comprehensive monitoring of the stability of our nation's financial system, as established under the Dodd-Frank Wall Street Reform and Consumer Protection Act" ;
	cmns-av:abbreviation "FSOC" ;
	cmns-av:explanatoryNote "The Council is charged with identifying risks to the financial stability of the United States; promoting market discipline; and responding to emerging risks to the stability of the United States' financial system. The Council consists of 10 voting members and 5 nonvoting members and brings together the expertise of federal financial regulators, state regulators, and an independent insurance expert appointed by the President." ;
	cmns-col:hasMember
		fibo-fbc-fct-usjrga:CommodityFuturesTradingCommission ,
		fibo-fbc-fct-usjrga:ConsumerFinancialProtectionBureau ,
		fibo-fbc-fct-usjrga:FederalDepositInsuranceCorporation ,
		fibo-fbc-fct-usjrga:FederalHousingFinanceAgency ,
		fibo-fbc-fct-usjrga:FederalReserveBoard ,
		fibo-fbc-fct-usjrga:NationalCreditUnionAdministration ,
		fibo-fbc-fct-usjrga:OfficeOfTheComptrollerOfTheCurrency ,
		fibo-fbc-fct-usjrga:SecuritiesAndExchangeCommission
		;
	cmns-col:isPartOf fibo-fbc-fct-usjrga:USDepartmentOfTheTreasury ;
	cmns-org:hasWebsite "https://www.treasury.gov/initiatives/fsoc/Pages/home.aspx"^^xsd:anyURI ;
	cmns-rga:hasJurisdiction fibo-be-ge-usj:UnitedStatesJurisdiction ;
	.

fibo-fbc-fct-usjrga:IssuerIdentificationNumber
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-fse:FinancialServiceProviderIdentifier ,
		cmns-ra:RegisteredIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:isRegisteredIn ;
			owl:hasValue fibo-fbc-fct-usjrga:ABAIINRegistry ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:hasRegistrationAuthority ;
			owl:hasValue fibo-fbc-fct-usjrga:AmericanBankersAssociationRegistrationAuthority ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:isRegisteredBy ;
			owl:hasValue fibo-fbc-fct-usjrga:AmericanBankersAssociationRegistrationAuthority ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fbc-fct-fse:FinancialInstitution ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "issuer identification number" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/USRegulatoryAgencies/> ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/ISO/IEC_7812> ;
	skos:definition "a numbering system that allows a credit, debit, or other card to be identified as having been issued by a particular financial institution" ;
	cmns-av:abbreviation "IIN" ;
	cmns-av:explanatoryNote
		"IINs are issued directly by the American Banker's Association (ABA) in the US. The ABA is the Registration Authority (RA) for ISO/IEC 7812, which defines the IIN, in other words." ,
		"The issuer identification number (IIN) is a six digit number that is unique to a single card issuer. The number is only used to identify the card issuer, and is not used to identify a particular product, service, or region associated with the card issuer."
		;
	.

