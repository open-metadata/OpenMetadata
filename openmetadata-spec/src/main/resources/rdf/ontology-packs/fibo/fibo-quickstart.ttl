	rdfs:range cmns-rga:RegulatoryAgency ;
	skos:definition "identifies an additional federal regulator, over and above the primary federal regulator, for an institution" ;
	.

fibo-fbc-fct-rga:Examiner
	a owl:Class ;
	rdfs:subClassOf
		cmns-bauth:ResponsibleParty ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-bauth:isAuthorizedBy ;
			owl:onClass cmns-rga:RegulatoryAgency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-law-lcap:hasCapacity ;
				owl:someValuesFrom fibo-fbc-fct-rga:RegulatoryCapacity ;
			] ;
		]
		;
	rdfs:label "examiner" ;
	skos:definition "party empowered as an official representative by a regulatory agency to investigate and review specified documents for accuracy and truthfulness" ;
	cmns-av:adaptedFrom
		"Black's Law Dictionary, see http://thelawdictionary.org/examiner/" ,
		"EDM Council"
		;
	.

fibo-fbc-fct-rga:GovernmentIssuedLicense
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-law-lcap:License ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom cmns-rga:RegulatoryAgency ;
		]
		;
	rdfs:label "government-issued license" ;
	skos:definition "grant of permission needed to legally perform some task, provide some service, exercise a certain privilege, or pursue some business or occupation" ;
	cmns-av:adaptedFrom "Barron's Dictionary of Business and Economics Terms, Fifth Edition, 2012" ;
	.

fibo-fbc-fct-rga:RegulationIdentificationScheme
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:IdentificationScheme ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fbc-fct-rga:RegulationIdentifier ;
		]
		;
	rdfs:label "regulation identification scheme" ;
	skos:definition "a scheme for organizing information and allocating identifiers to regulations" ;
	.

fibo-fbc-fct-rga:RegulationIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:isMemberOf ;
			owl:onClass fibo-fbc-fct-rga:RegulationIdentificationScheme ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fnd-law-lcap:Regulation ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "regulation identifier" ;
	skos:definition "an identifier associated with a regulation" ;
	.

fibo-fbc-fct-rga:RegulatoryCapacity
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-law-lcap:LegalCapacity ;
	rdfs:label "regulatory capacity" ;
	skos:definition "the capacity of some natural person to regulate some industry, organization, or product by virtue of some certification program on behalf of some regulatory agency" ;
	.

fibo-fbc-fct-rga:TaxAuthority
	a owl:Class ;
	rdfs:subClassOf
		cmns-rga:RegulatoryAgency ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:issues ;
			owl:onClass fibo-fnd-pty-pty:TaxIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:manages ;
			owl:someValuesFrom fibo-fnd-pty-pty:TaxIdentificationScheme ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:hasJurisdiction ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "tax authority" ;
	skos:definition "regulatory agency that has jurisdiction over the assessment, determination, collection, imposition and other aspects of any tax" ;
	cmns-av:adaptedFrom
		"https://www.collinsdictionary.com/dictionary/english/tax-authority" ,
		"https://www.lawinsider.com/dictionary/tax-authority"
		;
	.

fibo-fbc-pas-caa:Account
	a owl:Class ;
	rdfs:subClassOf
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isHeldBy ;
			owl:onClass fibo-fbc-pas-caa:AccountHolder ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fbc-pas-caa:AccountIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasCloseDate ;
			owl:onClass fibo-fbc-pas-caa:CloseDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasRecord ;
			owl:onClass fibo-fbc-pas-caa:TransactionRecord ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasOpenDate ;
			owl:onClass fibo-fbc-pas-caa:OpenDate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasBalance ;
			owl:someValuesFrom fibo-fbc-pas-caa:Balance ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fbc-pas-caa:AccountProvider ;
		]
		;
	rdfs:label "account" ;
	skos:definition "container for records associated with a business arrangement for regular transactions and services" ;
	cmns-av:explanatoryNote "In general, an account is associated with a contractual relationship between a buyer and seller under which payment may be made at a later time. General ledger accounts are an exception to this, however, and typically do not have account holders, including internal account holders. They may, on the other hand, have responsible parties." ;
	.

fibo-fbc-pas-caa:AccountAsAnAsset
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:FinancialAsset ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:isAssetOf ;
			owl:someValuesFrom fibo-fbc-pas-caa:AccountHolder ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom fibo-fbc-pas-caa:Account ;
		]
		;
	rdfs:label "account as an asset" ;
	skos:definition "financial asset in the form of an account" ;
	.

fibo-fbc-pas-caa:AccountHolder
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Owner ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:someValuesFrom fibo-fbc-pas-caa:Account ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-oac-own:owns ;
				owl:someValuesFrom fibo-fbc-pas-caa:Account ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fbc-pas-caa:Account ;
			] ;
		]
		;
	rdfs:label "account holder" ;
	skos:definition "party that owns an account" ;
	cmns-av:explanatoryNote
		"An account holder is named on the account and is authorized to conduct transactions associated with the account. Authorization is typically evidenced by signatures maintained on file by the account provider." ,
		"Note that this concept of account holder applies to internal accounts that are non-general ledger accounts also have account holders, such as payroll accounts, internal checking accounts associated with cashier's checks, and so forth."
		;
	.

fibo-fbc-pas-caa:AccountIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-ra:RegisteredIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fbc-pas-caa:Account ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "account identifier" ;
	skos:definition "identifier that denotes an account" ;
	cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
	cmns-av:synonym "account number" ;
	.

fibo-fbc-pas-caa:AccountOwnership
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-oac-own:Ownership ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:hasOwnedAsset ;
			owl:onClass fibo-fbc-pas-caa:AccountAsAnAsset ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-oac-own:hasOwningParty ;
			owl:someValuesFrom fibo-fbc-pas-caa:AccountHolder ;
		]
		;
	rdfs:label "account ownership" ;
	skos:definition "holding of an account" ;
	.

fibo-fbc-pas-caa:AccountProvider
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:ServiceProvider ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fbc-pas-caa:Account ;
			] ;
		]
		;
	rdfs:label "account provider" ;
	skos:definition "party that provides and services an account" ;
	.

fibo-fbc-pas-caa:AccountSpecificServiceAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:ServiceAgreement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:someValuesFrom fibo-fbc-pas-caa:AccountHolder ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:someValuesFrom fibo-fbc-pas-caa:AccountProvider ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-pas-caa:Account ;
		]
		;
	rdfs:label "account-specific service agreement" ;
	skos:definition "service-agreement that is account-specific, applicable in cases where a client might hold multiple accounts with differing terms and conditions" ;
	cmns-av:explanatoryNote "Customers of financial service providers frequently hold multiple accounts - brokerage accounts, checking and savings accounts, trust accounts, and so forth - which may have specific terms and conditions associated with them." ;
	.

fibo-fbc-pas-caa:AccountStatement
	a owl:Class ;
	rdfs:subClassOf
		cmns-doc:LegalDocument ,
		cmns-doc:Record ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasEndingBalance ;
			owl:onClass fibo-fbc-pas-caa:Balance ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasStartingBalance ;
			owl:onClass fibo-fbc-pas-caa:Balance ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-doc:hasReportingPeriod ;
			owl:onClass cmns-dt:ExplicitDatePeriod ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:appliesToAccount ;
			owl:onClass fibo-fbc-pas-caa:Account ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:recordsTransaction ;
			owl:someValuesFrom fibo-fbc-pas-caa:IndividualTransaction ;
		]
		;
	rdfs:label "account statement" ;
	skos:definition "periodic summary of account activity for a given period of time" ;
	cmns-av:explanatoryNote "Common kinds of account statements include checking account statements, usually provided monthly, and brokerage account statements, which are provided monthly or quarterly, depending on the terms of the account agreement. Monthly credit card bills are also considered account statements." ;
	.

fibo-fbc-pas-caa:AccountingTransaction
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-pas-pas:TransactionEvent ;
	rdfs:label "accounting transaction" ;
	skos:definition "event recognized by an entry in the records of an account" ;
	.

fibo-fbc-pas-caa:Balance
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:MonetaryAmount ;
	rdfs:label "balance" ;
	skos:definition "amount of money available or owed" ;
	cmns-av:explanatoryNote "The balance is the net amount after factoring in all debits and credits, including service charges and fees." ;
	.

fibo-fbc-pas-caa:BankAccountIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:AccountIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fbc-pas-caa:DemandDepositAccount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "bank account identifier" ;
	skos:definition "identifier that identifies a demand deposit account provided by a bank" ;
	cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
	cmns-av:synonym "bank account number" ;
	.

fibo-fbc-pas-caa:BankIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-fse:FinancialServiceProviderIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fbc-fct-fse:FinancialInstitution ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "bank identifier" ;
	skos:definition "identifier that uniquely identifies the financial institution and, when appropriate, the branch of that financial institution servicing an account" ;
	cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
	cmns-av:synonym "bank number" ;
	.

fibo-fbc-pas-caa:BasicBankAccountIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:BankAccountIdentifier ,
		cmns-cxtid:StructuredIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fbc-pas-caa:BankAccountIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fbc-pas-caa:BankIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "basic bank account identifier" ;
	skos:definition "identifier that uniquely identifies an individual account at a specific financial institution in a particular country and which includes a bank identifier of the financial institution servicing that account" ;
	cmns-av:abbreviation "BBAN" ;
	cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
	cmns-av:synonym "basic bank account number" ;
	.

fibo-fbc-pas-caa:BrokerageAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:InvestmentAccount ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fbc-fct-fse:Bank
					fibo-fbc-fct-fse:BrokerageFirm
					fibo-fbc-fct-fse:FuturesCommissionMerchant
				) ;
			] ;
		]
		;
	rdfs:label "brokerage account" ;
	skos:definition "account offered by a broker that allows the investor to deposit funds and place investment orders" ;
	cmns-av:explanatoryNote "The investor owns the assets contained in the brokerage account and must usually claim as income any capital gains incurred." ;
	.

fibo-fbc-pas-caa:CertificateOfDeposit
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fi-fi:CashInstrument ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
			owl:onClass fibo-fnd-acc-cur:InterestRate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-fi:hasNominalValue ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractDuration ;
			owl:onClass cmns-dt:Duration ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "certificate of deposit"@en ;
	skos:definition "cash instrument associated with a time deposit account that cannot be withdrawn for a certain period of time (term)"@en ;
	cmns-av:abbreviation "CD" ;
	cmns-av:explanatoryNote "When the term is over it can be withdrawn or it can be held for another term. The longer the term the better the yield on the money." ;
	.

fibo-fbc-pas-caa:ChartOfAccounts
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-doc:FinancialRecord ,
		cmns-col:Arrangement ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:characterizes ;
			owl:someValuesFrom fibo-fbc-pas-caa:LedgerAccount ;
		]
		;
	rdfs:label "chart of accounts" ;
	skos:definition "structured system of financial account codes used to classify, record, and organize an entity's financial transactions in accordance with applicable legal, regulatory, and reporting requirements" ;
	.

fibo-fbc-pas-caa:CloseDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "close date" ;
	skos:definition "date on which something was closed" ;
	skos:example "account close date, transaction record close date, and so forth" ;
	.

fibo-fbc-pas-caa:CommercialLendingService
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-fpas:FinancialService ;
	rdfs:label "commercial lending service" ;
	skos:definition "service involving the extension of credit to support business activities" ;
	skos:example "Examples include operating lines of credit and term loans for property, plant and equipment (PP&E)." ;
	.

fibo-fbc-pas-caa:CustomerAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:Account ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fbc-pas-fpas:FinancialProduct
					fibo-fbc-pas-fpas:FinancialService
				) ;
			] ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isHeldBy ;
			owl:someValuesFrom fibo-fbc-pas-caa:CustomerAccountHolder ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-fnd-pas-pas:ServiceAgreement ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:someValuesFrom fibo-fbc-pas-caa:AccountIdentifier ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:intersectionOf (
					fibo-fbc-pas-caa:AccountProvider
					fibo-fbc-pas-fpas:FinancialServiceProvider
				) ;
			] ;
		]
		;
	rdfs:label "customer account" ;
	skos:definition "account that represents an identified, named collection of balances and cumulative totals used to summarize customer transaction-related activity over a designated period of time" ;
	cmns-av:synonym "financial service account" ;
	.

fibo-fbc-pas-caa:CustomerAccountHolder
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:AccountHolder ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-pas-pas:Client
				fibo-fnd-pas-pas:Customer
			) ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:holds ;
			owl:someValuesFrom fibo-fbc-pas-caa:CustomerAccount ;
		]
		;
	rdfs:label "customer account holder" ;
	skos:definition "party that owns a customer account" ;
	.

fibo-fbc-pas-caa:DemandDepositAccount
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-caa:TransactionDepositAccount ;
	rdfs:label "demand deposit account" ;
	skos:definition "non-interest-bearing deposit account in which deposits are payable immediately on demand, or that are issued with an original maturity or required notice period of less than seven days, or that represent funds for which the depository institution does not reserve the right to require at least seven days' written notice of an intended withdrawal" ;
	cmns-av:abbreviation "DDA" ;
	cmns-av:explanatoryNote "Demand deposits include any matured time deposits without automatic renewal provisions, unless the deposit agreement provides for the funds to be transferred at maturity to another type of account. Demand deposits do not include: (i) money market deposit accounts (MMDAs) or (ii) NOW accounts." ;
	.

fibo-fbc-pas-caa:DepositAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-fct-fse:BankingProduct ,
		fibo-fbc-pas-caa:InvestmentOrDepositAccount ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fbc-fct-fse:DepositoryInstitution ;
		]
		;
	rdfs:label "deposit account" ;
	skos:definition "account that provides a record of money placed with a depository institution for safekeeping and management" ;
	skos:example "Deposit accounts include savings accounts, money market accounts, and transactional accounts, such as demand deposit accounts, among others." ;
	cmns-av:explanatoryNote "The account holder has the right to withdraw deposited funds, as set forth in the terms and conditions governing the account agreement. Deposit accounts may be insured up to a certain amount, depending on the jurisdiction." ;
	.

fibo-fbc-pas-caa:Fee
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:MonetaryAmount ;
	rdfs:label "fee" ;
	skos:definition "charge for services performed" ;
	.

fibo-fbc-pas-caa:GeneralLedger
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-doc:FinancialRecord ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-pas-caa:LedgerAccount ;
		]
		;
	rdfs:label "general ledger" ;
	skos:definition "organized collection of ledger accounts used to record and summarize changes in position as transactions are posted during an accounting period" ;
	.

fibo-fbc-pas-caa:IndividualTransaction
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedCollectionConstituent ,
		fibo-fnd-dt-oc:Occurrence ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-ra:isRegisteredIn ;
			owl:allValuesFrom fibo-fbc-pas-caa:TransactionRecord ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fbc-pas-caa:TransactionIdentifier ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:involvesMerchant ;
			owl:onClass fibo-be-fct-fct:Merchant ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-fbc-pas-caa:TransactionCategory ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:onClass fibo-fbc-pas-caa:TransactionSubcategory ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fnd-pas-pas:TransactionEvent ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasTransactionDescription ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:appliesToAccount ;
			owl:onClass fibo-fbc-pas-caa:Account ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasPostingDate ;
			owl:onClass fibo-fbc-pas-caa:PostingDate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasTransactionDate ;
			owl:onClass fibo-fbc-pas-caa:TransactionDate ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasMonetaryAmount ;
			owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "individual transaction" ;
	skos:definition "event that has a monetary impact and is documented in the records associated with an account" ;
	.

fibo-fbc-pas-caa:InternationalBankAccountIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:BankAccountIdentifier ,
		cmns-cxtid:StructuredIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fbc-pas-caa:BasicBankAccountIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass cmns-loc:GeographicRegionIdentifier ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "international bank account identifier" ;
	skos:definition "identifier for a bank account that is an expanded version of the basic bank account number (BBAN), intended for use internationally" ;
	skos:example "For an account in Switzerland, suppose that an example domestic account number is 762 1162-3852.957. Suppose further that the bank identifier portion of that domestic account number is 762, or normalized for the BBAN is '00762'. For that example, the corresponding BBAN is '00762011623852957' and IBAN is 'CH9300762011623852957'." ;
	cmns-av:abbreviation "IBAN" ;
	cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
	cmns-av:explanatoryNote
		"Note that international bank account numbers are formatted uniquely by country. A description of the country-specific formats is available from SWIFT (https://www.swift.com/), which is the ISO registrar for ISO 13616." ,
		"The IBAN structure is defined in ISO 13616-1 and consists of a two-letter ISO 3166-1 country code, followed by two check digits and up to thirty alphanumeric characters for a BBAN (Basic Bank Account Number) which has a fixed length per country and, included within it, a bank identifier with a fixed position and a fixed length per country. The check digits are calculated based on the scheme defined in ISO/IEC 7064 (MOD97-10)."
		;
	cmns-av:synonym "international bank account number" ;
	.

fibo-fbc-pas-caa:InvestmentAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:InvestmentOrDepositAccount ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fbc-fct-fse:FinancialInstitution ;
		]
		;
	rdfs:label "investment account" ;
	skos:definition "account that provides a record of deposits of funds and/or securities held at a financial institution" ;
	cmns-av:explanatoryNote "The typical objectives of an investment account are to achieve long term growth, income or capital preservation from the deposited asset portfolio. Investment accounts are typically not insured." ;
	.

fibo-fbc-pas-caa:InvestmentOrDepositAccount
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-caa:Account ;
	rdfs:label "investment or deposit account" ;
	owl:disjointWith fibo-fbc-pas-caa:LoanOrCreditAccount ;
	skos:definition "account associated with a product or service that requires the account holder to provide funds for management by the account provider" ;
	cmns-av:explanatoryNote "The account holder may or may not be entitled to consideration in exchange for providing such funds, for example, interest, depending on the type of account and the terms and conditions associated with it. Also, there may be fees associated with management services provided by the account provider. Note too that this may be an internal account held on behalf of an institution or a customer account." ;
	.

fibo-fbc-pas-caa:LedgerAccount
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-caa:Account ;
	rdfs:label "ledger account" ;
	skos:definition "individual record for one element or sub-element in a ledger that records and summarizes increases, decreases, and balances associated with that specific element" ;
	cmns-av:explanatoryNote "Ledger accounts are internal to a legal entity's accounting system(s)." ;
	.

fibo-fbc-pas-caa:LedgerAccountClassificationScheme
	a
		owl:NamedIndividual ,
		cmns-cls:ClassificationScheme ,
		cmns-cds:CodeSet ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fbc-pas-caa:LedgerAccountClassifier ;
		]
		;
	rdfs:label "ledger account classification scheme" ;
	skos:definition "classification scheme used to organize an entity's financial accounts in accordance with applicable legal, regulatory, and reporting requirements" ;
	.

fibo-fbc-pas-caa:LedgerAccountClassifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:hasValue fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fbc-pas-caa:LedgerAccount ;
		]
		;
	rdfs:label "ledger account classifier" ;
	skos:definition "classifier used to organize an entity's financial accounts in accordance with applicable legal, regulatory, and reporting requirements" ;
	.

fibo-fbc-pas-caa:LedgerAccountClassifier-Assets
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-caa:LedgerAccountClassifier
		;
	rdfs:label "ledger account classifier - assets" ;
	dct:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
	skos:definition "classifier for ledger accounts used to track present rights of an entity to an economic benefit" ;
	cmns-av:explanatoryNote
		"A present right of an entity to an economic benefit entitles the entity to the economic benefit and the ability to restrict others' access to the benefit to which the entity is entitled. Assets are economic resources that an entity controls as a result of past events and that it expects to generate future economic benefits." ,
		"Assets commonly have features that help identify them - for example, assets may be contractual, tangible, exchangeable, or separable. However, those features are not essential characteristics of assets. Their absence is not sufficient to preclude an item from qualifying as an asset."
		;
	cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-txt:hasTextValue "Assets" ;
	.

fibo-fbc-pas-caa:LedgerAccountClassifier-Equity
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-caa:LedgerAccountClassifier
		;
	rdfs:label "ledger account classifier - equity" ;
	dct:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
	skos:definition "classifier for ledger accounts used to track the residual interest in the assets of an entity that remains after deducting its liabilities" ;
	cmns-av:synonym "Net Assets" ;
	cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-txt:hasTextValue "Equity" ;
	.

fibo-fbc-pas-caa:LedgerAccountClassifier-Expenses
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-caa:LedgerAccountClassifier
		;
	rdfs:label "ledger account classifier - expenses" ;
	dct:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
	skos:definition "classifier for ledger accounts used to track outflows or other using up of assets of an entity or incurrences of its liabilities (or a combination of both) from delivering or producing goods, rendering services, or carrying out other activities" ;
	cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-txt:hasTextValue "Expenses" ;
	.

fibo-fbc-pas-caa:LedgerAccountClassifier-Liabilities
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-caa:LedgerAccountClassifier
		;
	rdfs:label "ledger account classifier - liabilities" ;
	dct:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
	skos:definition "classifier for ledger accounts used to track present obligations of an entity to transfer an economic benefit" ;
	cmns-av:explanatoryNote
		"Liabilities are obligations whose settlement is expected to involve transferring assets, providing services, or other outflows of resources." ,
		"Liabilities commonly have features that help identify them. For example, many liabilities require the obligated entity to pay cash to one or more identified other entities. Liabilities may not require an entity to pay cash but may require the entity to convey other assets, provide services, or transfer other economic benefits or to be ready to do so."
		;
	cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-txt:hasTextValue "Liabilities" ;
	.

fibo-fbc-pas-caa:LedgerAccountClassifier-Revenue
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-caa:LedgerAccountClassifier
		;
	rdfs:label "ledger account classifier - revenue" ;
	dct:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
	skos:definition "classifier for ledger accounts used to track inflows or other enhancements of assets of an entity or settlements of its liabilities (or a combination of both) from delivering or producing goods, rendering services, or carrying out other activities" ;
	cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
	cmns-txt:hasTextValue "Revenue" ;
	.

fibo-fbc-pas-caa:LendingOfficer
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-oac-exec:CorporateOfficer ,
		fibo-fbc-pas-caa:RelationshipManager
		;
	rdfs:label "lending officer" ;
	skos:definition "corporate officer that has overarching responsibility for the relationship with a specific borrower or account" ;
	.

fibo-fbc-pas-caa:LoanOrCreditAccount
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-caa:Account ;
	rdfs:label "loan or credit account" ;
	skos:definition "account associated with a service in which the account holder receives funds from the account provider under certain terms and conditions for repayment" ;
	cmns-av:explanatoryNote "Note that this may be an internal account held on behalf of an institution or a customer account, such as a line of credit account associated with an internal line of business." ;
	.

fibo-fbc-pas-caa:NonTransactionDepositAccount
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-caa:DepositAccount ;
	rdfs:label "non-transaction deposit account" ;
	owl:disjointWith fibo-fbc-pas-caa:TransactionDepositAccount ;
	skos:definition "any deposit account that is not explicitly considered a transaction account" ;
	cmns-av:explanatoryNote "Non-transaction accounts include: (a) savings deposits ((i) money market deposit accounts (MMDAs) and (ii) other savings deposits) and (b) time deposits ((i) time certificates of deposit and (ii) time deposits, open account)." ;
	.

fibo-fbc-pas-caa:OpenDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "open date" ;
	skos:definition "date on which something was created" ;
	.

fibo-fbc-pas-caa:PaymentDueDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "payment due date" ;
	skos:definition "date by which payment of the current outstanding balance, part thereof, or a minimum amount due must be made to the creditor" ;
	.

fibo-fbc-pas-caa:PostingDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "posting date" ;
	skos:definition "date that determines in which posting period a document or journal entry is added to an account record" ;
	.

fibo-fbc-pas-caa:RelationshipManager
	a owl:Class ;
	rdfs:subClassOf
		cmns-bauth:ResponsibleParty ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:manages ;
			owl:someValuesFrom fibo-fbc-pas-caa:Account ;
		]
		;
	rdfs:label "relationship manager" ;
	skos:definition "responsible party who manages a client's account and oversees their relationship with the service provider" ;
	cmns-av:synonym "account manager" ;
	.

fibo-fbc-pas-caa:TimeCertificateOfDepositAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:TimeDepositAccount ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isExemplifiedBy ;
			owl:someValuesFrom fibo-fbc-pas-caa:CertificateOfDeposit ;
		]
		;
	rdfs:label "time certificate of deposit account" ;
	owl:disjointWith fibo-fbc-pas-caa:TimeDepositOpenAccount ;
	skos:definition "time deposit account that allows deposits evidenced by a negotiable or nonnegotiable instrument, or a deposit in book entry form evidenced by a receipt or similar acknowledgement issued by the bank, that provides, on its face, that the amount of such deposit is payable to the bearer, to any specified person, or to the order of a specified person, as follows: (1) on a certain date not less than seven days after the date of deposit, (2) at the expiration of a specified period not less than seven days after the date of the deposit, or (3) upon written notice to the bank which is to be given not less than seven days before the date of withdrawal." ;
	cmns-av:abbreviation "CDA" ;
	.

fibo-fbc-pas-caa:TimeDepositAccount
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-caa:NonTransactionDepositAccount ,
		fibo-fnd-pas-pas:ContractualProduct
		;
	rdfs:label "time deposit account" ;
	skos:definition "deposit account that the depositor does not have a right, and is not permitted, to make withdrawals from within six days after the date of deposit unless the deposit is subject to an early withdrawal penalty of at least seven days' simple interest on amounts withdrawn within the first six days after deposit" ;
	cmns-av:explanatoryNote "A time deposit from which partial early withdrawals are permitted must impose additional early withdrawal penalties of at least seven days' simple interest on amounts withdrawn within six days after each partial withdrawal. If such additional early withdrawal penalties are not imposed, the account ceases to be a time deposit. The account may become a savings deposit if it meets the requirements for a savings deposit; otherwise it becomes a demand deposit." ;
	.

fibo-fbc-pas-caa:TimeDepositOpenAccount
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-caa:TimeDepositAccount ;
	rdfs:label "time deposit open account" ;
	skos:definition "time deposit account that allows deposits (other than time certificates of deposit) for which there is in force a written contract with the depositor that neither the whole nor any part of such deposit may be withdrawn prior to (1) the date of maturity, which shall be not less than seven days after the date of the deposit, or (2) the expiration of a specified period of written notice of not less than seven days" ;
	.

fibo-fbc-pas-caa:TransactionCategory
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		cmns-cds:CodeElement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fbc-pas-caa:IndividualTransaction ;
		]
		;
	rdfs:label "transaction category" ;
	skos:definition "high-level classifier for an individual transaction" ;
	skos:example "credit, debit, fee" ;
	.

fibo-fbc-pas-caa:TransactionDate
	a owl:Class ;
	rdfs:subClassOf cmns-dt:ExplicitDate ;
	rdfs:label "transaction date" ;
	skos:definition "date on which a specific transaction was initiated" ;
	.

fibo-fbc-pas-caa:TransactionDepositAccount
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-caa:DepositAccount ;
	rdfs:label "transaction deposit account" ;
	skos:definition "deposit account from which the depositor / account holder is permitted to make transfers or withdrawals by negotiable / transferable instruments, payment orders of withdrawal, telephone transfers, and so forth, and that may be accessible via an electronic device such as an automated teller machine (ATM), remote service unit (RSU), mobile device, and by debit card" ;
	cmns-av:explanatoryNote "Excluded from transaction accounts are savings deposits (both money market deposit accounts (MMDAs) and other savings deposits), even though such deposits permit some third-party transfers. However, an account that otherwise meets the definition of a savings deposit but that authorizes or permits the depositor to exceed the transfer limitations specified for that account shall be reported as a transaction account." ;
	.

fibo-fbc-pas-caa:TransactionIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fbc-pas-caa:IndividualTransaction ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "transaction identifier" ;
	skos:definition "identifier for an individual transaction associated with an account" ;
	.

fibo-fbc-pas-caa:TransactionRecord
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-dt-fd:DatedStructuredCollection ,
		cmns-doc:Record ,
		cmns-ra:Registry ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fbc-pas-caa:TransactionRecordIdentifier ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasCloseDate ;
			owl:onClass fibo-fbc-pas-caa:CloseDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:onClass fibo-fbc-pas-caa:IndividualTransaction ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasOpenDate ;
			owl:onClass fibo-fbc-pas-caa:OpenDate ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:hasTransactionRecordStatus ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-caa:appliesToAccount ;
			owl:onClass fibo-fbc-pas-caa:Account ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isManagedBy ;
			owl:onClass fibo-fbc-pas-caa:AccountProvider ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "transaction record" ;
	skos:definition "record of transactions associated with an account" ;
	cmns-av:usageNote "The date a particular transaction record is closed typically corresponds to (and may precede) the date the account is closed, though in the case of certain accounts, such as a credit card account, if a customer is issued a new account or card number due to loss, fraud, or for some other reason, it is possible that multiple transaction records would be associated with the account. In that case, the close date might correspond to the date that a hold was placed on the original account." ;
	.

fibo-fbc-pas-caa:TransactionRecordIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-ra:RegisteredIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fbc-pas-caa:TransactionRecord ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "transaction record identifier" ;
	skos:definition "unique identifier for record of transactions" ;
	.

fibo-fbc-pas-caa:TransactionSubcategory
	a owl:Class ;
	rdfs:subClassOf
		cmns-cls:Classifier ,
		cmns-cds:CodeElement ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fbc-pas-caa:IndividualTransaction ;
		]
		;
	rdfs:label "transaction subcategory" ;
	skos:definition "second-level classifier for a transaction, e.g., direct deposit, check, cash advance, withdrawal, payment, purchase, and so forth" ;
	.

fibo-fbc-pas-caa:appliesToAccount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-cxtdsg:appliesTo ;
	rdfs:label "applies to account" ;
	rdfs:range fibo-fbc-pas-caa:Account ;
	skos:definition "indicates the account to which the transaction record or individual transaction applies" ;
	.

fibo-fbc-pas-caa:hasBalance
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has balance" ;
	rdfs:range fibo-fbc-pas-caa:Balance ;
	skos:definition "relates an account to the net amount of money available in that account" ;
	.

fibo-fbc-pas-caa:hasCloseDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasEndDate ,
		cmns-dt:hasExplicitDate
		;
	rdfs:label "has close date" ;
	rdfs:range fibo-fbc-pas-caa:CloseDate ;
	skos:definition "relates something to the date that it was closed" ;
	.

fibo-fbc-pas-caa:hasCorrespondingAccount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-pas-fpas:relatesTo ;
	rdfs:label "has corresponding account" ;
	rdfs:domain fibo-fbc-dae-dbt:CreditAgreement ;
	rdfs:range fibo-fbc-pas-caa:LoanOrCreditAccount ;
	skos:definition "relates a credit agreement to an account used as the basis for managing transactions" ;
	.

fibo-fbc-pas-caa:hasEndingBalance
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-pas-caa:hasBalance ;
	rdfs:label "has ending balance" ;
	rdfs:domain fibo-fbc-pas-caa:AccountStatement ;
	rdfs:range fibo-fbc-pas-caa:Balance ;
	skos:definition "relates an account statement to the amount of money available in that account at the end of the statement period" ;
	.

fibo-fbc-pas-caa:hasOpenDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		cmns-dt:hasExplicitDate ,
		cmns-dt:hasStartDate
		;
	rdfs:label "has open date" ;
	rdfs:range fibo-fbc-pas-caa:OpenDate ;
	skos:definition "relates something to the date that it was created" ;
	.

fibo-fbc-pas-caa:hasPaymentDueDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has payment due date" ;
	rdfs:range fibo-fbc-pas-caa:PaymentDueDate ;
	skos:definition "indicates the date by which payment of some amount must be made to the creditor" ;
	.

fibo-fbc-pas-caa:hasPostingDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has posting date" ;
	rdfs:range fibo-fbc-pas-caa:PostingDate ;
	skos:definition "indicates the date that the transaction was posted to the account" ;
	.

fibo-fbc-pas-caa:hasPrimaryAccountHolder
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf fibo-fnd-rel-rel:isHeldBy ;
	rdfs:label "has primary account holder" ;
	rdfs:domain fibo-fbc-pas-caa:CustomerAccount ;
	rdfs:range fibo-fbc-pas-caa:CustomerAccountHolder ;
	skos:definition "relates an account to a client or customer that is considered the primary owner of the account" ;
	cmns-av:explanatoryNote "Note that for many financial institutions, there must be a client or customer designated as the primary owner. In cases where there is a tax identifier associated with the account, it is that of the primary owner." ;
	cmns-av:synonym "has primary account owner" ;
	.

fibo-fbc-pas-caa:hasSecondaryAccountHolder
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:isHeldBy ;
	rdfs:label "has secondary account holder" ;
	rdfs:domain fibo-fbc-pas-caa:CustomerAccount ;
	rdfs:range fibo-fbc-pas-caa:CustomerAccountHolder ;
	skos:definition "relates an account to a client or customer that is considered a secondary, co-owner of the account" ;
	cmns-av:synonym
		"has account co-owner" ,
		"has secondary account owner"
		;
	.

fibo-fbc-pas-caa:hasStartingBalance
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-pas-caa:hasBalance ;
	rdfs:label "has starting balance" ;
	rdfs:domain fibo-fbc-pas-caa:AccountStatement ;
	rdfs:range fibo-fbc-pas-caa:Balance ;
	skos:definition "relates an account statement to the amount of money available in that account at the beginning of the statement period" ;
	.

fibo-fbc-pas-caa:hasTransactionDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
	rdfs:label "has transaction date" ;
	rdfs:range fibo-fbc-pas-caa:TransactionDate ;
	skos:definition "indicates the date on which the transaction actually occurred" ;
	.

fibo-fbc-pas-caa:hasTransactionDescription
	a owl:DatatypeProperty ;
	rdfs:label "has transaction description" ;
	rdfs:domain fibo-fbc-pas-caa:IndividualTransaction ;
	rdfs:range xsd:string ;
	skos:definition "provides a textual description of the transaction" ;
	.

fibo-fbc-pas-caa:hasTransactionRecordStatus
	a owl:DatatypeProperty ;
	rdfs:label "has transaction record status" ;
	rdfs:range xsd:string ;
	skos:definition "indicates the status of the transaction record" ;
	.

fibo-fbc-pas-caa:involvesMerchant
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:involves ;
	rdfs:label "involves merchant" ;
	rdfs:range fibo-be-fct-fct:Merchant ;
	skos:definition "indicates the merchant (seller) involved in the transaction" ;
	.

fibo-fbc-pas-caa:isLinkedToAccount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fbc-pas-fpas:relatesTo ;
	rdfs:label "is linked to account" ;
	rdfs:domain fibo-fbc-pas-caa:CustomerAccount ;
	rdfs:range fibo-fbc-pas-caa:CustomerAccount ;
	skos:definition "connects a given customer account to another customer account" ;
	.

fibo-fbc-pas-caa:recordsTransaction
	a owl:ObjectProperty ;
	rdfs:label "records transaction" ;
	owl:propertyChainAxiom (
		fibo-fbc-pas-caa:appliesToAccount
		fibo-fnd-arr-doc:hasRecord
		cmns-col:comprises
	) ;
	skos:definition "links an account statement to the individual transactions it documents" ;
	.

fibo-fbc-pas-fpas:AgencyAgreement
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:WrittenContract ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
			owl:someValuesFrom fibo-fbc-pas-fpas:RegisteredAgent ;
		]
		;
	rdfs:label "agency agreement" ;
	rdfs:seeAlso <http://www.sos.state.tx.us/corp/registeredagents.shtml> ;
	skos:definition "agreement that designates a party as a registered agent to represent and act on behalf of another party in some, typically legal, financial, or medical capacity" ;
	.

fibo-fbc-pas-fpas:AgentForServiceOfProcess
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-fpas:RegisteredAgent ;
	rdfs:label "agent for service of process" ;
	rdfs:seeAlso
		<http://www.law.cornell.edu/wex/agent_for_service_of_process> ,
		<http://www.sos.state.tx.us/corp/registeredagents.shtml>
		;
	skos:definition "registered agent (person or organization) designated by a business entity, such as a corporation, to receive legal correspondence on behalf of the business entity in the jurisdiction in which the agent's address is located" ;
	cmns-av:explanatoryNote "The person may be an officer of the corporation or a third party, such as the corporation's attorney, or a company providing such agency services." ;
	.

fibo-fbc-pas-fpas:AmendedTrade
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-fpas:TradeLifecycleStage
		;
	rdfs:label "amended trade" ;
	skos:definition "stage in the lifecycle of a trade indicating that a change or addition has been made to the terms of the trade, leaving the original terms largely intact" ;
	.

fibo-fbc-pas-fpas:Basket
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:Collection ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:hasSelectingParty ;
			owl:onClass cmns-pts:Party ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:hasSelectionCriteria ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fbc-pas-fpas:BasketConstituent ;
		]
		;
	rdfs:label "basket" ;
	skos:definition "collection of goods, services, or other things (e.g., financial contracts) that can be purchased and sold in some marketplace" ;
	cmns-av:explanatoryNote
		"A basket may be associated with a specific market sector, and may be delineated for the purposes of statistical analysis, such as for calculating CPI. According to the US Bureau of Labor Statistics (BLS), with respect to the CPI, a market basket is a package of goods and services that consumers purchase for day-to-day living. The weight of each item is based on the amount of expenditure reported by a sample of households." ,
		"From a securities perspective, a basket is a collection of products or securities that are designated to mimic the performance of a market. For investors, the market basket is the principal idea behind index funds, which are essentially a broad sample of stocks, bonds or other securities in the market; this provides investors with a benchmark against which to compare their investment returns."
		;
	.

fibo-fbc-pas-fpas:BasketConstituent
	a owl:Class ;
	rdfs:subClassOf cmns-col:Constituent ;
	rdfs:label "basket constituent" ;
	owl:equivalentClass [
		a owl:Restriction ;
		owl:onProperty cmns-col:isConstituentOf ;
		owl:someValuesFrom fibo-fbc-pas-fpas:Basket ;
	] ;
	skos:definition "component of a basket" ;
	.

fibo-fbc-pas-fpas:Broker
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractThirdParty ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fbc-pas-fpas:LicensedAgent
				fibo-fbc-pas-fpas:ThirdPartyAgent
			) ;
		]
		;
	rdfs:label "broker" ;
	skos:definition "any party that acts as an intermediary between a buyer and a seller, usually charging a commission" ;
	cmns-av:adaptedFrom "17 CFR 45.1, Definitions - see the definition of agent" ;
	cmns-av:explanatoryNote "A broker that specializes in stocks, bonds, commodities, or certain derivatives must be registered with the exchange in which the securities are traded." ;
	.

fibo-fbc-pas-fpas:BrokerDealer
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-fct:FunctionalEntity ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fbc-pas-fpas:Broker
				fibo-fbc-pas-fpas:Dealer
			) ;
		]
		;
	rdfs:label "broker-dealer" ;
	skos:definition "any party in the business of buying and selling securities, operating as both a broker and a dealer, depending on the transaction" ;
	cmns-av:adaptedFrom "Office of Financial Research (OFR) Annual Report, 2012, Glossary" ;
	.

fibo-fbc-pas-fpas:Catalog
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-pub:Publication ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:allValuesFrom cmns-id:Identifier ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:describes ;
			owl:someValuesFrom fibo-fnd-pas-pas:Product ;
		]
		;
	rdfs:label "catalog" ;
	skos:definition "publication including a list of products available for sale with their descriptions and possibly prices" ;
	.

fibo-fbc-pas-fpas:ClearedTrade
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-fpas:TradeLifecycleStage
		;
	rdfs:label "cleared trade" ;
	skos:definition "stage in the lifecycle of a trade indicating that a third-party clearing house, acting as an intermediary, has reconciled the orders involved in the trade" ;
	cmns-av:explanatoryNote "Clearing validates the availability of funds, records the transfer, and in the case of securities ensures the delivery of the security to the buyer." ;
	.

fibo-fbc-pas-fpas:ClosedTrade
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-fpas:TradeLifecycleStage
		;
	rdfs:label "closed trade" ;
	skos:definition "stage in the lifecycle of a trade indicating that the trade has been finalized, and that there is no longer a corresponding open position on the books of the trader, eliminating any exposure" ;
	.

fibo-fbc-pas-fpas:ContractLifecycle
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:Lifecycle ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleStage ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isLifecycleOf ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleStage ;
		]
		;
	rdfs:label "contract lifecycle" ;
	skos:definition "lifecycle of an agreement, including, but not limited to a credit agreement, financial instrument, or other formal contract, from initial stages through retirement" ;
	cmns-av:explanatoryNote "Certain business agreements, such as partnership agreements,may involve planning, drafting/review/revision, execution and management, renewal, and possibly sunsetting phases. Financial contracts, such as loans and other instruments have specific stages and events during the execution and management phase, i.e. from the effective date of the contract through maturity and redemption." ;
	.

fibo-fbc-pas-fpas:ContractLifecycleEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleEvent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:ContractLifecycleEvent ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:onClass fibo-fbc-pas-fpas:ContractLifecycleEventOccurrence ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleStage ;
		]
		;
	rdfs:label "contract lifecycle event" ;
	skos:definition "kind of event that occurs during one or more stages of the lifecycle of an agreement" ;
	skos:example "a call notification or coupon payment as a part of a bond lifecycle" ;
	.

fibo-fbc-pas-fpas:ContractLifecycleEventOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleEventOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:ContractLifecycleEvent ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isClassifiedBy ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleStageOccurrence ;
		]
		;
	rdfs:label "contract lifecycle event occurrence" ;
	skos:definition "actual occurrence of an event during a specific stage of a specific contract lifecycle" ;
	.

fibo-fbc-pas-fpas:ContractLifecycleOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:ContractLifecycle ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleStageOccurrence ;
		]
		;
	rdfs:label "contract lifecycle occurrence" ;
	skos:definition "realization of the lifecycle of a specific contract" ;
	.

fibo-fbc-pas-fpas:ContractLifecycleStage
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleStage ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:ContractLifecycleStage ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isStageOf ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycle ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycle ;
		]
		;
	rdfs:label "contract lifecycle stage" ;
	skos:definition "phase in the lifecycle of an agreement" ;
	.

fibo-fbc-pas-fpas:ContractLifecycleStageOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleStageOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:ContractLifecycleStage ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isStageOf ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleOccurrence ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ContractLifecycleEventOccurrence ;
		]
		;
	rdfs:label "contract lifecycle stage occurrence" ;
	skos:definition "realization, from start to finish of a phase in an occurrence of a specific contract lifecycle" ;
	.

fibo-fbc-pas-fpas:Dealer
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:ServiceProvider ,
		[
			a owl:Class ;
			owl:unionOf (
				fibo-fnd-pas-pas:Buyer
				fibo-fnd-pas-pas:Seller
			) ;
		]
		;
	rdfs:label "dealer" ;
	skos:definition "any party that purchases goods or services for resale and acts on their own behalf in a transaction" ;
	cmns-av:explanatoryNote "A dealer is a counterparty or principal in the transaction with the customer." ;
	.

fibo-fbc-pas-fpas:Exposure
	a owl:Class ;
	rdfs:subClassOf cmns-pts:Undergoer ;
	rdfs:label "exposure" ;
	skos:definition "means by which an individual or organization is unprotected and open to damage, danger, risk of suffering a loss, or uncertainty" ;
	skos:example "Examples include financial exposure, credit exposure, legal exposure, credit rating exposure, reputational exposure, and so forth." ;
	.

fibo-fbc-pas-fpas:ExposureBearer
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Actor ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:isExposedPartyIn ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ExposureSituation ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:isExposedTo ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Exposure ;
		]
		;
	rdfs:label "exposure bearer" ;
	skos:definition "party subject to influence or risk arising from a specific contract, instrument, or arrangement" ;
	skos:note "Note that the name given to the party at risk is dependent on the jurisdiction and nature of the risk. Different regulations use differing terminology for this party, and exposure bearer is considered more general that some synonyms." ;
	cmns-av:synonym
		"exposed party" ,
		"risk bearer" ,
		"risk-bearing party"
		;
	.

fibo-fbc-pas-fpas:ExposureSituation
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:hasExposedParty ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ExposureBearer ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:hasExposureTo ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Exposure ;
		]
		;
	rdfs:label "exposure situation"@en ;
	skos:definition "state of affairs in which some party is subject to influence or risk arising from a specific contract, instrument, or arrangement" ;
	.

fibo-fbc-pas-fpas:FinancialExposure
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-fpas:Exposure ;
	rdfs:label "financial exposure" ;
	skos:definition "the extent to which an individual or organization is open to risk of suffering a loss in a transaction, or with respect to some investment or set of investments, e.g., some holding; the amount one stands to lose in that transaction or investment" ;
	skos:example "Examples in banking include the total amount of unsecured loans, the amount of loans advanced to a single borrower, group, industry, or country, and the probability of loss from devaluation, revaluation, or foreign exchange fluctuations." ;
	skos:note "Financial exposure may be related to a holding, involving ownership, or may involve rights or obligations related to borrowing or derivatives." ;
	.

fibo-fbc-pas-fpas:FinancialIntermediationService
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-fpas:FinancialService ;
	rdfs:label "financial intermediation service" ;
	skos:definition "any financial service in which a third party (the intermediary) matches lenders and investors with entrepreneurs and other borrowers in need of capital" ;
	fibo-fnd-utl-av:definitionOrigin "Office of Financial Research (OFR) Annual Report, 2012, Glossary" ;
	cmns-av:explanatoryNote "Often investors and borrowers do not have precisely matching needs, and the intermediary's capital is put at risk to transform the credit risk and maturity of the liabilities to meet the needs of investors." ;
	.

fibo-fbc-pas-fpas:FinancialProduct
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:Product ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fbc-pas-fpas:FinancialServiceProvider ;
		]
		;
	rdfs:label "financial product" ;
	skos:definition "product provided to consumers and businesses by financial institutions such as banks, insurance companies, brokerage firms, consumer finance companies, and investment companies" ;
	.

fibo-fbc-pas-fpas:FinancialProductCatalog
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:Catalog ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:describes ;
			owl:someValuesFrom fibo-fbc-pas-fpas:FinancialProduct ;
		]
		;
	rdfs:label "financial product catalog" ;
	skos:definition "catalog of financial products and/or services available for sale with their description and other product details" ;
	cmns-av:adaptedFrom "Nordea Bank" ;
	.

fibo-fbc-pas-fpas:FinancialService
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:Service ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:isProvidedBy ;
			owl:someValuesFrom fibo-fbc-pas-fpas:FinancialServiceProvider ;
		]
		;
	rdfs:label "financial service" ;
	skos:definition "service provided to consumers and businesses by financial institutions such as banks, insurance companies, brokerage firms, consumer finance companies, and investment companies" ;
	.

fibo-fbc-pas-fpas:FinancialServiceProvider
	a owl:Class ;
	rdfs:subClassOf
		fibo-be-fct-fct:FunctionalBusinessEntity ,
		cmns-org:ServiceProvider ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:onClass cmns-org:LegalEntity ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-org:provides ;
			owl:someValuesFrom fibo-fbc-pas-fpas:FinancialService ;
		]
		;
	rdfs:label "financial service provider" ;
	skos:definition "functional entity either licensed to provide financial services to consumers and/or businesses or established by law to provide financial services, such as a central bank" ;
	.

fibo-fbc-pas-fpas:Holding
	a owl:Class ;
	owl:deprecated "true"^^xsd:boolean ;
	owl:equivalentClass fibo-fnd-oac-own:Holding ;
	.

fibo-fbc-pas-fpas:LegalAgent
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:AgentRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-law-lcap:hasCapacity ;
				owl:someValuesFrom fibo-fnd-law-lcap:DelegatedLegalAuthority ;
			] ;
		]
		;
	rdfs:label "legal agent" ;
	skos:definition "any party that has been legally empowered to act on behalf of another party" ;
	cmns-av:adaptedFrom "17 CFR 45.1, Definitions - see the definition of agent" ;
	.

fibo-fbc-pas-fpas:LicensedAgent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:LegalAgent ,
		fibo-fnd-law-lcap:Licensee ,
		cmns-bauth:ResponsibleParty
		;
	rdfs:label "licensed agent" ;
	skos:definition "any individual who is licensed to perform a legally binding function, and who has been legally empowered to act on behalf of another party" ;
	skos:example "Insurance agents, realtors, financial advisors, certain attorneys, and brokers are examples of legal agents." ;
	cmns-av:adaptedFrom "17 CFR 45.1, Definitions - see the definition of agent" ;
	.

fibo-fbc-pas-fpas:MaturedTrade
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-fpas:TradeLifecycleStage
		;
	rdfs:label "matured trade" ;
	skos:definition "stage in the lifecycle of a trade indicating that the trade, and related instrument(s) has ended (expired)" ;
	.

fibo-fbc-pas-fpas:Offeree
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fbc-pas-fpas:Offering ;
			] ;
		]
		;
	rdfs:label "offeree" ;
	skos:definition "party that receives an offer from something from someone (i.e., an offerer) based on the terms of the offering" ;
	.

fibo-fbc-pas-fpas:Offering
	a owl:Class ;
	rdfs:subClassOf
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:onClass fibo-fbc-pas-fpas:Offeree ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Offeror ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom owl:Thing ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-pts:hasPartyRole ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Offeror ;
		]
		;
	rdfs:label "offering" ;
	skos:definition "expression of interest in providing something to someone that is contingent upon acceptance, forbearance, or some other consideration, as might be desired by an offeree(s)" ;
	cmns-av:explanatoryNote "The making of an offer is the first of three steps in the traditional process of forming a valid contract: an offer, an acceptance of the offer, and an exchange of consideration. (Consideration is the act of doing something or promising to do something that a person is not legally required to do, or the forbearance or the promise to forbear from doing something that he or she has the legal right to do.)" ;
	cmns-av:usageNote "An offering may or may not be considered a 'state of affairs' or situation, depending on the circumstances. In some cases such as a prospectus or other offering in the context of financial services, an offering may also be classified as a situation. Users may choose to model an individual offering as both an offering and situation, depending on the circumstances, in other words." ;
	.

fibo-fbc-pas-fpas:Offeror
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:PartyRole ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:issues ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Offering ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty cmns-pts:isAPartyTo ;
				owl:someValuesFrom fibo-fbc-pas-fpas:Offering ;
			] ;
		]
		;
	rdfs:label "offeror" ;
	skos:definition "party that proposes to make something available to someone (i.e., an offeree) based on the terms of the offering" ;
	.

fibo-fbc-pas-fpas:OpenTrade
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-fpas:TradeLifecycleStage
		;
	rdfs:label "open trade" ;
	skos:definition "stage in the lifecycle of a trade indicating that the trade has been established and there is an associated open position on the books of the trader as a consequence" ;
	.

fibo-fbc-pas-fpas:Position
	a owl:Class ;
	rdfs:subClassOf fibo-fbc-pas-fpas:FinancialExposure ;
	rdfs:label "position" ;
	skos:definition "financial exposure resulting from owning, borrowing, shorting, or entering into a contract (e.g., derivatives)" ;
	cmns-av:explanatoryNote
		"A position can be long or short, and it can be in any asset class, such as stocks, bonds, futures, or options. A position can be open (current) or closed (past), but in general use, unless a position is specifically referred to as closed, the assumption is that it references an open position." ,
		"""Regulators use 'position' when speaking about exposure with respect to 
- CFTC futures/options positions
- Basel risk-weighted exposures
- Short-selling regulations (net short position)
- Derivatives reporting (swap positions)

A position may exist without a holding (e.g., short sale, swap exposure). A holding always implies a long position, but a position does not always imply a holding."""
		;
	.

fibo-fbc-pas-fpas:ProductLifecycle
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:Lifecycle ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycleStage ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isLifecycleOf ;
			owl:someValuesFrom fibo-fnd-pas-pas:Product ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycleStage ;
		]
		;
	rdfs:label "product lifecycle" ;
	skos:definition "lifecycle specific to a product or product family" ;
	skos:example "The product life cycle describes the period of time over which an item is developed, brought to market and eventually removed from the market. The cycle is broken into four stages: introduction, growth, maturity and decline. The idea of the product life cycle is used in marketing to decide when it is appropriate to advertise, reduce prices, explore new markets or create new packaging." ;
	.

fibo-fbc-pas-fpas:ProductLifecycleEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleEvent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:ProductLifecycleEvent ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:onClass fibo-fbc-pas-fpas:ProductLifecycleEventOccurrence ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycleStage ;
		]
		;
	rdfs:label "product lifecycle event" ;
	skos:definition "kind of event that occurs during one or more stages of a product lifecycle" ;
	.

fibo-fbc-pas-fpas:ProductLifecycleEventOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleEventOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:ProductLifecycleEvent ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycleStageOccurrence ;
		]
		;
	rdfs:label "product lifecycle event occurrence" ;
	skos:definition "actual occurrence of an event that happens during a specific stage of a specific product lifecycle" ;
	.

fibo-fbc-pas-fpas:ProductLifecycleOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:ProductLifecycle ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycleStageOccurrence ;
		]
		;
	rdfs:label "product lifecycle occurrence" ;
	skos:definition "realization of the lifecycle of a specific product" ;
	.

fibo-fbc-pas-fpas:ProductLifecycleStage
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleStage ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:ProductLifecycleStage ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isStageOf ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycle ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fnd-pas-pas:Product ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycleEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycle ;
		]
		;
	rdfs:label "product lifecycle stage" ;
	skos:definition "phase in a product lifecycle" ;
	skos:example "research and development phase of a product lifecycle or the introduction phase in a marketing lifecycle, growth stage in an economic lifecycle for a product" ;
	.

fibo-fbc-pas-fpas:ProductLifecycleStageOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleStageOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:ProductLifecycleStage ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isStageOf ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycleOccurrence ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-pas-fpas:ProductLifecycleEventOccurrence ;
		]
		;
	rdfs:label "product lifecycle stage occurrence" ;
	skos:definition "realization of a specific stage in the lifecycle of a given product" ;
	.

fibo-fbc-pas-fpas:RegisteredAgent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:LegalAgent ,
		fibo-fnd-agr-ctr:ContractParty ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:intersectionOf (
					[
						a owl:Restriction ;
						owl:onProperty cmns-pts:isAPartyTo ;
						owl:someValuesFrom fibo-fbc-pas-fpas:AgencyAgreement ;
					]
					[
						a owl:Restriction ;
						owl:onProperty cmns-rga:isRecognizedIn ;
						owl:someValuesFrom cmns-rga:Jurisdiction ;
					]
				) ;
			] ;
		]
		;
	rdfs:label "registered agent" ;
	rdfs:seeAlso
		<http://www.sos.state.tx.us/corp/registeredagents.shtml> ,
		<https://thelawdictionary.org/agent/>
		;
	skos:definition "legal agent designated by some party to represent them and act on their behalf under a formal agency agreement" ;
	cmns-av:explanatoryNote "Agency capacity, as specified in an agency agreement, may include power of attorney, the ability to act as an agent in certain kinds of transactions such as real estate, tax, audit or other financial or legal transactions, as a fiduciary, including as a trustee or legal guardian, for service of process, and so forth." ;
	cmns-av:synonym
		"resident agent" ,
		"statutory agent"
		;
	.

fibo-fbc-pas-fpas:RegulatedCommodity
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-pas-pas:Commodity ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isRegulatedBy ;
			owl:allValuesFrom cmns-rga:RegulatoryAgency ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rga:isGovernedBy ;
			owl:someValuesFrom cmns-rga:Jurisdiction ;
		]
		;
	rdfs:label "regulated commodity" ;
	skos:definition "commodity under the jurisdiction of the regulatory agency, such as the Commodities Futures Trading Commission (CFTF) in the United States, which includes any commodity traded in an organized contracts market" ;
	cmns-av:explanatoryNote "The CFTC polices matters of information and disclosure, fair trading practices, registration of firms and individuals, protection of customer funds, record keeping, and maintenance of orderly options and futures markets in the United States." ;
	.

fibo-fbc-pas-fpas:SettlementTerms
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-agr-ctr:ContractualCommitment ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:hasSettlementDate ;
			owl:allValuesFrom cmns-dt:Date ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-fi-stl:hasDeliveryMethod ;
			owl:someValuesFrom fibo-fbc-fi-stl:DeliveryMethod ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-fi-stl:Settlement ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-doc:specifies ;
			owl:someValuesFrom fibo-fbc-fi-stl:SettlementConvention ;
		]
		;
	rdfs:label "settlement terms" ;
	skos:definition "contract terms that define the commitment to and mechanism for settling one or more sides of a transaction" ;
	cmns-av:explanatoryNote "In general, settlement involves arrangement of disposition of property, typically for legal reasons. With respect to financial transactions, it involves completion of a trade, either between brokers or agents, or between a broker and client. This may include settlement in cash, either for the entire transaction or for the cash leg of a transaction, either now or at some specified time in the future." ;
	.

fibo-fbc-pas-fpas:TerminatedTrade
	a
		owl:NamedIndividual ,
		fibo-fbc-pas-fpas:TradeLifecycleStage
		;
	rdfs:label "terminated trade" ;
	skos:definition "stage in the trade lifecycle in which the trade has been terminated early, i.e., prior to maturity" ;
	cmns-av:explanatoryNote "Early termination may be triggered by a position sell or early termination provision, such as auto call/cancel, knock-out, etc." ;
	.

fibo-fbc-pas-fpas:ThirdPartyAgent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:LegalAgent ,
		fibo-fnd-law-lcap:Licensee ,
		cmns-org:ServiceProvider
		;
	rdfs:label "third-party agent" ;
	skos:definition "any service provider that is licensed to perform a legally binding function and has been legally empowered to act on behalf of another party" ;
	cmns-av:adaptedFrom "17 CFR 45.1, Definitions - see the definition of agent" ;
	cmns-av:usageNote "Note that third-party agent is defined as a service provider (organization) acting in an agency capacity, such as a law firm, accountancy, or investment bank. This is distinct from the concept of an individual (licensed agent), for example one who works for a broker-dealer, that is a registered agent licensed to sell securities." ;
	.

fibo-fbc-pas-fpas:Trade
	a owl:Class ;
	rdfs:subClassOf
		cmns-pts:Situation ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:Trade ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:isIdentifiedBy ;
			owl:onClass fibo-fbc-pas-fpas:TradeIdentifier ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:isCharacterizedBy ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycle ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:isFacilitatedBy ;
			owl:onClass fibo-fbc-pas-fpas:Trader ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:isEmbodiedIn ;
			owl:someValuesFrom fibo-fnd-agr-ctr:Contract ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:hasBuyer ;
			owl:someValuesFrom fibo-fnd-pas-pas:Buyer ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-pas-pas:hasSeller ;
			owl:someValuesFrom fibo-fnd-pas-pas:Seller ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:involves ;
			owl:someValuesFrom [
				a owl:Class ;
				owl:unionOf (
					fibo-fnd-agr-ctr:Contract
					fibo-fnd-pas-pas:Good
					cmns-org:Service
				) ;
			] ;
		]
		;
	rdfs:label "trade" ;
	skos:definition "situation that realizes an agreement between parties participating in a voluntary action of buying and selling goods and services" ;
	cmns-av:adaptedFrom "Deutsche Bank Presentation on the Lifecycle of a Trade, available at http://www.slideshare.net/ahaline/23512555-tradelifecycle" ;
	cmns-av:explanatoryNote
		"The advent of money as a medium of exchange has allowed trade to be conducted in a manner that is much simpler and effective compared to earlier forms of trade, such as bartering. In financial markets, trading also can mean performing a transaction that involves the selling and purchasing of a security." ,
		"The seller must deliver the commodity sold to the buyer; the buyer must pay the agreed purchase price, which could be in the form of other goods or services, on the agreed date." ,
		"Trading activities typically include (a) regularly underwriting or dealing in securities; interest rate, foreign exchange rate, commodity, equity, and credit derivative contracts; other financial instruments; and other assets for resale, (b) acquiring or taking positions in such items principally for the purpose of selling in the near term or otherwise with the intent to resell in order to profit from short-term price movements, and (c) acquiring or taking positions in such items as an accommodation to customers or for other trading purposes. (Source: Instructions for Preparation of Consolidated Reports of Condition and Income (FFIEC 031 and 041), Schedule RC-D - Trading Assets and Liabilities, 2013."
		;
	.

fibo-fbc-pas-fpas:TradeIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Trade ;
		]
		;
	rdfs:label "trade identifier" ;
	skos:definition "sequence of characters identifying a trade within some context" ;
	skos:note "Note that a given trade may consist of multiple transactions, and thus there may be multiple identifiers for such transactions associated with a specific trade." ;
	.

fibo-fbc-pas-fpas:TradeLifecycle
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:Lifecycle ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycleStage ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isLifecycleOf ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Trade ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:defines ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycleStage ;
		]
		;
	rdfs:label "trade lifecycle" ;
	skos:definition "lifecycle that defines the evolution of a trade, from initiation through settlement" ;
	skos:example "The trade life cycle covers the period of time over which a trade is initiated, typically as a part of a broader deal, is consumated, processed and executed, is settled or closed for other reasons, and is reported. Parts of a trade lifecycle may include or overlap with the lifecycle of one or more contracts." ;
	.

fibo-fbc-pas-fpas:TradeLifecycleEvent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleEvent ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycleEvent ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycleEventOccurrence ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycleStage ;
		]
		;
	rdfs:label "trade lifecycle event" ;
	skos:definition "kind of event that occurs during one or more stages of the lifecycle of a trade" ;
	.

fibo-fbc-pas-fpas:TradeLifecycleEventOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleEventOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycleEventOccurrence ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycleEvent ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:appliesTo ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycleStageOccurrence ;
		]
		;
	rdfs:label "trade lifecycle event occurrence" ;
	skos:definition "realization of an event that happens during a specific stage of a specific trade lifecycle" ;
	.

fibo-fbc-pas-fpas:TradeLifecycleOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycle ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:hasStage ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycleStageOccurrence ;
		]
		;
	rdfs:label "trade lifecycle occurrence" ;
	skos:definition "realization of the lifecycle for a specific trade" ;
	.

fibo-fbc-pas-fpas:TradeLifecycleStage
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleStage ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycleStage ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isStageOf ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycle ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cls:classifies ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Trade ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycleEvent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:isDefinedIn ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycle ;
		]
		;
	rdfs:label "trade lifecycle stage" ;
	skos:definition "phase in the lifecycle of a trade" ;
	.

fibo-fbc-pas-fpas:TradeLifecycleStageOccurrence
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-arr-lif:LifecycleStageOccurrence ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dt:succeeds ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycleStageOccurrence ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:exemplifies ;
			owl:onClass fibo-fbc-pas-fpas:TradeLifecycleStage ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-arr-lif:isStageOf ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycleOccurrence ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:comprises ;
			owl:someValuesFrom fibo-fbc-pas-fpas:TradeLifecycleEventOccurrence ;
		]
		;
	rdfs:label "trade lifecycle stage occurrence" ;
	skos:definition "realization of a phase in the lifecycle of a specific trade" ;
	.

fibo-fbc-pas-fpas:Trader
	a owl:Class ;
	rdfs:subClassOf
		cmns-org:ServiceProvider ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:facilitates ;
			owl:someValuesFrom fibo-fbc-pas-fpas:Trade ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-rlcmp:isPlayedBy ;
			owl:someValuesFrom [
				a owl:Restriction ;
				owl:onProperty fibo-fnd-law-lcap:hasCapacity ;
				owl:someValuesFrom fibo-fnd-law-lcap:ContractualCapability ;
			] ;
		]
		;
	rdfs:label "trader" ;
	skos:definition "party that engages in the transfer of financial assets in any financial market on behalf of a client or the financial services provider" ;
	.

fibo-fbc-pas-fpas:TradingStrategy
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-gao-obj:Strategy ;
	rdfs:label "trading strategy" ;
	skos:definition "approach used for buying and selling in the securities markets" ;
	cmns-av:explanatoryNote "A trading strategy is a plan whose aim is to make a profit or hedge against risk, based on rules and other criteria used when making trading decisions. A trading strategy may be simple or complex, and involve considerations such as investment style (e.g., value vs. growth), market cap, technical indicators, fundamental analysis, industry sector, level of portfolio diversification, time horizon or holding period, risk tolerance, leverage, tax considerations, and so on." ;
	.

fibo-fbc-pas-fpas:UniqueTransactionIdentifier
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:TradeIdentifier ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:onClass fibo-fbc-fi-fi:SecuritiesTransaction ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fbc-pas-fpas:hasGeneratingEntity ;
			owl:someValuesFrom cmns-org:LegalEntity ;
		]
		;
	rdfs:label "unique transaction identifier" ;
	skos:definition "sequence of characters identifying a financial transaction uniquely whenever useful and agreed by the parties or community involved in the transaction" ;
	cmns-av:abbreviation "UTI" ;
	cmns-av:adaptedFrom
		"Harmonization of the Unique Transaction Identifier - Technical Guidance, 20 Feb 2017, described in https://www.bis.org/cpmi/publ/d158.pdf" ,
		"ISO 23897:2020, Financial services - Unique transaction identifier (UTI)"
		;
	cmns-av:explanatoryNote "In particular, a UTI will help to ensure the consistent aggregation of OTC derivatives and other securities transactions by minimising the likelihood that the same transaction will be counted more than once (for instance, because it is reported by more than one counterparty to a transaction, or to more than one trade repository (TR))." ;
	.

fibo-fbc-pas-fpas:WeightedBasket
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:Basket ,
		cmns-col:StructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fbc-pas-fpas:WeightedBasketConstituent ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:someValuesFrom fibo-fnd-utl-alx:WeightingFunction ;
		]
		;
	rdfs:label "weighted basket" ;
	skos:definition "basket whose constituents have some relative importance with respect to one another" ;
	.

fibo-fbc-pas-fpas:WeightedBasketConstituent
	a owl:Class ;
	rdfs:subClassOf
		fibo-fbc-pas-fpas:BasketConstituent ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-utl-alx:hasWeight ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "weighted basket constituent" ;
	skos:definition "component of a basket whose relative importance with respect to other basket constituents is known" ;
	.

fibo-fbc-pas-fpas:exposesIn
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:undergoes ;
	rdfs:label "exposes in" ;
	rdfs:domain fibo-fbc-pas-fpas:Exposure ;
	rdfs:range fibo-fbc-pas-fpas:ExposureSituation ;
	skos:definition "indicates the state of affairs in which exposure occurs" ;
	.

fibo-fbc-pas-fpas:facilitates
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:playsActivePartyIn ;
	rdfs:label "facilitates" ;
	skos:definition "acts as an enabler in a situation in which an event, a task, a conversation or something else occurs" ;
	.

fibo-fbc-pas-fpas:hasExposedParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasActor ;
	rdfs:label "has exposed party" ;
	rdfs:domain fibo-fbc-pas-fpas:ExposureSituation ;
	rdfs:range fibo-fbc-pas-fpas:ExposureBearer ;
	owl:inverseOf fibo-fbc-pas-fpas:isExposedPartyIn ;
	skos:definition "indicates the party subject to influence or risk in" ;
	.

fibo-fbc-pas-fpas:hasExposureTo
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasUndergoer ;
	rdfs:label "has exposure to" ;
	rdfs:domain fibo-fbc-pas-fpas:ExposureSituation ;
	rdfs:range fibo-fbc-pas-fpas:Exposure ;
	owl:inverseOf fibo-fbc-pas-fpas:exposesIn ;
	skos:definition "involves influence or risk from" ;
	.

fibo-fbc-pas-fpas:hasGeneratingEntity
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-rel-rel:generates ;
	rdfs:label "has generating entity" ;
	rdfs:range cmns-org:LegalEntity ;
	skos:definition "specifies a legal entity that generates something" ;
	.

fibo-fbc-pas-fpas:hasGeneratingEntityIdentifier
	a owl:ObjectProperty ;
	rdfs:label "has generating entity identifier" ;
	rdfs:domain fibo-fbc-pas-fpas:UniqueTransactionIdentifier ;
	owl:propertyChainAxiom (
		fibo-fbc-pas-fpas:hasGeneratingEntity
		cmns-id:isIdentifiedBy
	) ;
	skos:definition "specifies an identifier for the entity that generated a unique transaction identifier" ;
	cmns-av:explanatoryNote "Note that the range of is identified by must be that entity's LEI in the context of a UTI." ;
	.

fibo-fbc-pas-fpas:hasLegalAgent
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasPartyRole ;
	rdfs:label "has registered agent" ;
	rdfs:range fibo-fbc-pas-fpas:LegalAgent ;
	skos:definition "identifies a party as one that has the legal, medical or financial capacity to act on behalf of someone else under specific circumstances" ;
	.

fibo-fbc-pas-fpas:hasNominalNumberOfUnits
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasAmount ;
	rdfs:label "has nominal number of units" ;
	rdfs:range xsd:integer ;
	skos:definition "indicates the base number of units of something associated with some offering" ;
	.

fibo-fbc-pas-fpas:hasOffering
	a owl:ObjectProperty ;
	rdfs:label "has offering" ;
	rdfs:range fibo-fbc-pas-fpas:Offering ;
	owl:inverseOf fibo-fbc-pas-fpas:isOfferingOf ;
	skos:definition "relates something to a voluntary but conditional promise submitted by a buyer or seller (offeror) to another (offeree) for acceptance, and which becomes legally enforceable if accepted by the offeree" ;
	.

fibo-fbc-pas-fpas:hasOfferingAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasNotionalAmount ;
	rdfs:label "has offering amount" ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "indicates the notional monetary amount, determined based on reference data, market rates or some other agreed method associated with some offering" ;
	.

fibo-fbc-pas-fpas:hasOfferingPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
	rdfs:label "has offering price" ;
	rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
	skos:definition "indicates the price associated with an offering, which may be an explicit or calculated price" ;
	.

fibo-fbc-pas-fpas:hasOfferingUnits
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasAmount ;
	rdfs:label "has offering units" ;
	rdfs:range xsd:integer ;
	skos:definition "indicates the actual number of units of something, including any premium on the number of units, associated with some offering" ;
	.

fibo-fbc-pas-fpas:hasSelectingParty
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasParty ;
	rdfs:label "has selecting party" ;
	rdfs:range cmns-pts:Party ;
	skos:definition "indicates the person(s) or organization(s) responsible for determining the contents of a basket" ;
	.

fibo-fbc-pas-fpas:hasSelectionCriteria
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has selection criteria" ;
	rdfs:domain cmns-col:Collection ;
	skos:definition "describes the methodology or program used to determine the membership of a collection" ;
	.

fibo-fbc-pas-fpas:hasSettlementDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasEndDate ;
	rdfs:label "has settlement date" ;
	rdfs:range fibo-fnd-dt-fd:CalculatedDate ;
	skos:definition "indicates the date by which an executed order or transaction must be settled" ;
	cmns-av:explanatoryNote "Settlement might involve either a buyer paying in cash or a seller delivering the relevant instrument(s) and receiving the proceeds as specified by the terms of a given transaction." ;
	.

fibo-fbc-pas-fpas:hasTradeDate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-dt:hasDate ;
	rdfs:label "has trade date" ;
	rdfs:range cmns-dt:Date ;
	skos:definition "indicates the date on which a security or other instrument-specific trade actually takes place" ;
	.

fibo-fbc-pas-fpas:isEmbodiedIn
	a owl:ObjectProperty ;
	rdfs:label "is embodied in" ;
	owl:inverseOf fibo-fnd-rel-rel:embodies ;
	skos:definition "identifies the representation or tangible form of something in some context" ;
	.

fibo-fbc-pas-fpas:isExposedPartyIn
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsIn ;
	rdfs:label "is exposed party in" ;
	rdfs:domain fibo-fbc-pas-fpas:ExposureBearer ;
	rdfs:range fibo-fbc-pas-fpas:ExposureSituation ;
	skos:definition "indicates the state of affairs in which the party bears the risk" ;
	.

fibo-fbc-pas-fpas:isExposedTo
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:actsOn ;
	rdfs:label "is exposed to" ;
	rdfs:domain fibo-fbc-pas-fpas:ExposureBearer ;
	rdfs:range fibo-fbc-pas-fpas:Exposure ;
	owl:inverseOf fibo-fbc-pas-fpas:isExposureOf ;
	skos:definition "is subject to influence or risk from" ;
	.

fibo-fbc-pas-fpas:isExposureOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:isAffectedBy ;
	rdfs:label "is exposure of" ;
	rdfs:domain fibo-fbc-pas-fpas:Exposure ;
	rdfs:range fibo-fbc-pas-fpas:ExposureBearer ;
	skos:definition "is the influence or risk borne by" ;
	.

fibo-fbc-pas-fpas:isFacilitatedBy
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-pts:hasActiveParty ;
	rdfs:label "is facilitated by" ;
	owl:inverseOf fibo-fbc-pas-fpas:facilitates ;
	skos:definition "identifies someone or something that expedites some event, transaction, conversation or something else in some context" ;
	.

fibo-fbc-pas-fpas:isOfferingOf
	a owl:ObjectProperty ;
	rdfs:label "is offering of" ;
	rdfs:domain fibo-fbc-pas-fpas:Offering ;
	skos:definition "relates an offering to one or things that are the subject of the offer" ;
	.

fibo-fbc-pas-fpas:relatesTo
	a owl:ObjectProperty ;
	rdfs:label "relates to" ;
	skos:definition "has a logical or causal connection with" ;
	.

fibo-fnd-acc-cur:AmountOfMoney
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:ScalarQuantityValue ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasCurrency ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "amount of money" ;
	owl:disjointWith fibo-fnd-pas-pas:Good ;
	skos:definition "amount of readily available cash in banknotes and coins" ;
	skos:editorialNote "This is an actual sum of money, not the measure of a sum of money in monetary units, although it has the same basic properties (decimal number with a currenct unit)." ;
	cmns-av:synonym "cash" ;
	.

fibo-fnd-acc-cur:CalculatedPrice
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:MonetaryPrice ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:uses ;
			owl:onClass fibo-fbc-fi-ip:PricingModel ;
			owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-qtu:hasExpression ;
			owl:onClass cmns-qtu:Expression ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "calculated price" ;
	skos:definition "monetary price determined by a formula" ;
	.

fibo-fnd-acc-cur:Currency
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:MeasurementUnit ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasMinorUnit ;
			owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
			owl:onDataRange xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasNumericCode ;
			owl:someValuesFrom xsd:string ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-cxtdsg:isUsedBy ;
			owl:someValuesFrom cmns-loc:GeopoliticalEntity ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:hasTextualName ;
			owl:someValuesFrom xsd:string ;
		]
		;
	rdfs:label "currency" ;
	skos:definition "medium of exchange value, defined by reference to the geographical location of the monetary authorities responsible for it" ;
	fibo-fnd-utl-av:definitionOrigin "Codes for the representation of currencies and funds, ISO 4217, Eighth edition, 2015-08-01, section 3.2" ;
	cmns-av:synonym
		"currency unit" ,
		"monetary unit"
		;
	.

fibo-fnd-acc-cur:CurrencyBasket
	a owl:Class ;
	rdfs:subClassOf
		cmns-col:StructuredCollection ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-col:hasMember ;
			owl:someValuesFrom fibo-fnd-acc-cur:Currency ;
		]
		;
	rdfs:label "currency basket" ;
	skos:definition "selected group of currencies, in which the weighted average is used as a measure of the value or the amount of an obligation" ;
	skos:note "A currency basket functions as a benchmark for regional currency movements; its composition and weighting depends on its purpose." ;
	fibo-fnd-utl-av:definitionOrigin "Codes for the representation of currencies and funds, ISO 4217, Eighth edition, 2015-08-01, section 3.2" ;
	.

fibo-fnd-acc-cur:CurrencyIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-fnd-acc-cur:Currency ;
		]
		;
	rdfs:label "currency identifier" ;
	skos:definition "sequence of characters representing some currency" ;
	cmns-av:adaptedFrom "Codes for the representation of currencies and funds, ISO 4217, Eighth edition, 2015-08-01, section 3.2" ;
	cmns-av:explanatoryNote "The first (left-most) two characters of the ISO 4217 3-letter currency identifier relate to the currency authority that issues the currency, and is, in most cases the ISO 3166-1 alpha 2 code for the geopolitical entity whose central bank is the issuer. The third (right-most) character of the identifier (alphabetic code) is an indicator derived from the name of the major currency unit or fund. If the currency is not associated with a single geographical entity as described in ISO 3166-1, typically a specially allocated identifier (alpha-2 code) is used to describe the currency authority. This code has been allocated by the Maintenance Agency from within the user-assigned range of codes XA to XZ specified in 8.1.3 of ISO 3166-1:2013. The character following X will be a mnemonic, where possible, derived from the name of the geographical area concerned." ;
	.

fibo-fnd-acc-cur:ExchangeRate
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:Ratio ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasBaseCurrency ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasDealtCurrency ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasRateValue ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "exchange rate" ;
	skos:definition "rate at which one currency can be exchanged for another" ;
	skos:example "The exchange rate between the U.S. dollar and British pound is distinct from the exchange rate between the U.S. dollar and the euro." ;
	.

fibo-fnd-acc-cur:Funds
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:Currency ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasCurrency ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "funds" ;
	skos:definition "artificial currency used as calculation basis for another currency(s) and accounting purposes" ;
	fibo-fnd-utl-av:definitionOrigin "Codes for the representation of currencies and funds, ISO 4217, Eighth edition, 2015-08-01, section 3.3" ;
	.

fibo-fnd-acc-cur:FundsIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-fnd-acc-cur:Funds ;
		]
		;
	rdfs:label "funds identifier" ;
	skos:definition "sequence of characters that can be used to uniquely identify funds" ;
	cmns-av:adaptedFrom "Codes for the representation of currencies and funds, ISO 4217, Eighth edition, 2015-08-01, section 3.2" ;
	.

fibo-fnd-acc-cur:InterestRate
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:PercentageMonetaryAmount ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasRateValue ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "interest rate" ;
	skos:definition "amount charged, expressed as a percentage of principal, in exchange for the use of assets" ;
	cmns-av:explanatoryNote "Interest rates are typically noted on an annual basis, known as the annual percentage rate (APR). The assets borrowed could include cash, consumer goods, and large assets such as a vehicle or building. The rate is derived by dividing the amount of interest by the amount of principal borrowed. Interest rates are quoted on bills, notes, bonds, credit cards, and many kinds of consumer and business loans." ;
	.

fibo-fnd-acc-cur:MonetaryAmount
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:ScalarQuantityValue ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasCurrency ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasAmount ;
			owl:onDataRange xsd:decimal ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "monetary amount" ;
	skos:definition "measure that is an amount of money specified in monetary units" ;
	.

fibo-fnd-acc-cur:MonetaryPrice
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:MonetaryAmount ,
		fibo-fnd-acc-cur:Price
		;
	rdfs:label "monetary price" ;
	skos:definition "price that that is expressed as a monetary amount" ;
	cmns-av:explanatoryNote "As the consideration given in exchange for transfer of ownership, price forms the essential basis of commercial transactions. It may be fixed by a contract, left to be determined by an agreed upon formula at a future date, or discovered or negotiated during the course of dealings between the parties involved. In commerce, price is determined by what (1) a buyer is willing to pay, (2) a seller is willing to accept, and (3) the competition is allowing to be charged." ;
	.

fibo-fnd-acc-cur:PercentageMonetaryAmount
	a owl:Class ;
	rdfs:subClassOf
		cmns-qtu:Percentage ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasCurrency ;
			owl:onClass fibo-fnd-acc-cur:Currency ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "percentage monetary amount" ;
	skos:definition "measure of some amount of money expressed as a percentage of some other amount, some notional amount or some concrete money amount" ;
	.

fibo-fnd-acc-cur:PreciousMetal
	a owl:Class ;
	rdfs:subClassOf
		fibo-der-drc-comm:Metal ,
		fibo-fnd-pas-pas:NegotiableCommodity ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:hasNumericCode ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-dsg:hasTextualName ;
			owl:someValuesFrom xsd:string ;
		]
		;
	rdfs:label "precious metal" ;
	skos:definition "metal that is considered to be rare and/or have a high economic value" ;
	.

fibo-fnd-acc-cur:PreciousMetalIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-fnd-acc-cur:PreciousMetal ;
		]
		;
	rdfs:label "precious metal identifier" ;
	skos:definition "sequence of characters uniquely identifying the precious metal in some context" ;
	.

fibo-fnd-acc-cur:Price
	a owl:Class ;
	rdfs:subClassOf cmns-qtu:ScalarQuantityValue ;
	rdfs:label "price" ;
	skos:definition "amount of money, goods, or services requested, expected, required, or given in exchange for something else" ;
	.

fibo-fnd-acc-cur:UnitOfAccount
	a owl:Class ;
	rdfs:subClassOf fibo-fnd-acc-cur:Currency ;
	rdfs:label "unit of account" ;
	skos:definition "nominal monetary unit of measure used to represent the real value (or cost) of any economic item; i.e. goods, services, assets, liabilities, income, expenses" ;
	.

fibo-fnd-acc-cur:UnitOfAccountIdentifier
	a owl:Class ;
	rdfs:subClassOf
		cmns-cds:CodeElement ,
		cmns-id:Identifier ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-rel-rel:hasTag ;
			owl:onDataRange xsd:string ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty cmns-id:identifies ;
			owl:someValuesFrom fibo-fnd-acc-cur:UnitOfAccount ;
		]
		;
	rdfs:label "unit of account identifier" ;
	skos:definition "sequence of characters that can be used to uniquely identify a nominal monetary unit" ;
	.

fibo-fnd-acc-cur:UnitPrice
	a owl:Class ;
	rdfs:subClassOf
		fibo-fnd-acc-cur:MonetaryPrice ,
		[
			a owl:Restriction ;
			owl:onProperty fibo-fnd-acc-cur:isPriceFor ;
			owl:someValuesFrom owl:Thing ;
		]
		;
	rdfs:label "unit price" ;
	skos:definition "monetary price expressed in relation to a well-known measurable unit by which the goods or services are allocated" ;
	skos:example "For example, gold is commonly measured in troy ounces, grams, etc., and oil is measured in terms of barrels." ;
	.

fibo-fnd-acc-cur:hasAmount
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has amount" ;
	rdfs:range xsd:decimal ;
	skos:definition "total number or quantity" ;
	.

fibo-fnd-acc-cur:hasBaseCurrency
	a
		owl:ObjectProperty ,
		owl:InverseFunctionalProperty
		;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasCurrency ;
	rdfs:label "has base currency" ;
	rdfs:range fibo-fnd-acc-cur:Currency ;
	skos:definition "specifies a unit of currency representing R units of the dealt currency, where R is the exchange rate value, in an exchange rate" ;
	.

fibo-fnd-acc-cur:hasCurrency
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasMeasurementUnit ;
	rdfs:label "has currency" ;
	rdfs:range fibo-fnd-acc-cur:Currency ;
	skos:definition "specifies the medium of exchange value in which something, such as a monetary amount is denominated" ;
	.

fibo-fnd-acc-cur:hasDealtCurrency
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasCurrency ;
	rdfs:label "has dealt currency" ;
	rdfs:range fibo-fnd-acc-cur:Currency ;
	skos:definition "specifies a unit of currency representing the exchanged (target) currency in an exchange rate; R units of this currency represent one unit of the base currency" ;
	.

fibo-fnd-acc-cur:hasFundsType
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has funds type" ;
	rdfs:domain fibo-fnd-acc-cur:Funds ;
	rdfs:range xsd:string ;
	skos:definition "indicates the type of funds, such as next day for US funds" ;
	.

fibo-fnd-acc-cur:hasMinorUnit
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has minor unit" ;
	rdfs:range xsd:string ;
	skos:definition "relates a code for the minor unit of currency to the currency or fund" ;
	skos:scopeNote """Requirements sometimes arise for values to be expressed in terms of minor units of currency. When this occurs, it is necessary to know the decimal relationship that exists between the currency concerned and its minor unit. 
- 0 means that there is no minor unit for the currency; 
- 1, 2, and 3 signify a ratio of 10 to 1, 100 to 1 and 1000 to 1 respectively.""" ;
	.

fibo-fnd-acc-cur:hasMonetaryAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
	rdfs:label "has monetary amount" ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "specifies a value for something in terms of an amount of money and the currency in which it is denoted" ;
	.

fibo-fnd-acc-cur:hasNotionalAmount
	a owl:ObjectProperty ;
	rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
	rdfs:label "has notional amount" ;
	rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
	skos:definition "has a generally unchangeable value used for certain calculations, expressed as some monetary amount" ;
	cmns-av:adaptedFrom "ISO 10962:2019, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10, clause 6.8.2" ;
	cmns-av:explanatoryNote
		"For certain kinds of derivative instruments, including but not limited to swaps, the notional amount indicates face amount of a swap upon which the payment streams for that swap are based. While this is typically constant throughout the lifetime of a contract, it can be accreting, amortizing, or custom, such as in the case of a notional step schedule." ,
		"""The notional amount (or notional principal amount or notional value) on a financial instrument is typically the face amount used to calculate payments made on that instrument. This amount generally does not change and is thus referred to as notional.
		
		When applied to a swap this is the amount used for calculating the actual value of the interest due. Also known as notional value when describing derivative contracts in the options, futures, and currency markets, this term is often used to value the underlying asset in a derivatives trade. It can be the total value of a position, how much value a position controls, or an agreed-upon amount in a contract.

		An example is that a firm might have a variable rate loan on $100,000 but decide to swap only $40,000. The $40,000 is the notional amount of the swap and becomes the amount on which interest is paid."""
		;
	.

fibo-fnd-acc-cur:hasNumericCode
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-txt:hasTextValue ;
	rdfs:label "has numeric code" ;
	rdfs:range xsd:string ;
	skos:definition "relates a numeric code to something, such as a currency or fund" ;
	skos:scopeNote "In the case of currency codes, the numeric currency code is derived, where possible, from the United Nations Standard Country or Area Code. Additional codes to meet special requirements (as described in 5.1.3) and in respect of funds will be allocated as necessary from within the user-assigned range of codes 950 to 998. Funds codes are allocated in descending order commencing at 998." ;
	.

fibo-fnd-acc-cur:hasPrice
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
	rdfs:label "has price" ;
	rdfs:range fibo-fnd-acc-cur:Price ;
	skos:definition "indicates the value of something expressed as an amount of money or goods" ;
	.

fibo-fnd-acc-cur:hasRateValue
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
	rdfs:label "has rate value" ;
	rdfs:range xsd:decimal ;
	skos:definition "has a value for a rate expressed as a number (may be a percentage or raw number)" ;
	.

fibo-fnd-acc-cur:isPriceFor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf cmns-doc:refersTo ;
	rdfs:label "is price for" ;
	rdfs:domain fibo-fnd-acc-cur:Price ;
	owl:inverseOf fibo-fnd-acc-cur:hasPrice ;
	skos:definition "links a price to something it provides a value for" ;
	.

