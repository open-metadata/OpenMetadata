fibo-be-ge-mxj:MexicanJurisdiction
	a
		owl:NamedIndividual ,
		cmns-rga:Jurisdiction
		;
	rdfs:label "Mexican jurisdiction" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/MXGovernmentEntitiesAndJurisdictions/> ;
	rdfs:seeAlso <https://www.scjn.gob.mx/> ;
	skos:definition "jurisdiction of the Supreme Court of Justice of the Nation, including the system of courts that interprets and applies the law at the federal level in Mexico" ;
	cmns-av:explanatoryNote "The Supreme Court of Justice of the Nation (SCJN) is the Mexican institution serving as the country's federal high court and the spearhead organisation for the judiciary of the Mexican Federal Government. It consists of eleven magistrates, known as ministers of the court, one of whom is designated the court's president." ;
	cmns-rga:hasReach lcc-3166-1:Mexico ;
	cmns-rga:isJurisdictionOf fibo-be-ge-mxj:FederalGovernmentOfMexico ;
	.

fibo-be-ge-usj:AmericanSamoaEntity
	a
		owl:NamedIndividual ,
		fibo-be-ge-ge:RegionalSovereignty
		;
	rdfs:label "American Samoa entity" ;
	rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/USGovernmentEntitiesAndJurisdictions/> ;
	rdfs:seeAlso
		<http://americansamoa.gov/> ,
		<https://www.doi.gov/oia/islands/american-samoa>
		;
	skos:definition "individual representing the unincorporated territory and polity of the United States located in the South Pacific Ocean, known as American Samoa" ;
	fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-2-us:AmericanSamoa ;
	fibo-be-ge-ge:isRepresentedBy fibo-be-ge-usj:GovernmentOfAmericanSamoa ;
	cmns-av:explanatoryNote "American Samoa consists of five main islands and two coral atolls. The largest and most populous island is Tutuila, with the Manu'a Islands, Rose Atoll, and Swains Island also included in the territory. American Samoa is part of the Samoan Islands chain, located west of the Cook Islands, north of Tonga, and some 300 miles (500 km) south of Tokelau." ;
	.

