{
  "$id": "https://open-metadata.org/schema/api/data/ontologyWorkingDiff.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OntologyWorkingDiff",
  "description": "A paginated comparison of the current working ontology with its active release.",
  "type": "object",
  "javaType": "org.openmetadata.schema.api.data.OntologyWorkingDiff",
  "properties": {
    "state": {
      "$ref": "../../type/ontologyState.json"
    },
    "data": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "ontologyReleaseDiff.json#/definitions/memberChange"
      },
      "default": []
    },
    "paging": {
      "$ref": "../../type/paging.json"
    }
  },
  "required": ["state", "data", "paging"],
  "additionalProperties": false
}
