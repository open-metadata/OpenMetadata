{
  "$id": "https://open-metadata.org/schema/governance/changeRequest/changeRequest.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangeRequest",
  "description": "A request to change a published asset that is waiting for, or has finished, approval.",
  "type": "object",
  "javaType": "org.openmetadata.schema.governance.changeRequest.ChangeRequest",
  "definitions": {
    "changeRequestStatus": {
      "javaType": "org.openmetadata.schema.governance.changeRequest.ChangeRequestStatus",
      "type": "string",
      "enum": ["Pending", "Approved", "Applied", "Rejected", "Conflicted", "Withdrawn", "Cancelled", "Superseded"]
    },
    "deliveryStatus": {
      "javaType": "org.openmetadata.schema.governance.changeRequest.DeliveryStatus",
      "description": "Operational state of handing the active revision to the review workflow. Never implies publication.",
      "type": "string",
      "enum": ["Pending", "Delivering", "Delivered", "AttentionRequired"]
    },
    "changeRequestOrigin": {
      "javaType": "org.openmetadata.schema.governance.changeRequest.ChangeRequestOrigin",
      "type": "string",
      "enum": ["Intercepted", "Explicit"]
    },
    "reviewPolicy": {
      "javaType": "org.openmetadata.schema.governance.changeRequest.ReviewPolicy",
      "description": "How the reviewing workflow's approval step decides the request: how many reviewers must agree to approve or to reject a change, and whether changes can be decided one by one.",
      "type": "object",
      "properties": {
        "approvalThreshold": { "type": "integer", "minimum": 1, "default": 1 },
        "rejectionThreshold": { "type": "integer", "minimum": 1, "default": 1 },
        "partialDecisions": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "changeConflict": {
      "javaType": "org.openmetadata.schema.governance.changeRequest.ChangeConflict",
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "baseValue": { "type": "string" },
        "currentValue": { "type": "string" },
        "proposedValue": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["field"],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": { "$ref": "../../type/basic.json#/definitions/uuid" },
    "entityType": { "type": "string" },
    "entityId": { "$ref": "../../type/basic.json#/definitions/uuid" },
    "entityFullyQualifiedName": { "type": "string" },
    "requestedBy": { "description": "Effective human requester.", "type": "string" },
    "impersonatedBy": { "description": "Bot that submitted on the requester's behalf, if any.", "type": "string" },
    "origin": { "$ref": "#/definitions/changeRequestOrigin" },
    "workflowDefinitionId": { "$ref": "../../type/basic.json#/definitions/uuid" },
    "status": { "$ref": "#/definitions/changeRequestStatus" },
    "activeRevisionId": { "$ref": "../../type/basic.json#/definitions/uuid" },
    "activeRevisionNumber": { "type": "integer", "minimum": 1 },
    "activeRevision": {
      "description": "Populated on read only; never persisted in the request row.",
      "$ref": "changeRevision.json"
    },
    "taskId": { "$ref": "../../type/basic.json#/definitions/uuid" },
    "deliveryStatus": { "$ref": "#/definitions/deliveryStatus" },
    "deliveryAttempts": { "type": "integer", "default": 0 },
    "reviewPolicy": { "$ref": "#/definitions/reviewPolicy" },
    "alreadyPublished": {
      "description": "Changes of the active revision that the asset already shows because another change published them; they are no longer reviewed.",
      "type": "array",
      "items": { "$ref": "approvalDecision.json#/definitions/changeRef" }
    },
    "superseded": {
      "description": "Changes of the active revision whose field was published with another value after the request was submitted. They leave the review and are not published; the requester can propose them again.",
      "type": "array",
      "items": { "$ref": "approvalDecision.json#/definitions/changeRef" }
    },
    "disagreed": {
      "description": "Changes of the active revision its reviewers can no longer agree on: the reviewers who have not voted cannot bring either the approvals or the rejections to their threshold. They are not published.",
      "type": "array",
      "items": { "$ref": "approvalDecision.json#/definitions/changeRef" }
    },
    "conflicts": { "type": "array", "items": { "$ref": "#/definitions/changeConflict" } },
    "statusReason": { "type": "string" },
    "createdAt": { "$ref": "../../type/basic.json#/definitions/timestamp" },
    "updatedAt": { "$ref": "../../type/basic.json#/definitions/timestamp" }
  },
  "required": ["id", "entityType", "entityId", "entityFullyQualifiedName", "requestedBy", "origin", "workflowDefinitionId", "status", "activeRevisionId", "activeRevisionNumber", "createdAt", "updatedAt"],
  "additionalProperties": false
}
