{
  "$id": "https://open-metadata.org/schema/governance/changeRequest/changeApplication.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangeApplication",
  "description": "The single committed publication of an approved revision.",
  "type": "object",
  "javaType": "org.openmetadata.schema.governance.changeRequest.ChangeApplication",
  "properties": {
    "id": { "$ref": "../../type/basic.json#/definitions/uuid" },
    "changeRequestId": { "$ref": "../../type/basic.json#/definitions/uuid" },
    "revisionId": { "$ref": "../../type/basic.json#/definitions/uuid" },
    "digest": { "type": "string" },
    "appliedBy": { "description": "Attributed author of the published change (the requester).", "type": "string" },
    "resultingEntityVersion": { "type": "number" },
    "droppedOps": {
      "description": "Non-gated ops not applied because the field changed after submission (decision D9).",
      "type": "array",
      "items": { "$ref": "mutationOp.json" }
    },
    "appliedAt": { "$ref": "../../type/basic.json#/definitions/timestamp" }
  },
  "required": ["id", "changeRequestId", "revisionId", "digest", "appliedBy", "appliedAt"],
  "additionalProperties": false
}
