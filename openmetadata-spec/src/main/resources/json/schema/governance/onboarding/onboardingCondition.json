{
  "$id": "https://open-metadata.org/schema/governance/onboarding/onboardingCondition.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OnboardingCondition",
  "javaType": "org.openmetadata.schema.governance.onboarding.OnboardingCondition",
  "type": "object",
  "properties": {
    "fieldPath": {
      "type": "string",
      "description": "Native or extension field to test."
    },
    "operator": {
      "type": "string",
      "enum": [
        "present",
        "equals",
        "contains"
      ]
    },
    "value": {
      "description": "Value compared using the selected operator.",
      "existingJavaType": "java.lang.Object"
    }
  },
  "required": [
    "fieldPath",
    "operator"
  ],
  "additionalProperties": false
}
