{
  "$id": "https://open-metadata.org/schema/governance/onboarding/onboardingTaskBinding.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OnboardingTaskBinding",
  "javaType": "org.openmetadata.schema.governance.onboarding.OnboardingTaskBinding",
  "type": "object",
  "properties": {
    "stepId": {
      "type": "string",
      "description": "Stable step identifier."
    },
    "taskId": {
      "$ref": "../../type/basic.json#/definitions/uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "fingerprint": {
      "type": "string",
      "description": "Fingerprint of metadata covered by the approval."
    },
    "workflowDefinitionId": {
      "$ref": "../../type/basic.json#/definitions/uuid"
    },
    "stallNotifiedAt": {
      "description": "When the playbook owners were told this task had stopped moving.",
      "type": "integer",
      "existingJavaType": "java.lang.Long"
    },
    "reassignedAt": {
      "description": "When the stall policy reassigned this task. Assignee refreshes never revert it.",
      "type": "integer",
      "existingJavaType": "java.lang.Long"
    }
  },
  "required": [
    "stepId",
    "taskId",
    "attempt"
  ],
  "additionalProperties": false
}
