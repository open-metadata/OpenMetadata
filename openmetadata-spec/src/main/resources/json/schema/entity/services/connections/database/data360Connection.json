{
  "$id": "https://open-metadata.org/schema/entity/services/connections/database/data360Connection.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Data360Connection",
  "description": "Salesforce Data 360 (formerly DataCloud) Connection Config",
  "type": "object",
  "javaType": "org.openmetadata.schema.services.connections.database.Data360Connection",
  "definitions": {
    "data360Type": {
      "description": "Service type.",
      "type": "string",
      "enum": [
        "Data360"
      ],
      "default": "Data360"
    }
  },
  "properties": {
    "type": {
      "title": "Service Type",
      "description": "Service Type",
      "$ref": "#/definitions/data360Type",
      "default": "Data360"
    },
    "consumerKey": {
      "title": "Consumer Key",
      "description": "Consumer key provided when you setup your Salesforce connected app",
      "type": "string",
      "format": "password"
    },
    "consumerSecret": {
      "title": "Consumer Secret",
      "description": "Consumer secret provided when you setup your Salesforce connected app",
      "type": "string",
      "format": "password"
    },
    "salesforceApiVersion": {
      "title": "Salesforce API Version",
      "description": "API version of the Salesforce instance",
      "type": "string",
      "default": "63.0"
    },
    "salesforceDomain": {
      "title": "Salesforce Domain",
      "description": "Domain of Salesforce instance",
      "type": "string",
      "default": "login"
    },
    "paginationLimit": {
      "title": "Pagination Limit",
      "description": "Pagination limit used when fetching Data 360 objects. The default value is 10, and the valid range is 1-100",
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 100
    },
    "supportsMetadataExtraction": {
      "title": "Supports Metadata Extraction",
      "$ref": "../connectionBasicType.json#/definitions/supportsMetadataExtraction"
    }
  },
  "additionalProperties": false,
  "required": [
    "consumerKey",
    "consumerSecret"
  ]
}
