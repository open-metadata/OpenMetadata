{
  "$id": "https://open-metadata.org/schema/type/personaContext.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PersonaContext",
  "description": "Structured form of the materialized AI context shared by members of a Persona.",
  "type": "object",
  "javaType": "org.openmetadata.schema.type.PersonaContext",
  "definitions": {
    "ruleResult": {
      "description": "Materialization result for one persona context rule.",
      "type": "object",
      "javaType": "org.openmetadata.schema.type.personaContext.RuleResult",
      "properties": {
        "ruleName": {
          "type": "string"
        },
        "entityType": {
          "type": "string"
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "renderedFull": {
          "type": "integer",
          "minimum": 0
        },
        "renderedCompact": {
          "type": "integer",
          "minimum": 0
        },
        "manifestOnly": {
          "type": "integer",
          "minimum": 0
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "aiContext.json"
          }
        }
      },
      "additionalProperties": false
    },
    "sharedKnowledge": {
      "description": "Distinct knowledge referenced by selected assets, rendered once in full in the document appendix.",
      "type": "object",
      "javaType": "org.openmetadata.schema.type.personaContext.SharedKnowledge",
      "properties": {
        "glossaryTerms": {
          "type": "array",
          "items": {
            "$ref": "aiContext.json#/definitions/knowledgeItem"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "aiContext.json#/definitions/knowledgeItem"
          }
        },
        "articles": {
          "type": "array",
          "items": {
            "$ref": "aiContext.json#/definitions/knowledgeItem"
          }
        }
      },
      "additionalProperties": false
    },
    "searchScopeRule": {
      "description": "One filteredInSearch rule contributing to the persona search scope.",
      "type": "object",
      "javaType": "org.openmetadata.schema.type.personaContext.SearchScopeRule",
      "properties": {
        "ruleName": {
          "type": "string"
        },
        "entityType": {
          "type": "string"
        },
        "queryFilter": {
          "description": "Elasticsearch query DSL string configured on the rule. Empty selects every entity of the configured type.",
          "type": "string"
        }
      },
      "required": ["ruleName", "entityType"],
      "additionalProperties": false
    },
    "searchScope": {
      "description": "Default search scope built from the persona's filteredInSearch rules. Consumers apply queryFilter to every AI search so the persona only sees the entities its rules select, instead of preloading them into the document.",
      "type": "object",
      "javaType": "org.openmetadata.schema.type.personaContext.SearchScope",
      "properties": {
        "entityTypes": {
          "description": "Distinct entity types named by the contributing rules. An entity type absent from this list is outside the scope entirely.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rules": {
          "description": "The contributing rules, kept for display and debugging.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/searchScopeRule"
          }
        },
        "queryFilter": {
          "description": "Ready-to-use Elasticsearch query DSL string unioning every contributing rule. Empty when the persona has no filteredInSearch rules, in which case search is unscoped.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "manifestEntry": {
      "description": "An entity that was compacted or omitted because the global character budget was exhausted.",
      "type": "object",
      "javaType": "org.openmetadata.schema.type.personaContext.ManifestEntry",
      "properties": {
        "entityType": {
          "type": "string"
        },
        "fullyQualifiedName": {
          "$ref": "basic.json#/definitions/fullyQualifiedEntityName"
        },
        "reason": {
          "type": "string",
          "enum": ["compact", "omitted"]
        }
      },
      "required": ["entityType", "fullyQualifiedName", "reason"],
      "additionalProperties": false
    }
  },
  "properties": {
    "persona": {
      "$ref": "entityReference.json"
    },
    "generatedAt": {
      "$ref": "basic.json#/definitions/timestamp"
    },
    "fingerprint": {
      "description": "Stable definition hash followed by a content hash for detecting a changed materialization.",
      "type": "string"
    },
    "truncated": {
      "description": "Whether at least one selected entity was compacted or omitted, or required knowledge exceeded the configured budget.",
      "type": "boolean",
      "default": false
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ruleResult"
      }
    },
    "sharedKnowledge": {
      "$ref": "#/definitions/sharedKnowledge"
    },
    "searchScope": {
      "$ref": "#/definitions/searchScope"
    },
    "manifest": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/manifestEntry"
      }
    }
  },
  "additionalProperties": false
}
