# Snyk policy file for the OpenMetadata repo root.
#
# This file is read by Snyk scans that run FROM REPO ROOT. Currently
# that means the snyk-server-report target (see Makefile):
#   snyk test --all-projects ...        (Snyk Open Source / SCA)
#   snyk code test --all-projects ...   (Snyk Code / SAST)
# and the snyk-ui-report target which scans the UI yarn.lock.
#
# Paths in `exclude.global` below are relative to THIS file's directory
# (the repo root). So an ingestion path looks like `ingestion/foo/**`.
#
# IMPORTANT: there is a SECOND policy file at `ingestion/.snyk`. It is
# read by the snyk-ingestion-report target, which runs
# `cd ingestion; snyk code test ...`. Snyk Code only reads a .snyk
# file from its own CWD, with no `--policy-path` and no `--exclude`
# flag available on the Code subcommand. So a pattern added here that
# lives under `ingestion/` will NOT be applied by that scan unless it
# is also added (without the `ingestion/` prefix) to `ingestion/.snyk`.
# Keep the two files in sync for any path under `ingestion/`.
#
# The same dual-file rule would apply to `openmetadata-airflow-apis/`
# if that scan ever needs path exclusions. The dedicated airflow scan
# also runs from a subdirectory and would need its own .snyk there.
#
# Snyk docs on .snyk policy lookup and Snyk Code excludes:
#   https://docs.snyk.io/manage-risk/policies/the-.snyk-file
#   https://docs.snyk.io/developer-tools/snyk-cli/scan-and-maintain-projects-using-the-cli/snyk-cli-for-snyk-code/exclude-directories-and-files-from-snyk-code-cli-tests

version: v1.25.0

# Suppressed Snyk Open Source findings.
#
# Each entry states a premise a reviewer can re-check and carries a short expiry, so a suppression
# that outlives its premise comes back on its own instead of hiding silently. Renewing one means
# re-verifying it, not moving the date.
ignore:
  # @tiptap/core prototype pollution in mergeAttributes() -- we are already on the fixed build.
  #
  # PREMISE: @tiptap/core resolves to >= 2.27.3. 2.27.3 is the backport of the same fix 3.30.4
  # shipped: the "__proto__" key is written with Object.defineProperty() and returned early,
  # instead of falling through to plain assignment. Confirmed by diffing the published tarballs --
  # 2.27.2 and 3.30.3 lack the guard, 2.27.3 and 3.30.4 carry it, identically. Re-check with:
  #   for v in 2.27.2 2.27.3 3.30.3 3.30.4; do npm pack @tiptap/core@$v >/dev/null 2>&1; \
  #     mkdir -p x$v && tar xzf tiptap-core-$v.tgz -C x$v; \
  #     printf '%s: ' "$v"; grep -c '__proto__' x$v/package/dist/index.js; done
  #
  # WHY IT IS FLAGGED ANYWAY: GHSA-cp6q-959q-f8rh was published 2026-09-02; 2.27.3 was published
  # 2026-09-04. The advisory's single range ">= 2.0.0-alpha.0, < 3.30.4" predates the backport and
  # has never been revised, so no version on the v2 line can satisfy it (2.27.3 is npm's v2-latest).
  # Snyk mirrors GHSA and inherits the error.
  #
  # RESOLUTION: correcting the advisory upstream, which clears this everywhere and lets the block be
  # deleted. Do NOT resolve it by moving to v3 -- that is a major across the BlockEditor (~68 files
  # under openmetadata-ui/), and @tiptap/pm@3 requires prosemirror-model ^1.25.11 / prosemirror-view
  # ^1.42.3 / prosemirror-transform ^1.12.0 against the 1.22.1 / 1.28.2 / 1.7.0 pinned in the UI
  # package.json resolutions block.
  #
  # SCOPE NOTE: '*' suppresses this id on every path and version -- .snyk has no version predicate,
  # so the premise above cannot be encoded as a condition. It holds today because @tiptap/core is a
  # direct dependency at ^2.27.3 in the UI package.json and the only package depending on it,
  # @tiptap/starter-kit, also requires ^2.27.3 -- neither can resolve below the fix. If a transitive
  # @tiptap/core ever appears on a looser range, this block must be re-scoped or dropped.
  SNYK-JS-TIPTAPCORE-19643571:
    - '*':
        reason: >-
          False positive -- @tiptap/core 2.27.3 is the v2 backport of the same mergeAttributes()
          __proto__ guard released in 3.30.4, verified against the published 2.27.2/2.27.3/3.30.3/
          3.30.4 tarballs. GHSA-cp6q-959q-f8rh predates the backport and omits the carve-out for it.
        created: 2026-09-15T00:00:00.000Z
        expires: 2026-10-31T00:00:00.000Z

patch: {}
exclude:
  global:
    # Ingestion (Python). When you add or change anything in this block,
    # MIRROR THE CHANGE IN `ingestion/.snyk` with the same pattern minus
    # the `ingestion/` prefix. Both files must list the exclusion for
    # both Snyk Code scans to honour it.
    - ingestion/examples/**
    - ingestion/tests/**
    - ingestion/src/_openmetadata_testutils/**
    - ingestion/src/metadata/sdk/examples/**

    # UI (TypeScript) test mocks.
    - openmetadata-ui/src/main/resources/ui/src/pages/service/mocks/**
    - openmetadata-ui/src/main/resources/ui/src/components/common/TestConnection/TestConnection.mock.ts

    # Server (Java) test fixtures.
    - openmetadata-service/src/test/**
