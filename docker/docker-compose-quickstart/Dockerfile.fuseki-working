# Simple Fuseki build that works on ARM64

# Amazon Corretto 21's generic Linux build, from its official image: Temurin has not published
# OpenJDK's November 2026 security release yet. Only the jlinked runtime leaves this stage, not
# the image's Amazon Linux 2 base.
FROM amazoncorretto:21-al2-generic AS jre-builder

# --strip-java-debug-attributes, not --strip-debug: Corretto ships its native libraries
# stripped, and --strip-debug would need objcopy for nothing.
RUN jlink \
      --add-modules ALL-MODULE-PATH \
      --strip-java-debug-attributes \
      --no-man-pages \
      --no-header-files \
      --compress=zip-6 \
      --output /javaruntime

FROM ubuntu:22.04

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
# C.UTF-8 ships with glibc, so the JVM gets UTF-8 without the locales package.
ENV LANG=C.UTF-8
COPY --from=jre-builder /javaruntime ${JAVA_HOME}

# The quickstart compose files health-check Fuseki with curl or wget.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl wget \
    && rm -rf /var/lib/apt/lists/*

# Set Fuseki version and paths
ENV FUSEKI_VERSION=6.2.0
ENV FUSEKI_HOME=/fuseki
ENV FUSEKI_BASE=/fuseki

# Create directories
RUN mkdir -p ${FUSEKI_HOME}

WORKDIR ${FUSEKI_HOME}

# Download Fuseki using ADD (doesn't require wget)
ADD https://archive.apache.org/dist/jena/binaries/apache-jena-fuseki-${FUSEKI_VERSION}.tar.gz /tmp/fuseki.tar.gz

# Extract Fuseki
RUN tar -xzf /tmp/fuseki.tar.gz --strip-components=1 -C ${FUSEKI_HOME} && \
    rm /tmp/fuseki.tar.gz && \
    mkdir -p ${FUSEKI_HOME}/run ${FUSEKI_HOME}/databases

# JVM options
ENV JVM_ARGS="-Xmx4g -Xms2g"

# Expose port
EXPOSE 3030

# Start Fuseki
CMD ["sh", "-c", "mkdir -p ${FUSEKI_HOME}/databases/openmetadata && exec ${FUSEKI_HOME}/fuseki-server --update --loc=${FUSEKI_HOME}/databases/openmetadata /openmetadata"]