# Fuseki assembler configuration for the OpenMetadata RDF store.
#
# Why --config instead of --loc: the settings that protect the single-writer
# TDB2 store are config-file-only. Most importantly arq:updateTimeout — the
# --timeout CLI flag covers queries ONLY, so a server launched with --loc has
# no server-side bound on UPDATE execution at all: an update abandoned by a
# client timeout keeps holding the writer lock until it finishes on its own.
#
# NOTE ON UPGRADES: the original `--loc=/fuseki-data` layout stored TDB2 files
# directly in /fuseki-data, while this assembler uses the /fuseki-data/openmetadata
# subdirectory. Pointing at the wrong location does not fail — it silently starts
# an EMPTY store — so verify a triple count before and after any launch-mode change.
# See docs/rdf-production-setup.md for the runbook.

@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tdb2:  <http://jena.apache.org/2016/tdb#> .
@prefix ja:    <http://jena.hpl.hp.com/2005/11/Assembler#> .
# jena-text prefix: without this the file fails to parse at the first text: term below
# ("Undefined prefix: text"), which made Fuseki refuse to boot with --config.
@prefix text:  <http://jena.apache.org/text#> .

[] rdf:type fuseki:Server ;
   fuseki:services (
     <#openmetadata>
   ) .

<#openmetadata> rdf:type fuseki:Service ;
    fuseki:name "openmetadata" ;
    fuseki:serviceQuery "sparql" ;
    fuseki:serviceQuery "query" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceUpload "upload" ;
    fuseki:serviceReadWriteGraphStore "data" ;
    fuseki:dataset <#dataset> .

<#dataset> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki-data/openmetadata" ;
    # Required, not cosmetic: OpenMetadata writes every entity into a NAMED graph, so
    # without this a plain `?s ?p ?o` against the default graph returns zero rows while
    # the data sits in <https://open-metadata.org/graph/knowledge>. That is the shape the
    # SPARQL playground and the MCP knowledge-graph tools generate, so turning this off
    # yields silently empty results rather than an error. Queries that need to target one
    # graph must say so with an explicit GRAPH clause.
    tdb2:unionDefaultGraph true ;
    # Server-side bound on UPDATE execution (milliseconds). Set above the
    # OpenMetadata client's request timeout (default 60s) so the normal path
    # is always client-governed, and the server only steps in to kill a
    # runaway or abandoned update before it monopolizes the writer lock.
    ja:context [ ja:cxtName "arq:updateTimeout" ; ja:cxtValue "120000" ] ;
    .

# Enable full-text search
<#dataset> ja:textIndex (<#index>) .

<#index> a text:TextIndexLucene ;
    text:directory "/fuseki-data/lucene" ;
    text:entityMap <#entityMap> ;
    text:storeValues true .

<#entityMap> a text:EntityMap ;
    text:defaultField "text" ;
    text:entityField "uri" ;
    text:map (
        [ text:field "text" ;
          text:predicate rdfs:label ]
        [ text:field "description" ;
          text:predicate <http://purl.org/dc/terms/description> ]
        [ text:field "name" ;
          text:predicate <https://open-metadata.org/ontology/name> ]
    ) .
