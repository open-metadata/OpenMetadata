#
# Bootstrap tree for the LDAP SSO Playwright fixture.
# Loaded by bitnami/openldap via LDAP_CUSTOM_LDIF_DIR=/ldifs at container init.
# Password is written in plaintext; the LDAP simple bind will compare it byte-
# for-byte against the stored userPassword attribute (no hashing required for
# the ephemeral E2E container). Do not reuse this LDIF in any real environment.

dn: dc=openmetadata,dc=org
objectClass: top
objectClass: dcObject
objectClass: organization
o: OpenMetadata
dc: openmetadata

dn: ou=users,dc=openmetadata,dc=org
objectClass: top
objectClass: organizationalUnit
ou: users

dn: uid=ldapuser,ou=users,dc=openmetadata,dc=org
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: ldapuser
cn: LDAP User
sn: User
mail: ldapuser@openmetadata.org
userPassword: ldappass
