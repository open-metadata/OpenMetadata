{
  "template": {
    "settings": {
      "index": {
        "max_ngram_diff": 17
      }
    },
    "mappings": {
      "dynamic_templates": [
        {
          "completeness_facts": {
            "path_match": "completenessFacts.*",
            "mapping": { "type": "double" }
          }
        }
      ],
      "properties": {
        "diRunId": { "type": "keyword" },
        "diCapturedAt": { "type": "long" },
        "updatedAt": { "type": "long" },
        "completenessDownstreamCount": { "type": "long" },
        "completenessFactVersion": { "type": "integer" },
        "completenessFactsAsOf": { "type": "long" },
        "completenessUnavailableSources": { "type": "keyword" },
        "completenessFacts": { "type": "object", "dynamic": true },
        "columnCoverage": {
          "properties": {
            "total": { "type": "long" },
            "described": { "type": "long" },
            "glossaryLinked": { "type": "long" },
            "piiClassified": { "type": "long" }
          }
        },
        "@timestamp": {
          "type": "date"
        },
        "id": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "tier": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "normalizer": "lowercase_normalizer",
              "ignore_above": 256
            }
          }
        },
        "customPropertiesTyped": {
          "type": "nested",
          "properties": {
            "name": {
              "type": "keyword"
            },
            "propertyType": {
              "type": "keyword"
            },
            "stringValue": {
              "type": "keyword"
            },
            "textValue": {
              "type": "text"
            },
            "longValue": {
              "type": "long"
            },
            "doubleValue": {
              "type": "double"
            },
            "start": {
              "type": "long"
            },
            "end": {
              "type": "long"
            },
            "refId": {
              "type": "keyword"
            },
            "refType": {
              "type": "keyword"
            },
            "refName": {
              "type": "keyword"
            },
            "refFqn": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
