{
  "name": "RdfIndexApp",
  "displayName": "RDF Knowledge Graph Indexing",
  "appConfiguration": {
    "entities": [],
    "recreateIndex": true,
    "batchSize": 100,
    "producerThreads": 4,
    "relationshipIsolationMaxFailures": 3,
    "minSuccessRatio": 0.95,
    "blueGreenRebuild": false
  },
  "appSchedule": {
    "scheduleTimeline": "Custom",
    "cronExpression": "0 0 * * 6"
  },
  "supportsInterrupt": true
}
