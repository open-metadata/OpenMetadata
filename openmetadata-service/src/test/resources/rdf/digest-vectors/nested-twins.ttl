PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# The same restriction twice, each over its own union: two pairs of blank nodes no refinement
# separates. A digest that orders tied nodes by label pairs each restriction with either union.
<http://ex.org/A> rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty <http://ex.org/p> ;
      owl:someValuesFrom [ a owl:Class ; owl:unionOf ( <http://ex.org/B> <http://ex.org/C> ) ] ] ,
    [ a owl:Restriction ; owl:onProperty <http://ex.org/p> ;
      owl:someValuesFrom [ a owl:Class ; owl:unionOf ( <http://ex.org/B> <http://ex.org/C> ) ] ] .
