{
  "compilerOptions": {
    "incremental": true,
    "target": "ES5",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "ES2020.Promise", "es2021"],
    "allowJs": true,
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "removeComments": false,
    "noEmit": true,
    "importHelpers": true,
    "downlevelIteration": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "types": ["node"],
    "baseUrl": ".",
    // Resolve the linked core-ui package's subpaths from SOURCE, not its built
    // dist/. The package's exports map points ./icons at dist/icons/index.es.js,
    // which only exists after the core-ui package is built — the nightly runs
    // Playwright without that build, so the import fails to resolve and specs
    // can't even be listed. The icon entries are pure React/SVG (no CSS side
    // imports), so Playwright's esbuild loader handles the source directly.
    "paths": {
      "@openmetadata/ui-core-components/icons": [
        "../../../../../../openmetadata-ui-core-components/src/main/resources/ui/src/icons/index.ts"
      ]
    }
  }
}
