{
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",
    "typeRoots": ["./src/@types", "./node_modules/@types"],
    "types": [
      "node",
      "jest",
      "react",
      "react-dom",
      "lodash",
      "lodash-es",
      "luxon",
      "js-yaml",
      "dagre",
      "diff",
      "katex",
      "pako",
      "qs",
      "showdown",
      "tinycolor2",
      "turndown",
      "testing-library__jest-dom",
      "react-grid-layout",
      "react-test-renderer",
      "reactjs-localstorage",
      "use-analytics"
    ],
    "incremental": true,
    "target": "es6",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "ES2020.Promise", "es2021"],
    "allowJs": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "removeComments": false,
    "noEmit": true,
    "importHelpers": true,
    "downlevelIteration": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "paths": {
      "react-hook-form": ["./node_modules/react-hook-form"],
      "@internationalized/date": ["./node_modules/@internationalized/date"],
      "react-aria-components": ["./node_modules/react-aria-components"],
      "react-stately": ["./node_modules/react-stately"],
      "react-aria": ["./node_modules/react-aria"],
      "@react-types/shared": ["./node_modules/@react-types/shared"],
      "@react-types/datepicker": ["./node_modules/@react-types/datepicker"],
      "@react-types/calendar": ["./node_modules/@react-types/calendar"],
      "@openmetadata/ui-core-components": [
        "../../../../../openmetadata-ui-core-components/src/main/resources/ui/dist/types/src/index.d.ts"
      ],
      "@openmetadata/ui-core-components/icons": [
        "../../../../../openmetadata-ui-core-components/src/main/resources/ui/dist/types/src/icons/index.d.ts"
      ],
      "@openmetadata/ui-core-components/icon": [
        "../../../../../openmetadata-ui-core-components/src/main/resources/ui/dist/types/src/icon/index.d.ts"
      ]
    }
  },
  "include": ["src"]
}
