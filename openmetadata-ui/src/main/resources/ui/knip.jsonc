{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.tsx"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/generated/**",
    "src/locale/**",
    "**/*.test.{ts,tsx}",
    "**/mocks/**",
    "**/__mocks__/**",
    // Compatibility forwards for openmetadata-collate (see each file's docstring);
    // delete the file and its entry here once Collate repoints its imports.
    "src/rest/index.ts",
    "src/styles/index.ts",
    // Unused here but consumed by openmetadata-collate via the generated
    // openmetadata-ui mirror — verify downstream before deleting:
    // NodeSuggestions: collate ERDiagramProvider; DataInsightProvider: collate
    // DashboardChart/DashboardDetails; useLogStream: collate useAutomationLogs.test.
    "src/components/Entity/EntityLineage/NodeSuggestions.component.tsx",
    "src/pages/DataInsightPage/DataInsightProvider.tsx",
    "src/components/common/LogViewerModal/useLogStream.ts",
    // Type-only compat forward: collate CustomizeMyDataPageClassCollate imports
    // AnnouncementsWidgetProps; the widget component itself was removed.
    "src/components/MyData/RightSidebar/AnnouncementsWidget.tsx"
  ],
  "ignoreDependencies": [".*"]
}
