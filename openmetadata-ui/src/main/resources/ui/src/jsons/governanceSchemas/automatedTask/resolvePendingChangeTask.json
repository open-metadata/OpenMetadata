{
  "title": "ResolvePendingChangeTaskDefinition",
  "description": "Resolves the change request the workflow run reviews. The action is configured on the node itself: 'commit' applies the reviewed revision when an eligible approval of that exact revision is recorded (the point a real ChangeEvent is emitted); 'discard' rejects it, leaving the published values in place. Place commit on the approval path and discard on the rejection path.",
  "javaInterfaces": [
    "org.openmetadata.schema.governance.workflows.elements.WorkflowNodeDefinitionInterface"
  ],
  "javaType": "org.openmetadata.schema.governance.workflows.elements.nodes.automatedTask.ResolvePendingChangeTaskDefinition",
  "type": "object",
  "definitions": {
    "action": {
      "javaType": "org.openmetadata.schema.governance.workflows.elements.nodes.automatedTask.ResolvePendingChangeAction",
      "description": "What to do with the change request the run reviews.",
      "type": "string",
      "enum": [
        "commit",
        "discard"
      ]
    }
  },
  "properties": {
    "type": {
      "type": "string",
      "default": "automatedTask"
    },
    "subType": {
      "type": "string",
      "default": "resolvePendingChangeTask"
    },
    "name": {
      "title": "Name",
      "description": "Name that identifies this Node.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^((?!::)[^>\"\\x00-\\x1f])*$"
    },
    "displayName": {
      "title": "Display Name",
      "description": "Display Name that identifies this Node.",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "description": "Description of the Node.",
      "$comment": "@om-field-type",
      "type": "string"
    },
    "config": {
      "title": "Node Configuration",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/definitions/action"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "relatedEntity",
        "updatedBy"
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2
    },
    "inputNamespaceMap": {
      "type": "object",
      "properties": {
        "relatedEntity": {
          "type": "string",
          "default": "global"
        },
        "updatedBy": {
          "type": "string",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "relatedEntity"
      ]
    },
    "output": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "additionalItems": false,
      "minItems": 0,
      "maxItems": 0
    },
    "outputNamespaceMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "config"
  ],
  "additionalProperties": false
}