{
  "name": "open-metadata",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.5",
    "yarn": "^4.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-metadata/OpenMetadata.git",
    "directory": "openmetadata-ui/src/main/resources/ui"
  },
  "scripts": {
    "start": "vite",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=6144}\" vite build",
    "build:release": "yarn build && yarn compress:brotli",
    "analyze": "vite build --mode analyze",
    "bundle:check": "node scripts/check-bundle-chunks.mjs",
    "bundle:runtime": "yarn test:bundle-runtime && node scripts/check-bundle-runtime.mjs",
    "test:bundle-runtime": "node --test scripts/check-bundle-runtime.test.mjs",
    "compress:brotli": "node scripts/compress-brotli.mjs",
    "preview": "vite preview",
    "postinstall": "yarn run build-check",
    "preinstall": "cd ../../../../../openmetadata-ui-core-components/src/main/resources/ui && yarn install && yarn build",
    "test": "node --test scripts/sso-dev-server.test.mjs && jest",
    "test:eslint-rules": "node --test eslint-rules/*.test.mjs 'playwright/eslint-rules/tests/**/*.test.mjs'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:cov-summary": "node --test scripts/sso-dev-server.test.mjs && jest --coverage --coverageReporters json-summary",
    "test:cov-ci": "node --test scripts/sso-dev-server.test.mjs && jest --coverage --coverageReporters json-summary --silent --reporters=summary --reporters=github-actions",
    "build-check": "yarn run js-antlr",
    "commit-check": "yarn run pretty && yarn run build",
    "license-header-check": "license-check-and-add check -f .licenseheaderrc.json",
    "license-header-fix": "license-check-and-add add -f .licenseheaderrc.json -r $(date +%Y)",
    "parse-schema": "node parseSchemas",
    "js-antlr": "PWD=$(echo $PWD) antlr4 -Dlanguage=JavaScript -o src/generated/antlr \"$PWD\"/../../../../../openmetadata-spec/src/main/antlr4/org/openmetadata/schema/*.g4",
    "i18n": "sync-i18n --files '**/locale/languages/*.json' --primary en-us --space 2 --fn",
    "check-i18n": "npm run i18n -- --check",
    "lint:base": "NODE_OPTIONS='--max-old-space-size=8192' eslint --no-error-on-unmatched-pattern",
    "lint": "yarn lint:base './src/**/*.{js,jsx,ts,tsx,json}'",
    "lint:fix": "yarn lint:base --fix './src/**/*.{js,jsx,ts,tsx,json}'",
    "lint:src:suppressions": "yarn lint --prune-suppressions",
    "token-audit": "node scripts/token-audit.js",
    "token-audit:report": "node scripts/token-audit.js --report",
    "token-migrate": "node scripts/token-migrate.js --write",
    "token-gen": "node scripts/design-tokens/gen-tokens.js && node scripts/design-tokens/gen-token-reference.js",
    "token-drift": "node scripts/design-tokens/check-drift.js",
    "token-test": "node --test scripts/design-tokens/*.test.js",
    "tw-audit": "node scripts/tw-audit.js",
    "tw-audit:report": "node scripts/tw-audit.js --report",
    "tw-guard": "node scripts/tw-deprecation-guard.js",
    "lint:playwright": "yarn lint:base './playwright/**/*.{js,jsx,ts,tsx}'",
    "lint:playwright:suppressions": "yarn lint:playwright --prune-suppressions",
    "generate:playwright-rules": "node scripts/generate-playwright-rule-table.mjs",
    "pretty:base": "prettier --config './.prettierrc.yaml' --ignore-path './.prettierignore'",
    "pretty": "yarn pretty:base . --write",
    "pretty:src": "yarn pretty:base './src/**/*.{js,jsx,ts,tsx,json}' --write",
    "pretty:playwright": "yarn pretty:base './playwright/**/*.{js,jsx,ts,tsx}' --write",
    "organize-imports:cli": "organize-imports-cli",
    "organize-imports": "yarn organize-imports:cli tsconfig[.*].json",
    "organize-imports:playwright": "yarn organize-imports:cli './playwright/tsconfig[.*].json'",
    "playwright:run": "playwright test",
    "playwright:visual": "playwright test --project=visual-regression",
    "playwright:visual:update": "playwright test --project=visual-regression --update-snapshots",
    "playwright:open": "playwright test --ui",
    "playwright:codegen": "playwright codegen",
    "generate:app-docs": "node generateApplicationDocs.js",
    "generate:e2e-docs": "PLAYWRIGHT_IS_OSS=true node playwright/doc-generator/generate.js",
    "tsc:check": "node ./node_modules/typescript-native/bin/tsc --noEmit --declaration false --declarationMap false",
    "tsc:check:tsrs": "node ./node_modules/tsrs/bin/tsrs --noEmit --checkers 4 --checkerAssignment go --tsBuildInfoFile node_modules/.cache/tsrs/app.tsbuildinfo",
    "tsc:playwright": "node ./node_modules/typescript-native/bin/tsc --project playwright/tsconfig.json --noEmit",
    "tsc:playwright:tsrs": "node ./node_modules/tsrs/bin/tsrs --project playwright/tsconfig.json --noEmit --checkers 4 --checkerAssignment go --tsBuildInfoFile node_modules/.cache/tsrs/playwright.tsbuildinfo",
    "ui-checkstyle": "yarn organize-imports && yarn lint:fix && yarn pretty && yarn license-header-fix && yarn i18n && yarn generate:app-docs",
    "ui-checkstyle:changed": "bash scripts/ui-checkstyle-changed.sh",
    "ui-checkstyle:playwright": "yarn organize-imports:playwright && yarn lint:playwright --fix && yarn pretty:playwright",
    "ui-checkstyle:playwright:changed": "bash scripts/ui-checkstyle-playwright-changed.sh",
    "test:ui": "vitest --config vitest.browser.config.ts",
    "test:ui:run": "vitest run --config vitest.browser.config.ts",
    "test:ui:coverage": "vitest run --config vitest.browser.config.ts --coverage --testTimeout=45000",
    "knip": "knip",
    "knip:files": "knip --include files"
  },
