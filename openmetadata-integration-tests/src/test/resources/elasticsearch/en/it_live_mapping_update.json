{
  "settings": {
    "analysis": {
      "tokenizer": {
        "om_ngram_search_tokenizer": {
          "type": "pattern",
          "pattern": "[^\\p{L}\\p{Nd}]+"
        },
        "n_gram_tokenizer": {
          "type": "ngram",
          "min_gram": 3,
          "max_gram": 20,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      },
      "analyzer": {
        "om_ngram_search": {
          "type": "custom",
          "tokenizer": "om_ngram_search_tokenizer",
          "filter": [
            "lowercase",
            "asciifolding",
            "om_ngram_search_min",
            "om_ngram_search_max"
          ]
        },
        "om_ngram": {
          "type": "custom",
          "tokenizer": "n_gram_tokenizer",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      },
      "filter": {
        "om_ngram_search_min": {
          "type": "length",
          "min": 3
        },
        "om_ngram_search_max": {
          "type": "truncate",
          "length": 20
        }
      }
    },
    "index": {
      "max_ngram_diff": 17
    }
  },
  "mappings": {
    "properties": {
      "name": {
        "type": "text",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "om_ngram",
            "search_analyzer": "om_ngram_search"
          }
        }
      },
      "newField": {
        "type": "keyword"
      }
    }
  }
}
